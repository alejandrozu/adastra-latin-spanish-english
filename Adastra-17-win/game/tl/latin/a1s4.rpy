    a "\"Blegh! Asine!\""

# game/a1s4.rpy:673
translate latin a1s4_046927fa:

    # "The wolf paws the water out of his eyes, looking ready to try and splash me as well."
    "Lupus aquam e oculis manibus tergit, quasi me quoque conspergere paratus."

# game/a1s4.rpy:674
translate latin a1s4_f6be6ee2:

    # "He sees me also at the ready though, hands up to my chest and ready to send another wave into his face."
    "Me tamen quoque paratum videt, manibus ad pectus sublatis ut alterum fluctum in faciem eius mittam."

