    "Fluctum aquae in faciem Amici impello, recta in os eius apertum mittens."

# game/a1s4.rpy:670
translate latin a1s4_ae5871d2:

    # "He coughs and spits, choking on the water I'd just forcibly slammed down his throat."
    "Tussit et exspuit, aqua suffocatus quam modo vi in guttur eius impulsi."

# game/a1s4.rpy:672
translate latin a1s4_5b476601:

