
# game/a3s1.rpy:3
translate latin a3s1_006d9f9c:

    # "The snuffling in my hair pauses as Amicus absorbs what I'd just said."
    "Amicus capillos meos olfacere desinit, dum ea quae modo dixi percipit."

# game/a3s1.rpy:5
translate latin a3s1_03aa16a0:

    # a "\"The parents?\""
    a "\"Parentes?\""

# game/a3s1.rpy:6
translate latin a3s1_c806ebc0:

    # m "\"Yeah.\""
    m "\"Ita.\""

# game/a3s1.rpy:8
translate latin a3s1_840e2238:

    # a "\"THE parents?\""
    a "\"ILLI Parentes?\""

# game/a3s1.rpy:9
translate latin a3s1_8ffa16f8:

    # "I sigh, wondering if I'm going to have just as much trouble convincing Amicus of this as I did with everyone else."
    "Suspiro, miratus num Amico hoc persuadere tam difficile mihi sit quam omnibus aliis."

# game/a3s1.rpy:10
translate latin a3s1_577ac75b:

    # "I still remember the look Neferu gave me when I told him about the drug trip I had."
    "Adhuc obtutum Neferu memini cum ei de visione medicamentis effecta narravi."

# game/a3s1.rpy:11
translate latin a3s1_5fc5a999:

    # "Amicus seems to sense my frustration and hugs me a little tighter."
    "Amicus taedium meum sentire videtur et me paulum artius amplectitur."

# game/a3s1.rpy:13
translate latin a3s1_ee3c6288:

    # a "\"Hey, I'm just surprised, I believe you. I have no reason not to.\""
    a "\"Heus, tantum miror; tibi credo. Nulla causa est cur non credam.\""

# game/a3s1.rpy:14
translate latin a3s1_3487b25b:

    # "He nuzzles my head again."
    "Rursus caput meum rostro mulcet."

# game/a3s1.rpy:15
translate latin a3s1_fe0b8294:

    # a "\"Did they come to you in a dream, or...\""
    a "\"In somnio ad te venerunt, an...\""

# game/a3s1.rpy:16
translate latin a3s1_3b52b862:

    # m "\"Sort of.\""
    m "\"Quodam modo.\""

# game/a3s1.rpy:17
translate latin a3s1_eaeb556d:

    # "I tell Amicus what happened in the hallway in front of the meditation room."
    "Amico narro quid in ambulacro ante meditationis cubiculum acciderit."

# game/a3s1.rpy:19
translate latin a3s1_2d370d51:

    # a "\"Wha—\""
    a "\"Qu—\""

# game/a3s1.rpy:20
translate latin a3s1_23edfe12:

    # "I push through his shocked exclamations and go on to describe the dreams I'd been having as well."
    "Per attonitas eius exclamationes pergo atque somnia quae habueram quoque describo."

# game/a3s1.rpy:22
translate latin a3s1_7e09cff1:

    # a "\"What? But why wouldn't you tell me this?\""
    a "\"Quid? Sed cur hoc mihi non narrasti?\""

# game/a3s1.rpy:23
translate latin a3s1_ed90ace8:

    # "I shrug against his body."
    "Contra corpus eius umeros tollo."

# game/a3s1.rpy:24
translate latin a3s1_1f2b771e:

    # m "\"I forgot about them as soon as I woke up. I didn't remember until after what happened with Cassius.\""
    m "\"Eorum statim oblitus sum ubi experrectus sum. Non memini nisi post id quod cum Cassio accidit.\""

# game/a3s1.rpy:25
translate latin a3s1_8baee541:

    # a "\"Well—\""
    a "\"Bene—\""

# game/a3s1.rpy:26
translate latin a3s1_961c12d8:

    # "I feel Amicus's chest puff up with pride."
    "Pectus Amici superbia inflari sentio."

# game/a3s1.rpy:28
translate latin a3s1_1087acbd:

    # a "\"—sounds like I really am meant to be emperor, eh?\""
    a "\"—videtur me vere ad imperium natum esse, eh?\""

# game/a3s1.rpy:29
translate latin a3s1_32a35f52:

    # m "\"That's what they said, but you know what else this means?\""
    m "\"Ita dixerunt; sed scis quid aliud hoc significet?\""

# game/a3s1.rpy:31
translate latin a3s1_e9e3bd96:

    # a "\"Mm?\""
    a "\"Mm?\""

# game/a3s1.rpy:32
translate latin a3s1_91e3699d:

    # m "\"The monitors know I'm here. They're okay with it. So I guess it's not really even illegal, right?\""
    m "\"Monitores sciunt me hic esse. Id probant. Itaque credo ne vere quidem illicitum esse, recte?\""

# game/a3s1.rpy:33
translate latin a3s1_f85b39eb:

    # "There's a pause."
    "Paulisper tacet."

# game/a3s1.rpy:34
translate latin a3s1_7345e930:

    # a "\"I mean, it may have been just a dream, but it's nice to hear, nevertheless. Also, stay away from that room.\""
    a "\"Dico, fortasse somnium tantum erat, sed tamen id audire gratum est. Etiam ab illo cubiculo abstine.\""

# game/a3s1.rpy:35
translate latin a3s1_f0494b4f:

    # a "\"While I find it funny that Cassius is using {i}somni{/i} to make contact, I'd rather you not use it.\""
    a "\"Quamquam me delectat Cassium {i}somni{/i} ad contactum faciendum uti, malo te eo non uti.\""

# game/a3s1.rpy:36
translate latin a3s1_944a4845:

    # "Amicus kisses the top of my head as I let out a sigh of exasperation."
    "Amicus verticem meum osculatur dum taedio suspiro."

# game/a3s1.rpy:37
translate latin a3s1_30a921cb:

    # m "\"I didn't do it on purpose...and you said you'd believe me!\""
    m "\"Consulto non feci...et dixisti te mihi crediturum!\""

# game/a3s1.rpy:38
translate latin a3s1_5d0a26e6:

    # "Amicus lets out a chuckle that rumbles through his torso and into my back."
    "Amicus leniter ridet, sono per corpus eius in tergum meum resonante."

# game/a3s1.rpy:39
translate latin a3s1_26ca33a3:

    # "It's a comforting feeling and despite my annoyance, I find myself pressing deeper against him."
    "Sensus consolans est; quamquam irritatus sum, me artius ei premere invenio."

# game/a3s1.rpy:41
translate latin a3s1_1e5ff128:

    # a "\"I believe that you saw these things, but who can say if it was real, or not? Sometimes I have dreams of entities that I believe are the parents, but I don't necessarily believe it actually is them.\""
    a "\"Credo te haec vidisse; sed quis dicat utrum vera fuerint necne? Interdum de animantibus somnio quos Parentes esse puto; sed non necessario credo vere eos esse.\""

# game/a3s1.rpy:42
translate latin a3s1_155c8c29:

    # "I'm quiet for a moment, letting the silence drag out and I know Amicus well enough at this point that he's got his ears pointed up, waiting for me to respond."
    "Paulisper taceo, silentium protrahens; iam Amicum satis bene novi ut sciam eum auribus erectis responsum meum exspectare."

# game/a3s1.rpy:43
translate latin a3s1_8788cb63:

    # m "\"Trust me. Like seriously, you need to trust me on this Amicus.\""
    m "\"Mihi confide. Serio dico: hac in re mihi confidere debes, Amice.\""

# game/a3s1.rpy:45
translate latin a3s1_5e161dd0:

    # "Amicus spends his own moment being quiet, resting his cheek against my head, contemplating."
    "Amicus quoque paulisper tacet, genam capiti meo imponens, deliberans."

# game/a3s1.rpy:46
translate latin a3s1_21d11a63:

    # m "\"DO you trust me?\""
    m "\"Mihi VERE confidis?\""

# game/a3s1.rpy:47
translate latin a3s1_d72e4a9b:

    # "There's only a short pause."
    "Breve tantum silentium est."

# game/a3s1.rpy:49
translate latin a3s1_b0849aad:

    # a "\"Alright, yes. I do trust you.\""
    a "\"Bene, ita. Tibi vere confido.\""

# game/a3s1.rpy:50
translate latin a3s1_82abc784:

    # "There's a sense of conviction in his voice, and I can tell that he really is determined to believe me."
    "Fides in voce eius est; intellego eum vere statuisse mihi credere."

# game/a3s1.rpy:51
translate latin a3s1_b12e64e7:

    # m "\"Thank you. But I only say that because of something else that happened.\""
    m "\"Gratias. Sed hoc tantum dico ob aliam rem quae accidit.\""

# game/a3s1.rpy:52
translate latin a3s1_ac78218d:

    # a "\"What was that?\""
    a "\"Quid illud erat?\""

# game/a3s1.rpy:53
translate latin a3s1_a5e8d1c4:

    # "I take a deep breath."
    "Alte spiro."

# game/a3s1.rpy:54
translate latin a3s1_e371ffc3:

    # "Amicus, sensing my anxiety, suddenly turns me in his lap to face him, letting me lay my head against his chest as he pets the side of my face."
    "Amicus, sollicitudinem meam sentiens, subito me in gremio ad se vertit, sinens me caput pectori eius imponere dum latus faciei meae mulcet."

# game/a3s1.rpy:56
translate latin a3s1_b53404f6:

    # a "\"Hey, you can tell me anything, [mc]. Like I said, I believe you.\""
    a "\"Heus, quidlibet mihi dicere potes, [mc]. Ut dixi, tibi credo.\""

# game/a3s1.rpy:57
translate latin a3s1_0fe353cc:

    # "He says it even more firmly this time, tipping his muzzle down to look at me as I look up at him, meeting eyes."
    "Hoc tempore etiam firmius dicit, rostro demisso ut me spectet dum ad eum suspicio, oculis inter se occurrentibus."

# game/a3s1.rpy:58
translate latin a3s1_f7ba4b10:

    # m "\"Alright, so I was in the archives with Virginia yesterday—\""
    m "\"Bene, heri in archivis cum Virginia eram—\""

# game/a3s1.rpy:60
translate latin a3s1_984a27ed:

    # "Amicus's eyes widen."
    "Oculi Amici dilatantur."

# game/a3s1.rpy:61
translate latin a3s1_231b3cd8:

    # a "\"The archives? What were you doing in there?\""
    a "\"Archiva? Quid ibi agebas?\""

# game/a3s1.rpy:62
translate latin a3s1_ba1885aa:

    # "This reminds me that I also need to tell Amicus about what we've been plotting this past week."
    "Hoc me admonet me Amico quoque narrare debere quid superiore hebdomada paraverimus."

# game/a3s1.rpy:63
translate latin a3s1_7e431881:

    # m "\"I'll tell you in a bit, but something happened when I was...hooked up to the machine."
    m "\"Mox tibi dicam, sed aliquid accidit cum...machinae conexus eram."

# game/a3s1.rpy:64
translate latin a3s1_4f42936a:

    # a "\"You connected with it? Why woul—\""
    a "\"Ei te conexuisti? Cur—\""

# game/a3s1.rpy:65
translate latin a3s1_694e15fe:

    # m "\"In a bit. Anyway, while I was hooked up, I had another vision from the parents.\""
    m "\"Mox. Ceterum, dum conexus eram, aliam visionem a Parentibus vidi.\""

# game/a3s1.rpy:66
translate latin a3s1_a08fc22a:

    # "Amicus thinks."
    "Amicus cogitat."

# game/a3s1.rpy:68
translate latin a3s1_ed5feb10:

    # a "\"Well...I suppose that would make more sense considering that's the way the emperor speaks with them...but it's only the emperor they speak to.\""
    a "\"Bene...credo id magis intellegi posse, quia ita imperator cum eis loquitur...sed tantum imperatori loquuntur.\""

# game/a3s1.rpy:69
translate latin a3s1_50b16890:

    # m "\"Yeah, well, for whatever reason they started talking to me...actually YOU started talking to me.\""
    m "\"Ita, sed nescio cur mecum loqui coeperunt...revera TU mecum loqui coepisti.\""

# game/a3s1.rpy:71
translate latin a3s1_744af5aa:

    # a "\"Me?\""
    a "\"Ego?\""

# game/a3s1.rpy:72
translate latin a3s1_890cf66c:

    # m "\"I think so. You were like, yelling, telling me that you didn't want me to leave you.\""
    m "\"Credo. Quasi clamabas, dicens te nolle me te relinquere.\""

# game/a3s1.rpy:74
translate latin a3s1_96136525:

    # a "\"Oh, well, that does sound like something I would say in such a situation.\""
    a "\"O, bene, id simile est verbis quae in tali condicione dicerem.\""

# game/a3s1.rpy:75
translate latin a3s1_7cd1124e:

    # m "\"But you sounded really scared and sad, and I felt like I couldn't breathe; my throat hurt and just felt weird.\""
    m "\"Sed vere territus ac tristis sonabas, et mihi videbatur me spirare non posse; guttur dolebat atque alienum sentiebatur.\""

# game/a3s1.rpy:77
translate latin a3s1_fea09bf9:

    # a "\"Hmmm...\""
    a "\"Hmmm...\""

# game/a3s1.rpy:78
translate latin a3s1_a9fe4775:

    # "Amicus seems to contemplate all of this, but doesn't say anything more."
    "Amicus omnia haec deliberare videtur, sed nihil amplius dicit."

# game/a3s1.rpy:79
translate latin a3s1_1a649b9c:

    # "I start to get frustrated, but I realize that I can't really expect him to offer more information that I don't already know."
    "Irritari incipio, sed intellego me non posse vere exspectare eum plus indicare quam iam scio."

# game/a3s1.rpy:80
translate latin a3s1_282a97f0:

    # "I guess I had hoped that he would have more insight into why parents do things the way that they do."
    "Credo me speravisse eum melius intellegere cur Parentes res sic agant."

# game/a3s1.rpy:81
translate latin a3s1_676525a0:

    # "But really, I'm on my own figuring this all out."
    "Sed vere solus haec omnia intellegere debeo."

# game/a3s1.rpy:82
translate latin a3s1_34e90a2d:

    # "I sigh and lean my head against the wolf's chest."
    "Suspiro et caput pectori lupi impono."

# game/a3s1.rpy:84
translate latin a3s1_38957971:

    # a "\"Hey, what's wrong? I'm sure you'll be fine. The parents are very mysterious. My father had several visions he had trouble interpreting.\""
    a "\"Heus, quid mali est? Certus sum res tibi bene cessuras. Parentes arcani sunt. Pater meus aliquot visiones habuit quas aegre interpretabatur.\""

# game/a3s1.rpy:85
translate latin a3s1_6ac698b4:

    # m "\"I just—I feel like something bad is going to happen, like really bad, and I don't know what it is that I should do to stop it.\""
    m "\"Tantum—sentio aliquid mali, immo gravissimi, mox futurum esse, nec scio quid facere debeam ut prohibeam.\""

# game/a3s1.rpy:86
translate latin a3s1_12750f9d:

    # a "\"Did they give you any guidance at all?\""
    a "\"Ullum consilium tibi dederunt?\""

# game/a3s1.rpy:87
translate latin a3s1_1fa4cd80:

    # m "\"They just said to give in to their 'benevolent will', or something like that.\""
    m "\"Tantum dixerunt me 'benevolae voluntati' suae cedere debere, vel aliquid tale.\""

# game/a3s1.rpy:89
translate latin a3s1_b2c3224f:

    # "Amicus gently pushes me back so that he can look at me directly before he smiles gently."
    "Amicus me leniter retrudit ut recta me spectare possit, deinde leniter subridet."

# game/a3s1.rpy:90
translate latin a3s1_9b011068:

    # a "\"Well, there's your answer. The parents only want what is best for all of us. Just follow their guidance, keep your mind and heart open to them and all will turn out as it should.\""
    a "\"Bene, ibi responsum tuum est. Parentes tantum id volunt quod omnibus nobis optimum est. Consilia eorum sequere, mentem corque eis aperta tene, et omnia sicut debent evenient.\""

# game/a3s1.rpy:91
translate latin a3s1_951e3b1d:

    # "Those sentences wouldn't be out of place during a sermon in a church on Earth, and I'm reminded again how these parents really are seen as gods."
    "Illa verba a sermone in ecclesia terrestri non aliena essent; rursus admoneor hos Parentes vere ut deos videri."

# game/a3s1.rpy:92
translate latin a3s1_881d957d:

    # "It's a comforting thought that I could just do as they say and be just fine, made all the more comforting by Amicus's smile and confidence in the matter."
    "Consolans est cogitatio me tantum facere posse quod dicant atque incolumem fore; etiam magis consolatur arrisus Amici eiusque fiducia in hac re."

# game/a3s1.rpy:93
translate latin a3s1_203de7b4:

    # "But there's a nagging feeling in the back of my mind, that there's more to the parents than the wolves seem to know."
    "Sed in mente mea sollicitudo manet: plura de Parentibus esse quam Lupi scire videantur."

# game/a3s1.rpy:94
translate latin a3s1_8fea60df:

    # "I lower my voice a bit."
    "Vocem paulum demitto."

# game/a3s1.rpy:95
translate latin a3s1_af278700:

    # m "\"I just...I just don't know if I trust them.\""
    m "\"Tantum...tantum nescio num eis confidam.\""

# game/a3s1.rpy:97
translate latin a3s1_a750297b:

    # "Amicus laughs, and that actually does annoy me."
    "Amicus ridet, et hoc vere me irritat."

# game/a3s1.rpy:98
translate latin a3s1_4077938e:

    # m "\"Hey, I'm serious. There's something off about all of this, like the way they're going about things. If they want me to do something then they should just tell me instead of showing me scary visions.\""
    m "\"Heus, serio dico. Aliquid alienum in his omnibus est, velut modus quo res agunt. Si me aliquid facere volunt, tantum dicere debent, pro eo quod visiones terribiles ostendant.\""

# game/a3s1.rpy:100
translate latin a3s1_2535486d:

    # "Amicus forces himself to stop laughing and clears his throat, trying to look serious."
    "Amicus se ridere desinere cogit et guttur purgat, gravis videri conatus."

# game/a3s1.rpy:102
translate latin a3s1_5d002496:

    # a "\"I'm sorry, [mc], I just sometimes forget that you are outside the {i}Galaxias{/i} and aren't accustomed to these things. The parents are nothing but benevolence and goodwill.\""
    a "\"Ignosce, [mc]; tantum interdum obliviscor te extra {i}Galaxias{/i} esse, nec his rebus adsuevisse. Parentes nihil nisi benevolentia et bona voluntas sunt.\""

# game/a3s1.rpy:103
translate latin a3s1_0a863382:

    # a "\"We all feel their guidance in our lives, even if we're not able to speak to them directly like the emperor. The fact that you are able to do so is an incredible honor. You should happy, not worried.\""
    a "\"Omnes consilia eorum in vita sentimus, etiamsi non sicut imperator recta cum eis loqui possumus. Quod tu potes, incredibilis honor est. Gaudere debes, non sollicitari.\""

# game/a3s1.rpy:104
translate latin a3s1_48a9d6a0:

    # "Amicus strokes my hair."
    "Amicus capillos meos mulcet."

# game/a3s1.rpy:105
translate latin a3s1_8841b0b1:

    # m "\"Yeah but don't you think me being an outsider gives me a different perspective on all of this? What if they aren't what they say they are?\""
    m "\"Ita, sed nonne putas me alienigenam haec omnia aliter spectare posse? Quid si non sunt id quod se esse dicunt?\""

# game/a3s1.rpy:107
translate latin a3s1_08b6f031:

    # a "\"They are, and have no reason not to be.\""
    a "\"Sunt, nec ulla causa est cur non sint.\""

# game/a3s1.rpy:108
translate latin a3s1_1f7a9e79:

    # "Amicus's voice becomes more firm, and I can tell that he's starting to become uncomfortable with my questions."
    "Vox Amici firmior fit; intellego eum quaestionibus meis vexari incipere."

# game/a3s1.rpy:109
translate latin a3s1_3373407d:

    # a "\"My advice to you? Listen to them. They will help you...and maybe even figure out a way to get us out of this mess.\""
    a "\"Consilium meum? Eos audi. Te adiuvabunt...et fortasse etiam viam invenient qua ex his malis nos eripiant.\""

# game/a3s1.rpy:111
translate latin a3s1_2bb391cc:

    # a "\"Besides, it's a great relief to know that you may be here for a reason. I'm starting to think I was meant to find you.\""
    a "\"Praeterea magnum levamen est scire te fortasse ob causam hic esse. Credere incipio me ad te inveniendum destinatum esse.\""

# game/a3s1.rpy:112
translate latin a3s1_42834070:

    # "Amicus hugs me again."
    "Amicus rursus me amplectitur."

# game/a3s1.rpy:113
translate latin a3s1_505e511f:

    # "I decide not to press further."
    "Statuo me non amplius urgere."

# game/a3s1.rpy:114
translate latin a3s1_e85662c4:

    # "I love and trust Amicus, but he's clearly on board with anything to do with the parents, and I doubt I'd be able to make him question that."
    "Amicum amo eique confido, sed clare omnia ad Parentes pertinentia probat; dubito me eum de eis dubitare facere posse."

# game/a3s1.rpy:115
translate latin a3s1_47bc4efb:

    # "Not that I really want to anyway, I just worry that I'm being lead down a path that I really don't want to go down."
    "Ne vere quidem id volo; tantum timeo ne per viam ducar quam omnino ingredi nolo."

# game/a3s1.rpy:117
translate latin a3s1_335ca6e6:

    # a "\"Oh, [mc].\""
    a "\"O, [mc].\""

# game/a3s1.rpy:118
translate latin a3s1_040319e3:

    # "Amicus, clearly sensing my continuing anxiety, pulls me forward to kiss me."
    "Amicus, sollicitudinem meam persistentem clare sentiens, me ad se trahit ut osculetur."

# game/a3s1.rpy:119
translate latin a3s1_6df4255a:

    # "I kiss back, and it feels good even though my stomach continues to churn."
    "Vicissim osculor, et suave est quamquam venter meus adhuc torquetur."

# game/a3s1.rpy:120
translate latin a3s1_7a61a916:

    # com "\"Ten minutes remaining, [mc].\""
    com "\"Decem minuta restant, [mc].\""

# game/a3s1.rpy:122
translate latin a3s1_fbccefbd:

    # "Com uses his loud voice to call down to us from the top of the ladder."
    "Computatrum magna voce e summis scalis ad nos clamat."

# game/a3s1.rpy:123
translate latin a3s1_af62ac39:

    # "Amicus and I sigh in unified frustration."
    "Amicus et ego pari taedio suspiramus."

# game/a3s1.rpy:125
translate latin a3s1_59b27c3f:

    # a "\"Ummm...want to have a little fun before you go?\""
    a "\"Ehm...paulum oblectari vis antequam abeas?\""

# game/a3s1.rpy:126
translate latin a3s1_48ef8e5c:

    # "I look down, and I'm kind of amazed to see that he still has a boner, which makes me wonder how much he'd really been engaged in our conversation."
    "Deorsum specto et aliquantum miror eum adhuc erectam mentulam habere; miror quantum vere sermoni nostro animum adhibuerit."

# game/a3s1.rpy:127
translate latin a3s1_827e5871:

    # m "\"I have to tell you—\""
    m "\"Tibi dicere debeo—\""

# game/a3s1.rpy:128
translate latin a3s1_378f8142:

    # "I catch myself and lower my voice."
    "Me contineo et vocem demitto."

# game/a3s1.rpy:129
translate latin a3s1_e1f6dca5:

    # m "\"—what we've been doing to get you out.\""
    m "\"—quid fecerimus ut te liberemus.\""

# game/a3s1.rpy:131
translate latin a3s1_e0f94c54:

    # a "\"You can do that...and other things at the same time.\""
    a "\"Id facere potes...atque alia simul.\""

# game/a3s1.rpy:132
translate latin a3s1_da21de04:

    # "Amicus tries not to look too eager."
    "Amicus conatur ne nimis cupidus videatur."

# game/a3s1.rpy:133
translate latin a3s1_06e3ddd2:

    # "I roll my eyes but press my hand against his chest and draw it slowly down the wolf's front, over the curve of his stomach."
    "Oculos volvo, sed manum pectori eius premo et lente per anteriorem lupi partem, per curvam ventris formam, duco."

# game/a3s1.rpy:134
translate latin a3s1_94f45fb8:

    # "He immediately moans quietly as I reach the lower part of his abdomen and I see the bulge jump in his underwear as his hips even thrust up a bit too."
    "Statim leniter gemit cum ad imum ventrem pervenio; tumorem in subligaculo subsilire video, coxis etiam paulum sursum impulsis."

# game/a3s1.rpy:135
translate latin a3s1_47a2d334:

    # "I laugh at his eagerness, and I have to admit that it's kind of nice to have something more light-hearted to do while I discuss all of these troubling issues with my wolf."
    "Cupiditati eius arrideo et fateor satis gratum esse rem leviorem agere posse, dum de his omnibus sollicitantibus rebus cum lupo meo disputo."

# game/a3s1.rpy:139
translate latin a3s1_25eecf92:

    # "For the next little while, I walk around the gardens, taking advantage of the mild weather."
    "Aliquamdiu postea per hortos ambulo, miti tempestate usus."

# game/a3s1.rpy:140
translate latin a3s1_7b44d987:

    # "I've noticed it's become cooler and less humid over the past week, which is nice."
    "Animadverti superiore hebdomada frigidius et minus umidum factum esse, quod gratum est."

# game/a3s1.rpy:141
translate latin a3s1_5d49f129:

    # "Apparently this is as cold as it gets on this part of Adastra though, and it never snows."
    "Sed haec pars Adastrae, ut videtur, non frigidior fit, et numquam ningit."

# game/a3s1.rpy:142
translate latin a3s1_2f50ad46:

    # "I sigh and sit on a bench, thinking back on my meeting with Amicus just an hour ago."
    "Suspiro et in scamno sedeo, conventum cum Amico ante horam tantum factum reminiscens."

# game/a3s1.rpy:143
translate latin a3s1_61128eac:

    # "It had been easier to say goodbye to the wolf this time, especially now that I know Cassius is willing to let us see each other as much as is possible."
    "Hoc tempore lupo valedicere facilius erat, maxime nunc cum sciam Cassium paratum esse sinere nos quam saepissime alterum alterum videre."

# game/a3s1.rpy:144
translate latin a3s1_6a9a3012:

    # "That being whenever Cato is out, which is good, because he's gone a lot of the time doing his \"official business\", or whatever."
    "Id est, quoties Cato abest, quod bonum est, quia saepe in \"negotio publico\" suo occupatus abest, vel quidquid est."

# game/a3s1.rpy:145
translate latin a3s1_2f57f6ba:

    # "Amicus, once again, had recommended I distance myself from the plotting so as not to get caught up if we get exposed."
    "Rursus Amicus monuerat ut a consiliis me removerem, ne implicarer si patefierent."

# game/a3s1.rpy:146
translate latin a3s1_74e7ead2:

    # "I reassure him even though I know I'm going to do whatever it takes to see this through, even if that means I will have to put myself in danger."
    "Eum confirmo, quamquam scio me quidquid opus sit facturum ut rem perficiam, etiamsi me ipsum periculo obicere debeam."

# game/a3s1.rpy:147
translate latin a3s1_eb70179d:

    # "I don't want Amicus to be down there for another day."
    "Nolo Amicum alterum diem ibi infra manere."

# game/a3s1.rpy:148
translate latin a3s1_5437916a:

    # "Just yesterday, Cassius...or Cato, banned all talk of Amicus on Adastra, which Neferu told me only caused the rumors to really start flying."
    "Heri tantum Cassius...aut Cato omnem de Amico sermonem in Adastra vetuit; Neferu mihi dixit id rumores vere excitavisse."

# game/a3s1.rpy:149
translate latin a3s1_6e2ad0b8:

    # "They range from Amicus being imprisoned (true), banished, or even executed."
    "Rumores eum in carcere esse dicunt, quod verum est, aut exsulem, aut etiam interfectum."

# game/a3s1.rpy:150
translate latin a3s1_e666b8be:

    # "This is good for us, I'm told, because the public, whether they liked Amicus or not, generally doesn't feel he should be struck from existence just because he lost the emperorship."
    "Hoc nobis bonum esse dicitur, quia populus, sive Amicum amabat sive non, plerumque non putat eum e vita tollendum tantum quia imperium amisit."

# game/a3s1.rpy:151
translate latin a3s1_3b0dd29a:

    # "In other words, the people will likely be on our side when we finally reveal everything."
    "Aliis verbis, populus probabiliter nobiscum erit cum tandem omnia patefaciemus."

# game/a3s1.rpy:152
translate latin a3s1_5ec8a2cf:

    # "Hopefully."
    "Ut spero."

# game/a3s1.rpy:153
translate latin a3s1_b1b82c39:

    # "That's really all we can rely on considering the emperor holds so much power, even if the way it was achieved was illegitimate."
    "Hoc tantum sperare possumus, quia imperator tam multam potestatem habet, etiamsi eam illicite adeptus est."

# game/a3s1.rpy:154
translate latin a3s1_3ff457f2:

    # "The triumvirates barely check the emperor's power, so unless the people as a whole come together, it would be difficult to remove Cassius from the throne."
    "Triumviratus vix potestatem imperatoris continent; itaque nisi totus populus coniungitur, Cassium e throno removere difficile erit."

# game/a3s1.rpy:155
translate latin a3s1_c94d537e:

    # "If Cassius still refuses to step down, our options will be very limited, and most probably won't turn out well for me, or anyone here that's not part of the family."
    "Si Cassius adhuc abdicare recusat, paucae tantum viae nobis erunt; pleraeque probabiliter nec mihi nec cuiquam hic extra familiam bene evenient."

# game/a3s1.rpy:156
translate latin a3s1_45574f13:

    # "Still, Cassius is proud, very proud."
    "Tamen Cassius superbus, valde superbus est."

# game/a3s1.rpy:157
translate latin a3s1_9474d9c6:

    # "Neferu and Virginia think he'll either step down, or at least accept combat to go out with honor."
    "Neferu et Virginia putant eum aut abdicaturum aut saltem pugnam accepturum ut cum honore cedat."

# game/a3s1.rpy:158
translate latin a3s1_835d51c8:

    # "Hopefully the first because I really don't know how Amicus would deal with the idea of having to kill his brother."
    "Spero primum, quia vere nescio quomodo Amicus cogitationem fratris interficiendi ferat."

# game/a3s1.rpy:159
translate latin a3s1_3d5b68a2:

    # "I sigh and lean back on the bench, really getting frustrated with all of this political bullshit."
    "Suspiro et in scamno recumbo, vere his sordibus politicis irritatus."

# game/a3s1.rpy:160
translate latin a3s1_2f240717:

    # "This had been the exact type of thing Cassius wanted to get rid of, but now it just seems worse than ever."
    "Haec ipsa res erat quam Cassius tollere volebat; sed nunc peior quam umquam videtur."

# game/a3s1.rpy:162
translate latin a3s1_ebafde4f:

    # "Just as I'm thinking this, I see Alex."
    "Dum hoc cogito, Alex video."

# game/a3s1.rpy:163
translate latin a3s1_a6a8836d:

    # "He's just up the path, standing right in the middle of it..."
    "Paulo longius in semita est, recta in medio stans..."

# game/a3s1.rpy:165
translate latin a3s1_15c3cc0a:

    # "...and he's looking right at me."
    "...et recta me spectat."

# game/a3s1.rpy:166
translate latin a3s1_a02e75ac:

    # "I give a start, then just stare back at him."
    "Subsilio, deinde tantum vicissim eum specto."

# game/a3s1.rpy:167
translate latin a3s1_ad5682f7:

    # "He doesn't move, just goes on looking at me, and I start to wonder what the hell he's doing."
    "Non movetur, me spectare pergit; mirari incipio quid tandem agat."

# game/a3s1.rpy:168
translate latin a3s1_f25c5673:

    # "He doesn't have his usual smile on either, and as a soft breeze blows through the leaves and foliage, I start to feel like I'm in some kind of horror movie."
    "Ne solitum quidem arrisum habet; dum lenis aura per folia frondesque fluit, quasi in pellicula terroris esse incipio sentire."

# game/a3s1.rpy:169
translate latin a3s1_711430e4:

    # "Actually, now that I know who he really is, I do start to feel a little concerned about what he's capable of."
    "Revera, nunc cum sciam quis vere sit, aliquantum sollicitari incipio quid facere possit."

# game/a3s1.rpy:170
translate latin a3s1_c6cebebf:

    # "So I decide to act casual and stand up, raising a hand and walking over to the cat."
    "Itaque statuo me otiosum simulare et surgo, manum tollens atque ad felem ambulans."

# game/a3s1.rpy:171
translate latin a3s1_64934fe8:

    # m "\"Hey, Alex.\""
    m "\"Salve, Alex.\""

# game/a3s1.rpy:172
translate latin a3s1_fc82cd96:

    # al "\"Alexios will do, [mc].\""
    al "\"Alexios sufficiet, [mc].\""

# game/a3s1.rpy:173
translate latin a3s1_6f742d16:

    # m "\"Um, okay. Hi Alexios.\""
    m "\"Ehm, bene. Salve, Alexios.\""

# game/a3s1.rpy:174
translate latin a3s1_961f3a23:

    # al "\"Ahhotep be with you, [mc].\""
    al "\"Ahhotep tecum sit, [mc].\""

# game/a3s1.rpy:175
translate latin a3s1_df8ec4bc:

    # m "\"What?\""
    m "\"Quid?\""

# game/a3s1.rpy:176
translate latin a3s1_3cc498ea:

    # al "\"I feel things should be more formal between us from now on, that is all.\""
    al "\"Puto res inter nos posthac sollemniores esse debere, nihil amplius.\""

# game/a3s1.rpy:177
translate latin a3s1_ef9d105c:

    # m "\"No, I mean why that greeting?\""
    m "\"Non, quaero cur illa salutatio?\""

# game/a3s1.rpy:178
translate latin a3s1_fb3a4df7:

    # "I'd heard Neferu use it many times, but no one else."
    "Neferu saepe ea uti audiveram, sed neminem alium."

# game/a3s1.rpy:179
translate latin a3s1_b7cb27d5:

    # al "\"You are a Khemian, are you not?\""
    al "\"Khemianus es, nonne?\""

# game/a3s1.rpy:180
translate latin a3s1_abde442e:

    # "That gives me pause."
    "Hoc me haerere facit."

# game/a3s1.rpy:181
translate latin a3s1_3c34ffc2:

    # m "\"Oh, yeah, I guess I am.\""
    m "\"O, ita, credo me esse.\""

# game/a3s1.rpy:183
translate latin a3s1_5b29b57c:

    # "The cat smirks."
    "Felis callide subridet."

# game/a3s1.rpy:184
translate latin a3s1_d1c141f9:

    # al "\"Odd. You seem to have forgotten your own citizenship.\""
    al "\"Mirum. Civitatis tuae oblitus videris.\""

# game/a3s1.rpy:185
translate latin a3s1_8619f2c6:

    # "I shrug."
    "Umeros tollo."

# game/a3s1.rpy:186
translate latin a3s1_06cfe8ed:

    # m "\"Still getting used to it.\""
    m "\"Adhuc ei adsuesco.\""

# game/a3s1.rpy:188
translate latin a3s1_661ddda5:

    # al "\"I mean, it's something that even some siblings desire, not to mention children...or even the uncontacted.\""
    al "\"Dico eam rem esse quam etiam nonnulli Fratres cupiunt, ne dicam Liberos...aut eos quibus nondum contactus factus est.\""

# game/a3s1.rpy:189
translate latin a3s1_09722dcb:

    # "I raise an eyebrow."
    "Supercilium tollo."

# game/a3s1.rpy:190
translate latin a3s1_e7ba2733:

    # m "\"That so?\""
    m "\"Itane?\""

# game/a3s1.rpy:191
translate latin a3s1_f9042ce0:

    # al "\"Certainly. Who wouldn't want to be part of the most spoiled civilization in the galaxy?\""
    al "\"Certe. Quis partem mollissimae civilizationis in galaxia esse nolit?\""

# game/a3s1.rpy:192
translate latin a3s1_484b7fd7:

    # "I sigh, still tired from thinking about all of this political maneuvering."
    "Suspiro, adhuc cogitatione harum omnium machinationum politicarum defatigatus."

# game/a3s1.rpy:193
translate latin a3s1_57ca372b:

    # "Playing games with Alexios is the last thing I want to do right now."
    "Cum Alexios ludere ultima res est quam nunc facere volo."

# game/a3s1.rpy:194
translate latin a3s1_1a1083b5:

    # m "\"Cut the bullshit, Alex. What do you want?\""
    m "\"Omitte nugas, Alex. Quid vis?\""

# game/a3s1.rpy:196
translate latin a3s1_4e17c6e7:

    # al "\"Excuse me?\""
    al "\"Quid ais?\""

# game/a3s1.rpy:197
translate latin a3s1_c78583d8:

    # m "\"You're excused.\""
    m "\"Tibi ignoscitur.\""

# game/a3s1.rpy:198
translate latin a3s1_e04d1fab:

    # "I walk past the cat, listening to him sputter in surprise."
    "Praeter felem ambulo, eum prae admiratione verba confusa edentem audiens."

# game/a3s1.rpy:200
translate latin a3s1_3de930f5:

    # al "\"You...you have some nerve to talk to a sibling like that.\""
    al "\"Tu...satis audax es ut Fratri ita loquaris.\""

# game/a3s1.rpy:201
translate latin a3s1_86947c99:

    # "I frown, glancing back."
    "Vultum contraho et respicio."

# game/a3s1.rpy:202
translate latin a3s1_05a92a30:

    # m "\"What's that supposed to mean?\""
    m "\"Quid id significare debet?\""

# game/a3s1.rpy:203
translate latin a3s1_c2b304eb:

    # al "\"You're...you're not even a child, yet you throw your weight around here like you're the most important person in the palace.\""
    al "\"Ne...ne Liber quidem es; tamen hic ita te iactas quasi gravissimus homo in palatio sis.\""

# game/a3s1.rpy:204
translate latin a3s1_833adc77:

    # "I laugh, loud."
    "Clare rideo."

# game/a3s1.rpy:205
translate latin a3s1_8c940ed6:

    # "I see the cat's ears pin back."
    "Aures felis retrorsum deprimi video."

# game/a3s1.rpy:206
translate latin a3s1_ec67eea8:

    # m "\"Are you fucking kidding me? All of you assholes have been throwing ME around with all your plots and fake niceties. I'm just trying to survive.\""
    m "\"Mecumne, mehercule, ludis? Omnes vos fututores ME huc illuc iactastis consiliis vestris atque fictis urbanitatibus. Tantum vivere conor.\""

# game/a3s1.rpy:207
translate latin a3s1_a7f742dd:

    # m "\"Also, last I checked, Khemians are all equal, so I don't really give a shit if you're a sibling.\""
    m "\"Etiam, quantum novi, omnes Khemiani aequales sunt; itaque nihil curo si Frater es.\""

# game/a3s1.rpy:209
translate latin a3s1_45fe45b4:

    # "Alex looks completely taken aback, which is completely satisfying."
    "Alex omnino attonitus videtur, quod valde me delectat."

# game/a3s1.rpy:210
translate latin a3s1_33d364e2:

    # m "\"And haven't you always implied that the wolves are fucked up for looking down on their children and treating them like slaves?\""
    m "\"Et nonne semper innuisti Lupos pessimos esse quod Liberos suos despiciunt atque ut servos tractant?\""

# game/a3s1.rpy:211
translate latin a3s1_8cef5105:

    # "Alex coughs to clear his throat."
    "Alex tussit ut guttur purget."

# game/a3s1.rpy:213
translate latin a3s1_c31822b3:

    # al "\"My apologies, I simply lost my temper for a moment. You were just being a bit rude.\""
    al "\"Veniam peto; tantum paulisper iratus sum. Tu paulum inurbanus eras.\""

# game/a3s1.rpy:214
translate latin a3s1_fd90d16a:

    # m "\"Or maybe deep down you're just as...speciesist, or whatever, as the wolves, even though you try to pretend you're not...Neferu's the same way.\""
    m "\"Aut fortasse penitus tam...specierum contemptor es, vel quidquid, quam Lupi, etiamsi te non esse simulas...Neferu idem est.\""

# game/a3s1.rpy:215
translate latin a3s1_173cf1eb:

    # "Even I'm surprising myself a little."
    "Etiam me ipsum paulum miror."

# game/a3s1.rpy:216
translate latin a3s1_e5c9da8a:

    # "It's like the lid has finally blown off and I'm just using Alex to vent all of my frustrations with this place."
    "Quasi operculum tandem avolavit; tantum Alex utor ut omne taedium huius loci effundam."

# game/a3s1.rpy:218
translate latin a3s1_43201a23:

    # al "\"What has gotten into you, [mc]?\""
    al "\"Quid tibi accidit, [mc]?\""

# game/a3s1.rpy:219
translate latin a3s1_f98281fd:

    # "There's a long pause, and I finally sigh, rubbing my face."
    "Longum silentium est; tandem suspiro, faciem fricans."

# game/a3s1.rpy:220
translate latin a3s1_4e1ecaa1:

    # m "\"Sorry, I'm just...I think I'm losing my mind here.\""
    m "\"Ignosce, tantum...credo me hic insanire.\""

# game/a3s1.rpy:222
translate latin a3s1_52515f5e:

    # "For the first time in a while, I see the cat crack a genuine smile."
    "Primum post aliquod tempus verum arrisum felis video."

# game/a3s1.rpy:223
translate latin a3s1_8d19dc53:

    # al "\"I can tell you then that you're not meant to be a diplomat.\""
    al "\"Ergo tibi dicere possum te ad legationem gerendam parum idoneum esse.\""

# game/a3s1.rpy:224
translate latin a3s1_002de6d3:

    # m "\"Definitely not.\""
    m "\"Certe non.\""

# game/a3s1.rpy:225
translate latin a3s1_cd801e84:

    # "For a moment, I feel that old, familiar kinship I had with the cat not even a few weeks ago."
    "Paulisper veterem familiaremque necessitudinem sentio quam cum fele paucis tantum hebdomadis abhinc habebam."

# game/a3s1.rpy:226
translate latin a3s1_5ebfe083:

    # "I do believe that in any other situation, in one where we're not all spies, Alex and I could have been really good friends."
    "Vere credo in alia condicione, qua non omnes exploratores essemus, Alex et me optimos amicos esse potuisse."

# game/a3s1.rpy:227
translate latin a3s1_4e10057f:

    # "I know that can't be the case now though, so I stop smiling and look Alexios right in the eye."
    "Sed scio nunc id fieri non posse, itaque subridere desino et recta in oculos Alexios specto."

# game/a3s1.rpy:228
translate latin a3s1_4fbb9329:

    # m "\"But seriously, what do you want? I can tell you're trying to get something out of me.\""
    m "\"Sed serio, quid vis? Intellego te aliquid a me elicere conari.\""

# game/a3s1.rpy:229
translate latin a3s1_3e312e4c:

    # "Alex becomes serious too, smile fading."
    "Alex quoque gravis fit, arrisu evanescente."

# game/a3s1.rpy:231
translate latin a3s1_bf55e9f6:

    # "He considers me for a long while, probably realizing that I'm not going to play his little game."
    "Diu me considerat, probabiliter intellegens me ludo eius parvo non interfuturum."

# game/a3s1.rpy:232
translate latin a3s1_2b77e86d:

    # al "\"Alright, [mc], who are you? I know you're not an abandoned child. What is it that you want and what are you doing here?\""
    al "\"Bene, [mc], quis es? Scio te Liberum desertum non esse. Quid vis, et quid hic agis?\""

# game/a3s1.rpy:233
translate latin a3s1_3215e217:

    # m "\"So you want to know everything?\""
    m "\"Ergo omnia scire vis?\""

# game/a3s1.rpy:234
translate latin a3s1_8c7583c6:

    # al "\"Yes.\""
    al "\"Ita.\""

# game/a3s1.rpy:235
translate latin a3s1_f53aa243:

    # m "\"And why should I tell you?\""
    m "\"Et cur tibi dicam?\""

# game/a3s1.rpy:236
translate latin a3s1_739032d2:

    # "Alex smirks."
    "Alex callide subridet."

# game/a3s1.rpy:238
translate latin a3s1_7d138169:

    # al "\"Why be blunt if we're going to play the game anyway, [mc]?\""
    al "\"Cur aperte dicamus si tamen ludum agemus, [mc]?\""

# game/a3s1.rpy:239
translate latin a3s1_00682048:

    # m "\"I'm just curious as to why you're so curious. I hardly matter in all of this.\""
    m "\"Tantum miror cur tam curiosus sis. Vix quidquam in his omnibus valeo.\""

# game/a3s1.rpy:241
translate latin a3s1_007b4740:

    # al "\"That is a complete lie. Everything has changed here since you arrived. This is why I want to know.\""
    al "\"Id omnino mendacium est. Omnia hic mutata sunt postquam venisti. Ideo scire volo.\""

# game/a3s1.rpy:242
translate latin a3s1_b18d4dfc:

    # m "\"But why does it matter that you know?\""
    m "\"Sed cur refert te scire?\""

# game/a3s1.rpy:243
translate latin a3s1_459e85cd:

    # al "\"I am an important link between Omorfa and Adastra. It is my job to know what is happening in this empire.\""
    al "\"Magnum vinculum inter Omorfam et Adastram sum. Officium meum est scire quid in hoc imperio accidat.\""

# game/a3s1.rpy:244
translate latin a3s1_54754d56:

    # m "\"Uh-huh, so who told you I'm uncontacted...Cassius?\""
    m "\"Ita, ergo quis tibi dixit mihi nondum contactum factum esse...Cassius?\""

# game/a3s1.rpy:245
translate latin a3s1_9093d1b1:

    # al "\"You've deduced correctly. But I also know that the monitors seem to approve of it...which is rather odd.\""
    al "\"Recte conclusisti. Sed etiam scio Monitores id probare videri...quod satis mirum est.\""

# game/a3s1.rpy:246
translate latin a3s1_8619f2c6_1:

    # "I shrug."
    "Umeros tollo."

# game/a3s1.rpy:247
translate latin a3s1_81ecaded:

    # m "\"Again, I don't know what's going on. Anyway, I don't see why I'd tell you anything if I don't know anything about you.\""
    m "\"Rursus, nescio quid accidat. Ceterum, non video cur quidquam tibi dicam, si nihil de te scio.\""

# game/a3s1.rpy:249
translate latin a3s1_e6feb859:

    # al "\"Why, I'm just a simple pet. I don't know anything that's going on.\""
    al "\"Quia tantum simplices deliciae sum. Nihil scio de iis quae accidunt.\""

# game/a3s1.rpy:250
translate latin a3s1_a7a847e1:

    # "His tone of voice tells me that he's mocking me."
    "Vox eius mihi ostendit eum me irridere."

# game/a3s1.rpy:251
translate latin a3s1_46646205:

    # "I raise an eyebrow, but don't say anything."
    "Supercilium tollo, sed nihil dico."

# game/a3s1.rpy:252
translate latin a3s1_ab09fa2f:

    # "Alex sighs."
    "Alex suspirat."

# game/a3s1.rpy:256
translate latin a3s1_c912da87:

    # al "\"The simplest way I can explain it is that I'm trying to maintain peace in the {i}Galaxias{/i} as a whole. That mainly involves watching the motives of the wolves.\""
    al "\"Simplicissime sic explicare possum: pacem in tota {i}Galaxias{/i} servare conor. Hoc maxime consilia Luporum observare complectitur.\""

# game/a3s1.rpy:257
translate latin a3s1_51e734c7:

    # m "\"Why's that?\""
    m "\"Cur?\""

# game/a3s1.rpy:258
translate latin a3s1_075ca7ef:

    # al "\"Because...they can be dangerous.\""
    al "\"Quia...periculosi esse possunt.\""

# game/a3s1.rpy:259
translate latin a3s1_2e4d8030:

    # m "\"Okay. Are none of the other siblings dangerous?\""
    m "\"Bene. Nulli alii Fratres periculosi sunt?\""

# game/a3s1.rpy:260
translate latin a3s1_3fe8b354:

    # al "\"[mc], Adastra is the only civilization in the galaxy to wage war on another sibling in over ten millennia...and they were the perpetrators in the previous war as well.\""
    al "\"[mc], hoc temporis spatio, quod plus quam decem annorum milia complectitur, nulla civilizatio in galaxia praeter Adastram bellum alteri Fratri intulit...et in bello priore quoque Adastrani primi bellum intulerunt.\""

# game/a3s1.rpy:261
translate latin a3s1_78d31e3b:

    # al "\"Not only that, but they waged war on an almost parent-level civilization. They're suicidal, and I can't imagine why the Khemians want an alliance with them.\""
    al "\"Non solum hoc: bellum civilizationi paene ad Parentis gradum provectae intulerunt. Mortem sibi quaerunt; non possum fingere cur Khemiani foedus cum eis velint.\""

# game/a3s1.rpy:262
translate latin a3s1_a5ed7e8b:

    # "I think."
    "Cogito."

# game/a3s1.rpy:263
translate latin a3s1_447f3678:

    # m "\"Do you...not want the alliance to happen?\""
    m "\"Num...non vis foedus fieri?\""

# game/a3s1.rpy:264
translate latin a3s1_7c624495:

    # "This seems to go against what Alex would want."
    "Hoc voluntati Alex contrarium videtur."

# game/a3s1.rpy:265
translate latin a3s1_3ae16758:

    # "I thought he wanted Amicus to take the throne."
    "Putabam eum velle Amicum thronum obtinere."

# game/a3s1.rpy:266
translate latin a3s1_3e9519ef:

    # al "\"I want the {i}Galaxias{/i} to remain safe. Is the alliance something YOU want to happen?\""
    al "\"Volo {i}Galaxias{/i} incolumem manere. TU vis foedus fieri?\""

# game/a3s1.rpy:267
translate latin a3s1_b9dd0920:

    # "I frown, wondering why he's asking me."
    "Vultum contraho, miratus cur me roget."

# game/a3s1.rpy:268
translate latin a3s1_87c9f920:

    # m "\"I mean, to me it seems like it would create peace, so yeah.\""
    m "\"Dico mihi videri id pacem effecturum, itaque ita.\""

# game/a3s1.rpy:269
translate latin a3s1_4d4aebf0:

    # "Alex's eyes narrow, like he figured something out."
    "Oculi Alex contrahuntur, quasi aliquid compererit."

# game/a3s1.rpy:270
translate latin a3s1_33f2b476:

    # m "\"What, do you want the wolves to stay isolated?\""
    m "\"Quid, vis Lupos separatos manere?\""

# game/a3s1.rpy:271
translate latin a3s1_992721a1:

    # al "\"I just want order. The wolves have none of that.\""
    al "\"Tantum ordinem volo. Lupi nihil eius habent.\""

# game/a3s1.rpy:272
translate latin a3s1_1986a682:

    # "The silence stretches out between us."
    "Silentium inter nos extenditur."

# game/a3s1.rpy:273
translate latin a3s1_24977fa2:

    # al "\"I suppose you're still not going to tell me anything about yourself, then?\""
    al "\"Credo igitur te adhuc nihil de te mihi dicturum?\""

# game/a3s1.rpy:274
translate latin a3s1_a3d05969:

    # m "\"I didn't say I would, and there really isn't much to tell.\""
    m "\"Non dixi me dicturum, et vere pauca tantum sunt quae dicam.\""

# game/a3s1.rpy:275
translate latin a3s1_c63e5989:

    # al "\"How about this; how did you secure Khemian citizenship? That's not something that's just given out to children who are presumed to belong to wolves.\""
    al "\"Quid de hac re: quomodo civitatem Khemianam adeptus es? Non est res quae tantum Liberis, qui Luporum esse putantur, datur.\""

# game/a3s1.rpy:276
translate latin a3s1_f8a0d137:

    # "The question takes me by surprise, though this whole Khemian thing does seem to be what's bothering him most, especially after his greeting."
    "Quaestio me incautum deprehendit, quamquam tota haec res Khemiana maxime eum vexare videtur, praesertim post salutationem eius."

# game/a3s1.rpy:277
translate latin a3s1_f474fa27:

    # "I think, but the truth doesn't seem harmful here."
    "Cogito, sed verum hic nocere non videtur."

# game/a3s1.rpy:278
translate latin a3s1_5af9a43e:

    # m "\"Honestly, it was just to protect me from Cassius. He doesn't really like me, if you haven't noticed.\""
    m "\"Vere, tantum ut a Cassio protegerer. Me non vere amat, si non animadvertisti.\""

# game/a3s1.rpy:279
translate latin a3s1_54d8e5a2:

    # "The expression on Alex's face tells me that he definitely doesn't believe me."
    "Vultus Alex mihi ostendit eum certe mihi non credere."

# game/a3s1.rpy:280
translate latin a3s1_09f8a60f:

    # al "\"Cassius wouldn't harm you unless you did something that deserved it.\""
    al "\"Cassius te non laederet nisi aliquid fecisses quo merereris.\""

# game/a3s1.rpy:281
translate latin a3s1_9f9978b0:

    # m "\"He said he wanted to execute me because I back talked him and Amicus slapped his nose.\""
    m "\"Dixit se me interficere velle quia ei contradixi et Amicus nasum eius alapa percussit.\""

# game/a3s1.rpy:282
translate latin a3s1_f50b2242:

    # "Alex's ears flatten."
    "Aures Alex complanantur."

# game/a3s1.rpy:284
translate latin a3s1_eb77d870:

    # al "\"Cassius...says things. He's very passionate.\""
    al "\"Cassius...verba dicit. Valde ardens est.\""

# game/a3s1.rpy:285
translate latin a3s1_17ff052b:

    # m "\"That's one way to put it.\""
    m "\"Unus est modus rem dicendi.\""

# game/a3s1.rpy:286
translate latin a3s1_764358f1:

    # "I shift on my feet, starting to get tired of this conversation."
    "Pondus de pede in pedem transfero, hoc sermone fatigari incipiens."

# game/a3s1.rpy:287
translate latin a3s1_cbda873e:

    # m "\"Listen, I have nothing against you, Alex. I'm just trying to get through this as much as you are.\""
    m "\"Audi, nihil contra te habeo, Alex. Tantum sicut tu haec superare conor.\""

# game/a3s1.rpy:289
translate latin a3s1_855cd033:

    # al "\"Neferu gave you the citizenship, right?\""
    al "\"Neferu tibi civitatem dedit, recte?\""

# game/a3s1.rpy:290
translate latin a3s1_2f83ba8d:

    # m "\"Uhhh...yeah?\""
    m "\"Ehm...ita?\""

# game/a3s1.rpy:291
translate latin a3s1_5128d548:

    # al "\"And you're working with him to make the alliance a reality, correct?\""
    al "\"Et cum eo agis ut foedus re vera fiat, recte?\""

# game/a3s1.rpy:292
translate latin a3s1_e0f26b6c:

    # "That stops me."
    "Hoc me sistit."

# game/a3s1.rpy:293
translate latin a3s1_c894e91b:

    # m "\"What? No...no, I'm focused on Amicus right now.\""
    m "\"Quid? Non...non, nunc Amico animum adhibeo.\""

# game/a3s1.rpy:294
translate latin a3s1_b80c1de3:

    # "Alex glares."
    "Alex iratus spectat."

# game/a3s1.rpy:295
translate latin a3s1_33d3cc03:

    # al "\"Which is still part of the alliance.\""
    al "\"Quod adhuc pars foederis est.\""

# game/a3s1.rpy:296
translate latin a3s1_c9c1d786:

    # m "\"I guess so, but honestly that's not really my top priority right now.\""
    m "\"Credo, sed vere hoc nunc non mihi praecipuum est.\""

# game/a3s1.rpy:297
translate latin a3s1_083fd42f:

    # al "\"It is part of your top priority.\""
    al "\"Pars rei tuae praecipuae est.\""

# game/a3s1.rpy:298
translate latin a3s1_b8936ae0:

    # "I'm getting frustrated and I start to sidle off toward the palace."
    "Irritor et paulatim ad palatium recedere incipio."

# game/a3s1.rpy:299
translate latin a3s1_eab6a985:

    # m "\"Yeah, we established that. Listen, I'm gonna lay down. I'm tired.\""
    m "\"Ita, id iam statuimus. Audi, recubitum eo. Defatigatus sum.\""

# game/a3s1.rpy:301
translate latin a3s1_c2d4b0f5:

    # "Alex goes on staring and doesn't say anything."
    "Alex spectare pergit et nihil dicit."

# game/a3s1.rpy:302
translate latin a3s1_f0936355:

    # m "\"Again, I have nothing against you. I hope that we can just...go back to normal in the future once this is over, ya know?\""
    m "\"Rursus, nihil contra te habeo. Spero nos tantum...ad pristinas res redire posse postea, ubi hoc perfectum erit, scis?\""

# game/a3s1.rpy:303
translate latin a3s1_3daf9e96:

    # al "\"Indeed.\""
    al "\"Certe.\""

# game/a3s1.rpy:305
translate latin a3s1_f7b7d9e6:

    # "With that, Alex turns and walks away up the path, leaving me to stare after him."
    "Tum Alex se vertit et per semitam abit, me post eum spectantem relinquens."

# game/a3s1.rpy:309
translate latin a3s1_c218dc7f:

    # "I decide to ask Neferu about what happened with Alex."
    "Statuo me Neferu rogaturum de re cum Alex acta."

# game/a3s1.rpy:310
translate latin a3s1_813a6044:

    # "I know they had some kind of relationship going on, so maybe he can enlighten me on the cat's motives."
    "Scio aliquam necessitudinem inter eos fuisse, itaque fortasse consilia felis mihi explicare potest."

# game/a3s1.rpy:314
translate latin a3s1_be9059f6:

    # "My mouth is already open as I'm walking into the bedroom when I'm hit with a blast of sound."
    "Iam os apertum est dum in cubiculum ingredior, cum magna soni unda me percutit."

# game/a3s1.rpy:317
translate latin a3s1_73814cdc:

    # "In front of me is Neferu with his back to me, though I can see that he's in his underwear."
    "Ante me Neferu est, tergo mihi verso, quamquam eum subligaculo indutum video."

# game/a3s1.rpy:318
translate latin a3s1_2b1df2e9:

    # "He's moving fluidly around, arms and paws waving about and pausing at odd angles while his feet slide across the ground, gliding back and forth."
    "Fluide movetur, bracchiis manibusque agitatis et miris angulis consistentibus, dum pedes per solum huc illuc labuntur."

# game/a3s1.rpy:319
translate latin a3s1_8e6b958a:

    # "At first, I think he's doing some kind of exercise, but then I can hear him singing over the music."
    "Primum puto eum quandam exercitationem agere, sed tum eum supra musicam cantantem audire possum."

# game/a3s1.rpy:320
translate latin a3s1_eace5e37:

    # "It's wordless because it doesn't translate through the lingua, just a sort of howling sound, though very different from the wolves."
    "Verba nulla sunt, quia per Linguam non vertitur; tantum quidam ululatus est, quamquam a Luporum ululatu valde differt."

# game/a3s1.rpy:321
translate latin a3s1_95fccd8e:

    # "It's very loud and it's a wonder I couldn't hear it in the hallway."
    "Clarissimus est, et mirum est me eum in ambulacro audire non potuisse."

# game/a3s1.rpy:322
translate latin a3s1_e67482aa:

    # "It doesn't necessarily sound bad, but I can tell Neferu isn't putting much effort into making it sound nice."
    "Non necessario male sonat, sed intellego Neferu parum operae dare ut bene sonet."

# game/a3s1.rpy:323
translate latin a3s1_ff9ff9dd:

    # "Still, I feel like I'm walking in on something private, so I consider backing out."
    "Tamen sentio me rem privatam interrumpere, itaque retro abire cogito."

# game/a3s1.rpy:324
translate latin a3s1_30a8a1f5:

    # "Of course, that's when he spins around and immediately spots me standing there in front of the door, my mouth still open."
    "Scilicet tum se vertit et statim me ante ianuam stantem videt, ore adhuc aperto."

# game/a3s1.rpy:326
translate latin a3s1_2bfd765d:

    # "Quickly, I fix my face into a pleasant smile, trying to act casual so I don't embarrass him."
    "Cito gratum arrisum faciei induo, otiosus videri conatus ne eum pudere faciam."

# game/a3s1.rpy:327
translate latin a3s1_dbfce420:

    # m "\"Oh hey, Neferu, I was—\""
    m "\"O salve, Neferu, ego—\""

# game/a3s1.rpy:329
translate latin a3s1_3d0f3247:

    # "I pause as I see Neferu grinning back at me."
    "Consisto cum Neferu vicissim subridentem video."

# game/a3s1.rpy:330
translate latin a3s1_65e23529:

    # m "\"Um, I was just, uh...you okay?\""
    m "\"Ehm, tantum, eh...vales?\""

# game/a3s1.rpy:331
translate latin a3s1_c0e2bcbd:

    # "I have to almost shout over the music."
    "Paene clamare debeo ut supra musicam audiar."

# game/a3s1.rpy:332
translate latin a3s1_a5145240:

    # "The Jackal is swaying back and forth a little bit, almost like he's still dancing."
    "Chacalus paulum huc illuc nutat, quasi adhuc saltet."

# game/a3s1.rpy:333
translate latin a3s1_ed6163f6:

    # n "\"Oh, [mc], what an incredibly pleasant and joyous surprise.\""
    n "\"O, [mc], quam incredibiliter grata laetaque res inopinata.\""

# game/a3s1.rpy:334
translate latin a3s1_0c96a866:

    # m "\"Uhhh...Thanks?\""
    m "\"Ehm...gratias?\""

# game/a3s1.rpy:336
translate latin a3s1_eaab285e:

    # "The jackal begins to dance again, facing me this time, though he doesn't sing, thankfully."
    "Chacalus rursus saltare incipit, hoc tempore ad me versus, quamquam feliciter non cantat."

# game/a3s1.rpy:337
translate latin a3s1_994f6c7b:

    # m "\"Are you okay?\""
    m "\"Vales?\""

# game/a3s1.rpy:338
translate latin a3s1_4a7e005e:

    # n "\"Better than I've ever been, my Simian friend! What do you think of the music?\""
    n "\"Melius quam umquam valui, amice Simiane! Quid de musica putas?\""

# game/a3s1.rpy:339
translate latin a3s1_e2af9fd0:

    # "Neferu nods at the ceiling."
    "Neferu capite tectum significat."

# game/a3s1.rpy:340
translate latin a3s1_5dd11dee:

    # m "\"It's...It's nice...kinda loud.\""
    m "\"Est...grata est...paulo clara.\""

# game/a3s1.rpy:341
translate latin a3s1_db0bd149:

    # n "\"I'm sorry, I need to hear sounds from home every now and then. The wolves have no...{i}spice{/i} in their music.\""
    n "\"Ignosce; interdum sonos patriae audire debeo. Lupi nullum...{i}condimentum{/i} in musica habent.\""

# game/a3s1.rpy:342
translate latin a3s1_244f4b12:

    # "The jackal slides his paws sensually over his torso, smoothing the fur down to better accentuate his pecs and abs, his eyes glued to mine."
    "Chacalus manus sensuose per corpus ducit, pilos complanans ut musculos pectoris ventrisque melius ostendat, oculis in meis fixis."

# game/a3s1.rpy:343
translate latin a3s1_28a8869d:

    # "I look around and note the three bottles of wine on the bedside table."
    "Circumspicio et tres lagenas vini in mensula iuxta lectum animadverto."

# game/a3s1.rpy:344
translate latin a3s1_f5dda719:

    # m "\"Oh...you're drunk.\""
    m "\"O...ebrius es.\""

# game/a3s1.rpy:346
translate latin a3s1_0e901af3:

    # n "\"I'm drunk.\""
    n "\"Ebrius sum.\""

# game/a3s1.rpy:347
translate latin a3s1_43679fa6:

    # "Neferu spins in a circle and actually almost loses his balance, something I've never seen him do."
    "Neferu in orbem vertitur et paene aequilibrium amittit, quod eum numquam facere vidi."

# game/a3s1.rpy:348
translate latin a3s1_05d472eb:

    # "I've seen him buzzed before, but he's always managed to keep his composure."
    "Eum vino paulum affectum antea vidi, sed semper se continere potuit."

# game/a3s1.rpy:349
translate latin a3s1_0deb666a:

    # "But now..."
    "Sed nunc..."

# game/a3s1.rpy:350
translate latin a3s1_d022db94:

    # m "\"How drunk?\""
    m "\"Quam ebrius?\""

# game/a3s1.rpy:352
translate latin a3s1_36c6ca77:

    # n "\"Too drunk, but—\""
    n "\"Nimis ebrius, sed—\""

# game/a3s1.rpy:353
translate latin a3s1_21cec5d6:

    # "Neferu steadies himself against a pillar, leaning and rubbing his head against it."
    "Neferu contra columnam se firmat, ei innitens et caput fricans."

# game/a3s1.rpy:355
translate latin a3s1_c243004e:

    # n "\"—at the same time, not drunk enough.\""
    n "\"—simul tamen non satis ebrius.\""

# game/a3s1.rpy:356
translate latin a3s1_3dbdf34c:

    # "I quickly make sure the door is closed behind me before moving closer to the jackal."
    "Cito certus fio ianuam post me clausam esse, antequam ad chacalum propius accedo."

# game/a3s1.rpy:357
translate latin a3s1_fe78655b:

    # m "\"Do you need help?\""
    m "\"Auxilio eges?\""

# game/a3s1.rpy:358
translate latin a3s1_e2e5c744:

    # n "\"What!?\""
    n "\"Quid!?\""

# game/a3s1.rpy:359
translate latin a3s1_b3af2145:

    # "I raise my voice above the music."
    "Vocem supra musicam tollo."

# game/a3s1.rpy:360
translate latin a3s1_0f20c0a5:

    # m "\"Do you—\""
    m "\"Num—\""

# game/a3s1.rpy:361
translate latin a3s1_7859df96:

    # "Neferu waves his paw at me."
    "Neferu manum ad me agitat."

# game/a3s1.rpy:362
translate latin a3s1_e85575cf:

    # n "\"Wait, Com, pause music.\""
    n "\"Exspecta, Computatrum, musicam suspende.\""

# game/a3s1.rpy:364
translate latin a3s1_0aa31415:

    # com "\"Pausing 'Dancing Amongst the Dunes' by Heqet.\""
    com "\"'Saltatio Inter Arenarum Colles' ab Heqet suspenditur.\""

# game/a3s1.rpy:366
translate latin a3s1_d9e2f4b0:

    # n "\"I need another drink.\""
    n "\"Alia potione mihi opus est.\""

# game/a3s1.rpy:367
translate latin a3s1_3d7f8685:

    # "Neferu reaches out toward the table even though it's a good ten feet away, and I look over to see that one of them is half full."
    "Neferu manum ad mensam porrigit, quamquam decem integris pedibus abest; eo specto et unam lagenam dimidiam plenam esse video."

# game/a3s1.rpy:368
translate latin a3s1_2d57c37d:

    # "There's a pause, then Neferu opens his eyes, frowning at me."
    "Paulisper tacet, deinde Neferu oculos aperit et me fronte contracta spectat."

# game/a3s1.rpy:370
translate latin a3s1_4fed1908:

    # n "\"I said I need a drink, [mc].\""
    n "\"Dixi me potione egere, [mc].\""

# game/a3s1.rpy:371
translate latin a3s1_cfc78543:

    # m "\"And what do you think I'm gonna do about that?\""
    m "\"Et quid putas me de ea re facturum?\""

# game/a3s1.rpy:372
translate latin a3s1_40a556dd:

    # n "\"You're a slave. You know what to do.\""
    n "\"Servus es. Scis quid facias.\""

# game/a3s1.rpy:373
translate latin a3s1_61f958ee:

    # "I stare."
    "Eum fixis oculis intueor."

# game/a3s1.rpy:374
translate latin a3s1_61d5f247:

    # m "\"Excuse me?\""
    m "\"Quid ais?\""

# game/a3s1.rpy:376
translate latin a3s1_e11c5139:

    # n "\"You. Are. A. Slave.\""
    n "\"Tu. Servus. Es.\""

# game/a3s1.rpy:377
translate latin a3s1_1bd9f5ec:

    # "Neferu pokes a finger in my direction with every word."
    "Neferu quoque verbo digitum ad me intendit."

# game/a3s1.rpy:378
translate latin a3s1_954afc44:

    # n "\"Don't let the wolves tell you any different. As long as you are here, they are your master.\""
    n "\"Noli Lupos sinere tibi aliud dicere. Dum hic es, domini tui sunt.\""

# game/a3s1.rpy:379
translate latin a3s1_6ff386a3:

    # m "\"But {i}you{/i} were treating me like a slave just now.\""
    m "\"Sed {i}tu{/i} modo me ut servum tractabas.\""

# game/a3s1.rpy:380
translate latin a3s1_ccfb0b22:

    # n "\"I was making—\""
    n "\"Ego—\""

# game/a3s1.rpy:381
translate latin a3s1_eab5b6ef:

    # "Neferu pauses as he makes a strange swallowing/hiccuping sound."
    "Neferu consistit, mirum sonum deglutiendi ac singultus edens."

# game/a3s1.rpy:382
translate latin a3s1_cb6f719c:

    # n "\"I was making a point, clearly. Sorry, should I simplify my words for you?\""
    n "\"Argumentum demonstrabam, ut patet. Ignosce, verba mea tibi simpliciora faciam?\""

# game/a3s1.rpy:384
translate latin a3s1_d0b59f05:

    # "The jackal goes on staring at the bottle, as if wondering if it's worth it to make the journey there."
    "Chacalus lagenam spectare pergit, quasi deliberet num operae pretium sit eo ire."

# game/a3s1.rpy:386
translate latin a3s1_2e08f618:

    # "He turns back to me, as if just remembering that I'm there, though he seems to have trouble focusing his eyes."
    "Rursus se ad me vertit, quasi modo meminerit me adesse, quamquam oculos recte intendere aegre videtur."

# game/a3s1.rpy:387
translate latin a3s1_52e9e541:

    # n "\"Don't worry, [mc], I am just as much a slave as you are. You have the advantage of some day leaving, though.\""
    n "\"Noli sollicitari, [mc]; tam servus quam tu sum. Tibi tamen commodum est te aliquando abiturum.\""

# game/a3s1.rpy:388
translate latin a3s1_af90e319:

    # "I move closer, deciding to sit on my bed while Neferu goes on hugging at the pillar, as if letting go will cause him to fall."
    "Propius accedo, statuoque in lecto meo sedere, dum Neferu columnam amplecti pergit, quasi, si eam dimittat, statim casurus sit."

# game/a3s1.rpy:389
translate latin a3s1_977b8ea0:

    # "That wouldn't be good considering the fountain is right there."
    "Id bonum non esset, quia fons statim ibi est."

# game/a3s1.rpy:390
translate latin a3s1_e8967cd6:

    # m "\"You can't leave whenever you want?\""
    m "\"Non potes abire quoties vis?\""

# game/a3s1.rpy:392
translate latin a3s1_c2c3a664:

    # "Neferu chuckles, then guffaws, another sound I've never heard from him."
    "Neferu leniter ridet, deinde cachinnat, sono quem ab eo numquam audivi."

# game/a3s1.rpy:393
translate latin a3s1_6fe012d7:

    # n "\"You don't understand. I can leave, but I {i}can't{/i} leave.\""
    n "\"Non intellegis. Abire possum, sed abire {i}non possum{/i}.\""

# game/a3s1.rpy:394
translate latin a3s1_33241b8d:

    # m "\"...Yeah, I don't think I do understand.\""
    m "\"...Ita, credo me non intellegere.\""

# game/a3s1.rpy:395
translate latin a3s1_00b444b9:

    # "Suddenly, Neferu's ears flatten."
    "Subito aures Neferu complanantur."

# game/a3s1.rpy:397
translate latin a3s1_e9080f3d:

    # n "\"You really fucked this up for me, do you understand that?\""
    n "\"Tu vere rem mihi corrupisti; hoc intellegis?\""

# game/a3s1.rpy:398
translate latin a3s1_2cc7b95a:

    # "I blink."
    "Palpebras moveo."

# game/a3s1.rpy:399
translate latin a3s1_df8ec4bc_1:

    # m "\"What?\""
    m "\"Quid?\""

# game/a3s1.rpy:401
translate latin a3s1_6d5d9718:

    # n "\"You. Fucked. My. Life.\""
    n "\"Tu. Vitam. Meam. Perdidisti.\""

# game/a3s1.rpy:402
translate latin a3s1_112966bd:

    # "This time Neferu uses his foot to point at me...or really just sort of kicking it in my direction."
    "Hoc tempore Neferu pede me significat...vel potius tantum pedem versus me iacit."

# game/a3s1.rpy:403
translate latin a3s1_02f1940d:

    # m "\"What the hell are you talking about?\""
    m "\"Quid tandem dicis?\""

# game/a3s1.rpy:404
translate latin a3s1_980ced3d:

    # n "\"If you hadn't come here, Cato would not have had the excuse to nullify Amicus's emperorship. I would be halfway through negotiating an alliance by now.\""
    n "\"Si huc non venisses, Cato causam imperii Amici irriti faciendi non habuisset. Iam medium iter foederis tractandi confecissem.\""

# game/a3s1.rpy:405
translate latin a3s1_0c281810:

    # m "\"Wait, this isn't my fault. I was brought here against my will, Neferu.\""
    m "\"Exspecta, haec culpa mea non est. Huc invitus adductus sum, Neferu.\""

# game/a3s1.rpy:407
translate latin a3s1_66f3c71d:

    # "Neferu makes another deep swallowing sound, then just belches loudly."
    "Neferu alium gravem sonum deglutiendi edit, deinde tantum clare ructat."

# game/a3s1.rpy:408
translate latin a3s1_66d3f6be:

    # n "\"Yes, yes, I'm sorry. I forget it's mostly that big idiot's fault.\""
    n "\"Ita, ita, ignosce. Obliviscor plerumque illius magni stulti culpam esse.\""

# game/a3s1.rpy:409
translate latin a3s1_0cd92e8e:

    # "I feel my temper snap and I stand up."
    "Iram meam erumpere sentio et surgo."

# game/a3s1.rpy:410
translate latin a3s1_38932c9f:

    # "Now is not the time I wanted to find out that my most important ally actually blames me and my boyfriend for the situation he's in."
    "Nunc minime cupiebam discere maximum socium meum vere me atque amantem meum condicionis suae accusare."

# game/a3s1.rpy:411
translate latin a3s1_955a8a09:

    # m "\"Hey, I know you're drunk, but I'm not gonna listen to you say this shit. You can call me back when you've sobered up and stop feeling sorry for yourself.\""
    m "\"Heus, scio te ebrium esse, sed haec merdosa verba a te audire non volo. Me revocare potes cum sobrius eris et te ipsum miserari desines.\""

# game/a3s1.rpy:413
translate latin a3s1_1f2b7d19:

    # "I start walking toward the door quickly, feeling a little sick at the whole situation."
    "Celeriter ad ianuam ambulare incipio, tota re paulum nauseans."

# game/a3s1.rpy:414
translate latin a3s1_b6a46ce6:

    # "If Neferu really is turning on me, that means the only person I can trust here is in the dungeon."
    "Si Neferu vere contra me se vertit, ille solus cui hic confidere possum in carcere est."

# game/a3s1.rpy:415
translate latin a3s1_89803e76:

    # "I really would be alone."
    "Vere solus essem."

# game/a3s1.rpy:416
translate latin a3s1_66fac335:

    # n "\"Wait...\""
    n "\"Exspecta...\""

# game/a3s1.rpy:417
translate latin a3s1_4faa458c:

    # "His voice is so quiet that I'm almost not even sure if I'd heard it."
    "Vox eius tam quieta est ut vix certus sim me eam audivisse."

# game/a3s1.rpy:418
translate latin a3s1_e1c41e39:

    # "I pause though, looking back over my shoulder."
    "Sed consisto, supra umerum respiciens."

# game/a3s1.rpy:420
translate latin a3s1_b997abe7:

    # "He's still leaned up against the pillar, his ears down, gazing at the ground."
    "Adhuc columnae innititur, auribus demissis, ad solum spectans."

# game/a3s1.rpy:421
translate latin a3s1_941ea22a:

    # "I'm about to ask him to repeat himself, but that's when he suddenly lets out a gasp and slides down the pillar to his knees."
    "Iam eum rogaturus sum ut verba repetat; sed tum subito anhelat et per columnam in genua labitur."

# game/a3s1.rpy:424
translate latin a3s1_32d2ec05:

    # "He crumples on the ground, paws covering his face as he trembles and starts to sob loudly."
    "In solo corruit, faciem manibus tegens dum tremit et clare flere incipit."

# game/a3s1.rpy:425
translate latin a3s1_6a691dbc:

    # n "\"I'm...I'm s—so sorry. I don't...I don't know what I'm—what I'm doing.\""
    n "\"Ego...m—maxime veniam peto. Non...nescio quid—quid agam.\""

# game/a3s1.rpy:426
translate latin a3s1_f070c4c4:

    # "I stare, open-mouthed, watching the jackal cry for several seconds."
    "Ore aperto intueor, chacalum per aliquot secunda flentem spectans."

# game/a3s1.rpy:427
translate latin a3s1_33c1cecf:

    # "Apparenly \"too drunk\" means \"waaaaay too drunk\"."
    "Ut videtur, \"nimis ebrius\" significat \"loooonge nimis ebrius\"."

# game/a3s1.rpy:428
translate latin a3s1_ec40abf0:

    # "Still, this jackal clearly has a lot of problems that he doesn't tell anyone about."
    "Tamen huic chacalo clare multa mala sunt de quibus nemini narrat."

# game/a3s1.rpy:429
translate latin a3s1_208fc44b:

    # "Actually, he doesn't really have anyone to tell them to on this alien moon."
    "Revera in hac aliena luna neminem habet cui narret."

# game/a3s1.rpy:430
translate latin a3s1_272a52df:

    # "At least I have Amicus."
    "Saltem ego Amicum habeo."

# game/a3s1.rpy:432
translate latin a3s1_ce056b53:

    # "So, after standing there in stunned silence for a moment, I walk over to Neferu."
    "Itaque postquam paulisper attonitus ac tacitus steti, ad Neferu ambulo."

# game/a3s1.rpy:433
translate latin a3s1_c6be5d92:

    # "I stand awkwardly at his side for a moment, watching his broad, black-furred shoulders heave up and down before I kneel and rest a hand on his back."
    "Paulisper inepte iuxta eum sto, latos umeros nigro pilo sursum deorsumque moveri spectans; tum genua flecto et manum tergo eius impono."

# game/a3s1.rpy:434
translate latin a3s1_1b3267cc:

    # "I see his ears perk up for a moment in reaction, but otherwise he doesn't say anything."
    "Aures eius paulisper erigi video; sed nihil aliud dicit."

# game/a3s1.rpy:435
translate latin a3s1_0248e681:

    # "I'm generally not the best at comforting someone, especially when they're crying, but I rub my hand in a circle through the fur."
    "Plerumque non optimus sum aliquem consolando, maxime flentem, sed manum in orbem per pilos duco."

# game/a3s1.rpy:436
translate latin a3s1_d00111f6:

    # m "\"Hey...I get it. This whole thing is really frustrating, but we'll figure this out together.\""
    m "\"Heus...intellego. Tota res vere irritat, sed una viam inveniemus.\""

# game/a3s1.rpy:437
translate latin a3s1_ba6e0355:

    # "I give the jackal a few minutes to finally calm down, then I start to pull him up, pushing him in the direction of his bed."
    "Chacalo pauca minuta do ut tandem quiescat; deinde eum tollere incipio, ad lectum propellens."

# game/a3s1.rpy:438
translate latin a3s1_53d45b5a:

    # "He doesn't resist and stumbles up to it before falling face-down onto the covers."
    "Non resistit et ad eum titubat, antequam pronus in stragula cadit."

# game/a3s1.rpy:439
translate latin a3s1_e8bd7674:

    # "He wipes his face with the pillow and while he does that, I quickly grab the wine bottles, moving them to the floor so that they're out of his reach."
    "Faciem pulvino tergit; dum facit, cito lagenas vini capio et in solum pono, ut eas attingere non possit."

# game/a3s1.rpy:440
translate latin a3s1_38e79375:

    # "Finally, Neferu lets out a big, shuddery sigh."
    "Tandem Neferu graviter tremensque suspirat."

# game/a3s1.rpy:442
translate latin a3s1_17a6450b:

    # n "\"Can you...rub my back again? It feels good.\""
    n "\"Potes...rursus tergum meum fricare? Suave est.\""

# game/a3s1.rpy:443
translate latin a3s1_4061012a:

    # "The jackal's voice is stuffy from his clogged nose."
    "Vox chacali ob obstructum nasum obtusa est."

# game/a3s1.rpy:444
translate latin a3s1_910f899d:

    # m "\"Sure.\""
    m "\"Sane.\""

# game/a3s1.rpy:445
translate latin a3s1_f19c12eb:

    # "I kneel beside the bed before starting to rub Neferu's back again."
    "Iuxta lectum genua flecto, deinde rursus tergum Neferu fricare incipio."

# game/a3s1.rpy:446
translate latin a3s1_4b98aa43:

    # "He sighs, head turned away from me."
    "Suspirat, capite a me averso."

# game/a3s1.rpy:447
translate latin a3s1_f84e01f6:

    # "I let the silence go on for a while, listening to the jackal sniffing every couple of seconds before I finally speak."
    "Silentium aliquamdiu durare sino, chacalum singulis paucis secundis nasum trahentem audiens, antequam tandem loquor."

# game/a3s1.rpy:448
translate latin a3s1_4731eb9a:

    # m "\"So uh...what happened?\""
    m "\"Ergo, eh...quid accidit?\""

# game/a3s1.rpy:449
translate latin a3s1_0a109fb3:

    # n "\"I drank.\""
    n "\"Bibi.\""

# game/a3s1.rpy:450
translate latin a3s1_d0193d53:

    # m "\"Yeah, speaking of which; Com, bring us a glass and pitcher of water please?\""
    m "\"Ita; de ea re, Computatrum, poculum atque urceum aquae nobis affer, quaeso?\""

# game/a3s1.rpy:451
translate latin a3s1_520b085c:

    # com "\"Yes, [mc].\""
    com "\"Ita, [mc].\""

# game/a3s1.rpy:452
translate latin a3s1_4a1aa200:

    # m "\"And uh, take the wine bottles away too.\""
    m "\"Et, eh, lagenas vini quoque aufer.\""

# game/a3s1.rpy:453
translate latin a3s1_520b085c_1:

    # com "\"Yes, [mc].\""
    com "\"Ita, [mc].\""

# game/a3s1.rpy:454
translate latin a3s1_37099a92:

    # n "\"Nooo, my precious wolven wine.\""
    n "\"Nooon, pretiosum meum vinum Luporum.\""

# game/a3s1.rpy:455
translate latin a3s1_cc442595:

    # "Neferu says it in a mock sad voice, but combined with his already sad state, there's not much of a difference."
    "Ficta tristi voce Neferu dicit; sed cum iam tristis sit, parum differt."

# game/a3s1.rpy:456
translate latin a3s1_ebd3f6e1:

    # m "\"Again, what happened?\""
    m "\"Rursus, quid accidit?\""

# game/a3s1.rpy:458
translate latin a3s1_7583a0b0:

    # n "\"I don't know...I suppose I realized how challenging this will all be. I can't say I trust the wolven people to oust Cassius. They're rather accepting of corrupt officials.\""
    n "\"Nescio...credo me intellexisse quam difficilia haec omnia futura sint. Non possum dicere me populo Luporum confidere ut Cassium expellat. Magistratus corruptos satis facile accipiunt.\""

# game/a3s1.rpy:459
translate latin a3s1_2c8bb309:

    # "I think, trying to approach this delicately."
    "Cogito, rem leniter tractare conatus."

# game/a3s1.rpy:460
translate latin a3s1_60d14cf1:

    # m "\"Is your family making you do this, like they won't let you come back unless you cultivate the alliance?\""
    m "\"Familia tua te hoc facere cogit, quasi te redire non sinat nisi foedus efficias?\""

# game/a3s1.rpy:462
translate latin a3s1_c1bfc414:

    # n "\"Hehe, my family doesn't even expect me to accomplish that, but that's why I must do it. If I don't, I might as well be banished.\""
    n "\"Hehe, familia mea ne exspectat quidem me id effecturum, sed ideo facere debeo. Si non facio, tamquam exsul ero.\""

# game/a3s1.rpy:463
translate latin a3s1_0fd013da:

    # m "\"It seems kind of unfair that they'd put all of this on you.\""
    m "\"Aliquantum iniquum videtur omnia haec tibi imponere.\""

# game/a3s1.rpy:465
translate latin a3s1_4f9d7d3b:

    # n "\"After what I've put them through, it's only fair.\""
    n "\"Post ea quae eos pati feci, tantum aequum est.\""

# game/a3s1.rpy:466
translate latin a3s1_918b3ff2:

    # "I wait for more of an explanation, but he doesn't go on."
    "Maiorem explicationem exspecto, sed non pergit."

# game/a3s1.rpy:467
translate latin a3s1_70274ef6:

    # m "\"So is what Alex said on the island about you and your family true?\""
    m "\"Ergo verum est quod Alex in insula de te et familia tua dixit?\""

# game/a3s1.rpy:468
translate latin a3s1_cf12068f:

    # n "\"More or less.\""
    n "\"Plus minusve.\""

# game/a3s1.rpy:469
translate latin a3s1_f54dbe2f:

    # "Again, he doesn't seem interested in talking about it, so I just go on rubbing his back."
    "Rursus de ea re loqui non cupere videtur, itaque tantum tergum eius fricare pergo."

# game/a3s1.rpy:470
translate latin a3s1_c74f7402:

    # m "\"Well, we're gonna get Amicus out of the dungeons and onto the throne. I know you don't believe that I've talked to the parents, but I really think I have, and they're on our side.\""
    m "\"Bene, Amicum e carcere in thronum adducemus. Scio te non credere me cum Parentibus locutum esse, sed vere puto me esse, et nobiscum sunt.\""

# game/a3s1.rpy:472
translate latin a3s1_adaeddad:

    # "Neferu chuckles."
    "Neferu leniter ridet."

# game/a3s1.rpy:474
translate latin a3s1_3236ec8d:

    # m "\"So you'll get that alliance.\""
    m "\"Ergo illud foedus habebis.\""

# game/a3s1.rpy:476
translate latin a3s1_7fe1a4f9:

    # n "\"I hope so, my friend.\""
    n "\"Spero, amice.\""

# game/a3s1.rpy:477
translate latin a3s1_5ee6a9ce:

    # "We sit in silence for a long while, and even I start to enjoy the hypnotic motion of rubbing Neferu's furry back in a large spiral motion."
    "Diu taciti sedemus; etiam mihi gratus fieri incipit motus mentem captivans quo manum in latam spiram per pilosum tergum Neferu moveo."

# game/a3s1.rpy:478
translate latin a3s1_0d360a41:

    # "My mind wanders back to the cat."
    "Mens mea ad felem redit."

# game/a3s1.rpy:480
translate latin a3s1_cc64e6cd:

    # m "\"Speaking of Alex, I had a weird conversation with him today. I think he thinks we're like...conspiring against him, or something.\""
    m "\"De Alex loquens, mirum sermonem cum eo hodie habui. Puto eum putare nos quasi...contra eum coniurare, vel aliquid tale.\""

# game/a3s1.rpy:481
translate latin a3s1_11246b01:

    # "Neferu grunts."
    "Neferu fremit."

# game/a3s1.rpy:483
translate latin a3s1_975f129e:

    # n "\"Stay away from that cat. He's nothing but trouble.\""
    n "\"Ab illo fele abstine. Nihil nisi mala est.\""

# game/a3s1.rpy:484
translate latin a3s1_abd525b5:

    # m "\"Well, he kept bringing up the alliance. He seemed to want to know my role in it.\""
    m "\"Bene, foedus identidem memorabat. Partem meam in eo scire velle videbatur.\""

# game/a3s1.rpy:485
translate latin a3s1_739d97dc:

    # "Neferu turns his face toward me, his eyes bloodshot, but the tears dried up at this point."
    "Neferu faciem ad me vertit, oculis sanguine rubris, sed lacrimis iam siccatis."

# game/a3s1.rpy:486
translate latin a3s1_1e0aea36:

    # n "\"I assume it had something to do with not wanting the alliance to happen?\""
    n "\"Credo id ex eo ortum esse quod foedus fieri nolit?\""

# game/a3s1.rpy:487
translate latin a3s1_c806ebc0_1:

    # m "\"Yeah.\""
    m "\"Ita.\""

# game/a3s1.rpy:488
translate latin a3s1_a6abe4cc:

    # "Neferu takes a deep breath and presses his face into the pillow, letting out a long groan."
    "Neferu alte spirat et faciem pulvino premit, longum gemitum edens."

# game/a3s1.rpy:489
translate latin a3s1_5eb0351c:

    # n "\"All I can say is don't trust him.\""
    n "\"Tantum dicere possum: ei noli confidere.\""

# game/a3s1.rpy:490
translate latin a3s1_772eb02e:

    # m "\"Yeah, definitely not. I just don't really get what he's doing.\""
    m "\"Ita, certe non. Tantum non vere intellego quid agat.\""

# game/a3s1.rpy:491
translate latin a3s1_e567b56d:

    # n "\"Neither do I, and that's why you should stay away from him.\""
    n "\"Ne ego quidem, et ideo ab eo abstinere debes.\""

# game/a3s1.rpy:492
translate latin a3s1_ebf91e77:

    # m "\"Really? I thought you two...I dunno, talked and did stuff together.\""
    m "\"Vere? Putabam vos duos...nescio, colloqui et res una agere.\""

# game/a3s1.rpy:494
translate latin a3s1_83c90434:

    # n "\"Which didn't shed any light on his motives. Considering the way our relationship has changed, I doubt I'll get any more information from him.\""
    n "\"Quod consilia eius non explicavit. Habita ratione mutationis necessitudinis nostrae, dubito me plus ab eo cogniturum.\""

# game/a3s1.rpy:495
translate latin a3s1_f30bfe77:

    # m "\"Sure you can't just seduce him again?\""
    m "\"Certus es te eum rursus seducere non posse?\""

# game/a3s1.rpy:497
translate latin a3s1_f9ee6f09:

    # "Neferu cracks a smile."
    "Neferu subridet."

# game/a3s1.rpy:498
translate latin a3s1_ac01ffd6:

    # n "\"Last time I tried that, he referred to me as a whore...which isn't exactly inaccurate.\""
    n "\"Novissime cum id conatus sum, me scortum appellavit...quod non omnino falsum est.\""

# game/a3s1.rpy:499
translate latin a3s1_a2f52205:

    # "The doors open and a drone glides in, setting water down on the bedside table and fetching the bottles from behind the jackals bed."
    "Ianua aperitur et automaton labitur, aquam in mensula iuxta lectum ponens atque lagenas post lectum chacali capiens."

# game/a3s1.rpy:501
translate latin a3s1_81351e51:

    # "Neferu watches it go morosely."
    "Neferu triste illud abire spectat."

# game/a3s1.rpy:502
translate latin a3s1_ce64039d:

    # "I clear my throat, trying to distract him from the departing alcohol."
    "Guttur purgo, conatus animum eius ab alcohole abeunte avertere."

# game/a3s1.rpy:503
translate latin a3s1_d7e4cdc0:

    # m "\"I get what you mean though. It seems like he favors one side, then the other. I don't get it.\""
    m "\"Sed intellego quid dicas. Videtur uni parti favere, deinde alteri. Non intellego.\""

# game/a3s1.rpy:504
translate latin a3s1_e20675ca:

    # "Neferu waves his paw."
    "Neferu manum agitat."

# game/a3s1.rpy:506
translate latin a3s1_9b72f79d:

    # n "\"Best not to worry yourself with him and simply stay away. Omorfans are famous for their quirks and seemingly contradictive behavior.\""
    n "\"Melius est de eo non sollicitari atque tantum abstinere. Omorfani noti sunt moribus miris et specie contrariis.\""

# game/a3s1.rpy:507
translate latin a3s1_6f19d038:

    # m "\"Alright.\""
    m "\"Bene.\""

# game/a3s1.rpy:509
translate latin a3s1_314e9f28:

    # "I rub for a while longer, switching hands as my arm starts getting tired."
    "Paulo diutius frico, manus commutans dum bracchium fatigari incipit."

# game/a3s1.rpy:510
translate latin a3s1_6d35b09a:

    # "I'm starting to think that the jackal has fallen asleep when he suddenly speaks again, jolting me out of my trance."
    "Credere incipio chacalum obdormivisse; tum subito rursus loquitur, me e stupore excitans."

# game/a3s1.rpy:512
translate latin a3s1_3eefe7b6:

    # n "\"We will be revealing our hand to Cassius tomorrow. With any luck, Amicus will be free by the end of the week.\""
    n "\"Cras consilium nostrum Cassio patefaciemus. Si fortuna favet, Amicus ante finem hebdomadae liber erit.\""

# game/a3s1.rpy:513
translate latin a3s1_89357ba6:

    # m "\"Oh...\""
    m "\"O...\""

# game/a3s1.rpy:514
translate latin a3s1_61b99de2:

    # "I'm surprised, finding that hard to take in."
    "Miror, id aegre accipiens."

# game/a3s1.rpy:515
translate latin a3s1_4991d345:

    # "I knew this would be coming, but not so soon."
    "Sciebam hoc venturum, sed non tam cito."

# game/a3s1.rpy:516
translate latin a3s1_540d79a9:

    # m "\"How are we gonna do that?\""
    m "\"Quomodo id faciemus?\""

# game/a3s1.rpy:517
translate latin a3s1_aad02cb6:

    # n "\"Well, we have three pieces of information that can help us. The first is the footage from the third trial, hopefully that will be enough to convince Cassius to step down.\""
    n "\"Bene, tria indicia habemus quae nos adiuvare possunt. Primum imagines tertii certaminis sunt; spero eas satis fore ut Cassio persuadeant abdicare.\""

# game/a3s1.rpy:518
translate latin a3s1_df288e8f:

    # "Neferu suddenly shifts and slowly sits up, groaning again before reaching for the pitcher and glass of water."
    "Neferu subito movetur et lente sedet, rursus gemens antequam urceum poculumque aquae petit."

# game/a3s1.rpy:519
translate latin a3s1_955f554a:

    # n "\"The second is the footage of Cato attacking me. I'd rather we not have to use that, but if Cassius isn't convinced by the first, then we may have to resort to it.\""
    n "\"Secundum imagines Catonis me petentis sunt. Malo nos eis non uti, sed si primum indicium Cassio non persuaserit, fortasse ad eas confugere debebimus.\""

# game/a3s1.rpy:520
translate latin a3s1_14212003:

    # "Neferu drinks deeply from his glass, and I watch him impatiently as he drains the entire thing."
    "Neferu multum e poculo bibit; impatienter specto eum totum exhaurire."

# game/a3s1.rpy:521
translate latin a3s1_6b1b3812:

    # m "\"And the third?\""
    m "\"Et tertium?\""

# game/a3s1.rpy:522
translate latin a3s1_167df24a:

    # "Neferu gasps and leans back, setting the glass down."
    "Neferu spiritum ducit et recumbit, poculum ponens."

# game/a3s1.rpy:524
translate latin a3s1_de56b445:

    # n "\"Remember your little theory about the previous emperor's accident?\""
    n "\"Meministi parvae sententiae tuae de casu pristini imperatoris?\""

# game/a3s1.rpy:525
translate latin a3s1_8ce61eb8:

    # "I nod."
    "Annuo."

# game/a3s1.rpy:526
translate latin a3s1_3baddf98:

    # m "\"Alex said the investigation was botched.\""
    m "\"Alex dixit investigationem male actam esse.\""

# game/a3s1.rpy:528
translate latin a3s1_5be167d1:

    # "Neferu glances at me."
    "Neferu ad me spectat."

# game/a3s1.rpy:529
translate latin a3s1_e4d29bfd:

    # n "\"The fact that the cat tipped you off is worrying...but, it is very odd. The investigation wasn't botched, but rather called off by the acting emperor.\""
    n "\"Quod felis te monuit sollicitat...sed res valde mira est. Investigatio male acta non est, sed ab imperatore interim regente intermissa.\""

# game/a3s1.rpy:530
translate latin a3s1_8a99da6f:

    # m "\"Cato?\""
    m "\"Cato?\""

# game/a3s1.rpy:531
translate latin a3s1_02de9316:

    # n "\"Indeed. The investigators were only able to get as far as discovering a possible malicious software installed on the ship's navigations system.\""
    n "\"Certe. Investigatores tantum ad id pervenire potuerunt ut rationem computatoriam fortasse malitiosam in systemate navem gubernante institutam invenirent.\""

# game/a3s1.rpy:532
translate latin a3s1_f5eeee97:

    # n "\"Considering software has to be installed through a port, and that the ship is heavily protected whenever outside the palace, the installation likely would have had to have happened while inside the palace.\""
    n "\"Cum rationes per aditum institui debeant, navis autem diligenter protegatur quoties extra palatium est, institutio probabiliter intra palatium facta esse debuit.\""

# game/a3s1.rpy:533
translate latin a3s1_88a5f18d:

    # m "\"So Cato.\""
    m "\"Ergo Cato.\""

# game/a3s1.rpy:535
translate latin a3s1_adaeddad_1:

    # "Neferu chuckles."
    "Neferu leniter ridet."

# game/a3s1.rpy:536
translate latin a3s1_f9c5aba9:

    # n "\"More than likely, yes, but I don't understand why. Cato was good friends with the last emperor, and as far as I can tell, he was supportive of his policies.\""
    n "\"Probabilissime ita, sed non intellego cur. Cato cum pristino imperatore bonus amicus erat; quantum intellegere possum, consilia eius probabat.\""

# game/a3s1.rpy:537
translate latin a3s1_ed383bf9:

    # m "\"Well, how people act on the outside doesn't really seem to matter much around here.\""
    m "\"Bene, mores quos homines foris ostendunt hic parum valere videntur.\""

# game/a3s1.rpy:539
translate latin a3s1_145767c2:

    # n "\"Or anywhere. What convinced me of Cato's involvement however, is the fact that every single investigator has gone missing since.\""
    n "\"Aut usquam. Sed quod omnes investigatores postea evanuerunt mihi persuasit Catonem huic rei interfuisse.\""

# game/a3s1.rpy:540
translate latin a3s1_df8ec4bc_2:

    # m "\"What?\""
    m "\"Quid?\""

# game/a3s1.rpy:542
translate latin a3s1_fd68d82c:

    # n "\"Mhm.\""
    n "\"Mhm.\""

# game/a3s1.rpy:543
translate latin a3s1_93ed1ccc:

    # "I start to feel that icy fear in my chest again."
    "Rursus illum gelidum metum in pectore sentire incipio."

# game/a3s1.rpy:544
translate latin a3s1_a2ed0224:

    # "If it is Cato, then he really is ruthless."
    "Si Cato est, vere immitis est."

# game/a3s1.rpy:545
translate latin a3s1_a3562a9c:

    # "What I saw happen to that doctor, Felix, could only be a taste of what Cato is capable of."
    "Quod illi medico Felici accidere vidi tantum specimen eorum esse potuit quae Cato facere potest."

# game/a3s1.rpy:546
translate latin a3s1_d97cda5a:

    # n "\"Unfortunately, because there is no solid evidence linking Cato, I'm afraid it might not be very effective. It could be another last resort though.\""
    n "\"Infeliciter, quia nulla firma indicia Catonem implicant, timeo ne parum valeat. Tamen alia ultima via esse posset.\""

# game/a3s1.rpy:548
translate latin a3s1_94c4eb4e:

    # n "\"Anyway, would you like to go with Virginia to try and convince him with this information?\""
    n "\"Ceterum, cum Virginia ire vis ut his indiciis ei persuadere coneris?\""

# game/a3s1.rpy:549
translate latin a3s1_0dadb667:

    # m "\"Really? You've been trying to get me to stay out of the way for the past week.\""
    m "\"Vere? Superiore hebdomada me a rebus abstinere facere conabaris.\""

# game/a3s1.rpy:550
translate latin a3s1_1a6579cf:

    # n "\"To keep you safe, but I've noticed that Cassius may have taken a liking to you as of late. You know him to some degree and could use that knowledge to better convince him.\""
    n "\"Ut te incolumem servemus; sed animadverti Cassium nuper fortasse tibi bene velle coepisse. Eum aliquantum nosti, et hac scientia ei melius persuadere possis.\""

# game/a3s1.rpy:551
translate latin a3s1_2be3e65d:

    # m "\"Well, I wouldn't say he likes me, but yeah, I can try.\""
    m "\"Bene, non dicerem me ei placere, sed ita, conari possum.\""

# game/a3s1.rpy:552
translate latin a3s1_7bd77c6c:

    # n "\"And as I said, Virginia will be there to help as well.\""
    n "\"Et, ut dixi, Virginia quoque ibi erit ut adiuvet.\""

# game/a3s1.rpy:553
translate latin a3s1_f5b997af:

    # m "\"I assume you're not going?\""
    m "\"Credo te non iturum?\""

# game/a3s1.rpy:555
translate latin a3s1_f93f2b76:

    # "Neferu smirks."
    "Neferu callide subridet."

# game/a3s1.rpy:556
translate latin a3s1_af4ceb73:

    # n "\"I am the last person he would want to see while discussing the possible end of his rule. Besides, I know I'm not going to be feeling my best tomorrow. I think I'll stay in bed for once.\""
    n "\"Ultimus sum quem videre velit dum de fine imperii sui fortasse futuro disserit. Praeterea scio me cras non optime valiturum. Credo me semel in lecto mansurum.\""

# game/a3s1.rpy:557
translate latin a3s1_d87f04fe:

    # m "\"Drink more water.\""
    m "\"Plus aquae bibe.\""

# game/a3s1.rpy:559
translate latin a3s1_fe575250:

    # "Neferu sighs, just sort of looking at the pitcher."
    "Neferu suspirat, tantum urceum spectans."

# game/a3s1.rpy:560
translate latin a3s1_112c2e03:

    # "I roll my eyes, reaching out to pour him another glass."
    "Oculos volvo, manum porrigens ut aliud poculum ei impleam."

# game/a3s1.rpy:562
translate latin a3s1_dd1e87cf:

    # n "\"Oh how kind of you.\""
    n "\"O quam benignus es.\""

# game/a3s1.rpy:563
translate latin a3s1_29e33bbf:

    # m "\"I'm a slave, right?\""
    m "\"Servus sum, recte?\""

# game/a3s1.rpy:565
translate latin a3s1_9a4bce58:

    # "Neferu winces as he takes the glass from me."
    "Neferu horrescit dum poculum a me accipit."

# game/a3s1.rpy:567
translate latin a3s1_d568f1aa:

    # n "\"No...you're a Khemian, and I think we'll be very proud to have you.\""
    n "\"Non...Khemianus es, et credo nos valde superbos fore quod te civem habebimus.\""

# game/a3s1.rpy:568
translate latin a3s1_463df8c5:

    # "With that, he once again downs the entire thing."
    "Tum rursus totum exhaurit."

# game/a3s1.rpy:571
translate latin a3s1_8550e322:

    # "I toss and turn most of the night, even while Neferu snores loudly in his own bed."
    "Maiorem noctis partem huc illuc me verto, dum Neferu in suo lecto clare stertit."

# game/a3s1.rpy:572
translate latin a3s1_ed703c06:

    # "I go over what I might be able to say to Cassius in case things go wrong for whatever reason."
    "Delibero quid Cassio dicere possim si aliqua de causa res male eveniant."

# game/a3s1.rpy:573
translate latin a3s1_d27a9228:

    # "I find that difficult to do though, especially considering how angry and unpredictable the wolf can be sometimes."
    "Sed id difficile invenio, maxime considerans quam iratus interdum lupus sit et quam aegre mores eius praevideantur."

# game/a3s1.rpy:574
translate latin a3s1_de1f525e:

    # "I manage to get maybe a couple hours of sleep."
    "Fortasse duas horas dormire possum."

# game/a3s1.rpy:576
translate latin a3s1_248a42ce:

    # "But as soon as the sun starts shining through the opening in the roof, I'm up and ready for Virginia to come get me."
    "Sed ubi sol per foramen tecti lucere incipit, surgo et paratus sum ut Virginia me petat."

# game/a3s1.rpy:577
translate latin a3s1_f46760fd:

    # "That doesn't happen until about an hour later, and Neferu only lifts his head for a moment when the wolf enters before groaning and dropping it back to the pillow."
    "Hoc non fit nisi post unam fere horam; Neferu tantum caput paulisper tollit cum lupa intrat, deinde gemit et rursus in pulvinum demittit."

# game/a3s1.rpy:578
translate latin a3s1_e7dd35d8:

    # "I'm hoping that he doesn't remember what happened yesterday, for his sake."
    "Spero eum non meminisse quid heri acciderit, propter ipsum."

# game/a3s1.rpy:581
translate latin a3s1_a7407fb3:

    # "The amount of anticipation in the air is almost too much for me to handle as I follow Virginia to the throne room."
    "Tanta exspectatio in aere est ut vix feram, dum Virginiam ad aulam throni sequor."

# game/a3s1.rpy:582
translate latin a3s1_ba556665:

    # "It's a feeling that I haven't felt since the trials, since when I thought I was about to be able to fly back home."
    "Sensus est quem post certamina non sensi, postquam putabam me mox domum volare posse."

# game/a3s1.rpy:583
translate latin a3s1_4fbea3ef:

    # "Now though, it's the anticipation that I'll be able to get Amicus out of the dungeons."
    "Sed nunc exspecto ut Amicum e carcere liberare possim."

# game/a3s1.rpy:584
translate latin a3s1_052a1037:

    # "We pause at the door, Virginia glancing at me."
    "Ad ianuam consistimus, Virginia ad me spectante."

# game/a3s1.rpy:586
translate latin a3s1_21717b76:

    # v "\"Remember, speak only if absolutely necessary. This is of the utmost importance.\""
    v "\"Memento: tantum loquere si omnino necesse est. Hoc maximi momenti est.\""

# game/a3s1.rpy:587
translate latin a3s1_71c8b117:

    # "I nod silently."
    "Tacitus annuo."

# game/a3s1.rpy:588
translate latin a3s1_3098e8a0:

    # "I get the feeling that she hadn't wanted me to come, but Neferu probably insisted."
    "Mihi videtur eam me venire noluisse, sed Neferu probabiliter institit."

# game/a3s1.rpy:589
translate latin a3s1_5f05b78e:

    # "The wolf reaches out and presses the panel, opening the door."
    "Lupa manum porrigit et tabulam premit, ianuam aperiens."

# game/a3s1.rpy:592
translate latin a3s1_b23cd80b:

    # "I follow her in and immediately spot Cassius on his throne, still on his little booster seat, but there's someone else too."
    "Eam intro sequor et statim Cassium in throno video, adhuc in parva sella altiore, sed etiam aliquis alius est."

# game/a3s1.rpy:593
translate latin a3s1_2a916ce0:

    # "We'd chosen today because Cato still hadn't returned from his trip, thus leaving Cassius alone."
    "Hodiernum diem elegeramus quia Cato adhuc ex itinere non redierat, Cassium igitur solum relinquens."

# game/a3s1.rpy:594
translate latin a3s1_d4fda896:

    # "Now though, Alex is here, kneeling beside the throne, his head on the armrest while Cassius strokes his head, his other paw occupied with a tablet-like device."
    "Sed nunc Alex hic est, iuxta thronum genibus flexis, capite bracchiali imposito dum Cassius caput eius mulcet, altera manu in instrumento tabellae simili occupata."

# game/a3s1.rpy:595
translate latin a3s1_86559426:

    # "He glances up."
    "Oculos tollit."

# game/a3s1.rpy:597
translate latin a3s1_48e05195:

    # c "\"Ah, sister...and [mc]. What was it you needed?\""
    c "\"Ah, soror...et [mc]. Quid vobis opus erat?\""

# game/a3s1.rpy:598
translate latin a3s1_eda9bdba:

    # "Virginia is silent until we stop at the base of the steps."
    "Virginia tacet donec ad imos gradus consistimus."

# game/a3s1.rpy:599
translate latin a3s1_d1e0b49b:

    # "I come to a stop just behind her, to her left."
    "Statim post eam, ad sinistram, consisto."

# game/a3s1.rpy:601
translate latin a3s1_05e9dcbe:

    # "Cassius narrows his eyes as he looks down at us, probably realizing that this is no ordinary visit."
    "Cassius oculos contrahit dum ad nos deorsum spectat, probabiliter intellegens hanc visitationem communem non esse."

# game/a3s1.rpy:603
translate latin a3s1_c1fb9c71:

    # "Meanwhile, Alex just stares at us inquisitively, looking innocent and oblivious as he always tries to."
    "Interea Alex tantum curiosus nos spectat, innocens atque ignarus videri conatus, sicut semper."

# game/a3s1.rpy:607
translate latin a3s1_44048250:

    # v "\"Brother...I have something very, very important to discuss with you.\""
    v "\"Frater...de re valde, valde gravi tecum disputare debeo.\""

# game/a3s1.rpy:608
translate latin a3s1_ec5ef88d:

    # "Cassius regards her for a moment, then glances at me."
    "Cassius paulisper eam considerat, tum ad me spectat."

# game/a3s1.rpy:610
translate latin a3s1_7a58e459:

    # c "\"Why is he here?\""
    c "\"Cur hic est?\""

# game/a3s1.rpy:612
translate latin a3s1_e18adbd1:

    # v "\"It involves him. It involves all of us, actually.\""
    v "\"Ad eum pertinet. Revera ad omnes nos pertinet.\""

# game/a3s1.rpy:614
translate latin a3s1_e41ee5d6:

    # "Cassius frowns deeply, expression growing more and more sour."
    "Cassius vehementer vultum contrahit, magis magisque amarus."

# game/a3s1.rpy:615
translate latin a3s1_6832ac46:

    # c "\"And what is it, Virginia?\""
    c "\"Et quid est, Virginia?\""

# game/a3s1.rpy:616
translate latin a3s1_359f4197:

    # "Virginia takes a deep breath."
    "Virginia alte spirat."

# game/a3s1.rpy:618
translate latin a3s1_85496cc8:

    # v "\"Cassius...you must abdicate.\""
    v "\"Cassi...abdicare debes.\""

# game/a3s1.rpy:621
translate latin a3s1_e0631be4:

    # "It takes Cassius a moment to take that in, but when he does, his eyes widen and his nostrils flare, leaning back in his throne like he's been slapped."
    "Cassio paulum temporis opus est ut hoc percipiat; tum oculi eius dilatantur et nares expanduntur, dum se in throno reclinat quasi alapa percussus sit."

# game/a3s1.rpy:623
translate latin a3s1_91c58798:

    # c "\"E—excuse me?\""
    c "\"Q—quid dixisti?\""

# game/a3s1.rpy:624
translate latin a3s1_1d25cf0e:

    # "I wonder if this is the best way to go about telling Cassius that we're about to try and take the throne from him."
    "Miror num haec optima via sit Cassio dicendi nos mox thronum ab eo auferre conaturos."

# game/a3s1.rpy:625
translate latin a3s1_8b1b0a5b:

    # "I look around, wondering if there are any drones that he might use to blast us with."
    "Circumspicio, miratus num automata adsint quibus nos ferire possit."

# game/a3s1.rpy:626
translate latin a3s1_3485a9dc:

    # v "\"Cassius, we all know that this is illegitimate. You must consider—\""
    v "\"Cassi, omnes scimus hoc illicitum esse. Considerare debes—\""

# game/a3s1.rpy:628
translate latin a3s1_30743b0e:

    # c "\"Enough! I will hear no talk of this...from my own sister, no less! Leave at once.\""
    c "\"Satis! Nullum de hac re sermonem audiam...a sorore mea ipsa quidem! Statim abite.\""

# game/a3s1.rpy:629
translate latin a3s1_06b84e9d:

    # "The young wolf is shaking in his seat, wide-eyed, ears flat."
    "Iuvenis lupus in sella tremit, oculis dilatatis auribusque complanatis."

# game/a3s1.rpy:630
translate latin a3s1_837f4148:

    # v "\"Well, you must hear it.\""
    v "\"Bene, audire debes.\""

# game/a3s1.rpy:632
translate latin a3s1_5d619cba:

    # c "\"I must not! I followed every protocol. I am in my rightful place. Leave now or I will have the drones escort you.\""
    c "\"Non debeo! Omnes leges secutus sum. In iusto loco meo sum. Nunc abite, aut automata vos comitari iubebo.\""

# game/a3s1.rpy:634
translate latin a3s1_00a7b130:

    # "Alex is sitting up straight now, staring at us, his ears perked, and I kind of wish that we could have had him leave the room."
    "Alex iam rectus sedet, nos spectans, auribus erectis; aliquantum vellem nos eum e cubiculo abire iubere potuisse."

# game/a3s1.rpy:636
translate latin a3s1_438248e8:

    # "Virginia remains calm, simply gazing back up at Cassius with an almost stoic look."
    "Virginia tranquilla manet, tantum ad Cassium vicissim suspiciens, vultu paene immoto."

# game/a3s1.rpy:637
translate latin a3s1_e43db0e7:

    # v "\"Brother, you must hear it, because we have proof of your deception.\""
    v "\"Frater, audire debes, quia fraudis tuae probationem habemus.\""

# game/a3s1.rpy:638
translate latin a3s1_62ab43d2:

    # "Cassius seems to have recovered from his initial shock, though he's still trembling a bit, chest heaving for breath."
    "Cassius e primo stupore se recepisse videtur, quamquam adhuc paulum tremit, pectore graviter spirante."

# game/a3s1.rpy:640
translate latin a3s1_b3ca42e2:

    # c "\"What...proof?\""
    c "\"Quam...probationem?\""

# game/a3s1.rpy:641
translate latin a3s1_359f4197_1:

    # "Virginia takes a deep breath."
    "Virginia alte spirat."

# game/a3s1.rpy:643
translate latin a3s1_4d9f03ab:

    # v "\"You know that we already know about the staging, but we have footage of the third trial...all of it.\""
    v "\"Scis nos iam scire de scaena ficta, sed imagines tertii certaminis habemus...omnes.\""

# game/a3s1.rpy:644
translate latin a3s1_9af23a27:

    # "Cassius stays quiet, unsure of what to say."
    "Cassius tacet, incertus quid dicat."

# game/a3s1.rpy:645
translate latin a3s1_188bdcb7:

    # v "\"We have contacts in Adastra that will release it to the public tomorrow evening.\""
    v "\"Nonnullos in Adastra nobiscum coniunctos habemus qui cras vesperi eas publico dabunt.\""

# game/a3s1.rpy:647
translate latin a3s1_a71669ec:

    # "Cassius swallows hard."
    "Cassius graviter deglutit."

# game/a3s1.rpy:649
translate latin a3s1_a296f849:

    # c "\"I will close the news channels.\""
    c "\"Canales nuntiorum claudam.\""

# game/a3s1.rpy:650
translate latin a3s1_8042deaa:

    # v "\"Not only to the news channels, but in portable formats as well that may be copied and spread. You will not be able to stop all of it.\""
    v "\"Non tantum canalibus nuntiorum, sed etiam in formis portabilibus quae describi atque diffundi possunt dabuntur. Omnia prohibere non poteris.\""

# game/a3s1.rpy:652
translate latin a3s1_92c1073a:

    # "Cassius opens his mouth, then closes it, then opens it again...then closes it."
    "Cassius os aperit, deinde claudit, rursus aperit...deinde claudit."

# game/a3s1.rpy:653
translate latin a3s1_5a786ffb:

    # "He didn't see this coming at all."
    "Hoc omnino non praevidit."

# game/a3s1.rpy:655
translate latin a3s1_95676bae:

    # "Finally, his shoulders drop and he stares at the floor."
    "Tandem umeri eius demittuntur et solum intuetur."

# game/a3s1.rpy:656
translate latin a3s1_280f73b0:

    # c "\"Virginia...how could you do this to me?\""
    c "\"Virginia...quomodo hoc mihi facere potuisti?\""

# game/a3s1.rpy:658
translate latin a3s1_7f6029e7:

    # "Virginia frowns, actually looking a bit sad."
    "Virginia vultum contrahit, aliquantum vere tristis."

# game/a3s1.rpy:659
translate latin a3s1_345e282f:

    # v "\"How could you take the throne in such a dishonest manner? Mother taught you better.\""
    v "\"Quomodo thronum tam improbe obtinere potuisti? Mater te melius docuit.\""

# game/a3s1.rpy:661
translate latin a3s1_e80cb004:

    # c "\"Do not speak of mother!\""
    c "\"Noli de matre loqui!\""

# game/a3s1.rpy:662
translate latin a3s1_872e68f6:

    # "Cassius's response is instant and angry before he deflates again."
    "Responsum Cassii statim iratum est, antequam rursus languescit."

# game/a3s1.rpy:664
translate latin a3s1_e9c52123:

    # "The silence stretches out for a while before Virginia speaks again."
    "Silentium aliquamdiu extenditur antequam Virginia rursus loquitur."

# game/a3s1.rpy:665
translate latin a3s1_d0e37417:

    # v "\"I know you Cass. I know you're an honest, honorable wolf. I know you don't want the emperorship like this.\""
    v "\"Te novi, Cass. Scio te lupum probum et honestum esse. Scio te imperium sic nolle.\""

# game/a3s1.rpy:666
translate latin a3s1_2739cf2d:

    # "Cassius goes on staring off into space."
    "Cassius nihil certum spectare pergit."

# game/a3s1.rpy:667
translate latin a3s1_d7d126f0:

    # m "\"Do you even want to be emperor, Cassius?\""
    m "\"Num omnino imperator esse vis, Cassi?\""

# game/a3s1.rpy:669
translate latin a3s1_bc934a29:

    # "Virginia looks sharply over at me, but I ignore her for now, looking right up at Cassius."
    "Virginia acute ad me spectat, sed nunc eam neglego, recta ad Cassium suspiciens."

# game/a3s1.rpy:671
translate latin a3s1_0c04eab2:

    # "He turns his gaze slowly to me."
    "Lente obtutum ad me vertit."

# game/a3s1.rpy:672
translate latin a3s1_fc02a00d:

    # c "\"What sort of question is that?\""
    c "\"Qualis quaestio est?\""

# game/a3s1.rpy:673
translate latin a3s1_ba193eab:

    # m "\"Remember when we saw the parents together?\""
    m "\"Meministi cum Parentes una vidimus?\""

# game/a3s1.rpy:675
translate latin a3s1_6a0462cf:

    # "Cassius instantly bristles, his ears turning a deep red."
    "Cassius statim pilos erigit, auribus valde rubentibus."

# game/a3s1.rpy:676
translate latin a3s1_fefadd85:

    # m "\"You remember what they said, right?\""
    m "\"Meministi quid dixerint, recte?\""

# game/a3s1.rpy:677
translate latin a3s1_0e9bcfca:

    # c "\"I don't remember.\""
    c "\"Non memini.\""

# game/a3s1.rpy:678
translate latin a3s1_63512457:

    # m "\"Sure, anyway, you know what the parents think, what they want. Just...listen to them, they only want what's best for this empire.\""
    m "\"Certe; ceterum, scis quid Parentes putent, quid velint. Tantum...eos audi; tantum quod huic imperio optimum est volunt.\""

# game/a3s1.rpy:679
translate latin a3s1_54954fff:

    # "Cassius closes his eyes, taking a deep breath."
    "Cassius oculos claudit, alte spirans."

# game/a3s1.rpy:681
translate latin a3s1_5afbea67:

    # c "\"Why are you doing this to me?\""
    c "\"Cur hoc mihi facitis?\""

# game/a3s1.rpy:682
translate latin a3s1_ddf9e68f:

    # "He says it quietly, and I'm not sure if he's talking to me, Virginia, or the both of us."
    "Leniter dicit; non certus sum utrum mihi, Virginiae an ambobus loquatur."

# game/a3s1.rpy:684
translate latin a3s1_a01fb054:

    # v "\"Because we also want what's best for the empire Cassius, and that involves a legitimate emperor that rightfully sits upon the throne.\""
    v "\"Quia nos quoque quod imperio optimum est volumus, Cassi, et hoc imperatorem legitimum complectitur qui iure in throno sedet.\""

# game/a3s1.rpy:686
translate latin a3s1_ff31a1e1:

    # c "\"I can't just abdicate. How many emperors have even done that? The humiliation would be too great.\""
    c "\"Non possum tantum abdicare. Quot imperatores vel id fecerunt? Dedecus nimium esset.\""

# game/a3s1.rpy:687
translate latin a3s1_f1191104:

    # "For the first time, I hear some resignation in Cassius's voice, and I actually do believe that he doesn't want this emperorship anymore."
    "Primum ex voce Cassii sentio eum paulum cedere; vere credo eum hoc imperium iam nolle."

# game/a3s1.rpy:688
translate latin a3s1_72838acc:

    # "I jump in again."
    "Rursus sermonem ingredior."

# game/a3s1.rpy:689
translate latin a3s1_2207e12d:

    # m "\"We can make up any story you want, Cassius. It doesn't have to be a shameful thing. We can make it seem honorable...even though I think it already is if you do step down.\""
    m "\"Quamlibet fabulam fingere possumus, Cassi. Res pudenda esse non debet. Honestam videri facere possumus...quamquam puto eam iam honestam esse si abdicas.\""

# game/a3s1.rpy:690
translate latin a3s1_79d4cade:

    # "Again, Cassius is silent, and I can only imagine all of the things that are going through his head right now."
    "Rursus Cassius tacet; tantum animo fingere possum omnia quae nunc in mente eius sunt."

# game/a3s1.rpy:691
translate latin a3s1_6bbe7673:

    # "He knows that the release of the footage will destroy his image, cause unrest, probably to the point that he'd never be able to recover if he remained on the throne."
    "Scit imagines publicatas existimationem suam perdituras, tumultum excitaturas, probabiliter adeo ut, si in throno maneat, se numquam recipere possit."

# game/a3s1.rpy:692
translate latin a3s1_afe61a5d:

    # "He already knows that he's been beaten."
    "Iam scit se victum esse."

# game/a3s1.rpy:694
translate latin a3s1_70de4d65:

    # "Alex, meanwhile, continues to sit at his side, just staring at the two of us."
    "Interea Alex iuxta eum sedere pergit, tantum ambos nos spectans."

# game/a3s1.rpy:695
translate latin a3s1_bc6d3725:

    # "I'm surprised he hasn't said anything at all, and again I'm not sure whose side he's on."
    "Miror eum nihil omnino dixisse; rursus non certus sum cui parti faveat."

# game/a3s1.rpy:697
translate latin a3s1_28c3d028:

    # v "\"Also, you need to demote Cato from Advisor, otherwise he will become acting emperor again.\""
    v "\"Etiam Catonem e munere Consiliarii demovere debes, alioquin rursus imperator interim regens fiet.\""

# game/a3s1.rpy:698
translate latin a3s1_7c65fa0a:

    # "Cassius looks sharply at us."
    "Cassius acute ad nos spectat."

# game/a3s1.rpy:700
translate latin a3s1_79114e15:

    # m "\"We know he's behind all of this...that you're a puppet, Cassius.\""
    m "\"Scimus eum post haec omnia esse...te pupam esse, Cassi.\""

# game/a3s1.rpy:704
translate latin a3s1_e5664e17:

    # "Cassius bristles and Virginia shoots me another warning look."
    "Cassius pilos erigit, et Virginia alium obtutum monentem mihi dat."

# game/a3s1.rpy:705
translate latin a3s1_4997b4fe:

    # m "\"But you're still the emperor. You have complete power over your advisor; you can easily cut those strings.\""
    m "\"Sed adhuc imperator es. Totam potestatem in consiliarium tuum habes; facile illa fila praecidere potes.\""

# game/a3s1.rpy:706
translate latin a3s1_5177068d:

    # "Cassius looks about ready to say something, to protest, but again he slumps down, just glaring at his knees."
    "Cassius quasi aliquid dicturus est, protestaturus; sed rursus languescit, tantum iratus genua sua spectans."

# game/a3s1.rpy:708
translate latin a3s1_736a272a:

    # c "\"That would automatically make Amicus emperor.\""
    c "\"Id statim Amicum imperatorem faceret.\""

# game/a3s1.rpy:709
translate latin a3s1_fbbe72e9:

    # "It's not a question, just a defeated statement."
    "Quaestio non est, tantum verba victi."

# game/a3s1.rpy:710
translate latin a3s1_26bc927b:

    # "We don't say anything."
    "Nihil dicimus."

# game/a3s1.rpy:712
translate latin a3s1_72e2889d:

    # c "\"I suppose he was always destined to be that. I was a fool to think I could make this work.\""
    c "\"Credo eum semper ad id destinatum esse. Stultus fui cum putavi me hoc efficere posse.\""

# game/a3s1.rpy:714
translate latin a3s1_34b4a831:

    # "Virginia's ears perk up and I feel a swooping feeling in my chest like I just missed a step."
    "Aures Virginiae eriguntur; lapsum in pectore sentio quasi gradum omiserim."

# game/a3s1.rpy:715
translate latin a3s1_3d7d86fb:

    # "Alex just looks up at Cassius, frowning."
    "Alex tantum ad Cassium suspicit, fronte contracta."

# game/a3s1.rpy:716
translate latin a3s1_1050aea7:

    # "Cassius shakes his head."
    "Cassius caput quatit."

# game/a3s1.rpy:718
translate latin a3s1_2c061b02:

    # c "\"I'll need to think. You said tomorrow evening?\""
    c "\"Cogitare debebo. Dixistis cras vesperi?\""

# game/a3s1.rpy:719
translate latin a3s1_e1400e6d:

    # v "\"The fourteenth hour.\""
    v "\"Hora quartadecima.\""

# game/a3s1.rpy:720
translate latin a3s1_29bb44ad:

    # "Cassius sighs, then nods."
    "Cassius suspirat, deinde annuit."

# game/a3s1.rpy:721
translate latin a3s1_6934ca8c:

    # c "\"I see. I will make an announcement tomorrow after breakfast. I need to meditate.\""
    c "\"Intellego. Cras post ientaculum pronuntiabo. Meditari debeo.\""

# game/a3s1.rpy:723
translate latin a3s1_7ee43426:

    # v "\"Certainly.\""
    v "\"Certe.\""

# game/a3s1.rpy:724
translate latin a3s1_b320fd32:

    # "Cassius drops his paw to his lap and picks up the glass tablet again, and just like that, we're dismissed."
    "Cassius manum in gremium demittit et tabellam vitream rursus capit; ita dimittimur."

# game/a3s1.rpy:726
translate latin a3s1_25d9c3e2:

    # "As Virginia turns to go, I quickly speak up."
    "Dum Virginia se vertit ut abeat, cito loquor."

# game/a3s1.rpy:727
translate latin a3s1_0d4c68d0:

    # m "\"Uh, Cassius? Can I see Amicus again?\""
    m "\"Eh, Cassi? Possum Amicum rursus videre?\""

# game/a3s1.rpy:728
translate latin a3s1_3c749781:

    # "He rolls his eyes."
    "Oculos volvit."

# game/a3s1.rpy:730
translate latin a3s1_ce7b44da:

    # c "\"Gods...yes, in fact—\""
    c "\"Di...ita, immo—\""

# game/a3s1.rpy:731
translate latin a3s1_536f3f6d:

    # "He looks up at the ceiling."
    "Ad tectum suspicit."

# game/a3s1.rpy:733
translate latin a3s1_039554da:

    # c "\"Com, set [mc]'s access to the dungeons as unrestricted...he'll be free by tomorrow anyway, I'm sure.\""
    c "\"Computatrum, aditum [mc] ad carceres sine limite dispone...cras tamen liber erit, certe.\""

# game/a3s1.rpy:734
translate latin a3s1_11cda958:

    # m "\"Thank you.\""
    m "\"Gratias.\""

# game/a3s1.rpy:736
translate latin a3s1_70d95e84:

    # "I bow because it feels like the right thing to do, but Cassius only grunts in response."
    "Inclino quia rectum videtur, sed Cassius tantum fremit."

# game/a3s1.rpy:737
translate latin a3s1_43a94352:

    # "I then quickly follow Virginia out into the hallway, almost skipping with relief and excitement."
    "Tum cito Virginiam in ambulacrum sequor, paene subsiliens levamine et gaudio."

# game/a3s1.rpy:740
translate latin a3s1_6f5f5f20:

    # m "\"Holy shit, that was easy!\""
    m "\"Di boni, id facile erat!\""

# game/a3s1.rpy:741
translate latin a3s1_646bc616:

    # "I whisper to the she-wolf as she maintains that stoic look."
    "Lupae susurro, dum vultum illum immotum servat."

# game/a3s1.rpy:743
translate latin a3s1_9d895475:

    # v "\"It really was, wasn't it? It seems that Cassius isn't enjoying his position on the throne after all.\""
    v "\"Vere erat, nonne? Videtur Cassio locus in throno tamen non placere.\""

# game/a3s1.rpy:744
translate latin a3s1_3a866959:

    # m "\"Did he think it would be easy?\""
    m "\"Putabatne facile fore?\""

# game/a3s1.rpy:745
translate latin a3s1_ce4bf356:

    # v "\"I think he never looked past beating Amicus. Now that he has, well...\""
    v "\"Credo eum ultra Amicum vincendum numquam spectavisse. Nunc cum vicit, bene...\""

# game/a3s1.rpy:746
translate latin a3s1_6a20a80d:

    # "I shake my head."
    "Caput quatio."

# game/a3s1.rpy:747
translate latin a3s1_d1fc70d9:

    # m "\"If that was his only reason, then he deserves this.\""
    m "\"Si haec sola causa eius erat, hoc meretur.\""

# game/a3s1.rpy:748
translate latin a3s1_96075f40:

    # v "\"Well, I don't believe it was his only reason, he simply didn't prepare himself beyond the trials.\""
    v "\"Bene, non credo eam solam causam fuisse; tantum ultra certamina se non paravit.\""

# game/a3s1.rpy:749
translate latin a3s1_1f22674d:

    # "Virginia side-eyes me."
    "Virginia a latere me spectat."

# game/a3s1.rpy:751
translate latin a3s1_0755091e:

    # v "\"And don't get too excited just yet. Nothing is final until Cassius says the words.\""
    v "\"Et nondum nimis gaude. Nihil firmum est donec Cassius verba dicit.\""

# game/a3s1.rpy:752
translate latin a3s1_acf64cce:

    # m "\"Yeah, but it looks like he's definitely going to.\""
    m "\"Ita, sed certe dicturus videtur.\""

# game/a3s1.rpy:753
translate latin a3s1_7d101186:

    # v "\"It does, yes, but remain careful and vigilant, also—\""
    v "\"Videtur, ita; sed cautus atque vigilans mane; etiam—\""

# game/a3s1.rpy:754
translate latin a3s1_76844bf4:

    # "Virginia pauses as we reach a branch in the hallway where we would part ways so that I can go to the dungeons."
    "Virginia consistit cum ad divisionem ambulacri pervenimus, ubi separaremur ut ad carceres eam."

# game/a3s1.rpy:755
translate latin a3s1_29d3914c:

    # "I stop and look up at her, stepping from one foot to the other, eager to tell Amicus the news."
    "Consisto et ad eam suspicio, de pede in pedem movens, cupidus Amico nuntios narrandi."

# game/a3s1.rpy:757
translate latin a3s1_99cffa5f:

    # v "\"You've noted my loyalty to Amicus over the past week, yes?\""
    v "\"Fidem meam erga Amicum superiore hebdomada animadvertisti, recte?\""

# game/a3s1.rpy:758
translate latin a3s1_fc3e2a4d:

    # m "\"Uh, yeah?\""
    m "\"Eh, ita?\""

# game/a3s1.rpy:759
translate latin a3s1_9b70abf7:

    # v "\"At the very least, this would be deserving of some time of official position, don't you think?\""
    v "\"Saltem hoc aliquod publicum munus mereretur, nonne putas?\""

# game/a3s1.rpy:760
translate latin a3s1_9ebe4f84:

    # m "\"You wanna be chief advisor, right?\""
    m "\"Praecipua consiliaria fieri vis, recte?\""

# game/a3s1.rpy:762
translate latin a3s1_f3cc3ec7:

    # v "\"Yes. And you are very close to him.\""
    v "\"Ita. Et tu ei proximus es.\""

# game/a3s1.rpy:763
translate latin a3s1_600666fc:

    # m "\"I'll get him to make it happen.\""
    m "\"Eum id facere efficiam.\""

# game/a3s1.rpy:765
translate latin a3s1_86a58d30:

    # "The wolf almost looks shocked."
    "Lupa paene attonita videtur."

# game/a3s1.rpy:766
translate latin a3s1_144439bf:

    # "I don't know why though; I'd assumed this was always part of the plan."
    "Sed nescio cur; putabam hoc semper partem consilii fuisse."

# game/a3s1.rpy:768
translate latin a3s1_53fb5f62:

    # v "\"Thank you, [mc].\""
    v "\"Gratias tibi ago, [mc].\""

# game/a3s1.rpy:769
translate latin a3s1_da156efe:

    # m "\"Of course. I'll see you later today.\""
    m "\"Certe. Te hodie postea videbo.\""

# game/a3s1.rpy:772
translate latin a3s1_3b967a6a:

    # "I leave the wolf standing there, trying not to walk too fast on my way to the dungeons."
    "Lupam ibi stantem relinquo, conatus ne nimis celeriter ad carceres ambulem."

# game/a3s1.rpy:775
translate latin a3s1_2e849425:

    # "Amicus is shocked when I tell him the news, obviously, but like Virginia, he tells me to stay cautious."
    "Amicus scilicet miratur cum nuntios ei dico; sed sicut Virginia me cautum manere iubet."

# game/a3s1.rpy:776
translate latin a3s1_85f4a4cf:

    # "Anything can happen between now and when Cassius makes the announcement."
    "Ex hoc tempore usque ad pronuntiationem Cassii quidlibet accidere potest."

# game/a3s1.rpy:777
translate latin a3s1_ea31c54a:

    # "And we're definitely not guaranteed an abdication during said announcement."
    "Nec certe promissum est eum in illa pronuntiatione abdicaturum."

# game/a3s1.rpy:778
translate latin a3s1_5f3b61a8:

    # "Either way, I promise Amicus to come back down first thing in the morning to tell him the news."
    "Utroque modo Amico promitto me primo mane rediturum ut nuntios dicam."

# game/a3s1.rpy:779
translate latin a3s1_66c29b20:

    # "I leave in good spirits, and I catch Amicus's tail wagging more than it usually does."
    "Laetus abeo, et caudam Amici plus quam solet moveri animadverto."

# game/a3s1.rpy:780
translate latin a3s1_bb73908d:

    # "We might actually be at the end of this nightmare..."
    "Fortasse vere ad finem huius horrendi somnii pervenimus..."

# game/a3s1.rpy:783
translate latin a3s1_1fe2b9dd:

    # com "\"[mc].\""
    com "\"[mc].\""

# game/a3s1.rpy:784
translate latin a3s1_a20cefa7:

    # "..."
    "..."

# game/a3s1.rpy:785
translate latin a3s1_1fe2b9dd_1:

    # com "\"[mc].\""
    com "\"[mc].\""

# game/a3s1.rpy:786
translate latin a3s1_ac94747a:

    # m "\"Huh?\""
    m "\"Hem?\""

# game/a3s1.rpy:788
translate latin a3s1_92da94fd:

    # "I stare at the ceiling, wondering for a moment where I am."
    "Tectum intueor, paulisper miratus ubi sim."

# game/a3s1.rpy:789
translate latin a3s1_39bf153a:

    # com "\"[mc], your presence is requested at breakfast.\""
    com "\"[mc], praesentia tua ad ientaculum petitur.\""

# game/a3s1.rpy:790
translate latin a3s1_df8ec4bc_3:

    # m "\"What?\""
    m "\"Quid?\""

# game/a3s1.rpy:791
translate latin a3s1_780375f4:

    # "I try to focus, the memories of last night slowly coming back to me."
    "Mentem colligere conor, memoriis noctis superioris lente redeuntibus."

# game/a3s1.rpy:792
translate latin a3s1_479c5379:

    # "I'd returned to Virginia and Neferu having a drink to celebrate our tentative victory."
    "Redieram ad Virginiam atque Neferu bibentes ut incertam victoriam nostram celebrarent."

# game/a3s1.rpy:793
translate latin a3s1_7b32a1b3:

    # "I'd joined them and maybe I had too much...it's a bit blurry, but the splitting headache is evidence enough."
    "Cum eis bibi et fortasse nimis multum...aliquantum confusum est, sed gravissimus capitis dolor satis indicat."

# game/a3s1.rpy:794
translate latin a3s1_dd6f77ac:

    # "Then I remember that Com woke me up."
    "Tum memini Computatrum me excitavisse."

# game/a3s1.rpy:795
translate latin a3s1_f57f5f1a:

    # m "\"Wait, breakfast?\""
    m "\"Exspecta, ientaculum?\""

# game/a3s1.rpy:796
translate latin a3s1_172ab3db:

    # com "\"Yes, your presence is requested immediately.\""
    com "\"Ita, praesentia tua statim petitur.\""

# game/a3s1.rpy:797
translate latin a3s1_eeb596ca:

    # "I hadn't had breakfast with the family since Amicus was imprisoned, why would they request me now?"
    "Cum familia ientaculum non habui postquam Amicus incarceratus est; cur nunc me petant?"

# game/a3s1.rpy:798
translate latin a3s1_1abc8a9e:

    # "That gets me nervous, knowing what's about to happen today."
    "Hoc me sollicitat, scientem quid hodie mox futurum sit."

# game/a3s1.rpy:799
translate latin a3s1_28936296:

    # "I look over to once again see Neferu sleeping in his bed, his fur uncharacteristically mussed up, just like yesterday morning."
    "Ad latus specto et rursus Neferu in lecto suo dormientem video, pilis contra morem incomptis, sicut heri mane."

# game/a3s1.rpy:800
translate latin a3s1_1e1cf41b:

    # "Quickly, I jump out of bed, throwing on my robes and trying to straighten out my hair as I hurry out and towards the dining room."
    "Cito e lecto salio, togam induens atque capillos componere conatus dum foras et ad triclinium festino."

# game/a3s1.rpy:803
translate latin a3s1_c95dcde3:

    # "I wonder if maybe Amicus is already out of the dungeons."
    "Miror num Amicus iam e carcere liberatus sit."

# game/a3s1.rpy:804
translate latin a3s1_1288d4bc:

    # "Maybe he's the one requesting my presence?"
    "Fortasse ipse praesentiam meam petit?"

# game/a3s1.rpy:805
translate latin a3s1_3078d135:

    # "But as I reach the door, I realize that's not the case."
    "Sed cum ad ianuam pervenio, intellego ita non esse."

# game/a3s1.rpy:813
translate latin a3s1_d177ec15:

    # "Virginia, Cassius, and Cato sit on the beds while Alex kneels in front of Cassius."
    "Virginia, Cassius atque Cato in lectis sedent, dum Alex ante Cassium genua flectit."

# game/a3s1.rpy:814
translate latin a3s1_bf86aa08:

    # "As I walk in, I can immediately tell that something's off."
    "Ubi intro ambulo, statim intellego aliquid alienum esse."

# game/a3s1.rpy:815
translate latin a3s1_0e7f3d71:

    # "The air is tense."
    "Aer sollicitudine plenus est."

# game/a3s1.rpy:816
translate latin a3s1_09280c0f:

    # "I come to a gradual stop, unsure of what to do as the rest of them glance up at me."
    "Paulatim consisto, incertus quid agam, dum alii oculos ad me tollunt."

# game/a3s1.rpy:818
translate latin a3s1_f76a494f:

    # ca "\"Ah, is that [mc]? How nice of you to join us. Would you care to serve us our food and drink, please?\""
    ca "\"Ah, [mc] est? Quam gratum est te nobiscum esse. Cibum atque potum nobis ministrare velis, quaeso?\""

# game/a3s1.rpy:819
translate latin a3s1_2db40aa9:

    # "Something is very wrong here."
    "Aliquid graviter male se habet hic."

# game/a3s1.rpy:820
translate latin a3s1_4e3b1d45:

    # "Did Cassius tell Cato about what happened?"
    "Cassiusne Catoni quid acciderit narravit?"

# game/a3s1.rpy:821
translate latin a3s1_24158393:

    # "There's not much else I can do except walk over to kneel beside Alex, reaching out to begin serving the wolves."
    "Parum aliud facere possum nisi ad Alex ambulare et iuxta eum genua flectere, manus porrigens ut Lupis ministrare incipiam."

# game/a3s1.rpy:822
translate latin a3s1_33b1ce60:

    # "It's completely silent as all of them just watch me fumbling around with the food."
    "Omnino silentium est, dum omnes me circa cibum inepte laborantem spectant."

# game/a3s1.rpy:823
translate latin a3s1_28e9677c:

    # "Finally, Virginia breaks the silence."
    "Tandem Virginia silentium rumpit."

# game/a3s1.rpy:824
translate latin a3s1_83491eaa:

    # v "\"Cato...is there a reason you called us all to breakfast?\""
    v "\"Cato...estne causa cur omnes nos ad ientaculum vocaveris?\""

# game/a3s1.rpy:825
translate latin a3s1_3e0fd94a:

    # "Cato turns his head in Virginia's direction."
    "Cato caput ad Virginiam vertit."

# game/a3s1.rpy:827
translate latin a3s1_acda6557:

    # ca "\"Can't I enjoy a meal with the royal siblings? I simply wanted to discuss my trip with you.\""
    ca "\"Non possum ientaculo cum regali fratre sororeque frui? Tantum de itinere meo vobiscum disputare volebam.\""

# game/a3s1.rpy:828
translate latin a3s1_f524c9a1:

    # v "\"Oh, I see. It's just been so long since we've had a scheduled breakfast.\""
    v "\"O, intellego. Tantum tam diu est postquam ientaculum constitutum habuimus.\""

# game/a3s1.rpy:829
translate latin a3s1_d20de67a:

    # ca "\"It may be a good habit to get back into, wouldn't you agree, Emperor Cassius?\""
    ca "\"Bonus mos esse possit quem recipiamus, nonne consentis, Imperator Cassi?\""

# game/a3s1.rpy:831
translate latin a3s1_3e6cc05c:

    # c "\"Oh! Yes, definitely Cato...how was your trip?\""
    c "\"O! Ita, certe, Cato...quomodo iter tuum fuit?\""

# game/a3s1.rpy:833
translate latin a3s1_33c262bd:

    # ca "\"Wonderful, I had the pleasure of visiting Ad Rotae. Being the entertainment capital of Adastra, I had such a good time observing the plays...despite my inability to observe.\""
    ca "\"Mirum; voluptatem habui Ad Rotae visendi. Cum caput oblectamenti Adastrae sit, tam bene me habui fabulas spectans...quamquam spectare non possum.\""

# game/a3s1.rpy:834
translate latin a3s1_34e29430:

    # "Cato starts laughing loudly and I can tell why everyone's on edge."
    "Cato clare ridere incipit; intellego cur omnes solliciti sint."

# game/a3s1.rpy:835
translate latin a3s1_e99fdf11:

    # "This isn't like Cato at all."
    "Hoc minime Catoni simile est."

# game/a3s1.rpy:836
translate latin a3s1_65408f1f:

    # "I set a plate out for Cato while Alex does the same for Cassius and while he's working on Virginia's plate, Cato shifts."
    "Patinam Catoni pono, dum Alex idem Cassio facit; dum Virginiae patinam parat, Cato se movet."

# game/a3s1.rpy:838
translate latin a3s1_4632f0d2:

    # ca "\"[mc], could you hand us all our goblets? I am absolutely parched.\""
    ca "\"[mc], omnibus nobis pocula dare potes? Valde sitio.\""

# game/a3s1.rpy:839
translate latin a3s1_90db77c4:

    # "I had noticed that the goblets had already been sat out in front of each wolf, already filled with wine."
    "Animadverteram pocula iam ante quemque lupum posita esse, iam vino plena."

# game/a3s1.rpy:840
translate latin a3s1_21af4e58:

    # "Carefully, I hand Cato his goblet, then turn and reach for Cassius's."
    "Diligenter Catoni poculum eius do, deinde me verto et Cassii peto."

# game/a3s1.rpy:842
translate latin a3s1_0049b059:

    # "\"{i}Fear not...these are the events that shall follow...{/i}\""
    "\"{i}Noli timere...haec sunt quae sequentur...{/i}\""

# game/a3s1.rpy:843
translate latin a3s1_af368f34:

    # "I blink, and I notice Cassius staring at me, raising an eyebrow."
    "Palpebras moveo et Cassium me spectantem animadverto, supercilio sublato."

# game/a3s1.rpy:844
translate latin a3s1_5c5539ce:

    # "I hold out the goblet, and my fingers twitch, but I keep a stubborn grip."
    "Poculum porrigo, et digiti mei tremunt, sed id pertinaciter teneo."

# game/a3s1.rpy:845
translate latin a3s1_ff439647:

    # "I shake my head and push the goblet into his paw."
    "Caput quatio et poculum in manum eius impello."

# game/a3s1.rpy:846
translate latin a3s1_7b7f7b47:

    # "I'm about to grab Virginia's, but Alex has already finished her plate and hands her her goblet as well."
    "Iam Virginiae capturus sum; sed Alex patinam eius iam perfecit et poculum quoque ei dat."

# game/a3s1.rpy:847
translate latin a3s1_c771ca7a:

    # "For a while, the wolves eat and drink in silence."
    "Aliquamdiu Lupi taciti edunt atque bibunt."

# game/a3s1.rpy:848
translate latin a3s1_639f2116:

    # "At least Virginia and Cassius do."
    "Saltem Virginia et Cassius."

# game/a3s1.rpy:849
translate latin a3s1_550fbd02:

    # "I notice Cato not touching his food at all, simply watching the rest of us."
    "Animadverto Catonem cibum suum omnino non tangere, tantum ceteros nos spectantem."

# game/a3s1.rpy:850
translate latin a3s1_0365a41d:

    # "Cassius lets out a loud cough."
    "Cassius clare tussit."

# game/a3s1.rpy:851
translate latin a3s1_bd54b0a1:

    # "Alex sets a paw on his leg in concern."
    "Alex sollicitus manum cruri eius imponit."

# game/a3s1.rpy:853
translate latin a3s1_52c1e822:

    # c "\"Sorry, something in my throat.\""
    c "\"Ignoscite, aliquid in gutture.\""

# game/a3s1.rpy:854
translate latin a3s1_3a331c2a:

    # "He takes another drink of his wine."
    "Rursus vinum bibit."

# game/a3s1.rpy:855
translate latin a3s1_fe93803e:

    # "\"{i}Keep your mind and heart open, great ape...You shall receive guidance...{/i}\""
    "\"{i}Mentem corque aperta tene, magna simia...Consilium accipies...{/i}\""

# game/a3s1.rpy:856
translate latin a3s1_f00d42f7:

    # "My vision flashes and the tension somehow builds, and I know now that something terrible is about to happen."
    "Visus meus micat et sollicitudo quodam modo crescit; iam scio aliquid horrendum mox futurum esse."

# game/a3s1.rpy:857
translate latin a3s1_acf4c868:

    # ca "\"So, Cassius. I hear you have an announcement to make this morning.\""
    ca "\"Ergo, Cassi. Audio te hoc mane aliquid pronuntiaturum.\""

# game/a3s1.rpy:861
translate latin a3s1_c8b801a1:

    # "The entire room freezes as the wolves stop eating and Alex stops serving."
    "Totum cubiculum immobile fit, Lupis edere desinentibus et Alex ministrare desinente."

# game/a3s1.rpy:862
translate latin a3s1_0d24e7f8:

    # "I sit there on my knees, trying to keep my breathing even, trying to deal with feeling like I have voices in my head, and with Cato apparently discovering our plan at the same time."
    "Ibi genibus flexis sedeo, spiritum aequum tenere conatus, conatus ferre sensum vocum in capite meo atque Catonem, ut videtur, simul consilium nostrum comperisse."

# game/a3s1.rpy:863
translate latin a3s1_7a38a2c6:

    # "Cassius finally speaks...or tries to."
    "Cassius tandem loquitur...aut conatur."

# game/a3s1.rpy:865
translate latin a3s1_bcd33917:

    # c "\"I—\""
    c "\"Ego—\""

# game/a3s1.rpy:867
translate latin a3s1_97e84dd8:

    # "He coughs again, harder this time."
    "Rursus tussit, vehementius hoc tempore."

# game/a3s1.rpy:869
translate latin a3s1_bcd33917_1:

    # c "\"I—\""
    c "\"Ego—\""

# game/a3s1.rpy:870
translate latin a3s1_4475fc7e:

    # "I notice him starting to shake, and Alex again puts a paw on his leg."
    "Animadverto eum tremere incipere; Alex rursus manum cruri eius imponit."

# game/a3s1.rpy:872
translate latin a3s1_8c7d51e4:

    # al "\"Cassius...Cassius, what's wrong?\""
    al "\"Cassi...Cassi, quid mali est?\""

# game/a3s1.rpy:873
translate latin a3s1_7fd52fd5:

    # ca "\"Yes, what's wrong Cassius? Don't you have a speech to give this morning? You might have to postpone it if you have a cough.\""
    ca "\"Ita, quid mali est, Cassi? Nonne hoc mane orationem habere debes? Fortasse differre debes si tussim habes.\""

# game/a3s1.rpy:874
translate latin a3s1_c458508e:

    # "Cassius suddenly sits up, trembling."
    "Cassius subito se erigit, tremens."

# game/a3s1.rpy:880
translate latin a3s1_392fa82e:

    # "He stares at Cato, wide-eyed, disbelieving, one paw moving to his throat."
    "Catonem oculis dilatatis intuetur, incredulus, una manu ad guttur mota."

# game/a3s1.rpy:882
translate latin a3s1_c05692ab:

    # al "\"Cassius!\""
    al "\"Cassi!\""

# game/a3s1.rpy:883
translate latin a3s1_abf7c567:

    # "He turns to Alex, reaching a paw out to him, which the cat catches."
    "Ad Alex se vertit, manum ad eum porrigens, quam felis capit."

# game/a3s1.rpy:884
translate latin a3s1_56be5092:

    # c "\"I...I can't...breathe...\""
    c "\"Ego...non possum...spirare...\""

# game/a3s1.rpy:885
translate latin a3s1_3ecb8893:

    # "Cassius wheezes looking down into his goblet, then he suddenly spasms curling over his stomach before another violent spasm takes him and he arches out onto the bed, screaming."
    "Cassius stridente spiritu in poculum suum deorsum spectat; tum subito convulsus super ventrem incurvatur, antequam alius violentus spasmus eum capit et in lecto arcuatur, clamans."

# game/a3s1.rpy:887
translate latin a3s1_0d55bc4b:

    # "It's a hideous sound, full of agony."
    "Horribilis sonus est, plenus cruciatus."

# game/a3s1.rpy:888
translate latin a3s1_8fdf7a51:

    # "It's so sudden, I'm left to just stare in shock, still on my knees."
    "Tam subitum est ut tantum attonitus spectem, adhuc genibus flexis."

# game/a3s1.rpy:889
translate latin a3s1_fe5dbb2d:

    # "Virginia stands up, moving around her bed to get closer to Cassius."
    "Virginia surgit et circa lectum suum ambulat ut ad Cassium propius accedat."

# game/a3s1.rpy:890
translate latin a3s1_1cd41325:

    # "Meanwhile, Alex screams as well, staring in horror at Cassius."
    "Interea Alex quoque clamat, Cassium horrens spectans."

# game/a3s1.rpy:891
translate latin a3s1_d7e4f232:

    # al "\"Cass! Cass, what is it, what happened!?\""
    al "\"Cass! Cass, quid est, quid accidit!?\""

# game/a3s1.rpy:892
translate latin a3s1_f38f1247:

    # "Cassius just writhes under him, even as Alex tries to hold him down."
    "Cassius tantum sub eo torquetur, dum etiam Alex eum tenere conatur."

# game/a3s1.rpy:893
translate latin a3s1_56b1d48f:

    # "I notice his mouth foaming, red from the wine, the goblet still held in his paw before he drops it, spilling it to the bed and floor."
    "Os eius spumare animadverto, vino rubrum, poculo adhuc in manu tento, antequam illud demittit, vino in lectum solumque effuso."

# game/a3s1.rpy:895
translate latin a3s1_e352e7f3:

    # al "\"CASS!\""
    al "\"CASS!\""

# game/a3s1.rpy:896
translate latin a3s1_54f81aa9:

    # "Alex's voice is filled with despair, probably realizing at the same time I do that Cassius has been poisoned, that he might be dying."
    "Vox Alex desperatione plena est; probabiliter simul ac ego intellegit Cassium venenatum esse, eum fortasse mori."

# game/a3s1.rpy:897
translate latin a3s1_b8019628:

    # ca "\"Oh dear, are you cramping, Cassius? Perhaps you ate too fast?\""
    ca "\"O miser, contractiones musculorum pateris, Cassi? Fortasse nimis celeriter edisti?\""

# game/a3s1.rpy:898
translate latin a3s1_3218deb6:

    # "The hair rises on the back of my neck as I sense Cato sitting behind me."
    "Pili in cervice mea eriguntur dum Catonem post me sedentem sentio."

# game/a3s1.rpy:899
translate latin a3s1_8c44d1bd:

    # "He'd found out about our plan."
    "Consilium nostrum compererat."

# game/a3s1.rpy:900
translate latin a3s1_88805f35:

    # "He'd put a stop to it just like that."
    "Sic tantum id prohibuerat."

# game/a3s1.rpy:901
translate latin a3s1_fa1e925d:

    # al "\"Cato, this was too far! Was it the wine!?\""
    al "\"Cato, hoc nimium erat! Vinumne erat!?\""

# game/a3s1.rpy:902
translate latin a3s1_de8f01ba:

    # "I almost don't register what Alex just said, but that's when I feel Cato get up behind me."
    "Vix percipio quid Alex modo dixerit; tum Catonem post me surgere sentio."

# game/a3s1.rpy:903
translate latin a3s1_92259f57:

    # "In a few steps, he's standing over Alex and Cassius before he swings a paw hard into Alex's face."
    "Paucis passibus supra Alex atque Cassium stat, deinde manum vehementer in faciem Alex iacit."

# game/a3s1.rpy:906
translate latin a3s1_a2b3410a:

    # "It sends the small cat flying so far that he's thrown up against the wall."
    "Parvum felem tam longe proicit ut in parietem impellatur."

# game/a3s1.rpy:907
translate latin a3s1_d0753a58:

    # "He crumples there, unmoving."
    "Ibi corruit, immobilis."

# game/a3s1.rpy:908
translate latin a3s1_f4903d04:

    # "Virginia ducks when this happens, but bravely moves forward, grabbing Cassius and turning him over onto his stomach."
    "Virginia cum hoc fit se demittit, sed fortiter procedit, Cassium capiens atque pronum vertens."

# game/a3s1.rpy:909
translate latin a3s1_e46b02c1:

    # "For a moment, I think Cato is going to do the same to her, but he seems to get himself under control."
    "Paulisper puto Catonem idem ei facturum, sed se continere videtur."

# game/a3s1.rpy:911
translate latin a3s1_5818a9a7:

    # ca "\"Was it the wine, then? Well...who served it?\""
    ca "\"Ergo vinum erat? Bene...quis ministravit?\""

# game/a3s1.rpy:912
translate latin a3s1_9244d4c5:

    # "He looks around inquisitively, even while Virginia sticks her fingers into Cassius's mouth, shoving them deep until the screaming wolf lets out a retch."
    "Curiosus circumspicit, dum Virginia digitos in os Cassii demittit, alte impellens donec lupus clamans vomendi conatum edit."

# game/a3s1.rpy:913
translate latin a3s1_6da87eb5:

    # "Cato's eyes settle on me."
    "Oculi Catonis in me consistunt."

# game/a3s1.rpy:914
translate latin a3s1_4d1eb44d:

    # ca "\"What did you put in his drink, simian?\""
    ca "\"Quid in potionem eius misisti, Simiane?\""

# game/a3s1.rpy:915
translate latin a3s1_4b5553af:

    # "I stay there on my knees, dumbfounded."
    "Ibi genibus flexis maneo, stupefactus."

# game/a3s1.rpy:916
translate latin a3s1_a358496f:

    # "Then, there's a splattering sound as Cassius vomits up his breakfast, tinged red from the wine."
    "Tum sonus respergentis auditur, dum Cassius ientaculum suum, vino subrubrum, vomit."

# game/a3s1.rpy:917
translate latin a3s1_1278e933:

    # "Virginia stubbornly continues to gag him, forcing out every little bit that she can."
    "Virginia pertinaciter vomitum eius excitare pergit, quidquid potest exprimens."

# game/a3s1.rpy:918
translate latin a3s1_83f3fd6c:

    # ca "\"Well...I suppose we'll have to investigate, won't we?\""
    ca "\"Bene...credo nos investigare debere, nonne?\""

# game/a3s1.rpy:920
translate latin a3s1_eec28777:

    # v "\"COM! Send a medical ship from Adastra City! Tell them the emperor has been poisoned!\""
    v "\"COMPUTATRUM! Navem medicam ex Urbe Adastra mitte! Dic imperatorem venenatum esse!\""

# game/a3s1.rpy:921
translate latin a3s1_02e7e13a:

    # com "\"Yes, Virginia.\""
    com "\"Ita, Virginia.\""

# game/a3s1.rpy:922
translate latin a3s1_7537c077:

    # "Cato looks down at me, then before I can move, he reaches out and grabs up my arm."
    "Cato ad me deorsum spectat, deinde antequam moveri possum, manum porrigit et bracchium meum capit."

# game/a3s1.rpy:923
translate latin a3s1_50187081:

    # "I've felt the power of a wolf before, main one being Amicus, of course, but this is different."
    "Vires lupi antea sensi, maxime Amici scilicet, sed hoc diversum est."

# game/a3s1.rpy:924
translate latin a3s1_297217bc:

    # "It's like he's made of stone."
    "Quasi ex lapide factus est."

# game/a3s1.rpy:925
translate latin a3s1_0aafee22:

    # "Cato starts pulling me toward the door and every step feels like my arm is about to be yanked out of its socket."
    "Cato me ad ianuam trahere incipit; quoque passu bracchium meum quasi e iunctura avellendum sentio."

# game/a3s1.rpy:927
translate latin a3s1_678700a6:

    # "As Cato marches out into the hallway, I grasp at his arm with my other hand, trying to relieve the pressure somehow."
    "Dum Cato in ambulacrum exit, altera manu bracchium eius capio, pressuram quodam modo levare conatus."

# game/a3s1.rpy:928
translate latin a3s1_170bc35e:

    # "The wolf stares straight ahead, ignoring me even as I try to pull away."
    "Lupus recta ante se spectat, me neglegens dum etiam recedere conor."

# game/a3s1.rpy:929
translate latin a3s1_bdbdb51b:

    # m "\"I can...walk.\""
    m "\"Possum...ambulare.\""

# game/a3s1.rpy:930
translate latin a3s1_d80a8ab7:

    # "I grit my teeth, my hand already numb."
    "Dentes comprimo, manu iam torpente."

# game/a3s1.rpy:931
translate latin a3s1_9fc15781:

    # "I look left and right, trying to figure out how I might get away."
    "Dextra sinistraque specto, viam effugiendi invenire conatus."

# game/a3s1.rpy:932
translate latin a3s1_e9667136:

    # "There's no chance for that though, as I realize we've reached Amicus's room."
    "Sed nulla facultas est; intellego nos ad cubiculum Amici pervenisse."

# game/a3s1.rpy:934
translate latin a3s1_59bde554:

    # "Suddenly, I find myself on the floor as the wolf throws me violently into the room."
    "Subito in solo sum, lupo me violenter in cubiculum iaciente."

# game/a3s1.rpy:935
translate latin a3s1_e181101f:

    # ca "\"I suggest you stay there; you have no means of escape anyway. I'll be back to...discuss things with you.\""
    ca "\"Moneo ut ibi maneas; tamen nullam viam effugiendi habes. Redibo ut...de rebus tecum disseram.\""

# game/a3s1.rpy:936
translate latin a3s1_4b2fbf8e:

    # "There's some strange humor in his voice with that last part, and before I can even look back, the door shuts and I hear another sound..."
    "In ultimis verbis mira iocositas in voce eius est; antequam respicere possum, ianua clauditur et alium sonum audio..."

# game/a3s1.rpy:938
translate latin a3s1_c3b5c3b6:

    # "...a click."
    "...crepitum."

# game/a3s1.rpy:941
translate latin a3s1_acd1b39c:

    # "I sit in Amicus's room in stunned silence for a long, long time."
    "In cubiculo Amici attonitus et tacitus per longum, longum tempus sedeo."

# game/a3s1.rpy:942
translate latin a3s1_e8b635cf:

    # "I still haven't been able to comprehend the series of events that had just unfolded."
    "Adhuc seriem rerum quae modo acciderunt intellegere non potui."

# game/a3s1.rpy:943
translate latin a3s1_ca308137:

    # "All I can piece together was that Alex, for whatever reason, had tipped Cato off as to what we were planning."
    "Tantum hoc colligere possum: Alex aliqua de causa Catonem de consiliis nostris monuisse."

# game/a3s1.rpy:944
translate latin a3s1_e545cd0e:

    # "I suppose the cat hadn't expected Cato to use such drastic measures, judging by his reaction, but he'd wanted to put a stop to our plans just the same."
    "Credo felem non exspectavisse Catonem tam gravibus modis usurum, ex reactione eius iudicans; sed tamen consilia nostra prohibere voluerat."

# game/a3s1.rpy:945
translate latin a3s1_73dbe2ed:

    # "I don't bother myself with trying to figure out Alex's motives anymore though."
    "Sed iam me consiliis Alex intellegendis non sollicito."

# game/a3s1.rpy:946
translate latin a3s1_df30e312:

    # "Instead, I'm left to sit here and wonder if there's anything I can possibly do to get out of this."
    "Tantum hic sedere debeo et mirari num quidquam facere possim ut ex his malis effugiam."

# game/a3s1.rpy:947
translate latin a3s1_4f87c68e:

    # "I soon find out that the clicking sound was the door locking."
    "Mox disco illum crepitum ianuam obserari significavisse."

# game/a3s1.rpy:948
translate latin a3s1_be604547:

    # "I suppose that means Cato is the acting emperor again, with Cassius either incapacitated...or even dead."
    "Credo id significare Catonem rursus imperatorem interim regentem esse, Cassio aut impotente...aut etiam mortuo."

# game/a3s1.rpy:949
translate latin a3s1_fc55dfd2:

    # "I ask Com about Cassius's health, but he only tells me that that information is not available to him."
    "Computatrum de valetudine Cassii rogo, sed tantum dicit sibi illa indicia praesto non esse."

# game/a3s1.rpy:950
translate latin a3s1_3472dacc:

    # "So I wait, sitting on the couch for hours, wondering if the next time the door slides open, it will be my death."
    "Itaque exspecto, in lectulo per horas sedens, miratus num proximo tempore quo ianua aperitur mors mea futura sit."

# game/a3s1.rpy:951
translate latin a3s1_8cdaa246:

    # "I need Amicus."
    "Amico egeo."

# game/a3s1.rpy:952
translate latin a3s1_85cd972f:

    # "These thoughts become too much for me and I have to get up to walk around, trying hard not to hyperventilate."
    "Hae cogitationes mihi nimiae fiunt; surgere atque ambulare debeo, diligenter conatus ne nimis celeriter spirem."

# game/a3s1.rpy:953
translate latin a3s1_a830b51a:

    # "Maybe Neferu will be able to do something."
    "Fortasse Neferu aliquid facere poterit."

# game/a3s1.rpy:954
translate latin a3s1_56bd817d:

    # "He must have heard about what happened by now...unless Cato did something to him as well."
    "Iam audivisse debet quid acciderit...nisi Cato ei quoque aliquid fecit."

# game/a3s1.rpy:955
translate latin a3s1_811f449b:

    # "With a deep breath, I push past the curtain and out onto the balcony."
    "Alte spirans, per velum foras in maenianum procedo."

# game/a3s1.rpy:958
translate latin a3s1_cc08ddf1:

    # "It's already late afternoon, but that's not what catches my attention."
    "Iam hora postmeridiana sera est, sed non id animum meum capit."

# game/a3s1.rpy:959
translate latin a3s1_567d3c97:

    # "Instead, it's the smoke rising over the city, the sun shining behind it all to give it a strange, red glow."
    "Sed fumus supra urbem surgens, sole post omnia lucente ut mirum rubrumque lumen praebeat."

# game/a3s1.rpy:960
translate latin a3s1_422844ed:

    # "I stare, wondering what possibly could have happened in the short time between this morning and now."
    "Intueor, miratus quid accidere potuerit in brevi tempore inter hoc mane et nunc."

# game/a3s1.rpy:961
translate latin a3s1_c3273a87:

    # m "\"Com?\""
    m "\"Computatrum?\""

# game/a3s1.rpy:962
translate latin a3s1_80cf3baf:

    # com "\"Yes, [mc]?\""
    com "\"Ita, [mc]?\""

# game/a3s1.rpy:963
translate latin a3s1_3feb32ae:

    # m "\"Why is there smoke over Adastra City?\""
    m "\"Cur fumus supra Urbem Adastra est?\""

# game/a3s1.rpy:964
translate latin a3s1_f85b39eb_1:

    # "There's a pause."
    "Paulisper tacet."

# game/a3s1.rpy:965
translate latin a3s1_b1811efc:

    # com "\"Here's what I found; at approximately the eleventh hour, Cato proclaimed himself emperor of Adastra shortly after Emperor Cassius was poisoned by a child pet.\""
    com "\"Haec inveni: hora fere undecima Cato se imperatorem Adastrae proclamavit, paulo postquam Imperator Cassius a deliciis e genere Liberorum venenatus est.\""

# game/a3s1.rpy:966
translate latin a3s1_3d9816ab:

    # com "\"Cato then dissolved the Triumvirate and assumed absolute control of the empire. There are destructive riots in all seven major cities.\""
    com "\"Cato deinde Triumviratum dissolvit atque absolutum imperii dominium accepit. Tumultus perniciosi in omnibus septem urbibus maximis sunt.\""

# game/a3s1.rpy:967
translate latin a3s1_7be1f3a0:

    # m "\"Is Cassius alive?\""
    m "\"Cassius vivit?\""

# game/a3s1.rpy:968
translate latin a3s1_a2fd2855:

    # com "\"That information is not available to me, [mc].\""
    com "\"Illa indicia mihi praesto non sunt, [mc].\""

# game/a3s1.rpy:969
translate latin a3s1_33fb006e:

    # "I sigh and stare down at the water, feeling sick."
    "Suspiro et ad aquam deorsum specto, nauseans."

# game/a3s1.rpy:970
translate latin a3s1_cc2149d5:

    # "I wonder how much of this is my fault...at least a little bit, if not all of it for just being here in the first place."
    "Miror quantum horum culpa mea acciderit...saltem aliquantum, si non omnia, tantum quia hic ab initio adsum."

# game/a3s1.rpy:971
translate latin a3s1_0b7e64ac:

    # "And now that Cato's framing me, I'm going to die..."
    "Et nunc cum Cato falso me accuset, moriar..."

# game/a3s1.rpy:972
translate latin a3s1_65a08bb7:

    # "My vision blurs with tears before one drops down into the sloshing lake below me..."
    "Visus meus lacrimis confunditur, antequam una in lacum sub me undantem cadit..."

# game/a3s1.rpy:973
translate latin a3s1_b850cd5c:

    # "...and then I remember."
    "...tum memini."

# game/a3s1.rpy:974
translate latin a3s1_e46216f2:

    # "I deleted my profile from Com's database."
    "Notas meas descriptas e datorum repositorio Computatri delevi."

# game/a3s1.rpy:975
translate latin a3s1_636331d1:

    # "I try to remember what I was told about how exactly it works...something to do with the AI's security system."
    "Conor meminisse quid mihi dictum sit de modo quo exacte agit...aliquid de systemate securitatis intellegentiae artificialis."

# game/a3s1.rpy:976
translate latin a3s1_6441b4d3:

    # "While he might be able to deduce what room I'm in based on my voice, he should be blind to my exact location."
    "Quamquam ex voce mea colligere possit in quo cubiculo sim, caecum esse debet ad exactum locum meum."

# game/a3s1.rpy:977
translate latin a3s1_76556022:

    # "That would mean leaving the boundaries of the palace shouldn't alert anything."
    "Id significet palatii fines egredi nihil excitaturum."

# game/a3s1.rpy:978
translate latin a3s1_69b72dbc:

    # "Maybe if I..."
    "Fortasse si ego..."

# game/a3s1.rpy:979
translate latin a3s1_a76c0719:

    # "I experimentally stick an arm over the railing, then a leg, and before I know it, I'm on the other side of the balcony, the lake sloshing below me."
    "Tentandi causa bracchium supra cancellos porrigo, deinde crus; antequam intellego, in altero latere maeniani sum, lacu sub me undante."

# game/a3s1.rpy:980
translate latin a3s1_3f03af31:

    # "I think about what I can do."
    "Cogito quid facere possim."

# game/a3s1.rpy:981
translate latin a3s1_1e250f52:

    # "I could swim for the shore, make a run for Adastra City and maybe find someone to help me."
    "Ad litus natare possim, ad Urbem Adastra currere et fortasse aliquem invenire qui me adiuvet."

# game/a3s1.rpy:982
translate latin a3s1_0591e7f0:

    # "Maybe one of those contacts that Neferu and Virginia keep talking about."
    "Fortasse unum ex illis quos Neferu et Virginia identidem memorant."

# game/a3s1.rpy:983
translate latin a3s1_ce866e9d:

    # "I could also just hide somewhere, maybe even on the island until things settle down a bit."
    "Possim etiam tantum alicubi latere, fortasse etiam in insula donec res aliquantum sedentur."

# game/a3s1.rpy:984
translate latin a3s1_e4a803dd:

    # "Running into a city in chaos probably wouldn't be the best move."
    "In urbem turbatam currere probabiliter non optimum consilium sit."

# game/a3s1.rpy:985
translate latin a3s1_ee0478a9:

    # "But...I already know what I'm going to do."
    "Sed...iam scio quid faciam."

# game/a3s1.rpy:986
translate latin a3s1_c18608b5:

    # "I'm not going to leave the palace."
    "Palatium non relinquam."

# game/a3s1.rpy:987
translate latin a3s1_a655056b:

    # "I'm going to find a way back in."
    "Viam qua rursus intrem inveniam."

# game/a3s1.rpy:988
translate latin a3s1_fa54f0d9:

    # "I need to get to Amicus."
    "Ad Amicum pervenire debeo."

# game/a3s1.rpy:989
translate latin a3s1_140ed949:

    # "I need to tell him what happened and...figure out a way to fall back on our last resort."
    "Ei narrare debeo quid acciderit atque...viam qua ad ultimum consilium confugiamus invenire."

# game/a3s1.rpy:990
translate latin a3s1_0030af29:

    # "My stomach twists at the idea, but I know that we're out of choices now."
    "Hac cogitatione venter meus torquetur, sed scio iam nullas alias vias nobis esse."

# game/a3s1.rpy:991
translate latin a3s1_a03b9c80:

    # "With that, I look down at the water and let go."
    "Tum ad aquam deorsum specto et me dimitto."

# game/a3s1.rpy:997
translate latin a3s1_fec97169:

    # "To be continued..."
    "Continuabitur..."

