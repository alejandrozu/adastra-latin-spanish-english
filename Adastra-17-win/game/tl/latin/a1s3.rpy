
# game/a1s3.rpy:2
translate latin a1s3_31a1e2c6:

    # "The next day, Amicus wakes me up by gently shaking my shoulder."
    "Postridie Amicus, umerum meum leniter quatiens, me excitat."

# game/a1s3.rpy:3
translate latin a1s3_823d26d2:

    # a "\"Hey...hey, [mc]? Wake up.\""
    a "\"Heus...heus, [mc]? Expergiscere.\""

# game/a1s3.rpy:5
translate latin a1s3_55bcffc8:

    # "I roll over on my sofa, groggily pulling the blanket up around me as I shiver."
    "In lectulo me converto; somno adhuc gravis, pallium circum me traho dum tremo."

# game/a1s3.rpy:6
translate latin a1s3_7ee8c806:

    # m "\"Ugh...it's so cold in here.\""
    m "\"Uf...quam frigidum hic est.\""

# game/a1s3.rpy:8
translate latin a1s3_8a6f2145:

    # a "\"Oh, I can turn up the heat if you'd like. It's just that I tend to...sweat a little when it's too warm.\""
    a "\"O, calorem augere possum, si vis. Solum...paulum sudare soleo cum nimis calet.\""

# game/a1s3.rpy:9
translate latin a1s3_34d6ee39:

    # m "\"Could just give me a better blanket.\""
    m "\"Vel melius pallium mihi dare posses.\""

# game/a1s3.rpy:11
translate latin a1s3_99851fb5:

    # a "\"Of course!\""
    a "\"Profecto!\""

# game/a1s3.rpy:12
translate latin a1s3_e5980160:

    # "I'm in just my underwear...my Romanesque underwear."
    "Solum subligaculum gero...subligaculum meum more Romano factum."

# game/a1s3.rpy:13
translate latin a1s3_7a6cc71d:

    # "Last night, Amicus had shown me (a bit awkwardly) how to tie it on."
    "Heri vesperi Amicus mihi, paulum verecunde, monstravit quomodo illud alligarem."

# game/a1s3.rpy:14
translate latin a1s3_6ceb2898:

    # "While it's comfortable, it always feels a little loose, and there's a constant worry that it's just going to drop off at some point."
    "Quamquam commodum est, semper paulum laxum videtur; assidue vereor ne aliquando decidat."

# game/a1s3.rpy:16
translate latin a1s3_3f9b2db6:

    # a "\"Anyway, we should get going soon. Alex is probably already waiting for us!\""
    a "\"Ceterum, mox proficiscendum nobis est. Alex nos probabiliter iam exspectat!\""

# game/a1s3.rpy:17
translate latin a1s3_66f1cd27:

    # "I rub the sleep from my eyes, drawing the blanket around myself a bit more tightly."
    "Somnum ex oculis frico et pallium paulo artius circum me duco."

# game/a1s3.rpy:18
translate latin a1s3_88eea13b:

    # m "\"For what?\""
    m "\"Quam ob rem?\""

# game/a1s3.rpy:20
translate latin a1s3_9918fccc:

    # a "\"We're going to the island for a picnic! You wanted something to do, didn't you?\""
    a "\"In insulam imus ut sub divo prandeamus! Aliquid agere volebas, nonne?\""

# game/a1s3.rpy:21
translate latin a1s3_705f013e:

    # m "\"Oh yeah, right.\""
    m "\"Ah, ita, memini.\""

# game/a1s3.rpy:23
translate latin a1s3_b254eac9:

    # "I get up and grab my new robe off the back of the sofa."
    "Surgo et novam tunicam e tergo lectuli capio."

# game/a1s3.rpy:24
translate latin a1s3_acae7eff:

    # a "\"Don't bother with a shower today since we'll be swimming...well, I will, anyway.\""
    a "\"Hodie lavari noli, quoniam natabimus...saltem ego natabo.\""

# game/a1s3.rpy:27
translate latin a1s3_000d9bf2:

    # "Amicus moves to the bathroom and pulls out a large glass bottle filled with a clear liquid."
    "Amicus in lavatorium abit et magnam lagonam vitream liquore pellucido plenam depromit."

# game/a1s3.rpy:28
translate latin a1s3_8c781358:

    # "He pours it into the glass cap and notices me watching."
    "Liquorem in operculum vitreum infundit et me spectantem animadvertit."

# game/a1s3.rpy:30
translate latin a1s3_2f196654:

    # a "\"Oh, would you like to try some? I suppose your species cares about dental hygiene considering your teeth look alright.\""
    a "\"O, paulum experiri vis? Opinor gentem tuam dentium munditiae consulere, cum dentes tui sani videantur.\""

# game/a1s3.rpy:31
translate latin a1s3_3ffe5d76:

    # m "\"What is it?\""
    m "\"Quid est?\""

# game/a1s3.rpy:33
translate latin a1s3_8e1384f7:

    # a "\"A wash that simply cleans the teeth. Keeps the breath from becoming offensively odorous.\""
    a "\"Liquor est qui dentes simpliciter purgat. Efficit ne halitus foede oleat.\""

# game/a1s3.rpy:34
translate latin a1s3_32e3d4a8:

    # "He holds out the cap and I take it from him as he just pours the liquid straight into his mouth."
    "Operculum porrigit; illud ab eo accipio, dum ipse liquorem recta in os infundit."

# game/a1s3.rpy:35
translate latin a1s3_3ecefa9c:

    # "I sniff it and though I expected a minty smell, it's floral instead."
    "Odorem eius naribus exploro; quamquam mentam exspectabam, flores redolet."

# game/a1s3.rpy:36
translate latin a1s3_242ddae1:

    # m "\"Is this all you use to clean your teeth?\""
    m "\"Hoc solum uteris ad dentes purgandos?\""

# game/a1s3.rpy:37
translate latin a1s3_06c0d7f0:

    # "Amicus swishes the liquid around in his mouth for a while, then spits it into the sink."
    "Amicus liquorem aliquantisper in ore agitat, deinde in labrum exspuit."

# game/a1s3.rpy:39
translate latin a1s3_00ab6a2e:

    # a "\"It removes any surface level debris, but you should get a deeper cleaning from a drone at least once a week. I can show you that later too, if you'd like.\""
    a "\"Sordes in superficie positas removet, sed saltem semel in hebdomada dentes ab automato penitius purgari debent. Id quoque tibi postea monstrare possum, si vis.\""

# game/a1s3.rpy:40
translate latin a1s3_ed6ee905:

    # "That...kinda sounds terrifying."
    "Hoc...paulum horrendum sonat."

# game/a1s3.rpy:41
translate latin a1s3_57c00e1b:

    # m "\"Maaaybe.\""
    m "\"Foortasse.\""

# game/a1s3.rpy:43
translate latin a1s3_27f2c8dc:

    # a "\"Honestly, you're supposed to use this every morning, but I forgot yesterday in all the excitement that we had.\""
    a "\"Re vera hoc singulis matutinis uti debes, sed heri ob omnia quae nobis evenerunt oblitus sum.\""

# game/a1s3.rpy:45
translate latin a1s3_ca6e7957:

    # "I lift the liquid-filled cap to my mouth and, with just a little hesitation, I pour it in."
    "Operculum liquore plenum ad os tollo et, paulum tantum cunctatus, liquorem infundo."

# game/a1s3.rpy:46
translate latin a1s3_a01c8f6f:

    # "The taste reminds me of walking into a room that's just been sprayed with air freshener."
    "Sapor me admonet quomodo sit cubiculum intrare in quo odorifera substantia modo aspersa sit."

# game/a1s3.rpy:47
translate latin a1s3_58536bfa:

    # "Not exactly pleasant, but when I spit it into the sink, I notice bits of what I assume to be plaque floating down the drain, and my mouth does feel a lot more fresh."
    "Non omnino iucundum est; sed cum in labrum exspuo, particulas quas puto esse sordes dentibus adhaerentes in cloacam defluentes video, et os meum multo purius sentitur."

# game/a1s3.rpy:48
translate latin a1s3_4df62a91:

    # "Guess it works."
    "Credo igitur hoc efficere."

# game/a1s3.rpy:49
translate latin a1s3_a0bdeb12:

    # "Amicus seems impatient though, shifting his weight from one foot to the other."
    "Amicus tamen impatiens videtur, modo alteri modo alteri pedi pondus corporis imponens."

# game/a1s3.rpy:51
translate latin a1s3_94235ba0:

    # a "\"Ready, [mc]?\""
    a "\"Paratus es, [mc]?\""

# game/a1s3.rpy:52
translate latin a1s3_b8afe3ec:

    # m "\"Uh, yeah, sure. Do you have bathing suits, or something?\""
    m "\"Ah, ita, sane. Vestimenta ad natandum habetis, vel aliquid simile?\""

# game/a1s3.rpy:54
translate latin a1s3_9a22748c:

    # a "\"Uhh, like clothes for swimming?\""
    a "\"Ah, vestes ad natandum dicis?\""

# game/a1s3.rpy:55
translate latin a1s3_5b5a83e5:

    # "Amicus steps out of the room and into the main hallway as I follow him."
    "Amicus e cubiculo in praecipuum ambulacrum exit; eum sequor."

# game/a1s3.rpy:58
translate latin a1s3_e8e158d7:

    # "At the same time I finish tying on my robe, trying to make sure everything is correctly in place."
    "Simul tunicam alligare perficio, conans efficere ut omnia recte composita sint."

# game/a1s3.rpy:60
translate latin a1s3_99b12af4:

    # a "\"No, we swim nude. But if you prefer to have something on you could use your undergarments. I can't imagine that would be comfortable, but Alex does it!\""
    a "\"Non, nudi natamus. Sed si aliquid gerere mavis, subligaculo tuo uti potes. Vix credo id commodum fore, sed Alex ita facit!\""

# game/a1s3.rpy:61
translate latin a1s3_c9dbdb63:

    # "Just as he says the cat's name, I see him standing in the hall, carrying a heavy-looking basket in both arms."
    "Cum nomen felis dicit, eum in ambulacro stantem video, corbem qui gravis videtur utroque bracchio portantem."

# game/a1s3.rpy:62
translate latin a1s3_cffb4dae:

    # "Once he sees us, he smiles."
    "Cum nos videt, subridet."

# game/a1s3.rpy:64
translate latin a1s3_d0a2816a:

    # al "\"Hello Amicus, hello [mc]. It's good to see you again. How are you this morning?\""
    al "\"Salve, Amice; salve, [mc]. Gaudeo te iterum videre. Quomodo te habes hoc mane?\""

# game/a1s3.rpy:65
translate latin a1s3_7cf81e77:

    # "I'm about to respond, but Amicus is already speaking."
    "Responsurus sum, sed Amicus iam loquitur."

# game/a1s3.rpy:67
translate latin a1s3_ff44c3f5:

    # a "\"Good, good. You got all the food, Alex?\""
    a "\"Bene, bene. Omnem cibum cepisti, Alex?\""

# game/a1s3.rpy:69
translate latin a1s3_6e4347cc:

    # al "\"Uh, yeah. Though are you sure it's not against protocol that I took all of this?\""
    al "\"Ah, ita. Sed certus es me haec omnia sumendo ordinem non violavisse?\""

# game/a1s3.rpy:71
translate latin a1s3_2b38fa88:

    # a "\"Well, it would be if I didn't approve it. Now let's go!\""
    a "\"Violares quidem, nisi ego permissem. Nunc eamus!\""

# game/a1s3.rpy:73
translate latin a1s3_f3274d5f:

    # "Alex and I follow the excited wolf's swishing tail as we head toward the front archways, an area that I haven't been to before."
    "Alex et ego caudam lupi laeti agitari videmus eamque sequimur, dum ad arcus anteriores imus, in locum quem nondum visitavi."

# game/a1s3.rpy:74
translate latin a1s3_4d724a8e:

    # ca "\"Ahem.\""
    ca "\"Hem.\""

# game/a1s3.rpy:75
translate latin a1s3_4bd084ee:

    # "I hear a familiar grunt and we all stop and turn around."
    "Gemitus notus auditur; omnes consistimus et nos convertimus."

# game/a1s3.rpy:79
translate latin a1s3_fc1b590c:

    # "Cato stands there watching us, stoic as always."
    "Cato ibi stat nos spectans, more suo impassibilis."

# game/a1s3.rpy:80
translate latin a1s3_11699fa9:

    # ca "\"Where might you three be off to?\""
    ca "\"Quo tandem vos tres pergitis?\""

# game/a1s3.rpy:82
translate latin a1s3_4e6d55c5:

    # a "\"Er, hello, Cato! We're going for a swim.\""
    a "\"Ah, salve, Cato! Ad natandum imus.\""

# game/a1s3.rpy:84
translate latin a1s3_75fdd6c0:

    # ca "\"A swim?\""
    ca "\"Ad natandum?\""

# game/a1s3.rpy:85
translate latin a1s3_2b472108:

    # "I can't exactly tell what's going on behind that visor, but the tone in his voice doesn't seem all that enthusiastic."
    "Quid post illam oculorum tegumentum agatur prorsus scire non possum, sed vox eius parum alacris videtur."

# game/a1s3.rpy:86
translate latin a1s3_677abf3b:

    # "Amicus seems to sense it too."
    "Amicus quoque id sentire videtur."

# game/a1s3.rpy:88
translate latin a1s3_bcc81977:

    # a "\"Yes.\""
    a "\"Ita.\""

# game/a1s3.rpy:89
translate latin a1s3_f5f4dc21:

    # "A moment of silence goes by."
    "Paulisper silentium est."

# game/a1s3.rpy:90
translate latin a1s3_df6be96d:

    # ca "\"You know you have combat training today, Amicus.\""
    ca "\"Scis te hodie pugnam exercere debere, Amice.\""

# game/a1s3.rpy:91
translate latin a1s3_3daf5d0a:

    # a "\"Well...yes, but only for part of the day. We'll be back shortly after noon.\""
    a "\"Ita...sed partem tantum diei. Paulo post meridiem revertemur.\""

# game/a1s3.rpy:92
translate latin a1s3_bb531317:

    # "Cato's face twitches and I can sense the disapproval coming off of him in waves."
    "Facies Catonis movetur; tanta indignatio ab eo emanare videtur ut eam paene sentiam."

# game/a1s3.rpy:93
translate latin a1s3_d4bc88ba:

    # "Then he turns his head slightly in my direction."
    "Deinde caput paulum ad me vertit."

# game/a1s3.rpy:95
translate latin a1s3_a7c7bd7d:

    # ca "\"You're taking the pets?\""
    ca "\"Delicias tecum ducis?\""

# game/a1s3.rpy:96
translate latin a1s3_7f1b07be:

    # "I quickly fix my face into a middle-distance stare."
    "Statim vultum compono et obtutum in medium spatium figo."

# game/a1s3.rpy:97
translate latin a1s3_a6a70d37:

    # a "\"Yes, I thought we could all use a little fresh air.\""
    a "\"Ita, putavi nos omnes paulum aere recenti egere.\""

# game/a1s3.rpy:99
translate latin a1s3_9ec1ffe2:

    # "Cato goes on staring for a moment, and I start to believe what Amicus said about Cato not having a good mood."
    "Cato paulisper spectare pergit; incipio credere Amico, qui Catonem numquam bono animo esse dixerat."

# game/a1s3.rpy:100
translate latin a1s3_aaa1707d:

    # "Finally, the old wolf turns his attention back to Amicus."
    "Tandem lupus senex animum rursus ad Amicum advertit."

# game/a1s3.rpy:102
translate latin a1s3_03487f9b:

    # ca "\"Well, I have some of my own duties to take care of this morning, but I expect you to be in the amphitheater by the 11th hour. Do not be late.\""
    ca "\"Bene, hoc mane quaedam officia mea curare debeo, sed te hora undecima in amphitheatro adesse exspecto. Noli sero venire.\""

# game/a1s3.rpy:104
translate latin a1s3_6899731d:

    # "With that, he turns and stalks off down the hall before disappearing around a marble corner."
    "His dictis se vertit et per ambulacrum graviter abit, donec post angulum marmoreum evanescit."

# game/a1s3.rpy:105
translate latin a1s3_48538c1f:

    # "Amicus lets out a breath."
    "Amicus suspirat."

# game/a1s3.rpy:107
translate latin a1s3_2556e7a4:

    # a "\"Ugh, thought he was going to cancel our outing all together. Alright, let's go before anyone else tries to stop us!\""
    a "\"Uf, putabam eum excursionem nostram omnino prohibiturum. Bene, eamus antequam alius nos retinere conetur!\""

# game/a1s3.rpy:108
translate latin a1s3_d5a5bc01:

    # "Amicus quickly turns toward the archways again and leads us out into the warm morning air."
    "Amicus cito rursus ad arcus se vertit et nos in tepidas auras matutinas ducit."

# game/a1s3.rpy:113
translate latin a1s3_5c4fe161:

    # al "\"You seem very eager, Amicus.\""
    al "\"Perstudiosus videris, Amice.\""

# game/a1s3.rpy:115
translate latin a1s3_461285c4:

    # a "\"Well, I haven't been swimming for weeks now, and I need a good exercise.\""
    a "\"Iam enim aliquot hebdomadas non natavi, et bona exercitatione egeo.\""

# game/a1s3.rpy:116
translate latin a1s3_e5735906:

    # "As we walk, I notice Alex huffing and puffing, struggling with the basket, so I hold out my hand."
    "Dum ambulamus, Alex graviter spirat et corbem vix portat; animadvertens manum porrigo."

# game/a1s3.rpy:117
translate latin a1s3_66610f9e:

    # m "\"Here, do you need help?\""
    m "\"Hem, auxilio eges?\""

# game/a1s3.rpy:119
translate latin a1s3_ae7d8d6c:

    # al "\"Oh, I don't want to inconvenience you—\""
    al "\"O, tibi molestus esse nolo—\""

# game/a1s3.rpy:120
translate latin a1s3_47406245:

    # "I reach out and take the handle of the basket and Alex doesn't resist as I pull it out of his paws."
    "Manum extendo et ansam corbis capio; Alex non resistit dum eum e manibus eius traho."

# game/a1s3.rpy:121
translate latin a1s3_948ae6a3:

    # "It's heavy, but not impossible to carry."
    "Gravis est, sed portari potest."

# game/a1s3.rpy:122
translate latin a1s3_df045a78:

    # "I heft it in both my hands as we walk down the path toward the lake."
    "Ambabus manibus eam sustineo, dum per semitam ad lacum ambulamus."

# game/a1s3.rpy:124
translate latin a1s3_6ccc155d:

    # al "\"Are you sure it's not too heavy?\""
    al "\"Certusne es eam non nimis gravem esse?\""

# game/a1s3.rpy:125
translate latin a1s3_88309383:

    # m "\"I'm fine! Though I think someone else might be able to handle it a bit better than us, especially since I imagine it's mostly HIS food.\""
    m "\"Bene me habeo! Puto tamen alium fortasse melius quam nos eam ferre posse, praesertim cum plerique cibi, ut opinor, EIUS sint.\""

# game/a1s3.rpy:127
translate latin a1s3_76c7624b:

    # "Amicus's ears perk at my pointed statement."
    "Amici aures ad verba mea consulto prolata eriguntur."

# game/a1s3.rpy:128
translate latin a1s3_3006f975:

    # a "\"Oh! Is it heavy?\""
    a "\"Oh! Gravisne est?\""

# game/a1s3.rpy:129
translate latin a1s3_8b3760fd:

    # "Amicus turns and yanks the basket from me, easily swinging it in one paw."
    "Amicus se vertit et corbem e manibus meis rapit, una manu facile eam huc illuc movens."

# game/a1s3.rpy:131
translate latin a1s3_643de721:

    # a "\"Should have said something, though I'll have to give it back once we get to the shore. I'll be swimming to the island!\""
    a "\"Dicere debuisti; sed cum ad litus pervenerimus eam reddam. Ego enim ad insulam natabo!\""

# game/a1s3.rpy:132
translate latin a1s3_e499761a:

    # "I frown."
    "Frontem contraho."

# game/a1s3.rpy:133
translate latin a1s3_73531d3f:

    # m "\"Is it far?\""
    m "\"Longe abest?\""

# game/a1s3.rpy:135
translate latin a1s3_d2fbb4d9:

    # a "\"Well of course you'll be taking the Sightseer.\""
    a "\"Vos scilicet Spectatrice vehemini.\""

# game/a1s3.rpy:136
translate latin a1s3_97e3eb46:

    # m "\"What's that?\""
    m "\"Quid est illud?\""

# game/a1s3.rpy:137
translate latin a1s3_535e834e:

    # "Alex moves up to walk alongside me."
    "Alex propius accedit ut iuxta me ambulet."

# game/a1s3.rpy:139
translate latin a1s3_3aa331dd:

    # al "\"You'll see. It's sort of a hovercraft for sight-seeing, as the name implies.\""
    al "\"Videbis. Quoddam est vehiculum in aere suspensum, ad loca spectanda, ut nomen indicat.\""

# game/a1s3.rpy:141
translate latin a1s3_f5e0c73f:

    # "After a few minutes, we reach the shore where there's a small gazebo with various boats underneath it."
    "Paucis minutis post ad litus pervenimus, ubi parva pergula est, variis naviculis sub ea positis."

# game/a1s3.rpy:142
translate latin a1s3_6a04aad0:

    # "There's also what sort of looks like a Jet Ski and next to that is...just a glass box with an open top."
    "Est etiam aliquid quod Jet Ski referre videtur; iuxta id autem...arca vitrea tantum, desuper aperta."

# game/a1s3.rpy:143
translate latin a1s3_aa02308d:

    # "This is what Alex and Amicus walk up to, the wolf leaning over to drop the picnic basket inside."
    "Ad hanc Alex et Amicus accedunt; lupus se inclinat et corbem cibariam intus deponit."

# game/a1s3.rpy:144
translate latin a1s3_a3976d28:

    # "Once he does that, he strips off his underwear and tosses it into the glass craft as well."
    "Quo facto, vestimentum interius exuit atque id quoque in naviculam vitream proicit."

# game/a1s3.rpy:145
translate latin a1s3_e0aeb681:

    # "I look away and notice Alex do the same, his ears down as he blushes furiously."
    "Oculos averto et Alex quoque oculos avertere video, auribus demissis, vehementer erubescentem."

# game/a1s3.rpy:146
translate latin a1s3_df431529:

    # "Trying to ignore the wolf, I walk up to the strange little craft, noticing that there's an open space on the side of the box that allows us to get in."
    "Lupum neglegere conans, ad naviculam miram parvam accedo; video in latere arcae apertum locum esse per quem intrare possimus."

# game/a1s3.rpy:147
translate latin a1s3_69531c60:

    # "The floor is glass as well, and I can see the dirt and vegetation underneath us."
    "Pavimentum quoque vitreum est, ita ut terram herbasque sub nobis videre possim."

# game/a1s3.rpy:148
translate latin a1s3_3b2c0be4:

    # a "\"Race you to the island!\""
    a "\"Certemus quis prior ad insulam perveniat!\""

# game/a1s3.rpy:149
translate latin a1s3_151612f9:

    # "Amicus cheerfully waves at us before running into the lake, the wolf's bushy tail swooshing around over his naked butt."
    "Amicus laetus nobis manu valedicit, deinde in lacum currit, cauda villosa supra nudas nates huc illuc mota."

# game/a1s3.rpy:151
translate latin a1s3_ca2cfce8:

    # al "\"Ugh...so inappropriate.\""
    al "\"Eheu...quam indecorum.\""

# game/a1s3.rpy:153
translate latin a1s3_e8f4042e:

    # "Alex shakes his head and turns to a slanted glass panel attached to the side of the craft."
    "Alex caput quatit et ad tabulam vitream obliquam in latere naviculae se vertit."

# game/a1s3.rpy:154
translate latin a1s3_0558b100:

    # "He touches it and several bright characters come to life on the screen."
    "Eam tangit, statimque aliquot clarae litterae in tabula apparent."

# game/a1s3.rpy:155
translate latin a1s3_2caf53ee:

    # "A few seconds later, our little glass craft levitates off the ground and starts to move over the water, albeit at a very slow pace."
    "Paucis secundis post parva navicula vitrea a terra tollitur et super aquam ferri incipit, quamquam lentissime."

# game/a1s3.rpy:156
translate latin a1s3_bcd6e1df:

    # m "\"Wow, what is this thing?\""
    m "\"Vah, quid est hoc instrumentum?\""

# game/a1s3.rpy:160
translate latin a1s3_81b3e19f:

    # al "\"A sight-seeing craft. Parental tech, so it's very safe and easy to navigate.\""
    al "\"Navicula ad loca spectanda. Ars Parentum est, itaque tutissima est et facile regi potest.\""

# game/a1s3.rpy:161
translate latin a1s3_4ce35368:

    # "I watch as we start to float over the slightly choppy water, Amicus already about 10 meters out in front of us."
    "Nos super aquam paulum agitatam ferri observo; Amicus iam fere 10 metra ante nos est."

# game/a1s3.rpy:162
translate latin a1s3_f1ca04b0:

    # m "\"He's a pretty good swimmer.\""
    m "\"Satis bene natat.\""

# game/a1s3.rpy:164
translate latin a1s3_d58b328e:

    # al "\"We're just slow. That's why he turned this into a race because he knows we won't beat him, even if we're going at full speed.\""
    al "\"Nos tantum lenti sumus. Ideo hanc rem in certamen mutavit: scit nos eum non superaturos esse, etiamsi summa celeritate feramur.\""

# game/a1s3.rpy:165
translate latin a1s3_04cb2419:

    # "Sure enough, Amicus starts to widen the gap."
    "Sane Amicus intervallum augere incipit."

# game/a1s3.rpy:166
translate latin a1s3_7400efa6:

    # "I notice Alex's ears twitching about as he navigates our craft, looking left and right while avoiding looking at the water altogether."
    "Video aures Alex moveri dum naviculam regit; dextra laevaque aspicit, ipsam autem aquam omnino vitat."

# game/a1s3.rpy:167
translate latin a1s3_ab910075:

    # m "\"Do you not like swimming?\""
    m "\"Natare tibi non placet?\""

# game/a1s3.rpy:168
translate latin a1s3_9f662e78:

    # al "\"Oh, I hate large bodies of water. It's a bit stressful coming out here honestly, but the island is serene and for the most part it makes the trip worth it.\""
    al "\"Oh, magna aquarum spatia odi. Huc venire, ut verum dicam, aliquantum me sollicitat; sed insula quieta est, et fere operae pretium est iter facere.\""

# game/a1s3.rpy:169
translate latin a1s3_da6b3ec9:

    # m "\"Ah...felines are kind of like that on Ea—my planet, too.\""
    m "\"Ah...feles quoque in Te—planeta meo similes fere mores habent.\""

# game/a1s3.rpy:170
translate latin a1s3_534d24e1:

    # "I cringe inwardly as I almost reveal the name of my planet."
    "Intus contremisco quod planetae mei nomen paene prodidi."

# game/a1s3.rpy:171
translate latin a1s3_6d17c3ca:

    # "It was pretty blatant, but Alex goes on like he didn't even notice."
    "Satis aperte id indicaveram; Alex autem loquitur quasi ne animadverterit quidem."

# game/a1s3.rpy:173
translate latin a1s3_6e739146:

    # al "\"Well, yes, similar origins and all, but honestly I'm a bit surprised that you're doing so well yourself, or that you even decided to come out here!\""
    al "\"Ita sane, similes origines habemus et cetera; sed vere miror te tam bene te habere, aut omnino statuisse huc venire!\""

# game/a1s3.rpy:174
translate latin a1s3_06dde7c5:

    # "That comes off as a little strange to me, but I'm distracted watching Amicus get closer to the island."
    "Id mihi paulum mirum videtur, sed animum mihi distrahit Amicus insulae appropinquans."

# game/a1s3.rpy:175
translate latin a1s3_8ac4acd5:

    # "Maybe only about fifty meters now."
    "Fortasse quinquaginta fere metra iam ab insula abest."

# game/a1s3.rpy:176
translate latin a1s3_7fe5589f:

    # "I start to get an idea, though."
    "Sed consilium quoddam mihi suboritur."

# game/a1s3.rpy:177
translate latin a1s3_8c702794:

    # "Judging by the distance between us, Amicus, and the island, I feel like I might be able to beat him..."
    "Ex intervallo inter nos, Amicum et insulam iudicans, sentio me fortasse eum superare posse..."

# game/a1s3.rpy:178
translate latin a1s3_dfebb020:

    # "I grin, then start stripping off my robe."
    "Late subrideo, deinde tunicam exuere incipio."

# game/a1s3.rpy:180
translate latin a1s3_f5ecb761:

    # al "\"Wh-what are you doing? We're not at the island yet!\""
    al "\"Qu—quid facis? Nondum ad insulam pervenimus!\""

# game/a1s3.rpy:181
translate latin a1s3_ea24e847:

    # "Alex blushes furiously again, looking away."
    "Alex rursus vehementer erubescit et oculos avertit."

# game/a1s3.rpy:182
translate latin a1s3_42e37fd2:

    # m "\"I'm gonna beat him.\""
    m "\"Eum superabo.\""

# game/a1s3.rpy:184
translate latin a1s3_b985c432:

    # al "\"What!?\""
    al "\"Quid!?\""

# game/a1s3.rpy:185
translate latin a1s3_141abefa:

    # "I grab onto the edge of the glass barrier and swing my legs over it."
    "Marginem saepimenti vitrei prehendo et crura super eum traicio."

# game/a1s3.rpy:186
translate latin a1s3_e0f2e819:

    # al "\"NO!\""
    al "\"NON!\""

# game/a1s3.rpy:187
translate latin a1s3_5351acb8:

    # "Alex actually tries to lunge for me, his paws just barely missing as I plunge into the lake."
    "Alex me apprehendere impetu conatur; manus eius vix me praetereunt, dum in lacum mergor."

# game/a1s3.rpy:190
translate latin a1s3_351a8526:

    # "I don't have much time to think about why because I'm instantly surrounded by freezing cold water."
    "Cur id faciat vix cogitare possum, quoniam statim gelidissima aqua circumdor."

# game/a1s3.rpy:191
translate latin a1s3_d1d89c21:

    # "I come up, gasping from the shock of it before I spot the direction of the island and start swimming toward it."
    "Emergo, frigore percussus anhelans; tum insulam conspicio et illuc natare incipio."

# game/a1s3.rpy:192
translate latin a1s3_1a76b22d:

    # "It's been a while since I've really had a chance to swim."
    "Diu est ex quo vera natandi occasio mihi data est."

# game/a1s3.rpy:193
translate latin a1s3_4fe897ed:

    # "I'd always been pretty good at it though, and soon enough I get into the familiar motions of putting one arm ahead of the other while turning my head to take breaths."
    "Natare tamen semper satis bene potui; mox familiares motus repeto, alterum brachium ante alterum proferens et caput vertens ut spiritum ducam."

# game/a1s3.rpy:194
translate latin a1s3_4ebcdde2:

    # "While this is going on, I can still hear Alex shouting behind me."
    "Dum haec facio, Alex a tergo meo adhuc clamantem audio."

# game/a1s3.rpy:195
translate latin a1s3_a9b9d98b:

    # "But then, just as I'm feeling that I'm about to gain on Amicus, I get rammed by something heavy and furry that suddenly starts to pull me into its grasp."
    "Sed cum iam Amico appropinquare mihi videar, res gravis et villosa in me incurrit meque repente amplecti incipit."

# game/a1s3.rpy:196
translate latin a1s3_2d331ada:

    # "At first, I wonder if I've been captured by some kind of Adastran sea monster."
    "Primum cogito num monstrum quoddam marinum Adastranum me ceperit."

# game/a1s3.rpy:197
translate latin a1s3_58e3de65:

    # "...Maybe that's why Alex is freaking out."
    "...Fortasse ideo Alex tam pavet."

# game/a1s3.rpy:198
translate latin a1s3_af44257b:

    # "But just as I'm about to resign myself to that fate—"
    "Sed cum iam illi sorti me traditurus sim—"

# game/a1s3.rpy:199
translate latin a1s3_0d181c37:

    # a "\"[mc]! Don't worry, I've got you!\""
    a "\"[mc]! Noli timere, te teneo!\""

# game/a1s3.rpy:200
translate latin a1s3_40485817:

    # "I stop fighting against the big, furry arms wrapping around me as I feel Amicus kicking his legs under mine, sort of pulling me toward the island that's just a few dozen meters away now."
    "Contra magna villosaque brachia me circumplexa luctari desino; sentio Amicum crura infra mea movere et me ad insulam trahere, quae iam paucas tantum duodenas metrorum abest."

# game/a1s3.rpy:201
translate latin a1s3_615edfba:

    # m "\"Wh—what are you doing!?\""
    m "\"Qu—quid facis!?\""

# game/a1s3.rpy:202
translate latin a1s3_abd632b0:

    # "I try to pull away, but Amicus keeps me in a fierce death-grip, refusing to loosen up at all."
    "Me expedire conor, sed Amicus me tenacissimo complexu retinet, omnino relaxare recusans."

# game/a1s3.rpy:203
translate latin a1s3_a7d8f66a:

    # al "\"By Galen!\""
    al "\"Per Galen!\""

# game/a1s3.rpy:204
translate latin a1s3_cbbbfe2e:

    # "I look up and see Alexios dumping out the basket full of food into the Sightseer before throwing the basket at me."
    "Suspicio et video Alexion corbem cibo plenam in Spectatricem exinanire, deinde ipsam corbem ad me proicere."

# game/a1s3.rpy:205
translate latin a1s3_1f53c82b:

    # al "\"Use this! It will keep you above water!\""
    al "\"Hac utere! Te supra aquam sustinebit!\""

# game/a1s3.rpy:206
translate latin a1s3_465ec4e9:

    # "It hits me in the face before gently bobbing away in the waves."
    "Vultum meum percutit, deinde undis leniter agitata abnatat."

# game/a1s3.rpy:207
translate latin a1s3_1bc7d1bb:

    # m "\"What the HELL is going on!?\""
    m "\"Quid, MALUM, agitur!?\""

# game/a1s3.rpy:208
translate latin a1s3_dd1aa4bf:

    # "I try to pull away from Amicus one last time, but give up, leaning into his chest with a bewildered expression on my face."
    "Postremo a complexu Amici me expedire conor; deinde omitto, pectori eius incumbens, vultu perplexo."

# game/a1s3.rpy:209
translate latin a1s3_e47333b8:

    # "He kicks his feet awkwardly under mine before I finally feel our feet drag into the shifting sand under the water."
    "Pedes incommode infra meos movet, donec tandem sentio pedes nostros in harenam mobilem sub aqua trahi."

# game/a1s3.rpy:211
translate latin a1s3_8c40b9e3:

    # "Even then, Amicus doesn't let me go."
    "Ne tum quidem Amicus me dimittit."

# game/a1s3.rpy:212
translate latin a1s3_71fd4e05:

    # "He keeps his firm grip around my wrist as he pulls me to shore, bringing us onto the little island."
    "Carpum meum adhuc arcte tenet dum me ad litus trahit, nos in parvam insulam ducens."

# game/a1s3.rpy:213
translate latin a1s3_e0f69c2d:

    # a "\"Are you alright!?\""
    a "\"Bene te habes!?\""

# game/a1s3.rpy:214
translate latin a1s3_21630eec:

    # "Amicus puts his paws on my shoulders, his wide eyes looking into mine, breathing heavily."
    "Amicus manus in umeros meos ponit, patulis oculis in meos aspiciens, graviter anhelans."

# game/a1s3.rpy:215
translate latin a1s3_2096c85e:

    # m "\"Yes! What the hell just happened?\""
    m "\"Ita! Quid, malum, modo accidit?\""

# game/a1s3.rpy:216
translate latin a1s3_0b6bd83b:

    # "I rub my nose where the basket hit me in the face and that's when Alex's little craft pushes gently onto the sand."
    "Nasum frico, ubi corbis vultum percussit; tum parva navicula Alex leniter in harenam impellitur."

# game/a1s3.rpy:217
translate latin a1s3_1ad669eb:

    # "He hops out, running up to us."
    "Ex ea desilit et ad nos currit."

# game/a1s3.rpy:219
translate latin a1s3_da0bd097:

    # al "\"I don't know what happened Amicus! He just jumped out! I'm sorry I couldn't stop him.\""
    al "\"Nescio quid acciderit, Amice! Modo exsiluit! Ignosce quod eum prohibere non potui.\""

# game/a1s3.rpy:220
translate latin a1s3_f007de41:

    # "Alex bows deeply, ears flat and trembling."
    "Alex se alte inclinat, auribus depressis ac trementibus."

# game/a1s3.rpy:221
translate latin a1s3_70f8ff35:

    # "I start to wonder if maybe there's something in the water that I wasn't supposed to come into contact with."
    "Cogitare incipio num aliquid in aqua sit quod tangere non debuerim."

# game/a1s3.rpy:222
translate latin a1s3_4d6d9a18:

    # "I look at my skin, but everything seems fine."
    "Cutem meam aspicio; sed omnia bene se habere videntur."

# game/a1s3.rpy:223
translate latin a1s3_35bc6ab6:

    # "I finally look up at Amicus, trying to ignore his dick as it swings around between his legs."
    "Tandem oculos ad Amicum attollo, mentulam eius inter crura motam neglegere conans."

# game/a1s3.rpy:224
translate latin a1s3_7a52be3f:

    # "Amicus seems to notice at the same time and covers up his crotch with his paw, keeping the other on my shoulder."
    "Amicus simul id animadvertere videtur et inguina altera manu tegit, alteram in umero meo retinens."

# game/a1s3.rpy:225
translate latin a1s3_b21e4f45:

    # m "\"Can you just explain to me what happened?\""
    m "\"Potesne modo explicare quid acciderit?\""

# game/a1s3.rpy:227
translate latin a1s3_c7328555:

    # "Amicus frowns at me."
    "Amicus frontem contrahens me aspicit."

# game/a1s3.rpy:228
translate latin a1s3_3d000ce9:

    # a "\"Well...You can't swim...you're hopeless in water. It's why I wanted you in the craft.\""
    a "\"Bene...Tu natare non potes...in aqua nihil vales. Ideo te in navicula esse volebam.\""

# game/a1s3.rpy:229
translate latin a1s3_59ddd0d0:

    # "Alex's lips tremble a bit, as if about to cry."
    "Labia Alex paulum tremunt, quasi iam fleturus sit."

# game/a1s3.rpy:231
translate latin a1s3_17cb50a0:

    # al "\"You're not born with natural swimming abilities. Whenever a primate falls into water they're almost sure to drown. Are you sure you're okay? I'm so, so sorry.\""
    al "\"Non cum innata natandi facultate nascimini. Quotiens primas in aquam cadit, paene certo mergitur et moritur. Certusne es te bene valere? Valde, valde doleo.\""

# game/a1s3.rpy:232
translate latin a1s3_f588645f:

    # "The way they explain to me how primates work reminds me that they still might not consider me to be on the same intelligence level as them."
    "Modus quo mihi exponunt quid primates facere possint me admonet eos fortasse adhuc non putare me tam intellegentem quam ipsos esse."

# game/a1s3.rpy:233
translate latin a1s3_779d50e1:

    # "It's like I don't know my own species capabilities, that I just jumped in because I'm a stupid barbarian."
    "Quasi nescirem quid species mea facere possit, et tantum exsiluissem quia stultus barbarus sum."

# game/a1s3.rpy:234
translate latin a1s3_ddd6c55d:

    # "It irritates me, but both of them look almost traumatized."
    "Id me irritat; ambo autem paene penitus perterriti videntur."

# game/a1s3.rpy:235
translate latin a1s3_4efd49cb:

    # "Especially Amicus."
    "Praesertim Amicus."

# game/a1s3.rpy:236
translate latin a1s3_ce68a004:

    # "The paw not concealing his crotch is still firmly locked on my shoulder, as if worried I'm going to go running off into the water again."
    "Manus quae inguina non tegit adhuc umerum meum firmissime tenet, quasi metuens ne rursus in aquam curram."

# game/a1s3.rpy:237
translate latin a1s3_728267e7:

    # m "\"Guys...I can swim. I mean, yeah it's not natural for us, but we can learn. I've known how to swim since I was a kid.\""
    m "\"Amici...natare possum. Ita sane, id nobis non innatum est; sed discere possumus. Iam a pueritia natare scio.\""

# game/a1s3.rpy:238
translate latin a1s3_dcacdd54:

    # "They still stare back at me, as if not understanding."
    "Adhuc me intuentur, quasi non intellegant."

# game/a1s3.rpy:239
translate latin a1s3_af121244:

    # a "\"Really?\""
    a "\"Revera?\""

# game/a1s3.rpy:240
translate latin a1s3_c5a23f0e:

    # m "\"Well yeah, do you think I just jumped out of the...the thing to just drown myself?\""
    m "\"Ita sane; putatisne me ex illo...ex illo instrumento desiluisse tantum ut me ipsum submergerem?\""

# game/a1s3.rpy:241
translate latin a1s3_65f1d361:

    # "Amicus lets go of my shoulder to cover his dick with both paws now."
    "Amicus umerum meum dimittit ut mentulam nunc ambabus manibus tegat."

# game/a1s3.rpy:242
translate latin a1s3_b6a2cf87:

    # a "\"I don't know. I know you're unhappy here, so I wasn't sure...\""
    a "\"Nescio. Scio te hic infelicem esse; itaque non certus eram...\""

# game/a1s3.rpy:243
translate latin a1s3_e33f02ef:

    # "I laugh."
    "Rideo."

# game/a1s3.rpy:244
translate latin a1s3_864b89ce:

    # m "\"I'm not THAT unhappy. I'm fine. And you know, I'm not an idiot. I thought you'd know this by now, Amicus.\""
    m "\"Non TAM infelix sum. Bene me habeo. Scis, non stultus sum. Putabam te iam hoc scire, Amice.\""

# game/a1s3.rpy:245
translate latin a1s3_e1ecad33:

    # "Things go quiet then; Alex looking off to the side with his ears down, Amicus standing awkwardly and covering his crotch with both paws."
    "Tum silentium fit: Alex auribus demissis ad latus aspicit; Amicus incommode stat, inguina ambabus manibus tegens."

# game/a1s3.rpy:246
translate latin a1s3_0a75131a:

    # m "\"So did I ruin our outing?\""
    m "\"Ergo excursionem nostram corrupine?\""

# game/a1s3.rpy:248
translate latin a1s3_7f345d7e:

    # a "\"No, no. I just need to remember that you're not a typical Child. Now uh, let's try to relax and have some fun. It's the whole reason we came out here after all!\""
    a "\"Non, non. Modo meminisse debeo te non esse unum e Liberis qui vulgo inveniuntur. Nunc autem, hem, quiescamus et oblectemur. Hanc ob causam huc venimus!\""

# game/a1s3.rpy:249
translate latin a1s3_73a4e09c:

    # "Alex still looks a bit dejected, looking off toward the Sightseer."
    "Alex adhuc paulum deiectus videtur, ad Spectatricem aspiciens."

# game/a1s3.rpy:250
translate latin a1s3_d689df3d:

    # al "\"I ruined our food. I'm sorry.\""
    al "\"Cibos nostros perdidi. Ignosce.\""

# game/a1s3.rpy:251
translate latin a1s3_5ea15bd5:

    # "Alex bows again."
    "Alex rursus se inclinat."

# game/a1s3.rpy:252
translate latin a1s3_171f7346:

    # "I remember how Alex isn't really supposed to know about my intelligence, or anything about me, really."
    "Memini Alex non debere scire quam intellegens sim; immo nihil fere de me scire debet."

# game/a1s3.rpy:253
translate latin a1s3_3303ec66:

    # "But if he's bothered by the conversation that just took place, he's not showing it."
    "Sed si colloquium quod modo habuimus eum perturbat, id non ostendit."

# game/a1s3.rpy:254
translate latin a1s3_f887bb98:

    # "Amicus shrugs."
    "Amicus umeros tollit."

# game/a1s3.rpy:256
translate latin a1s3_9f456f95:

    # a "\"Stop bowing, it makes me feel strange.\""
    a "\"Desine te inclinare; me mirum in modum afficit.\""

# game/a1s3.rpy:257
translate latin a1s3_1d1bda8a:

    # "The naked wolf ambles over to the craft and as he leans over to look at the cluttered mess inside"
    "Lupus nudus ad naviculam lente ambulat et, cum se inclinet ut res intus perturbatas aspiciat,"

# game/a1s3.rpy:258
translate latin a1s3_4886ba73:

    # "His tail lifts and we get a view of his butt again."
    "cauda eius attollitur et nates rursus videmus."

# game/a1s3.rpy:260
translate latin a1s3_797a005e:

    # "Alex looks away, blushing, but at this point I think I've given up on trying not to see the various naked parts of this wolf."
    "Alex erubescens oculos avertit; iam autem, credo, omisi conatus varias partes nudas huius lupi non videndi."

# game/a1s3.rpy:261
translate latin a1s3_40074a98:

    # "Being in the nude seems pretty natural for him, even if he tries to hide it from us."
    "Nudus esse ei satis naturale videtur, etiamsi id a nobis celare conatur."

# game/a1s3.rpy:263
translate latin a1s3_b7cf2bd1:

    # a "\"I think we can salvage a decent meal out of this. The wine's good!\""
    a "\"Puto adhuc satis bonam refectionem ex his cibis parari posse. Vinum bonum est!\""

# game/a1s3.rpy:264
translate latin a1s3_09805e56:

    # "Amicus lifts a large bottle of wine into the air, still not turning around."
    "Amicus magnam vini lagonam in aera tollit, adhuc non se convertens."

# game/a1s3.rpy:266
translate latin a1s3_95c34620:

    # al "\"I—I'll sort through it Amicus. Please, enjoy your swimming exercises in the meantime.\""
    al "\"E—ego cibos eligam et componam, Amice. Tu interim, quaeso, natando te exerce et fruere.\""

# game/a1s3.rpy:267
translate latin a1s3_76423db0:

    # "Alex quickly moves to start gathering up the food, head down."
    "Alex celeriter cibos colligere incipit, capite demisso."

# game/a1s3.rpy:269
translate latin a1s3_f3c795f2:

    # a "\"Well...alright. And ears up, Alex! We're here to have fun!\""
    a "\"Bene...fiat. Et aures tolle, Alex! Hic sumus ut oblectemur!\""

# game/a1s3.rpy:270
translate latin a1s3_27de9264:

    # "Alex puts his ears up, but doesn't lift his head to look at us."
    "Alex aures tollit, sed caput ad nos aspiciendos non erigit."

# game/a1s3.rpy:272
translate latin a1s3_1e70efdc:

    # a "\"Oh, right.\""
    a "\"O, recte.\""

# game/a1s3.rpy:273
translate latin a1s3_39fd8972:

    # "The wolf grins at me, dipping his muzzle down at his crotch."
    "Lupus mihi late subridet, rostrum ad inguina sua inclinans."

# game/a1s3.rpy:274
translate latin a1s3_e4aec8cb:

    # a "\"The Cats are just like you when it comes to this sort of thing. Anyway, I'll get in the water so you won't have to keep averting your eyes. You should join me now that we know you can swim, [mc]!\""
    a "\"Feles in talibus rebus tibi similes sunt. Ceterum in aquam ingrediar, ne oculos semper avertas. Quin mecum natas, nunc cum te natare posse sciamus, [mc]!\""

# game/a1s3.rpy:276
translate latin a1s3_f033435a:

    # "I start to follow, then look back at the cat."
    "Eum sequi incipio, deinde ad felem respicio."

# game/a1s3.rpy:277
translate latin a1s3_e4baecd0:

    # m "\"Uh, do you need help, Alex?\""
    m "\"Hem, opusne tibi auxilio est, Alex?\""

# game/a1s3.rpy:279
translate latin a1s3_b0e37c50:

    # "Alex shakes his head quickly, and I can see that he's still blushing."
    "Alex celeriter caput quatit; eum adhuc erubescere video."

# game/a1s3.rpy:280
translate latin a1s3_9e1381cc:

    # al "\"Go on and swim, [mc]. I'll just be sunbathing anyway.\""
    al "\"Age, nata, [mc]. Ego tantum in sole apricabor.\""

# game/a1s3.rpy:282
translate latin a1s3_b8b83359:

    # "There isn't much room in the Sightseer for two people, and Amicus seems to be waiting for me, so I follow the wolf out toward the water."
    "In Spectatrice duabus personis non multum loci est, et Amicus me exspectare videtur; itaque lupum versus aquam sequor."

# game/a1s3.rpy:284
translate latin a1s3_0c2ccc83:

    # a "\"Intelligent conversation AND a swimming partner. I have a pet that can do it all!\""
    a "\"Et colloquia sapientia et socium natandi! Animal domesticum habeo quod omnia potest!\""

# game/a1s3.rpy:285
translate latin a1s3_6a678fbf:

    # "Amicus shoulders me as we walk along the beach, making me stumble."
    "Amicus umero me impellit, dum per litus ambulamus, ita ut titubem."

# game/a1s3.rpy:286
translate latin a1s3_2cd5ad3b:

    # m "\"Hey.\""
    m "\"Heus.\""

# game/a1s3.rpy:287
translate latin a1s3_c2a52699:

    # "I say it warningly, even though I know he's joking."
    "Hoc monendo dico, etiamsi scio eum iocari."

# game/a1s3.rpy:288
translate latin a1s3_933fca9f:

    # m "\"You know, I have to wonder why you'd take me out here if you didn't think I could swim.\""
    m "\"Scis, quaero cur me huc duxeris, si me natare posse non putabas.\""

# game/a1s3.rpy:289
translate latin a1s3_6c56c8d8:

    # a "\"Everyone enjoys the beach whether they can swim or not!\""
    a "\"Omnibus litus placet, sive natare possunt sive non!\""

# game/a1s3.rpy:290
translate latin a1s3_5b73629f:

    # "The sand becomes too hot as I walk along the beach, so I have to jog the last ten meters or so to the wet sand, sighing as a wave cools my burning feet."
    "Harena mihi nimis calida fit dum per litus ambulo; itaque decem fere metra extrema ad harenam umidam currere debeo, suspirans cum unda pedes urentes refrigerat."

# game/a1s3.rpy:291
translate latin a1s3_265a5506:

    # "Amicus catches up."
    "Amicus me assequitur."

# game/a1s3.rpy:293
translate latin a1s3_31d87e96:

    # a "\"Too hot? I suppose I should remember that you are a bit more fragile than the other species.\""
    a "\"Nimis calidum? Credo mihi meminisse debere te paulum fragiliorem aliis speciebus esse.\""

# game/a1s3.rpy:294
translate latin a1s3_3413bb13:

    # m "\"Fragile?\""
    m "\"Fragiliorem?\""

# game/a1s3.rpy:296
translate latin a1s3_27f619aa:

    # a "\"Well, a bit. I mean, when we fought on the ship I had to hold back a lot!\""
    a "\"Ita, paulum. Nam cum in nave pugnabamus, multum vires meas coercere debui!\""

# game/a1s3.rpy:297
translate latin a1s3_7e811b2d:

    # "I give Amicus a shove, the wolf stumbling more than he probably would have if he wasn't covering up his junk."
    "Amicum impello; lupus magis titubat quam fortasse titubasset nisi genitalia tegeret."

# game/a1s3.rpy:299
translate latin a1s3_94fe48da:

    # a "\"Whoa, hey!\""
    a "\"Vah, heus!\""

# game/a1s3.rpy:303
translate latin a1s3_39a60a18:

    # "With that, I wade out into the shallows, the water quickly coming up to my shoulders."
    "His dictis, in vada ingredior; aqua celeriter ad umeros meos ascendit."

# game/a1s3.rpy:304
translate latin a1s3_06645bc4:

    # "I stick to the shore, treading water as I watch Amicus splash around, doing a sort of lunging swim that reminds me of the butterfly stroke...just a lot more clumsy."
    "Prope litus maneo, in loco natans dum Amicum aquam circum se spargere video, quodam impetu natantem qui me de modo natandi papilionis admonet...multo tantum ineptiore."

# game/a1s3.rpy:305
translate latin a1s3_6f84a052:

    # "After a few minutes, he swims up next to me."
    "Paucis minutis post ad latus meum adnatat."

# game/a1s3.rpy:306
translate latin a1s3_e4c873ca:

    # a "\"You doing alright? I'm still unsure of you being out in the water...\""
    a "\"Bene te habes? Adhuc dubito num tibi tutum sit in aqua esse...\""

# game/a1s3.rpy:307
translate latin a1s3_657bf87d:

    # m "\"Hey, don't start. I know what I'm doing.\""
    m "\"Heus, noli incipere. Scio quid agam.\""

# game/a1s3.rpy:308
translate latin a1s3_cb2c47e7:

    # a "\"Alright, alright, but even experienced swimmers can have accidents, so let me know if you need help, or anything.\""
    a "\"Bene, bene; sed etiam peritis natatoribus casus accidere possunt. Dic igitur si auxilio aut alia re tibi opus est.\""

# game/a1s3.rpy:309
translate latin a1s3_7de9d4e4:

    # "Amicus stands right in front of me, his fur plastered tightly against his chest."
    "Amicus recta ante me stat, pilis arcte pectori adhaerentibus."

# game/a1s3.rpy:310
translate latin a1s3_011d6512:

    # m "\"I will.\""
    m "\"Faciam.\""

# game/a1s3.rpy:311
translate latin a1s3_12876712:

    # "The wolf shields his eyes from the sun with a paw as he looks around."
    "Lupus manu oculos a sole tegit, dum circumspicit."

# game/a1s3.rpy:312
translate latin a1s3_4e5a75d4:

    # a "\"Anyway, do you want to have a race around the island? We can stay in the shallows. I actually used to do it with Cass all the time as a pup.\""
    a "\"Ceterum, visne natando circa insulam certare? In vadis manere possumus. Catulus cum Cass saepissime sic certabam.\""

# game/a1s3.rpy:313
translate latin a1s3_60221a12:

    # "I look around the small island, deciding that the distance is short enough that I can manage it."
    "Parvam insulam circumspicio et spatium satis breve esse statuo ut id enatare possim."

# game/a1s3.rpy:314
translate latin a1s3_169c263b:

    # m "\"Alright, sure.\""
    m "\"Bene, fiat.\""

# game/a1s3.rpy:315
translate latin a1s3_db0f1faa:

    # a "\"Alright [mc], but be warned; I won't go easy on you just because you're a primate!\""
    a "\"Bene, [mc]; sed moneo me tibi non parciturum esse tantum quia primas es!\""

# game/a1s3.rpy:316
translate latin a1s3_6b4eb34d:

    # "I swim past Amicus."
    "Amicum natando praetereo."

# game/a1s3.rpy:317
translate latin a1s3_cba3c4a0:

    # m "\"Go!\""
    m "\"Eamus!\""

# game/a1s3.rpy:318
translate latin a1s3_3f8b4444:

    # a "\"Wh-HEY!\""
    a "\"Qu-HEUS!\""

# game/a1s3.rpy:319
translate latin a1s3_e82e3b2d:

    # "I hear the wolf splash noisily behind me as he tries to catch up."
    "Lupum a tergo meo aquam magno strepitu spargere audio, dum me assequi conatur."

# game/a1s3.rpy:320
translate latin a1s3_0dc9167d:

    # "I do fairly well for the first half of our little race, managing to get around the backside of the island without the wolf catching up to me."
    "Primam fere dimidiam partem certaminis satis bene perficio; ad insulae partem posteriorem pervenio, nec lupus me adhuc assequitur."

# game/a1s3.rpy:321
translate latin a1s3_d6e21d2c:

    # "I notice that this part of the island is covered in dense trees and vegetation with no beach to speak of."
    "Video hanc insulae partem densis arboribus herbisque tegi, nullo fere litore arenoso."

# game/a1s3.rpy:322
translate latin a1s3_ef1c7642:

    # "It's at this point that Amicus overtakes me with his big, lunging strokes, breathing hard each time he comes up."
    "Tum Amicus magnis ictibus impetuosis me praetergreditur, graviter respirans quotiens emergit."

# game/a1s3.rpy:323
translate latin a1s3_78007708:

    # "I realize how hard he's trying, and I wonder if he's actually afraid of losing."
    "Intellego quantum contendat, et quaero num vere timeat ne vincatur."

# game/a1s3.rpy:324
translate latin a1s3_2ba64737:

    # "It's clear that there's a competitive edge to him, and I guess that makes sense if he's so determined to beat Cassius to the throne."
    "Manifestum est eum certandi cupidum esse; id fortasse convenit, cum Cassium in certamine de solio vincere tam vehementer velit."

# game/a1s3.rpy:325
translate latin a1s3_3aedb646:

    # "As we come around the final bend, I fall further behind, quickly losing stamina as the muscles burn in my arms and legs."
    "Cum extremum flexum circumimus, longius a tergo relinquor; vires mihi celeriter deficiunt, musculis brachiorum crurumque urentibus."

# game/a1s3.rpy:326
translate latin a1s3_b78c5291:

    # "Amicus seems to notice and slows down a bit toward the end, allowing me to catch up some before he reaches the same spot we'd started at."
    "Amicus id animadvertere videtur et sub finem paulum tardius natat, ita ut eum aliquatenus assequar antequam ipse ad locum unde profecti sumus perveniat."

# game/a1s3.rpy:327
translate latin a1s3_33790077:

    # "For a moment, we both just gasp for breath in the shallows, though Amicus grins."
    "Paulisper ambo tantum in vadis anhelamus; Amicus tamen late subridet."

# game/a1s3.rpy:330
translate latin a1s3_6ad455b5:

    # a "\"Huh...huh...huh...hehe, I win...huh...\""
    a "\"Huh...huh...huh...hehe, vinco...huh...\""

# game/a1s3.rpy:331
translate latin a1s3_b2f9ae50:

    # "I roll my eyes and wait until I can breathe evenly again."
    "Oculos fastidio verto et exspecto donec rursus aequabiliter respirare possim."

# game/a1s3.rpy:332
translate latin a1s3_2ad9a5f9:

    # m "\"Whatever. You've got way more muscle than I do.\""
    m "\"Quid refert? Multo plus carnis musculosae quam ego habes.\""

# game/a1s3.rpy:333
translate latin a1s3_7ed787de:

    # a "\"That...isn't really...an advantage.\""
    a "\"Hoc...re vera...commodum non est.\""

# game/a1s3.rpy:334
translate latin a1s3_831616a5:

    # "Amicus still breathes heavily and I wonder how much effort he actually put into beating me."
    "Amicus adhuc graviter respirat; quaero quantum re vera contenderit ut me vinceret."

# game/a1s3.rpy:335
translate latin a1s3_9b1dd788:

    # a "\"Besides...I've got all this fur weighing me down and you don't. You know, competitive swimmers actually shave their fur down near the skin.\""
    a "\"Praeterea...tot pili me degravant, te autem non. Scis, natatores qui certant pilos paene ad cutem radunt.\""

# game/a1s3.rpy:336
translate latin a1s3_68df8fc9:

    # "That makes me wonder what a shaved wolf would look like."
    "Cogito qualis lupus rasus videretur."

# game/a1s3.rpy:337
translate latin a1s3_81bbb482:

    # m "\"Guess I just have bad stamina.\""
    m "\"Credo me tantum cito fatigari.\""

# game/a1s3.rpy:338
translate latin a1s3_e50e7a2d:

    # a "\"Actually, you did a lot better than I thought you would. Had me worried the first few minutes. What do you call that swimming style?\""
    a "\"Immo multo melius quam putabam natavisti. Primis minutis me sollicitum habuisti. Quid illum natandi modum appellatis?\""

# game/a1s3.rpy:339
translate latin a1s3_14cf6ea1:

    # m "\"Uh, I don't know. I think it's just called freestyle.\""
    m "\"Hem, nescio. Puto simpliciter liberum natandi genus appellari.\""

# game/a1s3.rpy:340
translate latin a1s3_ff1da866:

    # "Amicus moves closer, his breathing finally under control."
    "Amicus propius accedit, tandem respiratione composita."

# game/a1s3.rpy:341
translate latin a1s3_463b6455:

    # a "\"Could you teach me?\""
    a "\"Potesne me docere?\""

# game/a1s3.rpy:342
translate latin a1s3_5cde273b:

    # m "\"To swim? Looks like you've already got that down.\""
    m "\"Natare? Iam id bene scire videris.\""

# game/a1s3.rpy:343
translate latin a1s3_c9abdee7:

    # a "\"I mean {i}your{/i} style of swimming.\""
    a "\"{i}Tuum{/i} natandi genus dicere volui.\""

# game/a1s3.rpy:344
translate latin a1s3_e368cdab:

    # m "\"You beat me, didn't you? Why would you want to learn my style?\""
    m "\"Me vicisti, nonne? Cur meum natandi genus discere velis?\""

# game/a1s3.rpy:345
translate latin a1s3_9e19461c:

    # "I say that, but I think I know what Amicus is getting at."
    "Haec dico, sed puto me intellegere quid Amicus velit."

# game/a1s3.rpy:346
translate latin a1s3_b1c3571e:

    # "He has a very...clumsy way of swimming, sort of like he's fighting the water itself."
    "Valde...inepte natat, quasi contra ipsam aquam pugnet."

# game/a1s3.rpy:347
translate latin a1s3_39485732:

    # "Amicus harrumphs, blowing some droplets of water from his nose."
    "Amicus fremitum edit, guttulas aquae e naribus exsufflans."

# game/a1s3.rpy:348
translate latin a1s3_91f4c676:

    # a "\"It looked effective. I'd just like to try it if you're willing to show me.\""
    a "\"Efficax videbatur. Modo id experiri velim, si mihi ostendere vis.\""

# game/a1s3.rpy:349
translate latin a1s3_ad10a89a:

    # "I smile."
    "Arrideo."

# game/a1s3.rpy:350
translate latin a1s3_6f19d038:

    # m "\"Alright.\""
    m "\"Bene.\""

# game/a1s3.rpy:351
translate latin a1s3_888b9fb3:

    # "For the next hour, I show the wolf how to swim freestyle."
    "Per proximam horam lupum liberum natandi genus doceo."

# game/a1s3.rpy:352
translate latin a1s3_dc67f503:

    # "At the beginning, it kind of feels like I'm teaching a toddler how to swim."
    "Initio sentio quasi puerulum natare doceam."

# game/a1s3.rpy:353
translate latin a1s3_e6f2b7c6:

    # "The first few tries end up with him thrashing around in the water like he's about to drown, showering me with lake water until I have to reach out and grab him to make him stop."
    "Primis conatibus ita in aqua iactatur quasi iam submergatur; aqua me perfundit, donec manus porrigere eumque prehendere debeam ut desistat."

# game/a1s3.rpy:354
translate latin a1s3_90eafe44:

    # "I decide to start with the arms first, standing in the shallows and showing him how I put one arm ahead of the other in a sort of rhythm."
    "A brachiis incipere statuo; in vadis stans ostendo quomodo alterum brachium ante alterum certo quodam numero proferam."

# game/a1s3.rpy:355
translate latin a1s3_7a54c3ce:

    # "Again, I have to stand close to the naked wolf, grabbing his big furry arms and showing him how to move them."
    "Rursus prope nudum lupum stare debeo, magna villosaque brachia eius prehendens et ostendens quomodo moveantur."

# game/a1s3.rpy:356
translate latin a1s3_ab28dc7e:

    # "Once he has that down, he quickly learns how to add his feet into the mix and pretty soon, he's swimming back and forth, picking up speed to the point that I'd have no hope of keeping up with him."
    "Quo percepto, celeriter discit quomodo pedes simul moveat; mox huc illuc natat tanta celeritate crescente ut eum assequi nullo modo possim."

# game/a1s3.rpy:357
translate latin a1s3_86ba6e16:

    # "I realize then that Amicus is a very fast learner."
    "Tum intellego Amicum celerissime discere."

# game/a1s3.rpy:358
translate latin a1s3_fac41598:

    # a "\"Haha! This is so much better! Do you know any other styles?\""
    a "\"Haha! Hoc multo melius est! Alia quoque genera scis?\""

# game/a1s3.rpy:359
translate latin a1s3_425e87a2:

    # "Amicus paddles happily around me."
    "Amicus laetus circa me natat."

# game/a1s3.rpy:360
translate latin a1s3_463c6667:

    # m "\"Well, I guess back floating, but no not really. I'm not a professional swimmer.\""
    m "\"Supinus quidem fluitare scio, credo; sed nihil aliud. Natator professionis causa non sum.\""

# game/a1s3.rpy:362
translate latin a1s3_529b3d6d:

    # "Amicus stands, water running down his furry body."
    "Amicus surgit, aqua per corpus villosum defluente."

# game/a1s3.rpy:363
translate latin a1s3_5449d783:

    # a "\"Want to race again?\""
    a "\"Visne rursus certare?\""

# game/a1s3.rpy:364
translate latin a1s3_834ea2cf:

    # "He grins at me."
    "Mihi late subridet."

# game/a1s3.rpy:365
translate latin a1s3_e33f02ef_1:

    # "I laugh."
    "Rideo."

# game/a1s3.rpy:366
translate latin a1s3_8294f1de:

    # m "\"No! I'm exhausted after teaching you all of that.\""
    m "\"Non! Tot res te docendo exhaustus sum.\""

# game/a1s3.rpy:367
translate latin a1s3_5ab108b9:

    # a "\"Oh don't be such a pup, or are you afraid of losing again?\""
    a "\"Oh, noli te catulum praebere! An rursus vinci times?\""

# game/a1s3.rpy:368
translate latin a1s3_cb065360:

    # "Amicus winks to lighten his words."
    "Amicus alterum oculum claudit ut verba sua leviora reddat."

# game/a1s3.rpy:369
translate latin a1s3_e96f2514:

    # "I think about flicking him on the nose like he's a misbehaving dog, but I resist the urge."
    "Cogito de naso eius levi ictu digiti percutiendo, quasi cani male se gerenti; sed cupiditati resisto."

# game/a1s3.rpy:370
translate latin a1s3_f73f0e7d:

    # m "\"No. I'm tired and I'm hungry and if I stay out any longer, I'm probably gonna get a sunburn.\""
    m "\"Non. Fessus sum et esurio; si diutius hic maneo, sol fortasse cutem meam uret.\""

# game/a1s3.rpy:371
translate latin a1s3_be7a0733:

    # "Reminding Amicus that there's food on the beach seems to change his mind and he follows me into the shallows."
    "Amicum admonere cibos in litore esse sententiam eius mutare videtur; me in vada sequitur."

# game/a1s3.rpy:373
translate latin a1s3_a9c9daa5:

    # a "\"Oh, that's right; you have no fur. Sometimes I get burned around my nose if I stay out too long. Are you alright?\""
    a "\"Oh, recte: pilos non habes. Mihi interdum cutis circa nasum uritur, si nimis diu in sole maneo. Bene te habes?\""

# game/a1s3.rpy:374
translate latin a1s3_ef8cd07e:

    # "I feel Amicus rub a paw over my shoulders and I shiver."
    "Sentio Amicum manu umeros meos fricare et contremisco."

# game/a1s3.rpy:375
translate latin a1s3_744cf8bf:

    # m "\"Well, we'll know by tonight, but I feel alright.\""
    m "\"Hac nocte sciemus; nunc autem bene me habeo.\""

# game/a1s3.rpy:378
translate latin a1s3_948c5012:

    # "As we trudge onto the beach, I see Alex curled up on a blanket, his fur bright and shiny under the sun."
    "Cum aegre per litus incedimus, Alex in stragulo contractum video, pilis in sole claris ac nitentibus."

# game/a1s3.rpy:379
translate latin a1s3_4a9c6b7f:

    # "Judging by the plates around him, he's already eaten."
    "Ex patinis circa eum positis iudicans, iam comedit."

# game/a1s3.rpy:380
translate latin a1s3_292c202c:

    # "Amicus chuckles."
    "Amicus leniter ridet."

# game/a1s3.rpy:382
translate latin a1s3_1404bca0:

    # a "\"Such a feline. Anyway, you'd better keep your eyes off me. I want the fur to dry before I put my undergarments back on, so I'm going to stop covering up for you!\""
    a "\"Felis plane est. Ceterum oculos a me averte. Pilos siccos esse volo antequam vestimentum interius rursus induam; itaque iam me propter te non tegam!\""

# game/a1s3.rpy:384
translate latin a1s3_7c203d05:

    # "Automatically, my eyes start wandering toward the wolf before snapping back to look straight ahead."
    "Oculi mei sponte ad lupum vagari incipiunt, deinde celeriter rursus recta prorsum aspicio."

# game/a1s3.rpy:385
translate latin a1s3_c7b82874:

    # "But then I start to think; I am going to be here for a while, as far as I know."
    "Tum tamen cogitare incipio: quantum scio, hic aliquamdiu ero."

# game/a1s3.rpy:386
translate latin a1s3_eed72600:

    # "Maybe I should get used to the whole nudity thing now?"
    "Fortasse iam nuditate assuescere debeam?"

# game/a1s3.rpy:391
translate latin a1s3_6f24b50d:

    # "I mean, it's not that big of a deal, and if this is a normal thing for the Wolves, why not get used to it?"
    "Non magni momenti est; et si hoc Lupis usitatum est, cur non assuescam?"

# game/a1s3.rpy:392
translate latin a1s3_22690ebb:

    # "So I look."
    "Itaque aspicio."

# game/a1s3.rpy:394
translate latin a1s3_6efd0dc8:

    # "Amicus grunts in surprise when he sees me not bothering to avoid looking his way."
    "Amicus mirans grunnit cum videt me aperte ad se aspicere."

# game/a1s3.rpy:396
translate latin a1s3_e86bc7c2:

    # a "\"Wh—human!\""
    a "\"Qu—homo!\""

# game/a1s3.rpy:398
translate latin a1s3_b4ccb19c:

    # "Amicus's paws snap to covering his crotch again."
    "Amicus manibus statim rursus inguina tegit."

# game/a1s3.rpy:399
translate latin a1s3_393dd690:

    # "I smirk."
    "Callide subrideo."

# game/a1s3.rpy:400
translate latin a1s3_91fbc810:

    # m "\"What? I might as well get used to it if this is normal around here, right? Though I gotta say, you're acting like it isn't.\""
    m "\"Quid? Assuescere possum, si hoc hic usitatum est, nonne? Tu tamen ita te geris quasi usitatum non sit.\""

# game/a1s3.rpy:401
translate latin a1s3_7b6ac009:

    # "Amicus pauses, then pulls his paws away from his crotch, his face flushed."
    "Amicus paulisper haeret, deinde manus ab inguinibus removet, vultu rubente."

# game/a1s3.rpy:403
translate latin a1s3_4ad52e57:

    # a "\"you just surprised me, is all! Anyway...\""
    a "\"Tantum me subito mirari fecisti! Ceterum...\""

# game/a1s3.rpy:405
translate latin a1s3_89c0ed7c:

    # "Amicus walks stiffly up the beach, past the sleeping Alex while I try to keep up."
    "Amicus rigidis passibus per litus ascendit, Alex dormientem praeteriens; ego eum assequi conor."

# game/a1s3.rpy:406
translate latin a1s3_4f6ee41f:

    # "It's kind of satisfying to see how embarrassed he is considering how much he'd been teasing me about it."
    "Aliquantum iucundum est videre quantum pudeat, cum ipse me hac de re toties luserit."

# game/a1s3.rpy:407
translate latin a1s3_5057b5d8:

    # "And honestly, now that I've seen it, it really isn't a big deal at all."
    "Et vere, nunc cum viderim, non magni momenti est."

# game/a1s3.rpy:408
translate latin a1s3_347dd719:

    # "The wolf's cock and balls are just like a human's."
    "Lupi mentula testiculique similes eisdem partibus hominis sunt."

# game/a1s3.rpy:409
translate latin a1s3_7e7c02f0:

    # "Sure, maybe with a little more fur on the balls and a darker shade on the cock, but still similar."
    "Fortasse testiculi paulo pilosiores sunt et mentula obscurior est; sed tamen similes."

# game/a1s3.rpy:411
translate latin a1s3_2085b979:

    # "We reach the Sightseer and I see that Alex has laid out the food in a neat little line of plates."
    "Ad Spectatricem pervenimus; video Alex cibos in parvis patinis ordine disposuisse."

# game/a1s3.rpy:412
translate latin a1s3_1acd74be:

    # "Though some of the pastries look a bit squashed, everything seems to have survived the emergency dumping that they suffered."
    "Quamquam quaedam crustula paulum compressa videntur, omnia illam effusionem subitam superfuisse videntur."

# game/a1s3.rpy:413
translate latin a1s3_e6cfd76a:

    # "Amicus grabs a few large plates of quiches and what look like fruit pastries."
    "Amicus aliquot magnas patinas placentis ovis farctis aliisque crustulis, quae fructibus farcta videntur, plenas sumit."

# game/a1s3.rpy:414
translate latin a1s3_38938819:

    # "Meanwhile, I grab a folded blanket, the bottle of wine for Amicus, and a smaller bottle of the vegetable-tasting juice I'd had yesterday for myself."
    "Ego interim stragulum complicatum sumo, vini lagonam Amico et mihi minorem lagonam illius suci qui holera sapit, quem heri bibi."

# game/a1s3.rpy:417
translate latin a1s3_fd38f889:

    # "Nope."
    "Minime."

# game/a1s3.rpy:418
translate latin a1s3_fd337297:

    # "Just because I'm on an alien moon doesn't mean I'm just gonna conform to their way life."
    "In luna aliena sum; non idcirco tamen eorum vitae morem sequar."

# game/a1s3.rpy:419
translate latin a1s3_0eb077f5:

    # "I'm not planning to stay here for {i}that{/i} long...I hope."
    "Non cogito {i}tam{/i} diu hic manere...spero."

# game/a1s3.rpy:420
translate latin a1s3_4020408f:

    # "Besides, Alex has been here a while and he seems to be getting along fine without conforming."
    "Alex praeterea iamdiu hic est et satis bene vivere videtur, etsi mores suos non mutat."

# game/a1s3.rpy:421
translate latin a1s3_ba4ec6be:

    # "So I go on keeping my eyes just slightly to the right, letting Amicus fade into a vague, gray blur."
    "Itaque oculos adhuc paulum ad dextram teneo, sinens Amicum in incertam canamque speciem evanescere."

# game/a1s3.rpy:422
translate latin a1s3_2085b979_1:

    # "We reach the Sightseer and I see that Alex has laid out the food in a neat little line of plates."
    "Ad Spectatricem pervenimus; video Alex cibos in parvis patinis ordine disposuisse."

# game/a1s3.rpy:423
translate latin a1s3_1acd74be_1:

    # "Though some of the pastries look a bit squashed, everything seems to have survived the emergency dumping that they suffered."
    "Quamquam quaedam crustula paulum compressa videntur, omnia illam effusionem subitam superfuisse videntur."

# game/a1s3.rpy:424
translate latin a1s3_e6cfd76a_1:

    # "Amicus grabs a few large plates of quiches and what look like fruit pastries."
    "Amicus aliquot magnas patinas placentis ovis farctis aliisque crustulis, quae fructibus farcta videntur, plenas sumit."

# game/a1s3.rpy:425
translate latin a1s3_38938819_1:

    # "Meanwhile, I grab a folded blanket, the bottle of wine for Amicus, and a smaller bottle of the vegetable-tasting juice I'd had yesterday for myself."
    "Ego interim stragulum complicatum sumo, vini lagonam Amico et mihi minorem lagonam illius suci qui holera sapit, quem heri bibi."

# game/a1s3.rpy:427
translate latin a1s3_51b049d2:

    # "We make our way over to the shade of the trees before I roll out the blanket and Amicus starts to tie his underwear back on."
    "Ad arborum umbram imus; deinde stragulum explico et Amicus vestimentum interius rursus sibi alligare incipit."

# game/a1s3.rpy:428
translate latin a1s3_49ec38e5:

    # "Finally, he sits down with a huff before reaching out for the wine."
    "Tandem anhelans considit, deinde manum ad vinum porrigit."

# game/a1s3.rpy:430
translate latin a1s3_b509c3e3:

    # a "\"You sure you don't want any?\""
    a "\"Certusne es te nihil velle?\""

# game/a1s3.rpy:431
translate latin a1s3_37b859d0:

    # "He asks before guzzling some of it down."
    "Hoc quaerit, deinde aliquantum vini avide haurit."

# game/a1s3.rpy:432
translate latin a1s3_6cc1e100:

    # m "\"Um, I mean, maybe at dinner, or something, but I'd rather not get buzzed right now.\""
    m "\"Hem, fortasse cum cenamus aut alio tempore; sed nunc paulum ebrius fieri nolim.\""

# game/a1s3.rpy:434
translate latin a1s3_13075a3e:

    # a "\"Oh really? I'd have to drink quite a bit more than this bottle to become inebriated.\""
    a "\"Oh, vere? Multo plus quam hac lagona continetur bibere deberem ut inebriarer.\""

# game/a1s3.rpy:435
translate latin a1s3_f45e7b44:

    # "Guess that explains how he can drink so much of it for every meal."
    "Id fortasse explicat cur ad omnem refectionem tantum vini bibere possit."

# game/a1s3.rpy:436
translate latin a1s3_e6c23ddc:

    # m "\"Well, you are a lot bigger. Anyway, this stuff is great.\""
    m "\"Tu tamen multo maior es. Ceterum hic sucus optimus est.\""

# game/a1s3.rpy:437
translate latin a1s3_642f553e:

    # "I easily pull out the cork on my own bottle before drinking down the ice-cold juice."
    "Suber e lagona mea facile extraho, deinde sucum gelidissimum haurio."

# game/a1s3.rpy:438
translate latin a1s3_c03a3102:

    # "Amicus pulls a face."
    "Amicus vultum contrahit."

# game/a1s3.rpy:440
translate latin a1s3_a489777c:

    # a "\"Eugh, {i}virdi{/i}? that stuff tastes awful. Wine is so much better.\""
    a "\"Eheu, {i}virdi{/i}? Illud pessime sapit. Vinum multo melius est.\""

# game/a1s3.rpy:441
translate latin a1s3_6addc190:

    # "Amicus immediately goes for the fruit pastries, shoving two in his mouth at the same time."
    "Amicus statim crustula fructibus farcta petit et duo simul in os congerit."

# game/a1s3.rpy:442
translate latin a1s3_9cd38a1e:

    # m "\"Maybe you just prefer sweet things? And slow down, don't you take time to enjoy your food?\""
    m "\"Fortasse dulcia tantum mavis? Et lentius ede: nonne cibis fruendis tempus das?\""

# game/a1s3.rpy:443
translate latin a1s3_18412b7c:

    # "Amicus frowns at me with his mouth full."
    "Amicus ore pleno frontem in me contrahit."

# game/a1s3.rpy:445
translate latin a1s3_11b4e1f8:

    # a "\"I do enjoy it. That's why I eat it fast.\""
    a "\"Eis fruor. Ideo celeriter edo.\""

# game/a1s3.rpy:446
translate latin a1s3_45fb950c:

    # "I smile and go after one of the quiches instead."
    "Subrideo et unam e placentis ovis farctis potius sumo."

# game/a1s3.rpy:448
translate latin a1s3_2b8c0674:

    # "We eat in silence for a few minutes, then I remember what Cato had said earlier."
    "Pauca minuta taciti edimus; deinde verba quae Cato antea dixerat memini."

# game/a1s3.rpy:449
translate latin a1s3_37d428d6:

    # m "\"When do you need to be at that thing Cato was talking about?\""
    m "\"Quando tibi ad illud quod Cato commemorabat eundum est?\""

# game/a1s3.rpy:450
translate latin a1s3_e5bc970b:

    # a "\"Combat practice? We've got at least an hour yet.\""
    a "\"Ad exercitationem pugnae? Hora saltem una nobis adhuc est.\""

# game/a1s3.rpy:451
translate latin a1s3_04b6fed6:

    # m "\"And what does that involve?\""
    m "\"Et quid ibi fit?\""

# game/a1s3.rpy:452
translate latin a1s3_827877b1:

    # a "\"Oh, just striking and grapples. I'm just glad Cass isn't here to join us. I hate sparring him.\""
    a "\"Oh, ictus tantum et luctae. Gaudeo Cass non hic esse ut nobiscum exerceatur. Cum eo pugnando exerceri odi.\""

# game/a1s3.rpy:453
translate latin a1s3_ca480a49:

    # m "\"Really? You told me last night he can't even compete with you.\""
    m "\"Vere? Hesterno vespere mihi dixisti eum ne certare quidem tecum posse.\""

# game/a1s3.rpy:455
translate latin a1s3_1c291250:

    # a "\"That's exactly why. He has a condition where his bones are less dense than what is normal, makes them easy to break. Because of this, I'm more of a training dummy for him than anything.\""
    a "\"Hanc ipsam ob causam. Morbo afficitur quo ossa eius minus densa quam solent sunt, ita ut facile frangantur. Itaque fere nihil sum nisi corpus in quo se exerceat.\""

# game/a1s3.rpy:457
translate latin a1s3_bbdc94f9:

    # a "\"Basically he just uses it as an excuse to punch me in the stomach. There isn't much I can do to retaliate that won't seriously injure him, so I prefer training with Cato.\""
    a "\"Fere tantum hac causa utitur ut pugno in ventrem me feriat. Vix quicquam reddere possum quod eum graviter non vulneret; itaque cum Catone exerceri malo.\""

# game/a1s3.rpy:458
translate latin a1s3_8447d83b:

    # m "\"Didn't you tell Cassius you'd punch him yesterday?\""
    m "\"Nonne heri Cassio dixisti te eum pugno percussurum esse?\""

# game/a1s3.rpy:459
translate latin a1s3_96910dda:

    # "Amicus laughs."
    "Amicus ridet."

# game/a1s3.rpy:461
translate latin a1s3_ba350933:

    # a "\"Hahahaha! I did, didn't I?\""
    a "\"Hahahaha! Dixi sane, nonne?\""

# game/a1s3.rpy:463
translate latin a1s3_b085fb67:

    # a "\"Well, that's why he was so offended, but now he knows not to bother you.\""
    a "\"Ideo tam offensus erat; nunc autem scit te non esse vexandum.\""

# game/a1s3.rpy:464
translate latin a1s3_b128720c:

    # a "\"I've learned to be gentle with him since we were pups, but my limits can only be pushed so far, especially now that I have you.\""
    a "\"Iam a pueritia didici cum eo leniter agere; sed patientia mea non sine fine temptari potest, praesertim nunc cum te habeam.\""

# game/a1s3.rpy:465
translate latin a1s3_a893c8d0:

    # m "\"You said you used to get along with him when you were pups?\""
    m "\"Dixisti vos catulos bene inter vos convenisse?\""

# game/a1s3.rpy:466
translate latin a1s3_c5b6d131:

    # a "\"Yes, but I think that had more to do with him admiring me when we were younger. He used to look up to me, which was preferable to how he is now.\""
    a "\"Ita, sed credo id magis ex eo ortum esse quod me admirabatur cum iuniores essemus. Me observabat ac suspiciebat, quod multo melius erat quam eius mores hodierni.\""

# game/a1s3.rpy:467
translate latin a1s3_8059cacc:

    # m "\"What happened?\""
    m "\"Quid accidit?\""

# game/a1s3.rpy:468
translate latin a1s3_f887bb98_1:

    # "Amicus shrugs."
    "Amicus umeros tollit."

# game/a1s3.rpy:470
translate latin a1s3_6d2ff918:

    # a "\"We grew older, then mother died and he was always very close to her. They shared a lot in common, including their disease.\""
    a "\"Crevimus; deinde mater mortua est, cui semper coniunctissimus erat. Multa communia habebant, etiam morbum.\""

# game/a1s3.rpy:471
translate latin a1s3_d611e9c0:

    # "Amicus pokes around at the pastries before picking one up that looks to be filled with a red fruit."
    "Amicus crustula explorat, deinde unum sumit quod fructu rubro farctum videtur."

# game/a1s3.rpy:472
translate latin a1s3_69781005:

    # a "\"Then I suppose we've always been different philosophically, which would be fine if he weren't trying to take the throne from me.\""
    a "\"Deinde, credo, semper philosophia dissensimus. Id nihil mali esset, nisi solium mihi eripere conaretur.\""

# game/a1s3.rpy:473
translate latin a1s3_70f07839:

    # m "\"So if you were next in line for the throne, how could Cassius just challenge you for it. Is that how it's supposed to work?\""
    m "\"Si igitur tu proximus solii heres eras, quomodo Cassius te ad certamen de solio provocare potuit? Sicne fieri debet?\""

# game/a1s3.rpy:474
translate latin a1s3_d767f551:

    # a "\"No, not really. Cato is the one who decided to do things this way...which he can because he's the acting emperor.\""
    a "\"Non, non vere. Cato ita rem administrare statuit...quod facere potest, cum interim imperatoris munere fungatur.\""

# game/a1s3.rpy:475
translate latin a1s3_ff04b41c:

    # a "\"Cassius has been building a following amongst the wolves for the past several years.\""
    a "\"Cassius per hos aliquot annos fautores inter lupos sibi conciliavit.\""

# game/a1s3.rpy:476
translate latin a1s3_3122b23f:

    # "Amicus shakes his head."
    "Amicus caput quatit."

# game/a1s3.rpy:477
translate latin a1s3_52bfc425:

    # a "\"I thought he was simply trying to solidify his chances of becoming my advisor, but his speeches and writings were so different from my father's...\""
    a "\"Putabam eum tantum facultatem consiliarii mei fiendi firmare conari; sed orationes scriptaque eius tam diversa a patris mei erant...\""

# game/a1s3.rpy:478
translate latin a1s3_b2c1c739:

    # a "\"I did realize he was cultivating a certain persona for the emperorship eventually, but I never thought Cato would buy in to it just because of Cassius's popularity...but he did, and here we are.\""
    a "\"Tandem intellexi eum personam quandam ad imperium aptam sibi componere; sed non putabam Catonem assentiri tantum quia Cassius multis placeret...tamen assensus est, et haec res est.\""

# game/a1s3.rpy:479
translate latin a1s3_e4bbad67:

    # "Amicus shoos away a worryingly large fly that lands near the plate."
    "Amicus muscam metuendae magnitudinis abigit, quae prope patinam considit."

# game/a1s3.rpy:480
translate latin a1s3_6b2dbc93:

    # a "\"I thought I'd have more time, anyway. A lot more time, but father's passing was sudden, so I'm left with what I have now.\""
    a "\"Putabam me plus temporis habiturum esse. Multo plus; sed mors patris subita fuit, itaque his tantum rebus quas nunc habeo uti possum.\""

# game/a1s3.rpy:481
translate latin a1s3_7a2864be:

    # m "\"What happened to him...if you don't mind me asking?\""
    m "\"Quid ei accidit...si licet quaerere?\""

# game/a1s3.rpy:482
translate latin a1s3_a4b6ed91:

    # a "\"To father? His ship crashed while landing in Adastra City about five months ago. It's a rare thing to happen, but it does happen.\""
    a "\"Patri? Navis eius, dum in Urbe Adastra descendebat, ante quinque fere menses cecidit. Raro fit, sed fit.\""

# game/a1s3.rpy:483
translate latin a1s3_3ed7b932:

    # m "\"I'm sorry.\""
    m "\"Doleo.\""

# game/a1s3.rpy:484
translate latin a1s3_794944a2:

    # a "\"Well, he's with the Parents now, so I'll see him again, but he should have had so much more time left, just like mother.\""
    a "\"Iam tamen cum Parentibus est, itaque eum rursus videbo. Multo tamen plus temporis ei reliquum esse debuerat, sicut matri.\""

# game/a1s3.rpy:485
translate latin a1s3_c45e4bac:

    # m "\"How old was he?\""
    m "\"Quot annos natus erat?\""

# game/a1s3.rpy:486
translate latin a1s3_ff4ab242:

    # a "\"157.\""
    a "\"157.\""

# game/a1s3.rpy:487
translate latin a1s3_2cc7b95a:

    # "I blink."
    "Palpebras moveo."

# game/a1s3.rpy:488
translate latin a1s3_8c7d2ff6:

    # m "\"He was 157?\""
    m "\"157 annos natus erat?\""

# game/a1s3.rpy:489
translate latin a1s3_bcc81977_1:

    # a "\"Yes.\""
    a "\"Ita.\""

# game/a1s3.rpy:490
translate latin a1s3_13d65215:

    # m "\"Years?\""
    m "\"Annos?\""

# game/a1s3.rpy:492
translate latin a1s3_8ca1d22f:

    # a "\"Yes?\""
    a "\"Volui?\""

# game/a1s3.rpy:493
translate latin a1s3_713ee5d0:

    # "Amicus looks at me, confused."
    "Amicus me perplexus intuetur."

# game/a1s3.rpy:494
translate latin a1s3_37709eea:

    # m "\"How long do you people live?\""
    m "\"Quot annos fere vivitis?\""

# game/a1s3.rpy:495
translate latin a1s3_cebde5c2:

    # a "\"Uhhh, it varies, obviously, but about 250 to 300 years.\""
    a "\"Hem, variatur scilicet; sed fere a 250 ad 300 annos.\""

# game/a1s3.rpy:496
translate latin a1s3_93bd3770:

    # m "\"Wow...\""
    m "\"Vah...\""

# game/a1s3.rpy:497
translate latin a1s3_c3cbce5a:

    # a "\"How long do your people live?\""
    a "\"Quot annos gens vestra vivit?\""

# game/a1s3.rpy:498
translate latin a1s3_8a3c8bf1:

    # "Amicus looks slightly apprehensive."
    "Amicus paulum sollicitus videtur."

# game/a1s3.rpy:499
translate latin a1s3_583b0a27:

    # m "\"I dunno, 80? 100 if we're lucky.\""
    m "\"Nescio, 80? 100, si fortuna nobis favet.\""

# game/a1s3.rpy:500
translate latin a1s3_69f0220c:

    # a "\"Oh.\""
    a "\"O.\""

# game/a1s3.rpy:502
translate latin a1s3_1d4e2cfa:

    # "Amicus's ears fall."
    "Amici aures demittuntur."

# game/a1s3.rpy:503
translate latin a1s3_dfb409dc:

    # a "\"That's...so short.\""
    a "\"Hoc...tam breve est.\""

# game/a1s3.rpy:504
translate latin a1s3_3b41d9a6:

    # m "\"Compared to you guys, yeah.\""
    m "\"Vobiscum comparatum, ita.\""

# game/a1s3.rpy:506
translate latin a1s3_fa8db221:

    # a "\"Wait, how old are you?\""
    a "\"Exspecta, quot annos natus es?\""

# game/a1s3.rpy:507
translate latin a1s3_a5fcb12d:

    # m "\"20, how old are you?\""
    m "\"20. Tu quot annos natus es?\""

# game/a1s3.rpy:509
translate latin a1s3_781e2d1b:

    # "Amicus is still frowning."
    "Amicus adhuc frontem contrahit."

# game/a1s3.rpy:510
translate latin a1s3_f51e5165:

    # a "\"23.\""
    a "\"23.\""

# game/a1s3.rpy:511
translate latin a1s3_271194ea:

    # "That gives me some pause, trying to work out how much that would be in a human lifespan."
    "Id me paulisper retinet, dum computare conor cui humanae vitae aetati hoc respondeat."

# game/a1s3.rpy:512
translate latin a1s3_6935afc7:

    # m "\"Wait, so are you an adult, or...\""
    m "\"Exspecta, igitur adultus es, an...\""

# game/a1s3.rpy:513
translate latin a1s3_08724c0c:

    # "Amicus seems to recover."
    "Amicus animum recipere videtur."

# game/a1s3.rpy:515
translate latin a1s3_05b82735:

    # a "\"Well, adulthood varies among species and cultures, obviously, but legal adulthood is 20. So yes, I'm considered an adult.\""
    a "\"Adulta aetas inter species et culturas scilicet variatur; sed secundum legem a 20 annis incipit. Itaque adultus habeor.\""

# game/a1s3.rpy:516
translate latin a1s3_fa910e7a:

    # m "\"Huh, that's about the same as humans.\""
    m "\"Hem, id hominibus fere idem est.\""

# game/a1s3.rpy:518
translate latin a1s3_e39a651c:

    # a "\"But the difference is that you die a lot sooner.\""
    a "\"Sed hoc interest: vos multo citius morimini.\""

# game/a1s3.rpy:519
translate latin a1s3_f8681f10:

    # "That concerned look again."
    "Rursus vultus ille sollicitus."

# game/a1s3.rpy:520
translate latin a1s3_8619f2c6:

    # "I shrug."
    "Umeros tollo."

# game/a1s3.rpy:521
translate latin a1s3_6880cecc:

    # m "\"Eh, I've grown up with the idea, so it's not all that shocking to me.\""
    m "\"Eh, hac cogitatione educatus sum; itaque me non adeo commovet.\""

# game/a1s3.rpy:523
translate latin a1s3_521b50ad:

    # "Amicus seems to be thinking."
    "Amicus cogitare videtur."

# game/a1s3.rpy:524
translate latin a1s3_32e5700c:

    # a "\"Well, maybe we can do something about it. I don't like the idea of you being through a fourth of your life when you've only just reached adulthood.\""
    a "\"Fortasse de hoc aliquid facere possumus. Mihi non placet te quartam vitae partem iam egisse cum modo adultus factus sis.\""

# game/a1s3.rpy:525
translate latin a1s3_e499761a_1:

    # "I frown."
    "Frontem contraho."

# game/a1s3.rpy:526
translate latin a1s3_f12c46c6:

    # m "\"Well, what are you gonna do about it?\""
    m "\"Et quid de hoc facere potes?\""

# game/a1s3.rpy:528
translate latin a1s3_9d7c0677:

    # a "\"We aren't able to live so long naturally. We take supplements and medication that slows the aging process. Maybe we could consider some for you.\""
    a "\"Natura tamdiu vivere non possumus. Supplementa et medicamenta sumimus quae senescendi cursum retardant. Fortasse aliqua tibi quoque considerare possimus.\""

# game/a1s3.rpy:529
translate latin a1s3_2e91dc0e:

    # "It's an interesting thought, but I don't like the idea of being a guinea pig for Wolvish medication."
    "Cogitatio iucunda est; sed non placet me esse animal in quo Lupi medicamenta sua experiantur."

# game/a1s3.rpy:530
translate latin a1s3_6927172c:

    # m "\"Uh, maybe, but let's figure out this whole emperor thing first.\""
    m "\"Hem, fortasse; sed prius de tota hac re imperatoris constituendi agamus.\""

# game/a1s3.rpy:532
translate latin a1s3_69520bfa:

    # a "\"Alright...\""
    a "\"Bene...\""

# game/a1s3.rpy:533
translate latin a1s3_3980aa4c:

    # "Amicus picks at his claws for a while, and it looks like he wants to say something, but he doesn't and just stays quiet."
    "Amicus ungues paulisper tractat; aliquid dicere velle videtur, sed non dicit et tacet."

# game/a1s3.rpy:534
translate latin a1s3_7ca7ff30:

    # "Finally, just as I'm about to ask him what's wrong, he looks over at the sleeping Alex."
    "Tandem, cum iam quaesiturus sim quid mali sit, ad Alex dormientem aspicit."

# game/a1s3.rpy:536
translate latin a1s3_4402f741:

    # a "\"I'll be right back.\""
    a "\"Statim redibo.\""

# game/a1s3.rpy:539
translate latin a1s3_b5aae08b:

    # "And with that, the wolf suddenly gets up and jogs over to the cat."
    "His dictis, lupus repente surgit et ad felem currit."

# game/a1s3.rpy:540
translate latin a1s3_94f386cb:

    # "I can't help but feel the conversation was left unfinished, but then I see Amicus get down on his paws and knees, as if sneaking up on Alex."
    "Colloquium imperfectum mansisse sentio; deinde tamen Amicum manibus genibusque innixum video, quasi ad Alex furtim accedat."

# game/a1s3.rpy:541
translate latin a1s3_d226fb94:

    # "I frown and watch as the wolf gets closer, his paw reaching out...for Alex's earring."
    "Frontem contraho et lupum appropinquantem observo, manum porrigentem...ad ornamentum auris Alex."

# game/a1s3.rpy:542
translate latin a1s3_f736583c:

    # "I guess the wolf wasn't being very quiet because Alex suddenly rolls over and squeals as the wolf leaps at him."
    "Credo lupum non admodum tacitum fuisse; Alex enim repente se vertit et acute clamat cum lupus in eum insilit."

# game/a1s3.rpy:545
translate latin a1s3_cb1c587f:

    # al "\"Amicus, no! No, no, this is my best one, don't mess it up!\""
    al "\"Amice, noli! Noli, noli, hoc optimum meum est; noli corrumpere!\""

# game/a1s3.rpy:546
translate latin a1s3_40ab31b3:

    # "I sigh and get up, a little reluctant to leave the shade as I make my way over to the pair."
    "Suspiro et surgo, paulum invitus umbram relinquens dum ad ambos accedo."

# game/a1s3.rpy:547
translate latin a1s3_3e0b079b:

    # "Alex has rolled up into a little ball, clutching at his ear as he tries to hide the grapes."
    "Alex se in parvam pilam contraxit, aurem tenens dum uvas celare conatur."

# game/a1s3.rpy:549
translate latin a1s3_0a3b5e4a:

    # al "\"Don't you dare! Do you want to tear my ear off!?\""
    al "\"Noli audere! Visne aurem mihi avellere!?\""

# game/a1s3.rpy:551
translate latin a1s3_30726470:

    # a "\"I'm being gentle! If you'd stop trying to fight it, it would make this easier!\""
    a "\"Leniter ago! Si luctari desineres, hoc facilius fieret!\""

# game/a1s3.rpy:553
translate latin a1s3_20507e3e:

    # al "\"Noooo!\""
    al "\"Nooon!\""

# game/a1s3.rpy:554
translate latin a1s3_0bcac7f5:

    # "Alexios tries to roll away, then spots me.\""
    "Alexios evolvi conatur, deinde me conspicit.\""

# game/a1s3.rpy:556
translate latin a1s3_d389d529:

    # al "\"[mc]! Help!\""
    al "\"[mc]! Adiuva!\""

# game/a1s3.rpy:557
translate latin a1s3_9c289f2d:

    # "I sigh and watch for a bit before deciding to save the poor cat."
    "Suspiro et paulisper observo; deinde miseram felem servare statuo."

# game/a1s3.rpy:558
translate latin a1s3_2ba1ebab:

    # "I look for an opening, then pounce on Amicus's back, wrapping my arms around his neck and my legs around his waist, trying to throw him off-balance."
    "Occasionem quaero; tum in tergum Amici insilio, brachiis cervicem, cruribus lumbos amplectens, eum de statu deicere conans."

# game/a1s3.rpy:560
translate latin a1s3_67a026f4:

    # a "\"Ohoho! Not so fragile now, are we?\""
    a "\"Ohoho! Iam non tam fragiles sumus, nonne?\""

# game/a1s3.rpy:562
translate latin a1s3_694561a5:

    # "Amicus swings me back and forth, as if trying to throw me off, but not really putting any effort into it."
    "Amicus me huc illuc iactat, quasi me deicere conetur, sed non vere contendens."

# game/a1s3.rpy:564
translate latin a1s3_6601fca5:

    # "Meanwhile, Alex scrambles out from under the wolf before turning and giving him a shove."
    "Interim Alex se sub lupo expedit; deinde se vertit et eum impellit."

# game/a1s3.rpy:566
translate latin a1s3_1eed65ba:

    # a "\"Agggh!\""
    a "\"Agggh!\""

# game/a1s3.rpy:567
translate latin a1s3_192e8cbe:

    # "Amicus starts to topple backwards and for a moment I think I'm about to get crushed between this 300 lbs wolf and the sand, but Amicus turns as we fall and we end up laying sideways on the beach."
    "Amicus retrorsum cadere incipit; paulisper puto me inter lupum 300 libras Anglicas pendentem et harenam compressum iri. Amicus autem dum cadimus se vertit, et in litore ambo in latus iacemus."

# game/a1s3.rpy:571
translate latin a1s3_16f8af81:

    # "Alex stands to the side, quickly dusting himself off before adjusting his earring, frowning."
    "Alex ad latus stat; pulverem celeriter excutit, deinde frontem contrahens auris ornamentum componit."

# game/a1s3.rpy:573
translate latin a1s3_2bff5bbc:

    # al "\"You know, I might as well just stop wearing this thing. There's no point if half of it is plucked by the day's end.\""
    al "\"Scis, potius hoc omnino gerere desinam. Nihil prodest si dimidia pars ante finem diei decerpta est.\""

# game/a1s3.rpy:574
translate latin a1s3_e958c843:

    # "Amicus just lays there and laughs."
    "Amicus tantum iacet et ridet."

# game/a1s3.rpy:575
translate latin a1s3_2318f0a1:

    # "His laugh is infectious, so I laugh too."
    "Risus eius me quoque ad ridendum ducit."

# game/a1s3.rpy:576
translate latin a1s3_cd397620:

    # a "\"They're too good, Alex. Maybe you should start wearing inedible berries instead?\""
    a "\"Nimis bonae sunt, Alex. Fortasse bacas quae edi non possunt potius gerere debes?\""

# game/a1s3.rpy:577
translate latin a1s3_c3f9c6e0:

    # "Alex huffs as he looks down his nose at us."
    "Alex fremit et nos superbus despicit."

# game/a1s3.rpy:578
translate latin a1s3_85b40f95:

    # al "\"It's a cultural staple of my people, and honestly, what you're doing is rather disrespectful, especially as a prospective emperor.\""
    al "\"Hoc in cultura gentis meae magni momenti est. Ut verum dicam, quod facis satis irreverens est, praesertim tibi qui imperium petis.\""

# game/a1s3.rpy:579
translate latin a1s3_b6153ea7:

    # "Amicus waves his paw dismissively, laying flat out on his back next to me, his arm flopping over my head."
    "Amicus manu rem neglegenter dimittit et supinus iuxta me sternitur, brachio super caput meum proiecto."

# game/a1s3.rpy:580
translate latin a1s3_232bd577:

    # a "\"Phaw! You're a friend. Obviously I wouldn't do it to an actual ambassador.\""
    a "\"Phaw! Amicus es. Scilicet legato vero id non facerem.\""

# game/a1s3.rpy:582
translate latin a1s3_19f1e891:

    # al "\"I {i}am{/i} an actual ambassador, Amicus!\""
    al "\"Ego {i}sum{/i} legatus verus, Amice!\""

# game/a1s3.rpy:583
translate latin a1s3_bee67dc3:

    # a "\"Yes, but a friend ambassador.\""
    a "\"Ita, sed legatus amicus.\""

# game/a1s3.rpy:584
translate latin a1s3_ab09fa2f:

    # "Alex sighs."
    "Alex suspirat."

# game/a1s3.rpy:586
translate latin a1s3_334f0a03:

    # al "\"Anyway, thank you, [mc]. You should obey your master, yes, but it is also important to keep your master in check when he oversteps his bounds.\""
    al "\"Ceterum gratias tibi ago, [mc]. Domino tuo parere debes, sane; sed etiam refrenandus est dominus, cum fines officii sui excedit.\""

# game/a1s3.rpy:587
translate latin a1s3_a2891b47:

    # a "\"Hey, don't encourage insubordination, Alex.\""
    a "\"Heus, ne contumaciam horteris, Alex.\""

# game/a1s3.rpy:588
translate latin a1s3_6c946f7a:

    # "Amicus's big paw resting above my head comes down to ruffle my hair."
    "Magna manus Amici supra caput meum quiescens descendit ut capillos meos turbet."

# game/a1s3.rpy:589
translate latin a1s3_542a5c6a:

    # "I realize for the first time since I was abducted that I'm at ease, happy even."
    "Primum ex quo raptus sum intellego me tranquillum esse, immo etiam laetum."

# game/a1s3.rpy:590
translate latin a1s3_03e32071:

    # "Then Alex looks at the sky."
    "Tum Alex caelum aspicit."

# game/a1s3.rpy:592
translate latin a1s3_c4bcb4d9:

    # al "\"Amicus, what time is it?\""
    al "\"Amice, quota hora est?\""

# game/a1s3.rpy:594
translate latin a1s3_42229f32:

    # "Amicus suddenly sits up with a grunt, also looking toward the sun."
    "Amicus repente grunnit et in sessum se tollit, ipse quoque ad solem aspiciens."

# game/a1s3.rpy:595
translate latin a1s3_c9a71176:

    # a "\"I don't know...is it close to the 11th hour?\""
    a "\"Nescio...estne iam prope undecimam horam?\""

# game/a1s3.rpy:596
translate latin a1s3_7a34c775:

    # al "\"I was asleep so I'm not sure. I'd ask Com, but we're outside his boundaries.\""
    al "\"Dormiebam, itaque nescio. Com interrogarem, sed extra fines eius sumus.\""

# game/a1s3.rpy:597
translate latin a1s3_8c9ad3f6:

    # "Amicus sits for a moment, then sighs."
    "Amicus paulisper sedet, deinde suspirat."

# game/a1s3.rpy:599
translate latin a1s3_97051d2f:

    # a "\"Well, I suppose we should be off, just in case.\""
    a "\"Credo nos abire debere, ne forte sero sit.\""

# game/a1s3.rpy:603
translate latin a1s3_6f8d779c:

    # "We gather up the food and blankets."
    "Cibos stragulaque colligimus."

# game/a1s3.rpy:604
translate latin a1s3_0a8b27af:

    # m "\"Don't you guys have portable clocks, or something?\""
    m "\"Nonne horologia quae vobiscum ferre possitis habetis aut aliquid tale?\""

# game/a1s3.rpy:605
translate latin a1s3_f887bb98_2:

    # "Amicus shrugs."
    "Amicus umeros tollit."

# game/a1s3.rpy:606
translate latin a1s3_0b5a30a4:

    # a "\"We do, but usually I can just ask Com.\""
    a "\"Habemus; sed fere Com interrogare possum.\""

# game/a1s3.rpy:607
translate latin a1s3_8f67fc8c:

    # "The wolf taps his ear."
    "Lupus aurem digito tangit."

# game/a1s3.rpy:608
translate latin a1s3_140280da:

    # a "\"But like Alex said, his signal doesn't reach the island.\""
    a "\"Sed, ut Alex dixit, signum eius insulam non attingit.\""

# game/a1s3.rpy:609
translate latin a1s3_67ba495a:

    # "Amicus is starting to look a little nervous, so we pick up the pace and pack ourselves into the Sightseer, a bit more crowded now with Amicus inside."
    "Amicus paulum sollicitus fieri incipit; itaque festinamus et nos in Spectatricem includimus, iam paulo artius cum Amicus intus sit."

# game/a1s3.rpy:611
translate latin a1s3_16633567:

    # "When we're halfway to the shore, Amicus asks the time, then groans."
    "Cum dimidium itineris ad litus confecimus, Amicus horam quaerit, deinde gemit."

# game/a1s3.rpy:612
translate latin a1s3_8d94af45:

    # a "\"Dammit, half-past the eleventh hour.\""
    a "\"Malum, dimidia hora post undecimam.\""

# game/a1s3.rpy:616
translate latin a1s3_ba000255:

    # "The Amphitheater is small compared to the massive one I'd seen in Rome."
    "Amphitheatrum parvum est, cum illo ingenti quod Romae vidi comparatum."

# game/a1s3.rpy:617
translate latin a1s3_9a44ebaa:

    # "It might only be able to fit a hundred people at most."
    "Centum tantum personas, ut plurimum, capere posse videtur."

# game/a1s3.rpy:618
translate latin a1s3_2b814f66:

    # "Though Alex tells me that the really big one is in the city center."
    "Alex tamen mihi dicit illud vere magnum in media urbe esse."

# game/a1s3.rpy:619
translate latin a1s3_b2a29154:

    # "He sits next to me on the bottom bench with the stairs between us as we watch Amicus stand alone in the center of the pit."
    "Iuxta me in scamno infimo sedet, gradibus inter nos positis, dum Amicum solum in media arena stantem observamus."

# game/a1s3.rpy:620
translate latin a1s3_a2223943:

    # "He has his paws on his hips, looking around, waiting."
    "Manus in coxis habet, circumspiciens et exspectans."

# game/a1s3.rpy:622
translate latin a1s3_20017d26:

    # a "\"Well, I don't think he's here.\""
    a "\"Credo eum non hic esse.\""

# game/a1s3.rpy:624
translate latin a1s3_e1f602cc:

    # al "\"Clearly.\""
    al "\"Ut patet.\""

# game/a1s3.rpy:626
translate latin a1s3_a4732af8:

    # a "\"Do you want to be my sparring partner for the day, Alex?\""
    a "\"Visne hodie socius exercitationis pugnae mihi esse, Alex?\""

# game/a1s3.rpy:628
translate latin a1s3_301701b6:

    # al "\"No!\""
    al "\"Non!\""

# game/a1s3.rpy:630
translate latin a1s3_37b66c72:

    # "Alex scrunches up, one paw going up to cover his earring as Amicus just laughs."
    "Alex se contrahit et altera manu auris ornamentum tegit; Amicus tantum ridet."

# game/a1s3.rpy:631
translate latin a1s3_00856440:

    # "I look around, not seeing the old wolf anywhere."
    "Circumspicio, senem lupum nusquam videns."

# game/a1s3.rpy:632
translate latin a1s3_9c67287a:

    # m "\"Are you gonna get in trouble, Amicus?\""
    m "\"Num ob hoc castigaberis, Amice?\""

# game/a1s3.rpy:636
translate latin a1s3_6c8eb9cb:

    # "Amicus shrugs, leaning one way, then the other in a sort of stretch."
    "Amicus umeros tollit; deinde in alteram atque alteram partem inclinat, quasi se extendat."

# game/a1s3.rpy:637
translate latin a1s3_5a7f630c:

    # a "\"Probably, but Cato is always upset. He'll probably just make me train an extra hour tomorrow, or something. Besides, I got most of my exercises in at the lake.\""
    a "\"Fortasse; sed Cato semper iratus est. Fortasse me cras hora amplius exerceri iubebit aut aliquid simile. Praeterea plerasque exercitationes ad lacum iam feci.\""

# game/a1s3.rpy:639
translate latin a1s3_00d60bca:

    # "Amicus suddenly does a handstand, his feet poking straight up in the air, and I'm amazed that he's able to keep perfectly balanced."
    "Amicus repente manibus insistit, pedibus recta sursum porrectis; miror eum perfecte aequilibrium tenere posse."

# game/a1s3.rpy:640
translate latin a1s3_783ba0c2:

    # "Alex quickly looks away as the hanging cloth on the wolf's undergarment falls upward, even if everything is still covered."
    "Alex statim oculos avertit cum pannus de lupi vestimento interiore pendens sursum cadit, etsi omnia adhuc teguntur."

# game/a1s3.rpy:641
translate latin a1s3_344863cf:

    # "Well...mostly; I can see the lighter colored fur that covers his front also covering his inner thighs."
    "Bene...fere omnia: pilos clariores qui partem anteriorem corporis tegunt etiam interiora femora tegere video."

# game/a1s3.rpy:642
translate latin a1s3_5645b3f3:

    # "Then Amicus falls backward, keeping his paws on the ground while his feet land with a thump, the wolf's back arched, making a bridge."
    "Tum Amicus retrorsum cadit, manibus humi retentis; pedes sonitu in terram incidunt, tergo arcuato, quasi pontem faciens."

# game/a1s3.rpy:643
translate latin a1s3_47a48d17:

    # "It's kind of impressive seeing such a thick, muscular body be so limber."
    "Mirum quodam modo est corpus tam crassum et musculosum tam flexibile videre."

# game/a1s3.rpy:644
translate latin a1s3_8a73abb7:

    # "That's when I notice Amicus looking directly at me from his upside-down position, watching me watching him."
    "Tum animadverto Amicum e statu inverso recta me aspicere, videntem me eum observare."

# game/a1s3.rpy:645
translate latin a1s3_06bd47a1:

    # "I quickly look away blushing, realizing the wolf is just showing off."
    "Celeriter erubescens oculos averto, intellegens lupum tantum se ostentare."

# game/a1s3.rpy:646
translate latin a1s3_70cfafe9:

    # "Amicus pushes off his paws, smoothly standing up straight."
    "Amicus manibus se impellit et leniter rectus surgit."

# game/a1s3.rpy:648
translate latin a1s3_5e37eae0:

    # a "\"Heh, well...I suppose we could go back to the palace since I'd need a partner to do the rest of my training...unless—\""
    a "\"Heh, bene...ad palatium redire possumus, credo; nam reliquae exercitationes socium requirunt...nisi—\""

# game/a1s3.rpy:649
translate latin a1s3_4ad4d594:

    # "Amicus glances at me."
    "Amicus me breviter intuetur."

# game/a1s3.rpy:651
translate latin a1s3_72431b79:

    # a "\"[mc], would you like to assist me?\""
    a "\"[mc], visne me adiuvare?\""

# game/a1s3.rpy:652
translate latin a1s3_d7270d44:

    # "I freeze up for a moment, still feeling a bit awkward at being caught staring at his body."
    "Paulisper rigesco, adhuc paulum verecundus quod corpus eius spectans deprehensus sum."

# game/a1s3.rpy:653
translate latin a1s3_707f5262:

    # "I know I can say no, but Alex is here, and I don't want to come off as a belligerent pet in front of him."
    "Scio me negare posse; sed Alex adest, et nolo coram eo animal domesticum contumax videri."

# game/a1s3.rpy:654
translate latin a1s3_8641ede8:

    # "We're still sort of pretending, after all, even though Alex probably thinks something is off about me."
    "Adhuc enim quodam modo simulamus, etsi Alex aliquid de me non recte se habere fortasse putat."

# game/a1s3.rpy:656
translate latin a1s3_4ff00a93:

    # a "\"Don't worry, I'm not going to hurt you. It would probably be the other way around, haha!\""
    a "\"Noli timere: te non laedam. Fortasse contrarium fiet, haha!\""

# game/a1s3.rpy:657
translate latin a1s3_9ca67f92:

    # m "\"...Alright.\""
    m "\"...Bene.\""

# game/a1s3.rpy:661
translate latin a1s3_707c86a8:

    # "I get up and stand awkwardly in front of the half-naked wolf, glad that I'm at least in my robes now."
    "Surgo et incommode ante lupum seminudum sto, gaudens me saltem nunc tunicam gerere."

# game/a1s3.rpy:663
translate latin a1s3_1929b4aa:

    # a "\"Do your people have combat sports?\""
    a "\"Vestra gens ludos certaminis pugnae habet?\""

# game/a1s3.rpy:664
translate latin a1s3_506cd822:

    # m "\"Uh, yeah. Actually there were a few where your people uplifted. Wrestling and something else where they'd basically just beat each other up...I can't remember the name of it though.\""
    m "\"Hem, ita. Nonnulli erant ubi gens vestra homines ad altiorem cultum provexit: lucta et aliud genus quo fere alter alterum caedebat...sed nomen non memini.\""

# game/a1s3.rpy:665
translate latin a1s3_37c0aac5:

    # "Amicus smiles."
    "Amicus subridet."

# game/a1s3.rpy:666
translate latin a1s3_6e2ec7c4:

    # a "\"That sounds similar enough! This is called {i}pugnu{/i} and it mostly involves punching, kicking, and grappling. The only rules are no claws, no teeth, and no going for the eyes...or groin.\""
    a "\"Satis simile videtur! Hoc {i}pugnu{/i} appellatur et fere pugnis, calcibus luctisque agitur. Haec tantum prohibentur: ungues, dentes, oculos petere...aut inguina.\""

# game/a1s3.rpy:668
translate latin a1s3_bc662d1f:

    # "Amicus smirks at me."
    "Amicus mihi subridet, paulum irridens."

# game/a1s3.rpy:669
translate latin a1s3_79a3d375:

    # a "\"And while sparring, we avoid striking above the neck. So! Go ahead and throw some punches at me!\""
    a "\"Dum autem nos exercemus, supra cervicem ferire vitamus. Ergo! Age, pugnos in me fer!\""

# game/a1s3.rpy:670
translate latin a1s3_605cf1c8:

    # "Amicus grins and hunches down, his paws out."
    "Amicus late subridet et se demittit, manibus porrectis."

# game/a1s3.rpy:672
translate latin a1s3_b13cd98c:

    # "I look over at Alex who watches us, a bit of a disapproving look on his face."
    "Alex aspicio, qui nos observat vultu paulum improbante."

# game/a1s3.rpy:673
translate latin a1s3_39bd1e59:

    # "Amicus notices."
    "Amicus id animadvertit."

# game/a1s3.rpy:675
translate latin a1s3_bb8278d8:

    # a "\"Don't mind Alex; his people are too soft for this sport.\""
    a "\"Noli Alex curare; gens eius nimis mollis est ad hunc ludum.\""

# game/a1s3.rpy:676
translate latin a1s3_561fed0d:

    # al "\"Um, excuse me, but we invented the grapples you use. We just grew out of it.\""
    al "\"Hem, ignosce: nos luctandi modos quibus utimini invenimus. Tantum iam eiusmodi studia superavimus.\""

# game/a1s3.rpy:678
translate latin a1s3_e4770f4f:

    # "Amicus seems to ignore the cat, circling me."
    "Amicus felem neglegere videtur, circa me circumiens."

# game/a1s3.rpy:679
translate latin a1s3_7e153544:

    # a "\"Come on, don't hold back! Mostly I just want to train my reflexes.\""
    a "\"Age, noli parcere! Maxime motuum responsa mea exercere volo.\""

# game/a1s3.rpy:680
translate latin a1s3_9fd6d041:

    # "I try to shake off my timidness and move forward, throwing an awkward punch at Amicus's chest."
    "Timiditatem excutere conor et prorsum accedo, pugno inepte pectus Amici petens."

# game/a1s3.rpy:681
translate latin a1s3_95b5adfc:

    # "The wolf easily slaps it away."
    "Lupus eum ictum facile manu avertit."

# game/a1s3.rpy:683
translate latin a1s3_0e234e2f:

    # a "\"I...hope you can do better than that, [mc].\""
    a "\"Spero...te melius facere posse, [mc].\""

# game/a1s3.rpy:684
translate latin a1s3_cef5e652:

    # "I blush and put a little more effort into a quick punch at the wolf's side, which he dodges with a jump to the right."
    "Erubesco et vehementius pugnum celerem in latus lupi fero; ille ad dextram saliens evitat."

# game/a1s3.rpy:685
translate latin a1s3_ef7dc1b9:

    # "I follow him and jab at his stomach, which he blocks with an elbow."
    "Eum sequor et pugno ventrem peto; cubito ictum arcet."

# game/a1s3.rpy:687
translate latin a1s3_7ba0a179:

    # a "\"Oh come on, you can hit harder than that!\""
    a "\"Oh, age, vehementius ferire potes!\""

# game/a1s3.rpy:688
translate latin a1s3_19cdc270:

    # "We go on for a while longer until I finally stop, huffing."
    "Aliquantum diutius sic agimus, donec tandem anhelans desisto."

# game/a1s3.rpy:689
translate latin a1s3_f62740c8:

    # "Amicus comes up from his crouch."
    "Amicus e statu demisso se erigit."

# game/a1s3.rpy:691
translate latin a1s3_cc3e36be:

    # a "\"What's wrong? Tired already?\""
    a "\"Quid est? Iam fatigatus es?\""

# game/a1s3.rpy:692
translate latin a1s3_6a20a80d:

    # "I shake my head."
    "Caput quatio."

# game/a1s3.rpy:693
translate latin a1s3_4ed948eb:

    # m "\"Honestly, I just don't like throwing punches at you...feels kinda wrong.\""
    m "\"Ut verum dicam, pugnos in te ferre mihi non placet...quasi non recte faciam.\""

# game/a1s3.rpy:695
translate latin a1s3_0c3a7364:

    # "Alex perks up."
    "Alex alacrior fit."

# game/a1s3.rpy:696
translate latin a1s3_6bfcf0de:

    # al "\"See? [mc] understands.\""
    al "\"Vides? [mc] intellegit.\""

# game/a1s3.rpy:697
translate latin a1s3_2036a934:

    # "Amicus rolls his eyes."
    "Amicus oculos fastidio vertit."

# game/a1s3.rpy:699
translate latin a1s3_1fb30e98:

    # a "\"Pff, you're both soft! There's nothing wrong with a bit of sanctioned combat. In fact, I'd say it creates a more civilized—Unf!\""
    a "\"Pff, ambo molles estis! Nihil mali est in pugna concessa. Immo dixerim sic effici cultiorem—Unf!\""

# game/a1s3.rpy:701
translate latin a1s3_1bf8bcbd:

    # "I take the opportunity to jab Amicus in the side, making the wolf grunt."
    "Occasionem capio et pugno latus Amici peto; lupus grunnit."

# game/a1s3.rpy:702
translate latin a1s3_c13ea992:

    # "Amicus turns on me with widened eyes."
    "Amicus patulis oculis ad me se vertit."

# game/a1s3.rpy:703
translate latin a1s3_a2ffe1b2:

    # m "\"Uh, oops?\""
    m "\"Hem, erravi?\""

# game/a1s3.rpy:707
translate latin a1s3_df29126b:

    # "Amicus frowns while Alex laughs."
    "Amicus frontem contrahit, dum Alex ridet."

# game/a1s3.rpy:709
translate latin a1s3_a9f004c9:

    # a "\"I'll show you an \"oops\".\""
    a "\"Ostendam tibi quid sit \"erravi\".\""

# game/a1s3.rpy:710
translate latin a1s3_a2bae82e:

    # "Amicus smirks as he ducks in, grabbing my arms and easily pinning them behind my back."
    "Amicus subridet dum se demittit, brachia mea arripit et facile post tergum meum figit."

# game/a1s3.rpy:711
translate latin a1s3_ef84a8b4:

    # m "\"Hey!\""
    m "\"Heus!\""

# game/a1s3.rpy:712
translate latin a1s3_6411710c:

    # "Amicus growls playfully into my ear."
    "Amicus prope aurem meam iocose fremit."

# game/a1s3.rpy:713
translate latin a1s3_3a1062af:

    # a "\"Ha! Now it's your turn to train. Try and and get out of this!\""
    a "\"Ha! Nunc tibi exercendum est. Age, ex hoc te expedi!\""

# game/a1s3.rpy:714
translate latin a1s3_81c25d14:

    # "He leans heavily against me, using his weight to his advantage."
    "Pondere suo mihi graviter incumbit, eo sibi commodum quaerens."

# game/a1s3.rpy:715
translate latin a1s3_ce1d26c5:

    # "It's clear I have no chance of getting out of the hold, but I try anyway, struggling and complaining."
    "Manifestum est me nullo modo e complexu evasurum esse; tamen conor, luctans et querens."

# game/a1s3.rpy:720
translate latin a1s3_6fae2329:

    # unk "\"AMICUS!\""
    unk "\"AMICE!\""

# game/a1s3.rpy:721
translate latin a1s3_a133cfaf:

    # "I jump and so does Amicus, the wolf immediately letting me go."
    "Subito expavesco, Amicus quoque; lupus statim me dimittit."

# game/a1s3.rpy:722
translate latin a1s3_9504849a:

    # "The sudden lack of support almost causes me to face-plant before Amicus catches me and sets me back on my feet."
    "Cum repente sustineri desino, paene in vultum cado; Amicus autem me excipit et in pedes restituit."

# game/a1s3.rpy:723
translate latin a1s3_9a392d1e:

    # "I turn around and see Cato."
    "Me verto et Catonem video."

# game/a1s3.rpy:725
translate latin a1s3_ac8979c8:

    # "Despite the volume and fury in his voice just moments earlier, he appears almost calm."
    "Quamquam paulo ante tam magna tamque irata voce clamaverat, nunc paene tranquillus videtur."

# game/a1s3.rpy:727
translate latin a1s3_a1532780:

    # "Amicus and I stand there for a moment, breathing heavily, then Amicus bows."
    "Amicus et ego paulisper illic stamus, graviter respirantes; deinde Amicus se inclinat."

# game/a1s3.rpy:729
translate latin a1s3_44922b6d:

    # a "\"Good morning, Cato.\""
    a "\"Bonum mane, Cato.\""

# game/a1s3.rpy:730
translate latin a1s3_1258f09c:

    # "I quickly follow suit, bowing low."
    "Statim idem facio, me alte inclinans."

# game/a1s3.rpy:731
translate latin a1s3_8f38e98a:

    # "There's a moment of silence as Cato regards us both."
    "Paulisper silentium est dum Cato ambos intuetur."

# game/a1s3.rpy:732
translate latin a1s3_0ce1b6f8:

    # ca "\"Afternoon, you mean. You're late.\""
    ca "\"Post meridiem dicere vis. Sero venis.\""

# game/a1s3.rpy:733
translate latin a1s3_69b852c5:

    # a "\"My apologies. I lost track of the time at the lake.\""
    a "\"Ignosce. Ad lacum temporis rationem amisi.\""

# game/a1s3.rpy:735
translate latin a1s3_e49171ce:

    # ca "\"Your pet did not remind you? Is that not one of his duties?\""
    ca "\"Animal tuum domesticum te non admonuit? Nonne hoc unum ex officiis eius est?\""

# game/a1s3.rpy:736
translate latin a1s3_f71f2867:

    # "Cato's gaze snaps in my direction, and I almost jump."
    "Cato oculos repente ad me convertit, ita ut paene expavescam."

# game/a1s3.rpy:737
translate latin a1s3_8d72bb25:

    # "I don't know what to do, so I go back to bowing, wondering if I should apologize."
    "Nescio quid agam; itaque rursus me inclino, quaerens num veniam petere debeam."

# game/a1s3.rpy:739
translate latin a1s3_6fa3ed67:

    # a "\"I...have not taught him our hours yet, Cato. It's my fault.\""
    a "\"Horas nostras...eum nondum docui, Cato. Mea culpa est.\""

# game/a1s3.rpy:740
translate latin a1s3_dbd970c4:

    # "Cato watches us for a moment longer, then begins unfastening his robe."
    "Cato paulo diutius nos observat, deinde tunicam solvere incipit."

# game/a1s3.rpy:741
translate latin a1s3_6e16595e:

    # ca "\"Luckily, my appointment with the Praetor has been canceled, so despite your tardiness, we may train."
    ca "\"Forte colloquium meum cum Praetore sublatum est; itaque, quamquam sero venisti, exerceri possumus."

# game/a1s3.rpy:743
translate latin a1s3_60976eed:

    # "Cato tosses his robe aside."
    "Cato tunicam ad latus proicit."

# game/a1s3.rpy:745
translate latin a1s3_3918878d:

    # ca "\"Move, pet.\""
    ca "\"Recede, animal domesticum.\""

# game/a1s3.rpy:746
translate latin a1s3_c6fa9434:

    # "I stand there like an idiot for a moment before realizing he's talking to me."
    "Paulisper quasi stultus sto, antequam intellego eum mecum loqui."

# game/a1s3.rpy:751
translate latin a1s3_2825f32d:

    # "I hurry over to sit down next to Alex and I can tell by the expression on his face that he's also a bit worried."
    "Festino ut iuxta Alex sedeam; ex vultu eius video eum quoque paulum sollicitum esse."

# game/a1s3.rpy:752
translate latin a1s3_f34174c6:

    # ca "\"I see you've already warmed up.\""
    ca "\"Video te iam corpus ad exercitationem paravisse.\""

# game/a1s3.rpy:753
translate latin a1s3_c25fe680:

    # "Cato glances over at me again before turning back to Amicus, getting into a crouch."
    "Cato me rursus breviter aspicit, deinde ad Amicum se vertit et in flexis genibus se demittit."

# game/a1s3.rpy:754
translate latin a1s3_e80d154a:

    # "Amicus stands awkwardly for a moment before doing the same."
    "Amicus paulisper incommode stat, deinde idem facit."

# game/a1s3.rpy:755
translate latin a1s3_e334baab:

    # a "\"Yes...did you need to—\""
    a "\"Ita...tu quoque debebasne—\""

# game/a1s3.rpy:756
translate latin a1s3_cfccba8b:

    # ca "\"I did mine while waiting for you for over half an hour, Amicus.\""
    ca "\"Ego me praeparavi dum te plus quam dimidiam horam exspectabam, Amice.\""

# game/a1s3.rpy:757
translate latin a1s3_8e5d5cd5:

    # a "\"Ah.\""
    a "\"Ah.\""

# game/a1s3.rpy:758
translate latin a1s3_8928b34c:

    # "The two big wolves start circling each other."
    "Duo ingentes lupi alter alterum circumire incipiunt."

# game/a1s3.rpy:759
translate latin a1s3_843381a1:

    # "I want to ask Alex if this is normal, but something tells me I shouldn't speak out of turn in the presence of Cato."
    "Alex quaerere volo num hoc usitatum sit; sed aliquid me monet ne coram Catone intempestive loquar."

# game/a1s3.rpy:760
translate latin a1s3_c160b5bc:

    # ca "\"Your brother had a very successful speech in the city today; over five hundred thousand attended.\""
    ca "\"Frater tuus hodie in urbe orationem optime acceptam habuit; amplius quingenta milia personarum aderant.\""

# game/a1s3.rpy:761
translate latin a1s3_8ca1e2e3:

    # a "\"Hm?\""
    a "\"Hm?\""

# game/a1s3.rpy:762
translate latin a1s3_342cb407:

    # "Amicus seems thrown off by what Cato said, but then Cato's fist snaps out and smacks Amicus right on the nose."
    "Verba Catonis Amicum perturbasse videntur; tum Cato pugnum repente porrigit et recta nasum Amici percutit."

# game/a1s3.rpy:767
translate latin a1s3_4cef82d5:

    # a "\"Agh!\""
    a "\"Ah!\""

# game/a1s3.rpy:768
translate latin a1s3_4c60859e:

    # "The wolf stumbles back, blinking and snorting as he holds his face."
    "Lupus retro titubat, palpebras movens et per nares fremens, dum vultum manibus tenet."

# game/a1s3.rpy:769
translate latin a1s3_cd46b176:

    # "I wince."
    "Vultum dolore contraho."

# game/a1s3.rpy:770
translate latin a1s3_c27f2ff8:

    # "Didn't Amicus just tell me they didn't go for the face during training?"
    "Nonne Amicus modo mihi dixit eos inter exercitationem vultum non petere?"

# game/a1s3.rpy:772
translate latin a1s3_b156ebce:

    # "I look at Alex questioningly, but the cat is now looking firmly at the ground between his feet, his ears down."
    "Alex interrogantis vultu aspicio; felis autem nunc terram inter pedes suos fixe intuetur, auribus demissis."

# game/a1s3.rpy:773
translate latin a1s3_6c479a8f:

    # ca "\"That's double his last speech, Amicus, and it rivals your father's early days as emperor.\""
    ca "\"Bis tot aderant quot ad priorem orationem, Amice; hoc cum primis diebus imperii patris tui certat.\""

# game/a1s3.rpy:774
translate latin a1s3_f2d14184:

    # "Amicus has recovered at this point and he's got his paws back up, his teeth bared."
    "Amicus iam se recepit et manus rursus attollit, dentibus nudatis."

# game/a1s3.rpy:775
translate latin a1s3_a7e9ee65:

    # "He doesn't respond and starts circling Cato again, and this time he attacks first, throwing an elbow at Cato's face."
    "Non respondet et Catonem rursus circumire incipit; hac vice primus petit, cubitum in vultum Catonis ferens."

# game/a1s3.rpy:776
translate latin a1s3_5b69272a:

    # "Cato ducks it and moves to the side, smacking a fist into Amicus's back, right over the kidney."
    "Cato se demittens evitat et ad latus movetur, pugno tergum Amici recta super renem feriens."

# game/a1s3.rpy:780
translate latin a1s3_13839791:

    # a "\"AAAAGH!\""
    a "\"AAAAGH!\""

# game/a1s3.rpy:781
translate latin a1s3_cc05f46f:

    # "Amicus lets out a pained grunt, bending sideways and stumbling before forcing himself back into position, his teeth showing now."
    "Amicus grunnitum doloris edit, ad latus se flectens et titubans; deinde se in statum pugnae restituit, iam dentibus ostensis."

# game/a1s3.rpy:782
translate latin a1s3_1d6a1e54:

    # ca "\"And while you were being a pup at the lake, Cassius was touring the countryside, and even that drew thousands.\""
    ca "\"Et dum te ad lacum catuli more gerebas, Cassius agros circumibat; id quoque multa milia attraxit.\""

# game/a1s3.rpy:783
translate latin a1s3_72a0c8d6:

    # "Cato throws a sudden kick at Amicus's thigh, and I look away, but I still hear the painful thwack of furry flesh on furry flesh."
    "Cato repente femur Amici calce petit; oculos averto, sed ictum dolorosum carnis villosae in carnem villosam audio."

# game/a1s3.rpy:784
translate latin a1s3_c113be52:

    # "This isn't training, this is punishment."
    "Haec exercitatio non est; poena est."

# game/a1s3.rpy:785
translate latin a1s3_bc5e88d9:

    # ca "\"Stealing a ship and flying across the galaxy will only get you so far, Amicus. You win the people over, not me—UNGH!\""
    ca "\"Navem furari et per galaxiam volare non satis est, Amice. Populum tibi conciliandum est, non me—UNGH!\""

# game/a1s3.rpy:786
translate latin a1s3_d8a4886e:

    # "Amicus bull rushes the old wolf, grabbing one of Cato's legs by the thigh, lifting it off the ground while he starts throwing vicious punches into the older wolf's face."
    "Amicus in senem lupum impetu irrumpit; unum crus Catonis ad femur arripit idque a terra tollit, dum vultum senis pugnis saevis crebro percutit."

# game/a1s3.rpy:787
translate latin a1s3_41bc6417:

    # "Cato seems to become dazed, stumbling on his one foot, raising his paws to protect himself."
    "Cato stupefactus videtur, uno pede titubans, manus ad se protegendum tollens."

# game/a1s3.rpy:788
translate latin a1s3_58b1d597:

    # "I silently root for Amicus, wanting to see him put the old man on his ass."
    "Tacitus Amico faveo, cupiens videre eum senem in nates deicere."

# game/a1s3.rpy:789
translate latin a1s3_624c489f:

    # "But then Cato's paw comes around in a vicious slap that turns Amicus's head to the right."
    "Sed tum Cato manum in saevo ictu circumfert, qui caput Amici ad dextram vertit."

# game/a1s3.rpy:790
translate latin a1s3_6200d51f:

    # "He drops Cato's leg, and that's when the old wolf wraps his arms around Amicus's waist, setting his shoulder in the other wolf's stomach before actually lifting him up off the ground."
    "Amicus crus Catonis dimittit; tum senex brachiis lumbos Amici amplectitur, umerum contra ventrem alterius ponit et vere totum eum a terra tollit."

# game/a1s3.rpy:792
translate latin a1s3_0af994cf:

    # "I don't know exactly how much Amicus weighs, but it's probably around the same as Cato himself, and somehow the old wolf is able to carry Amicus across the pit in a rush."
    "Nescio exacte quanti ponderis Amicus sit; sed fere tantum quantum ipse Cato pendere debet. Quoquo modo senex lupus Amicum rapido cursu trans arenam portare potest."

# game/a1s3.rpy:796
translate latin a1s3_6437268b:

    # "Alex and I dive out of the way as Cato crushes Amicus into the stairs with a thudding crunch."
    "Alex et ego ex via salimus, dum Cato Amicum in gradus sonitu gravi ac fragore allidit."

# game/a1s3.rpy:797
translate latin a1s3_bfc7fc2f:

    # a "\"Huuunffh!\""
    a "\"Huuunffh!\""

# game/a1s3.rpy:799
translate latin a1s3_8e1a2876:

    # "I look back and see Amicus folded around Cato's shoulder, making a sound like a deflating tire as his eyes bulge."
    "Respicio et Amicum circa umerum Catonis complicatum video, sonum velut rotae inflatae aere exeunte edentem, oculis prominentibus."

# game/a1s3.rpy:800
translate latin a1s3_0907b945:

    # "After a moment, Cato finally pulls back."
    "Paulo post Cato tandem recedit."

# game/a1s3.rpy:801
translate latin a1s3_42b33f69:

    # "Amicus curls up and rolls down the few steps to the pit of the amphitheater, making a horrible groaning sound."
    "Amicus se contrahit et paucos gradus ad arenam amphitheatri devolvitur, horrendum gemitum edens."

# game/a1s3.rpy:802
translate latin a1s3_f0281a99:

    # "Cato, meanwhile, straightens out his undergarments before turning to pick his robes up."
    "Cato interim vestimentum interius componit, deinde se vertit ut tunicam tollat."

# game/a1s3.rpy:804
translate latin a1s3_88f365cd:

    # ca "\"Good spar, Amicus. I hope you learned something from it. I announced to the public that the trials will begin at the end of this month.\""
    ca "\"Bene pugnatum est, Amice. Spero te aliquid didicisse. Populo nuntiavi certamina exeunte hoc mense incipere.\""

# game/a1s3.rpy:805
translate latin a1s3_ec5a8b2d:

    # ca "\"Remember that your pet will be involved, so be sure that he's prepared.\""
    ca "\"Memento animal tuum domesticum quoque participaturum esse; cura igitur ut paratum sit.\""

# game/a1s3.rpy:807
translate latin a1s3_c5e63ec2:

    # "Cato ties on his robe as he walks away, then suddenly turns as if forgetting something, addressing the still-wheezing Amicus."
    "Cato tunicam sibi alligat dum abit; tum repente se vertit, quasi aliquid oblitus, ad Amicum adhuc anhelantem loquens."

# game/a1s3.rpy:808
translate latin a1s3_35af9d64:

    # ca "\"Oh, and your sister and her guest arrived today. She requested to see you in the great hall as soon as our session ended.\""
    ca "\"Oh, soror tua et hospes eius hodie advenerunt. Rogavit ut statim post exercitationem nostram ad se in aulam magnam venires.\""

# game/a1s3.rpy:810
translate latin a1s3_6a826c68:

    # "And with that, Cato stalks off, his robes billowing in the wind."
    "His dictis, Cato magnis passibus abit, tunica vento agitata."

# game/a1s3.rpy:812
translate latin a1s3_32a278f0:

    # "I rush to Amicus's side."
    "Ad latus Amici festino."

# game/a1s3.rpy:813
translate latin a1s3_fb6c0d0f:

    # m "\"Amicus! Are you okay?\""
    m "\"Amice! Bene te habes?\""

# game/a1s3.rpy:814
translate latin a1s3_4741aae0:

    # "I know that wolves are tougher than humans, but if I'd been slammed into the stairs like that there'd be a good chance I'd never get back up."
    "Scio lupos hominibus duriores esse; sed si ego sic in gradus allisus essem, fortasse numquam resurrexissem."

# game/a1s3.rpy:815
translate latin a1s3_ac1a28d3:

    # "I set a hand on the Amicus's back as he hugs at his middle and presses his face against the stone floor."
    "Manum in tergum Amici pono, dum medium corpus amplectitur et vultum pavimento lapideo premit."

# game/a1s3.rpy:816
translate latin a1s3_52a9f44d:

    # "He keeps making a strained, grunting sound, and I can see a strand of drool connecting from his lips to the ground."
    "Adhuc grunnit cum labore; video filum salivae a labiis eius ad terram pertinere."

# game/a1s3.rpy:818
translate latin a1s3_4861c620:

    # "Alex stands next to us, nervously fidgeting with his robe."
    "Alex iuxta nos stat, tunicam nervosus tractans."

# game/a1s3.rpy:819
translate latin a1s3_2e87079d:

    # m "\"Amicus?\""
    m "\"Amice?\""

# game/a1s3.rpy:820
translate latin a1s3_a72df472:

    # "Amicus surprises me by roughly pushing my hand away."
    "Amicus manum meam vehementer repellit, quod me mirari facit."

# game/a1s3.rpy:822
translate latin a1s3_b5500f37:

    # a "\"I...I just...lost my wind. Give me...a moment.\""
    a "\"Ego...ego modo...spiritum amisi. Da mihi...paulisper.\""

# game/a1s3.rpy:823
translate latin a1s3_c753c6b8:

    # "Amicus turns away from me, then rolls onto his back, his paws above his head, his breathing still irregular, but at least he {i}is{/i} breathing now."
    "Amicus a me se avertit, deinde supinus se vertit, manibus supra caput positis. Respiratio adhuc inaequalis est; saltem tamen nunc {i}respirat{/i}."

# game/a1s3.rpy:824
translate latin a1s3_bbe4aec7:

    # "Alex clears his throat."
    "Alex fauces purgat."

# game/a1s3.rpy:826
translate latin a1s3_1909cd31:

    # al "\"Amicus, do you need medical attention?\""
    al "\"Amice, opusne tibi medici auxilio est?\""

# game/a1s3.rpy:827
translate latin a1s3_c04dd6b9:

    # "Amicus takes a deep breath, then lets it out slowly."
    "Amicus alte spiritum ducit, deinde lente emittit."

# game/a1s3.rpy:828
translate latin a1s3_2765f877:

    # a "\"No, Alex.\""
    a "\"Non, Alex.\""

# game/a1s3.rpy:829
translate latin a1s3_f401e24f:

    # al "\"Alright...then I should probably take my leave. I don't know when Cassius will return.\""
    al "\"Bene...igitur mihi fortasse abeundum est. Nescio quando Cassius redibit.\""

# game/a1s3.rpy:830
translate latin a1s3_c7a54e22:

    # "Alex, looking extremely uncomfortable, bows to both of us."
    "Alex, vultu valde incommodo, ambos nos salutat inclinans."

# game/a1s3.rpy:831
translate latin a1s3_6058277e:

    # al "\"Amicus, [mc], thank you for the outing. It was very relaxing.\""
    al "\"Amice, [mc], gratias pro excursione. Valde tranquilla fuit.\""

# game/a1s3.rpy:833
translate latin a1s3_96c1acc4:

    # "He then quickly makes his exit down the stone path, disappearing through the trees."
    "Tum celeriter per semitam lapideam abit et inter arbores evanescit."

# game/a1s3.rpy:834
translate latin a1s3_e23603b5:

    # "I stand awkwardly off to the side, waiting for Amicus to recover."
    "Incommode ad latus sto, exspectans dum Amicus se recipiat."

# game/a1s3.rpy:835
translate latin a1s3_0d223639:

    # a "\"Tch, some ambassador friend he is.\""
    a "\"Tch, egregius ille amicus legatus!\""

# game/a1s3.rpy:836
translate latin a1s3_288a180b:

    # "He opens one eye, looking at me."
    "Alterum oculum aperit et me aspicit."

# game/a1s3.rpy:838
translate latin a1s3_0240f4d0:

    # a "\"You know, you can head back to the palace as well.\""
    a "\"Scis, tu quoque ad palatium redire potes.\""

# game/a1s3.rpy:839
translate latin a1s3_a6737e04:

    # m "\"I...just wanna make sure you're okay.\""
    m "\"Ego...modo certus esse volo te bene valere.\""

# game/a1s3.rpy:840
translate latin a1s3_bb29fc33:

    # a "\"I'm fine.\""
    a "\"Bene valeo.\""

# game/a1s3.rpy:841
translate latin a1s3_6da6c062:

    # m "\"I mean, he hit you really hard. I'm a little worried.\""
    m "\"Gravissime te percussit. Paululum sollicitus sum.\""

# game/a1s3.rpy:843
translate latin a1s3_d24211da:

    # a "\"Don't be. Go back to my room.\""
    a "\"Noli esse. Redi in cubiculum meum.\""

# game/a1s3.rpy:844
translate latin a1s3_16893f7f:

    # "Amicus's usually cheerful mood has completely dissipated."
    "Usitata hilaritas Amici omnino evanuit."

# game/a1s3.rpy:845
translate latin a1s3_70f08979:

    # m "\"Well, if I'm pretending to be your pet then I guess I'll just pretend to be worried, alright?\""
    m "\"Si animal tuum domesticum simulo, me sollicitum esse quoque simulabo, bene?\""

# game/a1s3.rpy:846
translate latin a1s3_eda0f1e0:

    # "Amicus just grunts and finally gets to his feet, wincing as he does."
    "Amicus tantum grunnit; tandem in pedes surgit, dolore vultum contrahens."

# game/a1s3.rpy:847
translate latin a1s3_f9452f29:

    # "He straightens out his undergarments which had twisted off to the side before walking toward the same path Alex had taken."
    "Vestimentum interius ad latus contortum componit, deinde eandem semitam petit quam Alex secutus est."

# game/a1s3.rpy:849
translate latin a1s3_898012cb:

    # "I quickly catch up, following a few steps behind the wolf."
    "Celeriter eum assequor et paucos passus post lupum sequor."

# game/a1s3.rpy:850
translate latin a1s3_353d1fae:

    # "Amicus is hunched over, walking with a light limp."
    "Amicus incurvus ambulat, paulum claudicans."

# game/a1s3.rpy:851
translate latin a1s3_701306c3:

    # "I feel a wave of anger for Cato."
    "Ira in Catonem me repente perfundit."

# game/a1s3.rpy:852
translate latin a1s3_844a9673:

    # "He'd been nice to me yesterday, but now I realize that isn't typical for him."
    "Heri mihi benignus fuerat; iam intellego hoc ei non usitatum esse."

# game/a1s3.rpy:853
translate latin a1s3_d356c29c:

    # "I understood the \"lesson\" he was teaching Amicus in the amphitheater, but I don't understand why it had to involve violence."
    "Intellexi \"lectionem\" quam Amico in amphitheatro dabat; non autem intellego cur vis adhibenda fuerit."

# game/a1s3.rpy:854
translate latin a1s3_7c208c67:

    # "Is this how the wolves normally treated each other?"
    "Solentne lupi sic alter alterum tractare?"

# game/a1s3.rpy:855
translate latin a1s3_77941b03:

    # "Fake civility with bursts of savage aggression?"
    "Urbanitas simulata, repente saevis impetibus interrupta?"

# game/a1s3.rpy:856
translate latin a1s3_50784dc8:

    # m "\"Was that...was what Cato did normal?\""
    m "\"Eratne hoc...eratne quod Cato fecit usitatum?\""

# game/a1s3.rpy:858
translate latin a1s3_cc43205e:

    # a "\"What do you mean?\""
    a "\"Quid dicis?\""

# game/a1s3.rpy:859
translate latin a1s3_3600a524:

    # m "\"I mean, does he usually just...beat you like that?\""
    m "\"Hoc volo dicere: soletne te sic...verberare?\""

# game/a1s3.rpy:860
translate latin a1s3_6d85daed:

    # "Amicus sighs deeply."
    "Amicus alte suspirat."

# game/a1s3.rpy:861
translate latin a1s3_67ace871:

    # a "\"Not usually, no.\""
    a "\"Non solet, non.\""

# game/a1s3.rpy:862
translate latin a1s3_368271e2:

    # m "\"Seemed a bit...much.\""
    m "\"Paulo...nimis saevum visum est.\""

# game/a1s3.rpy:864
translate latin a1s3_b6df1af7:

    # a "\"Can we not speak of this? I'm not in the mood.\""
    a "\"Possumusne de hoc non loqui? Mihi nunc non libet.\""

# game/a1s3.rpy:865
translate latin a1s3_53d090c1:

    # "I go quiet and I see Amicus's ears fall flat for a bit before coming back up."
    "Taceo et aures Amici paulisper demitti, deinde rursus erigi video."

# game/a1s3.rpy:867
translate latin a1s3_ebc91ffe:

    # "We walk the rest of the way to the palace in silence."
    "Reliquam viam ad palatium taciti pergimus."

# game/a1s3.rpy:868
translate latin a1s3_e6b91e0b:

    # "I'm sure to stay a few steps behind Amicus, wanting to give him space."
    "Paucos passus post Amicum manere curo, ut eum sibi relinquam."

# game/a1s3.rpy:870
translate latin a1s3_5b4c61b2:

    # "I get the feeling that while he's definitely upset about what happened, he's mostly just embarrassed that I saw it."
    "Mihi videtur, quamquam certe ea quae acciderunt eum perturbant, maxime pudere quod ego ea viderim."

# game/a1s3.rpy:873
translate latin a1s3_89cc8238:

    # "We finally reach the main entrance to the palace and just as we turn into the great hall—"
    "Tandem ad primarium palatii aditum pervenimus; atque ut in aulam magnam ingredimur—"

# game/a1s3.rpy:875
translate latin a1s3_120f6972:

    # unk "\"Amicus!\""
    unk "\"Amice!\""

# game/a1s3.rpy:876
translate latin a1s3_96761ffb:

    # "A high, sing-song voice echoes around the marble walls as a slight, Wolvish figure quickly approaches us."
    "Vox acuta et canora inter parietes marmoreos resonat, dum gracilis figura lupina celeriter ad nos accedit."

# game/a1s3.rpy:878
translate latin a1s3_eb529969:

    # "A wolf who I can only imagine is Virginia walks up to Amicus."
    "Lupa, quam Virginiam esse puto, ad Amicum venit."

# game/a1s3.rpy:879
translate latin a1s3_2984a8e8:

    # "She places both paws on his shoulders and leans in, pressing the side of her face to his."
    "Ambas manus umeris eius imponit et se inclinat, latus vultus sui vultui eius admovens."

# game/a1s3.rpy:881
translate latin a1s3_d396564e:

    # a "\"Hi, Virginia.\""
    a "\"Salve, Virginia.\""

# game/a1s3.rpy:882
translate latin a1s3_624bf570:

    # "Virginia pulls back, rolling her eyes."
    "Virginia se retrahit et oculos sursum vertit."

# game/a1s3.rpy:884
translate latin a1s3_fafd2f3b:

    # v "\"Amicus, I took your place on a trip around the moon for a full week and your only response is 'hi'?\""
    v "\"Amice, per totam hebdomadam loco tuo lunam circumiens iter feci, et tu tantum 'salve' respondes?\""

# game/a1s3.rpy:886
translate latin a1s3_2ddfb85a:

    # a "\"Sorry, I...I'm not feeling all that well.\""
    a "\"Ignosce, ego...non admodum bene me habeo.\""

# game/a1s3.rpy:888
translate latin a1s3_637c1856:

    # v "\"Oh? Was Cato too rough with you during training? Shall I have a word with him?\""
    v "\"Oh? Cato nimis saeve te inter exercitationem tractavit? Visne ut eum de hoc alloquar?\""

# game/a1s3.rpy:890
translate latin a1s3_30c10f04:

    # a "\"No, I'm just sore.\""
    a "\"Non, tantum doleo.\""

# game/a1s3.rpy:892
translate latin a1s3_853eb190:

    # v "\"Mh, you could use a shower, too. You smell dreadful.\""
    v "\"Mh, tibi quoque imbre lavandum est. Foedissime oles.\""

# game/a1s3.rpy:894
translate latin a1s3_e96b5234:

    # a "\"I—we were swimming in the lake...never mind.\""
    a "\"Ego—nos in lacu natabamus...nihil refert.\""

# game/a1s3.rpy:896
translate latin a1s3_1654af19:

    # a "\"I should be getting back to my room.\""
    a "\"Mihi in cubiculum meum redeundum est.\""

# game/a1s3.rpy:898
translate latin a1s3_3ecc1aa9:

    # v "\"Enough with the dour mood, Amicus. Not until we introduce our guests to each other!\""
    v "\"Satis iam tristitiae, Amice. Non prius quam hospites nostros inter se praesentaverimus!\""

# game/a1s3.rpy:900
translate latin a1s3_304e03c1:

    # "Virginia looks right at me, over Amicus's shoulder."
    "Virginia ultra umerum Amici me recta aspicit."

# game/a1s3.rpy:901
translate latin a1s3_377c83fb:

    # "Amicus sighs, then reaches out his paw to me."
    "Amicus suspirat, deinde manum ad me porrigit."

# game/a1s3.rpy:902
translate latin a1s3_e9dfa47b:

    # "I walk over to him, letting the wolf place his paw on my shoulder."
    "Ad eum accedo et lupum manum umero meo imponere sino."

# game/a1s3.rpy:903
translate latin a1s3_f0aa396d:

    # a "\"This is [mc], he's an abandoned child.\""
    a "\"Hic est [mc]; unus est e Liberis desertis.\""

# game/a1s3.rpy:905
translate latin a1s3_1dca376f:

    # v "\"Oh, fascinating. I thought Cass was pulling my tail in his letters.\""
    v "\"Oh, quam mirum. Putabam Cass in litteris suis me ludificari.\""

# game/a1s3.rpy:907
translate latin a1s3_c04e3ef2:

    # "Virginia stretches out a paw."
    "Virginia manum porrigit."

# game/a1s3.rpy:908
translate latin a1s3_f89be9be:

    # "I stand there awkwardly, unsure of what to do...so I reach out and take her paw in my hand."
    "Incommode ibi sto, incertus quid faciam...itaque manum porrigo et eius manum mea prehendo."

# game/a1s3.rpy:909
translate latin a1s3_94774804:

    # "Then, after another pause, I lean down and brush my lips on her fur like I'd seen people do in movies."
    "Deinde, post alteram moram, me inclino et labra leviter pilis eius admoveo, sicut homines in pelliculis facere videram."

# game/a1s3.rpy:911
translate latin a1s3_68690702:

    # v "\"Heh, interesting. It seems they have some sort of etiquette.\""
    v "\"Heh, mirum. Videntur aliquas urbanitatis regulas habere.\""

# game/a1s3.rpy:912
translate latin a1s3_3036822a:

    # "I step back, keeping my head down."
    "Recedo, capite demisso."

# game/a1s3.rpy:914
translate latin a1s3_45800067:

    # a "\"A bit, yes. Now where's the Khemian?\""
    a "\"Aliquas, sane. Nunc ubi est Khemius?\""

# game/a1s3.rpy:915
translate latin a1s3_af6d301a:

    # v "\"Manners, Amicus. He's examining the murals.\""
    v "\"Urbanior esto, Amice. Picturas murales inspicit.\""

# game/a1s3.rpy:916
translate latin a1s3_fec9b48e:

    # "She turns to her right, raising her voice a bit."
    "Se ad dextram vertit et vocem paulo tollit."

# game/a1s3.rpy:918
translate latin a1s3_69c7ae95:

    # v "\"Neferu? Could you come over and meet my brother, please?\""
    v "\"Neferu? Visne huc venire ut fratrem meum cognoscas?\""

# game/a1s3.rpy:919
translate latin a1s3_7ff82308:

    # "There's a moment of silence, then soft footsteps."
    "Paulisper silentium est, deinde vestigia lenia audiuntur."

# game/a1s3.rpy:921
translate latin a1s3_d963e447:

    # "A canine appears around the corner, his fur much darker than the wolves, almost pitch-black."
    "Canis circa angulum apparet, cuius pili multo obscuriores sunt quam luporum, paene pice nigri."

# game/a1s3.rpy:922
translate latin a1s3_cdd97703:

    # "He's covered in gold highlights and immediately I'm struck by how he looks."
    "Aureis ornamentis obtectus est; statim species eius me percellit."

# game/a1s3.rpy:923
translate latin a1s3_b8b90a9b:

    # "Not just because his presence is impressive, it definitely is, but mostly because he reminds me of something on Earth."
    "Non solum quia praesentia eius magnifica est, quod certe est, sed maxime quia me rei cuiusdam in Terra admonet."

# game/a1s3.rpy:924
translate latin a1s3_bf7c6b3e:

    # "Not just something, but an entire thing...a culture."
    "Non modo rei cuiusdam, sed rei integrae...cultus cuiusdam."

# game/a1s3.rpy:926
translate latin a1s3_3a1bdb90:

    # "As I stare, I realize that he's not looking at Amicus, but at me."
    "Dum intueor, eum Amicum non aspicere, sed me intellego."

# game/a1s3.rpy:927
translate latin a1s3_ff54a66a:

    # "I quickly look down again, not wanting to draw attention to myself."
    "Celeriter oculos rursus demitto, nolens animos in me convertere."

# game/a1s3.rpy:929
translate latin a1s3_5331dcd4:

    # v "\"Neferu, this is my brother, Amicus.\""
    v "\"Neferu, hic est frater meus, Amicus.\""

# game/a1s3.rpy:930
translate latin a1s3_bc3cce23:

    # "Neferu bows his head slightly in Amicus's direction."
    "Neferu caput paulo versus Amicum inclinat."

# game/a1s3.rpy:932
translate latin a1s3_fffa4ba3:

    # n "\"Hello, thank you for letting me take up residence in your palace. It is indeed beautiful.\""
    n "\"Salve; gratias quod in palatio tuo habitare me sinis. Pulcherrimum certe est.\""

# game/a1s3.rpy:933
translate latin a1s3_1c34b703:

    # "It's hard to describe, but I immediately know that Neferu is speaking a different language than the wolves."
    "Difficile est describere; tamen statim scio Neferu alia lingua quam lupos loqui."

# game/a1s3.rpy:934
translate latin a1s3_548a3826:

    # "It has a different feel in my brain, like a different dialect."
    "Aliter eam mente percipio, quasi alia dialectus sit."

# game/a1s3.rpy:936
translate latin a1s3_3de05df9:

    # a "\"Certainly. You'll have to excuse my appearance; I was just out combat training.\""
    a "\"Certe. Speciei meae ignoscas oportet; modo foris ad pugnam me exercebam.\""

# game/a1s3.rpy:938
translate latin a1s3_55d9bb52:

    # n "\"Oh, I see. It must have been a rough session, by the looks of it.\""
    n "\"Oh, intellego. Ex specie tua videtur aspera exercitatio fuisse.\""

# game/a1s3.rpy:942
translate latin a1s3_65126a1b:

    # "Neferu gives Amicus a cool smile and Amicus can only manage a grunt in response, self-consciously running a paw over his head fur."
    "Neferu Amico frigide arridet; Amicus tantum grunnitum respondere potest, manum per capitis pilos ducens, specie sua sollicitus."

# game/a1s3.rpy:943
translate latin a1s3_750703dc:

    # "That's when Neferu turns his cool, blue gaze on me."
    "Tum Neferu oculos caeruleos et frigidos ad me convertit."

# game/a1s3.rpy:945
translate latin a1s3_13175862:

    # n "\"And who might you be?\""
    n "\"Et tu quis es?\""

# game/a1s3.rpy:946
translate latin a1s3_b05e013c:

    # "I open my mouth to answer, then catch myself and quickly look back down."
    "Os aperio ut respondeam, sed me cohibeo et celeriter oculos rursus demitto."

# game/a1s3.rpy:948
translate latin a1s3_ee3d1d40:

    # a "\"This is [mc], my pet. He's an abandoned child.\""
    a "\"Hic est [mc], animal meum domesticum. Unus est e Liberis desertis.\""

# game/a1s3.rpy:949
translate latin a1s3_e29b59fc:

    # "Amicus says it quickly, putting his paw on my shoulder again while gently pulling me in the direction of his room."
    "Amicus haec celeriter dicit, manum rursus umero meo imponens et me leniter versus cubiculum suum trahens."

# game/a1s3.rpy:951
translate latin a1s3_42805eda:

    # a "\"It was wonderful meeting you, but now I must be off to my shower—\""
    a "\"Valde gaudeo te cognovisse, sed nunc mihi imbre lavatum eundum est—\""

# game/a1s3.rpy:953
translate latin a1s3_4ea9f189:

    # "Neferu offers his paw to me."
    "Neferu manum mihi porrigit."

# game/a1s3.rpy:955
translate latin a1s3_066d5afd:

    # "I pause again, but Amicus just stares at Neferu, so I take it and do the same as I did with Virginia."
    "Rursus cunctor; sed Amicus tantum Neferu intuetur, itaque manum accipio et idem facio quod cum Virginia feci."

# game/a1s3.rpy:957
translate latin a1s3_df8aa612:

    # "Neferu lets out a soft chuckle as I let go of his paw."
    "Neferu leniter cachinnat, dum manum eius dimitto."

# game/a1s3.rpy:959
translate latin a1s3_74d81c2e:

    # n "\"What a fascinating creature. Do you speak?\""
    n "\"Quam mirabile animal. Loquerisne?\""

# game/a1s3.rpy:960
translate latin a1s3_be9d0e5d:

    # "I make sure to give a long pause, then—"
    "Longam moram consulto facio, deinde—"

# game/a1s3.rpy:961
translate latin a1s3_209b2171:

    # m "\"Little...\""
    m "\"Paulum...\""

# game/a1s3.rpy:963
translate latin a1s3_80416439:

    # n "\"I see.\""
    n "\"Intellego.\""

# game/a1s3.rpy:964
translate latin a1s3_23e28f48:

    # "Neferu keeps his eyes fixed on me, and I have to wonder why the hell he's taken such an interest."
    "Neferu oculos in me fixos tenet; mecum quaero cur me, di boni, tanto studio observet."

# game/a1s3.rpy:966
translate latin a1s3_61cdecfe:

    # a "\"Ahem.\""
    a "\"Hem.\""

# game/a1s3.rpy:967
translate latin a1s3_9c95ecca:

    # "Amicus draws me close to his side with a paw before starting to walk in the direction of the hall."
    "Amicus manu me ad latus suum attrahit, deinde versus ambulacrum ire incipit."

# game/a1s3.rpy:968
translate latin a1s3_3bf51a1f:

    # a "\"If you'll excuse us, I need my pet's assistance in the showers. Pleasure meeting you.\""
    a "\"Si nobis ignoscitis, auxilio animalis mei domestici ad imbres egeo. Gaudeo te cognovisse.\""

# game/a1s3.rpy:969
translate latin a1s3_aa7b048f:

    # "Virginia, who had been silent throughout, smiles."
    "Virginia, quae toto tempore tacuerat, arridet."

# game/a1s3.rpy:971
translate latin a1s3_e5b611fb:

    # v "\"Don't worry Neferu, we just caught my brother in a bad mood. Usually he's much more friendly.\""
    v "\"Noli sollicitus esse, Neferu; modo fratrem meum tristem offendimus. Plerumque multo amicior est.\""

# game/a1s3.rpy:973
translate latin a1s3_4b709626:

    # a "\"I can hear you, Virginia. I'm still here.\""
    a "\"Te audio, Virginia. Adhuc hic sum.\""

# game/a1s3.rpy:977
translate latin a1s3_30a751d3:

    # v "\"So you are, yet you said you had to be off. We shall speak more in depth in the evening, perhaps when you've stopped sulking.\""
    v "\"Ita es; tamen dixisti tibi abeundum esse. Vesperi plura loquemur, fortasse cum maestus esse desieris.\""

# game/a1s3.rpy:979
translate latin a1s3_c1d6e3aa:

    # "Amicus grunts noncommittally and pulls me along toward his bedroom."
    "Amicus grunnit nihil promittens et me secum versus cubiculum trahit."

# game/a1s3.rpy:982
translate latin a1s3_2248249e:

    # "As we arrive at Amicus's room, there's a cart of flatbread, vegetables, and a bowl of sauce sitting outside the door."
    "Cum ad cubiculum Amici pervenimus, extra ianuam plaustrum panem planum, holera et patinam liquaminis ferens stat."

# game/a1s3.rpy:983
translate latin a1s3_bdf44a3b:

    # "I've come to realize that there are two main meals in the day: breakfast and dinner, with a sort of midday snack in between."
    "Iam intellexi duo praecipua cotidie convivia esse: ientaculum et cenam, cum parvo quodam prandio interiecto."

# game/a1s3.rpy:984
translate latin a1s3_9b28f8f5:

    # "Amicus grabs the cart and shoves it into the room toward the sofa, almost rattling the contents to the floor."
    "Amicus plaustrum prehendit et in cubiculum versus lectulum impellit, ita ut res quas fert concussae paene in pavimentum cadant."

# game/a1s3.rpy:985
translate latin a1s3_3f5fe7a9:

    # "Then, without a word, he heads straight to the shower, leaving me to sit on the couch while I frown at the door."
    "Deinde, nullo verbo dicto, recta ad imbrem it; me in lectulo sedentem et ianuam fronte contracta aspicientem relinquit."

# game/a1s3.rpy:986
translate latin a1s3_57c6e829:

    # "At first, I think about calling him out on his bad mood when he comes back out, maybe go on about how I didn't ask to be here and him being an ass only makes it worse."
    "Primo cogito eum, cum redeat, propter tristitiam reprehendere; fortasse dicam me huc venire non petivisse eumque se improbe gerentem res tantum peiores facere."

# game/a1s3.rpy:987
translate latin a1s3_a6191e7b:

    # "But then I start to realize that maybe I wouldn't be so happy myself if I'd gotten my ass kicked in front of my friends."
    "Deinde autem intellegere incipio fortasse me ipsum quoque non laetum fore si coram amicis vehementer victus essem."

# game/a1s3.rpy:988
translate latin a1s3_b9fb4a5c:

    # "I spend the next fifteen minutes or so spreading the orange-colored sauce on the flatbread before sprinkling the vegetables on top and rolling it into a wrap."
    "Proxima quindecim fere minuta liquamen aurantii coloris pani plano illino, deinde holera desuper spargo et panem circum ea convolvo."

# game/a1s3.rpy:989
translate latin a1s3_f4fd75ef:

    # "It's good, and the sauce is one of the first spicy things that I've experienced on this moon."
    "Bene sapit; liquamen est una e primis rebus acriter conditis quas in hac luna gustavi."

# game/a1s3.rpy:990
translate latin a1s3_c04a0ca5:

    # "Then Amicus comes back out, looking particularly fluffy."
    "Tum Amicus redit, pilis mirum in modum erectis ac mollibus."

# game/a1s3.rpy:991
translate latin a1s3_745d0131:

    # "I'm about to ask if he wants to get brushed, but he just falls back into his bed with a groan."
    "Iam rogaturus sum an pecti velit; ille autem cum gemitu in lectum se reicit."

# game/a1s3.rpy:993
translate latin a1s3_702cfbe4:

    # m "\"You alright?\""
    m "\"Valesne?\""

# game/a1s3.rpy:995
translate latin a1s3_408fcf67:

    # a "\"Never better.\""
    a "\"Numquam melius.\""

# game/a1s3.rpy:996
translate latin a1s3_5190711e:

    # "A few of the chopped peppers fall out of my wrap onto the sofa and I quickly pick them back up and set them on the cart."
    "Aliquot piperum concisorum frusta e pane convoluto in lectulum cadunt; celeriter ea colligo et in plaustro pono."

# game/a1s3.rpy:997
translate latin a1s3_3d041607:

    # m "\"This is actually really good; I was starting to worry that you guys didn't have food with actual flavor here. You know the country where you guys uplifted, Italy, it's known for its food.\""
    m "\"Hoc re vera optime sapit; iam sollicitus fieri incipiebam quod fortasse hic cibi sapidi vobis deessent. Scis regionem illam ubi incolas ad altiorem cultum evexistis, Italiam, cibis suis inclutam esse.\""

# game/a1s3.rpy:998
translate latin a1s3_eaa06e60:

    # m "\"Actually, before you uh, took me, I had this trip planned to go to Naples, which is a few hours outside of Rome, just to try the pizza...do you have pizza here?\""
    m "\"Re vera, antequam me, em, abstulisti, iter Neapolim paraveram; urbs paucas horas via a Roma abest. Eo tantum ibam ut placentam Neapolitanam gustarem...habetisne hic placentas Neapolitanas?\""

# game/a1s3.rpy:1000
translate latin a1s3_f80b7f81:

    # "Amicus gazes at me with a frown."
    "Amicus me fronte contracta intuetur."

# game/a1s3.rpy:1001
translate latin a1s3_6293a9bd:

    # "I wonder if he understood a single thing I said."
    "Mecum quaero an quidquam eorum quae dixi intellexerit."

# game/a1s3.rpy:1002
translate latin a1s3_d9aed1e7:

    # a "\"No.\""
    a "\"Non.\""

# game/a1s3.rpy:1003
translate latin a1s3_ab0b8c36:

    # m "\"Oh...well, it's sort of like this if I'd kept it flat and we baked it. Anyway, you want some?\""
    m "\"Oh...ergo, huic similis est si panem planum reliquissem atque in furno coxissem. Utut est, visne paulum?\""

# game/a1s3.rpy:1004
translate latin a1s3_62403c20:

    # "I hold up my wrap with a smile."
    "Panem convolutum tollo et arrideo."

# game/a1s3.rpy:1006
translate latin a1s3_2f8b3961:

    # "Amicus glares."
    "Amicus me torve aspicit."

# game/a1s3.rpy:1007
translate latin a1s3_9fca7eb8:

    # a "\"I just had my guts squashed flatter than that flatbread and you're assuming I still have an appetite?\""
    a "\"Modo viscera mea hoc pane plano planiora compressa sunt, et tu putas me adhuc appetentiam cibi habere?\""

# game/a1s3.rpy:1008
translate latin a1s3_a0a3368d:

    # "I quickly lower it."
    "Celeriter eum demitto."

# game/a1s3.rpy:1009
translate latin a1s3_11e67e6b:

    # m "\"Oh yeah, sorry.\""
    m "\"Oh, ita; ignosce.\""

# game/a1s3.rpy:1011
translate latin a1s3_b1ad0265:

    # "Amicus goes on staring at the ceiling while I nibble on the food, though I'm not really all that hungry anymore."
    "Amicus lacunar aspicere pergit, dum ego cibum paulatim mordeo; iam tamen non admodum esurio."

# game/a1s3.rpy:1012
translate latin a1s3_3207e293:

    # "Then Amicus sighs deeply, covering his face with his paws."
    "Tum Amicus alte suspirat et vultum manibus operit."

# game/a1s3.rpy:1014
translate latin a1s3_bced20e2:

    # a "\"I'm...sorry. I've just been thinking a lot is all.\""
    a "\"Ego...ignosce. Multa tantum animo volvebam.\""

# game/a1s3.rpy:1015
translate latin a1s3_736e45ce:

    # m "\"...About?\""
    m "\"...De quibus?\""

# game/a1s3.rpy:1016
translate latin a1s3_c8798544:

    # "Amicus just shakes his head, continuing to rub his brow."
    "Amicus tantum caput quatit et frontem fricare pergit."

# game/a1s3.rpy:1017
translate latin a1s3_2cb76928:

    # a "\"Well, how sore I am, for one.\""
    a "\"De eo, inter alia, quantum doleam.\""

# game/a1s3.rpy:1018
translate latin a1s3_9d5ead88:

    # "I look over at the wolf, then remember what he'd said last night, about the massage."
    "Lupum aspicio, deinde memini quid heri noctu de frictione dixerit."

# game/a1s3.rpy:1019
translate latin a1s3_ddb454f1:

    # "I think about it for a moment."
    "Paulisper hoc considero."

# game/a1s3.rpy:1020
translate latin a1s3_f08a536a:

    # "Amicus {i}has{/i} been trying to make me as comfortable as possible throughout the few days I've been here...minus the sofa."
    "Amicus per paucos dies quibus hic fui {i}certe{/i} conatus est ut quam commodissime me haberem...lectulo excepto."

# game/a1s3.rpy:1021
translate latin a1s3_21bb763d:

    # "I kinda feel like I owe it to him."
    "Quodammodo sentio me hoc ei debere."

# game/a1s3.rpy:1022
translate latin a1s3_6bdb9c7e:

    # m "\"You want a massage?\""
    m "\"Visne ut te perfricem?\""

# game/a1s3.rpy:1024
translate latin a1s3_d186e8fc:

    # "I see Amicus freeze up, his face still covered with his paws until he finally lowers them, his expression almost comical."
    "Amicum subito rigescere video, vultu adhuc manibus obtecto, donec tandem eas demittit; vultus eius paene ridiculus est."

# game/a1s3.rpy:1025
translate latin a1s3_3c8805f7:

    # a "\"What?\""
    a "\"Quid?\""

# game/a1s3.rpy:1026
translate latin a1s3_03e7b0ae:

    # "I feel myself turning red."
    "Sentio me erubescere."

# game/a1s3.rpy:1027
translate latin a1s3_a57f8de0:

    # m "\"I asked if you want a massage.\""
    m "\"Rogavi an velles ut te perfricarem.\""

# game/a1s3.rpy:1029
translate latin a1s3_85a29171:

    # a "\"I thought you didn't want to.\""
    a "\"Putabam te nolle.\""

# game/a1s3.rpy:1030
translate latin a1s3_37d0cf45:

    # m "\"Well, I never really gave you an answer, did I?\""
    m "\"At numquam tibi re vera respondi, nonne?\""

# game/a1s3.rpy:1031
translate latin a1s3_d72b6cc7:

    # "Amicus narrows his eyes."
    "Amicus oculos contrahit."

# game/a1s3.rpy:1033
translate latin a1s3_6cccea73:

    # a "\"I don't want to force you into something you don't want to do.\""
    a "\"Nolo te ad id cogere quod facere non vis.\""

# game/a1s3.rpy:1034
translate latin a1s3_e5c0d4a9:

    # m "\"Well I'm offering, but if you don't want it...\""
    m "\"At me ultro offero; sed si non vis...\""

# game/a1s3.rpy:1035
translate latin a1s3_a030b796:

    # "I start to sit back down."
    "Rursus considere incipio."

# game/a1s3.rpy:1036
translate latin a1s3_dba88776:

    # "Amicus's ears fall flat."
    "Aures Amici demittuntur."

# game/a1s3.rpy:1038
translate latin a1s3_4a1c44d7:

    # a "\"No, no, please do.\""
    a "\"Non, non; quaeso, fac.\""

# game/a1s3.rpy:1039
translate latin a1s3_08106cc9:

    # "I try to hide my smile as I get back up and approach the bed."
    "Risum celare conor, dum rursus surgo et ad lectum accedo."

# game/a1s3.rpy:1040
translate latin a1s3_003a059c:

    # "Amicus just sort of watches me, half-sitting up."
    "Amicus me tantum observat, corpore semierecto."

# game/a1s3.rpy:1041
translate latin a1s3_b6ea62b7:

    # "Once I get to the edge of the bed, I pause."
    "Cum ad marginem lecti pervenio, consisto."

# game/a1s3.rpy:1042
translate latin a1s3_f93353de:

    # m "\"Umm, so what do I do?\""
    m "\"Em, quid igitur faciam?\""

# game/a1s3.rpy:1044
translate latin a1s3_b9e01f02:

    # a "\"Oh, uh...\""
    a "\"Oh, em...\""

# game/a1s3.rpy:1045
translate latin a1s3_57555863:

    # "Amicus rolls over onto his front."
    "Amicus se vertit ut pronus iaceat."

# game/a1s3.rpy:1047
translate latin a1s3_f78bdd28:

    # a "\"Well, honestly I don't really know how it's {i}supposed{/i} to be done, but you could start with some...light rubbing.\""
    a "\"Sane, re vera nescio quomodo hoc {i}recte{/i} faciendum sit; sed incipere potes...leniter fricando.\""

# game/a1s3.rpy:1048
translate latin a1s3_00c92f27:

    # "Cautiously, I get up onto the bed on my knees, trying not to get tangled up in my robe as I scoot closer."
    "Caute genibus in lectum ascendo, cavens ne tunica implicer, dum propius me moveo."

# game/a1s3.rpy:1049
translate latin a1s3_e84cc513:

    # "Tentatively, I reach out and touch the wolf's back."
    "Cunctanter manum porrigo et tergum lupi tango."

# game/a1s3.rpy:1050
translate latin a1s3_f5c85f92:

    # "Amicus inhales gently, his back rising against my fingers."
    "Amicus leniter spiritum ducit; tergum eius ad digitos meos surgit."

# game/a1s3.rpy:1051
translate latin a1s3_4aef78e2:

    # "Then, slowly, I start to massage, starting on his thick neck before slowly rubbing my way down."
    "Deinde lente perfricare incipio, a crasso collo eius orsus, et paulatim deorsum frico."

# game/a1s3.rpy:1052
translate latin a1s3_823acc36:

    # "I don't know the first thing about massaging, so I just do what feels natural, and Amicus seems to like it."
    "De arte frictionis nihil omnino scio; tantum facio quod natura suadere videtur, et Amico id placere videtur."

# game/a1s3.rpy:1053
translate latin a1s3_ca73ca54:

    # "When I reach his mid-back, he grunts."
    "Cum ad medium tergum pervenio, grunnit."

# game/a1s3.rpy:1055
translate latin a1s3_b28e4eae:

    # a "\"Little more gentle there. Got scraped on the stairs.\""
    a "\"Ibi paulo lenius. In gradibus cutis mihi abrasa est.\""

# game/a1s3.rpy:1056
translate latin a1s3_e72c4b6f:

    # "I pause, then tease through the fur a bit and find a small, fresh scab, right on Amicus's spine."
    "Consisto, deinde pilos paulum diduco et parvam crustam recentem recta in spina Amici invenio."

# game/a1s3.rpy:1057
translate latin a1s3_b7818439:

    # "I pet the fur back down before moving past it, working my thumbs into the muscles on either side of the wolf's spine."
    "Pilos rursus leniter deprimo, deinde locum illum praetereo et pollices in musculos utrimque iuxta spinam lupi premo."

# game/a1s3.rpy:1058
translate latin a1s3_6444435b:

    # m "\"Cato's an asshole.\""
    m "\"Cato improbus est.\""

# game/a1s3.rpy:1060
translate latin a1s3_c88a54db:

    # "Amicus lets out a choked cough of surprise."
    "Amicus stupore tussim interclusam edit."

# game/a1s3.rpy:1062
translate latin a1s3_7b4efb6e:

    # a "\"[mc]! Don't say that! He's the acting emperor.\""
    a "\"[mc]! Noli hoc dicere! Imperatoris vicem gerit.\""

# game/a1s3.rpy:1063
translate latin a1s3_dee421ac:

    # m "\"Well, he is.\""
    m "\"At certe improbus est.\""

# game/a1s3.rpy:1064
translate latin a1s3_67a58621:

    # a "\"If you must say it, at least keep your voice down. I swear, Cassius sometimes has his ear pressed to my doo-aaaaah...\""
    a "\"Si hoc dicere debes, saltem submissius loquere. Iuro Cassium interdum aurem premere ad ostium me-aaaaah...\""

# game/a1s3.rpy:1066
translate latin a1s3_ddf22c45:

    # "Amicus moans as I start on his neck again and press harder than I had last time, really sinking into the muscle."
    "Amicus gemit, dum collo eius rursus incipio et vehementius quam prius premo, penitus in musculum digitos mergens."

# game/a1s3.rpy:1067
translate latin a1s3_4aa70756:

    # "The wolf's body melts into the bed and I grin with satisfaction as I keep up the pressure down the rest of his back."
    "Corpus lupi laxatum in lectum subsidit; laetus arrideo, dum eadem vi per reliquum tergum deorsum premo."

# game/a1s3.rpy:1068
translate latin a1s3_158ec1eb:

    # "It would be easier if I were straddling him, but I don't know how I feel about doing that just yet."
    "Facilius esset si eum cruribus utrimque positis insederem; nondum tamen scio an id facere mihi placeat."

# game/a1s3.rpy:1069
translate latin a1s3_57438d7c:

    # "Amicus is quiet for a few minutes while I work, then he sighs."
    "Amicus aliquot minuta tacet dum operam do, deinde suspirat."

# game/a1s3.rpy:1071
translate latin a1s3_5532e1d1:

    # a "\"He was right though. I still act like a pup. I need to be more serious.\""
    a "\"Ille tamen recte dixit. Adhuc quasi catulus me gero. Mihi graviori esse necesse est.\""

# game/a1s3.rpy:1072
translate latin a1s3_e499761a_2:

    # "I frown."
    "Frontem contraho."

# game/a1s3.rpy:1073
translate latin a1s3_9d3344cb:

    # m "\"What do you mean?\""
    m "\"Quid dicis?\""

# game/a1s3.rpy:1074
translate latin a1s3_044069f7:

    # a "\"Cato had every right to beat me. I haven't been acting very much like an emperor lately.\""
    a "\"Cato pleno iure me verberavit. Nuper non admodum ut imperator me gessi.\""

# game/a1s3.rpy:1075
translate latin a1s3_6a20a80d_1:

    # "I shake my head."
    "Caput quatio."

# game/a1s3.rpy:1076
translate latin a1s3_3461c9bf:

    # m "\"First of all, no one should be beaten. Second, Cassius acts like a child...or pup. I mean, you might sometimes act a little immature, but he's a brat. You're fine if he's the one you're competing with.\""
    m "\"Primum, nemo verberandus est. Deinde, Cassius quasi puer...vel catulus se gerit. Dico te interdum paulo immaturum videri; ille autem puer insolens est. Bene tibi est, si cum illo contendis.\""

# game/a1s3.rpy:1077
translate latin a1s3_c24fd540:

    # m "\"Besides, you're a lot of fun to be around. If I were a wolf, I would think it's pretty cool to have an emperor as nice and fun as you are.\""
    m "\"Praeterea pergratum est tecum esse. Si lupus essem, pulchrum mihi videretur imperatorem tam benignum et iucundum quam te habere.\""

# game/a1s3.rpy:1079
translate latin a1s3_950e85cf:

    # a "\"Oh really?\""
    a "\"Itane vero?\""

# game/a1s3.rpy:1081
translate latin a1s3_996cbad6:

    # a "\"Then I suppose things are different here. I forgot myself at the lake today, and when Cato caught me teasing you...\""
    a "\"Ergo puto res hic aliter se habere. Hodie apud lacum mei oblitus sum; et cum Cato me te ludentem deprehendit...\""

# game/a1s3.rpy:1083
translate latin a1s3_b598e920:

    # "Amicus presses his face into the pillow, cringing."
    "Amicus vultum in cervical premit, pudore se contrahens."

# game/a1s3.rpy:1084
translate latin a1s3_a44466bc:

    # m "\"Can you not have fun as the prospective emperor?\""
    m "\"Nonne potes te oblectare cum imperator futurus sis?\""

# game/a1s3.rpy:1086
translate latin a1s3_01975de2:

    # a "\"Not really...Cassius hasn't been out in the lake for years. Sometimes I think something is wrong with me, that I still enjoy such things.\""
    a "\"Vix...Cassius iam multos annos ad lacum non venit. Interdum puto aliquid mihi deesse, quod talia adhuc amo.\""

# game/a1s3.rpy:1087
translate latin a1s3_a28731d1:

    # "I think, trying to decide whether my opinion is worth anything on this alien moon."
    "Cogito, conans decernere an sententia mea quidquam in hac luna aliena valeat."

# game/a1s3.rpy:1088
translate latin a1s3_1ebb9d48:

    # m "\"Well, I don't think so. People our age on Earth do way dumber stuff to have fun and it's considered normal. Even when you get older you're expected to do things you enjoy.\""
    m "\"Ego non puto. In Terra homines aetatis nostrae multo stultiora faciunt ut se oblectent, et hoc usitatum habetur. Etiam cum aetate provectior es, exspectatur ut ea facias quibus delecteris.\""

# game/a1s3.rpy:1089
translate latin a1s3_eea311ca:

    # m "\"Otherwise what's the point of life? We're only here for a moment before we die and that's it.\""
    m "\"Alioquin quorsum vita pertinet? Momento tantum hic sumus, deinde morimur et omnia finita sunt.\""

# game/a1s3.rpy:1090
translate latin a1s3_3acbffc8:

    # "I can't help but feel that my argument is a bit amateurish."
    "Non possum non sentire rationem meam paulo imperitam esse."

# game/a1s3.rpy:1091
translate latin a1s3_4889be37:

    # "Amicus doesn't seem convinced either."
    "Amicus quoque persuasus esse non videtur."

# game/a1s3.rpy:1092
translate latin a1s3_7797cb03:

    # a "\"Well, first of all the point of my life is to lead my people to a better future. Secondly, we become one with the parents when we die.\""
    a "\"Primum, finis vitae meae est populum meum ad meliorem condicionem futuram ducere. Deinde, cum morimur, unum cum Parentibus efficimur.\""

# game/a1s3.rpy:1093
translate latin a1s3_e499761a_3:

    # "I frown."
    "Frontem contraho."

# game/a1s3.rpy:1094
translate latin a1s3_81d6399a:

    # m "\"Become one? What, do they...absorb your soul, or something?\""
    m "\"Unum efficimini? Quid, illi...animam vestram absorbent, aut aliquid simile?\""

# game/a1s3.rpy:1095
translate latin a1s3_a3cd140c:

    # "I stifle my chuckle when I see that Amicus is still very serious."
    "Risum cohibeo cum Amicum adhuc gravissimum esse video."

# game/a1s3.rpy:1096
translate latin a1s3_c76da010:

    # a "\"No, well, I don't know, but our consciousness joins theirs and we go on to spread throughout the universe together.\""
    a "\"Non, immo, nescio; sed mens nostra eorum mentibus iungitur, et postea per universum una diffundimur.\""

# game/a1s3.rpy:1097
translate latin a1s3_cfaf8b4b:

    # m "\"Huh, is there...proof of this? Did they say that's what happens?\""
    m "\"Hem, suntne huius...argumenta? Dixeruntne hoc accidere?\""

# game/a1s3.rpy:1098
translate latin a1s3_d098c481:

    # a "\"Of course.\""
    a "\"Certe.\""

# game/a1s3.rpy:1099
translate latin a1s3_90449f37:

    # "I think of questioning him further, but right now I'm not really in the mood to debate anything religious with this wolf."
    "Cogito eum plura rogare; nunc tamen non admodum mihi libet de religione cum hoc lupo disputare."

# game/a1s3.rpy:1100
translate latin a1s3_45db9ce8:

    # "His mind seems to be on the \"having fun\" issue anyway."
    "Animus eius ad rem \"se oblectandi\" intentus esse videtur."

# game/a1s3.rpy:1101
translate latin a1s3_2920a5ea:

    # m "\"Well, I will say that Roman emperors on Earth had a lot of fun.\""
    m "\"Hoc tamen dicam: in Terra imperatores Romani se multum oblectabant.\""

# game/a1s3.rpy:1102
translate latin a1s3_e33f02ef_2:

    # "I laugh."
    "Rideo."

# game/a1s3.rpy:1103
translate latin a1s3_42ac20de:

    # m "\"There was an emperor named Elagabalus that didn't really give a shit about what the people thought of him. He had all the fun and sex he wanted.\""
    m "\"Erat imperator nomine Elagabalus, qui minime curabat quid populus de se sentiret. Quantum volebat voluptatibus et concubitu fruebatur.\""

# game/a1s3.rpy:1105
translate latin a1s3_c8caa8fc:

    # a "\"Oh?\""
    a "\"O?\""

# game/a1s3.rpy:1106
translate latin a1s3_38e17d1f:

    # "Amicus sounds amused."
    "Amicus oblectari videtur."

# game/a1s3.rpy:1107
translate latin a1s3_414a9227:

    # "Then I wince, remembering that no one really liked Elagabalus and he was killed along with his male lover, then his beheaded body was dragged through the streets of Rome..."
    "Tum vultum contraho, memor neminem fere Elagabalum amavisse eumque una cum amante suo viro interfectum esse; deinde corpus eius capite truncatum per vias Romae tractum esse..."

# game/a1s3.rpy:1108
translate latin a1s3_2d896667:

    # m "\"Well...I think balance is a good thing to have in life. Be serious when you need to be, have fun when you can.\""
    m "\"Ergo...puto modum in vita bonum esse. Gravis esto cum necesse est; te oblecta cum potes.\""

# game/a1s3.rpy:1109
translate latin a1s3_4bfc8e95:

    # "Amicus just grunts again and I go on rubbing for a while longer."
    "Amicus tantum rursus grunnit, et ego paulo diutius fricare pergo."

# game/a1s3.rpy:1111
translate latin a1s3_92e768ab:

    # a "\"Oh! So while I was at my studies I had some time in the library to myself.\""
    a "\"Oh! Dum studiis meis operam dabam, paulisper solus in bibliotheca esse potui.\""

# game/a1s3.rpy:1113
translate latin a1s3_3302ded6:

    # a "\"I found this primate species in the...general vicinity of your star.\""
    a "\"Inveni hanc speciem primatum in...regione satis propinqua astro tuo.\""

# game/a1s3.rpy:1114
translate latin a1s3_05631a1a:

    # a "\"They were part of a failed uplift and look generally similar to you. A lot hairier, but I don't think anyone will notice.\""
    a "\"Eos ad altiorem cultum evehere conati sunt, sed conatus frustra fuit; fere similes tibi sunt. Multo pilosiores, sed non puto quemquam id animadversurum esse.\""

# game/a1s3.rpy:1115
translate latin a1s3_b0d23cf0:

    # a "\"The name they have for themselves isn't pronounceable by us, but we named them the {i}Simanians{/i}, so if anyone asks you what you are, tell them that.\""
    a "\"Nomen quo se appellant a nobis pronuntiari non potest; nos autem eos {i}Simianos{/i} nominavimus. Si igitur quis roget quid sis, hoc ei dic.\""

# game/a1s3.rpy:1116
translate latin a1s3_ac7e79cb:

    # m "\"Oh, okay.\""
    m "\"Oh, bene.\""

# game/a1s3.rpy:1117
translate latin a1s3_232fa72d:

    # "I repeat the word in my head, trying to memorize it."
    "Verbum animo repeto, ut memoriae mandem."

# game/a1s3.rpy:1119
translate latin a1s3_c01e0238:

    # a "\"Also...I would recommend avoiding that Khemian. I didn't like the looks of him.\""
    a "\"Praeterea...tibi suadeo ut illum Khemium vites. Species eius mihi non placuit.\""

# game/a1s3.rpy:1120
translate latin a1s3_2558be92:

    # m "\"Why not?\""
    m "\"Cur non?\""

# game/a1s3.rpy:1121
translate latin a1s3_e79a60ab:

    # a "\"I don't know, but his demeanor was rather rude. I've heard they are an arrogant people, but to see it in person...\""
    a "\"Nescio; se tamen satis inurbane gerebat. Audivi eos populum superbum esse; sed hoc ipsum coram videre...\""

# game/a1s3.rpy:1122
translate latin a1s3_f5568cd1:

    # "I almost laugh at the hypocrisy of that statement."
    "Paene rideo, cum ipsa Amici dicta moribus eius contradicant."

# game/a1s3.rpy:1123
translate latin a1s3_d2b8fab3:

    # "I'd point it out if Amicus wasn't being so grumpy right now."
    "Hoc indicarem si Amicus nunc tam morosus non esset."

# game/a1s3.rpy:1124
translate latin a1s3_c777a4c4:

    # a "\"And the way he looked at you didn't sit well with me. Just be sure you watch out for him.\""
    a "\"Et quo modo te aspexit mihi non placuit. Cura tantum ut ab eo caveas.\""

# game/a1s3.rpy:1125
translate latin a1s3_3c66ec5c:

    # "I didn't really see much of a difference bewteen Neferu and the wolves aside from appearance, but Amicus seems genuinely concerned."
    "Non re vera multum discriminis inter Neferu et lupos vidi, praeter speciem; Amicus tamen vere sollicitus videtur."

# game/a1s3.rpy:1126
translate latin a1s3_6f19d038_1:

    # m "\"Alright.\""
    m "\"Bene.\""

# game/a1s3.rpy:1128
translate latin a1s3_be4fc48b:

    # "Amicus grunts in response and I go on rubbing for a little while longer."
    "Amicus respondens grunnit et ego paulo diutius fricare pergo."

# game/a1s3.rpy:1130
translate latin a1s3_39d6f820:

    # "Then Amicus rolls over."
    "Tum Amicus se vertit."

# game/a1s3.rpy:1131
translate latin a1s3_17799653:

    # "I pause."
    "Consisto."

# game/a1s3.rpy:1132
translate latin a1s3_511a7243:

    # m "\"Um...\""
    m "\"Ehm...\""

# game/a1s3.rpy:1133
translate latin a1s3_872229c1:

    # "Amicus suddenly opens his eyes, as if realizing what he's doing."
    "Amicus repente oculos aperit, quasi intellegens quid faciat."

# game/a1s3.rpy:1135
translate latin a1s3_ed2bac03:

    # a "\"Oh! Er...\""
    a "\"Oh! Em...\""

# game/a1s3.rpy:1136
translate latin a1s3_ce2a4a7c:

    # m "\"Do I...do your front too?\""
    m "\"Etiam...etiam anteriorem corporis tui partem fricem?\""

# game/a1s3.rpy:1137
translate latin a1s3_a4af12ec:

    # a "\"Well...often after I get my massage, my drone rubs me. It helps me fall asleep for my afternoon naps.\""
    a "\"Sane...saepe post frictionem automaton meum me fricat. Hoc me adiuvat ut ad meridianum somnum obdormiscam.\""

# game/a1s3.rpy:1138
translate latin a1s3_4a0e706d:

    # m "\"Rubs you where?\""
    m "\"Qua parte te fricat?\""

# game/a1s3.rpy:1139
translate latin a1s3_3a20dfd9:

    # "Amicus's ears turn bright red."
    "Aures Amici valde rubescunt."

# game/a1s3.rpy:1140
translate latin a1s3_163eb697:

    # a "\"My...my belly.\""
    a "\"Ventrem...ventrem meum.\""

# game/a1s3.rpy:1141
translate latin a1s3_e33f02ef_3:

    # "I laugh."
    "Rideo."

# game/a1s3.rpy:1143
translate latin a1s3_7927aacc:

    # a "\"Don't laugh! You're the one that wanted to know.\""
    a "\"Noli ridere! Tu scire voluisti.\""

# game/a1s3.rpy:1144
translate latin a1s3_0a04ef9c:

    # "I hesitate, and then almost automatically, my hand reaches out and starts to rub."
    "Cunctor; deinde paene sua sponte manus mea porrigitur et fricare incipit."

# game/a1s3.rpy:1146
translate latin a1s3_88d0d125:

    # "Amicus is tense at first, then starts to relax, the blush in his ears receding."
    "Amicus primo intentus est, deinde se relaxare incipit; rubor aurium minuitur."

# game/a1s3.rpy:1147
translate latin a1s3_9a21a419:

    # m "\"You're such a canine.\""
    m "\"Tam caninus es.\""

# game/a1s3.rpy:1149
translate latin a1s3_7b7bc8ca:

    # a "\"I am a canine.\""
    a "\"Canis sum.\""

# game/a1s3.rpy:1151
translate latin a1s3_f0a3e485:

    # "The fur, fluffy and disheveled from the shower, smooths down against the wolf's thick stomach, his belly rising and falling against my hand."
    "Pili, post imbrem erecti et inordinati, in crassum ventrem lupi complanantur; venter sub manu mea surgit ac subsidit."

# game/a1s3.rpy:1152
translate latin a1s3_de3be73b:

    # "In his relaxed state, his stomach is soft under the fur, and I press down a bit more firmly to really rub at it."
    "Cum ita relaxatus sit, venter eius sub pilis mollis est; paulo firmius premo ut eum penitus fricem."

# game/a1s3.rpy:1153
translate latin a1s3_fc1a784e:

    # "Amicus grunts and winces a bit."
    "Amicus grunnit et vultum paulum dolore contrahit."

# game/a1s3.rpy:1154
translate latin a1s3_7621d92c:

    # m "\"Too hard?\""
    m "\"Nimis firmiter?\""

# game/a1s3.rpy:1155
translate latin a1s3_f0b82ba4:

    # a "\"Just sore, but keep going; it feels good.\""
    a "\"Tantum doleo; sed perge. Iucundum est.\""

# game/a1s3.rpy:1156
translate latin a1s3_481a208b:

    # "As I continue to rub, his eyes close and his muzzle parts slightly."
    "Dum fricare pergo, oculi eius clauduntur et rostrum paulo aperitur."

# game/a1s3.rpy:1157
translate latin a1s3_138016c8:

    # m "\"Soooo...the trials start soon, at the end of this month, I guess?\""
    m "\"Itaqueee...certamina mox incipiunt, exeunte hoc mense, ut puto?\""

# game/a1s3.rpy:1158
translate latin a1s3_4eb44ffd:

    # a "\"...Yes.\""
    a "\"...Ita.\""

# game/a1s3.rpy:1159
translate latin a1s3_5e42ba62:

    # m "\"And I'm involved in it somehow?\""
    m "\"Et ego aliquo modo participo?\""

# game/a1s3.rpy:1160
translate latin a1s3_ff59f998:

    # a "\"Mmmmh...\""
    a "\"Mmmmh...\""

# game/a1s3.rpy:1161
translate latin a1s3_da75757c:

    # m "\"Wanna talk about it later?\""
    m "\"Visne postea de hoc loqui?\""

# game/a1s3.rpy:1162
translate latin a1s3_8e3323ca:

    # a "\"Mmh.\""
    a "\"Mmh.\""

# game/a1s3.rpy:1163
translate latin a1s3_9cea7ff8:

    # "Now that I'm thinking about it, I'm getting a bit nervous."
    "Iam, cum hoc considero, paulo sollicitior fio."

# game/a1s3.rpy:1164
translate latin a1s3_abd25d4b:

    # "But Amicus doesn't seem to be worried, and that puts me at ease, at least a little bit."
    "Amicus autem sollicitus esse non videtur; hoc me placat, saltem paulum."

# game/a1s3.rpy:1165
translate latin a1s3_3341b434:

    # "That's when I notice the particular bulge in Amicus's undergarments, the one I'd noticed when I'd brushed him yesterday."
    "Tum illum singularem tumorem in vestimento interiore Amici animadverto, quem heri dum eum pectebam videram."

# game/a1s3.rpy:1166
translate latin a1s3_645e4ea6:

    # "I'm not surprised this time, though."
    "Hac vice tamen non miror."

# game/a1s3.rpy:1167
translate latin a1s3_865525cb:

    # "If brushing had done it to him, rubbing definitely would too."
    "Si pecti hoc effecerat, certe fricari quoque idem efficeret."

# game/a1s3.rpy:1168
translate latin a1s3_568d8688:

    # "So I ignore it and so does Amicus, or maybe he's just asleep."
    "Itaque eum neglego; Amicus quoque eum neglegit, vel fortasse iam dormit."

# game/a1s3.rpy:1169
translate latin a1s3_ff7c2a12:

    # "I realize then just how much I've accepted my life here, rubbing this prospective emperor wolf's belly, even though I know it's making him hard."
    "Tum intellego quantum vitam meam hic acceperim: ventrem huius lupi imperatoris futuri frico, quamquam scio hoc mentulam eius erigere."

# game/a1s3.rpy:1170
translate latin a1s3_dca415aa:

    # "But I also realize that I don't really mind it."
    "Sed etiam intellego me hoc non re vera moleste ferre."

# game/a1s3.rpy:1172
translate latin a1s3_b537565d:

    # "It's only been a few days, but there's something about this wolf..."
    "Pauci tantum dies praeterierunt; tamen aliquid in hoc lupo est..."

# game/a1s3.rpy:1173
translate latin a1s3_814740fe:

    # "I don't know, I just like him."
    "Nescio; tantum mihi placet."

# game/a1s3.rpy:1174
translate latin a1s3_f43c02f1:

    # "Amicus starts to snore, so I slowly stop rubbing, watching his chest rise and fall with his steady breaths."
    "Amicus stertere incipit; itaque lente fricare desino, pectus eius placidis respirationibus surgens ac subsidens observans."

# game/a1s3.rpy:1175
translate latin a1s3_5928aaed:

    # "I think about going back over to the sofa, but instead I just roll over to Amicus's left, curling up on my side in the soft pillows."
    "Cogito ad lectulum redire; sed potius ad sinistram Amici me verto et inter mollia cervicalia in latus me contraho."

# game/a1s3.rpy:1176
translate latin a1s3_c5db41d8:

    # "With the relaxing sounds of Amicus's gentle snores behind me, I drift off into a light sleep."
    "Lenibus Amici stertentis sonis post me animum mulcentibus, in levem somnum delabor."

translate latin strings:

    # a1s3.rpy:388
    old "When in Rome..."
    new "Cum Romae..."

    # a1s3.rpy:388
    old "Don't look."
    new "Noli aspicere."

