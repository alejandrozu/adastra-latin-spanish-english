
# game/a1s6.rpy:3
translate latin a1s6_3a6e1507:

    # "A few minutes later, Amicus is flat on his stomach, looking under his bed as he mumbles something under his breath."
    "Paucis minutis post, Amicus pronus iacet et sub lectum spectat, aliquid submissa voce murmurans."

# game/a1s6.rpy:4
translate latin a1s6_20ae193c:

    # "I stand awkwardly off to the side, watching as he sweeps a paw underneath, as if feeling for something."
    "E latere incomposite sto et specto dum manum sub lecto circumducit, quasi aliquid tactu quaerat."

# game/a1s6.rpy:5
translate latin a1s6_9e2304d6:

    # m "\"What are you doing?\""
    m "\"Quid agis?\""

# game/a1s6.rpy:6
translate latin a1s6_263132eb:

    # "Amicus grunts as he gets to his knees, then stands up, looking up at the ceiling as he turns in a slow circle."
    "Amicus gemit dum primum in genua se erigit, deinde surgit; ad laquear suspiciens, lente in orbem vertitur."

# game/a1s6.rpy:8
translate latin a1s6_d1591564:

    # a "\"Looking for whatever Cass might have been doing.\""
    a "\"Quaero quidquid Cassius hic agere potuit.\""

# game/a1s6.rpy:9
translate latin a1s6_8ca1e6dd:

    # m "\"You know what he was doing?\""
    m "\"Scis quid egerit?\""

# game/a1s6.rpy:10
translate latin a1s6_d8934f73:

    # a "\"I have my suspicions.\""
    a "\"Quaedam suspicor.\""

# game/a1s6.rpy:11
translate latin a1s6_4c5ddf2d:

    # m "\"Which are?\""
    m "\"Quae?\""

# game/a1s6.rpy:12
translate latin a1s6_7a40d4b1:

    # "Amicus stops his turning and looks at me, folding his arms."
    "Amicus se vertere desinit et, bracchiis complicatis, me spectat."

# game/a1s6.rpy:13
translate latin a1s6_66732799:

    # a "\"Well, I'm not sure, but a recording device possibly, or he was just snooping for information.\""
    a "\"Non certo scio, sed fortasse instrumentum ad res gestas memorandas posuit, aut indicia tantum curiosius quaerebat.\""

# game/a1s6.rpy:14
translate latin a1s6_5ba3bb5d:

    # m "\"Can we just ask Com?\""
    m "\"Possumusne Computatrum simpliciter interrogare?\""

# game/a1s6.rpy:15
translate latin a1s6_814397fc:

    # a "\"No, his capabilities are very limited despite what his intelligence might suggest. He doesn't record our activities specifically so we can't spy on each other; rules put in place millennia ago.\""
    a "\"Non; facultates eius valde finitae sunt, quamvis intellegentia aliud suadere videatur. Res nostras consulto non memorat, ne alter alterum occulte observare possimus; hae leges ante multa annorum milia constitutae sunt.\""

# game/a1s6.rpy:16
translate latin a1s6_48d777f6:

    # "I sigh and look at the door, still feeling a little shaken up at what had just happened."
    "Suspiro et ianuam specto, adhuc paulum commotus iis quae modo evenerunt."

# game/a1s6.rpy:17
translate latin a1s6_64f68652:

    # m "\"Why can't you lock the door, or something?\""
    m "\"Cur ianuam obserare non potes, vel aliquid simile facere?\""

# game/a1s6.rpy:18
translate latin a1s6_f887bb98:

    # "Amicus shrugs."
    "Amicus umeros tollit."

# game/a1s6.rpy:20
translate latin a1s6_56fdbcd1:

    # a "\"That's something only the emperor can do. Again, rules that have been in place for a very long time.\""
    a "\"Id solum imperatori licet. Hae quoque leges iam diutissime valent.\""

# game/a1s6.rpy:21
translate latin a1s6_cf52434f:

    # m "\"That doesn't seem safe.\""
    m "\"Id parum tutum videtur.\""

# game/a1s6.rpy:22
translate latin a1s6_a47bf672:

    # a "\"Well, only the most trusted are allowed in the palace after all, which tends to only be family.\""
    a "\"Postremo, soli fidissimi in palatium admittuntur; plerumque hi propinqui tantum sunt.\""

# game/a1s6.rpy:23
translate latin a1s6_cc4e28c1:

    # m "\"Aside from Neferu.\""
    m "\"Praeter Neferum.\""

# game/a1s6.rpy:24
translate latin a1s6_25de02e8:

    # a "\"Aside from him, yes.\""
    a "\"Praeter eum, ita.\""

# game/a1s6.rpy:25
translate latin a1s6_eeeb5dcd:

    # m "\"You don't have much freedom for being the emperor's son.\""
    m "\"Imperatoris filius es, nec tamen multam libertatem habes.\""

# game/a1s6.rpy:27
translate latin a1s6_c67a5700:

    # a "\"You just noticed?\""
    a "\"Id nunc demum animadvertisti?\""

# game/a1s6.rpy:29
translate latin a1s6_5286e5a6:

    # "Amicus huffs and stands in the middle of the room, his arms folded, a deep frown on his face."
    "Amicus fremit et in medio cubiculo stat, bracchiis complicatis, fronte vehementer contracta."

# game/a1s6.rpy:30
translate latin a1s6_2291e871:

    # m "\"He was probably just trying to find out what you're planning for the next trial. We know some stuff about him already.\""
    m "\"Probabiliter tantum scire conabatur quid ad proximum certamen paraveris. Nos iam quaedam de eo scimus.\""

# game/a1s6.rpy:31
translate latin a1s6_8e3323ca:

    # a "\"Mmh.\""
    a "\"Mmh.\""

# game/a1s6.rpy:32
translate latin a1s6_3ff385b0:

    # "Amicus continues to look concerned."
    "Amicus sollicitus esse pergit."

# game/a1s6.rpy:33
translate latin a1s6_3ffe5d76:

    # m "\"What is it?\""
    m "\"Quid est?\""

# game/a1s6.rpy:34
translate latin a1s6_7c164a26:

    # a "\"I just...\""
    a "\"Ego tantum...\""

# game/a1s6.rpy:35
translate latin a1s6_dcfb9068:

    # "Amicus lowers his voice."
    "Amicus vocem submittit."

# game/a1s6.rpy:37
translate latin a1s6_56496167:

    # a "\"..worry it might have something to do with you. After what he said as he was leaving...it's left me uneasy, is all.\""
    a "\"..vereor ne res ad te pertineat. Quae enim abiens dixit...me inquietum reliquerunt, nihil aliud.\""

# game/a1s6.rpy:38
translate latin a1s6_12af59b2:

    # "Oh yeah, that thing about executing me."
    "Ah, ita: quod de me interficiendo dixit."

# game/a1s6.rpy:39
translate latin a1s6_35886d5e:

    # "I haven't had time to think about the possibility of someone on the verge of near-absolute power wanting me dead yet."
    "Nondum tempus habui cogitandi aliquem, qui paene summam potestatem adepturus sit, mortem meam fortasse cupere."

# game/a1s6.rpy:40
translate latin a1s6_1b754e41:

    # m "\"Do you think he was serious?\""
    m "\"Putasne eum serio dixisse?\""

# game/a1s6.rpy:41
translate latin a1s6_11ad0c3f:

    # "Amicus is quiet for a moment."
    "Amicus paulisper tacet."

# game/a1s6.rpy:43
translate latin a1s6_236e1fbe:

    # a "\"No...but obviously I'm not going to assume he wasn't. I won't even give him a chance at the emperorship now.\""
    a "\"Non...sed certe non temere sumam eum non serio locutum esse. Nunc ne facultatem quidem imperium obtinendi ei dabo.\""

# game/a1s6.rpy:44
translate latin a1s6_e499761a:

    # "I frown."
    "Frontem contraho."

# game/a1s6.rpy:45
translate latin a1s6_b346dae9:

    # m "\"And you were going to before?\""
    m "\"Antehac igitur daturus eras?\""

# game/a1s6.rpy:47
translate latin a1s6_c2c081ac:

    # a "\"No! I'm just going to make extra sure now.\""
    a "\"Non! Sed nunc etiam diligentius cavebo.\""

# game/a1s6.rpy:48
translate latin a1s6_d60eb140:

    # "I'm quiet, deciding to sit on the bed instead."
    "Taceo et potius in lecto sedere statuo."

# game/a1s6.rpy:49
translate latin a1s6_32d8385b:

    # "I don't like that this situation has become a lot more serious than it already was."
    "Mihi displicet res multo graviores factas esse quam iam erant."

# game/a1s6.rpy:50
translate latin a1s6_c4f527e8:

    # "After a moment, Amicus comes to sit next to me, the depression he creates in the mattress forcing me to lean sideways into him."
    "Paulo post, Amicus iuxta me sedet; pondus eius culcitam deprimit, ita ut in eum inclinari cogar."

# game/a1s6.rpy:51
translate latin a1s6_80f4f52c:

    # "He wraps an arm around me."
    "Bracchium circum me ducit."

# game/a1s6.rpy:53
translate latin a1s6_053bc662:

    # a "\"Don't worry about it at all. He has no chance and besides, I wouldn't let him touch you.\""
    a "\"Nihil omnino timeas. Nulla ei spes est; praeterea, te tangere eum non sinerem.\""

# game/a1s6.rpy:54
translate latin a1s6_b31db3db:

    # m "\"How would you be able to do that if he's the emperor though?\""
    m "\"Quomodo tamen eum prohibere posses, si imperator esset?\""

# game/a1s6.rpy:56
translate latin a1s6_7a7fe58e:

    # a "\"Well, I'm also his older brother. Some relationships don't change, even if the official ones do.\""
    a "\"Ego etiam frater eius natu maior sum. Quaedam necessitudines non mutantur, etiamsi publicae mutantur.\""

# game/a1s6.rpy:57
translate latin a1s6_b2e661d9:

    # "I stay quiet, unconvinced."
    "Taceo, neque persuasus sum."

# game/a1s6.rpy:59
translate latin a1s6_75d1083d:

    # a "\"Anyway, it would look awfully bad on his record. He just let his anger get the best of him. He'll quickly forget about the matter with the next trial coming up.\""
    a "\"Ceterum, factum tale famae eius valde noceret. Ira eum tantum vicit. Proximo certamine appropinquante, rem cito obliviscetur.\""

# game/a1s6.rpy:60
translate latin a1s6_26600159:

    # "Amicus squeezes me."
    "Amicus me artius amplectitur."

# game/a1s6.rpy:61
translate latin a1s6_d8ff6a7b:

    # a "\"And this is all assuming he'd win. He won't.\""
    a "\"Haec autem omnia posito eum victurum esse dicimus. Non vincet.\""

# game/a1s6.rpy:62
translate latin a1s6_a98e443b:

    # m "\"That's what you said last time.\""
    m "\"Id priore quoque certamine dixisti.\""

# game/a1s6.rpy:64
translate latin a1s6_6a627c79:

    # a "\"And we had an unforeseeable mishap last time. There isn't much possibility for one of those to happen in this trial.\""
    a "\"Priore autem certamine casus quem providere non poteramus nobis accidit. In hoc certamine talis casus vix fieri potest.\""

# game/a1s6.rpy:66
translate latin a1s6_36648890:

    # "We sit there a while longer, Amicus rubbing my shoulder with his paw."
    "Aliquantum diutius ibi sedemus; Amicus umerum meum manu mulcet."

# game/a1s6.rpy:67
translate latin a1s6_2b784e70:

    # "Despite my rising anxiety, it's comforting, and before long I'm leaning my head against his shoulder."
    "Quamquam anxietas mea crescit, id me solatur; mox caput umero eius admoveo."

# game/a1s6.rpy:72
translate latin a1s6_be27d597:

    # "A week later, Amicus and I sit in the gardens, enjoying the cool, fresh morning air."
    "Post hebdomadam, Amicus et ego in hortis sedemus, aura matutina frigida ac recenti fruentes."

# game/a1s6.rpy:73
translate latin a1s6_6bbf7b3b:

    # m "\"So, what's your main argument?\""
    m "\"Quae igitur praecipua ratio tua est?\""

# game/a1s6.rpy:75
translate latin a1s6_624289ed:

    # a "\"That Adastra has been on a steady rise politically and economically since the beginning of the {i}Ad Astra{/i} policy era. Why take steps backwards when we're so clearly moving in the right direction?\""
    a "\"Adastram, ex quo aetas consilii {i}Ad Astra{/i} coepit, in rebus publicis atque oeconomicis constanter floruisse. Cur retrocedamus, cum tam manifeste recta via progrediamur?\""

# game/a1s6.rpy:76
translate latin a1s6_88dc90c8:

    # m "\"And Cassius?\""
    m "\"Cassius autem?\""

# game/a1s6.rpy:78
translate latin a1s6_803b6dbb:

    # a "\"That Adastra's decline over the past few hundred years is due to that policy. Instead of looking outward to the children and other siblings, we should instead be looking inward to better ourselves.\""
    a "\"Adastram propter illud consilium per hos paucos saeculos deminutam esse. Potius quam ad Liberos aliosque Fratres foras spectemus, animum ad nos ipsos emendandos convertere debere.\""

# game/a1s6.rpy:79
translate latin a1s6_2d589eca:

    # "Amicus scratches his nose."
    "Amicus nasum scalpit."

# game/a1s6.rpy:81
translate latin a1s6_3b752d2e:

    # a "\"Well, that's the basics anyway.\""
    a "\"Haec saltem summa rei est.\""

# game/a1s6.rpy:83
translate latin a1s6_6254305a:

    # a "\"Obviously there is much, much more to it.\""
    a "\"Scilicet multo, multo plura ad rem pertinent.\""

# game/a1s6.rpy:84
translate latin a1s6_c0bad9c8:

    # m "\"So how are you gonna counter that argument? Seems like a pretty good one to me.\""
    m "\"Quomodo igitur illi rationi respondebis? Mihi satis valida videtur.\""

# game/a1s6.rpy:86
translate latin a1s6_441c1f19:

    # a "\"If the wheel of your chariot is caught on a stone, does that mean the campaign should be turned around and ended?\""
    a "\"Si rota currus tui saxo impeditur, num id significat expeditionem retro convertendam et finiendam esse?\""

# game/a1s6.rpy:87
translate latin a1s6_533446a6:

    # "He looks at me, and I just stare back."
    "Me spectat, atque ego eum vicissim tantum aspicio."

# game/a1s6.rpy:89
translate latin a1s6_3999bd33:

    # a "\"Well, the answer is no; you simply need to give it a push.\""
    a "\"Responsum est non: currum tantum impellere debes.\""

# game/a1s6.rpy:90
translate latin a1s6_825b7646:

    # m "\"In other words?\""
    m "\"Quid igitur significas?\""

# game/a1s6.rpy:92
translate latin a1s6_91591116:

    # a "\"In other words, the downturn over the past 200 years is simply a stone in the road. Why throw away ten millennia of progress due to a few centuries of light hardship?\""
    a "\"Significo detrimentum horum ducentorum annorum saxum tantum in via esse. Cur decem annorum milia progressus propter pauca saecula levium difficultatum abiciamus?\""

# game/a1s6.rpy:93
translate latin a1s6_36d3adcd:

    # a "\"Besides, it was completely predictable: the war with the Khemians and the resulting end of diplomatic relations with most of the other siblings caused it.\""
    a "\"Praeterea, hoc omnino provideri poterat: bellum contra Khemianos et commercia publica, quae inde cum plerisque aliis Fratribus rupta sunt, id effecerunt.\""

# game/a1s6.rpy:95
translate latin a1s6_f2723af4:

    # a "\"We certainly can't have any leverage in the galaxy when the only siblings speaking to us are the cats. If we can fix those relations, we could be well on our way to prosperity again.\""
    a "\"Certe nihil in galaxia efficere possumus, cum soli feles ex Fratribus nobiscum colloquantur. Si illas necessitudines restituamus, rursus ad prosperitatem provehi possimus.\""

# game/a1s6.rpy:96
translate latin a1s6_25df439a:

    # m "\"Well, that and un-stunting your children.\""
    m "\"Id quidem, atque Liberos tuos ab impedimentis quibus eos coercuisti liberare.\""

# game/a1s6.rpy:98
translate latin a1s6_9cc334db:

    # a "\"Yes, that too.\""
    a "\"Ita, id quoque.\""

# game/a1s6.rpy:99
translate latin a1s6_2bd58c52:

    # m "\"Which I still can't believe you did.\""
    m "\"Quod vos fecisse adhuc credere non possum.\""

# game/a1s6.rpy:101
translate latin a1s6_b9506e9e:

    # a "\"Again, it wasn't ME. Anyway, that will also be part of my argument: upraise the children fully as the partial uplift programs are now clearly a failure.\""
    a "\"Iterum dico: EGO id non feci. Ceterum, hoc quoque in oratione mea ponam: Liberos plane ad altiorem cultum evehere, quoniam consilia quibus partim tantum provehebantur manifeste defecerunt.\""

# game/a1s6.rpy:102
translate latin a1s6_e29161a5:

    # m "\"And end the slavery.\""
    m "\"Et servitutem tollere.\""

# game/a1s6.rpy:104
translate latin a1s6_46e1b975:

    # a "\"And consider the debts repaid, yes.\""
    a "\"Et debita soluta habere, ita.\""

# game/a1s6.rpy:105
translate latin a1s6_495c000c:

    # m "\"Debts that didn't exist in the first place, sure.\""
    m "\"Debita quae omnino numquam fuerunt, scilicet.\""

# game/a1s6.rpy:107
translate latin a1s6_31a9222b:

    # a "\"Listen, [mc], I have to use VERY careful language so as not to upset the people, not to mention the triumvirates. Feelings are sensitive at times like these and must be considered despite how tedious...or untrue it can be.\""
    a "\"Audi, [mc]: verbis CAUTISSIME uti debeo, ne populum offendam, nedum triumviros. Talibus temporibus animi facile laeduntur, eisque consulendum est, quantumvis id molestum...aut falsum esse possit.\""

# game/a1s6.rpy:108
translate latin a1s6_619c344e:

    # "Amicus is right; the wolves are very sensitive when it comes to their culture and history."
    "Recte dicit Amicus: Lupi, ubi de cultu historiaque sua agitur, facillime offenduntur."

# game/a1s6.rpy:109
translate latin a1s6_b79959ca:

    # "I'm starting to realize that their hubris is probably their biggest downfall."
    "Incipio intellegere superbiam maximam fortasse perniciem eorum esse."

# game/a1s6.rpy:110
translate latin a1s6_3c833db1:

    # "I lean back on the bench, starting to feel a little sweaty under the rising sun."
    "In scamno recumbo; sole oriente, paulum sudare incipio."

# game/a1s6.rpy:111
translate latin a1s6_ccc6223b:

    # m "\"Isn't that gonna be Cassius's whole thing, though? Appeal to their feelings, throw out the etiquette, and get straight to the point?\""
    m "\"Nonne tamen Cassius omnino id aget? Affectus eorum sollicitabit, urbanitatem abiciet et recta ad rem veniet?\""

# game/a1s6.rpy:113
translate latin a1s6_ee5a513f:

    # a "\"Possibly, but I'm confident my composure and consideration will win over the triumvirates.\""
    a "\"Fortasse, sed confido moderationem meam atque curam triumviros mihi conciliaturas esse.\""

# game/a1s6.rpy:114
translate latin a1s6_e4487ba7:

    # m "\"You ever considered NOT being so confident, maybe preparing for the worst?\""
    m "\"Num aliquando cogitasti te NON tantopere confidere debere, atque ad pessimum fortasse parari?\""

# game/a1s6.rpy:116
translate latin a1s6_5234c2ef:

    # a "\"I'm confident that I'm prepared for the worst.\""
    a "\"Confido me ad pessimum paratum esse.\""

# game/a1s6.rpy:117
translate latin a1s6_e44562c2:

    # "I roll my eyes and Amicus glares at me."
    "Oculos in caelum verto, et Amicus me iratus aspicit."

# game/a1s6.rpy:119
translate latin a1s6_ad468b6d:

    # a "\"I don't understand why you're so insistent on projecting yourself onto me. Just because {i}you{/i} aren't sure of yourself doesn't mean that {i}I{/i} should be the same.\""
    a "\"Non intellego cur tam pertinaciter tuos affectus mihi imponas. Quod {i}tu{/i} tibi non confidis, non significat {i}me{/i} quoque talem esse debere.\""

# game/a1s6.rpy:120
translate latin a1s6_e499761a_1:

    # "I frown."
    "Frontem contraho."

# game/a1s6.rpy:121
translate latin a1s6_a32a3184:

    # m "\"Ouch.\""
    m "\"Au.\""

# game/a1s6.rpy:123
translate latin a1s6_ecef8a0a:

    # a "\"...Sorry. But I strongly believe in what I'm doing. How can I ever be an emperor if I'm not sure that what I'm doing is right?\""
    a "\"...Ignosce. Sed firmissime credo ea quae ago recta esse. Quomodo umquam imperator esse possim, nisi certo sciam me recte agere?\""

# game/a1s6.rpy:124
translate latin a1s6_e1c7349c:

    # m "\"Sure...but all I'm saying is that you might not always be right, and you need to be prepared for that.\""
    m "\"Sane...sed hoc tantum dico: fortasse non semper recte senties, et ad id paratus esse debes.\""

# game/a1s6.rpy:126
translate latin a1s6_b4e84a82:

    # a "\"Trust me, I'm learning as I go, and after the last trial, I'm preparing for everything.\""
    a "\"Crede mihi: dum procedo, disco; post prius certamen, me ad omnia paro.\""

# game/a1s6.rpy:127
translate latin a1s6_c89493bb:

    # m "\"How are they even going to choose the winner? Wouldn't they just pick who they agree with most?\""
    m "\"Quomodo omnino victorem eligent? Nonne simpliciter eum eligent cuius sententiae maxime consentiant?\""

# game/a1s6.rpy:129
translate latin a1s6_ddcfea03:

    # a "\"Technically no, they're supposed to choose the best performance, the most convincing and dramatic.\""
    a "\"Proprie non; optimam actionem eligere debent, quae maxime persuadeat et animos maxime commoveat.\""

# game/a1s6.rpy:130
translate latin a1s6_9255b818:

    # m "\"How very Wolven.\""
    m "\"Quam proprium Luporum.\""

# game/a1s6.rpy:131
translate latin a1s6_b924b287:

    # a "\"Mmh...\""
    a "\"Mmh...\""

# game/a1s6.rpy:132
translate latin a1s6_ab61a356:

    # m "\"So you just have to convince a majority of the triumvirates?\""
    m "\"Maiori igitur triumvirorum parti tantum persuadere debes?\""

# game/a1s6.rpy:133
translate latin a1s6_5ddc6a0e:

    # a "\"Well, yes, but Cato's vote holds twice the power of a triumvirate vote, so I need at least either four triumvirates, or two triumvirates, plus Cato.\""
    a "\"Ita, sed suffragium Catonis bis tantum valet quam unius triumviri suffragium; ergo aut quattuor saltem triumviros, aut duos triumviros et Catonem mihi conciliare debeo.\""

# game/a1s6.rpy:134
translate latin a1s6_54d120ea:

    # m "\"And what are Cato's beliefs?\""
    m "\"Quid autem Cato sentit?\""

# game/a1s6.rpy:135
translate latin a1s6_f887bb98_1:

    # "Amicus shrugs."
    "Amicus umeros tollit."

# game/a1s6.rpy:137
translate latin a1s6_aca6d39f:

    # a "\"He doesn't talk about them much, but again it shouldn't matter.\""
    a "\"De sententiis suis raro loquitur; sed, ut dixi, id referre non debet.\""

# game/a1s6.rpy:139
translate latin a1s6_6a3706fc:

    # "He's certainly right about Cato not talking much about himself."
    "Certe recte dicit Catonem raro de se loqui."

# game/a1s6.rpy:140
translate latin a1s6_24b238bc:

    # "But that tends to be the way everyone is around here."
    "Sed omnes hic fere ita se gerunt."

# game/a1s6.rpy:141
translate latin a1s6_f46584b4:

    # "I can tell Amicus isn't all that interested in talking about this though, so I try to think of something else."
    "Intellego tamen Amicum parum de hac re loqui velle; aliud igitur excogitare conor."

# game/a1s6.rpy:142
translate latin a1s6_4483d6d0:

    # m "\"What started the war with the Khemians, by the way?\""
    m "\"Ceterum, unde bellum contra Khemianos ortum est?\""

# game/a1s6.rpy:144
translate latin a1s6_490bf8e5:

    # a "\"Their ambitions got the best of them. They began to interact with some of our abandoned children, some of which were very close to Adastra.\""
    a "\"Ambitio eos vicit. Cum quibusdam Liberis nostris desertis agere coeperunt; nonnulli ex his prope Adastram erant.\""

# game/a1s6.rpy:145
translate latin a1s6_2f737126:

    # m "\"Oh, is that illegal, or something?\""
    m "\"O, idne contra legem est, vel aliquid simile?\""

# game/a1s6.rpy:147
translate latin a1s6_1838044b:

    # a "\"Well...technically not if they're abandoned, but it's never really happened considering if a species is abandoned then that's a signal to the other siblings that the race is un-upliftable.\""
    a "\"Proprie...non, si deserti sunt. Sed id fere numquam accidit: si gens deseritur, ceteri Fratres eo signo admonentur eam gentem ad altiorem cultum evehi non posse.\""

# game/a1s6.rpy:148
translate latin a1s6_3a8d4f5e:

    # m "\"So they weren't breaking any rules?\""
    m "\"Nullas igitur leges violabant?\""

# game/a1s6.rpy:150
translate latin a1s6_693ba37d:

    # a "\"Even if they weren't breaking laws, they were clearly provoking us by uplifting races just a few hundred light years away from our moon. They are an arrogant people.\""
    a "\"Etiamsi leges non violabant, nos manifeste lacessiverunt, gentes ad altiorem cultum evehentes quae paucis tantum centenis annis lucis a luna nostra distabant. Gens eorum arrogans est.\""

# game/a1s6.rpy:151
translate latin a1s6_1502a996:

    # m "\"Neferu seems nice, always polite.\""
    m "\"Neferus benignus videtur, semper urbanus.\""

# game/a1s6.rpy:152
translate latin a1s6_84d141c7:

    # "Amicus smirks."
    "Amicus callide subridet."

# game/a1s6.rpy:154
translate latin a1s6_d35d0de7:

    # a "\"Well, that's how they often get their way; a facade of niceties to pull you into their trap. Either way, the war was a draw despite their technical advantage. Wolven tenacity beats Khemian tech any day.\""
    a "\"Saepe ita quod volunt consequuntur: specie comitatis te in insidias alliciunt. Ceterum, bellum sine victore finitum est, quamquam arte technica superiores erant. Constantia Luporum artem Khemianam quovis die vincit.\""

# game/a1s6.rpy:155
translate latin a1s6_381d6e3d:

    # "Despite Amicus's more progressive views on things, he's not immune to Wolven hubris either, it seems."
    "Quamquam Amicus novas rationes facilius recipit, ne ipse quidem superbia Luporum vacare videtur."

# game/a1s6.rpy:156
translate latin a1s6_04c5c0f6:

    # "But I'm not in the mood to argue with him about that."
    "Sed de ea re cum eo contendere nunc nolo."

# game/a1s6.rpy:157
translate latin a1s6_4942ff40:

    # m "\"You know, Neferu reminds of a culture on Earth...the Egyptians. I wonder if they uplifted there too?\""
    m "\"Scis, Neferus mihi gentem quandam Terrae in mentem revocat...Aegyptios. Miror num ibi quoque gentes ad altiorem cultum evexerint.\""

# game/a1s6.rpy:159
translate latin a1s6_4354910e:

    # "Amicus looks down at me, then snorts."
    "Amicus ad me despicit, deinde naribus fremit."

# game/a1s6.rpy:161
translate latin a1s6_f208352e:

    # a "\"More likely they just share simple aesthetics. Your people being uplifted twice while having no knowledge of the {i}Galaxias{/i} is impossible. The Khemians rarely abandon anyway...actually I don't think they ever have. They tend to have the best of luck.\""
    a "\"Verisimilius est eos simplicem ornandi modum tantum communem habere. Fieri non potest ut gens tua bis ad altiorem cultum evecta sit, nihil tamen de {i}Galaxias{/i} sciat. Khemiani autem raro gentes deserunt...immo, credo eos id numquam fecisse. Plerumque optima fortuna fruuntur.\""

# game/a1s6.rpy:162
translate latin a1s6_6a54bd74:

    # "Amicus stretches."
    "Amicus membra extendit."

# game/a1s6.rpy:164
translate latin a1s6_0f27a0cc:

    # a "\"Honestly though, this talk is boring. This is my only day off before the trial next week. We should be doing something fun.\""
    a "\"Sed, ut verum dicam, hic sermo taediosus est. Hodie solus dies mihi liber est ante certamen proximae hebdomadis. Aliquid iucundum agere debemus.\""

# game/a1s6.rpy:165
translate latin a1s6_20defb42:

    # m "\"Like what?\""
    m "\"Quid, exempli gratia?\""

# game/a1s6.rpy:166
translate latin a1s6_bd22dc24:

    # "Amicus looks around, then grins."
    "Amicus circumspicit, deinde late subridet."

# game/a1s6.rpy:168
translate latin a1s6_2bf2f860:

    # a "\"Want to practice {i}pugnu{/i} with me?\""
    a "\"Visne mecum {i}pugnu{/i} exercere?\""

# game/a1s6.rpy:169
translate latin a1s6_c651d0c8:

    # m "\"No.\""
    m "\"Non.\""

# game/a1s6.rpy:171
translate latin a1s6_36acf70c:

    # a "\"Aww, come on.\""
    a "\"Ah, age.\""

# game/a1s6.rpy:172
translate latin a1s6_596f2ccd:

    # "I know Amicus would go easy on me, but I really don't feel like getting sweaty and exhausted right now."
    "Scio Amicum mihi parciturum esse, sed nunc sudare et defatigari prorsus nolo."

# game/a1s6.rpy:173
translate latin a1s6_96a8f1de:

    # m "\"Why don't we just go to the island and have a picnic again?\""
    m "\"Cur non simpliciter in insulam imus ut rursus sub divo prandeamus?\""

# game/a1s6.rpy:175
translate latin a1s6_eed3f9fa:

    # a "\"Oh! Yeah, great idea.\""
    a "\"O! Ita, optime excogitatum.\""

# game/a1s6.rpy:178
translate latin a1s6_8603f928:

    # "Amicus grins and hops up, already making his way to the beach as he calls out to Com to get the food ready."
    "Amicus late subridet et exsilit; iam ad litus pergit, Computatro clamans ut cibum paret."

# game/a1s6.rpy:179
translate latin a1s6_7c5a0a14:

    # "With a sigh, I get up and jog after him toward the Sightseer."
    "Suspirans surgo et post eum ad Spectatricem curro."

# game/a1s6.rpy:183
translate latin a1s6_e263d634:

    # "I stand on the beach, hands on my hips as I look out at the sparkling lake, the breeze that's coming off the water cool and soothing."
    "In litore sto, manibus in coxis positis, lacum micantem spectans; aura ex aqua flans frigida est ac leniter me reficit."

# game/a1s6.rpy:184
translate latin a1s6_2fb8ec92:

    # "Adastra City sparkles in the distance as well, making the tall structures look like they have a glass, or crystal coating."
    "Urbs Adastra quoque procul micat, ita ut alta aedificia vitro vel crystallo obducta videantur."

# game/a1s6.rpy:185
translate latin a1s6_fba5a139:

    # "I look back at Amicus, the wolf in the process of spreading out a blanket under the shade of the trees."
    "Ad Amicum respicio; lupus sub arborum umbra stragulum explicat."

# game/a1s6.rpy:186
translate latin a1s6_82aec158:

    # m "\"You sure Cato isn't gonna kick your ass for doing this again?\""
    m "\"Certus es Catonem te ob hoc iterum agentem non verberaturum esse?\""

# game/a1s6.rpy:187
translate latin a1s6_33d984c4:

    # "I see the wolf's ears flick down for a moment."
    "Aures lupi paulisper demitti video."

# game/a1s6.rpy:189
translate latin a1s6_a0b24dc9:

    # a "\"That was for missing an appointment. I don't have any today.\""
    a "\"Tum id fecit quia tempore constituto non adfui. Hodie nihil mihi constitutum est.\""

# game/a1s6.rpy:190
translate latin a1s6_591c0bd4:

    # "I resist telling Amicus that it was about much more than a missed lesson, and instead I walk over to help him spread the blanket out more evenly."
    "Me cohibeo ne Amico dicam rem multo graviorem fuisse quam unam lectionem omissam; potius ad eum accedo et stragulum aequius explicare adiuvo."

# game/a1s6.rpy:192
translate latin a1s6_34b202c8:

    # a "\"Thank you! Now, shall we eat?\""
    a "\"Gratias! Nunc prandeamus?\""

# game/a1s6.rpy:196
translate latin a1s6_7e4c6c34:

    # "Amicus pulls the cloth off the basket, revealing tightly packed and covered plates, along with bottles of wine and {i}virdi{/i}."
    "Amicus pannum e corbe tollit, patinas arte compositas et opertas, cum lagonis vini atque {i}virdi{/i}, aperiens."

# game/a1s6.rpy:197
translate latin a1s6_397d8c14:

    # "This time, the food is a selection of wraps full of meat and cheeses along with chilled, salted cucumbers."
    "Hac vice cibum constituunt panes carnem ac caseos involventes, atque cucumeres frigidi sale conditi."

# game/a1s6.rpy:198
translate latin a1s6_f7002c02:

    # "Amicus splays out in that luxurious Roman way as he pulls his plate of food up next to his chest, immediately stuffing a whole wrap in his muzzle."
    "Amicus more Romano luxuriose recumbit, patinam ad pectus trahit, statimque totum panem farctum in os ingerit."

# game/a1s6.rpy:199
translate latin a1s6_46e31f1c:

    # "I'm a bit more dainty, instead sitting next to the wolf cross-legged as I nibble at my own wrap."
    "Ego paulo elegantius ago: iuxta lupum cruribus decussatis sedeo, paulatim panem meum mordens."

# game/a1s6.rpy:200
translate latin a1s6_53f611b8:

    # "We eat in silence for a little while, Amicus gobbling up the majority of the food like always."
    "Aliquantisper taciti comedimus; Amicus, ut semper, maiorem cibi partem avidissime devorat."

# game/a1s6.rpy:201
translate latin a1s6_6b16e15d:

    # "I notice the wolf drinking more wine than he usually does, probably because it's his day off."
    "Lupum plus vini quam solet bibere animadverto, probabiliter quia hodie ab officiis vacat."

# game/a1s6.rpy:202
translate latin a1s6_6067ec64:

    # "After taking a particularly large swig, he points at my legs."
    "Haustu praecipue magno sumpto, crura mea digito indicat."

# game/a1s6.rpy:204
translate latin a1s6_95504baa:

    # a "\"I don't know how you're comfortable doing that; looks like hell on the knees.\""
    a "\"Nescio quomodo ita commode sedere possis; genua graviter cruciare videtur.\""

# game/a1s6.rpy:205
translate latin a1s6_aad87ec1:

    # m "\"Well, laying down like you are actually hurts my neck. I don't know how you do it for so long.\""
    m "\"Mihi autem collum dolet cum sicut tu recumbo. Nescio quomodo tam diu ita manere possis.\""

# game/a1s6.rpy:206
translate latin a1s6_10d650f0:

    # "I rub the left side of my neck as I say that, then carefully uncork the bottle of {i}virdi{/i}."
    "Dum haec dico, sinistram colli partem frico, deinde lagenam {i}virdi{/i} caute recludo."

# game/a1s6.rpy:207
translate latin a1s6_a3da22b5:

    # a "\"Cato's the same way, but he's old.\""
    a "\"Cato idem sentit, sed senex est.\""

# game/a1s6.rpy:208
translate latin a1s6_00d55ff6:

    # "I take a sip of the cold drink that I've come to really like over the past few weeks."
    "Frigidam potionem sorbeo, quae per has hebdomadas mihi valde placere coepit."

# game/a1s6.rpy:209
translate latin a1s6_6144e201:

    # m "\"Speaking of Cato. Who exactly is he? How'd he become the acting emperor?\""
    m "\"De Catone loquentes: quis ille revera est? Quomodo imperatoris vicarius factus est?\""

# game/a1s6.rpy:210
translate latin a1s6_aa2593b8:

    # "I try circling us back around to the conversation we'd had earlier, wanting to know more about the wolf that's apparently ruling all of Adastra right now."
    "Ad priorem sermonem redire conor, plura discere cupiens de lupo qui nunc toti Adastrae imperare videtur."

# game/a1s6.rpy:212
translate latin a1s6_2f341333:

    # a "\"Oh! Well, he was father's friend since childhood. He was the Imperial Legate during the Khemian War.\""
    a "\"O! Amicus patri ab ipsa pueritia fuit. Bello Khemiano legatus imperialis erat.\""

# game/a1s6.rpy:213
translate latin a1s6_8659f7f9:

    # m "\"Is that an important position?\""
    m "\"Estne id magnum officium?\""

# game/a1s6.rpy:215
translate latin a1s6_4ceab8c9:

    # a "\"It's the highest rank in the military, aside from the emperor, of course. He's credited with preventing outright defeat.\""
    a "\"Summus gradus in exercitu est, praeter imperatorem scilicet. Ei tribuitur quod plenam cladem avertit.\""

# game/a1s6.rpy:216
translate latin a1s6_a5b0e666:

    # m "\"Huh...must be kind of weird for him to have Neferu walking around in the palace.\""
    m "\"Ah...illi aliquantum mirum esse debet Neferu in palatio ambulantem videre.\""

# game/a1s6.rpy:218
translate latin a1s6_a44677e7:

    # a "\"Another reason I wonder why Virginia brought him to the palace. Cato's scars aren't just physical.\""
    a "\"Alia causa est cur mirer Virginiam eum in palatium adduxisse. Cicatrices Catonis non corporis tantum sunt.\""

# game/a1s6.rpy:219
translate latin a1s6_c2555556:

    # m "\"Physical?\""
    m "\"Corporis?\""

# game/a1s6.rpy:220
translate latin a1s6_5c29414f:

    # a "\"I take it you've noticed the visor, yes? Well, he lost an eye and part of his skull during the war. Eventually, the other eye failed as well, and he had to go to our parent to have mechanical vision installed.\""
    a "\"Opinor te oculorum tegumentum animadvertisse, nonne? Bello oculum atque partem cranii amisit. Tandem alter quoque oculus defecit, et ad Parentem nostrum ire debuit ut visus machinalis ei insereretur.\""

# game/a1s6.rpy:222
translate latin a1s6_332eb194:

    # a "\"Anyway, Neferu was born decades after the war, so I doubt Cato holds anything against him specifically.\""
    a "\"Ceterum, Neferu aliquot decenniis post bellum natus est; dubito igitur Catonem ipsi nominatim inimicum esse.\""

# game/a1s6.rpy:223
translate latin a1s6_a08ac6ec:

    # m "\"Is he alright with the alliance thing?\""
    m "\"Consilium foederis probatne?\""

# game/a1s6.rpy:224
translate latin a1s6_4b8b0163:

    # "Knowing this about Cato makes me worry that he might not agree with Amicus on one of his most controversial policies."
    "His de Catone cognitis, vereor ne ab Amico de uno e consiliis maxime controversis dissentiat."

# game/a1s6.rpy:225
translate latin a1s6_d4174b16:

    # a "\"I doubt that, but I think he understands it's necessary if we're to begin re-establishing relations with the other siblings.\""
    a "\"Dubito, sed credo eum intellegere id necessarium esse, si necessitudines cum aliis Fratribus restituere incipere volumus.\""

# game/a1s6.rpy:226
translate latin a1s6_de33013b:

    # m "\"Hmm...\""
    m "\"Hmm...\""

# game/a1s6.rpy:227
translate latin a1s6_8e471e15:

    # "I feel my stomach turn a little as I realize we might be disadvantaged in this trial as well."
    "Venter meus paulum torquetur, cum intellego nos hoc quoque certamine fortasse iniquiore condicione fore."

# game/a1s6.rpy:228
translate latin a1s6_9b541833:

    # m "\"Amicus...what's going to happen if you lose this next trial?\""
    m "\"Amice...quid fiet si hoc proximum certamen amiseris?\""

# game/a1s6.rpy:230
translate latin a1s6_0bbe384e:

    # a "\"Again, don't wor—\""
    a "\"Iterum dico, noli ti—\""

# game/a1s6.rpy:231
translate latin a1s6_f444377d:

    # m "\"I know you don't think it can happen, but if it DOES...what happens to me?\""
    m "\"Scio te id fieri posse non putare; sed si FIAT...quid mihi accidet?\""

# game/a1s6.rpy:233
translate latin a1s6_47caa0d5:

    # "Amicus frowns at me, a meat wrap halfway to his face before he sets it back down."
    "Amicus me fronte contracta spectat; panem carne farctum ad os fere tulerat, sed eum rursus deponit."

# game/a1s6.rpy:234
translate latin a1s6_009ff7e6:

    # a "\"First of all, I won't have you worrying about Cassius's words. What he said was out of anger, and besides, I'll have measures in place to stop it from ever happening.\""
    a "\"Primum, verbis Cassii te angi non sinam. Quae dixit ira dixit; praeterea, consilia paravero ne id umquam accidere possit.\""

# game/a1s6.rpy:235
translate latin a1s6_ae817c0e:

    # m "\"What measures?\""
    m "\"Quae consilia?\""

# game/a1s6.rpy:236
translate latin a1s6_dd2bca73:

    # a "\"I'm...not fully sure of that yet, but I will have them in place by the time the next trial comes...very good measures.\""
    a "\"Id...nondum plane scio, sed parata erunt cum proximum certamen venerit...optima consilia.\""

# game/a1s6.rpy:237
translate latin a1s6_15b15847:

    # m "\"And aside from that? What do I do next?\""
    m "\"Praeter id autem? Quid deinde faciam?\""

# game/a1s6.rpy:238
translate latin a1s6_a08fc22a:

    # "Amicus thinks."
    "Amicus cogitat."

# game/a1s6.rpy:240
translate latin a1s6_35fe0502:

    # a "\"Like I said before, I'll ensure a way home for you. The problem is the illegality of you being here. The more people who know about it, the more likely a monitor may be alerted to what happened.\""
    a "\"Ut antea dixi, curabo ut tibi via domum pateat. Difficultas est quod te hic esse contra legem est. Quo plures rem sciunt, eo facilius Monitor de facto certior fieri potest.\""

# game/a1s6.rpy:242
translate latin a1s6_6d6bc829:

    # a "\"I need to be very careful about who I let know about the situation.\""
    a "\"Cautissime eligere debeo quos de hac re certiores faciam.\""

# game/a1s6.rpy:243
translate latin a1s6_f0f1d907:

    # m "\"Okay...\""
    m "\"Bene...\""

# game/a1s6.rpy:244
translate latin a1s6_6c857bbb:

    # "I look down at my food, suddenly having lost my appetite."
    "Ad cibum despicio, subito omni appetitu amisso."

# game/a1s6.rpy:245
translate latin a1s6_5f2059b0:

    # "Amicus sighs, sounding annoyed."
    "Amicus suspirat, voce irritata."

# game/a1s6.rpy:247
translate latin a1s6_987ec479:

    # a "\"Come on, [mc], this is likely going to be your last few weeks here. Stop focusing so much on what's unlikely to happen. Let's enjoy ourselves a little bit.\""
    a "\"Age, [mc], hae probabiliter ultimae tuae hebdomadae hic erunt. Noli tam assidue de rebus vix futuris cogitare. Paulum gaudeamus.\""

# game/a1s6.rpy:249
translate latin a1s6_b38380e1:

    # "The wolf suddenly sits up, brushing the crumbs off his fur before swigging down more wine."
    "Lupus subito se erigit, micas e pilo detergit, deinde plus vini haurit."

# game/a1s6.rpy:251
translate latin a1s6_ec8b7a7e:

    # a "\"Come, let's practice combat.\""
    a "\"Age, pugnam exerceamus.\""

# game/a1s6.rpy:252
translate latin a1s6_06fb94d7:

    # m "\"What? I said I didn't want to do that.\""
    m "\"Quid? Dixi me id agere nolle.\""

# game/a1s6.rpy:254
translate latin a1s6_4a67ae54:

    # a "\"Well, since you're so worried about Cassius, I'll teach you a few tricks to take him down.\""
    a "\"Cum tamen Cassium tantopere timeas, quasdam artes te docebo quibus eum prosternas.\""

# game/a1s6.rpy:255
translate latin a1s6_55c73a4e:

    # m "\"Take him down?\""
    m "\"Eum prosternam?\""

# game/a1s6.rpy:257
translate latin a1s6_e5940d5a:

    # a "\"Well, I don't trust him to keep his paws to himself now, so if he ever tries to take advantage of you while I'm not around, you can at least hold him off long enough to get away.\""
    a "\"Iam non confido eum manus continere; si quando, me absente, te vexare conetur, saltem eum satis diu retinere possis ut effugias.\""

# game/a1s6.rpy:258
translate latin a1s6_d5166bfc:

    # m "\"Yeah, and that won't make everything worse.\""
    m "\"Ita, atque hoc omnia peiora profecto non faciet.\""

# game/a1s6.rpy:260
translate latin a1s6_01adf5d8:

    # a "\"Well, after what happened a few days ago, I suppose it can't get much worse.\""
    a "\"Post ea quae ante paucos dies evenerunt, credo res vix peiores fieri posse.\""

# game/a1s6.rpy:261
translate latin a1s6_a75c792e:

    # "I slowly get to my feet, straightening out my robes."
    "Lente surgo et tunicam compono."

# game/a1s6.rpy:262
translate latin a1s6_f881281e:

    # m "\"I'm not so sure about that. Besides, we just ate.\""
    m "\"Id non tam certo scio. Praeterea, modo prandimus.\""

# game/a1s6.rpy:264
translate latin a1s6_96910dda:

    # "Amicus laughs."
    "Amicus ridet."

# game/a1s6.rpy:265
translate latin a1s6_06bda32a:

    # a "\"It's not like you're Cato. I think I'll be able to keep my food and drink down.\""
    a "\"Non es Cato. Credo me cibum potionemque in ventre retinere posse.\""

# game/a1s6.rpy:266
translate latin a1s6_ba07af94:

    # m "\"What about me!?\""
    m "\"Quid de me!?\""

# game/a1s6.rpy:268
translate latin a1s6_ebeb9bc0:

    # a "\"I'm not going to hit you or anything.\""
    a "\"Te ferire non cogito, neque quidquam simile facere.\""

# game/a1s6.rpy:270
translate latin a1s6_55c2b031:

    # "Amicus squares his stance, standing in the sand off to the side of the blanket, still in the shade."
    "Amicus se firmiter constituit, in arena iuxta stragulum stans, adhuc sub umbra."

# game/a1s6.rpy:271
translate latin a1s6_920e5d57:

    # "I sigh, recognizing that Amicus is in one of those moods where it's hard to talk him out of doing something."
    "Suspiro, intellegens Amicum eo animo esse quo aegre ab ullo consilio revocatur."

# game/a1s6.rpy:272
translate latin a1s6_ccfe7d45:

    # "I walk over to stand in front of the wolf, my arms folded."
    "Ad eum accedo et ante lupum sto, bracchiis complicatis."

# game/a1s6.rpy:273
translate latin a1s6_541f5946:

    # a "\"And about Cato...I could probably beat him in a fair fight. He just caught me by surprise that last time.\""
    a "\"Et de Catone...probabiliter eum aequa pugna vincere possim. Illa priore vice me tantum improviso oppressit.\""

# game/a1s6.rpy:274
translate latin a1s6_f79b8db2:

    # "I pause, then raise an eyebrow."
    "Paulisper consisto, deinde supercilium tollo."

# game/a1s6.rpy:275
translate latin a1s6_9d3344cb:

    # m "\"What do you mean?\""
    m "\"Quid dicis?\""

# game/a1s6.rpy:277
translate latin a1s6_3a023877:

    # a "\"I mean he started fighting no holds barred without warning. I'd have given him the business if I'd known he were going to do that.\""
    a "\"Dico eum sine monitu omnibus artibus pugnare coepisse. Eum graviter oppressissem, si antea scivissem eum ita acturum esse.\""

# game/a1s6.rpy:278
translate latin a1s6_594adfd0:

    # m "\"Hey, I don't think of you any less for losing a fight...to an old man.\""
    m "\"Heus, non te minus aestimo quod pugnam amisisti...contra senem.\""

# game/a1s6.rpy:280
translate latin a1s6_7abfe71f:

    # "Amicus furrows his brow, the way he does when he's realizing that I'm teasing him."
    "Amicus frontem contrahit, more suo cum intellegit me eum irridere."

# game/a1s6.rpy:281
translate latin a1s6_4486aa1d:

    # a "\"I'm serious.\""
    a "\"Serio loquor.\""

# game/a1s6.rpy:282
translate latin a1s6_dd1fb494:

    # m "\"So am I. I mean, you almost had me that one time in the spaceship. You're a real force to be reckoned with.\""
    m "\"Ego quoque. Nam illa vice in nave astrali me fere vicisti. Vere adversarius formidandus es.\""

# game/a1s6.rpy:284
translate latin a1s6_1586e4bb:

    # a "\"It's not smart to tease a wolf before a fight, human.\""
    a "\"Lupum ante pugnam irridere non sapientis est, homo.\""

# game/a1s6.rpy:285
translate latin a1s6_7446285d:

    # m "\"I'm not teasing.\""
    m "\"Non te irrideo.\""

# game/a1s6.rpy:286
translate latin a1s6_986f488a:

    # a "\"Mhm, and kicking an unsuspecting man in the balls isn't exactly a win in my book.\""
    a "\"Mhm, neque hominem incautum in testiculos calce ferire ego pro victoria habeo.\""

# game/a1s6.rpy:287
translate latin a1s6_40a7ee18:

    # m "\"It is in mine.\""
    m "\"Ego pro victoria habeo.\""

# game/a1s6.rpy:288
translate latin a1s6_9840bd78:

    # a "\"Clearly. Speaking of which—\""
    a "\"Manifeste. De quo quidem—\""

# game/a1s6.rpy:290
translate latin a1s6_c7b8943b:

    # "Amicus suddenly steps forward, thrusting his knee up at my crotch."
    "Amicus subito procedit et genu ad inguina mea impellit."

# game/a1s6.rpy:291
translate latin a1s6_02ef3e6c:

    # "I can only watch in horror as it comes up fast, stopping just an inch from my groin."
    "Horrens tantum spectare possum dum genu cito ascendit, uno fere pollice ab inguinibus meis consistens."

# game/a1s6.rpy:292
translate latin a1s6_44d1c0b8:

    # "We both stand there for a moment before I gasp and stumble back, holding my nuts even though Amicus didn't make contact."
    "Ambo paulisper stamus; deinde anhelans retro titubo, testiculos protegens, quamquam Amicus eos non tetigit."

# game/a1s6.rpy:293
translate latin a1s6_85872ef6:

    # m "\"What the hell!?\""
    m "\"Quid, malum!?\""

# game/a1s6.rpy:294
translate latin a1s6_c5da86f8:

    # a "\"If you don't want Cassius to hold broken bones against you, go for the genitals. That should be enough to stun him. This goes for anyone else who might try to attack you.\""
    a "\"Si non vis Cassium tibi ossa fracta exprobrare, genitalia pete. Id satis erit ad eum obstupefaciendum. Hoc quoque valet de quolibet alio qui te oppugnare conetur.\""

# game/a1s6.rpy:295
translate latin a1s6_54c374e5:

    # "Annoyed, I make as if to do the same to Amicus, but he's already blocking."
    "Irritatus simulo me idem Amico facturum, sed ille iam ictum impedit."

# game/a1s6.rpy:297
translate latin a1s6_06f04491:

    # a "\"Haha! Yes, like that, though try to be a little more subtle. You telegraph your moves far too much.\""
    a "\"Haha! Ita, sic; sed paulo callidius conare. Motus tuos nimis manifeste ante ostendis.\""

# game/a1s6.rpy:298
translate latin a1s6_04e15d96:

    # "I stop struggling with the wolf, breathing heavily."
    "Cum lupo luctari desino, graviter spirans."

# game/a1s6.rpy:299
translate latin a1s6_ef56a217:

    # m "\"Fine...\""
    m "\"Bene...\""

# game/a1s6.rpy:300
translate latin a1s6_fd6e5762:

    # "Then, as Amicus starts to drop his guard, I try to swat him in the crotch."
    "Deinde, cum Amicus se tueri desinere incipit, inguina eius manu ferire conor."

# game/a1s6.rpy:301
translate latin a1s6_b2390548:

    # "He snatches up my hand immediately."
    "Ille statim manum meam arripit."

# game/a1s6.rpy:303
translate latin a1s6_b15b88e7:

    # a "\"Ah! Better, [mc], though you should probably try something harder than a flowery slap.\""
    a "\"Ah! Melius, [mc]; sed probabiliter ictum fortiorem quam mollem alapam conari debes.\""

# game/a1s6.rpy:305
translate latin a1s6_c2071970:

    # "I try to shove the wolf away, but he steps to the side...and gives me a shove as well."
    "Lupum repellere conor, sed ille ad latus se movet...atque me quoque impellit."

# game/a1s6.rpy:309
translate latin a1s6_89fbceaa:

    # "I trip over something, and it's not until I'm on my ass that I realize he'd stuck his foot out behind me."
    "In aliquid impingo; non ante quam in clunibus iaceo intellego eum pedem post me posuisse."

# game/a1s6.rpy:310
translate latin a1s6_842ca667:

    # "I look up at Amicus as he stands over me, the expression on his face showing me that he's trying very hard not to laugh."
    "Ad Amicum supra me stantem suspicio; vultus eius ostendit eum summopere conari ne rideat."

# game/a1s6.rpy:312
translate latin a1s6_1b0ee8d8:

    # a "\"Tangle up his feet and you should be able to send him to the ground fairly easily. If he breaks any of his bones from the fall, then at least he can't say you did it intentionally.\""
    a "\"Pedes eius implica, et eum satis facile in terram deicere poteris. Si cadendo ossa fregerit, saltem dicere non poterit te id consulto fecisse.\""

# game/a1s6.rpy:313
translate latin a1s6_bc6a3c0a:

    # "Amicus reaches down with a paw to help me up."
    "Amicus manum demittit ut me erigere adiuvet."

# game/a1s6.rpy:314
translate latin a1s6_3f6bf113:

    # "I take it and he pulls me up easily, almost lifting me off my feet."
    "Eam capio; ille facile me tollit, paene a terra sublevans."

# game/a1s6.rpy:315
translate latin a1s6_02024f96:

    # m "\"This is great and all, but I don't see how this is gonna help me. I wasn't even the one that broke his tail, and he wanted me killed.\""
    m "\"Haec quidem bona sunt, sed non video quomodo me iuvabunt. Non ego caudam eius fregeram, et tamen me interfici voluit.\""

# game/a1s6.rpy:317
translate latin a1s6_05f2c03c:

    # a "\"Again, with me standing in his way, he won't ever get the chance to try anything, if he even intends to. This is only to give you a chance to get away from him.\""
    a "\"Iterum dico: cum ego obstem, facultatem quidquam conandi numquam habebit, etiamsi aliquid cogitet. Hoc tantum efficit ut ab eo effugere possis.\""

# game/a1s6.rpy:318
translate latin a1s6_2c03b041:

    # "Amicus brushes the sand off my robes."
    "Amicus arenam e tunica mea detergit."

# game/a1s6.rpy:319
translate latin a1s6_0c015c99:

    # a "\"Besides, this is useful in any situation, not just for Cassi-US!\""
    a "\"Praeterea, haec quavis in re utilia sunt, non tantum adversus Cassi-UM!\""

# game/a1s6.rpy:321
translate latin a1s6_034cfcb2:

    # "Amicus chokes on his last syllable as I ram my shoulder into him, grabbing at his legs to try and trip him up, kind of like I saw Cato do to him in the amphitheater."
    "Amicus ultimam syllabam aegre effert, dum umerum in eum impello et crura eius arripio, eum supplantare conans, fere sicut Catonem in amphitheatro facere vidi."

# game/a1s6.rpy:322
translate latin a1s6_fe025f7c:

    # "Obviously, someone as small as me going up against a hulking wolf like Amicus is bound to fail, but the wolf does stumble back a few steps."
    "Scilicet homo tam parvus quam ego contra ingentem lupum qualis Amicus nihil efficere solet, sed lupus aliquot passus retro titubat."

# game/a1s6.rpy:323
translate latin a1s6_8f863953:

    # a "\"H-hey!\""
    a "\"H-heus!\""

# game/a1s6.rpy:325
translate latin a1s6_30fa954f:

    # "Amicus chuckles and I feel him let himself fall backwards to the sand."
    "Amicus subridet; sentio eum sponte retro in arenam cadere."

# game/a1s6.rpy:327
translate latin a1s6_27c50037:

    # "It reminds me of the last time we'd wrestled on the beach, except now I end up on top with my fall cushioned by his body, my face bouncing against his massive chest."
    "Hoc me prioris nostrae luctationis in litore admonet; nunc tamen ego supra eum cado, corpore eius molliter exceptus, facie ad ingens pectus eius repercussa."

# game/a1s6.rpy:328
translate latin a1s6_88a4717d:

    # "Amicus grins at me."
    "Amicus mihi late subridet."

# game/a1s6.rpy:329
translate latin a1s6_c944c6e5:

    # a "\"Oof! Not bad, not bad. With a little more force, you might be able to knock down someone as small as Cassius.\""
    a "\"Uf! Non male, non male. Si paulo fortius impuleris, aliquem tam parvum quam Cassium deicere possis.\""

# game/a1s6.rpy:330
translate latin a1s6_7287699b:

    # "I pin the wolf down, my hands on his shoulders."
    "Lupum detineo, manibus in umeris eius positis."

# game/a1s6.rpy:331
translate latin a1s6_88a7f45c:

    # m "\"Oh please, I knocked you down fair and squ-ARE!\""
    m "\"O, quaeso, te aeque ac recte deie-CI!\""

# game/a1s6.rpy:332
translate latin a1s6_4cb4c65b:

    # "This time, I'm the one to yelp on my last syllable, Amicus easily reversing our positions as he rolls us both over."
    "Hac vice ego ultimam syllabam eiulans effero; Amicus facile loca nostra mutat, ambos volvens."

# game/a1s6.rpy:333
translate latin a1s6_27727ee9:

    # "I find myself staring up at the wolf, his massive paws on my shoulders, his knees spread to either side of my thighs as he's careful not to rest his weight on top of me."
    "Me ad lupum suspicientem invenio; ingentes manus eius in umeris meis sunt, genua ab utroque femorum meorum latere, dum cavet ne pondere suo me premat."

# game/a1s6.rpy:334
translate latin a1s6_9dde583c:

    # "He grins down at me, chest heaving for breath as his tongue dangles out his muzzle a bit, the way it sometimes does when he's buzzed, giving his grin a dopey quality."
    "Ad me late subridet, pectore anhelante; lingua paulum ex ore pendet, sicut interdum fit cum vino exhilaratus est, ita ut risus eius aliquantum stultus videatur."

# game/a1s6.rpy:335
translate latin a1s6_29c5c964:

    # "He's hunched over me to the point where his tongue almost touches my nose."
    "Tam prope supra me incumbit ut lingua nasum meum paene tangat."

# game/a1s6.rpy:336
translate latin a1s6_a4104dae:

    # "Although I try to keep my face in a scowl, I can't stop the smile from coming through, and pretty soon I'm laughing a little."
    "Quamquam vultum severum servare conor, risum continere non possum; mox paulum rideo."

# game/a1s6.rpy:337
translate latin a1s6_17a9190b:

    # "I'm about to tell Amicus that this whole thing is hardly fair when he leans down fully, pressing his lips to mine in a kiss."
    "Amico dicturus sum hanc rem vix aequam esse, cum ille plane se demittit et labra sua meis osculans admovet."

# game/a1s6.rpy:339
translate latin a1s6_1f9a4ea1:

    # "I gasp in surprise, but it's through my nose as my mouth is sealed to his."
    "Miratus anhelo, sed per nares, quia os meum ori eius adhaeret."

# game/a1s6.rpy:340
translate latin a1s6_2430a4df:

    # "My eyes are wide, his closed as he presses harder against my lips."
    "Oculi mei late patent, eius clausi sunt, dum labra mea vehementius premit."

# game/a1s6.rpy:341
translate latin a1s6_3fc2438f:

    # "As he'd bent over me, his paws left my shoulders to instead hold my head steady, one paw against my cheek, the other cupped around my head, his whole body huddling around my face."
    "Cum supra me inclinavit, manus ab umeris meis removit ut caput meum firmaret: altera genae meae admota, altera caput amplectente, dum totum corpus circum faciem meam contrahit."

# game/a1s6.rpy:342
translate latin a1s6_be90baa7:

    # "I don't move, not hugging back, but not turning away either."
    "Non moveor; neque eum vicissim amplector, neque me averto."

# game/a1s6.rpy:343
translate latin a1s6_db234f12:

    # "Instead, I just lay there as I feel my heart skip a beat, the feeling of the big, strong wolf crouched over me, kissing me, sending a thrill from my chest down to my crotch."
    "Tantum iaceo, sentiens cor quasi unum pulsum omittere; magnus fortisque lupus supra me accubans et me osculans sensum trepidum e pectore ad inguina mittit."

# game/a1s6.rpy:344
translate latin a1s6_3aff93a7:

    # "The wolf's broad, cold nose twitches against mine before a hot huff of breath escapes it and washes over my face."
    "Latus et frigidus nasus lupi contra meum movetur; deinde calidus halitus erumpit et faciem meam perfundit."

# game/a1s6.rpy:345
translate latin a1s6_2cbdbe37:

    # "At the same time, Amicus suddenly rolls off of me, our lips parting just as quickly as they'd connected as he flops to the side on his back, mirroring my spread-eagle position."
    "Simul Amicus subito a me devolvitur; labra nostra tam cito separantur quam coniuncta erant, dum ille iuxta me supinus cadit, positionem meam membris late expansis imitans."

# game/a1s6.rpy:346
translate latin a1s6_2bfbf961:

    # "We lay there next to each other, my heart hammering as I listen to the wolf breathing heavily next to me."
    "Iuxta invicem iacemus; cor meum vehementer pulsat, dum lupum prope me graviter spirantem audio."

# game/a1s6.rpy:348
translate latin a1s6_8c4eeb7b:

    # "Aside from that, the only other sounds are the waves washing up against the shore a few dozen yards away."
    "Praeter eum, soli alii soni sunt undae litus paucis decenis passibus remotum alluentes."

# game/a1s6.rpy:349
translate latin a1s6_5a4ec406:

    # "A few minutes pass in silence as I wait for the wolf to say something."
    "Aliquot minuta taciti manemus, dum exspecto lupum aliquid dicturum."

# game/a1s6.rpy:350
translate latin a1s6_4731fc45:

    # "He doesn't, and finally it gets to the point where {i}I{/i} have to say something."
    "Nihil dicit; tandem ad eum locum pervenimus quo {i}ego{/i} aliquid dicere debeam."

# game/a1s6.rpy:351
translate latin a1s6_2a419574:

    # m "\"Soooo...\""
    m "\"Igiturr...\""

# game/a1s6.rpy:353
translate latin a1s6_8ca1e2e3:

    # a "\"Hm?\""
    a "\"Hm?\""

# game/a1s6.rpy:354
translate latin a1s6_57ba4367:

    # "Amicus responds instantly with an innocent, inquisitive grunt."
    "Amicus statim respondet, voce innocenti atque interrogante murmurans."

# game/a1s6.rpy:355
translate latin a1s6_30c1e05a:

    # m "\"Uh...what was that?\""
    m "\"Ah...quid illud erat?\""

# game/a1s6.rpy:357
translate latin a1s6_2b5d6c7c:

    # a "\"'That'...Oh, the kiss?\""
    a "\"Illud...O, osculum?\""

# game/a1s6.rpy:358
translate latin a1s6_bf023949:

    # m "\"Yeah...\""
    m "\"Ita...\""

# game/a1s6.rpy:359
translate latin a1s6_b18f15a5:

    # a "\"Just thought I owed it to you after Meera. I botched it during the performance after all.\""
    a "\"Putavi me id tibi post Meeram debere. In fabula enim male osculatus sum.\""

# game/a1s6.rpy:360
translate latin a1s6_ad6689ae:

    # "The wolf sounds distant, distracted, like he's not paying attention to me."
    "Vox lupi remota ac distracta videtur, quasi animum ad me non advertat."

# game/a1s6.rpy:361
translate latin a1s6_784c9da8:

    # "I finally prop myself up on an elbow, looking directly at Amicus now."
    "Tandem cubito nixus me erigo, iam recta ad Amicum spectans."

# game/a1s6.rpy:362
translate latin a1s6_0b4eb0fa:

    # m "\"Really?\""
    m "\"Revera?\""

# game/a1s6.rpy:364
translate latin a1s6_dd446c7b:

    # "Like a child, Amicus looks away toward the lake, not saying anything."
    "Ut puer, Amicus obtutum ad lacum avertit, nihil dicens."

# game/a1s6.rpy:365
translate latin a1s6_f8415527:

    # "I wait a while longer, giving him a chance to respond, a chance he doesn't take."
    "Aliquantum diutius exspecto, facultatem respondendi ei praebens; ea non utitur."

# game/a1s6.rpy:366
translate latin a1s6_3f739ce1:

    # "I sigh."
    "Suspiro."

# game/a1s6.rpy:367
translate latin a1s6_72c38985:

    # m "\"Talk to me.\""
    m "\"Mecum loquere.\""

# game/a1s6.rpy:368
translate latin a1s6_69c17fb7:

    # a "\"What is there to say?\""
    a "\"Quid dicendum est?\""

# game/a1s6.rpy:369
translate latin a1s6_e499761a_2:

    # "I frown."
    "Frontem contraho."

# game/a1s6.rpy:370
translate latin a1s6_4bea4da2:

    # m "\"A lot. I'm kinda confused honestly.\""
    m "\"Multa. Ut verum dicam, aliquantum confusus sum.\""

# game/a1s6.rpy:371
translate latin a1s6_d287c430:

    # "A big, huffing sigh, then—"
    "Magnus suspiratus fremens auditur, deinde—"

# game/a1s6.rpy:372
translate latin a1s6_146d1898:

    # a "\"I like you, [mc], quite a bit in fact.\""
    a "\"Mihi places, [mc], atque valde quidem.\""

# game/a1s6.rpy:373
translate latin a1s6_c2ae1f7a:

    # m "\"I know. I like you too.\""
    m "\"Scio. Tu quoque mihi places.\""

# game/a1s6.rpy:374
translate latin a1s6_cd4b90bb:

    # "We'd technically confessed our feelings to each other when Amicus asked me on that \"date\", but only technically."
    "Proprie affectus nostros invicem iam confessi eramus, cum Amicus me ad illum \"congressum amatorium\" invitavit; sed proprie tantum."

# game/a1s6.rpy:375
translate latin a1s6_aa7aedc6:

    # m "\"Are you drunk?\""
    m "\"Ebrius es?\""

# game/a1s6.rpy:376
translate latin a1s6_2e6a67e0:

    # a "\"...Maybe a little...but I knew what I was doing.\""
    a "\"...Fortasse paulum...sed sciebam quid agerem.\""

# game/a1s6.rpy:377
translate latin a1s6_486859e8:

    # "More silence."
    "Plus silentii."

# game/a1s6.rpy:378
translate latin a1s6_74b1ef73:

    # m "\"Amicus.\""
    m "\"Amice.\""

# game/a1s6.rpy:379
translate latin a1s6_8ca1e2e3_1:

    # a "\"Hm?\""
    a "\"Hm?\""

# game/a1s6.rpy:380
translate latin a1s6_832b0432:

    # m "\"Could you look at me?\""
    m "\"Potesne me aspicere?\""

# game/a1s6.rpy:381
translate latin a1s6_2cccdee7:

    # "Amicus's ears go flat, then he slowly turns his head toward me, but his eyes are down, looking at my chest rather than my face."
    "Aures Amici capiti adhaerent; lente caput ad me vertit, sed oculos demittit et pectus meum potius quam faciem spectat."

# game/a1s6.rpy:382
translate latin a1s6_a3f87669:

    # "I think about making a \"my eyes are up here\" joke, but I know it'll fall flat with him."
    "De illo ioco \"oculi mei hic supra sunt\" cogito, sed scio eum illum non intellecturum esse."

# game/a1s6.rpy:383
translate latin a1s6_fbbab472:

    # m "\"Listen, we've already sort of talked about this. The problem is the situation we're in. It makes the whole...dating thing impossible.\""
    m "\"Audi, de hac re iam quodam modo locuti sumus. Difficultas est condicio in qua sumus. Efficit ut tota...consuetudo amatoria fieri non possit.\""

# game/a1s6.rpy:384
translate latin a1s6_5005d8cd:

    # "I see Amicus smile at the word, then frown again."
    "Amicum ad illam vocem subridere video, deinde frontem rursus contrahere."

# game/a1s6.rpy:385
translate latin a1s6_47f9e7fe:

    # a "\"I know...but if we feel the same, why not be a little closer? I know you'll have to leave soon, but that doesn't mean we can't enjoy the time we have together.\""
    a "\"Scio...sed si idem sentimus, cur non paulo artius coniungamur? Scio te mox abire debere, sed non ideo tempore nobis una dato frui non possumus.\""

# game/a1s6.rpy:386
translate latin a1s6_067872ce:

    # m "\"Sure...but I think that'll make saying goodbye a little harder, don't you?\""
    m "\"Sane...sed credo id discessum paulo difficiliorem facturum, nonne?\""

# game/a1s6.rpy:387
translate latin a1s6_8d9a2409:

    # a "\"Maybe. But we'll find a way to see each other again.\""
    a "\"Fortasse. Sed viam inveniemus qua rursus invicem videamus.\""

# game/a1s6.rpy:388
translate latin a1s6_cae6ae7a:

    # "What he's saying makes sense, but this whole situation has red flags all over it."
    "Quae dicit rationem habent, sed tota haec condicio periculorum signis plena est."

# game/a1s6.rpy:389
translate latin a1s6_4affea70:

    # "Having feelings for my abductor in a situation that's completely illegal is so wrong in so many ways."
    "Illum qui me rapuit amare, dum res omnino contra legem est, tot modis pravum est."

# game/a1s6.rpy:390
translate latin a1s6_6c7cd7fa:

    # "Amicus is talking about it like it could be an innocent fling, but this feels like more than that."
    "Amicus de hac re quasi de brevi amore innocenti loquitur, sed mihi gravior esse videtur."

# game/a1s6.rpy:391
translate latin a1s6_95d4df7f:

    # "The wolf has the the same dejected look he'd worn when he'd came out to me a few weeks ago."
    "Lupus eundem vultum deiectum habet quem gerebat cum ante aliquot hebdomadas se viros amare mihi confessus est."

# game/a1s6.rpy:392
translate latin a1s6_c879ead4:

    # "So, I reach out a hand and rest it in his paw."
    "Itaque manum porrigens in manu eius pono."

# game/a1s6.rpy:394
translate latin a1s6_b1d5dced:

    # "He looks at me then, ears still low, but his expression hopeful."
    "Tum me spectat, auribus adhuc demissis, sed vultu spe pleno."

# game/a1s6.rpy:395
translate latin a1s6_31f7ea7d:

    # m "\"Everything's just so messed up and complicated.\""
    m "\"Omnia tam perturbata ac implicata sunt.\""

# game/a1s6.rpy:397
translate latin a1s6_0082f079:

    # a "\"Yes...I'm sorry. I shouldn't have kissed you.\""
    a "\"Ita...ignosce. Te osculari non debui.\""

# game/a1s6.rpy:398
translate latin a1s6_320c31e4:

    # m "\"Maybe not...\""
    m "\"Fortasse non...\""

# game/a1s6.rpy:399
translate latin a1s6_17df0a8d:

    # "I swallow."
    "Salivam degluttio."

# game/a1s6.rpy:400
translate latin a1s6_9147498c:

    # m "\"But I liked it.\""
    m "\"Sed mihi placuit.\""

# game/a1s6.rpy:402
translate latin a1s6_e8275c27:

    # "Amicus snaps his eyes back up to look at me."
    "Amicus subito oculos rursus tollit ut me aspiciat."

# game/a1s6.rpy:403
translate latin a1s6_af121244:

    # a "\"Really?\""
    a "\"Revera?\""

# game/a1s6.rpy:404
translate latin a1s6_c806ebc0:

    # m "\"Yeah.\""
    m "\"Ita.\""

# game/a1s6.rpy:406
translate latin a1s6_d6486976:

    # "The wolf lets out a huge sigh of relief."
    "Lupus ingentem suspiratum levati animi emittit."

# game/a1s6.rpy:408
translate latin a1s6_a38a5226:

    # a "\"You didn't kiss back though. It worried me that I'd made a mistake once again.\""
    a "\"Non tamen me vicissim osculatus es. Timebam ne rursus peccavissem.\""

# game/a1s6.rpy:409
translate latin a1s6_0195d320:

    # m "\"I was surprised is all...and what do you mean, 'once again'?\""
    m "\"Miratus tantum eram...et quid dicis, 'rursus'?\""

# game/a1s6.rpy:410
translate latin a1s6_bc62fb25:

    # "The wolf seems to contemplate something, then turns on his side too, finally facing me."
    "Lupus aliquid secum cogitare videtur; deinde ipse quoque in latus se vertit, tandem ad me conversus."

# game/a1s6.rpy:412
translate latin a1s6_172e0a7f:

    # a "\"About five years ago, I shared my first kiss with another male.\""
    a "\"Ante quinque fere annos primum cum alio viro osculum communicavi.\""

# game/a1s6.rpy:413
translate latin a1s6_ba8d8248:

    # m "\"Oh?\""
    m "\"O?\""

# game/a1s6.rpy:414
translate latin a1s6_4c19475c:

    # a "\"At the time, there were rumors that I'd...performed poorly with a female my father had arranged me to be with.\""
    a "\"Tum rumores erant me...parum feliciter cum femina egisse cui pater me iunxerat.\""

# game/a1s6.rpy:415
translate latin a1s6_2d6ee573:

    # m "\"Oh.\""
    m "\"O.\""

# game/a1s6.rpy:417
translate latin a1s6_b6208523:

    # "Amicus's ears turn red."
    "Aures Amici rubescunt."

# game/a1s6.rpy:418
translate latin a1s6_6d1cb705:

    # a "\"Anyway, so this male approaches me during the summer festival. He was the son of one of the triumvirs of Tricelli. He made it very clear what he wanted from me.\""
    a "\"Itaque ille vir aestivo festo ad me accedit. Filius unius ex triumviris Tricellensibus erat. Quid a me vellet manifestissime ostendit.\""

# game/a1s6.rpy:420
translate latin a1s6_8c284b7e:

    # a "\"He kissed me on the balcony while a covert drone recorded the exchange. It was broadcast on the information channels the next day.\""
    a "\"Me in maeniano osculatus est, dum automatum occultum rem memorabat. Postridie per canales nuntiorum divulgata est.\""

# game/a1s6.rpy:421
translate latin a1s6_e499761a_3:

    # "I frown."
    "Frontem contraho."

# game/a1s6.rpy:422
translate latin a1s6_fdcfd18e:

    # m "\"Why?\""
    m "\"Cur?\""

# game/a1s6.rpy:423
translate latin a1s6_5032ff83:

    # "Amicus shrugs, looking down at the sand."
    "Amicus umeros tollit, in arenam despiciens."

# game/a1s6.rpy:424
translate latin a1s6_03c5b896:

    # a "\"The triumvir had a past grievance with my father. He used mine and his own son's sexual preferences to get back at him.\""
    a "\"Triumviro vetus simultas cum patre meo erat. Meis atque ipsius filii cupiditatibus venereis usus est ut a patre meo poenas repeteret.\""

# game/a1s6.rpy:425
translate latin a1s6_bc6da920:

    # m "\"What happened then?\""
    m "\"Quid deinde accidit?\""

# game/a1s6.rpy:427
translate latin a1s6_a906ceff:

    # a "\"Well, father used his power to shut down the networks along with banishing the triumvir and his family to {i}Ancoris{/i}.\""
    a "\"Pater potestate sua usus est ad retia nuntiorum claudenda, atque triumvirum cum familia in {i}Ancoris{/i} relegavit.\""

# game/a1s6.rpy:428
translate latin a1s6_4b3e3ce1:

    # "Amicus nods up at the sky where {i}Ancoris{/i} looms monolithically in its faded, chalky gray."
    "Amicus capite caelum indicat, ubi {i}Ancoris{/i} ingens atque immota, pallida et cinerea quasi creta, imminet."

# game/a1s6.rpy:429
translate latin a1s6_97367a05:

    # a "\"It was an unpopular decision, but father felt it had to be done. Obviously it's left me a bit worried about kissing...and pursuing other men.\""
    a "\"Decretum populo displicuit, sed pater id faciendum putavit. Scilicet inde oscula...atque alios viros quaerere paulum timeo.\""

# game/a1s6.rpy:430
translate latin a1s6_e7757e5d:

    # "I squeeze his paw."
    "Manum eius comprimo."

# game/a1s6.rpy:431
translate latin a1s6_6cdfe0e1:

    # m "\"Well, you don't have to worry about that with me, obviously. I don't know anyone here, and I'm trying to stay out of other people's business as much as possible.\""
    m "\"Mecum certe hoc timere non debes. Neminem hic novi, atque ab alienis rebus quam maxime abstinere conor.\""

# game/a1s6.rpy:433
translate latin a1s6_f27c8d9c:

    # a "\"I know.\""
    a "\"Scio.\""

# game/a1s6.rpy:434
translate latin a1s6_0cab938b:

    # "Amicus squeezes back."
    "Amicus vicissim manum comprimit."

# game/a1s6.rpy:436
translate latin a1s6_d2677040:

    # a "\"I'm still sorry though, I should have asked, or...not done it.\""
    a "\"Tamen adhuc me paenitet: rogare debui, aut...id non facere.\""

# game/a1s6.rpy:437
translate latin a1s6_5eee7f91:

    # m "\"You're fine.\""
    m "\"Bene est.\""

# game/a1s6.rpy:438
translate latin a1s6_4c07a1a9:

    # "Another stretch of silence, and I get the feeling that Amicus is waiting for an answer which he confirms with what he says next."
    "Iterum aliquamdiu tacemus; sentio Amicum responsum exspectare, quod proximis verbis confirmat."

# game/a1s6.rpy:440
translate latin a1s6_a58437d3:

    # a "\"So...if you're fine with it, did you want to...date me?\""
    a "\"Itaque...si tibi placet, visne...mecum consuetudinem amatoriam incipere?\""

# game/a1s6.rpy:441
translate latin a1s6_01836e48:

    # "Amicus says the foreign word very carefully, and for a moment the Lingua skips a beat in its steady translation, allowing him to speak the word unfiltered."
    "Amicus vocem peregrinam cautissime pronuntiat; paulisper Lingua translationem continuam intermittit, ita ut vox eius sine translatione audiatur."

# game/a1s6.rpy:442
translate latin a1s6_31eb523f:

    # "It's still his voice, but the heavy accent that comes through is surprising, even a little sexy."
    "Vox adhuc eius est, sed gravis peregrina pronuntiatio quae auditur mihi mira est, ac paulum etiam me allicit."

# game/a1s6.rpy:443
translate latin a1s6_591179fc:

    # "I know I should say no though, the red flags fluttering ominously around our precarious, even dangerous situation."
    "Scio tamen me negare debere; periculi signa circa condicionem nostram incertam, immo periculosam, ominose volitant."

# game/a1s6.rpy:444
translate latin a1s6_80f1b8ae:

    # m "\"I'll...think about it over the next few days, then let you know.\""
    m "\"Ego...de hac re per proximos dies cogitabo, deinde te certiorem faciam.\""

# game/a1s6.rpy:445
translate latin a1s6_e65c3ebd:

    # "Amicus smiles a little."
    "Amicus paulum subridet."

# game/a1s6.rpy:447
translate latin a1s6_d9660094:

    # a "\"Okay.\""
    a "\"Bene.\""

# game/a1s6.rpy:448
translate latin a1s6_e5d25c7a:

    # m "\"But you need to be focusing on the trial, so no thinking about this while I'm deciding.\""
    m "\"Sed animum ad certamen advertere debes; dum ego delibero, tu de hac re ne cogitaveris.\""

# game/a1s6.rpy:450
translate latin a1s6_99851fb5:

    # a "\"Of course!\""
    a "\"Profecto!\""

# game/a1s6.rpy:451
translate latin a1s6_18e41726:

    # "I groan inwardly as I realize I've just added another distraction to the wolf's goal of becoming emperor."
    "Intus gemo, cum intellego me aliud impedimentum addidisse lupo imperium adipisci cupienti."

# game/a1s6.rpy:452
translate latin a1s6_914a3804:

    # m "\"You promise this won't distract you?\""
    m "\"Promittisne te hac re non distractum iri?\""

# game/a1s6.rpy:454
translate latin a1s6_8d1f5b0c:

    # a "\"Definitely not!\""
    a "\"Nullo modo me distrahet!\""

# game/a1s6.rpy:455
translate latin a1s6_c6b63358:

    # "I give the wolf a look of disbelief and he responds with a glare."
    "Lupum incredulus aspicio; ille iratus me vicissim intuetur."

# game/a1s6.rpy:457
translate latin a1s6_408a0e39:

    # a "\"[mc], I've wanted this my entire life. I know it might not have seemed like it earlier, but I'm taking this very, very seriously.\""
    a "\"[mc], hoc per totam vitam cupivi. Scio antea fortasse aliter visum esse, sed rem gravissime, gravissime ago.\""

# game/a1s6.rpy:458
translate latin a1s6_aec069e4:

    # m "\"And I won't be a distraction?\""
    m "\"Me igitur animum tuum distracturum non putas?\""

# game/a1s6.rpy:460
translate latin a1s6_ef7eca93:

    # a "\"Of course not, in fact I think it would be rather positive for me to know that you...return my feelings to some degree. It gives me even more confidence.\""
    a "\"Minime. Immo, puto mihi valde prodesse scire te...affectibus meis aliquatenus respondere. Id mihi etiam maiorem fiduciam dat.\""

# game/a1s6.rpy:461
translate latin a1s6_bc8ec571:

    # m "\"Oh God, no...\""
    m "\"O Deus, non...\""

# game/a1s6.rpy:463
translate latin a1s6_4b87ac29:

    # a "\"Hey.\""
    a "\"Heus.\""

# game/a1s6.rpy:464
translate latin a1s6_042d6add:

    # "Amicus sets a paw on my shoulder and it looks like he wants to lean in and kiss me again...but he doesn't."
    "Amicus manum umero meo imponit et rursus ad me inclinaturus atque me osculaturus videtur...sed non facit."

# game/a1s6.rpy:465
translate latin a1s6_879bb97d:

    # a "\"Thank you for understanding and for putting up with me. I have a good feeling about...well, everything now.\""
    a "\"Gratias quod me intellegis atque toleras. Nunc de...omnibus bene spero.\""

# game/a1s6.rpy:467
translate latin a1s6_07b98246:

    # "I don't know how much I agree considering our situation is causing us so many problems, but I set my hand on his paw anyway."
    "Nescio quantum consentiam, cum condicio nostra tot difficultates nobis faciat; tamen manum meam in eius manu pono."

# game/a1s6.rpy:468
translate latin a1s6_910f899d:

    # m "\"Sure.\""
    m "\"Sane.\""

# game/a1s6.rpy:472
translate latin a1s6_026faffd:

    # "Our relationship after that conversation is...strange, to say the least."
    "Post illum sermonem necessitudo nostra...mira est, ut parcissime dicam."

# game/a1s6.rpy:473
translate latin a1s6_6aafc7fe:

    # "While it felt meaningful at the time, I realize later that we didn't really get anywhere except once again admit to the feelings we'd been having over the past few weeks."
    "Quamquam tum gravis visus est, postea intellego nos nihil fere profecisse, nisi quod rursus affectus confessi sumus quos per superiores hebdomadas senseramus."

# game/a1s6.rpy:474
translate latin a1s6_7944cb56:

    # "Amicus is extra careful about touching me now, probably because he doesn't want me to misconstrue it for something more than it is."
    "Amicus nunc me tangere cautissime curat, probabiliter ne ego tactum plus significare quam vere significat putem."

# game/a1s6.rpy:475
translate latin a1s6_1a540000:

    # "At the same time, our conversations have become less casual and joking, more stiff and awkward."
    "Simul sermones nostri minus faciles ac iocosi, magis rigidi atque incompositi facti sunt."

# game/a1s6.rpy:476
translate latin a1s6_5fbbfa50:

    # "I hate it."
    "Id odi."

# game/a1s6.rpy:477
translate latin a1s6_4a0abce1:

    # "In any other situation, I'd want to just sit down and talk my feelings out with the person...but Amicus is different."
    "Quavis alia condicione sederem et de affectibus meis cum illo homine loqui vellem...sed Amicus alius est."

# game/a1s6.rpy:478
translate latin a1s6_285613fb:

    # "First of all, he's an alien, and having the feelings that I do for an alien, a wolf alien at that, is weird."
    "Primum, alienigena est; hos affectus erga alienigenam habere, atque alienigenam lupum quidem, mirum est."

# game/a1s6.rpy:479
translate latin a1s6_c29a880d:

    # "Secondly, this relationship, this closeness...it's just not important in the grand scheme of things."
    "Deinde, haec necessitudo, haec familiaritas...in summa rerum non magni momenti est."

# game/a1s6.rpy:480
translate latin a1s6_271987f9:

    # "We're currently doing something so illegal that, if it were to be found out, it could bring the entire empire to a stand-still...at least more than it already is."
    "Nunc rem tam illicitam agimus ut, si cognoscatur, totum imperium impedire possit...saltem magis quam iam impeditum est."

# game/a1s6.rpy:481
translate latin a1s6_7ec783c5:

    # "So instead of playing out one of the cheesy, wolven romance dramas I've seen on Adastran television, maybe instead I should be focusing on how the hell I'm going to exist in this empire, especially if the second trial falls through."
    "Potius igitur quam unam ex ineptis fabulis amatoriis Luporum agere quas in televisione Adastrana vidi, fortasse cogitare debeam quomodo tandem in hoc imperio vivere possim, praesertim si secundum certamen male cedat."

# game/a1s6.rpy:482
translate latin a1s6_bf0874e3:

    # "But..."
    "Sed..."

# game/a1s6.rpy:483
translate latin a1s6_73543f56:

    # "Amicus wants a relationship with me, that much he's made clear."
    "Amicus mecum consuetudinem amatoriam vult; id certe manifestum fecit."

# game/a1s6.rpy:484
translate latin a1s6_baf2f0d1:

    # "I just wonder if it truly would help him like he says it will, or if he's just saying that so I'll give him what he wants."
    "Tantum miror num vere eum, ut dicit, iuvet, an id tantum dicat ut quod cupit ei dem."

# game/a1s6.rpy:485
translate latin a1s6_1436494c:

    # "I don't doubt that the wolf likes me...maybe even more than that, but we've only known each other for about a month."
    "Non dubito quin lupo placeam...fortasse plus etiam sentit; sed nos invicem unum fere mensem tantum novimus."

# game/a1s6.rpy:486
translate latin a1s6_dbb5c5e5:

    # "Do we really even know anything about each other?"
    "Num revera quidquam alter de altero scimus?"

# game/a1s6.rpy:487
translate latin a1s6_ed03d88d:

    # "Despite all of this, and after a few days of thinking about it, I start to warm up to the idea."
    "His omnibus tamen perpensis, atque post aliquot dies cogitationis, consilium mihi placere incipit."

# game/a1s6.rpy:488
translate latin a1s6_71deefe7:

    # "We both know it'll be short, an \"innocent fling\" like I'd thought of it earlier."
    "Ambo scimus rem brevem fore: \"brevem amorem innocentem\", ut antea putaveram."

# game/a1s6.rpy:489
translate latin a1s6_1c1b7d1c:

    # "I could be leaving for Earth any time in the next month, but..."
    "Quolibet tempore intra proximum mensem in Terram abire possim, sed..."

# game/a1s6.rpy:490
translate latin a1s6_37025632:

    # "I can't deny that I really like him too."
    "Negare non possum eum mihi quoque valde placere."

# game/a1s6.rpy:491
translate latin a1s6_0cd01972:

    # "An innocent fling."
    "Brevis amor innocens."

# game/a1s6.rpy:492
translate latin a1s6_2c3adb65:

    # "The more I say that in my head, the better it sounds."
    "Quo saepius haec mente repeto, eo melius sonant."

# game/a1s6.rpy:493
translate latin a1s6_c706f54d:

    # "Despite everything, knowing that I could have a relationship with an alien, the son of an emperor...actually, someone who will likely become the emperor...that's kinda cool."
    "Omnibus difficultatibus neglectis, consuetudinem amatoriam cum alienigena, imperatoris filio...immo, eo qui probabiliter imperator futurus est, habere posse...id satis mirum ac iucundum est."

# game/a1s6.rpy:494
translate latin a1s6_c5ca5916:

    # "Besides, he did say it would help him with his confidence for the trial."
    "Praeterea, dixit id fiduciam suam in certamine adiuturum esse."

# game/a1s6.rpy:495
translate latin a1s6_9b53820e:

    # "And finally, I'm tired of this awkwardness between us."
    "Postremo, haec difficultas inter nos me taedet."

# game/a1s6.rpy:496
translate latin a1s6_9d513c18:

    # "Amicus is my friend, and I want to be able to talk normally with him again."
    "Amicus mihi amicus est, et rursus libere cum eo loqui volo."

# game/a1s6.rpy:497
translate latin a1s6_8cb14575:

    # "I'm pretty sure making things official will clear everything up."
    "Satis certus sum, si rem aperte constituamus, omnia expedita fore."

# game/a1s6.rpy:499
translate latin a1s6_5bc77da6:

    # "I just have to go about doing it the right way...."
    "Tantum recte id agere debeo...."

# game/a1s6.rpy:503
translate latin a1s6_f626817f:

    # "The day before the trial, Amicus shoos me and Alex out into the gardens."
    "Pridie certaminis, Amicus me et Alex in hortos emittit."

# game/a1s6.rpy:504
translate latin a1s6_aec368b1:

    # "It's strange, but he tells us that they need to be tended to considering that the camera drones are going to sweep over the grounds for an opening shot before the second trial begins."
    "Mirum est, sed dicit hortos curandos esse, quoniam automata cum instrumentis visificis ante initium secundi certaminis supra aream volabunt ut primam imaginem sumant."

# game/a1s6.rpy:505
translate latin a1s6_9d5a2334:

    # "It's the first time he's ever really asked me to do a task, and when I point that out to him, he says that he also needs time alone to practice his speech."
    "Primum vere mihi opus faciendum commisit; cum id ei dico, respondet se etiam solum esse debere ut orationem exerceat."

# game/a1s6.rpy:506
translate latin a1s6_58b03902:

    # "That makes sense, but it's still a little odd."
    "Id rationem habet, sed adhuc paulum mirum est."

# game/a1s6.rpy:507
translate latin a1s6_cab39af7:

    # "Alex and I stand in the gardens, picking at the weeds just like I had on my first day at the palace."
    "Alex et ego in hortis stamus, herbas inutiles vellentes sicut primo meo die in palatio feci."

# game/a1s6.rpy:508
translate latin a1s6_46a8e7b8:

    # "It's hard to believe a month's gone by, even with the nineteen hour days."
    "Vix credo mensem iam praeteriisse, quamquam dies undeviginti horas habent."

# game/a1s6.rpy:509
translate latin a1s6_12f1477f:

    # "I guess it's been about three weeks in Earth time."
    "Credo tres fere hebdomadas tempore Terrae praeteriisse."

# game/a1s6.rpy:510
translate latin a1s6_dbe614e9:

    # "I get to work pulling up the small white flowers, the ones that seem to grow in every crevice of the garden."
    "Operam do exiguis floribus albis evellendis, qui in omni hortorum rima nasci videntur."

# game/a1s6.rpy:511
translate latin a1s6_1fc9980c:

    # m "\"You'd think the drones would be smart enough to take care of the weeds themselves.\""
    m "\"Crederes automata satis callida esse ut ipsa herbas inutiles curarent.\""

# game/a1s6.rpy:513
translate latin a1s6_bc7092f3:

    # al "\"Well, they don't have appendages to pull with. All they could really do is use their high-powered lasers, but that risks starting fires.\""
    al "\"Membra quibus evellant non habent. Solum radiis lasericis potentissimis uti possent, sed ita incendia excitari possunt.\""

# game/a1s6.rpy:514
translate latin a1s6_fdf10af1:

    # m "\"The drones have lasers?\""
    m "\"Automata radios lasericos habent?\""

# game/a1s6.rpy:516
translate latin a1s6_b90d68c5:

    # al "\"Oh yes, they need some form of a defense mechanism.\""
    al "\"O, ita; aliquo instrumento ad se defendenda egent.\""

# game/a1s6.rpy:517
translate latin a1s6_887e49fb:

    # m "\"Huh...\""
    m "\"Ah...\""

# game/a1s6.rpy:519
translate latin a1s6_129bbb13:

    # al "\"I mean, it's not like they'd ever use it on you. Even if they did, it's not enough to kill you, at least not quickly. Just leaves nasty burns.\""
    al "\"Non quod illis umquam in te uterentur. Etiamsi uterentur, non satis valent ut te necent, saltem non cito. Tantum graves ustiones relinquunt.\""

# game/a1s6.rpy:520
translate latin a1s6_d985ab4e:

    # "I find myself continuing to glance up at an Adastran spider sitting motionlessly on the wall of the palace."
    "Saepe rursus ad araneam Adastranam suspicio, quae in muro palatii immota sedet."

# game/a1s6.rpy:521
translate latin a1s6_f1c804af:

    # m "\"Wish they'd use them on those hideous things.\""
    m "\"Utinam illis in ista foeda animalia uterentur.\""

# game/a1s6.rpy:522
translate latin a1s6_d68ebc49:

    # "It takes Alex a moment to see what I'm looking at."
    "Alex paulisper indiget ut perspiciat quid spectem."

# game/a1s6.rpy:524
translate latin a1s6_9998f481:

    # al "\"Oh, [mc], you know those are important for the—\""
    al "\"O, [mc], scis illa magni momenti esse ad—\""

# game/a1s6.rpy:525
translate latin a1s6_c7379c40:

    # m "\"—Ecosystem, yeah, I know. Doesn't make them any less disgusting. Imagine one of those things biting you.\""
    m "\"—Systema naturae, ita, scio. Non ideo minus foeda sunt. Finge unum ex illis te mordere.\""

# game/a1s6.rpy:527
translate latin a1s6_8d86e210:

    # al "\"Indeed, though honestly I've been vaccinated so many times after coming to Adastra that sharp, pointy things don't scare me so much anymore.\""
    al "\"Certe; sed, ut verum dicam, postquam in Adastram veni, totiens contra morbos inoculatus sum ut res acutae ac cuspidatae me iam minus terreant.\""

# game/a1s6.rpy:528
translate latin a1s6_06461156:

    # "We work quietly for a few more minutes, Alex lazily humming as I try to think of a way to bring something up that I've wanted to talk about with the cat."
    "Aliquot minuta taciti laboramus; Alex otiose cantum murmurat, dum ego excogito quomodo rem attingam de qua cum fele loqui volui."

# game/a1s6.rpy:529
translate latin a1s6_cc7caf8c:

    # m "\"Soo...\""
    m "\"Igiturr...\""

# game/a1s6.rpy:531
translate latin a1s6_6a14791d:

    # al "\"So?\""
    al "\"Igitur?\""

# game/a1s6.rpy:532
translate latin a1s6_089992ea:

    # "I watch as Alex's paws work fast, plucking the weeds with speed and precision."
    "Manus Alex celeriter operari specto, herbas inutiles cito et accurate evellentes."

# game/a1s6.rpy:533
translate latin a1s6_248037af:

    # m "\"What's your relationship with Cassius like?\""
    m "\"Qualis necessitudo tibi cum Cassio est?\""

# game/a1s6.rpy:535
translate latin a1s6_51494e54:

    # "I see Alex's paws freeze for a moment, then quickly return to their work, the dirty pile of weeds next to him growing larger and larger on the marble floor."
    "Manus Alex paulisper immobiles fieri video, deinde cito operi reddi; sordidus herbarum acervus iuxta eum in solo marmoreo magis magisque crescit."

# game/a1s6.rpy:537
translate latin a1s6_fb01ca70:

    # al "\"Our relationship? You already know that, [mc]. I'm his pet! Just like you are Amicus's pet.\""
    al "\"Necessitudo nostra? Iam scis, [mc]. Ego deliciae eius sum! Sicut tu Amici deliciae es.\""

# game/a1s6.rpy:539
translate latin a1s6_513a3f23:

    # "He smiles at me."
    "Mihi subridet."

# game/a1s6.rpy:540
translate latin a1s6_210cd0ce:

    # "At this point, I decide to stop letting the cat play his little game with me."
    "Iam statuo feli non amplius permittere ut mecum hunc ludiculum agat."

# game/a1s6.rpy:541
translate latin a1s6_82f3bc38:

    # "I give him a look that says \"oh, come on\" and I see his ears fall a bit."
    "Eum obtutu aspicio qui significat \"o, age\"; aures eius paulum demitti video."

# game/a1s6.rpy:543
translate latin a1s6_07682022:

    # al "\"What?\""
    al "\"Quid?\""

# game/a1s6.rpy:544
translate latin a1s6_742fd088:

    # m "\"You know exactly what. I think it's pretty obvious the two of you are...I dunno, something more.\""
    m "\"Plane scis quid. Satis manifestum puto vos duos esse...nescio, aliquid amplius.\""

# game/a1s6.rpy:545
translate latin a1s6_d09b4171:

    # "This is the first time I've called the cat out on his polite-pet-facade, and I see that it's thrown him off a bit."
    "Primum felem de hac specie animalis domestici urbani aperte interrogo; eum paulum perturbatum esse video."

# game/a1s6.rpy:546
translate latin a1s6_4abd8564:

    # "His ears are down and he's staring hard at his paws, pushing through the weeds, though he's no longer plucking them."
    "Aures demissae sunt, et manus suas intentissime spectat, herbas agitans quamquam eas non iam vellit."

# game/a1s6.rpy:547
translate latin a1s6_04da5387:

    # al "\"That's...such a forward question, [mc].\""
    al "\"Ista...quaestio nimis directa est, [mc].\""

# game/a1s6.rpy:548
translate latin a1s6_7c030a2a:

    # "I wonder if his demeanor just has to do with his cat modesty, or if there are actual laws against pet-master relationships."
    "Miror num mores eius tantum ex modestia felium oriantur, an leges vere sint quae amorem inter delicias et dominos prohibeant."

# game/a1s6.rpy:549
translate latin a1s6_d2f94f43:

    # m "\"Come on, we're friends...besides, I want some advice.\""
    m "\"Age, amici sumus...praeterea, consilio egeo.\""

# game/a1s6.rpy:550
translate latin a1s6_7718cb9c:

    # "Now his ears perk up a little bit."
    "Nunc aures eius paulum eriguntur."

# game/a1s6.rpy:552
translate latin a1s6_79bc60eb:

    # al "\"Oh? With what?\""
    al "\"O? De qua re?\""

# game/a1s6.rpy:553
translate latin a1s6_fafbeb8d:

    # m "\"Well, first I wanna know if...you know, something's going on between you and Cassius, then I'll know if you can answer.\""
    m "\"Primum scire volo num...scis, aliquid inter te et Cassium agatur; tum sciam num respondere possis.\""

# game/a1s6.rpy:554
translate latin a1s6_a0d17728:

    # "Alex sighs huffily and sits back on his rear, looking a bit childish with his legs and feet splayed out in front of himself."
    "Alex fremens suspirat et in clunibus recumbit; paulum puerilis videtur, cruribus pedibusque ante se late patentibus."

# game/a1s6.rpy:556
translate latin a1s6_dc99c3a9:

    # al "\"I don't know why it matters.\""
    al "\"Nescio cur referat.\""

# game/a1s6.rpy:557
translate latin a1s6_c77d898a:

    # m "\"Well, I don't know how things are on Omorfa, but where I'm from, friends talk about their relationships with each other. It's actually strange NOT to tell your friend about who you're in a relationship with.\""
    m "\"Nescio quomodo res in Omorfa se habeant; sed unde ego venio, amici de amoribus suis invicem loquuntur. Mirum quidem est amico NON dicere quem ames.\""

# game/a1s6.rpy:558
translate latin a1s6_33eba1a4:

    # "Though his ears are folded down, I can see how red they are"
    "Quamquam aures eius demissae sunt, videre possum quam rubrae sint"

# game/a1s6.rpy:560
translate latin a1s6_40108085:

    # al "\"We're...not in an official relationship. But there are...feelings between us, yes.\""
    al "\"Nos...necessitudinem certo definitam non habemus. Sed inter nos...affectus sunt, ita.\""

# game/a1s6.rpy:561
translate latin a1s6_0b4eb0fa_1:

    # m "\"Really?\""
    m "\"Revera?\""

# game/a1s6.rpy:562
translate latin a1s6_8355aed4:

    # "Alex snaps his gaze to mine."
    "Alex subito oculos meis occurrere facit."

# game/a1s6.rpy:564
translate latin a1s6_33aebe61:

    # al "\"Why do you sound so surprised?\""
    al "\"Cur tam miratus videris?\""

# game/a1s6.rpy:565
translate latin a1s6_a9c79b6f:

    # "I'm not surprised just...fascinated."
    "Non miratus sum, tantum...rem curiosissime cognoscere cupio."

# game/a1s6.rpy:566
translate latin a1s6_99cc6bb2:

    # m "\"I'm not! You two are just really...different.\""
    m "\"Non miror! Vos duo tantum valde...dissimiles estis.\""

# game/a1s6.rpy:568
translate latin a1s6_4310fe89:

    # al "\"How so?\""
    al "\"Quomodo?\""

# game/a1s6.rpy:569
translate latin a1s6_840cb9f6:

    # m "\"I mean, do I have to explain it?\""
    m "\"Num id explicare debeo?\""

# game/a1s6.rpy:570
translate latin a1s6_8ea94acb:

    # "Alex is quiet."
    "Alex tacet."

# game/a1s6.rpy:571
translate latin a1s6_f596d547:

    # m "\"Well, you're so reserved and quiet and he's so...\""
    m "\"Tu tam taciturnus ac quietus es, ille autem tam...\""

# game/a1s6.rpy:572
translate latin a1s6_1c3e1e53:

    # "Now that I know Alex actually likes Cassius, I don't wanna be too offensive."
    "Nunc scio Alex Cassium vere amare; eum nimis offendere nolo."

# game/a1s6.rpy:573
translate latin a1s6_0ed720a8:

    # m "\"...Cassius.\""
    m "\"...Cassius.\""

# game/a1s6.rpy:574
translate latin a1s6_ab09fa2f:

    # "Alex sighs."
    "Alex suspirat."

# game/a1s6.rpy:575
translate latin a1s6_510ccf9e:

    # al "\"Yes, Cassius is very {i}Cassius{/i}, but there's a lot more to him than what he puts out in public.\""
    al "\"Ita, Cassius valde {i}Cassius{/i} est; sed multo plura in eo sunt quam quae palam ostendit.\""

# game/a1s6.rpy:576
translate latin a1s6_e5b57225:

    # m "\"So...you like him?\""
    m "\"Igitur...tibi placet?\""

# game/a1s6.rpy:577
translate latin a1s6_0f53f4b3:

    # al "\"Parts of him, yes.\""
    al "\"Quaedam eius partes, ita.\""

# game/a1s6.rpy:578
translate latin a1s6_45a5c501:

    # "Alex has lowered his voice to the point where I almost can't hear him, so I do the same."
    "Alex vocem adeo submisit ut eum vix audiam; ego idem facio."

# game/a1s6.rpy:579
translate latin a1s6_c488276d:

    # m "\"So are you in like, a relationship? I don't know what they're called on Adastra.\""
    m "\"Ergo quasi amantes estis? Nescio quo nomine in Adastra appellentur.\""

# game/a1s6.rpy:580
translate latin a1s6_1cce24ff:

    # "Alex bristles."
    "Alex pilos erigit."

# game/a1s6.rpy:582
translate latin a1s6_854a206d:

    # al "\"Well, It is simply called a relationship. The only official status is marriage, but that's only between males and females.\""
    al "\"Simpliciter necessitudo amatoria appellatur. Sola condicio publice constituta est matrimonium, sed illud tantum inter viros et feminas est.\""

# game/a1s6.rpy:583
translate latin a1s6_b3e52829:

    # m "\"What about between males?\""
    m "\"Quid inter viros?\""

# game/a1s6.rpy:585
translate latin a1s6_289dc334:

    # al "\"There is none. Why are you so curious?\""
    al "\"Nulla est. Cur tam curiosus es?\""

# game/a1s6.rpy:586
translate latin a1s6_6b095d94:

    # "Alex looks at me carefully, eyes narrowed."
    "Alex me caute spectat, oculis contractis."

# game/a1s6.rpy:587
translate latin a1s6_8619f2c6:

    # "I shrug."
    "Umeros tollo."

# game/a1s6.rpy:588
translate latin a1s6_226b3843:

    # m "\"Just wondering. I like to learn about the culture I'm in.\""
    m "\"Tantum miror. Libenter cultum disco in quo versor.\""

# game/a1s6.rpy:590
translate latin a1s6_6a040d90:

    # al "\"I see...are you interested in Amicus?\""
    al "\"Intellego...Amicum amas?\""

# game/a1s6.rpy:591
translate latin a1s6_12e19aad:

    # "Now it's my turn to blush."
    "Nunc mihi rubescendum est."

# game/a1s6.rpy:592
translate latin a1s6_74ff3f5f:

    # m "\"I—no.\""
    m "\"Ego—non.\""

# game/a1s6.rpy:594
translate latin a1s6_8daacd9f:

    # al "\"[mc], you can tell me. I thought we were friends?\""
    al "\"[mc], mihi dicere potes. Credebam nos amicos esse.\""

# game/a1s6.rpy:595
translate latin a1s6_5fd7cf77:

    # "I get the feeling that Alex is a lot better than me at these \"games\"."
    "Sentio Alex his \"ludis\" multo peritiorem quam me esse."

# game/a1s6.rpy:596
translate latin a1s6_f5e38064:

    # m "\"I...I don't know honestly, but I guess I was wondering how I'd go about it if I decided to...\""
    m "\"Ego...revera nescio; sed credo me scire voluisse quomodo agerem, si statuerem...\""

# game/a1s6.rpy:598
translate latin a1s6_c96df9c0:

    # al "\"Awww, that's adorable!\""
    al "\"Awww, quam venustum!\""

# game/a1s6.rpy:599
translate latin a1s6_34f5e986:

    # "All I can do in response is blush a deeper shade of red."
    "Solum etiam vehementius rubescere possum."

# game/a1s6.rpy:601
translate latin a1s6_14017022:

    # al "\"So you're asking how to tell a wolf that you're interested?\""
    al "\"Quaeris igitur quomodo lupo dicas eum tibi placere?\""

# game/a1s6.rpy:602
translate latin a1s6_6bff4e6b:

    # m "\"...Yeah.\""
    m "\"...Ita.\""

# game/a1s6.rpy:603
translate latin a1s6_2c1f1c1f:

    # al "\"Well, between males, it usually happens naturally, without saying so. If you haven't noticed, there's a stigma against same-sex relationships on Adastra.\""
    al "\"Inter viros plerumque sponte fit, sine verbis. Si nondum animadvertisti, amores eiusdem sexus in Adastra infames habentur.\""

# game/a1s6.rpy:605
translate latin a1s6_cbf024fd:

    # al "\"Leaving the status of a relationship unsaid makes it less likely that you'll be found out.\""
    al "\"Si necessitudo verbis non declaratur, minus facile detegitur.\""

# game/a1s6.rpy:606
translate latin a1s6_a3506f66:

    # "I think for a moment."
    "Paulisper cogito."

# game/a1s6.rpy:607
translate latin a1s6_cad3097c:

    # "Amicus seemed to want me to make the relationship \"official\"."
    "Amicus videbatur velle ut necessitudinem nostram \"clare definirem\"."

# game/a1s6.rpy:608
translate latin a1s6_5c605d27:

    # "I guess he's just going by my standards, then."
    "Credo igitur eum morem meum tantum sequi."

# game/a1s6.rpy:609
translate latin a1s6_82379599:

    # "He probably wants me to ask him to date me, Earth-style."
    "Probabiliter vult ut eum ad consuetudinem amatoriam more Terrae invitem."

# game/a1s6.rpy:610
translate latin a1s6_835dac22:

    # "Alex goes back to plucking some of the weeds."
    "Alex rursus quasdam herbas vellere incipit."

# game/a1s6.rpy:612
translate latin a1s6_af883914:

    # al "\"However, I feel that things are changing, though very slowly. Honestly, someone like Amicus becoming emperor would be really something.\""
    al "\"Tamen res mutari sentio, quamquam lentissime. Ut verum dicam, aliquem talem qualis Amicus imperatorem fieri magni momenti esset.\""

# game/a1s6.rpy:613
translate latin a1s6_28505312:

    # "I'm about to ask Alex how prominent the rumors are about Amicus when I suddenly hear footsteps."
    "Alex interrogaturus sum quam vulgati rumores de Amico sint, cum subito passus audio."

# game/a1s6.rpy:614
translate latin a1s6_2e4800b6:

    # "I look up, half-expecting to see the wolf, but instead..."
    "Suspicio, lupum fere exspectans videre; sed potius..."

# game/a1s6.rpy:617
translate latin a1s6_7d71a2ab:

    # "Cato simply stares at us, his paws behind his back as usual."
    "Cato nos tantum intuetur, manibus more suo post tergum positis."

# game/a1s6.rpy:618
translate latin a1s6_e6182cec:

    # "A moment of silence goes by before Alex suddenly stumbles to his feet, paws clasped in front of himself before bowing low."
    "Paulisper silentium est; tum Alex subito titubans surgit, manibus ante se coniunctis, deinde alte se inclinat."

# game/a1s6.rpy:620
translate latin a1s6_99148e6b:

    # "I quickly follow suit, a few seconds behind the cat."
    "Statim eum imitor, paucis secundis post felem."

# game/a1s6.rpy:621
translate latin a1s6_705b99aa:

    # "As I bow, I notice how dirty my robe is at the knees."
    "Dum me inclino, animadverto quam sordida ad genua tunica mea sit."

# game/a1s6.rpy:622
translate latin a1s6_1bdff6e0:

    # "Alex remains bowed so I do the same, listening as Cato's footsteps come closer."
    "Alex inclinatus manet; ego idem facio, audiens passus Catonis appropinquare."

# game/a1s6.rpy:623
translate latin a1s6_58654c26:

    # "He stops a few feet away, and I can see his worn, blunt claws at the top of my vision."
    "Paucis pedibus a nobis consistit; in summo obtutu ungues eius detritos atque obtusos videre possum."

# game/a1s6.rpy:624
translate latin a1s6_33a6f95a:

    # "He stands there for a very long time, not saying anything, forcing me and Alex to remain stooped."
    "Diutissime ibi stat, nihil dicens, me et Alex cogens inclinatos manere."

# game/a1s6.rpy:625
translate latin a1s6_f8bc8e40:

    # "As my back starts to ache, I realize that he must be doing this on purpose."
    "Cum dorsum meum dolere incipit, intellego eum sine dubio id consulto facere."

# game/a1s6.rpy:626
translate latin a1s6_44da688f:

    # "Are we in trouble for something?"
    "Num ob aliquid in culpa sumus?"

# game/a1s6.rpy:627
translate latin a1s6_ab5ddbc4:

    # "Finally he speaks, and I almost jump."
    "Tandem loquitur, atque ego paene exsilio."

# game/a1s6.rpy:628
translate latin a1s6_f8e53764:

    # ca "\"Alexios, [mc], how are you this afternoon?\""
    ca "\"Alexios, [mc], quomodo vos habetis hoc postmeridiano tempore?\""

# game/a1s6.rpy:629
translate latin a1s6_5763a621:

    # "Alex straightens up and I do the same, stifling my groan of relief."
    "Alex se erigit; ego idem facio, gemitum levati animi cohibens."

# game/a1s6.rpy:630
translate latin a1s6_a4855f33:

    # "If Alex is sore, he's not showing it at all as he fixes a smile on his face."
    "Si Alex dolet, nihil ostendit, dum risum vultui suo imponit."

# game/a1s6.rpy:632
translate latin a1s6_6ab04d85:

    # al "\"Wonderful, Your Imperial Majesty. I hope the same is for you?\""
    al "\"Optime, Maiestas Imperialis. Spero te quoque bene valere?\""

# game/a1s6.rpy:633
translate latin a1s6_400f735b:

    # "I open my mouth, trying to think of something to say, though Alex didn't leave me much room to do so."
    "Os aperio, conans aliquid dicendum excogitare, quamquam Alex mihi parum loci reliquit."

# game/a1s6.rpy:634
translate latin a1s6_26fe5207:

    # "That doesn't seem to matter though, as Cato starts speaking, reminding me that I'm still supposed to be a near-mute primitive."
    "Id tamen nihil referre videtur, cum Cato loqui incipit, me admonens me adhuc barbarum paene mutum simulare debere."

# game/a1s6.rpy:636
translate latin a1s6_1f30b2fd:

    # ca "\"Sadly no, Alexios. I was just in the city today, and I was hearing some unfortunate rumors amongst the officials.\""
    ca "\"Heu, non, Alexios. Hodie modo in urbe fui, et quosdam rumores infaustos inter magistratus audiebam.\""

# game/a1s6.rpy:637
translate latin a1s6_fa5b4290:

    # "Another long pause."
    "Iterum longa mora."

# game/a1s6.rpy:639
translate latin a1s6_f2c8d145:

    # al "\"O-oh?\""
    al "\"O-o?\""

# game/a1s6.rpy:641
translate latin a1s6_bc21ceff:

    # "The corner of Cato's mouth twitches and while I usually have a hard time knowing what the old wolf is thinking, I can tell that right now he's not happy."
    "Angulus oris Catonis movetur; quamquam plerumque aegre scio quid lupus senex cogitet, nunc eum minime laetum esse intellego."

# game/a1s6.rpy:642
translate latin a1s6_4271e1a2:

    # ca "\"Indeed. Rumors about Cassius and his intentions involving the Triumvirates if he becomes emperor.\""
    ca "\"Certe. Rumores de Cassio atque de consiliis eius erga triumviratus, si imperator fiat.\""

# game/a1s6.rpy:643
translate latin a1s6_0106de1d:

    # "It takes me a moment to know what they're talking about, then I remember..."
    "Paulo tempore mihi opus est ut intellegam de quo loquantur; deinde memini..."

# game/a1s6.rpy:645
translate latin a1s6_595a95b6:

    # al "\"The Triumvirates? I wonder why?\""
    al "\"De triumviratibus? Miror cur.\""

# game/a1s6.rpy:646
translate latin a1s6_1f4ef8b1:

    # "Alex puts on a very innocent, confused look, even though I know that he knows what this is about."
    "Alex vultum innocentissimum atque confusum simulat, quamquam scio eum scire de qua re agatur."

# game/a1s6.rpy:647
translate latin a1s6_20723980:

    # ca "\"I wonder as well, which is why I'm curious to know if either of you have heard the rumor, or possibly the source of the rumor?\""
    ca "\"Ego quoque miror. Ideo scire cupio num alteruter vestrum rumorem audiverit, vel fortasse unde ortus sit noverit.\""

# game/a1s6.rpy:648
translate latin a1s6_889522ec:

    # "Immediately, I feel sweat starting to break out on my forehead, and I'm glad that I'm already sweating from the heat."
    "Statim sudorem in fronte oriri sentio; gaudeo me iam ob calorem sudare."

# game/a1s6.rpy:650
translate latin a1s6_7ffe344a:

    # al "\"I am sorry to say that I do not know, Your Imperial Majesty.\""
    al "\"Doleo me nescire, Maiestas Imperialis.\""

# game/a1s6.rpy:651
translate latin a1s6_70dd9eb5:

    # "Another moment of silence goes by, and that's when I notice that Cato's waiting for me to answer."
    "Iterum paulisper tacetur; tum animadverto Catonem meum responsum exspectare."

# game/a1s6.rpy:652
translate latin a1s6_5f753372:

    # "I choke on my words for a moment, adjusting my brain to \"dumb ape\" mode."
    "Verba paulisper in faucibus haerent, dum animum ad modum \"simiae stultae\" compono."

# game/a1s6.rpy:653
translate latin a1s6_dd312eeb:

    # m "\"Uhhhh...what is trimvirites?\""
    m "\"Ahhh...quid trumvirates est?\""

# game/a1s6.rpy:654
translate latin a1s6_18c391de:

    # "Cato's mouth twitches again."
    "Os Catonis rursus movetur."

# game/a1s6.rpy:655
translate latin a1s6_04fd830c:

    # ca "\"Anyway, I'm on my way to Cassius's room to let him know the news. Please accompany me, Alexios.\""
    ca "\"Ceterum, ad cubiculum Cassii eo ut eum de nuntiis certiorem faciam. Mecum veni, Alexios.\""

# game/a1s6.rpy:657
translate latin a1s6_4462d8b9:

    # al "\"Yes, Emperor.\""
    al "\"Ita, Imperator.\""

# game/a1s6.rpy:658
translate latin a1s6_6abe3801:

    # "Alex quickly hops to attention as Cato turns with a twirl of his robes, heading back up the path as Alex quickly follows."
    "Alex statim se paratum praebet, dum Cato, tunica circumvolante, se vertit et per semitam redit; Alex cito sequitur."

# game/a1s6.rpy:662
translate latin a1s6_b855350b:

    # "I'm left to stand there alone for a moment, watching the two of them disappear amongst the bushes."
    "Solus paulisper ibi sto, ambos inter frutices evanescentes spectans."

# game/a1s6.rpy:663
translate latin a1s6_1fa5371b:

    # "So...someone had told some of the officials about Cassius's plans to eliminate the triumvirates."
    "Igitur...aliquis quibusdam magistratibus dixit Cassium triumviratus tollere velle."

# game/a1s6.rpy:664
translate latin a1s6_1eecac80:

    # "Despite Alex's innocent act, I assume it had to be him."
    "Quamquam Alex innocentem simulat, credo ipsum fuisse."

# game/a1s6.rpy:665
translate latin a1s6_1ee1e16c:

    # "Either that, or it was Virginia."
    "Aut ille, aut Virginia erat."

# game/a1s6.rpy:666
translate latin a1s6_48ffb1c5:

    # "I wonder if Cato is already suspicions about Alex and, if that's the case, if it could all come back to me."
    "Miror num Cato Alex iam suspectum habeat, atque, si ita sit, num res tandem ad me redire possit."

# game/a1s6.rpy:667
translate latin a1s6_05fb68ce:

    # "I hope not."
    "Spero non."

# game/a1s6.rpy:668
translate latin a1s6_dc02440c:

    # "The idea of playing politics amongst these passive-aggressive wolves is not at all appealing."
    "In rebus publicis cum his lupis, qui iram occulte sub blanditiis celant, versari mihi minime placet."

# game/a1s6.rpy:670
translate latin a1s6_54d4eefe:

    # "I spend a few more hours weeding the gardens on my own, knowing that I won't be able to make much progress alone."
    "Aliquot horas solus herbas inutiles in hortis vello, sciens me solum parum proficere posse."

# game/a1s6.rpy:671
translate latin a1s6_1bf38d7f:

    # "After a while, I meander around the gardens a bit, wanting to go back inside, but not really wanting to bother Amicus while he studies."
    "Aliquanto post, paulum per hortos erro; intro redire cupio, sed Amicum studentem molestare nolo."

# game/a1s6.rpy:672
translate latin a1s6_f23d4fe0:

    # "While I'm doing that though, I think more and more about what Alex and I had been talking about."
    "Dum autem ita ago, magis magisque de sermone meo cum Alex cogito."

# game/a1s6.rpy:673
translate latin a1s6_04a61c81:

    # "Should I just confess my feelings to Amicus, and close the awkward gap between us?"
    "Num affectus meos Amico simpliciter confitear, ut incompositam distantiam inter nos tollam?"

# game/a1s6.rpy:674
translate latin a1s6_05993ee6:

    # "I know it's weighing on his mind."
    "Scio rem animum eius gravare."

# game/a1s6.rpy:675
translate latin a1s6_dcf31dac:

    # "Maybe asking him out will give him that boost that he needs to win?"
    "Fortasse, si eum ad amorem invitem, illam vim animi ei dabo qua ad vincendum eget?"

# game/a1s6.rpy:676
translate latin a1s6_166428b2:

    # "Maybe I'm just trying to convince myself, but I realize that it is something that I want to do."
    "Fortasse mihi tantum persuadere conor; sed intellego me id vere agere velle."

# game/a1s6.rpy:677
translate latin a1s6_35ae1ce9:

    # "And if I'm going to do it, it's probably best to do it before the trial, to set his mind at ease."
    "Si id faciam, probabiliter ante certamen facere optimum erit, ut animus eius tranquillior sit."

# game/a1s6.rpy:678
translate latin a1s6_91b227ef:

    # "Carefully, I pick a few flowers from the gardens, not making the giant bouquet that Amicus had made for his own proposal, but enough to look nice, at least in my opinion."
    "Caute aliquot flores ex hortis carpo; non tam magnum fasciculum facio quam Amicus ad suam invitationem fecerat, sed satis saltem pulchrum, mea quidem sententia."

# game/a1s6.rpy:680
translate latin a1s6_1f8853fb:

    # "As I walk to the the wolf's room, I have enough time to second-guess myself."
    "Dum ad cubiculum lupi ambulo, satis temporis habeo ut de consilio rursus dubitem."

# game/a1s6.rpy:681
translate latin a1s6_6e21b2e7:

    # "Maybe this isn't such a good idea..."
    "Fortasse hoc consilium non tam bonum est..."

# game/a1s6.rpy:682
translate latin a1s6_d8f9e2b1:

    # "My heart is hammering in my chest as I approach the wolf's door, and I'm sure my face is bright red."
    "Cor in pectore vehementer pulsat dum ad ianuam lupi accedo; certus sum faciem meam valde rubere."

# game/a1s6.rpy:684
translate latin a1s6_85dc99b7:

    # "I try to keep my breathing under control as I stand in front of the door."
    "Ante ianuam stans, spiritum moderari conor."

# game/a1s6.rpy:685
translate latin a1s6_f162fa90:

    # "What should I say?"
    "Quid dicam?"

# game/a1s6.rpy:686
translate latin a1s6_c9cc48c6:

    # "Maybe just imitate what the wolf did back when he asked me out?"
    "Fortasse tantum imiter quae lupus fecit cum me invitavit?"

# game/a1s6.rpy:687
translate latin a1s6_579a87f5:

    # "Yeah, that'll be funny and cute, right?"
    "Ita, id iocosum atque venustum erit, nonne?"

# game/a1s6.rpy:688
translate latin a1s6_29c732e7:

    # "As I start to feel myself getting cold feet, I just reach up to the panel, pressing it, deciding to just throw myself into this."
    "Cum timidior fieri incipio, manum ad tabulam tollo eamque premo, statuens me sine cunctatione huic rei committere."

# game/a1s6.rpy:692
translate latin a1s6_f7a38885:

    # "The scene that I come upon is probably the last one I would have ever expected."
    "Scaena quam invenio probabiliter ultima est quam umquam exspectavissem."

# game/a1s6.rpy:693
translate latin a1s6_997a1e4a:

    # "At first, I think the two of them are fighting."
    "Primo puto ambos pugnare."

# game/a1s6.rpy:694
translate latin a1s6_786da5f1:

    # "Neferu and Amicus obviously have some kind of tension going on between them, so seeing the jackal splayed out on the bed while Amicus growled and snarled above him, pinning him down..."
    "Inter Neferu et Amicum manifeste quaedam contentio est; itaque, cum chacalum in lecto porrectum video, Amico supra eum fremente atque ringente et eum detinente..."

# game/a1s6.rpy:695
translate latin a1s6_818bb412:

    # "...well, a fight is all that would come to my mind."
    "...pugna sola mihi in mentem veniret."

# game/a1s6.rpy:696
translate latin a1s6_b73d0e78:

    # "But, after a few more seconds of staring open-mouthed at the scene in front of me, I slowly realize what's actually happening."
    "Sed post aliquot secunda, quibus ore aperto scaenam ante me positam aspicio, lente intellego quid revera fiat."

# game/a1s6.rpy:697
translate latin a1s6_b34360ca:

    # "While Amicus might be snarling, Neferu is letting out grunts and groans that are clearly full of pleasure"
    "Amicus quidem ringitur, sed Neferu gemitus murmuraque emittit quae voluptate manifeste plena sunt"

# game/a1s6.rpy:698
translate latin a1s6_bb7c9fe7:

    # "His face and body say it all too, the jackal writhing and twisting under the wolf, pawing at him as he says words that don't translate through the Lingua."
    "Facies quoque et corpus eius rem plane ostendunt: chacalus sub lupo se torquet atque contorquet, eum manibus tangens, dum verba dicit quae Lingua non vertit."

# game/a1s6.rpy:699
translate latin a1s6_3e96d2f7:

    # "If that isn't enough to tell me exactly what's going on, then the jackal's slick, pink cock bouncing against his tightened abs is."
    "Si haec nondum satis clare rem mihi ostendunt, mentula chacali lubrica ac rosea, contra abdomen tensum saliens, certe ostendit."

# game/a1s6.rpy:700
translate latin a1s6_fe88a4a3:

    # "I guess the sounds they're making covered up the sound of the door opening, because neither of them look up."
    "Credo sonos quos faciunt sonum ianuae apertae texisse, quia neuter suspicit."

# game/a1s6.rpy:701
translate latin a1s6_11b3c0ac:

    # "Instead, they both continue to go at it while I stare in shock."
    "Ambo potius agere pergunt, dum ego stupens specto."

# game/a1s6.rpy:702
translate latin a1s6_77c20b8f:

    # "A part of me doesn't want to make any sudden movements so as not to attract their attention while the other part of me just stares in fascination, never having seen anything like this before."
    "Pars mei subito moveri non vult, ne animum eorum ad me avertam; altera autem curiosissime spectat, cum nihil tale umquam viderim."

# game/a1s6.rpy:703
translate latin a1s6_20dabe5f:

    # "A few times, Neferu tries to reach up and touch Amicus's face and each time the wolf bats it away, or pins the paw down."
    "Aliquoties Neferu manum tollit ut faciem Amici tangat; totiens lupus eam repellit aut detinet."

# game/a1s6.rpy:704
translate latin a1s6_cb2d181d:

    # "Amicus seems irritated almost, like he's more annoyed about the situation than anything else."
    "Amicus fere irritatus videtur, quasi res eum potius vexet quam quidquam aliud."

# game/a1s6.rpy:705
translate latin a1s6_d3b470d8:

    # "Neferu is practically the opposite, somehow maintaining that trademark smirk of his while this is all going down."
    "Neferu fere contrarius est: nescio quomodo illum suum risum callidum servat, dum haec omnia fiunt."

# game/a1s6.rpy:708
translate latin a1s6_72a280f6:

    # "And then, of all the moments for me to walk in on their little session, they seem to reach their peak."
    "Deinde, ex omnibus momentis quibus parvum eorum congressum deprehendere poteram, eo ipso quo ingressus sum culmen attingere videntur."

# game/a1s6.rpy:709
translate latin a1s6_22cb7a32:

    # "Neferu lets out a series of short moans, a strange sound coming from someone as refined and reserved as he is."
    "Neferu breves gemitus continuos emittit, sonum mirum ab aliquo tam eleganti ac modesto."

# game/a1s6.rpy:710
translate latin a1s6_e47d1392:

    # "I can see the results as it splatters against his torso and muzzle, his hips jerking frantically as his face morphs into a look of strained pleasure."
    "Quod effundit in truncum rostrumque aspergi video; coxae eius violenter moventur, dum vultus in speciem voluptatis intentae mutatur."

# game/a1s6.rpy:711
translate latin a1s6_3bce09c6:

    # "Meanwhile, Amicus's moan is long and deep as he thrusts harder into the jackal, freezing up before practically melting over the other canine."
    "Interim gemitus Amici longus atque gravis est, dum se vehementius in chacalum impellit; rigidus consistit, deinde quasi liquefactus supra alterum canem procumbit."

# game/a1s6.rpy:712
translate latin a1s6_4fc04d43:

    # "His expression is a lot more goofy, and despite myself, I find myself thinking that this is exactly how I'd imagine his orgasm face."
    "Vultus eius multo stultior est; invitus cogito eum prorsus talem esse qualem vultum eius in orgasmo imaginatus essem."

# game/a1s6.rpy:713
translate latin a1s6_8eb02432:

    # "I just sort of take this all in, still trying to understand what the hell is going on."
    "Haec omnia quodam modo accipio, adhuc conans intellegere quid tandem agatur."

# game/a1s6.rpy:714
translate latin a1s6_915991ff:

    # "I mean, I know what's going on, but I don't know why."
    "Scio quidem quid agatur; sed nescio cur."

# game/a1s6.rpy:715
translate latin a1s6_6f4563b8:

    # "There's a certain amount of horror that goes with my reaction, as if I'd just walked in on my parents doing it."
    "Horroris aliquid responsum meum comitatur, quasi parentes meos coeuntes deprehendissem."

# game/a1s6.rpy:716
translate latin a1s6_d1634775:

    # "I guess I'm at least glad that I'm seeing it at this angle, which means I can't see what's going going on under Neferu's hips."
    "Saltem gaudeo me ex hoc latere spectare, unde ea quae sub coxis Neferu aguntur videre non possum."

# game/a1s6.rpy:717
translate latin a1s6_4f7481a2:

    # "I realize then that I need to get the hell out before they see me."
    "Tum intellego me abire debere antequam me videant."

# game/a1s6.rpy:718
translate latin a1s6_8d7b6f14:

    # "As they both gasp in their sticky mess, I slowly start to back out, but that's when the door automatically closes behind me."
    "Dum ambo in mixtura glutinosa anhelant, lente retrocedere incipio; sed tum ianua post me sponte clauditur."

# game/a1s6.rpy:720
translate latin a1s6_3a694796:

    # "Now that things are quiet, nothing covers up that sound, and Neferu and Amicus look up at me as one."
    "Nunc, cum res quietae sint, nihil illum sonum tegit; Neferu et Amicus una ad me suspiciunt."

# game/a1s6.rpy:722
translate latin a1s6_7da0e4e5:

    # "I stand there, feeling as if I'm in a dream as they both stare at me."
    "Ibi sto, quasi in somnio sim, dum ambo me intuentur."

# game/a1s6.rpy:723
translate latin a1s6_9741745f:

    # "I must look like an idiot; my robe dirty from the gardens, flowers dangling from my right hand, my mouth hanging open in fascinated horror."
    "Stultus plane videri debeo: tunica ob hortos sordida, floribus e dextra pendentibus, ore in admiratione atque horrore aperto."

# game/a1s6.rpy:724
translate latin a1s6_8d7f409e:

    # "Amicus looks most shocked of all though, and I can see a million thoughts running through his head, clearly not having wanted me to see this."
    "Amicus tamen maxime omnium attonitus videtur; innumeras cogitationes per caput eius currere video, manifesto nolentis me haec videre."

# game/a1s6.rpy:725
translate latin a1s6_2f54482c:

    # "His reasons for sending me and Alex out to do menial yard work is very clear now."
    "Cur me et Alex ad humilem hortorum laborem emiserit nunc manifestissimum est."

# game/a1s6.rpy:726
translate latin a1s6_565d74c2:

    # "Neferu, for his part, isn't wearing his usual, suave smirk."
    "Neferu vero non solitum risum suum elegantem gerit."

# game/a1s6.rpy:727
translate latin a1s6_51a68e6d:

    # "Instead, it's surprised and maybe even a little guilty, like not even he wanted me to see this."
    "Potius miratus, ac fortasse paulum etiam reus, videtur, quasi ne ipse quidem me haec videre voluerit."

# game/a1s6.rpy:728
translate latin a1s6_7effd1ff:

    # "I open my mouth."
    "Os aperio."

# game/a1s6.rpy:729
translate latin a1s6_9046708a:

    # m "\"I—\""
    m "\"Ego—\""

# game/a1s6.rpy:730
translate latin a1s6_478abab4:

    # "But then any will to smooth over the situation somehow, make a joke of it even, leaves me."
    "Sed omnis voluntas rem quoquo modo componendi, vel etiam iocum de ea faciendi, me deserit."

# game/a1s6.rpy:731
translate latin a1s6_e23fad40:

    # "With both their eyes on me, I turn and almost run into the door, having to drop the flowers on the ground to press the panel."
    "Ambobus me spectantibus, me verto et paene in ianuam impingo; flores in terram deponere debeo ut tabulam premam."

# game/a1s6.rpy:732
translate latin a1s6_7102c223:

    # "Somehow, I feel even worse than I had when I'd left the throne room in disgrace after the dance."
    "Nescio quomodo, etiam peius me sentio quam cum post saltationem dedecore affectus e regia aula abii."

# game/a1s6.rpy:734
translate latin a1s6_732dc1ae:

    # "The door slides open and the next thing I know, I'm jogging out into the hall."
    "Ianua labitur aperta; mox iam in ambulacrum curro."

# game/a1s6.rpy:735
translate latin a1s6_ccb476b9:

    # "As I do, I hear Amicus struggling for words."
    "Dum eo, Amicum verba aegre quaerentem audio."

# game/a1s6.rpy:736
translate latin a1s6_dc58f367:

    # a "\"[mc], w-wait!\""
    a "\"[mc], e-exspecta!\""

# game/a1s6.rpy:737
translate latin a1s6_7e20f4f3:

    # "There's some rustling sounds, followed by a yelp from Neferu before the door slides shut and the only sounds are my echoing footsteps."
    "Murmura frictionis audiuntur, deinde clamor Neferu; ianua labitur clausa, et soli soni sunt passus mei resonantes."

# game/a1s6.rpy:740
translate latin a1s6_4a1ec749:

    # "I'm not sure where I'm going, I just know that I need to get as far as I can from that...{i}situation{/i}."
    "Nescio quo eam; tantum scio me quam longissime ab illa...{i}re{/i} abire debere."

# game/a1s6.rpy:741
translate latin a1s6_be07158e:

    # "What I just saw is only now sinking in, and so is the hurt."
    "Nunc demum quae modo vidi intellego; nunc quoque dolor penetrat."

# game/a1s6.rpy:742
translate latin a1s6_8ae1a176:

    # "What the fuck?"
    "Quid, malum?"

# game/a1s6.rpy:743
translate latin a1s6_cec2b5a8:

    # "That fucking wolf tells me he's in love with me...or at least interested in me, and the next thing I know he's fucking that jackal?"
    "Iste maledictus lupus dicit se me amare...aut saltem me cupere; mox autem illum chacalum futuit?"

# game/a1s6.rpy:744
translate latin a1s6_caf62aaf:

    # "What the FUCK!?"
    "Quid, MALUM!?"

# game/a1s6.rpy:745
translate latin a1s6_6daaba99:

    # "I guess I'm more angry than hurt."
    "Credo me magis iratum quam maestum esse."

# game/a1s6.rpy:746
translate latin a1s6_89abbe39:

    # "I must have looked like such an idiot standing there while one of them was getting railed."
    "Quam stultus videri debui ibi stans, dum alter tam vehementer futuebatur."

# game/a1s6.rpy:747
translate latin a1s6_e27c8b0e:

    # "And to walk in on THAT moment."
    "Atque ILLUD ipsum tempus ingressus sum."

# game/a1s6.rpy:748
translate latin a1s6_ef20c3ef:

    # "Neferu had been so clearly into it, and Amicus looked so mean and aggressive."
    "Neferu tam manifeste fruebatur, Amicus autem tam saevus atque ferox videbatur."

# game/a1s6.rpy:749
translate latin a1s6_38b77c94:

    # "The whole thing was just awful."
    "Tota res horrenda erat."

# game/a1s6.rpy:750
translate latin a1s6_1dc8190a:

    # "Well...awful to walk in on unexpectedly."
    "Saltem...horrendum erat eam improviso deprehendere."

# game/a1s6.rpy:751
translate latin a1s6_16f03285:

    # "In another context..."
    "Alia condicione..."

# game/a1s6.rpy:752
translate latin a1s6_c238bbc5:

    # "My vision blurs for a moment, but I refuse to let myself cry over something that wasn't even going to be serious."
    "Obtutus meus paulisper turbatur, sed me flere ob rem quae ne gravis quidem futura erat non sino."

# game/a1s6.rpy:753
translate latin a1s6_bb24307a:

    # "I was going to offer Amicus that stupid \"fling\", and that was it."
    "Illum stultum \"brevem amorem\" Amico propositurus eram, nihil amplius."

# game/a1s6.rpy:754
translate latin a1s6_4b9e468a:

    # "He wasn't obligated to have eyes only for me."
    "Non tenebatur me solum cupere."

# game/a1s6.rpy:755
translate latin a1s6_59b1cab1:

    # "In fact, I KNEW he was into Neferu, we'd already discussed it."
    "Immo, SCIEBAM Neferu eum allicere; iam de ea re locuti eramus."

# game/a1s6.rpy:756
translate latin a1s6_a2f41661:

    # "So this is fine, this was expected."
    "Itaque bene est; hoc exspectandum erat."

# game/a1s6.rpy:757
translate latin a1s6_daddeae8:

    # "Actually, I wasn't even expecting anything."
    "Revera, ne quidquam quidem exspectabam."

# game/a1s6.rpy:758
translate latin a1s6_10705cca:

    # "No, the reason I'm so embarrassed and feel like shit right now is because I walked in on two alien dogs butt-fucking."
    "Non: tam confusus atque miser nunc sum quia duos canes alienigenas deprehendi, altero alterum pedicante."

# game/a1s6.rpy:759
translate latin a1s6_4bc7e7e4:

    # "That was weird and messed up, and I just need to collect my thoughts for a moment..."
    "Id mirum ac pravum erat; tantum paulisper cogitationes colligere debeo..."

# game/a1s6.rpy:760
translate latin a1s6_438a3d47:

    # "That's when I realize that I don't really know where I am in the palace."
    "Tum intellego me revera nescire ubi in palatio sim."

# game/a1s6.rpy:761
translate latin a1s6_4355bcaf:

    # "Most of the hallways look the same, and this one is no exception, though I know I'm deeper in than I've been before."
    "Pleraque ambulacra similia sunt, neque hoc ab aliis differt; tamen scio me altius intus esse quam antea fuerim."

# game/a1s6.rpy:762
translate latin a1s6_27b7f10b:

    # a "\"[mc]!\""
    a "\"[mc]!\""

# game/a1s6.rpy:763
translate latin a1s6_12b16b0f:

    # "Amicus's footsteps pound against the floor behind me."
    "Passus Amici post me contra solum feriunt."

# game/a1s6.rpy:765
translate latin a1s6_5c4699cf:

    # "I don't know how far away he is considering the echoing halls can be deceptive, but I immediately take a right through a particularly large set of double doors."
    "Nescio quantum absit, quoniam ambulacra resonantia fallere possunt; sed statim dextrorsum per praegrandes fores duplices verto."

# game/a1s6.rpy:770
translate latin a1s6_dd8191b9:

    # "The room I walk into is full of smells, good ones, like a garden."
    "Cubiculum quod intro plenum est odoribus bonis, quasi hortus."

# game/a1s6.rpy:771
translate latin a1s6_d7a65232:

    # "The air is cool and fresh even as afternoon light pours in from an opening in the ceiling."
    "Aer frigidus ac recens est, quamquam lux postmeridiana per foramen laquearis infunditur."

# game/a1s6.rpy:772
translate latin a1s6_ebe1bf36:

    # "All the while, there's the sound of a soft trickling of water from a small fountain in the center of the room."
    "Interim aquae leniter e parvo fonte in medio cubiculo fluentes audiuntur."

# game/a1s6.rpy:773
translate latin a1s6_f75b274f:

    # "I stand there for a moment, eyes scanning for anyone else that might be here."
    "Paulisper ibi sto, oculis quaerens num quis alius hic sit."

# game/a1s6.rpy:774
translate latin a1s6_be66ccfb:

    # "When I don't see anyone, I move closer to the center of the room, looking around at the flowers and plants as I try to calm my hammering heart."
    "Cum neminem video, propius ad medium cubiculum accedo, flores et plantas circumspiciens, dum cor vehementer pulsans sedare conor."

# game/a1s6.rpy:775
translate latin a1s6_1cbaf26b:

    # "I know Amicus is probably going to find me soon, all he has to do is ask Com."
    "Scio Amicum probabiliter mox me inventurum: tantum Computatrum interrogare debet."

# game/a1s6.rpy:776
translate latin a1s6_258b7ab6:

    # "So I fold my arms, trying to look casual, realizing now that it would have just been better for me to hang out in the hall, maybe laugh when Amicus came out."
    "Bracchia igitur complico et tranquillum me simulare conor; nunc intellego melius fuisse in ambulacro manere, fortasse ridere cum Amicus exiret."

# game/a1s6.rpy:777
translate latin a1s6_277964ae:

    # "I'd have made a joke and acted like it wasn't a big deal...but it's way too late for that now."
    "Iocum fecissem et rem parvi momenti simulassem...sed iam nimis sero est."

# game/a1s6.rpy:778
translate latin a1s6_7661bbb2:

    # "Sure enough, the door slides open and Amicus stumbles in in his underwear, his fur completely mussed up, chest heaving for breath."
    "Ut exspectabam, ianua labitur aperta et Amicus subligaculum gerens titubando intrat, pilo prorsus turbato, pectore anhelante."

# game/a1s6.rpy:780
translate latin a1s6_4b8785d6:

    # a "\"[mc], I—I need to talk...about...\""
    a "\"[mc], ego—ego loqui debeo...de...\""

# game/a1s6.rpy:782
translate latin a1s6_933f9502:

    # "He doubles over, paws on his knees as he gasps in his air."
    "Alte se incurvat, manibus genibus impositis, dum spiritum aegre haurit."

# game/a1s6.rpy:783
translate latin a1s6_e86412c6:

    # "I cringe as I see my flowers clutched in one of his paws."
    "Horreo cum flores meos in altera eius manu compressos video."

# game/a1s6.rpy:784
translate latin a1s6_ed4cae1c:

    # "But I still try to look casual, keeping my arms folded."
    "Tamen tranquillum me simulare conor, bracchiis adhuc complicatis."

# game/a1s6.rpy:785
translate latin a1s6_df8ec4bc:

    # m "\"What?\""
    m "\"Quid?\""

# game/a1s6.rpy:786
translate latin a1s6_c5335163:

    # a "\"About...what you just saw.\""
    a "\"De...iis quae modo vidisti.\""

# game/a1s6.rpy:787
translate latin a1s6_45c1f55f:

    # m "\"Don't worry about it.\""
    m "\"Noli de ea re sollicitari.\""

# game/a1s6.rpy:788
translate latin a1s6_a13cf2aa:

    # "I shrug before busying myself with brushing off my robes so they don't look so dirty."
    "Umeros tollo, deinde me ad tunicam detergendam converto, ne tam sordida videatur."

# game/a1s6.rpy:789
translate latin a1s6_86a714a8:

    # a "\"No, I want to explain what...what happened.\""
    a "\"Non, explicare volo quid...quid acciderit.\""

# game/a1s6.rpy:790
translate latin a1s6_883a3745:

    # m "\"You don't need to explain it. It's none of my business.\""
    m "\"Explicare non debes. Res mea non est.\""

# game/a1s6.rpy:791
translate latin a1s6_75bf4905:

    # a "\"Well, it is.\""
    a "\"Immo, est.\""

# game/a1s6.rpy:792
translate latin a1s6_b517b6c3:

    # m "\"It's definitely not!\""
    m "\"Minime est!\""

# game/a1s6.rpy:794
translate latin a1s6_32513967:

    # "I snap at the wolf."
    "Lupo iratus respondeo."

# game/a1s6.rpy:795
translate latin a1s6_6f094e1b:

    # m "\"Who you fuck is none of my business! That's all up to you. Don't let me tell you who you can and can't be with.\""
    m "\"Quos futuas, me non spectat! Totum in tua potestate est. Ne mihi permittas dicere quibuscum esse possis aut non possis.\""

# game/a1s6.rpy:797
translate latin a1s6_9025a899:

    # "Amicus frowns deeply at me."
    "Amicus me fronte vehementer contracta intuetur."

# game/a1s6.rpy:798
translate latin a1s6_3c8805f7:

    # a "\"What?\""
    a "\"Quid?\""

# game/a1s6.rpy:799
translate latin a1s6_d9282d11:

    # m "\"You heard me. I don't wanna hear about it. I'm not here for this shit anyway.\""
    m "\"Me audivisti. De ea re audire nolo. Neque propter has sordes hic sum.\""

# game/a1s6.rpy:800
translate latin a1s6_fafeac4b:

    # a "\"Here for what?\""
    a "\"Propter quid hic es?\""

# game/a1s6.rpy:801
translate latin a1s6_0f70f97c:

    # m "\"For—\""
    m "\"Propter—\""

# game/a1s6.rpy:802
translate latin a1s6_ff5fcb8a:

    # "I throw my hands up in frustration."
    "Manus iratus in altum iacio."

# game/a1s6.rpy:803
translate latin a1s6_9cc7ce57:

    # m "\"What just happened. For sex, or love, or whatever the hell it is you guys do. Whatever it is you told me you wanted on the island.\""
    m "\"Quod modo accidit. Propter venerem, aut amorem, aut quidquid tandem vos agitis. Quidquid in insula dixisti te velle.\""

# game/a1s6.rpy:804
translate latin a1s6_965fa014:

    # "I point at the flowers in his paw."
    "Flores in manu eius digito indico."

# game/a1s6.rpy:805
translate latin a1s6_0e00e31f:

    # m "\"I'm just trying to get home.\""
    m "\"Tantum domum redire conor.\""

# game/a1s6.rpy:806
translate latin a1s6_aa1d743f:

    # "I feel my eyes threatening to water up again, and I stubbornly swallow that down right quick."
    "Sentio oculos rursus lacrimis impleri velle; pertinaciter id statim cohibeo."

# game/a1s6.rpy:808
translate latin a1s6_08cc00b8:

    # a "\"No! That's not what that was! {i}Please{/i}, let me explain.\""
    a "\"Non! Non id erat! {i}Quaeso{/i}, me explicare sine.\""

# game/a1s6.rpy:809
translate latin a1s6_6a20a80d:

    # "I shake my head."
    "Caput quatio."

# game/a1s6.rpy:810
translate latin a1s6_80c1d63a:

    # m "\"You guys have sex, it's not a big deal, I get it. Humans can be like that too.\""
    m "\"Vos coitis, neque res magni momenti est; intellego. Homines quoque ita agere possunt.\""

# game/a1s6.rpy:811
translate latin a1s6_335fed4d:

    # "Amicus takes a step forward, but I take one back."
    "Amicus unum passum procedit, sed ego retrocedo."

# game/a1s6.rpy:812
translate latin a1s6_737b093d:

    # m "\"I guess it's just a little fucked up that you confessed your feelings two days ago, and then suddenly you're just fucking another guy.\""
    m "\"Tantum paulum pravum videtur te ante duos dies affectus tuos confessum esse, deinde subito alium virum futuere.\""

# game/a1s6.rpy:813
translate latin a1s6_37ed35b3:

    # "This is all so ridiculous."
    "Haec omnia tam absurda sunt."

# game/a1s6.rpy:814
translate latin a1s6_889094be:

    # "Not only the situation I'm in, but the fact that I feel so hurt by the wolf, even though nothing has really happened between us except an alcohol-fueled kiss."
    "Non solum condicio in qua sum, sed etiam quod tam graviter a lupo laesus me sentio, quamquam inter nos nihil vere accidit praeter osculum vino excitatum."

# game/a1s6.rpy:815
translate latin a1s6_78c61f5c:

    # "Amicus takes another step forward, his paws up, staring wide-eyed at me."
    "Amicus rursus procedit, manibus elatis, oculis late patentibus me spectans."

# game/a1s6.rpy:816
translate latin a1s6_809a142c:

    # a "\"That's not what happened, and if you'll let me explain...\""
    a "\"Non id accidit, et si me explicare sinas...\""

# game/a1s6.rpy:817
translate latin a1s6_f55b408e:

    # m "\"Then what did I just see?\""
    m "\"Quid igitur modo vidi?\""

# game/a1s6.rpy:818
translate latin a1s6_82d7b300:

    # a "\"What you saw...it was...more of a transaction than anything.\""
    a "\"Quod vidisti...erat...magis permutatio quam quidquam aliud.\""

# game/a1s6.rpy:819
translate latin a1s6_60db651e:

    # m "\"What, of cum?\""
    m "\"Quid, seminis?\""

# game/a1s6.rpy:820
translate latin a1s6_916f225e:

    # "Amicus chokes in surprise."
    "Amicus miratus verba in faucibus comprimit."

# game/a1s6.rpy:822
translate latin a1s6_890c1f15:

    # a "\"Well...yes, I guess, but I made a deal with the Khemian.\""
    a "\"Ita...credo; sed cum Khemiano pactus sum.\""

# game/a1s6.rpy:823
translate latin a1s6_e5edecfb:

    # m "\"What deal?\""
    m "\"Quid pactus es?\""

# game/a1s6.rpy:825
translate latin a1s6_cb639cb4:

    # a "\"Well, I'm sure you remember our problems with Cassius?\""
    a "\"Certe difficultates nostras cum Cassio meministi?\""

# game/a1s6.rpy:826
translate latin a1s6_0f6cb2ba:

    # m "\"About him wanting to murder me?\""
    m "\"Quod me trucidare vult?\""

# game/a1s6.rpy:827
translate latin a1s6_b79cea14:

    # a "\"Yes, that problem.\""
    a "\"Ita, illam difficultatem.\""

# game/a1s6.rpy:828
translate latin a1s6_43c58380:

    # m "\"What about it?\""
    m "\"Quid de ea?\""

# game/a1s6.rpy:829
translate latin a1s6_a315656e:

    # a "\"Well, I did say it wasn't something you should worry about, but like I also said, I'm taking all precautions.\""
    a "\"Dixi quidem te non debere sollicitari; sed, ut etiam dixi, omnia remedia parare conor.\""

# game/a1s6.rpy:830
translate latin a1s6_9b78ca0f:

    # m "\"Yeah?\""
    m "\"Quid?\""

# game/a1s6.rpy:831
translate latin a1s6_df013a0b:

    # a "\"Yes. So...\""
    a "\"Ita. Igitur...\""

# game/a1s6.rpy:832
translate latin a1s6_3b4f9b88:

    # "The wolf pauses."
    "Lupus paulisper tacet."

# game/a1s6.rpy:833
translate latin a1s6_df8ec4bc_1:

    # m "\"What?\""
    m "\"Quid?\""

# game/a1s6.rpy:835
translate latin a1s6_994d7526:

    # a "\"I realize now that I should have consulted you on this, but it was my only immediate option...\""
    a "\"Nunc intellego me te de hac re consulere debuisse; sed sola facultas mihi statim praesto erat...\""

# game/a1s6.rpy:836
translate latin a1s6_f72c76f6:

    # m "\"What option?\""
    m "\"Quae facultas?\""

# game/a1s6.rpy:837
translate latin a1s6_5fcd3352:

    # a "\"Well, while Cassius might be willing to execute MY pet, he wouldn't dare touch the pet of a Khemian.\""
    a "\"Cassius fortasse delicias MEAS interficere velit, sed delicias Khemiani tangere non audeat.\""

# game/a1s6.rpy:838
translate latin a1s6_df8ec4bc_2:

    # m "\"What?\""
    m "\"Quid?\""

# game/a1s6.rpy:839
translate latin a1s6_f7ff6a29:

    # "The wolf rubs behind his neck with one paw and speaks very quickly."
    "Lupus altera manu posteriorem cervicis partem fricat et celerrime loquitur."

# game/a1s6.rpy:840
translate latin a1s6_5168e1a9:

    # a "\"If I were to lose the second trial, I made it so that your ownership would transfer to Neferu. You'd become his pet.\""
    a "\"Si secundum certamen amitterem, providi ut dominium tui ad Neferu transferretur. Deliciae eius fieres.\""

# game/a1s6.rpy:841
translate latin a1s6_f1edb6ac:

    # "I stare at the wolf."
    "Lupum intueor."

# game/a1s6.rpy:842
translate latin a1s6_594f9a8f:

    # a "\"This would ensure that Cassius would not dare come after you. If he did, it might upset the very delicate relations we have with the Khemians.\""
    a "\"Hoc efficere potest ut Cassius te persequi non audeat. Si faceret, necessitudines nostras iam fragillimas cum Khemianis perturbaret.\""

# game/a1s6.rpy:843
translate latin a1s6_3b13c900:

    # "A moment of silence passes."
    "Paulisper tacetur."

# game/a1s6.rpy:844
translate latin a1s6_c0e87107:

    # m "\"So I'd become Neferu's pet?\""
    m "\"Deliciae igitur Neferu fierem?\""

# game/a1s6.rpy:846
translate latin a1s6_d99a54ae:

    # a "\"If I somehow lose the trial, yes.\""
    a "\"Si quo modo certamen amittam, ita.\""

# game/a1s6.rpy:847
translate latin a1s6_f1edb6ac_1:

    # "I stare at the wolf."
    "Lupum intueor."

# game/a1s6.rpy:848
translate latin a1s6_13629e33:

    # a "\"Are you okay with that?\""
    a "\"Tibi id placet?\""

# game/a1s6.rpy:849
translate latin a1s6_6ae30550:

    # m "\"Amicus...\""
    m "\"Amice...\""

# game/a1s6.rpy:850
translate latin a1s6_bef6471c:

    # "Again with him doing things without even telling me."
    "Iterum aliquid agit ne me quidem certiorem faciens."

# game/a1s6.rpy:851
translate latin a1s6_0139701c:

    # "No conversation, no warning...no consideration."
    "Nullus sermo, nullus monitus...nulla cura."

# game/a1s6.rpy:852
translate latin a1s6_cd4e90da:

    # "After all this time, he still doesn't see me as an equal."
    "Post tantum tempus, me adhuc parem non videt."

# game/a1s6.rpy:853
translate latin a1s6_b0addcd8:

    # "Amicus sees my expression change and quickly jumps in again."
    "Amicus vultum meum mutari videt et statim rursus loqui incipit."

# game/a1s6.rpy:854
translate latin a1s6_f98f2776:

    # a "\"It's the best alternative, mainly because the Khemians likely use their own stretch. Neferu would be able to get you home if he had to.\""
    a "\"Optimum est alterum consilium, praesertim quia Khemiani probabiliter sua Propulsione Dilatatoria utuntur. Neferu te domum reducere posset, si opus esset.\""

# game/a1s6.rpy:855
translate latin a1s6_561c9e5e:

    # m "\"So to pay him...\""
    m "\"Ut igitur ei solveres...\""

# game/a1s6.rpy:857
translate latin a1s6_d12246f2:

    # a "\"He wanted sex and ONLY seemed interested in that, yes. Trust me, I took no emotional pleasure in it.\""
    a "\"Venerem volebat, atque ea SOLA delectari videbatur, ita. Crede mihi: nullam voluptatem animi ex ea cepi.\""

# game/a1s6.rpy:858
translate latin a1s6_4f30fff8:

    # "I'm quiet."
    "Taceo."

# game/a1s6.rpy:860
translate latin a1s6_3c669092:

    # a "\"Don't worry though, I made sure the contract we agreed to ensures that you will not have to be involved in anything like that. In fact, you'd almost be treated like a Pharaoh.\""
    a "\"Noli tamen timere. Curavi ut pactum nostrum caveret ne quid tale invitus facere cogereris. Immo, paene ut Pharao tractareris.\""

# game/a1s6.rpy:862
translate latin a1s6_6cb81a69:

    # "Amicus grins proudly."
    "Amicus superbe subridet."

# game/a1s6.rpy:863
translate latin a1s6_6b57aaf5:

    # "I stare at the wolf for a while, suddenly feeling numb."
    "Aliquamdiu lupum specto, subito omni sensu quasi carens."

# game/a1s6.rpy:865
translate latin a1s6_51b33145:

    # a "\"Are you feeling better?\""
    a "\"Melius te habes?\""

# game/a1s6.rpy:866
translate latin a1s6_59505a56:

    # "His voice takes on a serious tone as he reaches out and pushes a thumb pad across my cheek."
    "Vox eius gravis fit dum manum porrigit et molli pollicis parte genam meam mulcet."

# game/a1s6.rpy:867
translate latin a1s6_8b3d795c:

    # "The action is intimate, and I turn my head away."
    "Gestus familiaris est; caput averto."

# game/a1s6.rpy:868
translate latin a1s6_0f5a83e4:

    # "We stand awkwardly for a moment, then Amicus holds up the flowers."
    "Paulisper incomposite stamus; deinde Amicus flores tollit."

# game/a1s6.rpy:870
translate latin a1s6_0904837e:

    # a "\"Er...you dropped these.\""
    a "\"Ah...hos demisisti.\""

# game/a1s6.rpy:871
translate latin a1s6_6a20a80d_1:

    # "I shake my head."
    "Caput quatio."

# game/a1s6.rpy:872
translate latin a1s6_d796486e:

    # m "\"They were for you.\""
    m "\"Tibi destinati erant.\""

# game/a1s6.rpy:874
translate latin a1s6_bddb760d:

    # "Amicus winces."
    "Amicus vultum contrahit."

# game/a1s6.rpy:875
translate latin a1s6_5be9a28d:

    # a "\"I thought so...were you going to ask me...\""
    a "\"Ita putabam...me rogaturus eras...\""

# game/a1s6.rpy:876
translate latin a1s6_22ab2662:

    # "I feel my face getting hot."
    "Faciem meam incalescere sentio."

# game/a1s6.rpy:877
translate latin a1s6_d4453130:

    # m "\"Yeah, but now—\""
    m "\"Ita, sed nunc—\""

# game/a1s6.rpy:878
translate latin a1s6_a06dc969:

    # "I'm suddenly enveloped in a very tight hug."
    "Subito artissimo amplexu circumdatus sum."

# game/a1s6.rpy:879
translate latin a1s6_fdf03a0d:

    # a "\"Gods, that was the absolute worst moment for you to walk in. I'm sorry.\""
    a "\"Di, illud pessimum omnium tempus erat quo ingredi posses. Ignosce.\""

# game/a1s6.rpy:880
translate latin a1s6_e1ef4f1c:

    # "I stand there limp, just letting the wolf hug me."
    "Languidus ibi sto, lupum tantum me amplecti sinens."

# game/a1s6.rpy:881
translate latin a1s6_ea038ed7:

    # "Finally, Amicus steps back, holding the slightly-wilting flowers as he stares at them."
    "Tandem Amicus retrocedit, flores paulum marcescentes tenens atque intuens."

# game/a1s6.rpy:883
translate latin a1s6_98a59e7f:

    # a "\"I hope after...that...you're still considering?\""
    a "\"Spero te post...illud...adhuc deliberare?\""

# game/a1s6.rpy:885
translate latin a1s6_3dac6c76:

    # "I sigh and shake my head to which Amicus's ears fall."
    "Suspiro et caput quatio; aures Amici demittuntur."

# game/a1s6.rpy:886
translate latin a1s6_135f0e70:

    # m "\"I'm just a stupid primate to you, aren't I?\""
    m "\"Tibi animal stultum e primatibus tantum sum, nonne?\""

# game/a1s6.rpy:888
translate latin a1s6_3c8805f7_1:

    # a "\"What?\""
    a "\"Quid?\""

# game/a1s6.rpy:889
translate latin a1s6_16172c86:

    # m "\"I told you before to just {i}talk{/i} to me if you're planning something that involves me...why couldn't you have at least given me a warning? Especially for something like {i}this{/i}.\""
    m "\"Ante te rogavi ut tantum mecum {i}loquereris{/i}, si aliquid ad me pertinens parares...cur me saltem admonere non potuisti? Praesertim de re tali qualis {i}haec{/i} est.\""

# game/a1s6.rpy:890
translate latin a1s6_8cb847f1:

    # a "\"I—I...\""
    a "\"Ego—ego...\""

# game/a1s6.rpy:891
translate latin a1s6_fd1a14ca:

    # m "\"You what?\""
    m "\"Tu quid?\""

# game/a1s6.rpy:892
translate latin a1s6_3adabcb3:

    # a "\"It was sudden and...I thought the idea might hurt you after what happened on the island.\""
    a "\"Subito accidit, et...putavi consilium te laedere posse post ea quae in insula evenerant.\""

# game/a1s6.rpy:893
translate latin a1s6_2b42bb82:

    # m "\"No shit. So you went behind my back? I know sometimes you don't...well, you don't even think, but you {i}knew{/i} this would hurt?\""
    m "\"Scilicet. Me igitur inscio egisti? Scio te interdum non...immo, ne cogitare quidem; sed hoc me laesurum {i}sciebas{/i}?\""

# game/a1s6.rpy:894
translate latin a1s6_b983c30a:

    # a "\"No! I've been so busy! Not to mention negotiating these things is complicated. I'm just trying to do what's best for you.\""
    a "\"Non! Tot rebus occupatus fui! Ne dicam quam difficile sit talia pacisci. Tantum quod tibi optimum est facere conor.\""

# game/a1s6.rpy:895
translate latin a1s6_4925ff7c:

    # m "\"Without really thinking about me, or how I might feel about any of this.\""
    m "\"Neque vere de me cogitas, aut quid de his omnibus sentire possim.\""

# game/a1s6.rpy:899
translate latin a1s6_25367e14:

    # a "\"I'm always thinking about you! Every damn hour of the day, and this is on top of the trials! Believe it or not, [mc], I'm stretched a bit thin, and it would be helpful if you could work with me—\""
    a "\"Semper de te cogito! Singulis maledictis horis diei, atque praeter certamina! Sive credis sive non, [mc], iam plurimum laboris sustineo; mihi proderet si mecum cooperari posses—\""

# game/a1s6.rpy:900
translate latin a1s6_4e2ba5d0:

    # m "\"Work with you how? Let you manipulate me into becoming your boyfriend, then watch you fuck another guy so I can become HIS slave instead? I've been pretending, but now it could actually become official!\""
    m "\"Quomodo tecum cooperer? Sinam te me callide inducere ut amator tuus fiam, deinde spectem te alium virum futuere ut potius servus EIUS fiam? Hactenus simulabam, sed nunc servitus vere legitima fieri posset!\""

# game/a1s6.rpy:902
translate latin a1s6_641a0aa1:

    # "I can't stop the words from spilling out of my mouth, wanting to hurt the wolf just as much as he hurt me."
    "Verba ex ore erumpere non possum prohibere; lupum tantum laedere cupio quantum ille me laesit."

# game/a1s6.rpy:903
translate latin a1s6_238573c8:

    # a "\"Manipu—\""
    a "\"Calli—\""

# game/a1s6.rpy:904
translate latin a1s6_30ffd6ec:

    # "The wolf stares at me."
    "Lupus me intuetur."

# game/a1s6.rpy:905
translate latin a1s6_2ea4205a:

    # "Then, Amicus's hackles rise, but instead of instilling any sort of fear in me like it normally would, I feel satisfaction."
    "Deinde pili Amici eriguntur; sed, pro timore quem plerumque excitaret, gaudium sentio."

# game/a1s6.rpy:907
translate latin a1s6_35ba2bfa:

    # a "\"[mc], I will not have you accusing me of such a thing. I was more honest with you on the island than I have been with anyone in YEARS.\""
    a "\"[mc], te talis rei me accusare non sinam. In insula sincerius tecum locutus sum quam cum ullo alio per multos ANNOS.\""

# game/a1s6.rpy:908
translate latin a1s6_16bb71f6:

    # m "\"But not about what just happened with Neferu.\""
    m "\"Non tamen de iis quae modo cum Neferu acciderunt.\""

# game/a1s6.rpy:909
translate latin a1s6_2b6a3abf:

    # a "\"What, you think I owe you celibacy? We're not 'dating', and you refuse to do {i}anything{/i} with me! It may come as a surprise to you, but even in times like these, I have needs.\""
    a "\"Quid, putas me continentiam tibi debere? Non sumus 'amantes', atque {i}quidquam{/i} mecum facere recusas! Fortasse miraberis, sed etiam talibus temporibus cupiditates habeo.\""

# game/a1s6.rpy:910
translate latin a1s6_b5976a22:

    # m "\"So you did want it.\""
    m "\"Id igitur vere cupiebas.\""

# game/a1s6.rpy:911
translate latin a1s6_280466dd:

    # "Amicus looks about ready to explode and, for a moment, he just stands there in silence, practically shaking."
    "Amicus ira paene erumpere videtur; paulisper tantum tacitus stat, fere tremens."

# game/a1s6.rpy:912
translate latin a1s6_21c0602f:

    # "He opens his mouth, and instead of the shouting I expect, it's almost a whisper."
    "Os aperit; sed pro clamore quem exspecto, vox fere susurrus est."

# game/a1s6.rpy:913
translate latin a1s6_6948f7a2:

    # a "\"I may not know how these things work on Earth, but YOU know how they work on Adastra. You said yourself that these matters are casual. What happened with the jackal means nothing to me. You mean so {i}much{/i} to me, which is why I did it to keep you safe!\""
    a "\"Fortasse nescio quomodo haec in Terra fiant, sed TU scis quomodo in Adastra fiant. Ipse dixisti has res leves esse. Quod cum chacalo accidit mihi nullius momenti est. Tu mihi tam {i}carus{/i} es; ideo id feci ut te salvum tenerem!\""

# game/a1s6.rpy:914
translate latin a1s6_6a20a80d_2:

    # "I shake my head."
    "Caput quatio."

# game/a1s6.rpy:915
translate latin a1s6_184015de:

    # "While seeing what happened in the bedroom hurt, it's really only the tip of the iceberg with what's wrong with all of this."
    "Quamquam quae in cubiculo vidi me laeserunt, minima tantum pars sunt omnium quae hic prava sunt."

# game/a1s6.rpy:916
translate latin a1s6_bcdee97c:

    # m "\"If you actually cared about me, you'd care about what I want. You keep telling me how smart I am, but here we are again with you doing stuff without any of my input because you think I'm too stupid to understand.\""
    m "\"Si vere de me curares, curares quid vellem. Assidue mihi dicis quam sapiens sim; sed rursus aliquid me inconsulto agis, quoniam me tam stultum putas ut intellegere non possim.\""

# game/a1s6.rpy:918
translate latin a1s6_92142fb6:

    # a "\"No—\""
    a "\"Non—\""

# game/a1s6.rpy:919
translate latin a1s6_1ec048e5:

    # m "\"You know, you wolves are all the same. We're all just stupid barbarians to you. You don't treat me as an equal, you look down on me, and why the fuck would I want to be with someone like that?\""
    m "\"Scis, vos Lupi omnes eiusdem modi estis. Omnes apud vos barbari stulti tantum sumus. Me parem non habes, me despicis; cur tandem cum tali aliquo esse velim?\""

# game/a1s6.rpy:921
translate latin a1s6_9025a3e7:

    # a "\"That is not even—\""
    a "\"Id ne quidem—\""

# game/a1s6.rpy:922
translate latin a1s6_ca39cecd:

    # m "\"Just win your stupid trial and send me home. If you don't, just blast my stupid ape-ass off into space. I don't wanna be here anymore.\""
    m "\"Tantum stultum certamen tuum vince et me domum mitte. Si non vincas, stultum meum simiae culum in spatium eice. Hic iam esse nolo.\""

# game/a1s6.rpy:924
translate latin a1s6_47138e21:

    # "I turn, heading for the door."
    "Me verto et ad ianuam pergo."

# game/a1s6.rpy:925
translate latin a1s6_aaf3eecf:

    # a "\"Wait, {i}Please{/i}—\""
    a "\"Exspecta, {i}Quaeso{/i}—\""

# game/a1s6.rpy:926
translate latin a1s6_87ce954d:

    # "Whatever he was going to say suddenly cuts off as I hear a loud thud."
    "Quidquid dicturus erat subito interrumpitur, dum magnum ictum audio."

# game/a1s6.rpy:928
translate latin a1s6_91ede1cf:

    # "I don't look back to see what he kicked or punched."
    "Non respicio ut videam quid calce aut pugno percusserit."

# game/a1s6.rpy:930
translate latin a1s6_fdf7af4b:

    # "Instead, I head out into the hall, not sure at all of where I'm going."
    "Potius in ambulacrum exeo, prorsus nesciens quo pergam."

# game/a1s6.rpy:931
translate latin a1s6_0edff0f3:

    # "I just know that I hate everything about what just happened."
    "Tantum scio me omnia quae modo acciderunt odisse."

# game/a1s6.rpy:935
translate latin a1s6_155b5484:

    # "For a while, I just wander."
    "Aliquamdiu tantum erro."

# game/a1s6.rpy:936
translate latin a1s6_b28d717c:

    # "I end up pacing the halls of the palace before going outside to sit in the gardens."
    "Tandem per ambulacra palatii ultro citroque ambulo, deinde foras exeo ut in hortis sedeam."

# game/a1s6.rpy:937
translate latin a1s6_c1b9dbed:

    # "I don't see anyone."
    "Neminem video."

# game/a1s6.rpy:938
translate latin a1s6_382d9f8b:

    # "It's weirdly calm outside, especially considering that the emperor could be decided tomorrow."
    "Foris mira tranquillitas est, praesertim cum cras imperator eligi possit."

# game/a1s6.rpy:939
translate latin a1s6_97af8384:

    # "I wonder how things are in the city, in the rest of the empire."
    "Miror quomodo res in urbe atque in reliquo imperio se habeant."

# game/a1s6.rpy:940
translate latin a1s6_0cca5e0c:

    # "I look out toward the faint city skyline, glinting gently in the afternoon light."
    "Ad tenuem formam urbis procul specto, quae in luce postmeridiana leniter micat."

# game/a1s6.rpy:941
translate latin a1s6_2bc49453:

    # "Amicus doesn't come after me."
    "Amicus me non sequitur."

# game/a1s6.rpy:942
translate latin a1s6_1026b4ad:

    # "Should he?"
    "Debetne?"

# game/a1s6.rpy:943
translate latin a1s6_e8d0e56c:

    # "I'd said such horrible things to him."
    "Tam horrenda ei dixeram."

# game/a1s6.rpy:944
translate latin a1s6_a22412d5:

    # "But even now, I feel like I had to say them."
    "Sed etiam nunc sentio me ea dicere debuisse."

# game/a1s6.rpy:945
translate latin a1s6_88b88785:

    # "I'm tired of being treated like an actual pet, and now that I might actually become one..."
    "Me tamquam veras delicias tractari taedet; nunc autem vere deliciae fieri possim..."

# game/a1s6.rpy:946
translate latin a1s6_48db0c2c:

    # "Still...I kind of wish he did come after me again."
    "Tamen...quodam modo vellem eum rursus me secutum esse."

# game/a1s6.rpy:947
translate latin a1s6_dfd95360:

    # "I do believe that he was only trying to protect me, that he thought what he was doing was the only way to do that."
    "Credo eum tantum me protegere conatum esse, atque putavisse id quod agebat solam viam me protegendi esse."

# game/a1s6.rpy:948
translate latin a1s6_693cb912:

    # "But after everything on the beach, after I've already told him to just keep me in the loop..."
    "Sed post omnia quae in litore acciderunt, postquam iam eum rogavi ut me certiorem faceret..."

# game/a1s6.rpy:949
translate latin a1s6_4fcdd2ac:

    # "Honestly, if he'd asked me about it first, even just told me about it, I'd probably have been okay with it."
    "Ut verum dicam, si prius me de re rogavisset, vel tantum mihi dixisset, probabiliter eam probavissem."

# game/a1s6.rpy:950
translate latin a1s6_d69a7667:

    # "Sure...maybe a little jealous, but okay."
    "Fortasse...paulum aemulus, sed probavissem."

# game/a1s6.rpy:951
translate latin a1s6_a6929987:

    # "I realize that a lot of this anger is because I just feel betrayed, and I feel that way because I really, really like Amicus."
    "Intellego multam huius irae partem ex eo oriri quod proditus me sentio; ita autem sentio quia Amicus mihi vere, vere placet."

# game/a1s6.rpy:952
translate latin a1s6_f69e4200:

    # "I'd expected him to treat me better after everything..."
    "Exspectaveram eum post omnia me melius tractaturum..."

# game/a1s6.rpy:954
translate latin a1s6_ae59086f:

    # "The late afternoon heat is making me sweat, but instead of going inside, I just move under some shade."
    "Calor serae partis diei me sudare facit; sed pro eo quod intro eam, tantum in umbram me confero."

# game/a1s6.rpy:955
translate latin a1s6_b70b5b82:

    # "After a while, I lay back on the bench I'm sitting on, drifting off to sleep."
    "Aliquanto post, in scamno in quo sedeo recumbo, paulatim somno cedens."

# game/a1s6.rpy:959
translate latin a1s6_9b1ea41a:

    # "When I wake up, it takes me a while to realize where I am."
    "Cum expergiscor, aliquanto tempore mihi opus est antequam intellego ubi sim."

# game/a1s6.rpy:960
translate latin a1s6_ae6fd716:

    # "I stare at the flowers and leaves, gently lit up by the garden lights, until I remember that I'd fallen asleep there."
    "Flores foliaque, leniter luminibus hortorum illustrata, intueor donec memini me ibi obdormivisse."

# game/a1s6.rpy:961
translate latin a1s6_511d0817:

    # "Groggily, I call out for Com and according to him, I've only been out for about two hours, but the sun here always moves fast across the sky."
    "Somno adhuc gravis, Computatrum voco; dicit me duas fere horas tantum dormivisse, sed sol hic semper cito per caelum movetur."

# game/a1s6.rpy:962
translate latin a1s6_186be029:

    # "I brush a few leaves off my robes as I get up and walk toward the palace, realizing at this point that I can't exactly avoid going back to Amicus's room forever."
    "Aliquot folia e tunica detergo, dum surgo et ad palatium ambulo; nunc intellego me non posse semper vitare reditum ad cubiculum Amici."

# game/a1s6.rpy:964
translate latin a1s6_9274ba6d:

    # "At least it'll force us to talk about things after we've cooled down."
    "Saltem nos coget de rebus colloqui postquam ira sedata erit."

# game/a1s6.rpy:965
translate latin a1s6_b21d12d9:

    # "...At least, I hope he's cooled down."
    "...Saltem spero iram eius sedatam esse."

# game/a1s6.rpy:966
translate latin a1s6_5587f53a:

    # "My pace starts to slow as I get closer to his bedroom, unsure what to say after everything that happened."
    "Lentius ambulare incipio dum ad cubiculum eius accedo, incertus quid post omnia quae acciderunt dicam."

# game/a1s6.rpy:967
translate latin a1s6_0a6f663d:

    # "I decide I'm going to apologize, but also expect an apology from him as well."
    "Statuo me veniam petiturum, sed etiam ab eo veniam peti exspecto."

# game/a1s6.rpy:968
translate latin a1s6_f8a42e07:

    # "We both made mistakes, but we could get past this if we talked it out..."
    "Ambo erravimus, sed rem superare possemus si aperte colloqueremur..."

# game/a1s6.rpy:969
translate latin a1s6_8f946de8:

    # "Dinner is still sitting next to the door on its cart, untouched."
    "Cena adhuc iuxta ianuam in vehiculo posita est, intacta."

# game/a1s6.rpy:970
translate latin a1s6_b544db46:

    # "I pause, my hand hovering over the panel, remembering what I saw the last time I opened this door."
    "Consisto, manu supra tabulam haerente, reminiscens quae vidi cum hanc ianuam novissime aperui."

# game/a1s6.rpy:972
translate latin a1s6_16637fbe:

    # "Shuddering, I steel myself and press it."
    "Tremens animum firmo et eam premo."

# game/a1s6.rpy:976
translate latin a1s6_6b4d5a38:

    # "The room's empty."
    "Cubiculum vacuum est."

# game/a1s6.rpy:977
translate latin a1s6_7c33c5b0:

    # "No wolf in sight."
    "Nusquam lupus apparet."

# game/a1s6.rpy:978
translate latin a1s6_aa5c8ed3:

    # "Cold air creeps out of the room, chilling my bare calves as I continue to stand in the hallway."
    "Aer frigidus e cubiculo effluit, nudas suras meas refrigerans, dum in ambulacro stare pergo."

# game/a1s6.rpy:979
translate latin a1s6_cd0ced26:

    # "I realize then that I was holding in my breath and I let it out slowly."
    "Tum intellego me spiritum tenuisse; lente eum emitto."

# game/a1s6.rpy:980
translate latin a1s6_201c8b01:

    # "I look up and down the hall in case I might see Amicus, but as always, it's empty."
    "Utrimque per ambulacrum specto, si forte Amicum videam; sed, ut semper, vacuum est."

# game/a1s6.rpy:981
translate latin a1s6_a436b890:

    # "With a soft sigh, I slowly walk in toward the bed before changing direction to sit on the sofa instead."
    "Leniter suspirans, lente ad lectum intro ambulo, deinde cursum muto ut potius in lectulo sedeam."

# game/a1s6.rpy:982
translate latin a1s6_7f5402c7:

    # "Com had told me that it was the eighteenth hour, which means Amicus should be getting ready for bed by now, a schedule he follows almost religiously."
    "Computatrum mihi dixerat horam duodevicesimam esse; igitur Amicus iam ad somnum se parare debet, ordinem quem fere religiose servat."

# game/a1s6.rpy:983
translate latin a1s6_43bb6134:

    # "Maybe he's getting ready for the trial somehow?"
    "Fortasse aliquo modo ad certamen se parat?"

# game/a1s6.rpy:984
translate latin a1s6_ce0d524c:

    # "That would be good, but I'm also getting the uncomfortable feeling that he's just avoiding me."
    "Id bonum esset, sed etiam incommodum sensum habeo eum me tantum vitare."

# game/a1s6.rpy:985
translate latin a1s6_a23c0bd5:

    # "That would be bad, because despite what happened, he shouldn't be thinking at all about me."
    "Id malum esset: quamquam res accidit, de me omnino cogitare non debet."

# game/a1s6.rpy:986
translate latin a1s6_ff6d0aff:

    # "He could be the emperor tomorrow."
    "Cras imperator esse possit."

# game/a1s6.rpy:987
translate latin a1s6_07c11914:

    # "So I sit there, hugging a pillow, waiting."
    "Itaque ibi sedeo, pulvinum amplectens, exspectans."

# game/a1s6.rpy:988
translate latin a1s6_2bc07e1c:

    # "After a while, I grab the food from the hallway and manage to eat a little bit."
    "Aliquanto post, cibum ex ambulacro capio et paulum comedere possum."

# game/a1s6.rpy:989
translate latin a1s6_4d4afe2e:

    # "I wonder if I should save some for Amicus, but decide that he'd be able to get his own food from the kitchens instead of these cold leftovers if he ends up returning."
    "Miror num aliquid Amico servem; sed statuo eum, si tandem redeat, suum cibum ex culina petere posse, potius quam has frigidas reliquias sumere."

# game/a1s6.rpy:990
translate latin a1s6_429aea62:

    # "So I send the rest back with the drones and continue waiting."
    "Reliquum igitur cibum per automata remitto et exspectare pergo."

# game/a1s6.rpy:991
translate latin a1s6_8920d118:

    # "After a few more hours, Amicus still doesn't come back, and I end up laying down on the sofa, waiting to fall asleep..."
    "Post aliquot horas, Amicus adhuc non redit; tandem in lectulo recumbo, somnum exspectans..."

# game/a1s6.rpy:997
translate latin a1s6_0894fe24:

    # "The sound of the door opening jolts me awake, and I quickly sit up, turning to look."
    "Sonus ianuae apertae me subito excitat; cito me erigo et me verto ut aspiciam."

# game/a1s6.rpy:998
translate latin a1s6_2e87079d:

    # m "\"Amicus?\""
    m "\"Amice?\""

# game/a1s6.rpy:1000
translate latin a1s6_4a9644c0:

    # "I stare at the jackal for a moment, feeling a sudden surge of anger in my chest."
    "Chacalum paulisper intueor, subitam iram in pectore oriri sentiens."

# game/a1s6.rpy:1001
translate latin a1s6_7b73873c:

    # n "\"Hello, [mc]. Are you not coming to the trial?\""
    n "\"Salve, [mc]. Nonne ad certamen venies?\""

# game/a1s6.rpy:1002
translate latin a1s6_02513e4d:

    # "I look around."
    "Circumspicio."

# game/a1s6.rpy:1003
translate latin a1s6_f3291692:

    # m "\"What time is it?\""
    m "\"Quota hora est?\""

# game/a1s6.rpy:1005
translate latin a1s6_4624c13d:

    # n "\"The seventh hour, which means the trial starts in less than an hour.\""
    n "\"Septima; itaque certamen intra minus quam unam horam incipiet.\""

# game/a1s6.rpy:1006
translate latin a1s6_54ae3d90:

    # m "\"Where's Amicus?\""
    m "\"Ubi est Amicus?\""

# game/a1s6.rpy:1007
translate latin a1s6_11e752eb:

    # n "\"Preparing for the trial.\""
    n "\"Ad certamen se parat.\""

# game/a1s6.rpy:1008
translate latin a1s6_e41cb36f:

    # m "\"He...hasn't been back all night.\""
    m "\"Ille...tota nocte non rediit.\""

# game/a1s6.rpy:1010
translate latin a1s6_2223b237:

    # n "\"He was meditating most of the night.\""
    n "\"Maiorem noctis partem meditatus est.\""

# game/a1s6.rpy:1011
translate latin a1s6_5372d0bd:

    # m "\"All night?\""
    m "\"Tota nocte?\""

# game/a1s6.rpy:1013
translate latin a1s6_e4456107:

    # n "\"Indeed.\""
    n "\"Certe.\""

# game/a1s6.rpy:1014
translate latin a1s6_a7eac603:

    # "I frown at the jackal."
    "Chacalum fronte contracta specto."

# game/a1s6.rpy:1015
translate latin a1s6_9caecb4d:

    # m "\"What do you want?\""
    m "\"Quid vis?\""

# game/a1s6.rpy:1016
translate latin a1s6_adf6b162:

    # "Neferu walks further into the room slowly before stopping in the middle, a good fifteen feet away."
    "Neferu lente altius in cubiculum intrat, deinde in medio consistit, quindecim fere pedibus remotus."

# game/a1s6.rpy:1019
translate latin a1s6_330b11e5:

    # n "\"To escort you to the trial, if you'd like...and to also talk.\""
    n "\"Te ad certamen comitari, si vis...atque etiam colloqui.\""

# game/a1s6.rpy:1020
translate latin a1s6_9cc1052b:

    # m "\"About what?\""
    m "\"De qua re?\""

# game/a1s6.rpy:1022
translate latin a1s6_05a09abf:

    # n "\"I've already told you that you don't need to play stupid with me, [mc].\""
    n "\"Iam dixi te mecum stultum simulare non debere, [mc].\""

# game/a1s6.rpy:1023
translate latin a1s6_b51d4045:

    # "I sit up straight, turning to face the jackal more directly."
    "Rectus sedeo et recta ad chacalum me converto."

# game/a1s6.rpy:1024
translate latin a1s6_cf931234:

    # m "\"I'm not, I'm just wondering why the fuck you have the nerve to show up here after taking advantage of Amicus like that.\""
    m "\"Non simulo; tantum miror cur tandem audeas hic adesse, postquam Amico ita abusus es.\""

# game/a1s6.rpy:1026
translate latin a1s6_520bd17d:

    # n "\"Wha—\""
    n "\"Qu—\""

# game/a1s6.rpy:1027
translate latin a1s6_3a0f421a:

    # "I don't think I've ever seen Neferu caught off-guard, so the sight is kind of funny."
    "Credo me Neferu numquam antea incautum deprehensum vidisse; spectaculum igitur paulum iocosum est."

# game/a1s6.rpy:1028
translate latin a1s6_393dd690:

    # "I smirk."
    "Callide subrideo."

# game/a1s6.rpy:1030
translate latin a1s6_101a4377:

    # n "\"Well...that's certainly a way to look at it.\""
    n "\"Ita...certe unus est modus rem spectandi.\""

# game/a1s6.rpy:1031
translate latin a1s6_220d9ce7:

    # m "\"What other way is there to look at it?\""
    m "\"Quis alius modus est?\""

# game/a1s6.rpy:1033
translate latin a1s6_279e34bf:

    # n "\"Plenty, if you'll let me explain.\""
    n "\"Multi, si me explicare sinas.\""

# game/a1s6.rpy:1034
translate latin a1s6_c8f2e276:

    # "I sit back on the sofa, crossing my arms."
    "In lectulo recumbo, bracchiis complicatis."

# game/a1s6.rpy:1035
translate latin a1s6_cb9fa3b8:

    # m "\"Amicus already explained. I become your pet to protect me from Cassius and in exchange for that, you made him fuck you in the ass.\""
    m "\"Amicus iam explicavit. Deliciae tuae fio ut a Cassio protegar; pro eo autem postulavisti ut Amicus te pedicaret.\""

# game/a1s6.rpy:1037
translate latin a1s6_16761b7a:

    # "Again, the jackal looks shocked, then he laughs, the sound high and soft."
    "Rursus chacalus attonitus videtur; deinde ridet, sono acuto atque leni."

# game/a1s6.rpy:1039
translate latin a1s6_b0dfaa37:

    # n "\"Hahaha...oh dear, there are many ways to look at this, aren't there?\""
    n "\"Hahaha...o di, multi modi hanc rem spectandi sunt, nonne?\""

# game/a1s6.rpy:1040
translate latin a1s6_55f6a14c:

    # "His suddenly cheerful mood irritates me."
    "Animus eius subito laetus me irritat."

# game/a1s6.rpy:1041
translate latin a1s6_c79fdc62:

    # m "\"Listen, I honestly don't want any part of this...\""
    m "\"Audi, revera ullam partem huius rei agere nolo...\""

# game/a1s6.rpy:1043
translate latin a1s6_289a0de9:

    # n "\"Yes, but you are already a part of it, whether you want to be or not, so please...allow me to explain some things.\""
    n "\"Ita, sed iam pars eius es, sive vis sive non vis; quaeso igitur...sine me quaedam explicare.\""

# game/a1s6.rpy:1044
translate latin a1s6_ee290847:

    # "I don't say anything, keeping my arms folded, my expression bored."
    "Nihil dico, bracchiis adhuc complicatis, vultu taedium ostendente."

# game/a1s6.rpy:1045
translate latin a1s6_8f17e6c9:

    # "The jackal seems to take that as his cue to continue."
    "Chacalus hoc quasi signum pergendi accipere videtur."

# game/a1s6.rpy:1047
translate latin a1s6_d7789f30:

    # n "\"Amicus approached me about this deal a week ago, shortly after the incident with Cassius. It seemed simple enough, and I had to agree with him; your position in this power struggle is becoming evermore precarious.\""
    n "\"Amicus ante hebdomadam de hoc pacto ad me venit, paulo post rem cum Cassio gestam. Satis simplex videbatur, et ei consentire debebam: locus tuus in hoc certamine potestatis magis magisque incertus fit.\""

# game/a1s6.rpy:1048
translate latin a1s6_09722dcb:

    # "I raise an eyebrow."
    "Supercilium tollo."

# game/a1s6.rpy:1049
translate latin a1s6_707d2a10:

    # m "\"How so?\""
    m "\"Quomodo?\""

# game/a1s6.rpy:1050
translate latin a1s6_d7b75af9:

    # n "\"The rumors about Cassius's intent to disband the triumvirates have saturated the trial, even though Cato has banned all discussion of it.\""
    n "\"Rumores Cassium triumviratus dissolvere velle totum certamen occupaverunt, quamquam Cato omnem de ea re sermonem vetuit.\""

# game/a1s6.rpy:1051
translate latin a1s6_fe9d1045:

    # n "\"Word is that Cassius has realized who might have started the rumors.\""
    n "\"Dicitur Cassius intellexisse quis rumores fortasse excitaverit.\""

# game/a1s6.rpy:1053
translate latin a1s6_864bb03f:

    # "Neferu looks pointedly at me, though I try to keep my expression neutral."
    "Neferu me significanter spectat; vultum tamen aequum servare conor."

# game/a1s6.rpy:1054
translate latin a1s6_bf696462:

    # n "\"This has implications for you obviously, but not only because you possibly sabotaged his chances at the throne.\""
    n "\"Hoc ad te scilicet pertinet, neque solum quia facultatem eius imperium obtinendi fortasse corrupisti.\""

# game/a1s6.rpy:1055
translate latin a1s6_87c718ee:

    # "I feel my stomach turn a little, realizing I've gotten myself into way more than I'd ever intended."
    "Venter meus paulum torquetur, cum intellego me in multo plures res implicatum esse quam umquam voluerim."

# game/a1s6.rpy:1056
translate latin a1s6_3af8d65f:

    # n "\"This also brings into question your intelligence...far too intelligent for a Simian, wouldn't you say?\""
    n "\"Etiam intellegentiam tuam suspectam facit...nimis sapiens es ut Simianus sis, nonne?\""

# game/a1s6.rpy:1057
translate latin a1s6_1fdc5f93:

    # "I open my mouth, but Neferu goes on."
    "Os aperio, sed Neferu pergit."

# game/a1s6.rpy:1059
translate latin a1s6_f68f9805:

    # n "\"Now, with all of this considered, it was only natural for Amicus to come to me for help. Your life is in danger, [mc], no matter the facade these peaceful palace halls might project.\""
    n "\"His omnibus consideratis, naturale erat Amicum auxilium a me petere. Vita tua periclitatur, [mc], quamvis haec quieta ambulacra palatii pacis speciem praebeant.\""

# game/a1s6.rpy:1060
translate latin a1s6_6bfc57b9:

    # "I stare at the jackal, surprised at how candid he's being with me."
    "Chacalum intueor, miratus quam aperte mecum loquatur."

# game/a1s6.rpy:1061
translate latin a1s6_9e010ebc:

    # n "\"He asked me what I wanted most, and I answered truthfully; an alliance with the wolves if Amicus were to become emperor.\""
    n "\"Interrogavit quid maxime vellem; vere respondi: foedus cum Lupis, si Amicus imperator fieret.\""

# game/a1s6.rpy:1063
translate latin a1s6_cd8dd838:

    # n "\"Of course, he declined outright, as he should have as the prospective emperor. How could he promise something so important with so many implications, all over one pet?\""
    n "\"Scilicet statim recusavit, sicut futurum imperatorem decebat. Quomodo rem tam gravem ac tot effectus habituram ob unas tantum delicias promittere posset?\""

# game/a1s6.rpy:1065
translate latin a1s6_28e28ef9:

    # n "\"So, knowing that was impossible, I offered something a bit more selfish on my part; copulation with the handsome son of a wolven emperor. To this, he only needed a few moments to agree.\""
    n "\"Sciens igitur id fieri non posse, aliquid paulo magis mihi ipsi commodum proposui: coitum cum pulchro filio imperatoris Luporum. Paucis tantum momentis deliberavit antequam huic rei assensus est.\""

# game/a1s6.rpy:1066
translate latin a1s6_cd938aab:

    # "I grimace."
    "Vultum contraho."

# game/a1s6.rpy:1068
translate latin a1s6_634c0450:

    # n "\"But I want you to understand something, [mc]. If Amicus had found even that disagreeable, I would have simply asked for nothing.\""
    n "\"Sed aliquid intellegere te volo, [mc]. Si hoc quoque Amico displicuisset, simpliciter nihil petivissem.\""

# game/a1s6.rpy:1070
translate latin a1s6_85bc146a:

    # n "\"It is the duty of all Khemians to protect any sapient fleeing wolven violence, whether they be sibling, child...or abandoned. Pet ownership is illegal where I'm from, and the idea is quite disgusting, don't you agree?\""
    n "\"Omnium Khemianorum officium est quemlibet Sapientem a violentia Luporum fugientem protegere, sive Frater, sive Liber...sive desertus sit. Dominium deliciarum lex vetat in terra unde venio; ipsa res foedissima est, nonne consentis?\""

# game/a1s6.rpy:1072
translate latin a1s6_5be167d1:

    # "Neferu glances at me."
    "Neferu ad me spectat."

# game/a1s6.rpy:1073
translate latin a1s6_09e4138d:

    # n "\"But wolves love their contracts, and no matter how different Amicus might wish himself to be, he is still a wolf. He despises the idea that he might owe something to a Khemian.\""
    n "\"Sed Lupi pacta sua amant; quantumvis Amicus se dissimilem esse velit, adhuc lupus est. Odit cogitationem se quidquam Khemiano debere posse.\""

# game/a1s6.rpy:1075
translate latin a1s6_877e4cad:

    # n "\"And his quickness to accept the deal showed me that despite how much he wanted to {i}not{/i} want to...'fuck' me, as you put it, there was a part of him that did. In the end, he was willing.\""
    n "\"Quam cito pactum accepit mihi ostendit eum, quantumvis {i}nolle{/i} me, ut tu dicis, 'futuere' cuperet, partim id tamen velle. Tandem ultro assensus est.\""

# game/a1s6.rpy:1076
translate latin a1s6_a4dfe006:

    # "I look away, frowning."
    "Obtutum averto, fronte contracta."

# game/a1s6.rpy:1077
translate latin a1s6_7283cc9e:

    # n "\"And I think this is something that has caused a rift between the two of you. You must understand that sex is casual here, it means nothing more than indulging in our corporeal desires. It's one of the few cultural similarities we share with the wolves.\""
    n "\"Credo autem hoc aliquid esse quod dissidium inter vos fecit. Intellegere debes venerem hic levem rem esse: nihil amplius significat quam cupiditatibus corporis indulgere. Una est ex paucis similitudinibus cultus quas cum Lupis habemus.\""

# game/a1s6.rpy:1078
translate latin a1s6_6fd74f4a:

    # n "\"I've been told that Simians are more similar to cats in that such things hold much more meaning, but you are no longer on Simia and must understand that things are different here.\""
    n "\"Audivi Simianos felibus similiores esse, quoniam talibus rebus multo plus momenti tribuunt. Sed iam in Simia non es, et intellegere debes res hic aliter se habere.\""

# game/a1s6.rpy:1079
translate latin a1s6_36cb5d8f:

    # n "\"Even if he wants to, which I believe he does, Amicus can't change his philosophy over the course of a single week.\""
    n "\"Etiamsi velit, quod credo eum velle, Amicus rationem suam intra unam hebdomadam mutare non potest.\""

# game/a1s6.rpy:1080
translate latin a1s6_a9edfacd:

    # "I finally find room to speak."
    "Tandem facultatem loquendi invenio."

# game/a1s6.rpy:1081
translate latin a1s6_a8ca4a83:

    # m "\"You're acting like we're in a relationship, or something.\""
    m "\"Agis quasi amantes simus, vel aliquid simile.\""

# game/a1s6.rpy:1083
translate latin a1s6_6d350243:

    # n "\"You aren't, but you want to be. Amicus loves you. It's clear as Vita, as they say here.\""
    n "\"Non estis, sed esse vis. Amicus te amat. Tam clarum est quam Vita, ut hic dicunt.\""

# game/a1s6.rpy:1084
translate latin a1s6_4a4c12e8:

    # "I feel that little thrill in my chest, and my face blushes furiously."
    "Parvum illum motum trepidum in pectore sentio, et facies mea vehementer rubescit."

# game/a1s6.rpy:1085
translate latin a1s6_d09c5668:

    # "Neferu goes on like he didn't actually just say that, though."
    "Neferu tamen pergit, quasi ea modo non dixisset."

# game/a1s6.rpy:1087
translate latin a1s6_2735ff17:

    # n "\"So yes, if you don't like the idea of Amicus 'fucking' another man, then claim him as {i}your own{/i} man.\""
    n "\"Itaque, si tibi displicet Amicum alium virum 'futuere', eum {i}tuum{/i} virum fac.\""

# game/a1s6.rpy:1088
translate latin a1s6_e499761a_4:

    # "I frown."
    "Frontem contraho."

# game/a1s6.rpy:1089
translate latin a1s6_0b12ad3e:

    # m "\"Claim?\""
    m "\"Meum faciam?\""

# game/a1s6.rpy:1091
translate latin a1s6_d06c376d:

    # n "\"I'm going by wolven terms here. I'm sure you have your own.\""
    n "\"Verbis Luporum hic utor. Certe vestra verba habetis.\""

# game/a1s6.rpy:1092
translate latin a1s6_b593813b:

    # "Did Neferu just ask me to ask Amicus out?"
    "Num Neferu modo me rogavit ut Amicum ad amorem invitem?"

# game/a1s6.rpy:1094
translate latin a1s6_513086f6:

    # n "\"Now, does that clear things up for you?\""
    n "\"Nunc res tibi clarae sunt?\""

# game/a1s6.rpy:1095
translate latin a1s6_83358dc3:

    # "Even though I just woke up, I'm already feeling exhausted."
    "Quamquam modo experrectus sum, iam defatigatus me sentio."

# game/a1s6.rpy:1096
translate latin a1s6_53d12f87:

    # m "\"I...guess. There was a little more to it than that, though.\""
    m "\"Ego...credo. Sed paulo plura ad rem pertinebant.\""

# game/a1s6.rpy:1097
translate latin a1s6_979054bd:

    # n "\"Which I'm sure can be settled in the future. Civil discussions can do wonders.\""
    n "\"Quae certe postea componi possunt. Sermones urbani mira efficere possunt.\""

# game/a1s6.rpy:1099
translate latin a1s6_affc4d6d:

    # n "\"Now, we really must be getting to the trial...if you're wanting to go?\""
    n "\"Nunc vere ad certamen ire debemus...si ire vis?\""

# game/a1s6.rpy:1100
translate latin a1s6_cb251dd7:

    # "Neferu raises an eyebrow at me."
    "Neferu supercilium ad me tollit."

# game/a1s6.rpy:1101
translate latin a1s6_2dbc183f:

    # "I find myself shaking my head, but not to deny the jackal his request."
    "Me caput quatientem invenio, sed non ut petitionem chacali recusem."

# game/a1s6.rpy:1102
translate latin a1s6_c9e19b9b:

    # "Rather, it's because I don't know what the hell this guy is up to."
    "Potius quia nescio quid tandem hic vir agat."

# game/a1s6.rpy:1103
translate latin a1s6_375e9f9b:

    # "I get up and Neferu offers his arm to me which I stare at."
    "Surgo; Neferu bracchium mihi offert, quod intueor."

# game/a1s6.rpy:1105
translate latin a1s6_c2bb4dac:

    # n "\"Shall I escort you?\""
    n "\"Te comiter?\""

# game/a1s6.rpy:1108
translate latin a1s6_06e152f9:

    # "This is something I'd seen the jackal do multiple times to Vriginia and Alex."
    "Hoc chacalum saepe erga Virginiam atque Alex facere videram."

# game/a1s6.rpy:1109
translate latin a1s6_33a30c69:

    # "For some reason, he seemed to really just enjoy \"escorting\" people around."
    "Nescio cur, sed alios huc illuc \"comitari\" valde gaudere videbatur."

# game/a1s6.rpy:1110
translate latin a1s6_84316a94:

    # "After his little lecture, I can tell that he's trying to smooth things over between me and Amicus."
    "Post brevem eius admonitionem, intellego eum dissidium inter me et Amicum componere conari."

# game/a1s6.rpy:1111
translate latin a1s6_71d254b6:

    # "So, reluctantly, I reach out and take his arm in both hands, if only to please him."
    "Itaque invitus manus porrigo et bracchium eius ambabus capio, vel tantum ut ei placeam."

# game/a1s6.rpy:1113
translate latin a1s6_b2f25461:

    # "And pleased he seems to be, a tugging at the corner of his muzzle making me think he's trying not to smile {i}too{/i} much."
    "Et ei placere videtur: angulus rostri motus me facit putare eum conari ne {i}nimis{/i} subrideat."

# game/a1s6.rpy:1116
translate latin a1s6_55a3940f:

    # "As he guides me out the door, I find myself feeling out the fur on his arm."
    "Dum me per ianuam ducit, pilos bracchii eius tangendo exploro."

# game/a1s6.rpy:1117
translate latin a1s6_807f040b:

    # "It's much more silky and smooth compared to Amicus, not quite as fluffy."
    "Multo sericis similiores et leviores sunt quam pili Amici, nec tam densi ac molles."

# game/a1s6.rpy:1118
translate latin a1s6_d4213ae2:

    # "It's not as nice as Amicus's coat, but it does feel nice in a different way."
    "Non tam grati sunt quam pellis Amici, sed alio modo tangenti grati sunt."

# game/a1s6.rpy:1119
translate latin a1s6_dbcb40be:

    # "There's a lot of muscle there too, and I wonder if the jackal works out in the amphitheater, though I've never seen him there."
    "Musculi quoque ibi multi sunt; miror num chacalus in amphitheatro se exerceat, quamquam eum ibi numquam vidi."

# game/a1s6.rpy:1120
translate latin a1s6_cd135896:

    # "I guess I can see why so many people are into this guy...if muscles are your thing."
    "Credo me intellegere posse cur hic vir tam multis placeat...si musculos amas."

# game/a1s6.rpy:1121
translate latin a1s6_1d641146:

    # "As we continue through the halls, I notice we're taking a different route than the one to the throne room."
    "Dum per ambulacra pergimus, animadverto nos alia via quam ea quae ad aulam throni ducit ire."

# game/a1s6.rpy:1122
translate latin a1s6_3b69c6f6:

    # m "\"Where are we going?\""
    m "\"Quo imus?\""

# game/a1s6.rpy:1124
translate latin a1s6_11868419:

    # n "\"To meet the star of the most asinine entertainment show in the galaxy. What better way to determine the fate of all things, siblings and parents alike, than through meaningless, wolven spectacle?\""
    n "\"Ut eum conveniamus qui praecipuam partem agit in stultissimo spectaculo totius galaxiae. Quis melior modus omnium rerum fata decernendi, Fratrum atque Parentum aeque, quam per inane Luporum spectaculum?\""

# game/a1s6.rpy:1125
translate latin a1s6_c7944f8f:

    # m "\"...What?\""
    m "\"...Quid?\""

# game/a1s6.rpy:1126
translate latin a1s6_95e30c58:

    # "Neferu pauses in front of a door, gently pulling away from me while his paw is held delicately up to the panel."
    "Neferu ante ianuam consistit, leniter se a me removens, dum manum leviter ad tabulam sustinet."

# game/a1s6.rpy:1128
translate latin a1s6_207da3c3:

    # n "\"What I'm saying is that quite a bit is depending on your wolf right now, and he might need some encouragement.\""
    n "\"Hoc dico: nunc satis multa e lupo tuo pendent, et fortasse hortatu indiget.\""

# game/a1s6.rpy:1129
translate latin a1s6_dbd86041:

    # "I'm still staring at the jackal when he finally presses the panel, opening the door."
    "Adhuc chacalum intueor cum tandem tabulam premit et ianuam aperit."

# game/a1s6.rpy:1132
translate latin a1s6_c82a6463:

    # "This is something I'd seen the jackal do multiple times to Virginia and Alex."
    "Hoc chacalum saepe erga Virginiam atque Alex facere videram."

# game/a1s6.rpy:1133
translate latin a1s6_33a30c69_1:

    # "For some reason, he seemed to really just enjoy \"escorting\" people around."
    "Nescio cur, sed alios huc illuc \"comitari\" valde gaudere videbatur."

# game/a1s6.rpy:1134
translate latin a1s6_855d2f34:

    # "However, I still really don't trust this guy, and I don't want him to feel like he's won any points with me."
    "Tamen huic viro adhuc minime confido, neque eum putare volo se apud me gratiam ullam consecutum esse."

# game/a1s6.rpy:1135
translate latin a1s6_4fdf42cd:

    # "So I shake my head."
    "Itaque caput quatio."

# game/a1s6.rpy:1136
translate latin a1s6_31d7001a:

    # m "\"Naw, I'll just follow you.\""
    m "\"Non, te tantum sequar.\""

# game/a1s6.rpy:1138
translate latin a1s6_46ec1ee0:

    # n "\"As you wish.\""
    n "\"Ut vis.\""

# game/a1s6.rpy:1141
translate latin a1s6_b445a737:

    # "I follow the jackal out the door, my footsteps much louder than Neferu's."
    "Chacalum per ianuam sequor, vestigiis meis multo maiorem strepitum quam vestigia Neferu facientibus."

# game/a1s6.rpy:1142
translate latin a1s6_5bfc0b5a:

    # "As we continue through the halls, I notice that we're taking a different route than the one to the throne room."
    "Dum per ambulacra pergimus, animadverto nos alia via quam ea quae ad aulam throni ducit ire."

# game/a1s6.rpy:1143
translate latin a1s6_3b69c6f6_1:

    # m "\"Where are we going?\""
    m "\"Quo imus?\""

# game/a1s6.rpy:1145
translate latin a1s6_11868419_1:

    # n "\"To meet the star of the most asinine entertainment show in the galaxy. What better way to determine the fate of all things, siblings and parents alike, than through meaningless, wolven spectacle?\""
    n "\"Ut eum conveniamus qui praecipuam partem agit in stultissimo spectaculo totius galaxiae. Quis melior modus omnium rerum fata decernendi, Fratrum atque Parentum aeque, quam per inane Luporum spectaculum?\""

# game/a1s6.rpy:1146
translate latin a1s6_c7944f8f_1:

    # m "\"...What?\""
    m "\"...Quid?\""

# game/a1s6.rpy:1147
translate latin a1s6_1d0a4e69:

    # "Neferu pauses in front of a door, his paw held delicately up to the panel."
    "Neferu ante ianuam consistit, manu leviter ad tabulam sublata."

# game/a1s6.rpy:1149
translate latin a1s6_fa576169:

    # n "\"What I'm saying is that quite a lot is depending on your wolf right now, and he might need some encouragement.\""
    n "\"Hoc dico: nunc permulta e lupo tuo pendent, et fortasse hortatu indiget.\""

# game/a1s6.rpy:1150
translate latin a1s6_dbd86041_1:

    # "I'm still staring at the jackal when he finally presses the panel, opening the door."
    "Adhuc chacalum intueor cum tandem tabulam premit et ianuam aperit."

# game/a1s6.rpy:1156
translate latin a1s6_b2f48c87:

    # "When I look back, I find myself looking into a much smaller room; simple and bare, just a bed and dresser."
    "Cum respicio, multo minus cubiculum video: simplex ac nudum, tantum lectus et armarium."

# game/a1s6.rpy:1157
translate latin a1s6_371a9c9a:

    # "The air is thick with the calming smell of incense as it creeps into the hallway and washes over me in a warm wave."
    "Aer odore turis tranquillitatem afferente gravis in ambulacrum serpit atque me velut calida unda perfundit."

# game/a1s6.rpy:1158
translate latin a1s6_9924e740:

    # "And there, sitting on the bed, is Amicus."
    "Et ibi, in lecto sedens, Amicus est."

# game/a1s6.rpy:1159
translate latin a1s6_349fe3df:

    # "Before I can look back at Neferu, the wolf suddenly looks up."
    "Priusquam ad Neferu respicere possum, lupus subito caput tollit."

# game/a1s6.rpy:1161
translate latin a1s6_e1a1dc0a:

    # "We both stare at each other for a moment, then the wolf is suddenly on his feet, stumbling toward me."
    "Paulisper alter alterum intuemur; tum lupus subito surgit et ad me titubans accedit."

# game/a1s6.rpy:1163
translate latin a1s6_1367b82d:

    # "He stops himself halfway across the room though, paws clasped in front of himself."
    "Sed medio in cubiculo consistit, manibus ante se coniunctis."

# game/a1s6.rpy:1164
translate latin a1s6_5a94f31f:

    # "I've never seen him so disheveled before."
    "Eum tam incomptum numquam antea vidi."

# game/a1s6.rpy:1165
translate latin a1s6_02df8f60:

    # "His fur is stuck up all over his neck and shoulders, his cape is askew, his eyes are red and bleary."
    "Pili circa collum et umeros passim erecti sunt, pallium obliquum, oculi rubri ac turbidi."

# game/a1s6.rpy:1166
translate latin a1s6_2d9a8e60:

    # "Before I know it, I'm walking into the room toward the wolf."
    "Antequam intellego quid agam, iam in cubiculum ad lupum ingredior."

# game/a1s6.rpy:1167
translate latin a1s6_994f6c7b:

    # m "\"Are you okay?\""
    m "\"Vales?\""

# game/a1s6.rpy:1168
translate latin a1s6_e73afff6:

    # "Amicus tries to smooth his fur down, but it sticks right back up."
    "Amicus pilos suos complanare conatur, sed statim rursus eriguntur."

# game/a1s6.rpy:1169
translate latin a1s6_20edd98c:

    # a "\"I'm...I'm fine. I was just meditating.\""
    a "\"Ego...bene valeo. Tantum meditabar.\""

# game/a1s6.rpy:1170
translate latin a1s6_3e9d443e:

    # m "\"You look awful. Isn't the trial in less than an hour?\""
    m "\"Horribilis videris. Nonne certamen intra minus quam unam horam incipiet?\""

# game/a1s6.rpy:1171
translate latin a1s6_4eb44ffd:

    # a "\"...Yes.\""
    a "\"...Ita.\""

# game/a1s6.rpy:1172
translate latin a1s6_b028bdf3:

    # "There's a moment of silence that goes by as I just stare at the wolf."
    "Paulisper silentium est, dum lupum tantum intueor."

# game/a1s6.rpy:1173
translate latin a1s6_ba5cd3fb:

    # m "\"Are...are you going then? You should get ready—\""
    m "\"I...ibis igitur? Te parare debes—\""

# game/a1s6.rpy:1174
translate latin a1s6_9e17ba4d:

    # a "\"[mc]...\""
    a "\"[mc]...\""

# game/a1s6.rpy:1175
translate latin a1s6_705d37e2:

    # "I stop, waiting."
    "Desisto et exspecto."

# game/a1s6.rpy:1176
translate latin a1s6_380c1cae:

    # "The pause is long, and when Amicus finally speaks, his voice is so quiet I can barely hear it."
    "Diu tacet; cum tandem Amicus loquitur, vox eius tam quieta est ut vix audiam."

# game/a1s6.rpy:1179
translate latin a1s6_8087c3b0:

    # a "\"I—I don't think I was meant for this...\""
    a "\"Ego—non puto me ad haec natum esse...\""

# game/a1s6.rpy:1180
translate latin a1s6_116c68d5:

    # "My heart sinks."
    "Animus meus concidit."

# game/a1s6.rpy:1181
translate latin a1s6_376124b5:

    # m "\"Meant for what?\""
    m "\"Ad quae natum?\""

# game/a1s6.rpy:1182
translate latin a1s6_e66e6d08:

    # a "\"Everything in this damned empire. I've done absolutely nothing right. Everything has been handed to me on a platter my entire life, but the first time I actually have to fight for something...\""
    a "\"Ad omnia in hoc maledicto imperio. Nihil omnino recte feci. Per totam vitam omnia mihi ultro oblata sunt, sed ubi primum revera pro aliqua re pugnare debeo...\""

# game/a1s6.rpy:1183
translate latin a1s6_091b061b:

    # a "\"I know you don't think I took this seriously, but I did. I tried...I wasn't prepared, and you were right.\""
    a "\"Scio te putare me haec serio non egisse, sed egi. Conatus sum...paratus non eram, et recte dicebas.\""

# game/a1s6.rpy:1184
translate latin a1s6_d7743d29:

    # "I see a little wetness around his eyes, but he aggressively wipes at them with an arm."
    "Paulum umoris circa oculos eius video, sed eos vehementer bracchio tergit."

# game/a1s6.rpy:1185
translate latin a1s6_dc83cc55:

    # "While weeks ago, I might have welcomed this epiphany, this is the absolute worst moment for it."
    "Ante aliquot hebdomadas fortasse hanc conscientiam libenter accepissem; sed hoc omnium pessimum tempus est."

# game/a1s6.rpy:1187
translate latin a1s6_fb68184e:

    # a "\"I couldn't even keep my best friend. I would have been a terrible emperor.\""
    a "\"Ne optimum quidem amicum retinere potui. Imperator pessimus fuissem.\""

# game/a1s6.rpy:1188
translate latin a1s6_48fe9226:

    # "It takes me a moment to realize that he's talking about me."
    "Paulum temporis opus est ut intellegam eum de me loqui."

# game/a1s6.rpy:1189
translate latin a1s6_74f704d9:

    # m "\"Amicus—\""
    m "\"Amice—\""

# game/a1s6.rpy:1191
translate latin a1s6_0c8c9dfa:

    # a "\"I'm sorry. I'm sorry I didn't tell you everything, that I treated you poorly, that I got you into this stupid mess in the first place...and that I can't get you out of it.\""
    a "\"Ignosce. Ignosce quod tibi omnia non dixi, quod te male tractavi, quod ab initio te in haec stulta mala implicavi...et quod ex eis te eripere non possum.\""

# game/a1s6.rpy:1192
translate latin a1s6_e4861271:

    # "The wolf's voice catches on that last part, and I wonder with some astonishment if I'm actually going to see him cry."
    "In ultimis verbis vox lupi haeret; cum aliqua admiratione miror num revera eum flentem videam."

# game/a1s6.rpy:1194
translate latin a1s6_efca2156:

    # "But he manages to hold it together, looking down at the floor."
    "Sed se continere potest, oculis in solum demissis."

# game/a1s6.rpy:1195
translate latin a1s6_413973b3:

    # a "\"I just wanted to do what was best for you, but I wasn't thinking {i}of{/i} you while I did it. I was inconsiderate, and I'm sorry.\""
    a "\"Tantum quod tibi optimum esset facere volebam, sed dum faciebam, {i}de{/i} te non cogitabam. Inconsideratus fui, et veniam peto.\""

# game/a1s6.rpy:1196
translate latin a1s6_da9220d5:

    # "Amicus stands there quietly, apparently finished."
    "Amicus ibi tacitus stat, quasi iam finierit."

# game/a1s6.rpy:1197
translate latin a1s6_8c43077f:

    # "I don't know if this is more about me, or about him feeling inadequate for the emperorship."
    "Nescio num haec magis ad me pertineant an ad eum, qui se imperio gerendo imparem sentit."

# game/a1s6.rpy:1198
translate latin a1s6_365e2781:

    # "I have no doubt that our little fight yesterday caused it though."
    "Sed certe parva nostra rixa hesterna haec effecit."

# game/a1s6.rpy:1199
translate latin a1s6_6f5eebf2:

    # "Seeing the wolf like this...it hurts, but it also makes me kind of angry."
    "Lupum talem videre...dolet, sed etiam me aliquantum iratum facit."

# game/a1s6.rpy:1200
translate latin a1s6_830c648a:

    # "This isn't the Amicus I know."
    "Hic non est Amicus quem novi."

# game/a1s6.rpy:1201
translate latin a1s6_396ea65b:

    # "I reach up, setting a hand on his shoulder, and he suddenly looks up at me."
    "Manum tollo et umero eius impono; subito ad me oculos tollit."

# game/a1s6.rpy:1202
translate latin a1s6_a3bf8b5c:

    # m "\"You're less than an hour away from becoming the emperor. You need to act like it.\""
    m "\"Intra minus quam unam horam imperator fieri potes. Ita te gerere debes.\""

# game/a1s6.rpy:1204
translate latin a1s6_2d370d51:

    # a "\"Wha—\""
    a "\"Qu—\""

# game/a1s6.rpy:1205
translate latin a1s6_3c8a16f5:

    # m "\"You think your dad would have acted like this when he wasn't sure of himself? Your grandfather, Drusus? There's a time and place and now is NOT the time.\""
    m "\"Putas patrem tuum ita se gessurum fuisse cum sibi non confideret? Avum tuum? Drusum? Suum cuique rei tempus et locus est, et nunc NON est tempus.\""

# game/a1s6.rpy:1206
translate latin a1s6_235f599d:

    # "I don't know if they would have, but I'm grasping at straws at this point."
    "Nescio num ita se gessissent, sed iam quamlibet spem arripio."

# game/a1s6.rpy:1207
translate latin a1s6_f405a8d1:

    # a "\"I—\""
    a "\"Ego—\""

# game/a1s6.rpy:1208
translate latin a1s6_0139524f:

    # m "\"And honestly, this is about a lot more than you, or me, or anyone here. This is about the lives of millions of sapients, about your entire empire. You think it all deserves to go to shit because suddenly you're not really sure of yourself?\""
    m "\"Et, ut verum dicam, haec multo plus quam ad te aut me aut quemquam hic pertinent. Ad vitas plurium milionum Sapientum, ad totum imperium tuum pertinent. Putas omnia pessum ire debere quia subito tibi parum confidis?\""

# game/a1s6.rpy:1209
translate latin a1s6_c2f8e12a:

    # m "\"You're such a good person, basically the opposite of what this society is, and you want to put that into your rule. That's amazing, but now you're suddenly willing to give up? What the fuck is wrong with you!?\""
    m "\"Tam bonus homo es, huic societati fere omnino contrarius, et hoc in imperium tuum inferre vis. Id mirum est; sed nunc subito cedere paratus es? Quid, mehercule, tibi accidit!?\""

# game/a1s6.rpy:1211
translate latin a1s6_4e8dc9e9:

    # m "\"Yeah, you made a bunch of mistakes, but that doesn't matter now. What matters is that you make sure that piece-of-shit-brother of yours doesn't take the throne. So you'd better get your ass out there and beat the hell out him in this stupid debate.\""
    m "\"Ita, multa erravisti; sed nunc id nihil refert. Refert efficere ne frater ille tuus, stercus hominis, thronum obtineat. Itaque melius est te illuc pergere et eum in hac stulta disputatione penitus vincere.\""

# game/a1s6.rpy:1212
translate latin a1s6_c9195947:

    # "I'm not sure what else to say so I stop, breathing hard."
    "Nescio quid aliud dicam, itaque desisto, graviter anhelans."

# game/a1s6.rpy:1214
translate latin a1s6_1a03dbf5:

    # "After a moment, I realize the wolf is smiling at me, and it takes me a moment to calm down from my Hollywood movie pep talk."
    "Aliquanto post intellego lupum mihi subridere; paulum temporis opus est ut post orationem hortatoriam, qualis in pellicula Hollywoodiana sit, quiescam."

# game/a1s6.rpy:1215
translate latin a1s6_df8ec4bc_3:

    # m "\"What?\""
    m "\"Quid?\""

# game/a1s6.rpy:1216
translate latin a1s6_548b4cb8:

    # a "\"I am going to go out there, [mc], there's no doubt about that. I just...I was just having a moment. I was trying to be more honest with you, but thank you.\""
    a "\"Illuc pergam, [mc]; id sine dubio faciam. Tantum...paulisper animo concideram. Tecum sincerius agere conabar, sed gratias tibi ago.\""

# game/a1s6.rpy:1217
translate latin a1s6_e499761a_5:

    # "I frown."
    "Frontem contraho."

# game/a1s6.rpy:1218
translate latin a1s6_e9e0bf95:

    # m "\"Well, you sure picked a hell of a moment to have it.\""
    m "\"Certe horrendum tempus elegisti quo concideres.\""

# game/a1s6.rpy:1220
translate latin a1s6_48b4286f:

    # a "\"I know...I've just been having a terrible time after yesterday, is all. I needed to apologize to you.\""
    a "\"Scio...tantum pessime me habui post diem hesternum. Veniam a te petere debebam.\""

# game/a1s6.rpy:1221
translate latin a1s6_b7f21db1:

    # "I deflate a little, but there's some relief there too, seeing Amicus somewhat back to his old self."
    "Paulum languesco, sed aliquantum quoque levatus sum, cum Amicum ad pristinum animum quodam modo reversum videam."

# game/a1s6.rpy:1222
translate latin a1s6_ebe2fa02:

    # m "\"I...well...I forgive you, but this is a lot bigger than us right now.\""
    m "\"Ego...bene...tibi ignosco, sed nunc haec multo maiora sunt quam nostra res.\""

# game/a1s6.rpy:1224
translate latin a1s6_2a24001e:

    # a "\"I know it is, and what I'm feeling is a lot bigger than us as well.\""
    a "\"Scio; atque ea quae sentio quoque multo maiora sunt quam nostra res.\""

# game/a1s6.rpy:1225
translate latin a1s6_fe534869:

    # "The wolf sets a paw on my shoulder."
    "Lupus manum umero meo imponit."

# game/a1s6.rpy:1226
translate latin a1s6_e93db576:

    # a "\"But I'm honest about what I said; I'm sorry, and I will never do anything involving you without your consultation again...and I will take your cultural differences into better consideration in the future.\""
    a "\"Sed vere dixi: veniam peto, neque umquam rursus quidquam ad te pertinens sine tuo consilio faciam...atque posthac differentias cultus tui diligentius considerabo.\""

# game/a1s6.rpy:1227
translate latin a1s6_7aed6d82:

    # "I look up at Amicus, at his earnest face, and I find myself hugging him, and he hugs back tightly."
    "Ad Amicum, ad sincerum eius vultum suspicio, eumque amplector; ille me vicissim artissime amplectitur."

# game/a1s6.rpy:1228
translate latin a1s6_74da5cb4:

    # m "\"We still need to talk about things, but we can do that later. You need to kick Cassius's ass first.\""
    m "\"Adhuc de rebus colloqui debemus, sed postea possumus. Prius Cassium penitus vincere debes.\""

# game/a1s6.rpy:1229
translate latin a1s6_f27c8d9c_1:

    # a "\"I know.\""
    a "\"Scio.\""

# game/a1s6.rpy:1230
translate latin a1s6_51dbda25:

    # "Amicus pulls back, both paws on my shoulders now."
    "Amicus se retrahit, utraque manu nunc umeris meis imposita."

# game/a1s6.rpy:1231
translate latin a1s6_89ed868d:

    # a "\"And I will.\""
    a "\"Et vincam.\""

# game/a1s6.rpy:1232
translate latin a1s6_3ddc73da:

    # "There's a gentle clearing of a throat behind us, and we both look back to see Neferu casually lounging in the doorway."
    "Post nos aliquis leniter tussit; ambo respicimus et Neferu otiose in limine stantem videmus."

# game/a1s6.rpy:1234
translate latin a1s6_0d4a1a12:

    # n "\"If you're finished, the trial begins in thirty minutes.\""
    n "\"Si finivistis, certamen intra triginta minuta incipiet.\""

# game/a1s6.rpy:1236
translate latin a1s6_305d58b8:

    # "Immediately, Amicus scowls at the sight of the jackal, but he nods."
    "Statim Amicus, chacalo viso, vultum contrahit, sed annuit."

# game/a1s6.rpy:1237
translate latin a1s6_2ba2b15b:

    # a "\"I'd better be going then.\""
    a "\"Itaque melius est me ire.\""

# game/a1s6.rpy:1238
translate latin a1s6_f5300967:

    # m "\"So you're feeling better now?\""
    m "\"Ergo melius te habes?\""

# game/a1s6.rpy:1240
translate latin a1s6_8e3319f9:

    # a "\"Much better, thanks to you!\""
    a "\"Multo melius, gratias tibi!\""

# game/a1s6.rpy:1241
translate latin a1s6_f7a0d3ab:

    # "I smile as I feel a wave of relief, even though this is just like Amicus to be so easily cheered up."
    "Subrideo, dum levamen per me fluit, quamquam facile sic animum recipere omnino Amici est."

# game/a1s6.rpy:1242
translate latin a1s6_0fc1fb9a:

    # "I allow the wolf to pull me toward the door."
    "Sino lupum me ad ianuam trahere."

# game/a1s6.rpy:1245
translate latin a1s6_e36cc1d5:

    # "Neferu moves out of the way as we exit the stifling meditation room."
    "Neferu de via cedit dum ex suffocante meditationis cubiculo egredimur."

# game/a1s6.rpy:1247
translate latin a1s6_84bd0351:

    # a "\"Alright, I'm on my way to a shower.\""
    a "\"Bene, ad imbrem lavatorium eo.\""

# game/a1s6.rpy:1248
translate latin a1s6_383856db:

    # m "\"I'll be watching...the rhetoric thing, I mean.\""
    m "\"Spectabo...rem rhetoricam, dico.\""

# game/a1s6.rpy:1250
translate latin a1s6_20b5148f:

    # a "\"Heh, I'll look for you, and...we'll talk after this?\""
    a "\"Heh, te quaeram, et...post haec colloquemur?\""

# game/a1s6.rpy:1251
translate latin a1s6_7f9d840d:

    # m "\"Yeah, we'll talk after you're emperor.\""
    m "\"Ita, colloquemur postquam imperator eris.\""

# game/a1s6.rpy:1253
translate latin a1s6_b6b84c66:

    # a "\"Alright.\""
    a "\"Bene.\""

# game/a1s6.rpy:1254
translate latin a1s6_769528a5:

    # "Amicus leans in to kiss me on the lips, then pauses before planting it on my cheek instead."
    "Amicus inclinat ut labra mea osculetur; tum consistit et pro eis genam meam osculatur."

# game/a1s6.rpy:1255
translate latin a1s6_4d688270:

    # "With that, he winks, then turns and dashes up the hall, running at a full sprint."
    "Deinde oculo mihi nictat, se vertit atque summa celeritate per ambulacrum currit."

# game/a1s6.rpy:1257
translate latin a1s6_04d2f856:

    # "I hear a soft chuckle behind me."
    "Post me lenem risum audio."

# game/a1s6.rpy:1259
translate latin a1s6_4fa30c9e:

    # n "\"Well, that went rather well. I didn't think that would be half as easy.\""
    n "\"Bene, id satis bene evenit. Ne dimidio quidem tam facile fore putabam.\""

# game/a1s6.rpy:1260
translate latin a1s6_023fc081:

    # "I glance back at the jackal as he basically reveals he's been planning this all along."
    "Ad chacalum respicio, dum quodam modo patefacit se hoc ab initio paravisse."

# game/a1s6.rpy:1261
translate latin a1s6_9ce42112:

    # "I guess it was obvious."
    "Credo id manifestum fuisse."

# game/a1s6.rpy:1262
translate latin a1s6_a405d1ed:

    # n "\"Shall we head to the throne room? They'll be wanting us sitting down early so they can film us. The whole things is a dreary spectacle, after all.\""
    n "\"Ad aulam throni eamus? Nos mature sedere volent, ut nos camera excipere possint. Tota res triste spectaculum est, ut scis.\""

# game/a1s6.rpy:1263
translate latin a1s6_6f19d038:

    # m "\"Alright.\""
    m "\"Bene.\""

# game/a1s6.rpy:1266
translate latin a1s6_67719e2c:

    # "With that, I follow the jackal toward the throne room, hoping that what I'd said to Amicus is enough to get him in the right head space to help him win."
    "Itaque chacalum ad aulam throni sequor, sperans verba quae Amico dixi satis esse ut rectum animum capiat atque vincat."

# game/a1s6.rpy:1267
translate latin a1s6_fad6732e:

    # "In just a few hours, I'll know if I'll be leaving soon...or staying for a long, long time."
    "Intra paucas tantum horas sciam num mox abeam...an per longum, longum tempus maneam."

# game/a1s6.rpy:1268
translate latin a1s6_afd25f6c:

    # "Either way, I'm just glad that this happened."
    "Utroque modo tantum gaudeo haec accidisse."

