
# game/a2s1.rpy:2
translate latin a2s1_a20cefa7:

    # "..."
    "..."

# game/a2s1.rpy:3
translate latin a2s1_160011ff:

    # unk "\"Understand that this will not be easy, even for the parents.\""
    unk "\"Intellege hoc facile non fore, ne Parentibus quidem.\""

# game/a2s1.rpy:4
translate latin a2s1_d9ae59d6:

    # unk "\"The pain will be temporary.\""
    unk "\"Dolor temporarius erit.\""

# game/a2s1.rpy:5
translate latin a2s1_7526860c:

    # "What's happening?"
    "Quid accidit?"

# game/a2s1.rpy:6
translate latin a2s1_a20cefa7_1:

    # "..."
    "..."

# game/a2s1.rpy:7
translate latin a2s1_245b0bf5:

    # unk "\"You will know in time...but not yet.\""
    unk "\"Suo tempore scies...sed nondum.\""

# game/a2s1.rpy:9
translate latin a2s1_1381611a:

    # "Time loses meaning."
    "Tempus significationem amittit."

# game/a2s1.rpy:10
translate latin a2s1_23607765:

    # "Blackness...simultaneously eternal and non-existent."
    "Tenebrae...simul aeternae et nullae."

# game/a2s1.rpy:11
translate latin a2s1_37151c28:

    # "Nightmares ebb and flow, building and fading."
    "Somnia terrifica recedunt ac redeunt, crescunt ac evanescunt."

# game/a2s1.rpy:12
translate latin a2s1_3c0c989d:

    # "Scenes from my earliest childhood to my landing on Adastra, all warped by horrific and violent imagery that never happened."
    "Res ab infantia mea prima usque ad adventum meum in Adastram, omnes horrendis ac violentis imaginibus depravatae, quae numquam acciderunt."

# game/a2s1.rpy:13
translate latin a2s1_5a877227:

    # "But as soon as each one ends, I forget, just like any other dream...except one."
    "Sed ubi quaeque finitur, obliviscor, sicut quodlibet aliud somnium...praeter unum."

# game/a2s1.rpy:16
translate latin a2s1_63fcd66d:

    # "I'm huddled in the seat of the ship, freezing cold, numb with desperation and the fear of impending death."
    "In sella navis me contraho, frigore rigens, desperatione et metu mortis imminentis torpens."

# game/a2s1.rpy:17
translate latin a2s1_37b5952c:

    # "How is this happening to me?"
    "Quomodo hoc mihi accidit?"

# game/a2s1.rpy:18
translate latin a2s1_6586d6e5:

    # "What did I do to deserve this?"
    "Quid feci ut hoc mererer?"

# game/a2s1.rpy:19
translate latin a2s1_c6b91544:

    # "I glance back at the crumpled form of the wolf in the back of the ship."
    "Ad corpus lupi, in posteriore navis parte collapsum, respicio."

# game/a2s1.rpy:20
translate latin a2s1_487348c9:

    # "His head is framed by a pool of blood, the metal pipe just a few feet away where I'd dropped it."
    "Caput eius lacu sanguinis circumdatum est; fistula metallica tantum paucis pedibus abest, ubi eam abieceram."

# game/a2s1.rpy:21
translate latin a2s1_bb3dd992:

    # "I've made a huge mistake."
    "Gravissime erravi."

# game/a2s1.rpy:22
translate latin a2s1_7bd4dbe4:

    # "The anger and terror I'd been feeling over the past several hours, days—"
    "Ira et terror quos per superiores horas, dies—"

# game/a2s1.rpy:23
translate latin a2s1_6b45b899:

    # "...weeks?"
    "...hebdomadas?"

# game/a2s1.rpy:24
translate latin a2s1_1640d67e:

    # "—builds until I scream and smash both of my fists on the glowing panels in front of me."
    "—senseram crescunt, donec clamo et ambos pugnos in tabulas coram me lucentes impingo."

# game/a2s1.rpy:28
translate latin a2s1_56cb53d4:

    # "The next thing I know, light blasts the interior of the ship and I cover my face with my hands."
    "Tum subito lux interiorem navis partem percutit, et faciem manibus tego."

# game/a2s1.rpy:29
translate latin a2s1_670d96d8:

    # "Still, the light pierces through and I see blood-red."
    "Tamen lux penetrat, et ruborem sanguinis video."

# game/a2s1.rpy:30
translate latin a2s1_b4971792:

    # "The ship vibrates violently, and I know right away that we're being pulled into it."
    "Navis vehementer tremit, et statim scio nos in eam trahi."

# game/a2s1.rpy:31
translate latin a2s1_cd5e14cd:

    # "I reach out despite the impossible light, uselessly pounding at the unresponsive panels."
    "Manus porrigo, quamquam lux intolerabilis est, frustra tabulas nihil respondentes pulsans."

# game/a2s1.rpy:32
translate latin a2s1_acdf0673:

    # "After a few moments, the brightness and heat become unbearable, and I finally throw myself to the floor, crawling away, crawling toward my wolf."
    "Aliquanto post lux et calor intolerabiles fiunt; tandem me in solum iacio et repens recedo, ad lupum meum repens."

# game/a2s1.rpy:33
translate latin a2s1_22aff67f:

    # m "\"Amicus, HELP!\""
    m "\"Amice, ADIUVA!\""

# game/a2s1.rpy:36
translate latin a2s1_1109be40:

    # "But the light continues to grow, and soon everything is lit up in a blinding white, the heat so intense that the metal melts underneath my hands and knees."
    "Sed lux crescere pergit, et mox omnia candore caecante illustrantur, calore tam vehementi ut metallum sub manibus genibusque meis liquefiat."

# game/a2s1.rpy:37
translate latin a2s1_93460862:

    # "I'm on fire...I {i}am{/i} fire. I feel lines of molten lead course through from the base of my neck, down my spine, branching out into my limbs, even my toes and fingers."
    "Ardeo...ignis {i}sum{/i}. Rivos plumbi liquefacti sentio ab ima cervice per spinam fluere, in membra mea diffundi, etiam in digitos pedum manuumque."

# game/a2s1.rpy:38
translate latin a2s1_ad6c4dc1:

    # "I can only float in the inferno, dumbly wondering why I still feel if I'm dead, wondering if this {i}is{/i} death as the ship, the wolf, and I become part of the star."
    "Tantum in incendio natare possum, stupide miratus cur adhuc sentiam si mortuus sum, miratus num haec mors {i}sit{/i}, dum navis, lupus atque ego pars stellae fimus."

# game/a2s1.rpy:39
translate latin a2s1_6c6dc7d6:

    # "Once again, time is lost and I only exist as fire."
    "Rursus tempus amittitur, et tantum ut ignis exsisto."

# game/a2s1.rpy:43
translate latin a2s1_c92cd084:

    # "I stare up at the sky, the air suddenly cool as I try to comprehend the sudden change from the harsh, all-consuming starlight, to the gentle, cold moonlight."
    "Caelum suspicio; aer subito frigidus est, dum intellegere conor subitam mutationem a dura stellae luce omnia consumente ad lenem frigidamque lunae lucem."

# game/a2s1.rpy:44
translate latin a2s1_508232ce:

    # "Still, fire continues to lance through my head, neck, spine, and limbs in agonizing lines, my body mapped as a tortured stick figure."
    "Tamen ignis adhuc dolorosis lineis per caput, cervicem, spinam membraque penetrat; corpus meum velut figura lineis ducta cruciata describitur."

# game/a2s1.rpy:45
translate latin a2s1_6a3e0e48:

    # "It hurts...hurts more than anything I've ever experienced, but it's fading after what happened in the star, so I try to relax in the sand."
    "Dolet...plus dolet quam quidquid umquam expertus sum; sed post ea quae in stella acciderunt languescit, itaque in harena requiescere conor."

# game/a2s1.rpy:46
translate latin a2s1_76aaa938:

    # "After a few minutes, I realize that I can hear the waves, and I feel something drawing me toward the water."
    "Post pauca minuta intellego me fluctus audire, et aliquid me ad aquam trahere sentio."

# game/a2s1.rpy:47
translate latin a2s1_6b8343f4:

    # "I'm a little scared of getting up, of any movement at all, terrified that it might trigger the pain anew...but it doesn't."
    "Paulum surgere vereor, omnino moveri; vehementer timeo ne dolor rursus excitetur...sed non excitatur."

# game/a2s1.rpy:48
translate latin a2s1_76f7ea5b:

    # "It almost feels like I'm not moving at all."
    "Paene sentio me omnino non moveri."

# game/a2s1.rpy:50
translate latin a2s1_aac0bcbb:

    # "I glide toward the water, watching the surface reflect the bright planet and moon in hypnotic ripples."
    "Ad aquam labor, spectans superficiem planetam clarum lunamque claram in undis mentem captivantibus reddere."

# game/a2s1.rpy:51
translate latin a2s1_2d08d92d:

    # "Entering the lake and feeling the cold, gentle water wash over my skin is the best feeling I've ever felt."
    "Lacum intrare et frigidam lenemque aquam cutem meam perfundere sentire est suavissimus sensus quem umquam expertus sum."

# game/a2s1.rpy:52
translate latin a2s1_d4cfd0e1:

    # "It envelops me slowly, moving up my legs, torso, and finally my head, and just like that, the pain and fire is chased away, subdued to a dull, tingly throb."
    "Lente me circumdat, crura, corpus, tandem caput ascendens; sic dolor atque ignis pelluntur, ad obscurum pulsus ac formicationis sensum redacti."

# game/a2s1.rpy:53
translate latin a2s1_2a256f2f:

    # "I gasp in relief, somehow able to breathe under the water."
    "Levatus spiritum duco, sub aqua quodam modo spirare valens."

# game/a2s1.rpy:54
translate latin a2s1_af40c3d5:

    # "I drift through the dark water, watching the globes of light dance and sway above me before I finally resurface."
    "Per obscuram aquam feror, globos lucis supra me saltantes ac nutantes spectans, antequam tandem rursus emergo."

# game/a2s1.rpy:55
translate latin a2s1_e7c6f119:

    # "It's only then that I remember Amicus."
    "Tum demum Amici memini."

# game/a2s1.rpy:56
translate latin a2s1_4fd3e49d:

    # "Fear grips me."
    "Metus me capit."

# game/a2s1.rpy:57
translate latin a2s1_3066e1cd:

    # "Was he still on that ship?"
    "Num adhuc in illa nave erat?"

# game/a2s1.rpy:58
translate latin a2s1_fd3518b2:

    # "Did I leave him behind in the star?"
    "Num eum in stella reliqui?"

# game/a2s1.rpy:59
translate latin a2s1_d11e3251:

    # "I look up and see the lights glittering from the palace and I begin to swim towards it, somehow moving much faster than I should be able to."
    "Suspicio et lumina e palatio micantia video; ad illud natare incipio, quodam modo multo celerius motus quam possim."

# game/a2s1.rpy:60
translate latin a2s1_448246f0:

    # "Instead of swimming to the beach though, I end up moving toward the balcony, straight to Amicus's room."
    "Sed pro eo quod ad litus natem, ad maenianum feror, recta ad cubiculum Amici."

# game/a2s1.rpy:61
translate latin a2s1_2bc0dc91:

    # "As I get closer, I realize that someone IS on the balcony."
    "Dum propius accedo, intellego aliquem in maeniano ESSE."

# game/a2s1.rpy:62
translate latin a2s1_709aca38:

    # "It's Amicus, and my heart fills with relief."
    "Amicus est, et cor meum levamine impletur."

# game/a2s1.rpy:63
translate latin a2s1_4b7871a8:

    # "He's got his back to the railing, leaning against it casually."
    "Tergo ad cancellos verso, otiose eis innititur."

# game/a2s1.rpy:64
translate latin a2s1_ae9b9397:

    # "Even though I can only see him from behind, I realize that it's not the Amicus I know."
    "Quamquam eum tantum a tergo videre possum, intellego hunc non esse Amicum quem novi."

# game/a2s1.rpy:65
translate latin a2s1_eb04a09c:

    # "Instead, he's in full robes, and he's a lot more skinny than I remember."
    "Toga totum corpus tegente indutus est, et multo gracilior est quam memini."

# game/a2s1.rpy:66
translate latin a2s1_52d2bf62:

    # "I slow down, wondering why he's not looking at me with all the splashing noises I'm making."
    "Tardius feror, miratus cur ad me non spectet, cum tam multum aquam moveam."

# game/a2s1.rpy:67
translate latin a2s1_b938c562:

    # "Just as I'm about to call up to him though, I see brown arms wrap around him, smoothing over his arms and back and that's when Amicus turns to the side."
    "Sed cum iam eum vocaturus sum, bracchia fusca eum amplecti video, bracchia tergumque eius leniter tangere; tum Amicus se in latus vertit."

# game/a2s1.rpy:68
translate latin a2s1_7c48af8a:

    # "I see now that those arms belong to another wolf, smaller and brown-furred, one that I've never seen before."
    "Iam video illa bracchia alterius lupi esse, minoris et fusco pilo, quem numquam antea vidi."

# game/a2s1.rpy:69
translate latin a2s1_f41d510c:

    # "Amicus is doing the same to him, paws moving around his body in a way that's awkward and hesitant...a pair of young lovers making out for the first time."
    "Amicus idem ei facit, manus circa corpus eius inepte ac dubitanter movens...duo iuvenes amantes primum osculantes."

# game/a2s1.rpy:70
translate latin a2s1_4a3787df:

    # "I watch, suddenly feeling embarrassed."
    "Specto, subito pudore affectus."

# game/a2s1.rpy:74
translate latin a2s1_9116b7fb:

    # "I'm back in Amicus's room, and that same, teen-aged wolf is now on the sofa, bent over, hiding his face behind his paws."
    "Rursus in cubiculo Amici sum; idem lupus adulescens nunc in lectulo est, incurvatus, faciem post manus occultans."

# game/a2s1.rpy:75
translate latin a2s1_161fec76:

    # "I've never seen Amicus really cry, but I can tell that's what he's doing now."
    "Amicum vere flentem numquam vidi, sed intellego eum nunc id facere."

# game/a2s1.rpy:76
translate latin a2s1_90b47541:

    # "I feel the sense of complete and utter shame, the feeling that you've let everyone down."
    "Totum atque integrum dedecus sentio, sensum illum quo omnibus te defuisse putas."

# game/a2s1.rpy:77
translate latin a2s1_b3bd77b8:

    # "It consumes me."
    "Me consumit."

# game/a2s1.rpy:78
translate latin a2s1_47bc94b7:

    # "I reach out toward the young wolf, wanting to comfort him, wondering if he'll even know who I am."
    "Manum ad iuvenem lupum porrigo, eum consolari cupiens, miratus num omnino sciat quis sim."

# game/a2s1.rpy:81
translate latin a2s1_c40df052:

    # "Suddenly, I'm sucked back into the cosmos."
    "Subito rursus in mundum siderum abstrahor."

# game/a2s1.rpy:82
translate latin a2s1_d220ccec:

    # "There is no parent this time."
    "Hoc tempore nullus Parens adest."

# game/a2s1.rpy:83
translate latin a2s1_1373005f:

    # "Instead, I float peacefully through the vacuum, staring down at what I assume is Adastra."
    "Sed tranquille per vacuum feror, deorsum ad id spectans quod Adastram esse puto."

# game/a2s1.rpy:84
translate latin a2s1_f583244f:

    # "Even though there isn't anyone here with me, I sense beings all around me."
    "Quamquam nemo hic mecum est, circum me undique animantes sentio."

# game/a2s1.rpy:86
translate latin a2s1_58bd533f:

    # "I also get a sense of approval, like their work is done."
    "Etiam approbationem sentio, quasi opus eorum perfectum sit."

# game/a2s1.rpy:87
translate latin a2s1_92bfcda0:

    # "\"Finish Meera's work, young human...\""
    "\"Opus Meerae perfice, iuvenis homo...\""

# game/a2s1.rpy:88
translate latin a2s1_4c2327be:

    # "Just like that, I start to drift back down toward the moon, descending faster and faster until everything becomes a blur."
    "Sic rursus ad lunam descendere incipio, celerius celeriusque delapsus donec omnia confusa fiunt."

# game/a2s1.rpy:92
translate latin a2s1_2e0cbece:

    # "This time, coming to feels real, and I immediately know I'm not in a dream."
    "Hoc tempore expergisci verum videtur, et statim scio me in somnio non esse."

# game/a2s1.rpy:93
translate latin a2s1_87975d1f:

    # "I smell lavender."
    "Lavandulam olfacio."

# game/a2s1.rpy:94
translate latin a2s1_f95af865:

    # "Amicus?"
    "Amicus?"

# game/a2s1.rpy:95
translate latin a2s1_14e0825c:

    # "My eyes feel like they're glued shut and I have to rub at them to get them to fully open."
    "Oculi mei quasi glutino clausi sunt; eos fricare debeo ut penitus aperiantur."

# game/a2s1.rpy:96
translate latin a2s1_0ec6e4de:

    # "The first thing I see is the sky, the planet {i}Ancoris{/i}, and the moon {i}Torque{/i}, both of them glowing brightly."
    "Primum caelum, planetam {i}Ancoris{/i} lunamque {i}Torque{/i} video; planeta et luna clare lucent."

# game/a2s1.rpy:97
translate latin a2s1_72fe72f2:

    # "I stare at the two floating orbs for a while, waiting for things to fall into place as to why I'm out here."
    "Duos orbes pendentes aliquamdiu intueor, exspectans dum intellegere possim cur hic foris sim."

# game/a2s1.rpy:98
translate latin a2s1_5bc44a2a:

    # "I'm laying on something hard, like concrete, and I feel soft, but weighty things on my chest."
    "In re dura, velut caemento, iaceo, et res molles sed graves in pectore meo sentio."

# game/a2s1.rpy:99
translate latin a2s1_35a509aa:

    # "My hands are curled around it, and I lift it slowly to have a look, even though it feels like a 50 pound dumbbell."
    "Manus meae eas tenent; lente tollo ut inspiciam, quamquam quasi pondus quinquaginta librarum sunt."

# game/a2s1.rpy:100
translate latin a2s1_f6beb2bb:

    # "Flowers..."
    "Flores..."

# game/a2s1.rpy:101
translate latin a2s1_b4fc8aea:

    # "Flowers with a fair bit of lavender mixed in."
    "Flores, aliquanta lavandula admixta."

# game/a2s1.rpy:102
translate latin a2s1_4c44e917:

    # "Slowly, I turn my head and again, I get the feeling of heavy weights attached to my body."
    "Lente caput verto, et rursus quasi magna pondera corpori meo affixa sentio."

# game/a2s1.rpy:103
translate latin a2s1_e47db068:

    # "I somehow manage it and immediately see that I'm in the amphitheater."
    "Quodam modo id facio et statim video me in amphitheatro esse."

# game/a2s1.rpy:104
translate latin a2s1_e4476fa8:

    # "At the same time, I see more flowers and I realize that they're arranged all around me in a circle."
    "Simul plures flores video et intellego eos circa me in orbem dispositos esse."

# game/a2s1.rpy:105
translate latin a2s1_2f54169e:

    # "Moving my head around also makes me realize that there's something scratchy and prickly on my head."
    "Caput circum movens etiam intellego aliquid asperum atque pungens in capite meo esse."

# game/a2s1.rpy:106
translate latin a2s1_6b7312dc:

    # "Still struggling with my heavy hand, I reach up and grab at it."
    "Adhuc gravem manum aegre movens, eam tollo et rem capio."

# game/a2s1.rpy:107
translate latin a2s1_1e21f6bd:

    # "I lift it from my head and hold it in front of my face, my eyes taking a few moments to focus to find out that it's a wreath, pink flowers woven into the twigs."
    "E capite eam tollo et ante faciem teneo; oculis meis paulum temporis opus est ut clare videant et intellegam coronam esse, roseis floribus inter ramulos contextis."

# game/a2s1.rpy:108
translate latin a2s1_5ccba045:

    # "I finally drop my arm to the side, getting too tired to hold it up and I watch it lazily roll a few feet away."
    "Tandem bracchium ad latus demitto, nimis defatigatus ut sublatum teneam; specto coronam lente paucis pedibus provolvi."

# game/a2s1.rpy:109
translate latin a2s1_a29ad6ff:

    # "The movement sends a wave of tingling through my body, but it fades quickly"
    "Motus formicationis undam per corpus meum mittit, sed cito evanescit"

# game/a2s1.rpy:110
translate latin a2s1_3f184c4f:

    # "The heavy weakness is also starting to fade, but I'm more worried about how I got here, and why I'm covered in flowers."
    "Gravis infirmitas quoque languescere incipit; sed magis sollicitus sum quomodo huc venerim et cur floribus tegar."

# game/a2s1.rpy:111
translate latin a2s1_5d59597f:

    # "From what I can tell, I'm in the gardens, though a part of it I haven't been to before."
    "Quantum intellegere possum, in hortis sum, quamquam in parte quam antea non adii."

# game/a2s1.rpy:112
translate latin a2s1_608f8f9a:

    # "I close my eyes, trying to remember how I got here."
    "Oculos claudo, conatus meminisse quomodo huc venerim."

# game/a2s1.rpy:113
translate latin a2s1_aa7471c5:

    # "Amicus...the Trial of Rhetoric...the restaurant...being sick."
    "Amicus...Certamen Rhetoricae...popina...morbus."

# game/a2s1.rpy:114
translate latin a2s1_982371be:

    # "Again, I lift my arm, though it's easier this time, and I look at the skin."
    "Rursus bracchium tollo, quamquam hoc tempore facilius est, et cutem inspicio."

# game/a2s1.rpy:115
translate latin a2s1_2e1f785a:

    # "It's covered in crusty, yellow-ish scabs, though they don't hurt."
    "Siccis crustis subflavis tegitur, quamquam non dolent."

# game/a2s1.rpy:116
translate latin a2s1_c48dfb6d:

    # "I don't know why, but I get the feeling that the skin underneath is completely healed."
    "Nescio cur, sed mihi videtur cutis sub eis penitus sanata esse."

# game/a2s1.rpy:117
translate latin a2s1_9d917297:

    # "I try to think again."
    "Rursus cogitare conor."

# game/a2s1.rpy:118
translate latin a2s1_6d4bcfce:

    # "I do remember throwing up on Cassius, but after that...just terrible dreams."
    "Memini me in Cassium vomuisse, sed postea...tantum somnia horrenda."

# game/a2s1.rpy:119
translate latin a2s1_f321f7d2:

    # "Did they heal me somehow?"
    "Num me quodam modo sanaverunt?"

# game/a2s1.rpy:120
translate latin a2s1_27bc3cea:

    # "Is this flower thing part of that?"
    "Num haec res florum pars eius est?"

# game/a2s1.rpy:121
translate latin a2s1_db2ec920:

    # "I'm feeling some of my strength returning, so I force myself into a sitting position, joints popping and muscles stiff."
    "Aliquantum virium redire sentio, itaque me sedere cogo, articulis crepitantibus musculisque rigidis."

# game/a2s1.rpy:122
translate latin a2s1_fc4c80fa:

    # "Still, with every movement things get easier."
    "Tamen quoque motu res faciliores fiunt."

# game/a2s1.rpy:123
translate latin a2s1_6f1980e9:

    # "I do get light-headed though, and I have to sit there for a moment, looking around again, wondering where Amicus is."
    "Sed vertiginem patior, itaque paulisper ibi sedere debeo, rursus circumspiciens, miratus ubi Amicus sit."

# game/a2s1.rpy:124
translate latin a2s1_62544444:

    # "He'd sounded so desperate and sad the last I heard him."
    "Tam desperatus ac tristis videbatur cum eum novissime audivi."

# game/a2s1.rpy:125
translate latin a2s1_374a4dce:

    # "I need to show him that I'm okay now...at least I think I am."
    "Ei ostendere debeo me nunc bene valere...saltem ita puto."

# game/a2s1.rpy:126
translate latin a2s1_458b3b89:

    # "I slowly push myself up, listening to the gunshot cracks of my knees, as if I hadn't used them for days."
    "Lente me erigo, crepitus genuum velut ictus sclopeti audiens, quasi per dies eis usus non sim."

# game/a2s1.rpy:127
translate latin a2s1_b28f2e2c:

    # "I stand unsteadily in the center of the square, looking around at the circle of flowers."
    "In medio spatio quadrato titubans sto, orbem florum circumspiciens."

# game/a2s1.rpy:128
translate latin a2s1_13be5b50:

    # "I'm startled when I turn and see a wolf behind me...but it's just a sculpture."
    "Exterret me cum me verto et lupum post me video...sed statua tantum est."

# game/a2s1.rpy:129
translate latin a2s1_ab4cb26e:

    # "A male wolf decked out in armor, both of his paws raised to the sky."
    "Lupus mas armis ornatus, utraque manu ad caelum sublata."

# game/a2s1.rpy:130
translate latin a2s1_753ca14d:

    # "He's got a bunch of flowers weaved around his wrists and on his head too."
    "Multi flores circa carpos eius atque in capite quoque contexti sunt."

# game/a2s1.rpy:131
translate latin a2s1_22f6f53b:

    # "I wait a few moments, listening for anyone that might be nearby."
    "Paulisper exspecto, auscultans num quis prope sit."

# game/a2s1.rpy:132
translate latin a2s1_9d30af44:

    # "All I hear are the insects around me."
    "Tantum insecta circa me audio."

# game/a2s1.rpy:133
translate latin a2s1_ba3febdd:

    # "So, I start to move toward the path that I know leads to the palace."
    "Itaque ad semitam, quam scio ad palatium ducere, ire incipio."

# game/a2s1.rpy:134
translate latin a2s1_49e187fa:

    # "Although I'm pretty sure I'm not dreaming now, this eerie scenario has me questioning that."
    "Quamquam satis certus sum me nunc non somniare, haec mira atque terrifica condicio me dubitare facit."

# game/a2s1.rpy:135
translate latin a2s1_25592392:

    # "The whole situation is surreal."
    "Tota res quasi ultra veritatem est."

# game/a2s1.rpy:136
translate latin a2s1_d58e3da8:

    # "All of the things that I remember happening last feel so distant."
    "Omnia quae novissime accidisse memini tam remota videntur."

# game/a2s1.rpy:137
translate latin a2s1_d5e18e8b:

    # "Despite spending all of my time on Adastra trying to be covert, I find myself longing to find someone, anyone really."
    "Quamquam omne tempus in Adastra occultus esse conatus sum, nunc aliquem, quemlibet, invenire cupio."

# game/a2s1.rpy:138
translate latin a2s1_d85c515b:

    # "I just need to know what's happened."
    "Tantum scire debeo quid acciderit."

# game/a2s1.rpy:139
translate latin a2s1_db7c317d:

    # "And pretty soon, I do find someone."
    "Et satis cito aliquem invenio."

# game/a2s1.rpy:140
translate latin a2s1_51517c3c:

    # "His back is to me, stooped over, fur almost ghostly in the glow of the garden lights."
    "Tergo mihi verso incurvatus stat, pilis in lumine hortorum paene umbrae similis."

# game/a2s1.rpy:141
translate latin a2s1_5efb5a4e:

    # "The cat busies himself with some flowers, a pair of metal clippers in his paws."
    "Felis circa flores occupatus est, forfice metallica manibus tenta."

# game/a2s1.rpy:142
translate latin a2s1_9b556c71:

    # "As I get closer, I can hear him humming just above the noise of his busy snipping."
    "Dum propius accedo, eum leniter cantillantem supra strepitum forficis operosae audire possum."

# game/a2s1.rpy:143
translate latin a2s1_20d66d9a:

    # "I'm just opening my mouth when I see his ears perk."
    "Iam os aperio cum aures eius erigi video."

# game/a2s1.rpy:144
translate latin a2s1_7ca27fa3:

    # al "\"Cass? You know I don't like these games.\""
    al "\"Cass? Scis me hos ludos non amare.\""

# game/a2s1.rpy:146
translate latin a2s1_d08a6b46:

    # "Alex turns to face me, a knowing smile on his lips."
    "Alex se ad me vertit, labris conscius subridens."

# game/a2s1.rpy:148
translate latin a2s1_3c880225:

    # "That quickly disappears the second he sees me though, replaced by a look of complete shock."
    "Sed arrisus statim evanescit ubi me videt, vultu stupore absoluto mutato."

# game/a2s1.rpy:149
translate latin a2s1_02be851c:

    # al "\"Ah—\""
    al "\"Ah—\""

# game/a2s1.rpy:150
translate latin a2s1_2b00a40e:

    # "Whatever he was trying to say doesn't seem to want to come out, and instead, he just stands there, gaping at me."
    "Quidquid dicere conabatur, proferre non potest; tantum ibi stat, ore aperto me spectans."

# game/a2s1.rpy:151
translate latin a2s1_50a1817c:

    # m "\"H—hey...\""
    m "\"S—salve...\""

# game/a2s1.rpy:152
translate latin a2s1_d63bda65:

    # "I can barely talk, my voice rasping out like sandpaper on wood."
    "Vix loqui possum; vox mea aspera exit velut charta aspera lignum radens."

# game/a2s1.rpy:153
translate latin a2s1_60746ad3:

    # "I take a step forward and that's when Alex finally reacts, jumping almost a foot into the air in a backwards motion, putting space between us as he yelps."
    "Unum passum propius facio; tum demum Alex reagit, retro paene unum pedem in aerem saliens, spatium inter nos faciens dum exclamat."

# game/a2s1.rpy:155
translate latin a2s1_b81aa4d4:

    # al "\"What...what!? How!?\""
    al "\"Quid...quid!? Quomodo!?\""

# game/a2s1.rpy:156
translate latin a2s1_06cbe9de:

    # "He stutters, and stumbles over his words."
    "Balbutit et in verbis haeret."

# game/a2s1.rpy:157
translate latin a2s1_639ebd86:

    # "I've seen Alex flustered before, but never like this."
    "Alex perturbatum antea vidi, sed numquam sic."

# game/a2s1.rpy:158
translate latin a2s1_0c721863:

    # "There's real fear in his eyes as he stumbles against some bushes."
    "Verus metus in oculis eius est, dum in frutices titubat."

# game/a2s1.rpy:159
translate latin a2s1_9666338d:

    # "I wonder if he's just going to take off running, but instead he stands there, quivering as he holds the clippers up in front of his chest, as if contemplating using them as a weapon."
    "Miror num subito currendo fugiat; sed ibi stat, tremens, forficem ante pectus tenens, quasi ea pro telo uti cogitet."

# game/a2s1.rpy:160
translate latin a2s1_5e6ae92c:

    # "I raise my hands reassuringly."
    "Manus ad eum confirmandum tollo."

# game/a2s1.rpy:161
translate latin a2s1_5f144e3e:

    # m "\"Hey...Alex, it's me...\""
    m "\"Heus...Alex, ego sum...\""

# game/a2s1.rpy:162
translate latin a2s1_f2dac74d:

    # "I cough a few times, trying to clear my throat."
    "Aliquoties tussio, guttur purgare conatus."

# game/a2s1.rpy:163
translate latin a2s1_9bf90bb5:

    # "I see Alex's ears twitch at the sound as he slowly lowers the clippers, though he moves to the side away from the bush, giving himself a clear path to the palace."
    "Aures Alex sono moveri video, dum lente forficem demittit; sed a frutice in latus recedit, liberam viam ad palatium sibi parans."

# game/a2s1.rpy:165
translate latin a2s1_673bde58:

    # al "\"[mc]? But how?\""
    al "\"[mc]? Sed quomodo?\""

# game/a2s1.rpy:166
translate latin a2s1_c554c7d0:

    # "He's staring at me like what he's seeing is impossible."
    "Me spectat quasi quod videt fieri non possit."

# game/a2s1.rpy:167
translate latin a2s1_86449a24:

    # m "\"How what?\""
    m "\"Quomodo quid?\""

# game/a2s1.rpy:168
translate latin a2s1_1ec05cea:

    # "I'm regaining my voice slowly, but surely."
    "Vocem lente sed certe recipio."

# game/a2s1.rpy:169
translate latin a2s1_604e6184:

    # m "\"What's happening?\""
    m "\"Quid accidit?\""

# game/a2s1.rpy:170
translate latin a2s1_3fe13a32:

    # "Alex finally seems to get a hold of himself, fur slowly laying flat again as he eyes me, looking almost suspicious."
    "Tandem Alex se continere videtur, pilis lente rursus complanatis, dum me intuetur, paene suspiciosus."

# game/a2s1.rpy:172
translate latin a2s1_2e576bda:

    # al "\"I could ask you the same thing.\""
    al "\"Idem a te quaerere possem.\""

# game/a2s1.rpy:173
translate latin a2s1_1767bb16:

    # "This catches me off-guard."
    "Hoc me incautum deprehendit."

# game/a2s1.rpy:174
translate latin a2s1_fdcfd18e:

    # m "\"Why?\""
    m "\"Cur?\""

# game/a2s1.rpy:175
translate latin a2s1_94dd6a87:

    # al "\"Well...\""
    al "\"Bene...\""

# game/a2s1.rpy:176
translate latin a2s1_a4a3dc23:

    # "Alex looks around before focusing on me again, tilting his head, as if to look at me from a different angle."
    "Alex circumspicit, deinde rursus me spectat, capite inclinato, quasi me ex alio angulo inspiciat."

# game/a2s1.rpy:178
translate latin a2s1_073b4648:

    # al "\"You were...you were dead.\""
    al "\"Eras...mortuus eras.\""

# game/a2s1.rpy:179
translate latin a2s1_90c3f286:

    # m "\"Dead?\""
    m "\"Mortuus?\""

# game/a2s1.rpy:180
translate latin a2s1_2291d7a0:

    # al "\"Well, not completely, but you were in a coma that we were told you would not wake up from.\""
    al "\"Bene, non penitus, sed in sopore eras ex quo nobis dictum est te non experrecturum.\""

# game/a2s1.rpy:181
translate latin a2s1_2d6ee573:

    # m "\"Oh.\""
    m "\"O.\""

# game/a2s1.rpy:182
translate latin a2s1_be758cce:

    # "I look down at myself, as if to confirm that I am indeed alive and well."
    "Me ipsum deorsum inspicio, quasi confirmem me vere vivere atque valere."

# game/a2s1.rpy:183
translate latin a2s1_49f4091f:

    # "Aside from the patchy scabs all over my arms and legs, I feel okay, aside from the grogginess."
    "Praeter crustas passim per bracchia cruraque sparsas, bene me habeo, sopore excepto."

# game/a2s1.rpy:184
translate latin a2s1_e57e4c16:

    # m "\"I thought the doctor healed me.\""
    m "\"Putabam medicum me sanavisse.\""

# game/a2s1.rpy:185
translate latin a2s1_757f0f1b:

    # "Alex's ears perk."
    "Aures Alex eriguntur."

# game/a2s1.rpy:187
translate latin a2s1_14b7da30:

    # al "\"Doctor?\""
    al "\"Medicus?\""

# game/a2s1.rpy:188
translate latin a2s1_6074f15d:

    # m "\"I mean, I think there was a doctor...I heard him when I was brought back here.\""
    m "\"Dico me putare medicum adfuisse...eum audivi cum huc reportatus sum.\""

# game/a2s1.rpy:190
translate latin a2s1_ba979357:

    # "Alex's eyes narrow."
    "Oculi Alex contrahuntur."

# game/a2s1.rpy:191
translate latin a2s1_b1ccb7d2:

    # al "\"Amicus told us you were vegetative before he arrived, how did you hear him?\""
    al "\"Amicus nobis dixit te iam ante medici adventum sensu omni caruisse; quomodo eum audivisti?\""

# game/a2s1.rpy:192
translate latin a2s1_f2ccde3e:

    # m "\"I...I dunno, I might have dreamed it. I was really out of it.\""
    m "\"Ego...nescio, fortasse somniavi. Minime mihi conscius eram.\""

# game/a2s1.rpy:193
translate latin a2s1_d36092b2:

    # al "\"If you were still concious when he arrived, he should have been able to halt the damage caused by the virus. Who was the doctor?\""
    al "\"Si adhuc conscius eras cum venit, damnum morbo virali illatum sistere potuisset. Quis medicus erat?\""

# game/a2s1.rpy:194
translate latin a2s1_a5374efd:

    # "With every passing second, I regain more and more of my wits, and Alex's demeanor is confusing me."
    "Quoque momento magis magisque mentem recipio, et mores Alex me confundunt."

# game/a2s1.rpy:195
translate latin a2s1_def963f3:

    # "He thought I was dead, and instead of being happy, I feel like he's interrogating me."
    "Me mortuum putabat; sed pro eo quod gaudeat, me interrogare videtur."

# game/a2s1.rpy:196
translate latin a2s1_2c651f30:

    # "That's also when I realize something else:"
    "Tum etiam aliud intellego:"

# game/a2s1.rpy:197
translate latin a2s1_705614c7:

    # m "\"Wait, you all think I'm dead?\""
    m "\"Exspecta, omnes me mortuum putatis?\""

# game/a2s1.rpy:199
translate latin a2s1_1b68d77a:

    # al "\"Well, not me anymore, obviously. This is all very strange...how did you survive, exactly?\""
    al "\"Bene, ego iam non, ut patet. Omnia haec valde mira sunt...quomodo vere superfuisti?\""

# game/a2s1.rpy:200
translate latin a2s1_9b64e0ec:

    # "Now the cat is starting to annoy me, and I look past him toward the palace, the situation finally dawning on me."
    "Iam felis me irritare incipit; praeter eum ad palatium specto, tandem condicionem intellegens."

# game/a2s1.rpy:201
translate latin a2s1_54ae3d90:

    # m "\"Where's Amicus?\""
    m "\"Ubi est Amicus?\""

# game/a2s1.rpy:202
translate latin a2s1_7ac60d87:

    # "The cat is quiet for a moment, as if contemplating something, then quirks his head."
    "Felis paulisper tacet, quasi aliquid deliberet, tum caput inclinat."

# game/a2s1.rpy:203
translate latin a2s1_5fda0983:

    # al "\"I'm not sure. He's been here and there, though I haven't seen him for at least a day.\""
    al "\"Non certus sum. Hic illic fuit, quamquam eum saltem per unum diem non vidi.\""

# game/a2s1.rpy:204
translate latin a2s1_51f4f438:

    # "I walk past the cat, toward the palace, realizing what sort of state the wolf might be in."
    "Praeter felem ad palatium ambulo, intellegens quo animo lupus esse possit."

# game/a2s1.rpy:206
translate latin a2s1_34cccb2b:

    # al "\"Where are you going? I'm very happy to see that you are well. This is all just very sudden and unexpected.\""
    al "\"Quo is? Valde gaudeo te bene valere. Haec omnia tantum valde subita atque inopinata sunt.\""

# game/a2s1.rpy:207
translate latin a2s1_836f1b1c:

    # "I ignore Alex, not really in the mood to figure out why he's acting the way he is."
    "Alex neglego, minime cupiens intellegere cur ita se gerat."

# game/a2s1.rpy:208
translate latin a2s1_acee2047:

    # "He's making me feel like I'm still dreaming."
    "Me facit putare me adhuc somniare."

# game/a2s1.rpy:210
translate latin a2s1_a0a6d4c0:

    # "So I walk quickly, and I'm relieved that he doesn't follow me."
    "Itaque celeriter ambulo et levatus sum quod me non sequitur."

# game/a2s1.rpy:213
translate latin a2s1_57c8c97b:

    # "The wave of cool air that hits me as I enter the palace is a welcome feeling, and I find myself grateful to be back."
    "Unda frigidi aeris quae me palatium intrantem percutit grata est, et me redisse gratias ago."

# game/a2s1.rpy:214
translate latin a2s1_4324a409:

    # "Despite having apparently been here the whole time, it really does feel like I've been away for weeks."
    "Quamquam, ut videtur, toto tempore hic fui, vere sentio me per hebdomadas abfuisse."

# game/a2s1.rpy:215
translate latin a2s1_196ebb3f:

    # "I pick up the pace as I head toward Amicus's room, practically jogging."
    "Gradum accelero dum ad cubiculum Amici eo, paene currens."

# game/a2s1.rpy:216
translate latin a2s1_bec4a70d:

    # "I have to let him know that I'm okay."
    "Ei scire faciam me bene valere."

# game/a2s1.rpy:217
translate latin a2s1_780edd54:

    # "The short distance to his room seems like it takes longer than it ever has before, and I'm glad that I don't run into anyone else on the way."
    "Breve iter ad cubiculum eius longius quam umquam antea videtur; gaudeo me in via neminem alium convenire."

# game/a2s1.rpy:218
translate latin a2s1_38af3931:

    # "That interaction with Alex was weird and I don't need a repeat of that right now."
    "Ille sermo cum Alex mirus erat; nunc talem rursus habere non debeo."

# game/a2s1.rpy:219
translate latin a2s1_ffc1b34a:

    # "I finally make it to his door and I immediately hear muffled chattering behind it."
    "Tandem ad ianuam eius pervenio et statim obscurum sermonem post eam audio."

# game/a2s1.rpy:220
translate latin a2s1_5d4338c9:

    # "I don't hesitate though, and I press my hand to the panel."
    "Sed non dubito et manum tabulae admoveo."

# game/a2s1.rpy:224
translate latin a2s1_ee46c8af:

    # "The door slides open, and instead of the usual blast of even colder air I would often get from Amicus's room, it's stuffy, warm, and the smell a little bit musky."
    "Ianua labitur et aperitur; pro solita unda etiam frigidioris aeris quae e cubiculo Amici saepe veniebat, aer suffocans, calidus est, et moschi odor leviter sentitur."

# game/a2s1.rpy:225
translate latin a2s1_6d59c678:

    # "The lights are dimmed, and my heart sinks when I see the empty bed."
    "Lumina obscurata sunt, et animus meus concidit cum lectum vacuum video."

# game/a2s1.rpy:226
translate latin a2s1_460bbc32:

    # "I linger in the doorway though, something feeling off."
    "Tamen in limine moror, quod aliquid alienum videtur."

# game/a2s1.rpy:227
translate latin a2s1_99c19046:

    # "The droning chatter is Com, giving what sounds like a monologue on the history of some past emperor."
    "Ille sermo assiduus Computatri est, quod quasi solum de historia cuiusdam pristini imperatoris disserit."

# game/a2s1.rpy:228
translate latin a2s1_999c8f56:

    # "I see wine bottles too, mostly bunched together on top of the bedside table, but there are also a few laying here and there on the floor."
    "Lagenas vini quoque video, plerasque in mensula iuxta lectum congregatas, sed aliquot etiam hic illic in solo iacentes."

# game/a2s1.rpy:229
translate latin a2s1_2e87079d:

    # m "\"Amicus?\""
    m "\"Amice?\""

# game/a2s1.rpy:230
translate latin a2s1_122a2bd7:

    # "I call out, starting to become afraid of what I might find."
    "Voco, timere incipiens quid inveniam."

# game/a2s1.rpy:231
translate latin a2s1_d0491686:

    # "I take a few tentative steps into the room, then I hear a loud snore and instantly, the worry gripping my chest starts to release."
    "Paucos passus dubitanter in cubiculum facio; tum stertentem clare audio, et statim metus pectus meum premens languescit."

# game/a2s1.rpy:232
translate latin a2s1_2c3f6caf:

    # "I'd recognize that sound anywhere."
    "Illum sonum ubicumque agnoscerem."

# game/a2s1.rpy:233
translate latin a2s1_23b00d31:

    # "I hurry over to the other side of the bed where I find my wolf splayed out on the floor, a wine bottle next to his head, only in his underwear."
    "Ad alterum lecti latus festino, ubi lupum meum in solo expansum invenio, lagena vini iuxta caput, subligaculo tantum indutum."

# game/a2s1.rpy:234
translate latin a2s1_2a116355:

    # "He's clearly asleep...or passed out, muzzle hanging wide open as another, thunderous snore shakes the floor."
    "Certe dormit...aut sensu caret, rostro late aperto, dum alius stertentis sonus velut tonitrus solum quatit."

# game/a2s1.rpy:235
translate latin a2s1_0c416389:

    # m "\"Amicus!\""
    m "\"Amice!\""

# game/a2s1.rpy:236
translate latin a2s1_ab30108e:

    # "I crouch down next to him, resting a hand on his chest, trying to shake him awake."
    "Iuxta eum me demitto, manum pectori eius imponens, eum quatiendo excitare conatus."

# game/a2s1.rpy:237
translate latin a2s1_5e959ba1:

    # "His only response is a few more broken snorts before drooling out the side of his muzzle."
    "Tantum aliquot alios interruptos fremitus reddit, antequam saliva e rostri latere fluit."

# game/a2s1.rpy:238
translate latin a2s1_02b85c32:

    # "I switch to patting at his face, then grabbing his muzzle and shaking it around, noticing how crusty the fur is, something I've never felt on Amicus before."
    "Faciem eius leniter pulsare incipio, deinde rostrum capio et quatio, animadvertens quam crustosi pili sint, quod in Amico numquam antea sensi."

# game/a2s1.rpy:239
translate latin a2s1_0c416389_1:

    # m "\"Amicus!\""
    m "\"Amice!\""

# game/a2s1.rpy:240
translate latin a2s1_93c40b17:

    # "I consider slapping him like I've seen people do in the movies, then I see the bottle next to his head and decide to go for another approach."
    "Cogito eum alapa ferire, sicut homines in pelliculis facere vidi; tum lagenam iuxta caput video et aliam rationem eligo."

# game/a2s1.rpy:241
translate latin a2s1_9e7f29f9:

    # "I snatch it up and hurry to the bathroom."
    "Eam arripio et ad balneum festino."

# game/a2s1.rpy:243
translate latin a2s1_db95341a:

    # "I hold the bottle under the faucet for a good five seconds, letting it fill up with soapy water to the halfway point before I hurry back out into the room."
    "Lagenam sub epistomio per quinque integra secunda teneo, aqua saponata ad dimidiam impleri sinens, antequam rursus in cubiculum festino."

# game/a2s1.rpy:245
translate latin a2s1_31282c9e:

    # "Meanwhile, Com doesn't seem to notice me, droning on about how this particular emperor was known for having a fondness of orchids."
    "Interea Computatrum me animadvertere non videtur, pergens disserere quomodo ille imperator amore orchidum notus fuerit."

# game/a2s1.rpy:246
translate latin a2s1_2bdfe313:

    # "I crouch down next to Amicus again, hesitating for a second as I wonder if maybe I should call Cato...probably not Cato...Neferu maybe, just in case Amicus is actually in trouble."
    "Rursus iuxta Amicum me demitto, paulisper dubitans num Catonem vocem...probabiliter non Catonem...fortasse Neferu, si forte Amicus vere periclitatur."

# game/a2s1.rpy:247
translate latin a2s1_1d03a23d:

    # "I don't know how much a wolf can drink before it can kill them, but the sheer amount of bottles laying around the room worries me."
    "Nescio quantum lupus bibere possit antequam id eum occidat, sed tanta multitudo lagenarum per cubiculum iacentium me sollicitat."

# game/a2s1.rpy:248
translate latin a2s1_38abd19e:

    # "I decide to just go ahead with my plan, and I upend the bottle over Amicus's face."
    "Consilium meum persequi statuo, et lagenam supra faciem Amici everto."

# game/a2s1.rpy:249
translate latin a2s1_3d315301:

    # "It pours directly onto his nose and he immediately chokes, turning his head this way and that to avoid the stream of bubbly water."
    "Recta in nasum eius effluit; statim suffocatur, caput huc illuc vertens ut rivum aquae spumosae vitet."

# game/a2s1.rpy:250
translate latin a2s1_8246ee8c:

    # "I have a moment to wonder if drowning him is the best approach before he suddenly sits up, pawing at his face."
    "Paulisper miror num eum submergere optima ratio sit; tum subito sedet, faciem manibus tergens."

# game/a2s1.rpy:252
translate latin a2s1_a4a4ee61:

    # a "\"Gah!\""
    a "\"Gah!\""

# game/a2s1.rpy:253
translate latin a2s1_039aeb77:

    # "The wolf covers his eyes and it's only then that I realize how irritating the soap might be for them."
    "Lupus oculos tegit; tum demum intellego quantum sapo eos irritare possit."

# game/a2s1.rpy:254
translate latin a2s1_57b286fd:

    # m "\"Shit, sorry! Should I get some water from the shower so you can rinse your eyes out?\""
    m "\"Merda, ignosce! Aquam e lavatorio petam ut oculos eluere possis?\""

# game/a2s1.rpy:255
translate latin a2s1_7e55b344:

    # "Amicus freezes, still covering his face, then slowly lowers his paws to reveal his bleary, bloodshot eyes."
    "Amicus immobilis fit, faciem adhuc tegens; tum lente manus demittit et oculos turbidos sanguineque rubros patefacit."

# game/a2s1.rpy:258
translate latin a2s1_34b31d73:

    # "He stares at me in a way that he never has before."
    "Me spectat sicut numquam antea fecit."

# game/a2s1.rpy:259
translate latin a2s1_0cfb7b95:

    # "It's kind of surprised like Alex had been, but rather than fear, Amicus simply looks empty, numb."
    "Aliquantum attonitus est, sicut Alex erat; sed pro metu Amicus tantum vacuus et torpens videtur."

# game/a2s1.rpy:260
translate latin a2s1_994f6c7b:

    # m "\"Are you okay?\""
    m "\"Vales?\""

# game/a2s1.rpy:261
translate latin a2s1_bda79675:

    # "I reach out, but Amicus turns his head away."
    "Manum porrigo, sed Amicus caput avertit."

# game/a2s1.rpy:263
translate latin a2s1_a502c2d7:

    # a "\"Away with you ghost...enough of your torment.\""
    a "\"Abi, umbra...satis me cruciavisti.\""

# game/a2s1.rpy:264
translate latin a2s1_998f342a:

    # "He keeps his head turned away, eyes closed."
    "Caput aversum, oculos clausos tenet."

# game/a2s1.rpy:265
translate latin a2s1_066a1a4f:

    # m "\"Ghost? Amicus, it's me.\""
    m "\"Umbra? Amice, ego sum.\""

# game/a2s1.rpy:266
translate latin a2s1_915985b2:

    # "I reach out and grab his face, and that seems to shock him as he jumps and turns to look me right in the eye."
    "Manum porrigo et faciem eius capio; hoc eum terrere videtur, quia subsilit et se vertit ut recta in oculos meos spectet."

# game/a2s1.rpy:268
translate latin a2s1_a79ed9e2:

    # "I can tell that he's drunk, very drunk, but there's an extra distant look in his eyes that I don't like."
    "Intellego eum ebrium, valde ebrium esse; sed etiam remotior quidam obtutus in oculis eius est, qui mihi displicet."

# game/a2s1.rpy:270
translate latin a2s1_fe1a0c89:

    # m "\"Amicus...what are you on? Did you take something?\""
    m "\"Amice...quid sumpsisti? Aliquid sumpsisti?\""

# game/a2s1.rpy:271
translate latin a2s1_f7fb34ff:

    # "I hold his big head steady, feeling the fullness of his cheeks in my hands, looking into his familiar eyes, no matter how glazed and unfocused they are."
    "Magnum eius caput firmum teneo, plenas genas manibus meis sentiens, in familiares oculos spectans, quamvis vitrei et incerti sint."

# game/a2s1.rpy:273
translate latin a2s1_6bbf591c:

    # "Then I find myself throwing my arms around his neck and leaning into his body, the reality of the situation crashing down on me all at once."
    "Tum bracchia circa collum eius iacio et corpori eius innitor, tota rei veritate subito me opprimente."

# game/a2s1.rpy:274
translate latin a2s1_0d29a13a:

    # "Amicus gasps into my ear, as if my touch suddenly makes him realize that I'm real, that I'm here."
    "Amicus ad aurem meam spiritum ducit, quasi tactus meus subito faciat eum intellegere me verum esse, me adesse."

# game/a2s1.rpy:275
translate latin a2s1_709ec02a:

    # "Clumsily, he starts to stand up, pulling me up with him."
    "Inepte surgere incipit, me secum tollens."

# game/a2s1.rpy:276
translate latin a2s1_343cf0f3:

    # "It's difficult because I don't let go, almost getting lifted off my feet before I settle on letting go for just a moment to hug him lower, around his body, pressing my head to his chest, hearing his heart hammering inside."
    "Difficile est quia eum non dimitto; paene de pedibus tollor, antequam statuo paulisper dimittere ut inferius circa corpus amplectar, caput pectori eius premens et cor intus pulsans audiens."

# game/a2s1.rpy:277
translate latin a2s1_4c5508ad:

    # "Finally, he's able to get a grip on me and push me away despite my intention to cling to him forever."
    "Tandem me firmiter capere et removere potest, quamquam in perpetuum ei adhaerere volo."

# game/a2s1.rpy:278
translate latin a2s1_94ba2416:

    # "He holds me at arms length, staring at me."
    "Me bracchiorum longitudine remotum tenet, me intuens."

# game/a2s1.rpy:279
translate latin a2s1_3edbab4e:

    # "I clutch his paws on my shoulders, staring up at him, feeling my eyes start to water."
    "Manus eius in umeris meis capio, ad eum suspiciens, oculos meos lacrimari incipere sentiens."

# game/a2s1.rpy:281
translate latin a2s1_81e7c5e6:

    # a "\"Is...is this possible? Is...no, please, I can't handle another hallucination.\""
    a "\"Po...potest hoc fieri? Num...non, quaeso, aliam falsam imaginem ferre non possum.\""

# game/a2s1.rpy:282
translate latin a2s1_8fa55bc4:

    # "His expression keeps morphing from hope and awe to devastation."
    "Vultus eius a spe et admiratione ad desperationem identidem mutatur."

# game/a2s1.rpy:283
translate latin a2s1_3a5c0960:

    # "I feel his paws grip into my shoulders tightly, almost painfully, as if to make sure I'm real."
    "Manus eius umeros meos artissime, paene cum dolore, premere sentio, quasi certior fiat me verum esse."

# game/a2s1.rpy:284
translate latin a2s1_119f0fed:

    # m "\"It's me! I woke up in the garden for some reason, I'm okay...\""
    m "\"Ego sum! Nescio cur in horto experrectus sum; bene valeo...\""

# game/a2s1.rpy:285
translate latin a2s1_62597a4d:

    # "I want to hug him again, but he keeps holding me away, looking me up and down, pushing my hair back and feeling my crusty skin."
    "Rursus eum amplecti volo, sed adhuc me remotum tenet, me sursum deorsumque inspiciens, capillos retrudens et cutem crustosam tangens."

# game/a2s1.rpy:286
translate latin a2s1_b9c47b09:

    # a "\"But...but how...\""
    a "\"Sed...sed quomodo...\""

# game/a2s1.rpy:287
translate latin a2s1_4074ccc2:

    # m "\"I don't know. I just remember having crazy dreams, then I was in the garden.\""
    m "\"Nescio. Tantum memini me mira somnia vidisse, tum in horto eram.\""

# game/a2s1.rpy:290
translate latin a2s1_9a7123a1:

    # "As I'm talking, I think Amicus is finally believing it's me...and I notice that his body is starting to sway in a worrying manner."
    "Dum loquor, puto Amicum tandem credere me adesse...et animadverto corpus eius sollicitanti modo nutare incipere."

# game/a2s1.rpy:291
translate latin a2s1_2e87079d_1:

    # m "\"Amicus?\""
    m "\"Amice?\""

# game/a2s1.rpy:292
translate latin a2s1_334a06e4:

    # "I reach out to steady him, but as I do, his eyes roll back and I realize there's no way in hell I'm going to be able to keep a wolf over twice my weight from toppling over."
    "Manum porrigo ut eum firmem; sed dum facio, oculi eius sursum volvuntur, et intellego me nullo modo lupum plus quam bis meum pondus habentem a casu sustinere posse."

# game/a2s1.rpy:294
translate latin a2s1_96778158:

    # "I try anyway, wrapping my arms around him as Amicus falls backwards, his bulk pulling me down with him before he falls back-first onto the bedside table, sending bottles flying while his upper-back and head smashes into the wall."
    "Tamen conor, eum bracchiis amplectens, dum Amicus retrorsum cadit; corpus eius me secum trahit, antequam tergo in mensulam iuxta lectum cadit, lagenas dispergens, dum superior dorsi pars atque caput parietem percutiunt."

# game/a2s1.rpy:297
translate latin a2s1_51e7b306:

    # "My fall is absorbed by his much softer front, but the sound is loud, the room shaking and probably waking up the entire palace."
    "Casus meus molliore corporis eius parte anteriore excipitur; sed sonus magnus est, cubiculum tremit et probabiliter totum palatium excitat."

# game/a2s1.rpy:301
translate latin a2s1_b5c11923:

    # "Waking the wolf up the second time is a lot easier, probably because he'd fainted rather than passed out from too much wine."
    "Lupum secundo excitare multo facilius est, probabiliter quia animo defecit, pro eo quod nimio vino sensum amisit."

# game/a2s1.rpy:302
translate latin a2s1_5932ca17:

    # "We're at least able to move onto the bed where Amicus sits cross-legged, pulling me onto his lap and just holding me there, his paws moving around my body, still trying to make sure I'm real."
    "Saltem ad lectum transire possumus, ubi Amicus cruribus implicatis sedet, me in gremium trahens atque ibi tenens, manibus circa corpus meum motis, adhuc conatus certior fieri me verum esse."

# game/a2s1.rpy:303
translate latin a2s1_507760fb:

    # "For a moment, we don't talk, the wolf just pressing his nose to my hair and breathing in deeply."
    "Paulisper non loquimur; lupus tantum nasum capillis meis premit et alte spirat."

# game/a2s1.rpy:304
translate latin a2s1_561de92c:

    # "I feel a little self-conscious, knowing I must not smell very good right now, but that doesn't seem to bother Amicus as he goes on pressing his nose to my head and neck, taking in my scent."
    "Paulum pudet, sciens me nunc bene olere non posse; sed id Amicum non vexat, dum nasum capiti cervicique meae premere pergit, odorem meum hauriens."

# game/a2s1.rpy:305
translate latin a2s1_766e820b:

    # "Finally, he does speak, but it's one word:"
    "Tandem loquitur, sed unum verbum est:"

# game/a2s1.rpy:307
translate latin a2s1_8f0367b9:

    # a "\"How?\""
    a "\"Quomodo?\""

# game/a2s1.rpy:308
translate latin a2s1_a16e2a59:

    # "I turn my head toward the wolf, resting my cheek against his neck."
    "Caput ad lupum verto, genam cervici eius imponens."

# game/a2s1.rpy:309
translate latin a2s1_269b8607:

    # m "\"I don't know. I don't really even know what happened to me.\""
    m "\"Nescio. Ne vere quidem scio quid mihi acciderit.\""

# game/a2s1.rpy:310
translate latin a2s1_5f05b7ee:

    # a "\"You got sick...so sick. You were having convulsions, brain and nerve damage, it was...it was terrible.\""
    a "\"Aegrotavisti...tam graviter. Convulsiones patiebaris, cerebrum nervique laedebantur; erat...erat horrendum.\""

# game/a2s1.rpy:312
translate latin a2s1_164c5252:

    # "Amicus's arms tighten around me, his voice, normally deep and strong, now sounding weak and broken."
    "Bracchia Amici circa me artius premunt; vox eius, solita gravis ac fortis, nunc infirma et fracta sonat."

# game/a2s1.rpy:313
translate latin a2s1_aa77c1d8:

    # "This statement worries me though, and I have to wonder if I really am better."
    "Sed haec verba me sollicitant, et mirari debeo num vere melius me habeam."

# game/a2s1.rpy:314
translate latin a2s1_04bc24b7:

    # "There seem to be patches missing from my memory, and I do feel different, like I'm not fully myself, but I don't really want to think about it right now."
    "Partes quaedam memoriae meae deesse videntur; me alium sentio, quasi non penitus ipse sim, sed nunc vere de ea re cogitare nolo."

# game/a2s1.rpy:315
translate latin a2s1_f256838f:

    # m "\"I think I remember a little bit of that. I had—\""
    m "\"Credo me aliquantum eius meminisse. Habebam—\""

# game/a2s1.rpy:316
translate latin a2s1_465418f6:

    # "I lift my arm up, showing Amicus the shiny, crusty scabs on my arm."
    "Bracchium tollo, lucidas crustas siccas in bracchio Amico ostendens."

# game/a2s1.rpy:318
translate latin a2s1_1766557d:

    # a "\"It was avia pox, I—I can't believe I didn't consider the possibility of disease and illness for you. I'm just so used to the idea of any new arrival on Adastra going through that process...obviously we did it a bit differently.\""
    a "\"Variola avia erat. Ego—non possum credere me non consideravisse te morbis affici posse. Tam adsuetus sum cogitationi quemlibet nuper in Adastram advenientem illam rationem sequi...ut patet, nos paulo aliter fecimus.\""

# game/a2s1.rpy:319
translate latin a2s1_bf023949:

    # m "\"Yeah...\""
    m "\"Ita...\""

# game/a2s1.rpy:321
translate latin a2s1_d8628ec5:

    # a "\"And honestly I'm not even sure I'd have you do it. I don't know if you'd react differently to those vaccinations...each species has their own customized cocktail."
    a "\"Et, ut verum dicam, ne certus quidem sum me te id facere iussurum fuisse. Nescio num aliter ad illa vaccina reageres...quaeque species suam mixturam propriam habet."

# game/a2s1.rpy:323
translate latin a2s1_97e31c80:

    # a "\"And avia pox isn't included in the vaccination set. It's such a mild virus, we'd never seen anyone react to it the way you did, even other primates.\""
    a "\"Et variola avia in serie vaccinorum non continetur. Tam leve virus est; neminem ei respondere sicut tu respondisti umquam videramus, ne alios quidem primates.\""

# game/a2s1.rpy:324
translate latin a2s1_52d565f8:

    # "I think back to how quickly I became sick, how quickly I almost died."
    "Reminiscor quam cito aegrotaverim, quam cito paene mortuus sim."

# game/a2s1.rpy:325
translate latin a2s1_d462051c:

    # "I notice Amicus looking down at me again and I look back up at him."
    "Animadverto Amicum rursus ad me deorsum spectare et ad eum suspicio."

# game/a2s1.rpy:326
translate latin a2s1_df8ec4bc:

    # m "\"What?\""
    m "\"Quid?\""

# game/a2s1.rpy:328
translate latin a2s1_3122b23f:

    # "Amicus shakes his head."
    "Amicus caput quatit."

# game/a2s1.rpy:329
translate latin a2s1_cbe94906:

    # a "\"I'm just still trying to make sure you're here, that you're real...I—I'm afraid if I let go, if I even look away, you'll disappear.\""
    a "\"Tantum adhuc conor certus esse te hic esse, te verum esse...ego—timeo ne, si te dimittam, si vel obtutum avertam, evanescas.\""

# game/a2s1.rpy:330
translate latin a2s1_717e2371:

    # "His arms tighten around me again, squeezing a huff of breath out of me."
    "Bracchia eius rursus circa me premunt, anhelitum e me exprimentia."

# game/a2s1.rpy:331
translate latin a2s1_a3f2d03a:

    # m "\"I'm here, I promise.\""
    m "\"Hic sum, promitto.\""

# game/a2s1.rpy:333
translate latin a2s1_4dd5f2d8:

    # a "\"Well, I've had a lot of hallucinations; too many stress tablets I think.\""
    a "\"Bene, multas falsas imagines vidi; nimis multas tabellas ad sollicitudinem levandam sumpsi, credo.\""

# game/a2s1.rpy:334
translate latin a2s1_bfdc248b:

    # m "\"Stress tablets?\""
    m "\"Tabellas ad sollicitudinem levandam?\""

# game/a2s1.rpy:335
translate latin a2s1_9114cacf:

    # a "\"Yes, quite a few of them in fact.\""
    a "\"Ita, satis multas quidem.\""

# game/a2s1.rpy:336
translate latin a2s1_2d633f11:

    # m "\"With wine?\""
    m "\"Cum vino?\""

# game/a2s1.rpy:338
translate latin a2s1_f2aee798:

    # a "\"Oh yes.\""
    a "\"O, ita.\""

# game/a2s1.rpy:339
translate latin a2s1_0c416389_2:

    # m "\"Amicus!\""
    m "\"Amice!\""

# game/a2s1.rpy:340
translate latin a2s1_16b9d01b:

    # "I don't really know what these stress tablets are, but I imagine mixing space Xanax with alcohol is a horrible idea."
    "Non vere scio quid hae tabellae ad sollicitudinem levandam sint, sed puto Xanax siderale cum alcohole miscere horrendum consilium esse."

# game/a2s1.rpy:341
translate latin a2s1_0abee862:

    # "Amicus doesn't seem bothered by my reprimand though, instead just snuggling closer to me, his crusted face-fur prickly against my skin."
    "Sed Amicus obiurgatione mea turbari non videtur; tantum propius mihi adhaeret, pilis crustosis faciei cutem meam pungentibus."

# game/a2s1.rpy:343
translate latin a2s1_67128b9e:

    # a "\"I love you, [mc].\""
    a "\"Te amo, [mc].\""

# game/a2s1.rpy:344
translate latin a2s1_3ac5abdd:

    # "I get that familiar swooping feeling in my chest, like I'm on a roller coaster."
    "Familiarem illum lapsus sensum in pectore sentio, quasi in curriculo per clivos vectus sim."

# game/a2s1.rpy:345
translate latin a2s1_1999a7c2:

    # "I clutch onto his arms."
    "Bracchia eius artissime teneo."

# game/a2s1.rpy:346
translate latin a2s1_8c5fe2d6:

    # m "\"I love you too.\""
    m "\"Te quoque amo.\""

# game/a2s1.rpy:347
translate latin a2s1_bd014e40:

    # "Amicus sighs and sets his chin on my head."
    "Amicus suspirat et mentum capiti meo imponit."

# game/a2s1.rpy:349
translate latin a2s1_223d78e5:

    # a "\"I thought I'd missed the opportunity to say it...I still can't believe you're real.\""
    a "\"Putabam me facultatem dicendi amisisse...adhuc credere non possum te verum esse.\""

# game/a2s1.rpy:350
translate latin a2s1_db932123:

    # m "\"Well, I am. I promise.\""
    m "\"Sed sum. Promitto.\""

# game/a2s1.rpy:351
translate latin a2s1_d13a114c:

    # a "\"But I still don't understand how. This shouldn't be possible. You were declared to be in a permanent coma, no brain activity...I had to set you out in the garden and only hope for a miracle.\""
    a "\"Sed adhuc non intellego quomodo. Hoc fieri non debet. Te in sopore perpetuo esse dictum est, nullo cerebri motu...te in horto ponere debui et miraculum tantum sperare.\""

# game/a2s1.rpy:352
translate latin a2s1_09e9bc28:

    # m "\"Miracle?\""
    m "\"Miraculum?\""

# game/a2s1.rpy:353
translate latin a2s1_523c118d:

    # "Amicus lets out a shaky sigh, running his fingers through my hair."
    "Amicus tremens suspirat, digitos per capillos meos ducens."

# game/a2s1.rpy:355
translate latin a2s1_4dbb73e3:

    # a "\"When a sapient falls into such a state, we simply let them...fade away in a peaceful setting, or possibly recover if the parent allows it.\""
    a "\"Cum Sapiens in talem statum cadit, eum tantum sinimus...in tranquillo loco paulatim interire, vel fortasse convalescere si Parens sinat.\""

# game/a2s1.rpy:356
translate latin a2s1_9a871024:

    # a "\"I sat out there for a while, but couldn't bare to see you waste away, so came back to my room to drink and prepare for the emperorship.\""
    a "\"Aliquamdiu foris sedi, sed te languescentem videre ferre non potui, itaque in cubiculum redii ut biberem atque ad imperium me pararem.\""

# game/a2s1.rpy:357
translate latin a2s1_5ba048bd:

    # "I imagine Amicus laying those flowers around me and I feel my heart break a little."
    "Amicum illos flores circa me ponentem animo fingo, et cor meum aliquantum frangi sentio."

# game/a2s1.rpy:358
translate latin a2s1_892d80eb:

    # a "\"Did...did the parents come to you, is that why you're here? I had hope that they would.\""
    a "\"Num...num Parentes ad te venerunt? Ideo hic es? Sperabam eos venturos.\""

# game/a2s1.rpy:359
translate latin a2s1_8619f2c6:

    # "I shrug."
    "Umeros tollo."

# game/a2s1.rpy:360
translate latin a2s1_4a53ce42:

    # m "\"I really can't remember much.\""
    m "\"Vere pauca tantum meminisse possum.\""

# game/a2s1.rpy:362
translate latin a2s1_c5968cab:

    # a "\"It does not matter. My prayers were answered, praise the gods.\""
    a "\"Nihil refert. Preces meae auditae sunt, di laudentur.\""

# game/a2s1.rpy:363
