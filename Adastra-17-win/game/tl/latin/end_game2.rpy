translate latin end_game2_57f4e1d2:

    # "I open my eyes again as I hear shuffling steps up the path."
    "Oculos iterum aperio cum gressus trahentes per semitam audio."

# game/end_game2.rpy:1930
translate latin end_game2_05b72e5a:

    # "For a moment, I think it's going to be Amicus, maybe having woken up and found me missing from the bed."
    "Paulisper puto Amicum venturum esse, fortasse experrectum et me e lecto abesse invenisse."

# game/end_game2.rpy:1931
translate latin end_game2_1da81d32:

    # "It's what I hope to see, even though I know he needs his sleep."
    "Id videre spero, quamquam scio ei somno opus esse."

# game/end_game2.rpy:1932
translate latin end_game2_21e7543c:

    # "I'm under enough stress right now that I'm willing to be selfish."
    "Nunc tanta sollicitudine premor ut commodum meum praeferre velim."

# game/end_game2.rpy:1933
translate latin end_game2_c171048e:

    # "But no."
    "Sed non."

# game/end_game2.rpy:1934
translate latin end_game2_29338550:

    # "I'm a bit surprised to see Virginia walking along the main path, head down as she manipulates one of those transparent tablets that the officials around here have."
    "Paulo miror Virginiam per viam principalem ambulantem videre, capite demisso dum unam ex illis tabulis pellucidis tractat quas magistratus hic habent."

# game/end_game2.rpy:1935
translate latin end_game2_80504f1f:

    # "As she gets closer, I let out a soft cough so I don't surprise her."
    "Cum appropinquat, leniter tussio ne eam terream."

# game/end_game2.rpy:1936
translate latin end_game2_313c4673:

    # "She looks up, her pace slowing before she realizes that it's me."
    "Suspicit, gressu tardato antequam me agnoscit."

# game/end_game2.rpy:1937
translate latin end_game2_a3ab8129:

    # "I had assumed she would just continue on her way, but now she deliberately walks in my direction."
    "Putaveram eam iter suum continuaturam esse, sed nunc consulto ad me ambulat."

# game/end_game2.rpy:1939
translate latin end_game2_57bbcd0f:

    # v "\"Pleasant early morning to you, [mc].\""
    v "\"Iucunda sit tibi prima lux, [mc].\""

# game/end_game2.rpy:1940
translate latin end_game2_610e1884:

    # m "\"Good morning.\""
    m "\"Bonum mane.\""

# game/end_game2.rpy:1942
translate latin end_game2_cc6cb352:

    # v "\"I must say that I'm a bit surprised to see you outside before Vita has even risen.\""
    v "\"Dicendum est me paulo mirari te foris videre antequam Vita etiam orta est.\""

# game/end_game2.rpy:1943
translate latin end_game2_8619f2c6_3:

    # "I shrug."
    "Umeros tollo."

# game/end_game2.rpy:1944
translate latin end_game2_3af30a7f:

    # m "\"Had trouble sleeping.\""
    m "\"Dormire difficile erat.\""

# game/end_game2.rpy:1946
translate latin end_game2_675a0568:

    # "There's a pause, and Virginia gives me a look, one that I think is sympathetic."
    "Silentium fit, et Virginia me aspicit vultu quem misericordem esse puto."

# game/end_game2.rpy:1947
translate latin end_game2_9e902d22:

    # v "\"I imagine.\""
    v "\"Credo.\""

# game/end_game2.rpy:1948
translate latin end_game2_486859e8:

    # "More silence."
    "Plus silentii."

# game/end_game2.rpy:1949
translate latin end_game2_60beff57:

    # "Even now, at the very end of my journey on Adastra, I feel the stiff, awkward wall between us"
    "Etiam nunc, ipso in fine itineris mei in Adastra, rigidum incommodumque murum inter nos sentio"

# game/end_game2.rpy:1950
translate latin end_game2_4191b536:

    # "Out of everyone I've met in the palace, I feel I know Virginia the least, and that includes Alex."
    "Ex omnibus quos in palatio conveni, Virginiam minime nosse me sentio, etiam Alexio computato."

# game/end_game2.rpy:1951
translate latin end_game2_534bff99:

    # "While her intentions became clear to me, like everyone's eventually did, I literally know nothing else about her."
    "Quamquam consilia eius mihi manifesta facta sunt, sicut tandem omnium, nihil omnino aliud de ea scio."

# game/end_game2.rpy:1952
translate latin end_game2_4cfb8897:

    # "I try to fill the silence."
    "Silentium explere conor."

# game/end_game2.rpy:1953
translate latin end_game2_239b6cb3:

    # m "\"So what has you up so early?\""
    m "\"Quid igitur te tam mane excitavit?\""

# game/end_game2.rpy:1954
translate latin end_game2_d1cffbf1:

    # "Virginia raises an eyebrow."
    "Virginia supercilium tollit."

# game/end_game2.rpy:1956
translate latin end_game2_7f413296:

    # v "\"We have run out of time to negotiate funding for a few smaller provinces to the north. I am using the early hours to make time.\""
    v "\"Tempus nobis defuit ad pecuniam quibusdam minoribus provinciis septentrionalibus concedendam tractandam. Primis horis utor ut tempus inveniam.\""

# game/end_game2.rpy:1957
translate latin end_game2_313863db:

    # m "\"That doesn't sound fun.\""
    m "\"Non iucundum videtur.\""

# game/end_game2.rpy:1959
translate latin end_game2_778dffda:

    # v "\"It is not meant to be {i}fun{/i}. My life is now dedicated to serving the empire. My own concerns do not matter.\""
    v "\"Non destinatur ut {i}iucundum{/i} sit. Vita mea nunc imperio serviendo dicata est. Curae meae nihil valent.\""

# game/end_game2.rpy:1960
translate latin end_game2_3f739ce1_1:

    # "I sigh."
    "Suspiro."

# game/end_game2.rpy:1961
translate latin end_game2_9dc09dd9:

    # m "\"Listen, I'm gonna be honest here. You seem less happy than you were before you had this position.\""
    m "\"Audi, sincere dicam. Minus felix videris quam antequam hoc munus habebas.\""

# game/end_game2.rpy:1963
translate latin end_game2_06f5e32c:

    # v "\"Again, my concerns are not important.\""
    v "\"Iterum dico, curae meae non magni momenti sunt.\""

# game/end_game2.rpy:1964
translate latin end_game2_5f1c3045:

    # m "\"I'm not saying they are, I'm just wondering why you wanted this position if it's only making your life worse.\""
    m "\"Non dico eas esse; tantum miror cur hoc munus volueris si vitam tuam tantum peiorem facit.\""

# game/end_game2.rpy:1965
translate latin end_game2_fc02cfa9:

    # "Virginia gives me a long, hard look."
    "Virginia diu dureque me intuetur."

# game/end_game2.rpy:1966
translate latin end_game2_2767a744:

    # "It always seems like our conversations become tense if we talk for more than three sentences."
    "Colloquia nostra semper tensa fieri videntur si plus quam tres sententias dicimus."

# game/end_game2.rpy:1967
translate latin end_game2_d8709670:

    # v "\"I think that you are not understanding the concept. {i}My{/i} concerns do not matter. {i}I{/i} do not matter. What does matter is the work I do."
    v "\"Puto te rem non intellegere. Curae {i}meae{/i} nihil valent. {i}Ego{/i} nihil valeo. Quod valet est opus quod facio."

# game/end_game2.rpy:1968
translate latin end_game2_91bcf6b1:

    # m "\"So...you just wanted to run the empire in a more efficient way, or something?\""
    m "\"Ita...tantum imperium efficacius regere volebas, vel tale quid?\""

# game/end_game2.rpy:1969
translate latin end_game2_77e3798b:

    # v "\"Yes, or something.\""
    v "\"Ita, vel tale quid.\""

# game/end_game2.rpy:1970
translate latin end_game2_78cd6ac8:

    # m "\"You could just be blunt like the Khemians are and tell me. We'd get to the point, and then you wouldn't have to be so angry all the time.\""
    m "\"Posses simpliciter, sicut Khemiani, loqui et mihi dicere. Ad rem veniremus, et non semper tam irata esse deberes.\""

# game/end_game2.rpy:1972
translate latin end_game2_680db11c:

    # "The look on Virginia's face has me raising my hands defensively."
    "Vultus Virginiae efficit ut manus ad me defendendum tollam."

# game/end_game2.rpy:1973
translate latin end_game2_6e9c3ca6:

    # m "\"Alright, sorry. I know whenever I talk I just piss you off, so I'll just stop.\""
    m "\"Bene, ignosce. Scio me quotiens loquor te tantum iratam facere, itaque desinam.\""

# game/end_game2.rpy:1975
translate latin end_game2_b3ab0b1a:

    # v "\"What has you so brash this morning?\""
    v "\"Quid te hac luce tam procacem facit?\""

# game/end_game2.rpy:1976
translate latin end_game2_6c15f3b1:

    # m "\"Everything.\""
    m "\"Omnia.\""

# game/end_game2.rpy:1977
translate latin end_game2_c4c1b51d:

    # "I put out my hands to either side of myself, as if to indicate the whole situation I'm in."
    "Manus utrimque extendo, quasi totum statum in quo sum indicem."

# game/end_game2.rpy:1978
translate latin end_game2_5b803beb:

    # m "\"But at least I'm not always...I dunno, acting like you're just an annoying distraction. Hell, even Cassius acknowledges my presence more than you do.\""
    m "\"Sed saltem non semper...nescio, ago quasi tu tantum molestum impedimentum sis. Mehercule, etiam Cassius praesentiam meam magis agnoscit quam tu.\""

# game/end_game2.rpy:1979
translate latin end_game2_f7830b08:

    # m "\"I mean, it's a bit late now, but considering I'm in a relationship with your brother, maybe we should get to know each other when I come back.\""
    m "\"Dico, nunc paulo sero est, sed cum amantem fratrem tuum habeam, fortasse nos melius cognoscere debemus cum rediero.\""

# game/end_game2.rpy:1980
translate latin end_game2_ab60fc93:

    # "Virginia regards me for a moment, then takes a deep breath."
    "Virginia me paulisper considerat, deinde alte spirat."

# game/end_game2.rpy:1981
translate latin end_game2_26ab4a4d:

    # v "\"[mc], I know you are leaving tomorrow, as we all do...but I also know that you will be back, and I will be made to work with you for a very long time, likely the rest of our lives.\""
    v "\"[mc], scio te cras discedere, sicut omnes scimus...sed etiam scio te rediturum esse, et me tecum diutissime laborare iussum iri, fortasse reliquam vitam nostram.\""

# game/end_game2.rpy:1982
translate latin end_game2_e499761a_3:

    # "I frown."
    "Frontem contraho."

# game/end_game2.rpy:1983
translate latin end_game2_749450e4:

    # "How would Virginia know I'll be working with the empire?"
    "Quomodo Virginia sciat me cum imperio laboraturum esse?"

# game/end_game2.rpy:1984
translate latin end_game2_8d9caf96:

    # "Is she supposed to know that?"
    "Licetne ei id scire?"

# game/end_game2.rpy:1985
translate latin end_game2_7932ba98:

    # "I start to wonder if the parents {i}are{/i} talking, just not to me."
    "Mirari incipio num Parentes {i}loquantur{/i}, tantum mihi non loquantur."

# game/end_game2.rpy:1986
translate latin end_game2_66c1fa2c:

    # "Virginia answers that question next, though."
    "Sed Virginia huic quaestioni mox respondet."

# game/end_game2.rpy:1988
translate latin end_game2_f68cbab3:

    # v "\"Amicus told me, as he should have, considering my position. It will help us prepare, at least in secret.\""
    v "\"Amicus mihi dixit, sicut debuit, munere meo considerato. Nos adiuvabit ad parandum, saltem clam.\""

# game/end_game2.rpy:1989
translate latin end_game2_09f43605:

    # "I wonder if the parents told him that was okay."
    "Miror num Parentes ei dixerint id licere."

# game/end_game2.rpy:1990
translate latin end_game2_49ac9687:

    # "I don't want to deviate from their plan at all if it risks my mission."
    "Nihil omnino a consilio eorum aberrare volo, si missionem meam periclitetur."

# game/end_game2.rpy:1991
translate latin end_game2_c260dea0:

    # "Virginia interrupts my thoughts though."
    "Sed Virginia cogitationes meas interrumpit."

# game/end_game2.rpy:1993
translate latin end_game2_5fcd5c58:

    # v "\"But I will say this once, and never again, so remember it when you return.\""
    v "\"Sed hoc semel dicam, nec umquam iterum; itaque memineris cum redieris.\""

# game/end_game2.rpy:1994
translate latin end_game2_0df5b9fc:

    # "I wait expectantly."
    "Intentus exspecto."

# game/end_game2.rpy:1995
translate latin end_game2_09ef3c47:

    # v "\"While young, my brothers and I experienced very different sides of my father. He coddled Amicus, neglected Cassius, and for me, it was a sort of in-between.\""
    v "\"Iuvenes, fratres mei et ego patrem nostrum valde diversum experti sumus. Amico indulgebat, Cassium neglegebat, mihi medium quiddam erat.\""

# game/end_game2.rpy:1996
translate latin end_game2_534b6df1:

    # v "\"He paid me very close, but strict attention. Unlike my brothers, who received lessons in maths, science, and combat—\""
    v "\"Me diligentissime, sed severe curabat. Dissimilis fratribus meis, qui mathematicam, scientiam pugnamque discebant—\""

# game/end_game2.rpy:1997
translate latin end_game2_282d147b:

    # v "\"—I was given lessons in speech, etiquette, but mainly I was subjected to long, cruel sessions of behavioral-molding.\""
    v "\"—ego sermonis urbanitatisque praecepta accipiebam, sed maxime longis crudelibusque exercitationibus mores mei fingebantur.\""

# game/end_game2.rpy:1998
translate latin end_game2_df112bcc:

    # v "\"He altered who I was as a person, something he would never do to his sons.\""
    v "\"Quae persona eram mutavit, quod filiis suis numquam faceret.\""

# game/end_game2.rpy:1999
translate latin end_game2_6d9b1db9:

    # m "\"Oh...why?\""
    m "\"O...cur?\""

# game/end_game2.rpy:2000
translate latin end_game2_38b39f44:

    # v "\"All I understood at the time was that he planned for me to occupy a prestigious position in the empire.\""
    v "\"Tunc tantum intellexi eum mihi clarum munus in imperio destinare.\""

# game/end_game2.rpy:2001
translate latin end_game2_8dbed4bb:

    # v "\"Still, I hated him for it. I felt almost no emotion when his sabotaged ship crashed.\""
    v "\"Tamen eum propter id oderam. Paene nihil sensi cum navis eius dolo corrupta cecidit.\""

# game/end_game2.rpy:2002
translate latin end_game2_89357ba6_1:

    # m "\"Oh...\""
    m "\"O...\""

# game/end_game2.rpy:2004
translate latin end_game2_32fccc2d:

    # v "\"Yes, odd how he would project himself to be the most egalitarian emperor in our history, yet treat his own daughter like clay that he could shape in any way he wanted.\""
    v "\"Ita, mirum est quod se aequissimum imperatorem historiae nostrae ostendebat, filiam tamen suam sicut argillam tractabat quam quocumque modo vellet fingere posset.\""

# game/end_game2.rpy:2005
translate latin end_game2_e34ba8f7:

    # "Now I'm really at a loss for words."
    "Nunc vere verba mihi desunt."

# game/end_game2.rpy:2007
translate latin end_game2_71a82174:

    # v "\"But...following his death and the resulting power struggle, I came to learn why, and the reason was rather simple.\""
    v "\"Sed...post mortem eius certamenque de potestate inde ortum, cur fecisset didici, et causa satis simplex erat.\""

# game/end_game2.rpy:2009
translate latin end_game2_5bb182d0:

    # v "\"If I were to be the first female in a particular position of power, I needed to set an example. Not only that, but I would need to ward off attempts by those in power to undermine me.\""
    v "\"Si prima femina in certo potentiae munere futura eram, exemplum praebere debebam. Nec tantum id: conatus potentium ad me labefactandam propulsare debebam.\""

# game/end_game2.rpy:2010
translate latin end_game2_a3b966b3:

    # v "\"My mind was already trained for the deceit I would come up against, and it serves me well, even now as officials spread rumors and attempt to discredit me.\""
    v "\"Mens mea iam ad fraudes quibus occurrerem exercitata erat, et bene mihi servit, etiam nunc cum magistratus rumores spargunt atque auctoritatem meam minuere conantur.\""

# game/end_game2.rpy:2011
translate latin end_game2_dd262dae:

    # v "\"Amateurish rumors, I'll have you know. Seems they can't think of anything more complex than saying the reason I get so much done is because I'm a whore.\""
    v "\"Rumores imperitorum, ut scias. Nihil perplexius excogitare possunt quam dicere me tam multa efficere quia meretrix sum.\""

# game/end_game2.rpy:2012
translate latin end_game2_c2e1c858:

    # v "\"But father personally made sure I understood the most important lesson in this empire: trust no male.\""
    v "\"Sed pater ipse curavit ut maximi momenti praeceptum huius imperii intellegerem: nulli mari confide.\""

# game/end_game2.rpy:2013
translate latin end_game2_ec4d8367:

    # v "\"It's what will keep me alive in this role. While I still hate father, I {i}understand{/i} him, now, which is better than just hate.\""
    v "\"Id me in hoc munere vivam servabit. Quamquam patrem adhuc odi, nunc eum {i}intellego{/i}, quod melius est quam solum odium.\""

# game/end_game2.rpy:2014
translate latin end_game2_43268636:

    # "Through all of this, I can only sit there awkwardly on the bench."
    "Per haec omnia nihil possum nisi in subsellio incommode sedere."

# game/end_game2.rpy:2015
translate latin end_game2_9daf0e98:

    # m "\"Okay...so is that why you treat me the way you do? I'm a male and you can't trust me?\""
    m "\"Bene...ideo me sic tractas? Mas sum et mihi confidere non potes?\""

# game/end_game2.rpy:2017
translate latin end_game2_cfe21df7:

    # v "\"[mc], I trust no one. I simply don't have to worry about women because they hold no power...yet.\""
    v "\"[mc], nemini confido. Tantum de feminis sollicitari non debeo quia nullam potestatem habent...adhuc.\""

# game/end_game2.rpy:2018
translate latin end_game2_9d55ca39:

    # v "\"I tell you this so that you might {i}understand{/i} me, as you wished. We will need to be close allies in the future, after all.\""
    v "\"Haec tibi dico ut me {i}intellegas{/i}, sicut voluisti. Posthac enim socii arcte coniuncti esse debebimus.\""

# game/end_game2.rpy:2020
translate latin end_game2_244bbb1b:

    # v "\"While I'm sure my upbringing has a little bit to do with my demeanor, the main reason for my shortness with you is simply due to your immaturity and lack of self-control. Amicus is no different.\""
    v "\"Quamquam certe educatio mea habitum meum paulo afficit, praecipua causa cur tecum abrupte agam simpliciter est immaturitas tua atque impotentia te ipsum regendi. Amicus non differt.\""

# game/end_game2.rpy:2021
translate latin end_game2_cd938aab:

    # "I grimace."
    "Vultum contraho."

# game/end_game2.rpy:2022
translate latin end_game2_9d706b34:

    # m "\"I think I'm a bit better than Amicus...\""
    m "\"Puto me paulo meliorem Amico esse...\""

# game/end_game2.rpy:2024
translate latin end_game2_17898228:

    # v "\"Mmh, yes, though he is growing into his position well enough. I'm sure you will as well.\""
    v "\"Mmh, ita, quamquam muneri suo satis bene assuescit. Certe tu quoque assuesces.\""

# game/end_game2.rpy:2025
translate latin end_game2_5b0396ad:

    # "I'm not sure if that's encouragement, or an insult."
    "Nescio utrum hortatio an contumelia sit."

# game/end_game2.rpy:2027
translate latin end_game2_57167d6a:

    # v "\"And thank you for saving my brother. I don't believe I've had the chance to say that yet. I know what I just said, but he is one of the few I can trust to...be himself.\""
    v "\"Et gratias tibi ago quod fratrem meum servavisti. Non credo me adhuc occasionem habuisse id dicendi. Scio quid modo dixerim, sed unus ex paucis est quibus confidere possum ut...ipse sit.\""

# game/end_game2.rpy:2028
translate latin end_game2_200704bc:

    # "Then Virginia turns away, walking toward the imperial ship."
    "Tum Virginia avertitur, ad navem imperatoriam ambulans."

# game/end_game2.rpy:2031
translate latin end_game2_7b64b5f8:

    # v "\"I really must be off to the city now. I'll be present for your departure tomorrow morning. Goodbye.\""
    v "\"Vere nunc ad urbem proficisci debeo. Cras mane discessui tuo adero. Vale.\""

# game/end_game2.rpy:2032
translate latin end_game2_323db076:

    # m "\"Bye...\""
    m "\"Vale...\""

# game/end_game2.rpy:2033
translate latin end_game2_4f79ef2c:

    # "I watch Virginia walk off into the dark, still feeling like I don't really know anything about her, even if she did kind of open up to me for the first time."
    "Virginiam in tenebras abeuntem specto, adhuc sentiens me nihil fere de ea scire, etsi primum quodammodo animum suum mihi aperuit."

# game/end_game2.rpy:2034
translate latin end_game2_1dbe6c6c:

    # "At least she's willing to work with me on how to integrate humanity."
    "Saltem mecum laborare vult de genere humano coniungendo."

# game/end_game2.rpy:2035
translate latin end_game2_cf2c0cc1:

    # "I'd been worried about that."
    "De eo sollicitus fueram."

# game/end_game2.rpy:2037
translate latin end_game2_db27fce1:

    # "The edge of the sky is just turning a lighter blue as I make my way back into the palace."
    "Caeli extremum modo levius caeruleum fit dum in palatium redeo."

# game/end_game2.rpy:2038
translate latin end_game2_1f8c7972:

    # "This is usually about the time that Amicus wakes up, so I'm not surprised to hear the shower running when I walk into his room."
    "Hoc fere tempore Amicus expergisci solet, itaque non miror aquam imbrium audire cum cubiculum eius intro."

# game/end_game2.rpy:2042
translate latin end_game2_af9b9cbb:

    # "I think about going into the bathroom, then think better of it, not wanting to hold up Amicus's morning routine."
    "Cogito de balneo intrando, deinde consilium muto, ne consuetudinem matutinam Amici morer."

# game/end_game2.rpy:2043
translate latin end_game2_79d4833a:

    # "I have to admit that I'm a little disappointed that he didn't come looking for me first thing."
    "Fatendum est me paulo deceptum esse quod non statim me quaerere venit."

# game/end_game2.rpy:2044
translate latin end_game2_27969ec4:

    # "Usually that's something he'd do if he's not sure where I am."
    "Id plerumque faceret si nesciret ubi essem."

# game/end_game2.rpy:2045
translate latin end_game2_2db086bc:

    # "For now, I just sit on the bed and wait, gradually growing more tired as the minutes go by, finally feeling like I might be able to get some sleep."
    "Nunc tantum in lecto sedeo et exspecto, minutis praetereuntibus paulatim lassior, tandem sentiens me fortasse dormire posse."

# game/end_game2.rpy:2046
translate latin end_game2_c9c1553f:

    # "Then the door slides open and Amicus steps out, freshly showered and dressed."
    "Tum ostium labens aperitur et Amicus exit, recens lotus atque vestitus."

# game/end_game2.rpy:2047
translate latin end_game2_6e09351a:

    # "He smiles brightly when he sees me."
    "Laete arridet cum me videt."

# game/end_game2.rpy:2049
translate latin end_game2_bf445fd1:

    # a "\"There you are! I was wondering if maybe you'd gone to get breakfast early.\""
    a "\"Ecce tu! Mirabar num forte maturius ad ientaculum ivisses.\""

# game/end_game2.rpy:2050
translate latin end_game2_e783f2c3:

    # "Immediately I'm jarred by Amicus's overly-cheerful demeanor, his voice louder than usual."
    "Statim nimis hilaris habitus Amici me percutit, voce solito maiore."

# game/end_game2.rpy:2051
translate latin end_game2_640db045:

    # m "\"No, I just needed some air.\""
    m "\"Non, tantum aere opus erat.\""

# game/end_game2.rpy:2053
translate latin end_game2_b0b0ede2:

    # a "\"Air? Is it too stuffy in here?\""
    a "\"Aere? Nimisne conclusus aer hic est?\""

# game/end_game2.rpy:2054
translate latin end_game2_349b9dcc:

    # m "\"No, it's freezing, as usual.\""
    m "\"Non, frigidissimus est, ut solet.\""

# game/end_game2.rpy:2055
translate latin end_game2_9c56b6e6:

    # "I stand up and hug Amicus, which he enthusiastically accepts."
    "Surgo et Amicum amplector, quod ille ardenter accipit."

# game/end_game2.rpy:2057
translate latin end_game2_ddf786c5:

    # "I sink into his furry warmth, and I feel my eyes sting as the reality of how much time we have left really sinks in."
    "In calorem pilosum eius demittor, et oculos urere sentio cum vere intellego quantum temporis nobis restet."

# game/end_game2.rpy:2058
translate latin end_game2_6ae30550_1:

    # m "\"Amicus...\""
    m "\"Amice...\""

# game/end_game2.rpy:2059
translate latin end_game2_7f86972b:

    # "My voice is small and sad, and Amicus quickly but gently sets his paws on my shoulders to push me back a step so that he can look me in the eyes."
    "Vox mea tenuis tristisque est, et Amicus cito sed leniter pedes in umeros meos ponit ut me uno gradu retrorsum pellat et in oculos meos intueri possit."

# game/end_game2.rpy:2061
translate latin end_game2_ebc313a6:

    # a "\"Hey, I'm going to be back early tonight, as early as possible. Unfortunately there are a few mandatory meetings involving the Khemians that I must attend.\""
    a "\"Heus, hac vespera mature redibo, quam maturissime. Infeliciter quibusdam conventibus necessariis de Khemianis adesse debeo.\""

# game/end_game2.rpy:2062
translate latin end_game2_abc1a553:

    # m "\"I know.\""
    m "\"Scio.\""

# game/end_game2.rpy:2063
translate latin end_game2_a9d222f3:

    # "Amicus had already tried to take the day off, but of course things came up."
    "Amicus iam diem vacuum sibi petere conatus erat, sed scilicet res intervenerunt."

# game/end_game2.rpy:2065
translate latin end_game2_c785d827:

    # a "\"And don't worry; I've kept tonight simple. Just dinner between you and I.\""
    a "\"Et noli sollicitus esse; hanc vesperam simplicem servavi. Tantum cena inter te et me.\""

# game/end_game2.rpy:2066
translate latin end_game2_03f7b25c:

    # "I can tell that Amicus is putting on a brave face."
    "Sentio Amicum fortem se simulare."

# game/end_game2.rpy:2067
translate latin end_game2_18d12c9d:

    # "So I do the same and swallow back the awful feelings that have been threatening to overwhelm me."
    "Ita idem facio et terribiles affectus reprimo qui me obruere minabantur."

# game/end_game2.rpy:2068
translate latin end_game2_b6968389:

    # m "\"Alright. I'll be waiting.\""
    m "\"Bene. Exspectabo.\""

# game/end_game2.rpy:2070
translate latin end_game2_6c3aa969:

    # a "\"Good. I won't be long, and the sooner I leave, the sooner I will return.\""
    a "\"Bene. Non diu abero, et quo citius abeo, eo citius redibo.\""

# game/end_game2.rpy:2071
translate latin end_game2_d6a866a9:

    # m "\"Then you'd better get going.\""
    m "\"Tunc melius est te proficisci.\""

# game/end_game2.rpy:2073
translate latin end_game2_7f8077c0:

    # a "\"Right away, Emperor Consort!\""
    a "\"Statim, Imperator Consors!\""

# game/end_game2.rpy:2074
translate latin end_game2_df48460b:

    # "I grimace at the title I would hold if Amicus made our marriage official."
    "Vultum contraho ad titulum quem haberem si Amicus matrimonium nostrum publice sanciret."

# game/end_game2.rpy:2075
translate latin end_game2_f0c2633c:

    # "But he plants a kiss on my face anyway before pulling back and smiling at me."
    "Sed ille faciem meam osculatur antequam recedit et mihi arridet."

# game/end_game2.rpy:2077
translate latin end_game2_e2ff96f8:

    # a "\"I love you, and tonight we shall be happy!\""
    a "\"Te amo, et hac vespera felices erimus!\""

# game/end_game2.rpy:2080
translate latin end_game2_5994faf5:

    # "I try to smile back as Amicus takes his leave, disappearing out the door, wondering how I'm going to manage to do that."
    "Vicissim arridere conor dum Amicus abit et per ostium evanescit, mirans quomodo id efficere possim."

# game/end_game2.rpy:2082
translate latin end_game2_4979d717:

    # "Hopefully well enough for Amicus's sake."
    "Spero me satis bene posse propter Amicum."

# game/end_game2.rpy:2085
translate latin end_game2_51852bf5:

    # "I'm able to nap for a few hours, after which I walk through the halls, though at a much slower pace than usual."
    "Paucas horas dormire possum; deinde per atria ambulo, quamquam multo lentius solito."

# game/end_game2.rpy:2086
translate latin end_game2_3c15347c:

    # "I take a good look at everything, remembering."
    "Omnia diligenter aspicio, memorias revocans."

# game/end_game2.rpy:2087
translate latin end_game2_34ec6244:

    # "I walk past the meditation room, and I pause before opening the door."
    "Praeter cubiculum meditationis ambulo et consisto antequam ostium aperio."

# game/end_game2.rpy:2089
translate latin end_game2_a21d4161:

    # "I'd made up with Amicus here after our fight a year ago."
    "Hic cum Amico post rixam nostram anno abhinc in gratiam redieram."

# game/end_game2.rpy:2090
translate latin end_game2_0c771429:

    # "This is also where I accidentally got high on the {i}somni{/i} Cassius had been smoking."
    "Hic etiam invitus {i}somni{/i} quod Cassius fumabat ebrietate affectus sum."

# game/end_game2.rpy:2091
translate latin end_game2_33038df3:

    # "The main reason I open the door though, is because I'm curious if any of that plant is lying around, maybe try to contact the Monitor myself."
    "Sed praecipua causa ostii aperiendi est quod curiosus sum num quid illius herbae circum iaceat, ut fortasse ipse Monitorem attingere experiar."

# game/end_game2.rpy:2092
translate latin end_game2_b7871814:

    # "I don't see any, and remembering Cassius's horrible experience gets me to give up pretty fast, not wanting to be tormented by the Monitor because I didn't follow their plan correctly."
    "Nihil video, et terribilem experientiam Cassii recordatus satis cito desisto, ne Monitor me cruciet quia consilium eorum recte non secutus sim."

# game/end_game2.rpy:2095
translate latin end_game2_39a46166:

    # "I head out into the gardens like usual, taking in the beauty of the arranged foliage for the last time."
    "In hortos ut soleo exeo, pulchritudinem frondium dispositarum ultimo contemplans."

# game/end_game2.rpy:2096
translate latin end_game2_56897f4a:

    # "I remember my first morning here...with Alex."
    "Primam lucem meam hic recordor...cum Alexio."

# game/end_game2.rpy:2097
translate latin end_game2_b61512c5:

    # "He'd been so helpful and kind, and I feel some sadness at the idea that I'll probably never see him again."
    "Tam benignus tamque utilis fuerat, et triste mihi est cogitare me probabiliter eum numquam iterum visurum esse."

# game/end_game2.rpy:2098
translate latin end_game2_0390494f:

    # "It's dulled a bit as I also remember that he'd only been sizing me up for manipulation, even then."
    "Tristitia paulum obtunditur cum memini eum etiam tunc me tantum aestimavisse ut me regeret."

# game/end_game2.rpy:2099
translate latin end_game2_c08d8986:

    # "While I feel our friendship had been partially genuine, I know that what he's done is something I can never forgive, even though Cassius was able to."
    "Quamquam amicitiam nostram partim veram fuisse sentio, scio eius facinora ea esse quibus numquam ignoscere possum, quamquam Cassius potuit."

# game/end_game2.rpy:2102
translate latin end_game2_3a686dd9:

    # "I head back in for a light breakfast, sitting on Amicus's usual bed."
    "Intro ad leve ientaculum redeo, in lecto quo Amicus solet sedens."

# game/end_game2.rpy:2103
translate latin end_game2_50b02153:

    # "I watch the screens as I do, not surprised to see Amicus's face pop up a few times."
    "Dum edo, imagines specto, nec miror faciem Amici aliquotiens apparere."

# game/end_game2.rpy:2104
translate latin end_game2_99148fd9:

    # "He is the emperor, after all, but I am surprised to see my own face, and I know immediately they're talking about us, speculating."
    "Imperator enim est, sed faciem meam videre miror, et statim scio eos de nobis loqui, coniecturas facientes."

# game/end_game2.rpy:2105
translate latin end_game2_cf83a85a:

    # "I tell Com to turn it off and sit there for a bit, thinking back on what had happened in this room."
    "Com iubeo imagines exstinguere et paulisper sedeo, cogitans quid in hoc cubiculo acciderit."

# game/end_game2.rpy:2106
translate latin end_game2_500c9e60:

    # "As always, my eyes are drawn to the dark wine stain in Cassius's bed, something that remained even after a deep cleaning."
    "Ut semper, oculi mei ad obscuram vini maculam in lecto Cassii trahuntur, quae etiam post diligentem purgationem mansit."

# game/end_game2.rpy:2107
translate latin end_game2_13e4650b:

    # "It hasn't been replaced, likely because Cassius doesn't really live in the palace anymore."
    "Lectus non mutatus est, probabiliter quia Cassius in palatio iam non vere habitat."

# game/end_game2.rpy:2108
translate latin end_game2_7daf6c12:

    # "Of course, it always brings to mind the moment he drank that poisoned wine."
    "Scilicet semper memoriam illius momenti revocat quo vinum venenatum bibit."

# game/end_game2.rpy:2109
translate latin end_game2_b2c4190b:

    # "The day we'd all sat there, knowing something was wrong, yet Cassius still trusting Cato enough to never suspect an assassination attempt."
    "Illius diei quo omnes ibi sedebamus, aliquid mali esse scientes, sed Cassius adhuc Catoni satis confidebat ut ne conatum quidem caedis suspicaretur."

# game/end_game2.rpy:2110
translate latin end_game2_95732994:

    # "Something he would have suspected if Neferu and I had been less cautious about releasing the information on the sabotaged ship."
    "Quod suspicatus esset si Neferu et ego minus cauti fuissemus de indicio navis corruptae divulgando."

# game/end_game2.rpy:2111
translate latin end_game2_471db41b:

    # "It probably wasn't enough to convict him in a trial, but all would have known."
    "Fortasse non satis erat ut eum in iudicio condemnarent, sed omnes scivissent."

# game/end_game2.rpy:2112
translate latin end_game2_5d788c1f:

    # "Even now I'm not sure why I'd handed the wine to him, knowing it would end badly, knowing I should spill it, just like I did my first time serving."
    "Etiam nunc nescio cur vinum ei tradiderim, sciens rem male finituram esse, sciens me effundere debere sicut primum ministrans feci."

# game/end_game2.rpy:2113
translate latin end_game2_34906d30:

    # "Yet I did what I was told, almost like a robot, maybe because I'd been conditioned to do whatever the wolves told me."
    "Tamen quod iussus eram feci, paene velut automaton, fortasse quia institutus eram ut quidquid lupi dicerent facerem."

# game/end_game2.rpy:2114
translate latin end_game2_8db2d112:

    # "I don't blame Cassius for staying away from the palace after what he went through."
    "Cassium non culpo quod post ea quae passus est a palatio abest."

# game/end_game2.rpy:2115
translate latin end_game2_1781df43:

    # "An assassination attempt resulting in a medically-induced coma does things to the mind, according to him."
    "Conatus caedis ex quo coma medicis inductum sequitur animum afficit, ut ipse dicit."

# game/end_game2.rpy:2116
translate latin end_game2_0122869f:

    # "I wonder if that includes forgiving a spy that's partially responsible for dozens of deaths."
    "Miror num id etiam significet ignoscere exploratori qui partim multarum decuriarum mortium reus est."

# game/end_game2.rpy:2117
translate latin end_game2_cbd5dae3:

    # "Feeling slightly nauseous, I send the rest of my food back."
    "Paulum nauseans reliquum cibi remitto."

# game/end_game2.rpy:2118
translate latin end_game2_df357b7d:

    # "I decide not to think about Alex anymore, feeling like the cat had never gotten what he deserved."
    "Statuo de Alexio amplius non cogitare, sentiens felem numquam poenas meritas dedisse."

# game/end_game2.rpy:2119
translate latin end_game2_45dd422a:

    # "I need to distract myself until Amicus gets back, so I head for the baths."
    "Animum distrahere debeo donec Amicus redit, itaque ad balnea eo."

# game/end_game2.rpy:2123
translate latin end_game2_c8fca5d2:

    # "It's become part of my routine, and the part I always look forward to the most for a couple of reasons."
    "Pars consuetudinis meae facta est, et pars quam duabus de causis maxime semper exspecto."

# game/end_game2.rpy:2124
translate latin end_game2_0d5e0348:

    # "First, it's just nice to soak, and second, because I see the person I often run into here."
    "Primum, iucundum est mergi; deinde, eum video quem hic saepe invenio."

# game/end_game2.rpy:2126
translate latin end_game2_c11d8300:

    # "He soaks in the pool, head leaning back against the edge, eyes closed."
    "In piscina mergitur, capite ad marginem reclinato, oculis clausis."

# game/end_game2.rpy:2127
translate latin end_game2_0b3abf02:

    # "While I may have lost my friendship with Alex, I'd gained a great one with Neferu."
    "Quamquam amicitiam cum Alexio amiseram, egregiam cum Neferu acquisiveram."

# game/end_game2.rpy:2128
translate latin end_game2_7126d1b1:

    # "Good thing too, considering he's the only other sapient that's regularly in the palace during the day."
    "Bene quoque accidit, cum solus alius Sapiens sit qui interdiu regulariter in palatio adest."

# game/end_game2.rpy:2129
translate latin end_game2_e0c5e81f:

    # "I walk over to the benches, beginning to strip off my robe, glancing at the jackal."
    "Ad subsellia ambulo et tunicam exuere incipio, chacalum aspiciens."

# game/end_game2.rpy:2130
translate latin end_game2_1f9f1b86:

    # m "\"You know, it's not safe to fall asleep in the bath.\""
    m "\"Scis, in balneo obdormiscere tutum non est.\""

# game/end_game2.rpy:2131
translate latin end_game2_2a1c1349:

    # "Neferu shifts, raising an eyebrow even though he keeps his eyes closed."
    "Neferu se movet, supercilium tollens quamquam oculos clausos tenet."

# game/end_game2.rpy:2134
translate latin end_game2_59dccc63:

    # n "\"I appreciate your concern, but I feel that the sensation of water filling my lungs would be sufficient to wake me.\""
    n "\"Cura tua grata est, sed puto sensum aquae pulmones implentis satis esse ut me excitet.\""

# game/end_game2.rpy:2136
translate latin end_game2_e4b43167:

    # n "\"And I was not asleep. I was awaiting your arrival.\""
    n "\"Nec dormiebam. Adventum tuum exspectabam.\""

# game/end_game2.rpy:2137
translate latin end_game2_4b7b1310:

    # "I walk up to the edge of the pool, Neferu turning his head to look back at me, not even glancing at my naked groin."
    "Ad marginem piscinae ambulo; Neferu caput vertit ut ad me respiciat, ne ad inguen quidem nudum oculos demittens."

# game/end_game2.rpy:2138
translate latin end_game2_70a12a49:

    # m "\"Really? I didn't think you'd be here. Amicus told me he had Khemian meetings to go to.\""
    m "\"Vere? Non putavi te hic fore. Amicus mihi dixit se ad conventus Khemianos ire debere.\""

# game/end_game2.rpy:2139
translate latin end_game2_19d3943b:

    # "Briefly, I feel a little upset at the idea that Neferu might stay at the palace to see me while Amicus wouldn't."
    "Paulisper paulo laedor cogitans Neferu in palatio manere posse ut me videat, Amicum autem nolle."

# game/end_game2.rpy:2140
translate latin end_game2_bdcf882b:

    # "But only briefly."
    "Sed paulisper tantum."

# game/end_game2.rpy:2141
translate latin end_game2_80da4ffb:

    # "Things are different for the emperor."
    "Res imperatori aliae sunt."

# game/end_game2.rpy:2143
translate latin end_game2_4e5aadde:

    # n "\"Luckily for me, my presence is no longer requested at such meetings. It matters little. I have direct access to the emperor anyway.\""
    n "\"Feliciter mihi, praesentia mea in talibus conventibus iam non petitur. Parum refert. Ad imperatorem enim directe accedere possum.\""

# game/end_game2.rpy:2144
translate latin end_game2_3f739ce1_2:

    # "I sigh."
    "Suspiro."

# game/end_game2.rpy:2145
translate latin end_game2_4b43164b:

    # m "\"You should choose your words carefully in front of the emperor's fiancée."
    m "\"Verba tua diligenter eligere debes coram imperatoris sponso."

# game/end_game2.rpy:2147
translate latin end_game2_22fa449a:

    # n "\"Why must you think I always speak in innuendos.\""
    n "\"Cur semper putas me ambigue loqui?\""

# game/end_game2.rpy:2148
translate latin end_game2_b047b2f5:

    # m "\"Because you do.\""
    m "\"Quia facis.\""

# game/end_game2.rpy:2149
translate latin end_game2_754f51e9:

    # "I jump into the pool."
    "In piscinam salio."

# game/end_game2.rpy:2152
translate latin end_game2_266ea5f8:

    # "It's not something I usually do, and I'm reminded why as my entire being burns for a few moments."
    "Id non soleo facere, et memini cur, cum totum corpus meum paulisper urit."

# game/end_game2.rpy:2153
translate latin end_game2_578d097a:

    # "It's worth it though, as I come up and see that I've accomplished my goal of splashing Neferu, the jackal in the middle of pawing water from his eyes."
    "Tamen operae pretium est, cum emergo et propositum meum effecisse video: Neferu aspersi, et chacalus aquam ab oculis pede abstergit."

# game/end_game2.rpy:2155
translate latin end_game2_0bf3a13b:

    # n "\"I must say, you become more like him every day.\""
    n "\"Dicendum est te cotidie similiorem illi fieri.\""

# game/end_game2.rpy:2156
translate latin end_game2_7e454f4c:

    # "I move to the bench to sit beside the jackal, my own eyes stinging from the salty, spring water."
    "Ad subsellium moveor ut iuxta chacalum sedeam, oculis meis quoque aqua fontis salsa urentibus."

# game/end_game2.rpy:2157
translate latin end_game2_d32985f8:

    # m "\"Because I'm more willing to shut you up?\""
    m "\"Quia te tacere iubere magis volo?\""

# game/end_game2.rpy:2159
translate latin end_game2_9f1a2c77:

    # n "\"Yes, crude like the wolves, having to resort to physical methods because they can't use their words properly.\""
    n "\"Ita, rudis sicut lupi, qui ad corporales modos confugere debent quia verbis recte uti non possunt.\""

# game/end_game2.rpy:2160
translate latin end_game2_0cd535bd_1:

    # "I narrow my eyes."
    "Oculos contraho."

# game/end_game2.rpy:2161
translate latin end_game2_9e7266c2:

    # m "\"Well, talk enough shit, then you're gonna get hit. Humans are the same, and I have a feeling jackals are too.\""
    m "\"Bene, satis sordida dic, et vapulabis. Homines idem faciunt, et suspicor chacalos quoque idem facere.\""

# game/end_game2.rpy:2163
translate latin end_game2_165d4bf6:

    # n "\"How would you know? I've never raised a paw against anyone on this moon.\""
    n "\"Quomodo scias? Numquam in hac luna pedem contra quemquam sustuli.\""

# game/end_game2.rpy:2164
translate latin end_game2_722cba8a:

    # m "\"Probably because you know you wouldn't stand a chance. Also I have seen you fight, first with Alex, and remember you accepted a spar with Amicus a few months back?\""
    m "\"Probabiliter quia scis te nihil posse. Praeterea te pugnantem vidi, primum cum Alexio, et meministi te certamen exercitationis cum Amico paucis mensibus abhinc accepisse?\""

# game/end_game2.rpy:2166
translate latin end_game2_d3858984:

    # n "\"I seem to have forgotten.\""
    n "\"Oblitus esse videor.\""

# game/end_game2.rpy:2167
translate latin end_game2_e6089c4b:

    # m "\"Well I haven't. You took off all your clothes to tease him, then got floored in like a second.\""
    m "\"Ego non sum. Omnia vestimenta exuisti ut eum irritares, deinde paene uno momento deiectus es.\""

# game/end_game2.rpy:2169
translate latin end_game2_072a6124:

    # n "\"He struck me in the stomach when I was not ready, and very hard, mind you. Their combat techniques are as crude as their words.\""
    n "\"Me in ventrem percussit cum paratus non eram, et vehementissime, ut scias. Artes eorum pugnandi tam rudes sunt quam verba.\""

# game/end_game2.rpy:2170
translate latin end_game2_517194ee:

    # m "\"You weren't ready because you were still using {i}your words{/i} after the fight had started.\""
    m "\"Non paratus eras quia adhuc {i}verbis tuis{/i} utebaris postquam pugna incohata erat.\""

# game/end_game2.rpy:2171
translate latin end_game2_90cdfeab:

    # "Even though the incident had been a little worrying at the time, I find it mostly funny now and I smirk at the memory."
    "Quamquam res illo tempore paulo sollicita fuerat, nunc eam maxime ridiculam invenio et memoria subrideo."

# game/end_game2.rpy:2172
translate latin end_game2_8e5a2559:

    # n "\"How is that funny? I had to check into hospital to make sure he didn't rupture anything. It was very dangerous to do such a thing in what was supposed to be a friendly spar.\""
    n "\"Quomodo id ridiculum est? In valetudinarium ire debui ut curarem nihil eum rupisse. Periculosissimum erat tale quid facere in certamine quod amicum esse debebat.\""

# game/end_game2.rpy:2173
translate latin end_game2_74a7b2f9:

    # m "\"I think it was the way you went from showboating to making the weirdest noises after you fell on the ground.\""
    m "\"Puto causam esse quod ab ostentatione ad sonos mirissimos faciendos transisti postquam in terram cecidisti.\""

# game/end_game2.rpy:2174
translate latin end_game2_e20c79ed:

    # "Amicus probably did take out a lot of his built-up frustration in that attack."
    "Amicus probabiliter multa indignatione cumulata illo impetu se liberavit."

# game/end_game2.rpy:2175
translate latin end_game2_a40854ce:

    # "Unfortunately, it resulted in even more tension between the two of them, which makes things difficult because I like them both."
    "Infeliciter inde etiam maior discordia inter eos orta est, quod res difficiles facit quia ambo mihi placent."

# game/end_game2.rpy:2176
translate latin end_game2_c424c5ab:

    # "I guess Neferu at least still talks official business with Amicus."
    "Credo Neferu saltem adhuc negotia publica cum Amico tractare."

# game/end_game2.rpy:2177
translate latin end_game2_9273eb0c:

    # "Neferu huffs."
    "Neferu indignans exhalat."

# game/end_game2.rpy:2178
translate latin end_game2_5b2e8498:

    # n "\"And like that blow, bringing that up is rather low of you.\""
    n "\"Et sicut ille ictus, hoc commemorare satis humile est ex te.\""

# game/end_game2.rpy:2179
translate latin end_game2_e058bc90:

    # "He's right."
    "Recte dicit."

# game/end_game2.rpy:2180
translate latin end_game2_57005a5c:

    # "My mood is a bit strange today, and just like with Virginia, I find myself being more blunt."
    "Animus meus hodie paulo insolitus est, et sicut cum Virginia, simplicius loquor."

# game/end_game2.rpy:2181
translate latin end_game2_8619f2c6_4:

    # "I shrug."
    "Umeros tollo."

# game/end_game2.rpy:2182
translate latin end_game2_557ddb38:

    # m "\"Well, so was making shitty comments about all wolves.\""
    m "\"Bene, humile quoque erat turpia de omnibus lupis dicere.\""

# game/end_game2.rpy:2184
translate latin end_game2_2dbe9971:

    # "Neferu sighs loudly, seemingly at a loss for words."
    "Neferu magna voce suspirat, verbis carere visus."

# game/end_game2.rpy:2185
translate latin end_game2_dee7ebb0:

    # "A rare sight."
    "Rarus aspectus."

# game/end_game2.rpy:2186
translate latin end_game2_3c0baa52:

    # "I start to feel a bit guilty and clear my throat, changing the subject, to the subject I'm not really sure how to explain to the jackal."
    "Paulum reum me sentire incipio et fauces expurgo, rem mutans ad id quod chacalo quomodo explicem non satis scio."

# game/end_game2.rpy:2187
translate latin end_game2_faf79df4:

    # m "\"So...I'm leaving tomorrow.\""
    m "\"Igitur...cras discedo.\""

# game/end_game2.rpy:2189
translate latin end_game2_6ef6c71c:

    # "Neferu's eyes light up."
    "Oculi Neferu clarescunt."

# game/end_game2.rpy:2190
translate latin end_game2_f566cc83:

    # n "\"So I have heard. Which is why I wanted to be sure that I would see you today, though I'm starting to regret it considering your mood.\""
    n "\"Ita audivi. Quam ob rem curare volui ut te hodie viderem, quamquam iam paenitere incipit, animo tuo considerato.\""

# game/end_game2.rpy:2191
translate latin end_game2_b0028243:

    # "I slump against the ledge."
    "Ad marginem delabor."

# game/end_game2.rpy:2192
translate latin end_game2_4adcbaaf:

    # m "\"Sorry, I'm feeling...weird today. I'm just overwhelmed with everything that's happening.\""
    m "\"Ignosce, hodie...insolite me habeo. Omnibus quae fiunt obrutus sum.\""

# game/end_game2.rpy:2193
translate latin end_game2_c34664d3:

    # n "\"Well, you'll be returning, won't you?\""
    n "\"Bene, redibis, nonne?\""

# game/end_game2.rpy:2194
translate latin end_game2_6a13c2fd:

    # m "\"...Yeah, just not sure when that might be."
    m "\"...Ita, tantum nescio quando id futurum sit."

# game/end_game2.rpy:2195
translate latin end_game2_cdf0f063:

    # "Obviously Amicus wouldn't have told Neferu about our situation, maybe even if the parents directed him to."
    "Scilicet Amicus Neferu de statu nostro non dixisset, fortasse etiam si Parentes eum iussissent."

# game/end_game2.rpy:2196
translate latin end_game2_f53e1fa0:

    # "I'm guessing it was Virginia who told him I'm leaving."
    "Suspicor Virginiam ei dixisse me discedere."

# game/end_game2.rpy:2198
translate latin end_game2_50bcae1a:

    # n "\"This is a temporary trip, is it not? You are engaged to be married, after all.\""
    n "\"Iter temporarium est, nonne? Matrimonium enim promissum habes.\""

# game/end_game2.rpy:2199
translate latin end_game2_c0321214:

    # "I shift a little under his intense gaze."
    "Sub intentis oculis eius paulum me moveo."

# game/end_game2.rpy:2200
translate latin end_game2_aa2e7dab:

    # m "\"Yeah, but I miss my planet. I just need to be home for a while...so it might be a while.\""
    m "\"Ita, sed planetam meum desidero. Tantum domi aliquamdiu esse debeo...ita fortasse diu erit.\""

# game/end_game2.rpy:2201
translate latin end_game2_f651cd9d:

    # "Neferu is quiet for a moment."
    "Neferu paulisper tacet."

# game/end_game2.rpy:2203
translate latin end_game2_a9e468a7:

    # n "\"Does 'a while' mean weeks...months?\""
    n "\"Num 'aliquamdiu' septimanas significat...menses?\""

# game/end_game2.rpy:2204
translate latin end_game2_1609e617:

    # "I look away, over the surface of the steaming water."
    "Averto oculos, super superficiem aquae vaporantis aspiciens."

# game/end_game2.rpy:2205
translate latin end_game2_d7b556f7:

    # m "\"Maybe a bit longer.\""
    m "\"Fortasse paulo diutius.\""

# game/end_game2.rpy:2207
translate latin end_game2_0e7d8d62:

    # n "\"Years.\""
    n "\"Annos.\""

# game/end_game2.rpy:2208
translate latin end_game2_c7f91870:

    # "It's more of a statement than a question."
    "Magis affirmatio quam quaestio est."

# game/end_game2.rpy:2209
translate latin end_game2_6f40f7c3:

    # m "\"Maybe.\""
    m "\"Fortasse.\""

# game/end_game2.rpy:2211
translate latin end_game2_8eb60deb:

    # n "\"Well, I must say that I was rather shocked to hear of your sudden plans for departure, that you would not tell me earlier.\""
    n "\"Dicendum est me satis percussum esse cum subita consilia discessus tui audivi, quod mihi antea non dixeris.\""

# game/end_game2.rpy:2212
translate latin end_game2_1257600b:

    # "I half-heartedly will the parents to send me a signal that I can just tell Neferu everything."
    "Non admodum ardenter Parentes mente oro ut mihi signum mittant quo omnia Neferu dicere liceat."

# game/end_game2.rpy:2213
translate latin end_game2_027c80d5:

    # "But, like always, all is quiet in space."
    "Sed, ut semper, omnia in spatio silent."

# game/end_game2.rpy:2214
translate latin end_game2_12905e0d:

    # n "\"But now I'm less surprised, considering that it sounds like you yourself did not realize you would be leaving.\""
    n "\"Sed nunc minus miror, cum videatur te ipsum discessum tuum non praevidisse.\""

# game/end_game2.rpy:2215
translate latin end_game2_4c3ab0d4:

    # m "\"I just didn't know how to tell you.\""
    m "\"Tantum nesciebam quomodo tibi dicerem.\""

# game/end_game2.rpy:2216
translate latin end_game2_2f34b8dd:

    # n "\"Mmh, that, or you're hiding something.\""
    n "\"Mmh, id, aut aliquid celas.\""

# game/end_game2.rpy:2217
translate latin end_game2_dd0ee98f:

    # "I look at him."
    "Eum intueor."

# game/end_game2.rpy:2218
translate latin end_game2_df8ec4bc_2:

    # m "\"What?\""
    m "\"Quid?\""

# game/end_game2.rpy:2220
translate latin end_game2_aabc5277:

    # n "\"Oh [mc], you're not nearly as subtle as you think. Like I said, you're becoming more like Amicus every day.\""
    n "\"O [mc], non fere tam subtilis es quam putas. Ut dixi, cotidie similior Amico fis.\""

# game/end_game2.rpy:2221
translate latin end_game2_9d3344cb:

    # m "\"What do you mean?\""
    m "\"Quid dicis?\""

# game/end_game2.rpy:2223
translate latin end_game2_dc6454c2:

    # n "\"Well, your sudden interest in galactic affairs, for one, but mostly, it's your mere presence here in the first place. It makes little sense.\""
    n "\"Subitum studium rerum galacticarum tuum, exempli causa; sed maxime ipsa praesentia tua hic. Parum rationis habet.\""

# game/end_game2.rpy:2224
translate latin end_game2_73453da0_1:

    # m "\"Oh yeah?\""
    m "\"O, ita?\""

# game/end_game2.rpy:2225
translate latin end_game2_e686e1c0:

    # "I kind of hope that Neferu figures it out on his own, considering that would dodge the issue of me telling anyone."
    "Quodammodo spero Neferu per se rem intellegere, quoniam ita quaestionem rem cuiquam dicendi vitarem."

# game/end_game2.rpy:2227
translate latin end_game2_93ed5efe:

    # n "\"Oh yes. If I were to guess, you are currently being trained by Adastra to assimilate your people with the children of the wolves.\""
    n "\"O ita. Si coniciam, nunc ab Adastra institueris ut populum tuum cum Liberis luporum coniungas.\""

# game/end_game2.rpy:2228
translate latin end_game2_833a0a07:

    # "I physically recoil at the idea, even though he's incredibly close."
    "Ab hac cogitatione corpore refugio, quamquam incredibiliter prope veritatem est."

# game/end_game2.rpy:2229
translate latin end_game2_2f912eb2:

    # m "\"What? Hell no! I would never do that to my people...or to any people!\""
    m "\"Quid? Minime, per inferos! Numquam id populo meo facerem...nec ulli populo!\""

# game/end_game2.rpy:2230
translate latin end_game2_62fe6725:

    # "Despite Amicus being emperor, and despite his slow but steady improvements for the wolven children, it's still not a situation I would put Earth in willingly."
    "Quamquam Amicus imperator est, et quamquam lente sed constanter condiciones Liberorum luporum meliores facit, tamen non est status in quem Terram sponte ponerem."

# game/end_game2.rpy:2232
translate latin end_game2_19a8bca3:

    # "Neferu raises his eyebrow again, seemingly convinced by my reaction."
    "Neferu iterum supercilium tollit, responsione mea persuasus visus."

# game/end_game2.rpy:2233
translate latin end_game2_7cd75aa3:

    # n "\"Hm...\""
    n "\"Hm...\""

# game/end_game2.rpy:2234
translate latin end_game2_1fec7261:

    # "We regard each other for a moment, and Neferu blinks first."
    "Nos paulisper invicem intuemur, et Neferu primus palpebras movet."

# game/end_game2.rpy:2236
translate latin end_game2_4f08eba1:

    # n "\"So, you really won't tell me?\""
    n "\"Igitur, vere mihi non dices?\""

# game/end_game2.rpy:2237
translate latin end_game2_210d5a96:

    # m "\"I didn't say I have a secret to tell, though. You're just assuming.\""
    m "\"Sed non dixi me arcanum habere quod dicam. Tantum conicis.\""

# game/end_game2.rpy:2238
translate latin end_game2_204e1544:

    # n "\"Honestly, I'm a bit hurt that you feel you can't trust me with this information, after all this time.\""
    n "\"Sincere, paulo dolet quod sentis te mihi hoc indicium credere non posse, post tantum tempus.\""

# game/end_game2.rpy:2239
translate latin end_game2_911c6045:

    # "Now I raise an eyebrow."
    "Nunc ego supercilium tollo."

# game/end_game2.rpy:2240
translate latin end_game2_a3a30c8e:

    # m "\"Neferu, you haven't told me anything about your own situation on your planet, along with your family.\""
    m "\"Neferu, nihil mihi de statu tuo in planeta tuo cum familia tua dixisti.\""

# game/end_game2.rpy:2242
translate latin end_game2_feeb28cb:

    # n "\"Well, you've never asked.\""
    n "\"Bene, numquam rogavisti.\""

# game/end_game2.rpy:2243
translate latin end_game2_a4e3c8d5:

    # m "\"Because I know it's personal. You dodged the topic whenever I brought it up.\""
    m "\"Quia scio rem privatam esse. Rem vitabas quotiens eam attuli.\""

# game/end_game2.rpy:2245
translate latin end_game2_5c3e9c6d:

    # n "\"It's a very long story, first of all, and second of all, it's a story about me being a selfish, foolish brat. Of course I wouldn't want to tell you.\""
    n "\"Primum, fabula longissima est; deinde, fabula est de me puero sui tantum studioso atque stulto. Scilicet tibi dicere nolim.\""

# game/end_game2.rpy:2247
translate latin end_game2_54a7b329:

    # n "\"But if I tell you, would you tell me?\""
    n "\"Sed si tibi dixero, mihi dices?\""

# game/end_game2.rpy:2248
translate latin end_game2_cb83fb0b:

    # "I think, somewhat tempted to make him tell his story, then just lie about mine...but only for a second."
    "Cogito, paulo tentatus ut eum fabulam suam narrare faciam, deinde de mea mentiar...sed momento tantum."

# game/end_game2.rpy:2249
translate latin end_game2_3f739ce1_3:

    # "I sigh."
    "Suspiro."

# game/end_game2.rpy:2250
translate latin end_game2_7b9a7861:

    # m "\"No. I...I'll only be able to when I come back.\""
    m "\"Non. Ego...tantum cum rediero potero.\""

# game/end_game2.rpy:2252
translate latin end_game2_ffadb9d0:

    # "Neferu's impish nature deflates pretty quick."
    "Lascivia Neferu satis cito languescit."

# game/end_game2.rpy:2253
translate latin end_game2_c5952df9:

    # n "\"Well, at least you're honest.\""
    n "\"Bene, saltem sincerus es.\""

# game/end_game2.rpy:2255
translate latin end_game2_937892a1:

    # n "\"I suppose I'll trust you that it's rather important and not my place to know. I admit that I am still hurt by all this, and that's not something I admit often.\""
    n "\"Credam tibi rem magni momenti esse neque me scire debere. Fateor haec omnia adhuc mihi dolere, quod non saepe fateor.\""

# game/end_game2.rpy:2256
translate latin end_game2_4a111ef8:

    # m "\"Sorry. I promise, you'll understand once I'm back.\""
    m "\"Ignosce. Promitto te intellecturum esse ubi rediero.\""

# game/end_game2.rpy:2257
translate latin end_game2_1a7c01f6:

    # "Again, I wonder if I'm already admitting too much."
    "Iterum miror num iam nimium concedam."

# game/end_game2.rpy:2259
translate latin end_game2_f523611d:

    # n "\"But years? I can't predict where I'll be in that amount of time.\""
    n "\"Sed annos? Praedicere non possum ubi post tantum tempus ero.\""

# game/end_game2.rpy:2260
translate latin end_game2_7a05e994:

    # m "\"Back on Khemia?\""
    m "\"Rursus in Khemia?\""

# game/end_game2.rpy:2261
translate latin end_game2_114a3364:

    # n "\"Possibly, if all goes well.\""
    n "\"Fortasse, si omnia bene cedunt.\""

# game/end_game2.rpy:2262
translate latin end_game2_3526662a:

    # m "\"I'll visit. I'm a citizen, remember?\""
    m "\"Te visam. Civis sum, meministi?\""

# game/end_game2.rpy:2264
translate latin end_game2_26e2ca6c:

    # n "\"Well, they rarely allow use of the stretch for only visits, but being the emperor's husband might make that easier.\""
    n "\"Bene, raro Propulsionem ad solas visitationes adhiberi sinunt, sed imperatoris virum esse id facilius facere potest.\""

# game/end_game2.rpy:2265
translate latin end_game2_16a0cead:

    # m "\"Yeah, I'll convince him.\""
    m "\"Ita, ei persuadebo.\""

# game/end_game2.rpy:2266
translate latin end_game2_2e0b0c7e:

    # "That seems to bring the issue of my sudden departure to a close."
    "Hoc quaestionem subiti discessus mei claudere videtur."

# game/end_game2.rpy:2267
translate latin end_game2_bad302f4:

    # "We sit there in silence for a long while, then I place a hand on Neferu's knee."
    "Diu ibi silentes sedemus, deinde manum in genu Neferu pono."

# game/end_game2.rpy:2268
translate latin end_game2_5e5f6d27:

    # "It's not something I would have done in the past, considering the jackal's reputation, but nothing about it feels sensual."
    "Id antea non fecissem, fama chacali considerata, sed nihil in eo libidinosum sentitur."

# game/end_game2.rpy:2269
translate latin end_game2_89f0eb15:

    # "Instead, I do it out of pure solidarity and friendship."
    "Potius ex pura societate et amicitia facio."

# game/end_game2.rpy:2270
translate latin end_game2_0da9fa66:

    # m "\"And I wanted to say thank you, Neferu, for everything. I don't think I'd be alive if you weren't there for me. I know you had your reasons, everyone did, but thank you.\""
    m "\"Et gratias tibi agere volebam, Neferu, pro omnibus. Non puto me vivere si mihi non adfuisses. Scio te causas tuas habuisse, omnes habebant, sed gratias.\""

# game/end_game2.rpy:2272
translate latin end_game2_3869227a:

    # n "\"It is the duty of all Khemians to protect any sapient fleeing wolven violence, whether they be sibling, child, or as you happen to be, abandoned.\""
    n "\"Omnium Khemianorum officium est quemlibet Sapientem a vi luporum fugientem protegere, sive Frater sit, sive Liber, sive, ut tu es, derelictus.\""

# game/end_game2.rpy:2273
translate latin end_game2_c6f32c90:

    # m "\"I'll believe that after I visit Khemia and have a look for myself.\""
    m "\"Id credam postquam Khemiam visam et ipse inspexero.\""

# game/end_game2.rpy:2275
translate latin end_game2_22b87124:

    # n "\"I'll be your tour guide.\""
    n "\"Dux itineris tui ero.\""

# game/end_game2.rpy:2276
translate latin end_game2_5b4e92f8:

    # m "\"And Neferu, you can still tell me what's going on with your family, if you want.\""
    m "\"Et Neferu, adhuc mihi dicere potes quid cum familia tua agatur, si vis.\""

# game/end_game2.rpy:2278
translate latin end_game2_81867468:

    # n "\"Definitely not. Do you {i}really{/i} want to know? The situation is complex, unresolved, and seems to always be changing.\""
    n "\"Certe non. {i}Vere{/i} scire vis? Res perplexa est, nondum soluta, et semper mutari videtur.\""

# game/end_game2.rpy:2279
translate latin end_game2_b42bda03:

    # m "\"I mean, yeah, I'd like to know. It seems really important to you, but...\""
    m "\"Dico, ita, scire velim. Tibi maximi momenti videtur, sed...\""

# game/end_game2.rpy:2280
translate latin end_game2_7f6e37de:

    # "It feels unfair that I'd make him tell me his clearly painful story without my own."
    "Iniquum videtur eum fabulam suam aperte dolorosam narrare cogere sine mea."

# game/end_game2.rpy:2281
translate latin end_game2_0d36bfbd:

    # m "\"Again, when I'm back. Then we can trade.\""
    m "\"Iterum, cum rediero. Tum fabulas permutabimus.\""

# game/end_game2.rpy:2283
translate latin end_game2_984a65b5:

    # n "\"Deal.\""
    n "\"Convenit.\""

# game/end_game2.rpy:2284
translate latin end_game2_a96d73eb:

    # "Neferu stands up, stepping up onto the bench before reaching down to pull me up."
    "Neferu surgit, in subsellium ascendens antequam manum demittit ut me tollat."

# game/end_game2.rpy:2286
translate latin end_game2_eeeaa10e:

    # n "\"Now let's go for a walk before your wolf returns. I would like our last conversations to be of happier things.\""
    n "\"Nunc ambulemus antequam lupus tuus redit. Volo ultima colloquia nostra de rebus laetioribus esse.\""

# game/end_game2.rpy:2288
translate latin end_game2_b1da4148:

    # "I take his paw, letting him pull me up."
    "Pedem eius capio, sinens eum me tollere."

# game/end_game2.rpy:2290
translate latin end_game2_f5441a5c:

    # "Then the two of us step out of the pool to towel off and dress."
    "Tum ambo e piscina eximus ut linteis nos tergamus et vestiamus."

# game/end_game2.rpy:2291
translate latin end_game2_d24914a0:

    # "Neferu is easily able to shift the conversation to things that are light and interesting, and it almost makes me forget that I'm leaving."
    "Neferu facile colloquium ad res leves iucundasque vertit, et paene facit ut discessus mei obliviscar."

# game/end_game2.rpy:2296
translate latin end_game2_9c5d32f3:

    # a "\"And so this wolverine actually believes that the imperial family would even {i}consider{/i} apologizing for the war. Absolutely asinine, if you ask me.\""
    a "\"Atque hic gulo vere credit familiam imperatoriam veniam pro bello petere etiam {i}cogitaturam{/i} esse. Prorsus asininum, si me rogas.\""

# game/end_game2.rpy:2297
translate latin end_game2_f8108e6c:

    # m "\"Sounds reasonable.\""
    m "\"Rationabile videtur.\""

# game/end_game2.rpy:2299
translate latin end_game2_3e7400a4:

    # a "\"What!? No, [mc], it is not! We suffered the heaviest casualties.\""
    a "\"Quid!? Non, [mc], non est! Nos gravissimas clades passi sumus.\""

# game/end_game2.rpy:2300
translate latin end_game2_71c048da:

    # m "\"But wasn't it started by the empire?\""
    m "\"Sed nonne ab imperio incohatum est?\""

# game/end_game2.rpy:2302
translate latin end_game2_3451b747:

    # a "\"No, it was started by Khemian provocation. Haven't you learned the history?\""
    a "\"Non, provocatione Khemiana incohatum est. Nonne historiam didicisti?\""

# game/end_game2.rpy:2303
translate latin end_game2_3507c7f7:

    # m "\"Well, yeah, but attacking a planet full of sapient children wasn't the best way to respond.\""
    m "\"Bene, ita, sed planetam Liberis Sapientibus plenum oppugnare non optimus respondendi modus erat.\""

# game/end_game2.rpy:2304
translate latin end_game2_4eef9e50:

    # a "\"We attacked the Khemian bases with weaponry which happened to be on a planet full of children. They were never fired on directly.\""
    a "\"Stationes Khemianas armatas oppugnavimus, quae forte in planeta Liberis pleno erant. Ipsi numquam directe oppugnati sunt.\""

# game/end_game2.rpy:2305
translate latin end_game2_43a06ddb:

    # m "\"So says the Adastran history books.\""
    m "\"Ita dicunt libri historiae Adastranae.\""

# game/end_game2.rpy:2307
translate latin end_game2_fb6a565a:

    # a "\"Ugh! Why would you assume that? It's not a good argument to just...whip out assumptions that these are lies. My father never lied.\""
    a "\"Ugh! Cur id conicias? Non bonum argumentum est tantum...coniecturas proferre haec mendacia esse. Pater meus numquam mentitus est.\""

# game/end_game2.rpy:2308
translate latin end_game2_5437b4b6:

    # m "\"I'm basing it off what I've learned from Khemian history as well. I'm not only learning about Adastra, you know.\""
    m "\"Id etiam ex historia Khemiana quam didici iudico. Non tantum de Adastra disco, scis.\""

# game/end_game2.rpy:2309
translate latin end_game2_26fdc21b:

    # "Amicus is quiet, but still looking huffy, so I lean over from my side of the couch to touch his shoulder."
    "Amicus tacet, sed adhuc indignatus videtur; itaque e parte mea lectuli inclino ut umerum eius tangam."

# game/end_game2.rpy:2310
translate latin end_game2_00ffc66e:

    # m "\"Listen, I'm not saying your father is a liar...I'm saying that sapients as a whole are. I know because humans do the exact same thing when we write our history.\""
    m "\"Audi, non dico patrem tuum mendacem esse...dico Sapientes universos esse. Scio quia homines idem prorsus faciunt cum historiam nostram scribimus.\""

# game/end_game2.rpy:2311
translate latin end_game2_ae079bd8:

    # a "\"You should have a bit more pride in your species. How will you lead the humans, otherwise?\""
    a "\"Paulo magis specie tua superbire debes. Quomodo alioquin homines duces?\""

# game/end_game2.rpy:2312
translate latin end_game2_59d25363:

    # m "\"Actually, I think pride is the biggest wolven problem.\""
    m "\"Re vera, puto superbiam maximum luporum malum esse.\""

# game/end_game2.rpy:2314
translate latin end_game2_d277cbf7:

    # "Amicus just goes quiet."
    "Amicus tantum tacet."

# game/end_game2.rpy:2315
translate latin end_game2_f1b92e5d:

    # "I think I hit a sore spot talking about his dad, and although I'm enjoying our usual, somewhat intense banter, I don't have as much energy as usual."
    "Puto me locum dolentem attigisse de patre eius loquens; et quamquam solitae nostrae satis acri cavillatione fruor, non tam strenuus sum quam soleo."

# game/end_game2.rpy:2316
translate latin end_game2_d5cbd0bf:

    # m "\"Sorry...I shouldn't talk about things I don't understand.\""
    m "\"Ignosce...de rebus quas non intellego loqui non debeo.\""

# game/end_game2.rpy:2317
translate latin end_game2_9e89c41e:

    # "Amicus looks at me with surprise."
    "Amicus me admirans aspicit."

# game/end_game2.rpy:2319
translate latin end_game2_7df2cfda:

    # a "\"What? No, I do want you to talk to me about these things. I might seem upset, but I've already told you I enjoy debating—\""
    a "\"Quid? Non, volo quidem ut de his rebus mecum loquaris. Iratus videri possum, sed iam tibi dixi me disputationibus frui—\""

# game/end_game2.rpy:2320
translate latin end_game2_2bc623db:

    # "I wave away Amicus's rush to smooth things over."
    "Manu Amici festinationem ad rem placandam dimitto."

# game/end_game2.rpy:2321
translate latin end_game2_7349bc5b:

    # m "\"No, me too. I'm just a little tired today.\""
    m "\"Non, ego quoque. Tantum hodie paulo lassus sum.\""

# game/end_game2.rpy:2323
translate latin end_game2_c2f7d8b7:

    # a "\"Ah...\""
    a "\"Ah...\""

# game/end_game2.rpy:2324
translate latin end_game2_5c589e68:

    # "What I want to talk about is what's about to happen to me, about how I very much doubt the parents themselves, how I don't want to do anything except stay on this couch."
    "De eo loqui volo quod mihi mox accidet, de eo quam valde de ipsis Parentibus dubitem, quam nihil facere velim nisi in hoc lecto sedendi manere."

# game/end_game2.rpy:2325
translate latin end_game2_bb81df59:

    # "But I can tell Amicus doesn't."
    "Sed sentio Amicum nolle."

# game/end_game2.rpy:2326
translate latin end_game2_930f0beb:

    # "He came in with the stories of the day right away, as if this isn't our last night together."
    "Statim cum fabulis huius diei intravit, quasi haec ultima nox nostra simul non sit."

# game/end_game2.rpy:2327
translate latin end_game2_4c7ad3ad:

    # "While it had been easy to pretend with Neferu, it's much more difficult seeing Amicus put on such an act to, I assume, make me feel better."
    "Quamquam cum Neferu facile erat simulare, multo difficilius est videre Amicum talem personam agere ut, suspicor, me consoletur."

# game/end_game2.rpy:2328
translate latin end_game2_246a9638:

    # m "\"Amicus, I don't know if I can—\""
    m "\"Amice, nescio num possim—\""

# game/end_game2.rpy:2330
translate latin end_game2_581182d7:

    # "Amicus suddenly holds up a paw."
    "Amicus subito pedem tollit."

# game/end_game2.rpy:2331
translate latin end_game2_467a16cd:

    # a "\"Wait, [mc], I—I know, but please, let's have this night together. I promise you, the situation will become clearer for you, just give it a little more time.\""
    a "\"Exspecta, [mc], ego—scio, sed quaeso, hanc noctem simul habeamus. Promitto rem tibi clariorem futuram esse; tantum paulo plus temporis da.\""

# game/end_game2.rpy:2332
translate latin end_game2_abde442e:

    # "That gives me pause."
    "Hoc me haerere facit."

# game/end_game2.rpy:2333
translate latin end_game2_fb8d3be6:

    # "It's like Amicus knows something that I don't..."
    "Quasi Amicus aliquid sciat quod ego nescio..."

# game/end_game2.rpy:2335
translate latin end_game2_116f6903:

    # a "\"And trust me, because we are traveling back to Earth together, we will have plenty of time to discuss whatever you wish—\""
    a "\"Et mihi crede, quia simul ad Terram redimus, satis temporis habebimus ad quidquid vis tractandum—\""

# game/end_game2.rpy:2337
translate latin end_game2_05321a92:

    # "Amicus's eyes start to glisten just slightly as he holds back tears, then clears his throat."
    "Oculi Amici paulo lucere incipiunt dum lacrimas reprimit; deinde fauces expurgat."

# game/end_game2.rpy:2339
translate latin end_game2_fd5c1b5f:

    # a "\"—but for now...I think it's preposterous that they expect me to apologize.\""
    a "\"—sed nunc...puto absurdum esse quod exspectant me veniam petiturum.\""

# game/end_game2.rpy:2340
translate latin end_game2_2649d278:

    # "I watch Amicus for a long time, realizing that maybe I should keep my suspicions to myself, for now."
    "Amicum diu specto, intellegens fortasse me suspiciones meas nunc mihi servare debere."

# game/end_game2.rpy:2341
translate latin end_game2_9eb7d982:

    # "He's in constant contact with the parents, and I've respected the fact that he can't tell me what they say unless given specific permission to do so."
    "Assidue cum Parentibus communicat, et observavi eum mihi quae dicant dicere non posse nisi nominatim permissum sit."

# game/end_game2.rpy:2342
translate latin end_game2_355c2532:

    # "But he must believe in them if he's still wanting to go along with this plan."
    "Sed eis credere debet si adhuc hoc consilium sequi vult."

# game/end_game2.rpy:2343
translate latin end_game2_000ad9eb:

    # "I think I need to figure out the parents on my own."
    "Puto me Parentes ipse intellegere debere."

# game/end_game2.rpy:2344
translate latin end_game2_ab0fa07f:

    # "On top of that, he knows how hard this separation is going to be, we both do."
    "Praeterea scit quam difficilis haec separatio futura sit; ambo scimus."

# game/end_game2.rpy:2345
translate latin end_game2_bb57c5a9:

    # "But he wants to save the tears for the end, and so do I."
    "Sed lacrimas ad finem servare vult, et ego quoque."

# game/end_game2.rpy:2346
translate latin end_game2_42b896f8:

    # "So..."
    "Ita..."

# game/end_game2.rpy:2347
translate latin end_game2_2e087ece:

    # m "\"Well, if it's just the imperial family apologizing that's actually asking for very little to create an alliance.\""
    m "\"Bene, si tantum familia imperatoria veniam petit, id re vera parvum postulatum est ad societatem faciendam.\""

# game/end_game2.rpy:2349
translate latin end_game2_a36109b8:

    # a "\"It's one of many demands, and they simply want to humiliate us, all because Neferu managed to get his balls kicked in.\""
    a "\"Unum ex multis postulatis est, et nos tantum humiliare volunt, totum quia Neferu testes sibi calcitrari sivit.\""

# game/end_game2.rpy:2350
translate latin end_game2_454c01d5:

    # m "\"I mean, the Pharaoh's son. You should honestly consider yourself lucky no one else saw {i}you{/i} hit him.\""
    m "\"Dico, filius Pharaonis. Vere te felicem habere debes quod nemo alius {i}te{/i} eum percutientem vidit.\""

# game/end_game2.rpy:2352
translate latin end_game2_3aaf056f:

    # a "\"Heh, he's an easy one to hit. What does he expect always leaving himself wide open? He deserved it. Both times.\""
    a "\"Heh, facile eum percutere est. Quid exspectat cum semper se omnino apertum relinquit? Meruit. Utraque vice.\""

# game/end_game2.rpy:2353
translate latin end_game2_3f739ce1_4:

    # "I sigh."
    "Suspiro."

# game/end_game2.rpy:2354
translate latin end_game2_49e6a085:

    # m "\"Be nice, Amicus.\""
    m "\"Benignus esto, Amice.\""

# game/end_game2.rpy:2356
translate latin end_game2_7eeecbae:

    # "But I lean into him, and he finally pulls me into his lap, nuzzling my hair."
    "Sed ei innitor, et tandem me in gremium suum attrahit, capillis meis rostrum admovens."

# game/end_game2.rpy:2359
translate latin end_game2_dc55772b:

    # "We talk for a while longer, the two of us trying to stay awake as long as possible."
    "Paulo diutius loquimur, ambo quam diutissime vigilare conantes."

# game/end_game2.rpy:2360
translate latin end_game2_1846f2a6:

    # "I finally manage to relax a bit, and finally my eyes grow heavy, and Amicus's warm breath puffs steadily against my head."
    "Tandem paulum relaxari possum, tandemque palpebrae graves fiunt, et calidus spiritus Amici aequabiliter contra caput meum flatur."

# game/end_game2.rpy:2361
translate latin end_game2_cf07b580:

    # "I imagine this moment folding into a pocket of infinity, made to go on forever, our responsibilities gone, the coming trials never to arrive."
    "Hoc momentum in recessum infinitatis complicari imaginor, in perpetuum duraturum, officiis nostris sublatis, venturis periculis numquam adventuris."

# game/end_game2.rpy:2362
translate latin end_game2_870e839a:

    # "But time does march on, because without realizing it, I start to fall asleep..."
    "Sed tempus procedit, nam inscius obdormiscere incipio..."

# game/end_game2.rpy:2366
translate latin end_game2_42992b10:

    # "{i}\"You are on the right path.\"{/i}"
    "{i}\"In recta via es.\"{/i}"

# game/end_game2.rpy:2367
translate latin end_game2_b6a8fd99:

    # "I grasp blindly at the sound of his voice."
    "Ad sonum vocis eius caecus manus tendo."

# game/end_game2.rpy:2368
translate latin end_game2_c22490cd:

    # "Hello?"
    "Salve?"

# game/end_game2.rpy:2369
translate latin end_game2_2c1b407f:

    # "I don't know what to do."
    "Nescio quid faciam."

# game/end_game2.rpy:2371
translate latin end_game2_92ad9a2c:

    # "My feet slide quietly across the rug and marble, leaving Amicus behind on the sofa."
    "Pedes mei tacite per tapetem et marmor labuntur, Amico post me in lectulo relicto."

# game/end_game2.rpy:2373
translate latin end_game2_09585107:

    # "{i}\"Apologies for the extended silence...\"{/i}"
    "{i}\"Ignosce diuturno silentio...\"{/i}"

# game/end_game2.rpy:2374
translate latin end_game2_3440caa5:

    # "But why?"
    "Sed cur?"

# game/end_game2.rpy:2375
translate latin end_game2_dca42e52:

    # "Who are you?"
    "Quis es?"

# game/end_game2.rpy:2376
translate latin end_game2_9ac078de:

    # "{i}\"You know me.\"{/i}"
    "{i}\"Me nosti.\"{/i}"

# game/end_game2.rpy:2378
translate latin end_game2_e679766b:

    # "I walk deliberately in the direction I know to go, my only distraction being the furious twitching in my left eyelid."
    "Consulto eo ambulo quo ire scio, sola palpebra sinistra vehementer tremens animum distrahens."

# game/end_game2.rpy:2380
translate latin end_game2_9d99a935:

    # "{i}\"You needed time to learn about yourself, to learn about the {i}Galaxias{/i}, to steel your resolve, and now you are ready to forge ahead.\"{/i}"
    "{i}\"Tempore opus erat ut de te ipso disceres, de {i}Galaxia{/i} disceres, ut propositum tuum firmares; nunc autem paratus es progredi.\"{/i}"

# game/end_game2.rpy:2382
translate latin end_game2_bcf6dd4d:

    # "No."
    "Non."

# game/end_game2.rpy:2384
translate latin end_game2_b6233d6a:

    # "{i}\"What?\"{/i}"
    "{i}\"Quid?\"{/i}"

# game/end_game2.rpy:2387
translate latin end_game2_6947da93:

    # mon "\"Would you like to glance through the eyes of the parents, to see what lies ahead?\""
    mon "\"Visne per oculos Parentum prospicere, ut videas quid ante te iaceat?\""

# game/end_game2.rpy:2388
translate latin end_game2_67aaa788:

    # "What?"
    "Quid?"

# game/end_game2.rpy:2389
translate latin end_game2_dfcc9b73:

    # "Something trembles under my feet."
    "Aliquid sub pedibus meis tremit."

# game/end_game2.rpy:2390
translate latin end_game2_fead4c8c:

    # "I sense someone else."
    "Alium sentio."

# game/end_game2.rpy:2391
translate latin end_game2_e5e3b81e:

    # mon "\"...\""
    mon "\"...\""

# game/end_game2.rpy:2392
translate latin end_game2_481f62e0:

    # "He does too."
    "Ille quoque."

# game/end_game2.rpy:2393
translate latin end_game2_4f965ec8:

    # "I move my mind towards the presence...towards {i}her{/i}."
    "Mentem meam ad praesentiam moveo...ad {i}illam{/i}."

# game/end_game2.rpy:2394
translate latin end_game2_c32b65ab:

    # mon "\"This way.\""
    mon "\"Hac via.\""

# game/end_game2.rpy:2395
translate latin end_game2_bcf6dd4d_1:

    # "No."
    "Non."

# game/end_game2.rpy:2396
translate latin end_game2_348adab7:

    # "He watches me, and for the first time, I sense something from the dragon that almost feels like worry."
    "Me spectat, et primum aliquid a dracone sentio quod paene sollicitudini simile est."

# game/end_game2.rpy:2397
translate latin end_game2_09f875f1:

    # mon "\"Don't be distracted by rogue entities, this is dangerous...\""
    mon "\"Ne ab entitatibus errantibus distraharis; hoc periculosum est...\""

# game/end_game2.rpy:2398
translate latin end_game2_c1aba2f1:

    # "What does that mean?"
    "Quid id significat?"

# game/end_game2.rpy:2399
translate latin end_game2_f8e44c12:

    # "But it doesn't matter, because I keep moving away."
    "Sed nihil refert, quia recedere pergo."

# game/end_game2.rpy:2402
translate latin end_game2_f4dc32c1:

    # "This presence, I know her."
    "Hanc praesentiam, eam novi."

# game/end_game2.rpy:2403
translate latin end_game2_20a4518f:

    # "She tried to contact me in the amalgamation."
    "Me in amalgamatione contingere conata est."

# game/end_game2.rpy:2404
translate latin end_game2_76a32cd7:

    # "She refused to mingle, she stayed separate."
    "Commisceri recusavit, separata mansit."

# game/end_game2.rpy:2405
translate latin end_game2_b250c582:

    # "And now, I can see her."
    "Et iam eam videre possum."

# game/end_game2.rpy:2406
translate latin end_game2_58f303ed:

    # "She appears before me."
    "Coram me apparet."

# game/end_game2.rpy:2408
translate latin end_game2_645c9371:

    # "She bows to me."
    "Mihi inclinat."

# game/end_game2.rpy:2409
translate latin end_game2_a077825f:

    # unk "\"Hello, my replacement. There is much to say.\""
    unk "\"Salve, qui mihi substitueris. Multa dicenda sunt.\""

# game/end_game2.rpy:2410
translate latin end_game2_f6a57508:

    # "I know her."
    "Eam novi."

# game/end_game2.rpy:2411
translate latin end_game2_7cd1acb3:

    # "Already, I know who this is."
    "Iam scio quis hic sit."

# game/end_game2.rpy:2412
translate latin end_game2_7905f008:

    # m "\"Meera.\""
    m "\"Meera.\""

# game/end_game2.rpy:2413
translate latin end_game2_3cb2199d:

    # me "\"Ah, so you do possess a notable level of intelligence.\""
    me "\"Ah, ita insignem intelligentiae gradum quidem habes.\""

# game/end_game2.rpy:2414
translate latin end_game2_fbb2fe16:

    # "I'm confused, unsure as to what's happening, {i}why{/i} it's happening."
    "Confusus sum, incertus quid fiat, {i}cur{/i} fiat."

# game/end_game2.rpy:2415
translate latin end_game2_f1f06139:

    # "I swallow, or at least I do mentally."
    "Deglutio, aut saltem mente facio."

# game/end_game2.rpy:2416
translate latin end_game2_2bd0777c:

    # "I still feel out-of-body, anchored to nothing."
    "Adhuc extra corpus meum esse sentio, nullo loco fixus."

# game/end_game2.rpy:2417
translate latin end_game2_b412417f:

    # "I'm just an observer from an indefinable point in space."
    "Tantum spectator sum ex puncto spatii quod definiri non potest."

# game/end_game2.rpy:2418
translate latin end_game2_30484fbf:

    # m "\"You...you say I'm a replacement?\""
    m "\"Tu...me substitutum esse dicis?\""

# game/end_game2.rpy:2419
translate latin end_game2_e0497e5d:

    # me "\"My replacement, yes. Though I suppose that label isn't entirely accurate...you're more of a successor.\""
    me "\"Substitutum meum, ita. Quamquam credo illud nomen non prorsus accuratum esse...potius successor es.\""

# game/end_game2.rpy:2420
translate latin end_game2_7d9f99ce:

    # "My concentration on summoning myself a body begins to yield some results as I see the outlines of my torso and legs below me."
    "Intentio mea corpus mihi evocandi aliquid efficere incipit, dum formas trunci et crurum meorum infra me video."

# game/end_game2.rpy:2421
translate latin end_game2_ba877dcb:

    # me "\"Though, my...inability to complete their requests has thrust some of those duties upon you. So yes, a successor, but also a replacement.\""
    me "\"Quamquam ego...petitiones eorum perficere non potui, quaedam ex illis officiis tibi imposita sunt. Ita certe successor es, sed etiam substitutus.\""

# game/end_game2.rpy:2422
translate latin end_game2_ad2ca24c:

    # "I finally materialize the majority of my body, solidifying its shape beneath my point of view."
    "Tandem maximam corporis mei partem in materiam redigo, formam eius infra locum unde prospicio solidans."

# game/end_game2.rpy:2423
translate latin end_game2_820917d3:

    # "I lift my hands to my face, and though they look tangible, there's also a dream-like quality to them, bending and moving in ways that don't seem real."
    "Manus ad vultum tollo et, quamquam tangi posse videntur, etiam aliquid somnii habent, flectentes et moventes modis qui veri non videntur."

# game/end_game2.rpy:2424
translate latin end_game2_e0781ba9:

    # "Meera is quiet, and I realize my focus isn't fully dedicated to her, though it should be."
    "Meera tacet, et intellego attentionem meam non plene ei dari, quamquam deberet."

# game/end_game2.rpy:2425
translate latin end_game2_6402fd69:

    # "I look up."
    "Suspicio."

# game/end_game2.rpy:2426
translate latin end_game2_7fb6a0c0:

    # m "\"Sorry, what was your assignment?\""
    m "\"Ignosce, quod erat munus tuum?\""

# game/end_game2.rpy:2427
translate latin end_game2_0506f4ca:

    # "She stares back at me for a while, brow furrowed, and I wonder if she's upset with me."
    "Me aliquamdiu vicissim fixis oculis intuetur, fronte contracta, et miror an mihi irata sit."

# game/end_game2.rpy:2428
translate latin end_game2_c614ff64:

    # me "\"Shall we adopt Khemian etiquette and get to the point quickly? I have a feeling my time with you will not be long.\""
    me "\"Mores Khemianos sumamus et celeriter ad rem veniamus? Sentio tempus meum tecum non longum fore.\""

# game/end_game2.rpy:2429
translate latin end_game2_7c265d8b:

    # m "\"S—sure.\""
    m "\"C-certe.\""

# game/end_game2.rpy:2430
translate latin end_game2_3f96ea03:

    # me "\"Splendid. So, [mc], do you trust the parents?\""
    me "\"Optime. Ita, [mc], Parentibusne confidis?\""

# game/end_game2.rpy:2431
translate latin end_game2_ac94747a:

    # m "\"Huh?\""
    m "\"Hem?\""

# game/end_game2.rpy:2432
translate latin end_game2_7519979b:

    # "I heard her well enough, I just don't know how I should answer the question."
    "Satis bene eam audivi, tantum nescio quomodo quaestioni respondere debeam."

# game/end_game2.rpy:2433
translate latin end_game2_41ba960e:

    # me "\"I said, do you trust the parents?\""
    me "\"Dixi, Parentibusne confidis?\""

# game/end_game2.rpy:2434
translate latin end_game2_73fa2339:

    # m "\"Yeah...mostly.\""
    m "\"Ita...plerumque.\""

# game/end_game2.rpy:2435
translate latin end_game2_b3443d55:

    # "I say that because I'm pretty sure the parents are listening right now."
    "Id dico quia satis certus sum Parentes nunc auscultare."

# game/end_game2.rpy:2436
translate latin end_game2_d665883e:

    # "For the past several months I've been trying to smother the questioning thoughts that I've had, the worry that I'm being kept from the full truth."
    "Per proximos aliquot menses cogitationes dubitantes quas habui opprimere conatus sum, timorem me a plena veritate arceri."

# game/end_game2.rpy:2437
translate latin end_game2_2a218be3:

    # "That's mainly because I don't want to jeopardize Amicus's plans, his future goals."
    "Id praecipue quia consilia Amici, proposita eius futura, periculo exponere nolo."

# game/end_game2.rpy:2438
translate latin end_game2_bd62d050:

    # "He knows much more about the parents than I do, and though he has his reservations after what happened to me, I think he trusts them."
    "Multo plus de Parentibus scit quam ego, et quamquam post ea quae mihi acciderunt dubitationes habet, puto eum eis confidere."

# game/end_game2.rpy:2439
translate latin end_game2_4e75bf9e:

    # "And because I trust Amicus, I guess I trust the parents as well."
    "Et quia Amico confido, credo me Parentibus quoque confidere."

# game/end_game2.rpy:2440
translate latin end_game2_115eefcd:

    # "...Sort of.\""
    "...Aliquatenus.\""

# game/end_game2.rpy:2441
translate latin end_game2_33af90c5:

    # me "\"You're not a very good liar, are you, [mc]?\""
    me "\"Non valde bene mentiris, nonne, [mc]?\""

# game/end_game2.rpy:2442
translate latin end_game2_e0694995:

    # m "\"I'm not lyin—\""
    m "\"Non mentior...\""

# game/end_game2.rpy:2443
translate latin end_game2_e1eb7721:

    # me "\"Do you know what my fate was, [mc]?\""
    me "\"Scisne quae sors mea fuerit, [mc]?\""

# game/end_game2.rpy:2444
translate latin end_game2_fe10ab79_1:

    # m "\"Uh...\""
    m "\"Eh...\""

# game/end_game2.rpy:2445
translate latin end_game2_5c72397c:

    # "I think back, trying to remember the full story."
    "Retro cogito, totam historiam meminisse conans."

# game/end_game2.rpy:2446
translate latin end_game2_7d69404a:

    # m "\"You committed suicide...to force Drusus into a choice...right?\""
    m "\"Te ipsa occidisti...ut Drusum eligere cogeres...nonne?\""

# game/end_game2.rpy:2447
translate latin end_game2_4d534806:

    # "The tigress continues to look at me with that piercing gaze."
    "Tigris me illo penetrante obtutu intueri pergit."

# game/end_game2.rpy:2448
translate latin end_game2_34b24e93:

    # "I start to become more uncomfortable."
    "Magis incommodus fieri incipio."

# game/end_game2.rpy:2449
translate latin end_game2_0738d2c5:

    # m "\"Listen, you had a lot to say, right? What is it?\""
    m "\"Audi, multa dicenda habebas, nonne? Quae sunt?\""

# game/end_game2.rpy:2450
translate latin end_game2_46b0b569:

    # me "\"[mc], what does it mean to be a sapient?\""
    me "\"[mc], quid est Sapientem esse?\""

# game/end_game2.rpy:2451
translate latin end_game2_cec87f76:

    # "I sigh, starting to get annoyed with how little explanation I'm getting."
    "Suspiro, vexari incipiens quod tam parum explicationis accipio."

# game/end_game2.rpy:2452
translate latin end_game2_f5bb2416:

    # "I shouldn't be the one answering questions."
    "Non ego esse debeo qui quaestionibus respondeat."

# game/end_game2.rpy:2453
translate latin end_game2_7ce305a1:

    # m "\"I don't know, to be self-aware?\""
    m "\"Nescio, sui ipsius conscium esse?\""

# game/end_game2.rpy:2454
translate latin end_game2_db27f46e:

    # "Meera laughs, and there's an odd, growling quality to it."
    "Meera ridet, et mirus quidam fremitus in risu est."

# game/end_game2.rpy:2455
translate latin end_game2_1dbd4396:

    # me "\"If that were true, then my lover would not have been considered a sapient.\""
    me "\"Si id verum esset, amans meus Sapiens habitus non esset.\""

# game/end_game2.rpy:2456
translate latin end_game2_b00d2cb5:

    # "Lover."
    "Amans."

# game/end_game2.rpy:2457
translate latin end_game2_fea0e1d4:

    # "I wonder if Drusus is here with her."
    "Miror an Drusus hic cum ea sit."

# game/end_game2.rpy:2458
translate latin end_game2_3b852ff9:

    # "I hope so, because if I end up like her, I'd still want to be with Amicus."
    "Spero ita, quia, si mihi tandem idem accidit ac ei, adhuc cum Amico esse velim."

# game/end_game2.rpy:2459
translate latin end_game2_0a8f0afc:

    # "The tigress adjusts her sari, pushing it back slightly to reveal more of her striped face."
    "Tigris vestem sari componit, paulum retrudens ut plus vultus sui striati patefaciat."

# game/end_game2.rpy:2460
translate latin end_game2_60750310:

    # me "\"But that is certainly part of being sapient, though I suppose my question should be more broad: what does it mean to be alive?\""
    me "\"Sed id certe ad Sapientis naturam pertinet, quamquam credo quaestionem meam latiorem esse debere: quid est vivere?\""

# game/end_game2.rpy:2461
translate latin end_game2_504133b1:

    # "I sigh, opening my mouth to tell her I don't know before Meera answers anyway."
    "Suspiro, os aperiens ut ei dicam me nescire, antequam Meera tamen respondet."

# game/end_game2.rpy:2462
translate latin end_game2_0f9413e8:

    # me "\"Agency, the ability to make your own decisions.\""
    me "\"Potestas agendi, facultas tua ipsius consilia capiendi.\""

# game/end_game2.rpy:2463
translate latin end_game2_04650e3e:

    # "The tigress becomes serious once again."
    "Tigris rursus gravis fit."

# game/end_game2.rpy:2464
translate latin end_game2_669e43ba:

    # me "\"Consider that the parents claim to hold life above all else in the universe.\""
    me "\"Cogita Parentes dicere se vitam ceteris omnibus rebus in universo praeferre.\""

# game/end_game2.rpy:2465
translate latin end_game2_b52e58f2:

    # me "\"With that in mind, does the concept of what it means to be alive merge with the goals of the parents? Does it merge with what they are doing to you?\""
    me "\"Hoc in mente habens, congruitne notio eius quod vivere significat cum propositis Parentum? Congruitne cum iis quae tibi faciunt?\""

# game/end_game2.rpy:2466
translate latin end_game2_cbc0f624:

    # "Now I see where she's going with this."
    "Iam video quo hac re tendat."

# game/end_game2.rpy:2467
translate latin end_game2_9facef06:

    # m "\"I don't have a choice.\""
    m "\"Eligere non possum.\""

# game/end_game2.rpy:2468
translate latin end_game2_66acc4df:

    # "The tigress pauses, and I think I see her smirk a little."
    "Tigris paulisper tacet, et puto me eam paulum subridentem videre."

# game/end_game2.rpy:2469
translate latin end_game2_856a4d71:

    # me "\"No, you do not. Now, they attempt to right this fallacy by re-establishing choice, by telling you that you do not have to follow their guidance.\""
    me "\"Non, non potes. Nunc hanc fallaciam corrigere conantur, electionem restituendo, dicendo tibi non necesse esse ductum eorum sequi.\""

# game/end_game2.rpy:2470
translate latin end_game2_f1ca2b3f:

    # me "\"But in my experience, the alternative was a scenario which threatened my very life, a sapient life which they claim to hold dear.\""
    me "\"Sed in mea experientia altera via fuit condicio quae ipsi vitae meae minabatur, vitae Sapienti quam dicunt se caram habere.\""

# game/end_game2.rpy:2471
translate latin end_game2_7031ea03:

    # "I think of Amicus's choice, a choice which wasn't really a choice at all for the wolf."
    "De electione Amici cogito, electione quae lupo re vera nulla electio erat."

# game/end_game2.rpy:2472
translate latin end_game2_d5e5e77e:

    # me "\"How can they proclaim themselves benevolent if they threaten the life of the individuals they manipulate?\""
    me "\"Quomodo se benignos proclamare possunt, si vitae eorum minantur quos regunt?\""

# game/end_game2.rpy:2473
translate latin end_game2_0f979164:

    # me "\"How is that even possible when they use our very lives to manipulate the ones we love?\""
    me "\"Quomodo id omnino fieri potest, cum ipsis vitis nostris utantur ad eos regendos quos amamus?\""

# game/end_game2.rpy:2474
translate latin end_game2_cd938aab_1:

    # "I grimace."
    "Vultum contraho."

# game/end_game2.rpy:2475
translate latin end_game2_c17a2a72:

    # "It's almost like this tiger is reading my mind."
    "Paene est quasi haec tigris mentem meam legat."

# game/end_game2.rpy:2476
translate latin end_game2_6b474037:

    # me "\"I could not stand for it, thus here I am.\""
    me "\"Id pati non potui, itaque hic sum.\""

# game/end_game2.rpy:2477
translate latin end_game2_51231553:

    # m "\"They...try not to interfere—\""
    m "\"Conantur...se non immiscere...\""

# game/end_game2.rpy:2478
translate latin end_game2_cad7a89d:

    # me "\"They say they don't want to interfere, yet they've set plans into motion to take power from the empire and govern the siblings directly.\""
    me "\"Dicunt se immiscere nolle, et tamen consilia agere coeperunt ad potestatem imperio auferendam et Fratres directe regendos.\""

# game/end_game2.rpy:2479
translate latin end_game2_61f958ee_1:

    # "I stare."
    "Eum fixis oculis intueor."

# game/end_game2.rpy:2480
translate latin end_game2_5080be28:

    # m "\"How do you know this?\""
    m "\"Unde hoc scis?\""

# game/end_game2.rpy:2481
translate latin end_game2_c7107a1d:

    # "The tiger glares."
    "Tigris iratis oculis intuetur."

# game/end_game2.rpy:2482
translate latin end_game2_8f09ace8:

    # me "\"I was privy to every one of their plans, even those 10,000 years into the future.\""
    me "\"Omnia eorum consilia mihi patebant, etiam quae ad futurum post 10,000 annos pertinebant.\""

# game/end_game2.rpy:2483
translate latin end_game2_2a15deac:

    # "I try to comprehend that, but then shake my head."
    "Id comprehendere conor, sed tum caput quatio."

# game/end_game2.rpy:2484
translate latin end_game2_8889b80d:

    # m "\"But isn't their goal not to interfere at all? They're just trying to set us on the right path. Taking full control would go against everything they say.\""
    m "\"Sed nonne propositum eorum est se omnino non immiscere? Tantum in recta via nos collocare conantur. Plenam potestatem sumere omnibus quae dicunt repugnaret.\""

# game/end_game2.rpy:2485
translate latin end_game2_472d57ec:

    # me "\"So they say. Yet they are stepping in to directly control your every move, your thoughts. Soon it will be the entire {i}Galaxias{/i}.\""
    me "\"Ita dicunt. Tamen interveniunt ut singulos motus tuos, cogitationes tuas, directe regant. Mox tota {i}Galaxias{/i} erit.\""

# game/end_game2.rpy:2486
translate latin end_game2_117526a8:

    # "I shake my head again, but Meera goes on."
    "Caput rursus quatio, sed Meera pergit."

# game/end_game2.rpy:2487
translate latin end_game2_8fa0dee8:

    # me "\"Did you ever wonder why the intel you gathered on Cato's sabotage of the emperor's ship was never utilized, seemingly pressed to the back of the minds of all who knew of it?\""
    me "\"Umquam miratus es cur notitiae quas collegisti de Catonis insidiis in navem imperatoris numquam adhibitae sint, quasi in posteriorem mentis partem omnium qui sciebant pressae?\""

# game/end_game2.rpy:2488
translate latin end_game2_81c4a6f4:

    # me "\"Information that could have brought an end to the struggle in a much more peaceful process.\""
    me "\"Notitiae quae certamen multo pacatiore modo finire potuissent.\""

# game/end_game2.rpy:2489
translate latin end_game2_284e39d7:

    # "I narrow my gaze on the tiger, starting to feel uncomfortable."
    "Contractis oculis tigrem intueor, incommodus fieri incipiens."

# game/end_game2.rpy:2490
translate latin end_game2_81279e08:

    # me "\"Why did you hand the goblet to Cassius, despite knowing what would follow?\""
    me "\"Cur poculum Cassio dedisti, quamquam sciebas quid sequeretur?\""

# game/end_game2.rpy:2492
translate latin end_game2_21381742:

    # "Now I start to really feel uneasy, looking carefully at the tigress."
    "Iam vere sollicitus fieri incipio, tigrem caute intuens."

# game/end_game2.rpy:2493
translate latin end_game2_8ecb86e8:

    # m "\"How do you know this? Are you watching me?\""
    m "\"Unde hoc scis? Me spectasne?\""

# game/end_game2.rpy:2494
translate latin end_game2_cbea3359:

    # "Meera's image seems to quiver."
    "Imago Meerae tremere videtur."

# game/end_game2.rpy:2495
translate latin end_game2_52a9ceb5:

    # me "\"{i}I am always watching.{/i}\""
    me "\"{i}Semper specto.{/i}\""

# game/end_game2.rpy:2497
translate latin end_game2_14ab4db5:

    # me "\"{i}I lurk outside your windows as you work. I sit in your closet, listening to you breathe as you sleep. I creep up upon your bed, willing you to die...{/i}\""
    me "\"{i}Extra fenestras tuas latito dum laboras. In armario tuo sedeo, spiritum tuum audiens dum dormis. In lectum tuum serpo, volens te mori...{/i}\""

# game/end_game2.rpy:2498
translate latin end_game2_f1e91418:

    # "Her voice takes on an odd tone, becoming muffled, staticky, like it's coming through a phone's speaker."
    "Vox eius mirum sonum accipit, submissa et crepitans fit, quasi per telephonii megaphonum veniat."

# game/end_game2.rpy:2499
translate latin end_game2_4e3b60f1:

    # "Yet it grows louder."
    "Tamen sonorior fit."

# game/end_game2.rpy:2500
translate latin end_game2_df8ec4bc_3:

    # m "\"What?\""
    m "\"Quid?\""

# game/end_game2.rpy:2502
translate latin end_game2_aa425faa:

    # "The back of my neck prickles, the hairs rising as Meera begins to disappear."
    "Cervicis posterior pars mihi pungitur, pilis erectis dum Meera evanescere incipit."

# game/end_game2.rpy:2504
translate latin end_game2_935cca7d:

    # "The space around me pulses, then fades out slowly as well."
    "Spatium circum me pulsat, deinde ipsum quoque lente evanescit."

# game/end_game2.rpy:2505
translate latin end_game2_5f2f81f5:

    # unk "\"{i}Do you want to know what death is like?{/i}\""
    unk "\"{i}Scire vis quale sit mori?{/i}\""

# game/end_game2.rpy:2506
translate latin end_game2_9bfd2c89:

    # "Meera's voice isn't her voice anymore...it's a cacophony of whispers and rustling, like a writhing pile of dead leaves."
    "Vox Meerae iam vox eius non est...confusa copia susurrorum et crepituum est, quasi acervus foliorum mortuorum se torquens."

# game/end_game2.rpy:2507
translate latin end_game2_9383a979:

    # unk "\"{i}I still taste the poison in my mouth, the agony in my body, the terror of dissolving into nothing.{/i}\""
    unk "\"{i}Adhuc venenum in ore meo gusto, dolorem in corpore meo, terrorem in nihil dissolvendi.{/i}\""

# game/end_game2.rpy:2508
translate latin end_game2_a93b46c2:

    # "The whispers move behind me, up my neck."
    "Susurri post me moventur, per cervicem sursum."

# game/end_game2.rpy:2509
translate latin end_game2_9266847e:

    # unk "\"{i}A nothingness that was simultaneously something, forced to be tormented in the hell of non-existence, of never-ending black.{/i}\""
    unk "\"{i}Nihil quod simul aliquid erat, coactum cruciari in inferno non exsistendi, nigri sine fine.{/i}\""

# game/end_game2.rpy:2510
translate latin end_game2_a457ac89:

    # "Is it talking about the amalgamation?"
    "De amalgamatione loquiturne?"

# game/end_game2.rpy:2511
translate latin end_game2_4ee20909:

    # "The voice chuckles, whipping up a vortex of dried leaves."
    "Vox subridet, vorticem foliorum siccatorum concitans."

# game/end_game2.rpy:2512
translate latin end_game2_c79267c8:

    # unk "\"{i}The Amalgamation...even you know how unnatural its existence is. A swirl of countless souls being harvested by the parents, to be used...{/i}\""
    unk "\"{i}Amalgamatio...etiam tu scis quam praeter naturam exsistat. Vortex innumerarum animarum quas Parentes metunt, ad usum...{/i}\""

# game/end_game2.rpy:2513
translate latin end_game2_72aaa430:

    # "I start to try and pull away from this thing, this creature that is no longer Meera."
    "Ab hac re, ab hac creatura quae iam Meera non est, recedere conari incipio."

# game/end_game2.rpy:2514
translate latin end_game2_f2109e1d:

    # unk "\"{i}You will experience it soon enough, the horror of it all.{/i}\""
    unk "\"{i}Satis mox id experieris, totius rei horrorem.{/i}\""

# game/end_game2.rpy:2515
translate latin end_game2_0602b77c:

    # "Something begins to wrap around my neck, the pressure growing."
    "Aliquid collum meum circumdare incipit, pressione crescente."

# game/end_game2.rpy:2516
translate latin end_game2_f8992974:

    # unk "\"{i}But don't worry. You won't be alone.{/i}\""
    unk "\"{i}Sed ne time. Solus non eris.{/i}\""

# game/end_game2.rpy:2517
translate latin end_game2_de58c136:

    # unk "\"{i}You will suffer together...{/i}\""
    unk "\"{i}Una patiemini...{/i}\""

# game/end_game2.rpy:2518
translate latin end_game2_aad8e3b2:

    # unk "\"{i}...With your wolf...{/i}\""
    unk "\"{i}...Cum lupo tuo...{/i}\""

# game/end_game2.rpy:2519
translate latin end_game2_cdb90bad:

    # unk "\"{i}Forever.{/i}\""
    unk "\"{i}In aeternum.{/i}\""

# game/end_game2.rpy:2520
translate latin end_game2_a20cefa7_2:

    # "..."
    "..."

# game/end_game2.rpy:2521
translate latin end_game2_a20cefa7_3:

    # "..."
    "..."

# game/end_game2.rpy:2522
translate latin end_game2_a20cefa7_4:

    # "..."
    "..."

# game/end_game2.rpy:2524
translate latin end_game2_3d25e24b:

    # mon "\"Enough.\""
    mon "\"Satis.\""

# game/end_game2.rpy:2525
translate latin end_game2_adc363d8:

    # "A strong, solid voice breaks through the smothering terror, and I cling to it immediately."
    "Fortis et firma vox per suffocantem terrorem penetrat, et statim ei haereo."

# game/end_game2.rpy:2526
translate latin end_game2_a9a74605:

    # "As if being pulled from a deep pool of water, I emerge from the black, back into the dazzling glimmers of space."
    "Quasi e profundo aquae stagno tractus, e nigro emergo, rursus in splendidos micatus spatii."

# game/end_game2.rpy:2528
translate latin end_game2_2720a3b0:

    # "I gasp for breath, even though I have no lungs to gasp into."
    "Spiritum avide haurio, quamquam nullos pulmones habeo qui eum hauriant."

# game/end_game2.rpy:2529
translate latin end_game2_658294b4:

    # "The monitor looms before me, exuding a stifled combination of frustration and concern."
    "Monitor coram me eminet, mixtas vexationem et sollicitudinem temperate effundens."

# game/end_game2.rpy:2530
translate latin end_game2_aa6b536c:

    # mon "\"Are you alright, [mc]?\""
    mon "\"Valesne, [mc]?\""

# game/end_game2.rpy:2531
translate latin end_game2_dde57a18:

    # "The fear I've had lingers, but I'm able to steady my nerves enough to talk."
    "Metus quem habui manet, sed nervos satis sedare possum ut loquar."

# game/end_game2.rpy:2532
translate latin end_game2_d2e8e108:

    # m "\"What the hell was that?\""
    m "\"Quid malum erat illud?\""

# game/end_game2.rpy:2533
translate latin end_game2_c0476d9f:

    # "The monitor stares at me for a while, thinking, contemplating something."
    "Monitor me aliquamdiu fixis oculis intuetur, cogitans, aliquid considerans."

# game/end_game2.rpy:2534
translate latin end_game2_8862a855:

    # mon "\"The Other.\""
    mon "\"Alterum.\""

# game/end_game2.rpy:2535
translate latin end_game2_3c749590:

    # "I'd already suspected that, but to have it confirmed makes my heart sink."
    "Id iam suspicatus eram, sed confirmatum cor mihi quasi deicit."

# game/end_game2.rpy:2536
translate latin end_game2_e6c9c70d:

    # m "\"I was told it wasn't here yet.\""
    m "\"Mihi dictum est illud nondum hic esse.\""

# game/end_game2.rpy:2537
translate latin end_game2_95715998:

    # mon "\"Where you are now is not where you used to be.\""
    mon "\"Ubi nunc es non est ubi solebas esse.\""

# game/end_game2.rpy:2538
translate latin end_game2_733a7a75:

    # m "\"But...why was it Meera?\""
    m "\"Sed...cur Meera erat?\""

# game/end_game2.rpy:2539
translate latin end_game2_2b4a3e96:

    # mon "\"It can take any forms its host can imagine...speak any words its host might imagine...\""
    mon "\"Quascumque formas sumere potest quas hospes eius fingere potest...quaecumque verba dicere quae hospes eius fingere possit...\""

# game/end_game2.rpy:2540
translate latin end_game2_ac03bc5d:

    # "The dragon looks pointedly at me here."
    "Hic draco me significanter intuetur."

# game/end_game2.rpy:2541
translate latin end_game2_94b213b1:

    # m "\"Host?\""
    m "\"Hospes?\""

# game/end_game2.rpy:2542
translate latin end_game2_fbd3648e:

    # "I sense something like a sigh from the reptile."
    "Aliquid suspirio simile a reptili sentio."

# game/end_game2.rpy:2543
translate latin end_game2_b8f81c00:

    # mon "\"You were the host, it was simply using your doubts against you.\""
    mon "\"Tu hospes eras; tantum dubitationibus tuis adversus te utebatur.\""

# game/end_game2.rpy:2544
translate latin end_game2_e80293df:

    # "I think, trying to remember everything Meera...the Other, had said."
    "Cogito, omnia meminisse conans quae Meera...Alterum dixerat."

# game/end_game2.rpy:2545
translate latin end_game2_a5304c56:

    # "Something still doesn't feel right."
    "Aliquid adhuc rectum non sentio."

# game/end_game2.rpy:2546
translate latin end_game2_c17dde80:

    # "She definitely didn't feel like something I could just think up, and the things she was saying, like about the Amalgamation, I'd never thought those things before."
    "Illa certe non similis alicui quod tantum excogitare possem sentiebatur, et illa quae dicebat, velut de Amalgamatione, numquam antea cogitaveram."

# game/end_game2.rpy:2547
translate latin end_game2_326e658a:

    # mon "\"Many thoughts are subconscious.\""
    mon "\"Multae cogitationes extra conscientiam sunt.\""

# game/end_game2.rpy:2548
translate latin end_game2_366de2d8:

    # "I wonder if Meera is still out there with the other."
    "Miror an Meera adhuc illic cum Altero sit."

# game/end_game2.rpy:2549
translate latin end_game2_cd05c0f7:

    # mon "\"The true Meera is in the Amalgamation, and though she may have come up short in her duties, she still rests happily with Drusus.\""
    mon "\"Vera Meera in Amalgamatione est, et quamquam officiis suis fortasse defuit, adhuc laete cum Druso quiescit.\""

# game/end_game2.rpy:2550
translate latin end_game2_37811be7:

    # "Yet I can't help but feel that must have been part of Meera, a mixture of doubts between me and her."
    "Tamen non possum quin sentiam id partem Meerae fuisse debere, mixturam dubitationum inter me et eam."

# game/end_game2.rpy:2551
translate latin end_game2_98501db0:

    # "Can the other store bits of memory of people that it's come into contact with?"
    "Potestne Alterum partes memoriae eorum servare quos attigit?"

# game/end_game2.rpy:2552
translate latin end_game2_6da05f46:

    # mon "\"Do not worry yourself over things that do not currently matter. What matters now is your doubts.\""
    mon "\"Ne de rebus solliciteris quae nunc nihil valent. Quod nunc valet sunt dubitationes tuae.\""

# game/end_game2.rpy:2553
translate latin end_game2_c57e4d0c:

    # "Despite what I've just been through, I feel a flare of irritation at the dragon's nonchalant attitude."
    "Quamquam illa omnia modo passus sum, irae impetum ob neglegentem draconis habitum sentio."

# game/end_game2.rpy:2554
translate latin end_game2_355c4259:

    # "Even if that was the Other that brought it out of me, at least now my worries are out in the open."
    "Etiamsi Alterum id e me elicuit, saltem iam sollicitudines meae apertae sunt."

# game/end_game2.rpy:2555
translate latin end_game2_4915e3bc:

    # m "\"Well, you heard my doubts. What do you have to say about them?\""
    m "\"Bene, dubitationes meas audivisti. Quid de eis dicendum habes?\""

# game/end_game2.rpy:2556
translate latin end_game2_de23b58a:

    # "The monitor bows his head slowly, closing his eyes."
    "Monitor caput lente inclinat, oculos claudens."

# game/end_game2.rpy:2557
translate latin end_game2_30191d32:

    # mon "\"It is worrying.\""
    mon "\"Sollicitudinem movet.\""

# game/end_game2.rpy:2558
translate latin end_game2_8325385b:

    # m "\"Is it? Well, now you know how I've felt the past year.\""
    m "\"Movetne? Bene, iam scis quomodo per annum proximum senserim.\""

# game/end_game2.rpy:2559
translate latin end_game2_9c6302d6:

    # "I'm defiant, even though I'm scared."
    "Contumax sum, quamquam timeo."

# game/end_game2.rpy:2560
translate latin end_game2_6da7d68c:

    # "I might have just screwed up Amicus's destiny if they know what I think now."
    "Fortasse modo fatum Amici corrupi, si iam sciunt quid cogitem."

# game/end_game2.rpy:2561
translate latin end_game2_a73e1e75:

    # mon "\"We've always known. We had simply hoped that those feelings would fade with time.\""
    mon "\"Semper scivimus. Tantum sperabamus illos affectus tempore evanituros esse.\""

# game/end_game2.rpy:2562
translate latin end_game2_e852c5fd:

    # m "\"By just not saying anything on your end? I have no idea what's going on.\""
    m "\"Vos tantum nihil dicendo? Nescio quid fiat.\""

# game/end_game2.rpy:2563
translate latin end_game2_1b6363b0:

    # mon "\"We mustn't interfere—\""
    mon "\"Nos immiscere non debemus...\""

# game/end_game2.rpy:2564
translate latin end_game2_a127e1cd:

    # m "\"I don't care. If you don't start telling me what I'm doing, and why, then I'm gonna follow Meera.\""
    m "\"Non curo. Si mihi dicere non incipitis quid faciam et cur, Meeram sequar.\""

# game/end_game2.rpy:2565
translate latin end_game2_dfcc7c61:

    # m "\"You care about choice? I'm making my choice now; either you tell me, or I walk out.\""
    m "\"Electionem curatis? Nunc eligo: aut mihi dicitis, aut discedo.\""

# game/end_game2.rpy:2566
translate latin end_game2_47a0e9bd:

    # "I'm bluffing, but only partly."
    "Minas fingo, sed tantum partim."

# game/end_game2.rpy:2567
translate latin end_game2_84739834:

    # "There's a small bit of me that is determined to follow through on that, and I think the Monitor senses it too."
    "Parva pars mei id perficere constituit, et puto Monitorem quoque sentire."

# game/end_game2.rpy:2568
translate latin end_game2_dc6059dd:

    # "I'm just done."
    "Mihi tantum satis est."

# game/end_game2.rpy:2569
translate latin end_game2_52a08222:

    # "Again, that big, heaving sigh."
    "Iterum magnum illud et grave suspirium."

# game/end_game2.rpy:2570
translate latin end_game2_cdbb4cc1:

    # mon "\"Providing you with knowledge ahead of schedule makes our ability to see blurry.\""
    mon "\"Scientiam tibi ante tempus praebere facultatem nostram videndi obscurat.\""

# game/end_game2.rpy:2571
translate latin end_game2_8619f2c6_5:

    # "I shrug."
    "Umeros tollo."

# game/end_game2.rpy:2572
translate latin end_game2_585e2e0e:

    # m "\"Better than me just leaving, right? Now tell me about your future plans, the amalgamation, why your moral compass is so fucked up.\""
    m "\"Melius quam me tantum discedere, nonne? Nunc mihi dicite de consiliis vestris futuris, amalgamatione, cur iudicium vestrum de moribus tam corruptum sit.\""

# game/end_game2.rpy:2573
translate latin end_game2_cf54a392:

    # "A typical pause."
    "Solita mora."

# game/end_game2.rpy:2574
translate latin end_game2_0d1c29f8:

    # mon "\"I'm sorry, but we cannot reveal everything to you, at least not yet...but we can at least tell you the plan we have set forth for you.\""
    mon "\"Doleo, sed omnia tibi revelare non possumus, saltem nondum...sed saltem consilium quod tibi proposuimus dicere possumus.\""

# game/end_game2.rpy:2575
translate latin end_game2_dbf6831f:

    # "I'm relieved, and a little surprised that I got the parents to do something that I want for a change."
    "Relevatus sum et paulum miratus quod tandem Parentes aliquid quod ego volo facere feci."

# game/end_game2.rpy:2576
translate latin end_game2_ae3f25e7:

    # mon "\"Do not get used to it. Trust me, they do not do this often.\""
    mon "\"Ne assuescas. Mihi crede, non saepe hoc faciunt.\""

# game/end_game2.rpy:2577
translate latin end_game2_f19555b0:

    # "I shrug, trying not to feel too smug that I just figured out that I hold a good deal of power myself."
    "Umeros levo, conans ne nimis mihi placeam quod modo intellexi me quoque satis multum potestatis habere."

# game/end_game2.rpy:2578
translate latin end_game2_25bb0f11:

    # "The parents struggle between wanting to appear benevolent while also wanting to force their subjects into specific roles leaves them at a bit of a disadvantage with me."
    "Luctatio Parentum, qui benigni videri volunt sed etiam subiectos suos in certas partes cogere, eos in paulum iniqua condicione adversus me ponit."

# game/end_game2.rpy:2579
translate latin end_game2_1895812e:

    # "The Monitor seems to choose not to comment on that thought process."
    "Monitor hanc cogitationem non commentari eligere videtur."

# game/end_game2.rpy:2580
translate latin end_game2_795b756b:

    # "I focus back on him."
    "In eum rursus intentus sum."

# game/end_game2.rpy:2581
translate latin end_game2_27516b03:

    # m "\"So what is it that I'm doing and why?\""
    m "\"Quid igitur facio et cur?\""

# game/end_game2.rpy:2585
translate latin end_game2_1a224131:

    # "I come to slowly on the floor, under the archives."
    "Lente ad me redeo in pavimento sub tabulario."

# game/end_game2.rpy:2587
translate latin end_game2_475cc359:

    # "My vision is blurry."
    "Visus meus turbatus est."

# game/end_game2.rpy:2588
translate latin end_game2_821eaa91:

    # "For the first time, I feel somewhat confident."
    "Primum aliquantum confidens sum."

# game/end_game2.rpy:2589
translate latin end_game2_fa0a25d7:

    # "Having the entire Earth plan laid out before me has made everything make so much more sense."
    "Totum consilium Terrae ante me explicatum fecit ut omnia multo facilius intellegerentur."

# game/end_game2.rpy:2590
translate latin end_game2_b316b8c5:

    # "Still, the experience I had with the Other, it's left me paranoid, and worried."
    "Tamen experientia quam cum Altero habui me suspiciosum et sollicitum reliquit."

# game/end_game2.rpy:2591
translate latin end_game2_2dd7e9c5:

    # "I refuse to believe that everything that came out of its mouth was all from my own mind."
    "Credere recuso omnia quae ex ore eius venerunt tota e mente mea esse."

# game/end_game2.rpy:2592
translate latin end_game2_7efe2cbc:

    # "There was something more, things that I can only imagine Meera had said herself."
    "Aliquid amplius erat, res quas tantum ipsam Meeram dixisse fingere possum."

# game/end_game2.rpy:2593
translate latin end_game2_a4126921:

    # "Maybe it wasn't to me at that moment, maybe it was simply words she had said in the past, brought to the present by the Other."
    "Fortasse non mihi illo momento dictum est; fortasse tantum verba erant quae olim dixerat, ab Altero in praesens adducta."

# game/end_game2.rpy:2594
translate latin end_game2_28976f0b:

    # "Either way, I'm going along with the plan, but knowing what I'm doing and why has made me feel much more in control."
    "Quidquid est, consilium sequor, sed scire quid faciam et cur fecit ut me multo magis rerum dominum sentiam."

# game/end_game2.rpy:2595
translate latin end_game2_5193296d:

    # "I can even reject certain tasks that they might give me in advance, force them to come up with another way."
    "Etiam quaedam munera quae mihi dare possint antea recusare possum, eos cogens aliam viam excogitare."

# game/end_game2.rpy:2596
translate latin end_game2_b3c0ac92:

    # "This new dynamic feels closer to true agency."
    "Haec nova ratio verae potestati agendi propior sentitur."

# game/end_game2.rpy:2597
translate latin end_game2_1154b4d0:

    # "I was able to tell that the monitor, and thus the parents, were unhappy about it."
    "Intellegere potui Monitorem et ideo Parentes de eo non laetos esse."

# game/end_game2.rpy:2598
translate latin end_game2_e128aa52:

    # "Still, I can't help but feel that this new-found sense of power on my end is going to make my life a lot easier, even if it makes theirs harder."
    "Tamen non possum quin sentiam hunc novum potestatis meae sensum vitam meam multo faciliorem facturum esse, etiamsi eorum difficiliorem faciat."

# game/end_game2.rpy:2599
translate latin end_game2_edf49843:

    # "I get up slowly, a smile on my face, feeling good for once."
    "Lente surgo, risu in vultu, tandem bene sentiens."

# game/end_game2.rpy:2600
translate latin end_game2_17031719:

    # "I make my way to the door, pressing the panel."
    "Ad ianuam venio, tabulam premens."

# game/end_game2.rpy:2605
translate latin end_game2_7ffbd8ab:

    # "I take a deep breath, feeling the cool, fragrant night air against my face."
    "Alte spiritum haurio, frigidum fragrantemque noctis aerem in vultu meo sentiens."

# game/end_game2.rpy:2606
translate latin end_game2_7c3b44ec:

    # "I stand there a moment, enjoying the feeling on level ground with the {i}Galaxias{/i}."
    "Ibi paulisper sto, fruens sensu me in aequo cum {i}Galaxias{/i} esse."

# game/end_game2.rpy:2607
translate latin end_game2_a0e85fe6:

    # "I'm so lost in this feeling of relief that I barely notice footsteps up the hall."
    "In hoc levamine tam demersus sum ut vix passus in porticu animadvertam."

# game/end_game2.rpy:2608
translate latin end_game2_8aa4ee51:

    # "Then voices."
    "Deinde voces."

# game/end_game2.rpy:2609
translate latin end_game2_c1aa0031:

    # "Laughing and talking."
    "Ridentes et loquentes."

# game/end_game2.rpy:2610
translate latin end_game2_4f3ee4e2:

    # "I just stand in the doorway, suddenly recognizing those voices."
    "Tantum in limine sto, subito illas voces agnoscens."

# game/end_game2.rpy:2611
translate latin end_game2_6d277516:

    # al "\"Cassius, stop! We need to be quiet.\""
    al "\"Cassi, desine! Quieti esse debemus.\""

# game/end_game2.rpy:2612
translate latin end_game2_b1689d84:

    # "Alex's voice is a hushed whisper, though I can tell he's trying not to laugh."
    "Vox Alex submissa susurrat, quamquam intellegere possum eum risum continere conari."

# game/end_game2.rpy:2613
translate latin end_game2_b0a16909:

    # c "\"Oh un-knot your tail, kitten. What will they do, arrest ME?\""
    c "\"O, caudae nodum solve, catule. Quid facient, ME comprehendent?\""

# game/end_game2.rpy:2614
translate latin end_game2_b3a4dbb3:

    # "Something is odd about Cassius's voice."
    "Aliquid mirum in voce Cassii est."

# game/end_game2.rpy:2615
translate latin end_game2_e76c6aaf:

    # "It's slurred and tired-sounding."
    "Balba est et fessa ut auditur."

# game/end_game2.rpy:2616
translate latin end_game2_4589007b:

    # "I don't even attempt to hide as the two of them stumble into view, Alex clinging to Cassius's neck as the wolf tries to keep his balance."
    "Ne me celare quidem conor, dum ambo titubantes in conspectum veniunt, Alex collo Cassii haerente, dum lupus aequilibrium tenere conatur."

# game/end_game2.rpy:2617
translate latin end_game2_83788b8a:

    # "Alex giggles while Cassius playfully nips him around his face and neck."
    "Alex cachinnat, dum Cassius vultum collumque eius ludens mordicat."

# game/end_game2.rpy:2618
translate latin end_game2_27e08573:

    # al "\"Stop! You're going to make me laugh. Someone will hear—\""
    al "\"Desine! Me ridere facies. Aliquis audiet...\""

# game/end_game2.rpy:2619
translate latin end_game2_e2bc8b47:

    # "Alex spots me and pulls away from Cassius, standing stiffly to the side."
    "Alex me videt et a Cassio se retrahit, rigide ad latus stans."

# game/end_game2.rpy:2621
translate latin end_game2_bdf1568f:

    # "Cassius, not having seen me yet, tries grabbing at him, but gets his paws slapped."
    "Cassius, qui me nondum vidit, eum capere conatur, sed pedes eius anteriores percutiuntur."

# game/end_game2.rpy:2623
translate latin end_game2_f1416168:

    # c "\"Ouch! Not so rough. My joints ache.\""
    c "\"Au! Ne tam aspere. Articuli mei dolent.\""

# game/end_game2.rpy:2624
translate latin end_game2_fae98249:

    # "He stares at Alex even as the Cat tries to nod in my direction to tip the wolf off."
    "Alex fixis oculis intuetur, etiam dum felis in meam partem annuere conatur ut lupum admoneat."

# game/end_game2.rpy:2625
translate latin end_game2_81be5240:

    # "It takes a minute, but eventually the white wolf gets it."
    "Minutum praeterit, sed tandem albus lupus intellegit."

# game/end_game2.rpy:2626
translate latin end_game2_43bd7b5c:

    # c "\"What'sa?\""
    c "\"Quidest?\""

# game/end_game2.rpy:2627
translate latin end_game2_31bb6bdf:

    # "He looks at me, takes a moment to process it, then stiffens up as well."
    "Me intuetur, paulisper rem intellegere conatur, deinde ipse quoque riget."

# game/end_game2.rpy:2629
translate latin end_game2_0047c983:

    # c "\"Oh...ape creature.\""
    c "\"O...creatura simiae similis.\""

# game/end_game2.rpy:2630
translate latin end_game2_1e2f23a0:

    # "I frown, wondering if he's forgotten my name already."
    "Frontem contraho, mirans an nomen meum iam oblitus sit."

# game/end_game2.rpy:2631
translate latin end_game2_2caed963:

    # "But my focus is mainly on Alex."
    "Sed praecipue in Alex intentus sum."

# game/end_game2.rpy:2632
translate latin end_game2_64934fe8:

    # m "\"Hey, Alex.\""
    m "\"Salve, Alex.\""

# game/end_game2.rpy:2634
translate latin end_game2_f37bff4e:

    # "I'm still feeling a little high and mighty after the trip I'd just had."
    "Adhuc paulum elatus et potens mihi videor post iter quod modo feci."

# game/end_game2.rpy:2636
translate latin end_game2_21edd8d1:

    # al "\"Uh...hello.\""
    al "\"Em...salve.\""

# game/end_game2.rpy:2637
translate latin end_game2_8dd51e45:

    # m "\"This is good. I actually wanted to talk to you before I leave.\""
    m "\"Bene est. Re vera tecum loqui volebam antequam discedo.\""

# game/end_game2.rpy:2639
translate latin end_game2_82156506:

    # al "\"Oh? what about?\""
    al "\"O? De quo?\""

# game/end_game2.rpy:2641
translate latin end_game2_6d4aa104:

    # m "\"Well, first of all, what are you doing here?\""
    m "\"Bene, primum, quid hic facis?\""

# game/end_game2.rpy:2642
translate latin end_game2_2d9201e8:

    # "Cassius steps forward unsteadily, pointing at me, I think."
    "Cassius incerte procedit, me digito demonstrans, credo."

# game/end_game2.rpy:2643
translate latin end_game2_017fbcc9:

    # "His finger kind of drifts off to the side."
    "Digitus eius paulum ad latus deflectit."

# game/end_game2.rpy:2645
translate latin end_game2_cad6cee0:

    # c "\"What right do you have to question him, human?\""
    c "\"Quo iure eum interrogas, homo?\""

# game/end_game2.rpy:2646
translate latin end_game2_735ef9c5:

    # "Alex quickly grabs one of Cassius's arms and tries to pull him back."
    "Alex celeriter unum bracchiorum Cassii capit et eum retrahere conatur."

# game/end_game2.rpy:2648
translate latin end_game2_fb04208d:

    # al "\"Cassius, please!\""
    al "\"Cassi, quaeso!\""

# game/end_game2.rpy:2650
translate latin end_game2_7b3b5b40:

    # c "\"You're acting very uppity for someone who is still considered a pet, even if you did win my brother's favor.\""
    c "\"Valde insolenter agis, cum adhuc animal domesticum habearis, etiamsi gratiam fratris mei meruisti.\""

# game/end_game2.rpy:2651
translate latin end_game2_bb2d25bb:

    # "I lean against the doorway casually, smiling."
    "Quasi neglegenter limini innitor, ridens."

# game/end_game2.rpy:2652
translate latin end_game2_abe499cd:

    # m "\"Oh, I won more than that, but if you really want I can call Amicus. He should have the proper authority.\""
    m "\"O, plus quam id merui, sed si vere vis, Amicum vocare possum. Ille idoneam auctoritatem habere debet.\""

# game/end_game2.rpy:2655
translate latin end_game2_301701b6:

    # al "\"No!\""
    al "\"Non!\""

# game/end_game2.rpy:2656
translate latin end_game2_0e8bebde:

    # "Alex freezes and every inch of his fur bristles out."
    "Alex riget et omnes pili eius eriguntur."

# game/end_game2.rpy:2657
translate latin end_game2_246aa1c0:

    # "I wait, not saying anything, but Alex also says nothing, just clinging to Cassius's arm as he stares at me, as if just moving will lead to me making good on my threat."
    "Exspecto, nihil dicens, sed Alex quoque nihil dicit, tantum bracchio Cassii haerens dum me fixis oculis intuetur, quasi solus motus me minam perficere faciat."

# game/end_game2.rpy:2658
translate latin end_game2_762d0270:

    # m "\"Well, then maybe we can start with what it is you're doing here. Last I heard, you were banished from the palace.\""
    m "\"Bene, tum fortasse incipere possumus a re quam hic facitis. Novissime audivi te e palatio expulsum esse.\""

# game/end_game2.rpy:2659
translate latin end_game2_cfd9304c:

    # "Cassius steps forward again, stumbling a bit as he drags Alex along."
    "Cassius rursus procedit, paulum titubans dum Alex secum trahit."

# game/end_game2.rpy:2661
translate latin end_game2_e9bb0595:

    # c "\"Enough intimidating my cat. We are here to claim my father's ship, which we will then pilot to Omorfa!\""
    c "\"Satis felem meum terres. Hic sumus ut navem patris mei sumamus, quam deinde ad Omorfa regemus!\""

# game/end_game2.rpy:2663
translate latin end_game2_f2dc1faa:

    # "Alex stares open-mouthed at Cassius, clearly shocked at how quickly his plans had just been revealed."
    "Alex Cassium ore aperto fixis oculis intuetur, manifeste attonitus quod consilia sua tam celeriter modo patefacta sint."

# game/end_game2.rpy:2665
translate latin end_game2_c05692ab:

    # al "\"Cassius!\""
    al "\"Cassi!\""

# game/end_game2.rpy:2667
translate latin end_game2_45202662:

    # c "\"What!? Am I saying something wrong? Well, consider it your fault as you wouldn't stop pressing the wine bottle to my mouth.\""
    c "\"Quid!? Aliquid mali dicone? Bene, tua culpa sit, cum utrem vini ori meo admovere non desineres.\""

# game/end_game2.rpy:2668
translate latin end_game2_8de5002a:

    # "Alexios can only stare back at the wolf, mouth agape before he snaps it closed and turns to me."
    "Alexios tantum lupum vicissim ore aperto intueri potest, deinde subito os claudit et ad me se vertit."

# game/end_game2.rpy:2670
translate latin end_game2_82907867:

    # al "\"My master is simply drunk, if that was not already obvious.\""
    al "\"Dominus meus tantum ebrius est, si id iam non manifestum erat.\""

# game/end_game2.rpy:2672
translate latin end_game2_4bdcdd17:

    # c "\"I am perfectly coherent despite my slightly inebriated state!\""
    c "\"Prorsus perspicue loquor, quamquam paulum ebrius sum!\""

# game/end_game2.rpy:2674
translate latin end_game2_8cae891e:

    # al "\"Coherency isn't the issue, Cass!\""
    al "\"Non agitur de perspicuitate, Cass!\""

# game/end_game2.rpy:2675
translate latin end_game2_b24f0aeb:

    # "Alex hisses angrily at the wolf before turning back to me, smoothing his fur down."
    "Alex irate lupo sibilat, deinde ad me redit, pilos suos componens."

# game/end_game2.rpy:2677
translate latin end_game2_40b914ad:

    # al "\"My master brought me here simply because he wanted to. As his pet, I have no choice but to obey.\""
    al "\"Dominus meus me huc adduxit tantum quia voluit. Ut animal eius domesticum, nihil eligere possum nisi parere.\""

# game/end_game2.rpy:2678
translate latin end_game2_0fbaec2a:

    # "I see Alexios's paw grip more tightly onto Cassius's arm, warning him."
    "Pedem anteriorem Alexii bracchium Cassii artius stringentem video, eum monentem."

# game/end_game2.rpy:2680
translate latin end_game2_1a9bba22:

    # c "\"Ouch! What did I say about me being sore?\""
    c "\"Au! Quid dixi de doloribus meis?\""

# game/end_game2.rpy:2681
translate latin end_game2_86274321:

    # "I sigh as finally recognize that look in Alex's eyes."
    "Suspiro, cum tandem illum in Alex oculis vultum agnoscam."

# game/end_game2.rpy:2682
translate latin end_game2_0e18c4db:

    # m "\"So, you were planning to steal the emperor's ship, which is Amicus's ship now, by the way, just before I was due to leave?\""
    m "\"Ita cogitabatis navem imperatoris furari, quae iam navis Amici est, obiter dico, paulo antequam mihi discedendum erat?\""

# game/end_game2.rpy:2683
translate latin end_game2_f2b302eb:

    # al "\"Oh, you're leaving?\""
    al "\"O, discedisne?\""

# game/end_game2.rpy:2684
translate latin end_game2_7fbd7712:

    # "Alex isn't even trying at this point."
    "Alex iam ne conatur quidem."

# game/end_game2.rpy:2685
translate latin end_game2_28417a74:

    # m "\"Man, you're a real piece of shit, you know that?\""
    m "\"Heus, vera merda es, scisne?\""

# game/end_game2.rpy:2687
translate latin end_game2_c16df18d:

    # al "\"And you're a reckless ape with no consideration for the rest of the galaxy!\""
    al "\"Et tu simia temeraria es, quae reliquam Galaxiam nullo modo curat!\""

# game/end_game2.rpy:2688
translate latin end_game2_f5f00b35:

    # "I blink in surprise, though I'm a little satisfied to see that I've gotten through his shield of indifference."
    "Miratus palpebras moveo, quamquam paulum gaudeo me per eius scutum neglegentiae penetrasse."

# game/end_game2.rpy:2689
translate latin end_game2_36a38e5e:

    # "Cassius, who had opened his mouth to butt in again, suddenly pauses, raising an eyebrow at the two of us."
    "Cassius, qui os aperuerat ut rursus interveniret, subito consistit, supercilium ad nos ambos tollens."

# game/end_game2.rpy:2691
translate latin end_game2_0f0c1690:

    # c "\"Wait a moment, do you two have some sort of history? You speak in a familiar way to each other.\""
    c "\"Exspectate paulisper; vos duo aliquam inter vos historiam habetis? Familiariter inter vos loquimini.\""

# game/end_game2.rpy:2693
translate latin end_game2_d57b1bcc:

    # al "\"No Cassius. Only in passing.\""
    al "\"Non, Cassi. Tantum obiter.\""

# game/end_game2.rpy:2694
translate latin end_game2_4fe51ee1:

    # "I remember then that Alex had tried to keep our interactions hidden from Cassius...though not the information I'd unwittingly given the cat during our many conversations."
    "Tum memini Alex colloquia nostra a Cassio celare conatum esse...non tamen notitias quas imprudens feli per multa colloquia nostra dederam."

# game/end_game2.rpy:2695
translate latin end_game2_3302a957:

    # "I ignore the wolf for the moment, unwilling to let this traitorous feline get the last word in."
    "Nunc lupum neglego, nolens sinere hunc proditorium felem ultimum verbum habere."

# game/end_game2.rpy:2696
translate latin end_game2_1d702e94:

    # m "\"And you have no consideration for the lives of anyone on this moon.\""
    m "\"Et tu vitas cuiusquam in hac luna non curas.\""

# game/end_game2.rpy:2697
translate latin end_game2_b11021ed:

    # "I turn to Cassius."
    "Ad Cassium me verto."

# game/end_game2.rpy:2698
translate latin end_game2_e3f9ea7f:

    # m "\"And how do you explain still wanting to get with this cat when he's responsible for most of the terrible things that happened to us last year, to your family?\""
    m "\"Et quomodo explicas te adhuc cum hoc fele coniungi velle, cum ille maximae parti horribilium rerum quae nobis anno superiore acciderunt, familiae tuae, causam dederit?\""

# game/end_game2.rpy:2699
translate latin end_game2_823d2aba:

    # al "\"Don't talk to him, Cassius. Let's just leave.\""
    al "\"Noli cum eo loqui, Cassi. Tantum discedamus.\""

# game/end_game2.rpy:2700
translate latin end_game2_7e57691b:

    # m "\"No, you're not leaving, otherwise I am calling for Amicus.\""
    m "\"Non, non disceditis; alioquin Amicum voco.\""

# game/end_game2.rpy:2701
translate latin end_game2_a43948dd:

    # "I look at Alex who purses his lips tightly before turning my attention back to Cassius."
    "Alex intueor, qui labia artius comprimit, deinde attentionem meam ad Cassium refero."

# game/end_game2.rpy:2703
translate latin end_game2_36d8f02b:

    # c "\"That is none of your concern, but if you {i}must{/i} know, then—\""
    c "\"Id nihil ad te pertinet, sed si scire {i}debes{/i}, tum...\""

# game/end_game2.rpy:2705
translate latin end_game2_809b7787:

    # al "\"Cassius.\""
    al "\"Cassius.\""

# game/end_game2.rpy:2707
translate latin end_game2_dbfa243f:

    # c "\"—consider how you would feel, left in a position in which the intents of your entire society rested upon your shoulders.\""
    c "\"...cogita quomodo sentias, si in ea condicione relictus sis ut consilia totius societatis tuae in umeris tuis consistant.\""

# game/end_game2.rpy:2709
translate latin end_game2_0c138f3b:

    # c "\"He had little choice, while also underestimating Cato's brutality.\""
    c "\"Parum eligere poterat, simul crudelitatem Catonis minorem quam erat aestimans.\""

# game/end_game2.rpy:2710
translate latin end_game2_eb5b4b13:

    # "Cassius's words are less slurred now, the topic of conversation seeming to have sobered him up a bit."
    "Verba Cassii nunc minus balba sunt; res de qua loquimur eum paulum sobriorem fecisse videtur."

# game/end_game2.rpy:2711
translate latin end_game2_e49dea8c:

    # m "\"He did have the choice to accept his 'assignment', as he put it, and I think he's smart enough to know his actions would destroy countless lives.\""
    m "\"Certe eligere potuit an suum 'munus', ut dixit, acciperet, et puto eum satis callidum esse ut sciret actiones suas innumeras vitas deleturas esse.\""

# game/end_game2.rpy:2712
translate latin end_game2_857ea0b7:

    # c "\"You misunderstand. His choice was an illusion so as to assure the cats, especially the ones giving the command, that they are still grounded by their values.\""
    c "\"Male intellegis. Electio eius falsa species erat, ut felibus, praesertim iis qui iussa dabant, fides fieret eos adhuc suis principiis teneri.\""

# game/end_game2.rpy:2714
translate latin end_game2_6c3e7480:

    # unk "\"{i}Illusion of choice...to steady unstable values.{/i}\""
    unk "\"{i}Falsa species electionis...ad principia instabilia firmanda.{/i}\""

# game/end_game2.rpy:2716
translate latin end_game2_afcd0da0:

    # c "\"I fully understand this, and so did Amicus when I explained the situation. We have both been left in such positions before—\""
    c "\"Id plene intellego, et Amicus quoque cum rem explicavi. Ambo antea in talibus condicionibus relicti sumus...\""

# game/end_game2.rpy:2717
translate latin end_game2_6a20a80d:

    # "I shake my head."
    "Caput quatio."

# game/end_game2.rpy:2718
translate latin end_game2_c2fca13a:

    # m "\"How can you not blame him for the destruction and death of your people?\""
    m "\"Quomodo eum ob vastationem et mortem populi tui non culpas?\""

# game/end_game2.rpy:2719
translate latin end_game2_c5345284:

    # c "\"[mc], he is only the stylus. I blame the hand of his government that wielded him like a disposable tool.\""
    c "\"[mc], ille tantum stilus est. Manum gubernationis eius culpo, quae eum usurpavit quasi instrumentum post usum abiciendum.\""

# game/end_game2.rpy:2720
translate latin end_game2_b4b9141b:

    # "Alex is tugging on the wolf's arm again, pulling him toward the main exit."
    "Alex bracchium lupi rursus trahit, eum ad exitum principalem ducens."

# game/end_game2.rpy:2722
translate latin end_game2_831c4f04:

    # al "\"Cassius, let's just leave. There's more wine in our apartment...\""
    al "\"Cassi, tantum discedamus. Plus vini in habitaculo nostro est...\""

# game/end_game2.rpy:2723
translate latin end_game2_9bb4ede0:

    # "I sigh, realizing that I probably won't ever have my questions about Alex answered, that he'll probably never get what he deserves."
    "Suspiro, intellegens quaestiones meas de Alex probabiliter numquam responsum habituras esse, eumque probabiliter numquam meritam poenam accepturum esse."

# game/end_game2.rpy:2724
translate latin end_game2_b9e78129:

    # "It still bothers me that he got off so easily, that Cassius shields him from any sort of comeuppance."
    "Adhuc me vexat eum tam facile evasisse, Cassium eum ab omni poena tueri."

# game/end_game2.rpy:2725
translate latin end_game2_e580ee1d:

    # m "\"Why do you trust him, Cassius? He's a traitor, but here you are, leaving your empire vulnerable by letting him get close to you, the brother of the emperor.\""
    m "\"Cur ei confidis, Cassi? Proditor est, sed hic es, imperium tuum periculo exponens dum ei propius ad te accedere sinis, ad fratrem imperatoris.\""

# game/end_game2.rpy:2726
translate latin end_game2_5e8dbbdf:

    # "Cassius pouts, putting an arm around Alexios."
    "Cassius labia protrudit, bracchio Alexium amplectens."

# game/end_game2.rpy:2728
translate latin end_game2_bee4b81b:

    # c "\"Because we understand each other, [mc], as you and Amicus somehow understand each other. I've grown tired of the games of politics. I simply want peace with an understanding partner.\""
    c "\"Quia nos invicem intellegimus, [mc], sicut tu et Amicus nescio quomodo vos invicem intellegitis. Ludorum rei publicae taedet me. Tantum pacem cum consorte intellegente volo.\""

# game/end_game2.rpy:2729
translate latin end_game2_1175a5b3:

    # m "\"By running away to Omorfa? Last I heard, they despise your kind.\""
    m "\"Ad Omorfa fugiendo? Novissime audivi eos genus tuum contemnere.\""

# game/end_game2.rpy:2731
translate latin end_game2_dc084697:

    # c "\"Actually, we're similar in many ways, one being our shared culture—\""
    c "\"Re vera multis modis similes sumus, quorum unus est communis cultus noster...\""

# game/end_game2.rpy:2732
translate latin end_game2_05e3ba31:

    # "I try not to roll my eyes at the word \"shared\"."
    "Conor oculos non volvere cum verbum \"communis\" audio."

# game/end_game2.rpy:2733
translate latin end_game2_91daad22:

    # c "\"And the other being the fact that the cats now oppose the parents. I believe this can result in plenty of common grou—\""
    c "\"Alter autem est quod feles iam Parentibus repugnant. Credo ex hoc multum communis consen...\""

# game/end_game2.rpy:2735
translate latin end_game2_fa03ab8f:

    # al "\"Come on!\""
    al "\"Age!\""

# game/end_game2.rpy:2739
translate latin end_game2_ee352006:

    # "Alex yanks the wolf, making Cassius yelp before stumbling after the cat."
    "Alex lupum subito trahit, ita ut Cassius ululet antequam titubans felem sequatur."

# game/end_game2.rpy:2740
translate latin end_game2_de725071:

    # c "\"Ooooh! Son of a whore, Alex! You're lucky I'm drunk, otherwise you could have seriously injured me!\""
    c "\"Ooooh! Fili meretricis, Alex! Felix es quod ebrius sum; alioquin me graviter laedere potuisses!\""

# game/end_game2.rpy:2742
translate latin end_game2_8ff64e3f:

    # "I watch the two of them disappear through the exit, part of me wanting to call security and have the cat arrested for trying to hijack Amicus's ship."
    "Ambos per exitum evanescentes specto; pars mei custodes vocare vult et felem comprehendi iubere, quod navem Amici rapere conatus sit."

# game/end_game2.rpy:2743
translate latin end_game2_8ee50e36:

    # "At the same time though, I wonder if it'll do us any good, considering what the cat has already gotten away with."
    "Simul tamen miror an id nobis prosit, cum ea considerem quae felis iam impune fecit."

# game/end_game2.rpy:2744
translate latin end_game2_74629da2:

    # "Still, I feel like Cassius seemingly wanting to abandon the empire, while drunk or not, is something Amicus should know about."
    "Tamen sentio Cassium imperium deserere velle videri, sive ebrius est sive non, aliquid esse quod Amicus scire debeat."

# game/end_game2.rpy:2745
translate latin end_game2_84354930:

    # "I decide that I will tell Amicus, but when we're both on our way back to Earth and he has time to think over what he wants to do about this."
    "Statuo me Amico dicturum esse, sed cum ambo iam ad Terram redeamus et tempus habeat cogitandi quid de hac re facere velit."

# game/end_game2.rpy:2746
translate latin end_game2_fd109146:

    # "As for Alex as a whole, I suppose his motivation, and Cassius's willingness to defend him makes a little more sense."
    "De Alex omnino, credo eius causam et voluntatem Cassii eum defendendi paulo facilius intellegi posse."

# game/end_game2.rpy:2747
translate latin end_game2_ef4ddbbc:

    # "We don't always have a choice, especially when those in power seek to manipulate us."
    "Non semper eligere possumus, praesertim cum potentes nos regere quaerunt."

# game/end_game2.rpy:2748
translate latin end_game2_3434c20f:

    # "If we really want to break free, we have to make our own choices."
    "Si vere nos liberare volumus, ipsi eligere debemus."

# game/end_game2.rpy:2751
translate latin end_game2_f5bea750:

    # "I head back to our bedroom, suddenly extremely tired as the euphoria of the night begins to wear off."
    "Ad cubiculum nostrum redeo, subito maxime fessus, dum laetitia noctis languescere incipit."

# game/end_game2.rpy:2752
translate latin end_game2_d81255aa:

    # "I feel like days have passed."
    "Sentio quasi dies praeterierint."

# game/end_game2.rpy:2753
translate latin end_game2_d0e94b0d:

    # "So when I find Amicus in the same position on the couch, I practically fall back into his arms."
    "Ita cum Amicum eodem situ in lecto sedendi invenio, paene in bracchia eius recido."

# game/end_game2.rpy:2754
translate latin end_game2_b06f7e52:

    # "He shifts when I do, then hugs me tight before falling back to sleep."
    "Ille se movet cum id facio, deinde me artius amplectitur et rursus obdormit."

# game/end_game2.rpy:2755
translate latin end_game2_46596633:

    # "I wiggle myself deeper into his embrace before doing the same, falling asleep almost instantly."
    "Me agitans profundius in eius amplexum insinuo, deinde idem facio, paene statim obdormiens."

# game/end_game2.rpy:2758
translate latin end_game2_f14076ef:

    # "It only seems like a second passes before I feel myself being moved around."
    "Unum tantum secundum praeteriisse videtur antequam me moveri sentio."

# game/end_game2.rpy:2759
translate latin end_game2_2fbe5909:

    # "Then I feel Amicus's paw on my head, gently nudging me out of sleep."
    "Tum pedem anteriorem Amici in capite meo sentio, me leniter e somno excitantem."

# game/end_game2.rpy:2761
translate latin end_game2_390cf09d:

    # a "\"Hey there, love.\""
    a "\"Heus, amor mi.\""

# game/end_game2.rpy:2763
translate latin end_game2_c72f7028:

    # a "\"It's time to get ready.\""
    a "\"Tempus est nos parare.\""

# game/end_game2.rpy:2767
translate latin end_game2_c8a6f0ea:

    # "I stand off to the side, watching Amicus load up the ship while checking various gadgets."
    "Ad latus sto, Amicum navem onerantem spectans dum varia instrumenta inspicit."

# game/end_game2.rpy:2768
translate latin end_game2_6fee16f4:

    # "Virginia and Neferu make small talk, the kind that makes it feel as if I'm not going away for eight years, that everything is still normal."
    "Virginia et Neferu de rebus levibus colloquuntur, ita ut sentiam quasi non per octo annos abiturus sim, quasi omnia adhuc solita sint."

# game/end_game2.rpy:2769
translate latin end_game2_5805f8ed:

    # "Then I have to remind myself that this technically isn't normal, even though it feels that way now."
    "Tum memet admonere debeo hanc rem re ipsa non solitam esse, quamquam nunc ita sentitur."

# game/end_game2.rpy:2770
translate latin end_game2_38f8162c:

    # "Finally, Amicus walks up to us, brushing his paws together."
    "Tandem Amicus ad nos ambulat, pedes anteriores inter se fricans."

# game/end_game2.rpy:2772
translate latin end_game2_7152ab65:

    # a "\"Well! It's about time we're off. I should be back in no more than two day's time, Virginia.\""
    a "\"Bene! Tempus fere est discedendi. Intra duos dies redire debeo, Virginia.\""

# game/end_game2.rpy:2774
translate latin end_game2_c197ba6c:

    # v "\"I certainly hope that to be the case, considering how much work will pile up. I'll try and keep the empire from rebelling while you're gone, though.\""
    v "\"Id certe spero, cum tantum laboris cumulatum iri cogitem. Conabor tamen imperium ne rebellet tenere dum abes.\""

# game/end_game2.rpy:2776
translate latin end_game2_f8a72902:

    # a "\"Thank you, Virginia.\""
    a "\"Gratias tibi, Virginia.\""

# game/end_game2.rpy:2777
translate latin end_game2_4aa0c234:

    # v "\"And I look forward to our next reunion, [mc]. I hope your experiences contribute to a more disciplined character.\""
    v "\"Et proximum congressum nostrum exspecto, [mc]. Spero experientias tuas ad mores magis disciplinatos profuturas esse.\""

# game/end_game2.rpy:2778
translate latin end_game2_fd56c2b7:

    # m "\"Uh, thanks?\""
    m "\"Em, gratias?\""

# game/end_game2.rpy:2780
translate latin end_game2_9544e7c7:

    # v "\"Of course.\""
    v "\"Certe.\""

# game/end_game2.rpy:2781
translate latin end_game2_e3e30d2f:

    # "Virginia sticks out a paw, and I blink at it until realizing what she's doing."
    "Virginia pedem anteriorem porrigit, et eum palpebris motis intueor donec intellego quid faciat."

# game/end_game2.rpy:2782
translate latin end_game2_a5c93da8:

    # "The way I first greeted her."
    "Quomodo eam primum salutavi."

# game/end_game2.rpy:2783
translate latin end_game2_a9d3328c:

    # "I bend to kiss it."
    "Me inclino ut eum osculer."

# game/end_game2.rpy:2785
translate latin end_game2_0dc06ff1:

    # v "\"Goodbye, [mc].\""
    v "\"Vale, [mc].\""

# game/end_game2.rpy:2786
translate latin end_game2_edec1b86:

    # "I step back awkwardly."
    "Incommode retro gradum facio."

# game/end_game2.rpy:2787
translate latin end_game2_323db076_1:

    # m "\"Bye...\""
    m "\"Vale...\""

# game/end_game2.rpy:2791
translate latin end_game2_3ce5c735:

    # "Then Neferu's paw sticks out, and I hear Amicus sigh loudly next to me."
    "Tum pes anterior Neferu porrigitur, et Amicum iuxta me sonore suspirantem audio."

# game/end_game2.rpy:2792
translate latin end_game2_08c73cb1:

    # "I don't humor the jackal though, instead just forcing it into an awkward handshake."
    "Chacalo tamen morem non gero, sed pedem eius in incommodam manuum iunctionem cogo."

# game/end_game2.rpy:2794
translate latin end_game2_433c39c6:

    # n "\"That's a new one.\""
    n "\"Nova haec est.\""

# game/end_game2.rpy:2795
translate latin end_game2_ddf3b6f3:

    # m "\"Another human greeting. I'll have to show you more when I see you next time.\""
    m "\"Alia salutatio humana. Plures tibi ostendere debebo cum proximo tempore te videro.\""

# game/end_game2.rpy:2797
translate latin end_game2_24815168:

    # n "\"Whenever that might be.\""
    n "\"Quando id futurum sit.\""

# game/end_game2.rpy:2798
translate latin end_game2_91663c88:

    # m "\"It'll happen. I promise.\""
    m "\"Fiet. Promitto.\""

# game/end_game2.rpy:2800
translate latin end_game2_86eccd72:

    # "Neferu raises an eyebrow at my assuredness, but nods."
    "Neferu supercilium ob certitudinem meam tollit, sed annuit."

# game/end_game2.rpy:2801
translate latin end_game2_ab74179e:

    # n "\"Well, here's a Khemian goodbye, one between those who are close.\""
    n "\"Bene, haec est salutatio discedentis Khemiana, inter eos qui intimi sunt.\""

# game/end_game2.rpy:2802
translate latin end_game2_6c9c6913:

    # "He then leans down, pulling me forward."
    "Tum se inclinat, me ad se trahens."

# game/end_game2.rpy:2807
translate latin end_game2_d60bdd5c:

    # "My chin rests on his shoulder, his paw coming up to rest on my head, his cheek pressed to mine."
    "Mentum meum in umero eius quiescit; pedem anteriorem tollit ut in capite meo ponat, gena sua meae pressa."

# game/end_game2.rpy:2808
translate latin end_game2_0dffef14:

    # n "\"May Ahhotep be with you on every step of your journey, brother, and may he help you to find all that you seek.\""
    n "\"Ahhotep tecum sit in omni itineris tui gradu, frater, et te adiuvet omnia invenire quae quaeris.\""

# game/end_game2.rpy:2809
translate latin end_game2_39052c8e:

    # "I expect to hear Amicus make more noises of disapproval, but it's quiet."
    "Exspecto Amicum plures sonos improbationis facturum esse, sed silentium est."

# game/end_game2.rpy:2810
translate latin end_game2_e4359bd9:

    # "I stand there for a few moments, then awkwardly put my hand on the jackal's head, hoping I'm returning the gesture appropriately."
    "Ibi pauca momenta sto, deinde incommode manum in capite chacali pono, sperans me gestum recte reddere."

# game/end_game2.rpy:2811
translate latin end_game2_ee53dd3d:

    # "I stand still until Neferu lets go and pulls back."
    "Immobilis sto donec Neferu me dimittit et recedit."

# game/end_game2.rpy:2816
translate latin end_game2_2f9add81:

    # m "\"Never heard you call me brother, before.\""
    m "\"Numquam antea te me fratrem appellare audivi.\""

# game/end_game2.rpy:2817
translate latin end_game2_9a6029c1:

    # n "\"It's a farewell normally reserved for siblings. I haven't performed it since I last saw my sister on Khemia, in fact.\""
    n "\"Salutatio discedentis est, quae plerumque fratribus et sororibus reservatur. Re vera eam non feci ex quo sororem meam novissime in Khemia vidi.\""

# game/end_game2.rpy:2818
translate latin end_game2_26e7d518:

    # m "\"You see me as a brother?\""
    m "\"Me fratrem habes?\""

# game/end_game2.rpy:2820
translate latin end_game2_b5ba710a:

    # n "\"Close enough.\""
    n "\"Satis prope.\""

# game/end_game2.rpy:2822
translate latin end_game2_faacf704:

    # n "\"Until we meet again, friend.\""
    n "\"Donec rursus convenimus, amice.\""

# game/end_game2.rpy:2823
translate latin end_game2_4dfd4a52:

    # m "\"Thanks, and yeah, until then, Neferu.\""
    m "\"Gratias, et ita, usque ad illud tempus, Neferu.\""

# game/end_game2.rpy:2825
translate latin end_game2_1167687f:

    # "Amicus coughs awkwardly, stepping forward and putting his paw around my shoulder."
    "Amicus incommode tussit, procedens et pedem anteriorem circa umerum meum ponens."

# game/end_game2.rpy:2827
translate latin end_game2_cd473855:

    # a "\"Alright, see you all when I return.\""
    a "\"Bene, vos omnes videbo cum rediero.\""

# game/end_game2.rpy:2828
translate latin end_game2_e6b73661:

    # "Virginia smiles and Neferu nods as we turn away from them, Amicus leading the way to the ship that's parked on the palace lawn."
    "Virginia ridet et Neferu annuit dum nos ab eis avertimus, Amico praeeunte ad navem in prato palatii positam."

# game/end_game2.rpy:2833
translate latin end_game2_45185812:

    # "He jumps in first, then reaches down to help pull me up."
    "Primus insilit, deinde manum deorsum porrigit ut me tollere adiuvet."

# game/end_game2.rpy:2834
translate latin end_game2_2e40683f:

    # "As soon as I'm inside, the door closes before I can look back."
    "Simul ac intus sum, ianua clauditur antequam respicere possum."

# game/end_game2.rpy:2838
translate latin end_game2_7086faa6:

    # "I'm struck by the fact that I haven't been inside the ship since I first got here, yet it's all so familiar."
    "Me ferit quod intus in nave non fui ex quo primum huc veni, et tamen omnia tam familiaria sunt."

# game/end_game2.rpy:2840
translate latin end_game2_50f5c4d6:

    # a "\"Alright! Let me make sure we have everything...\""
    a "\"Bene! Videam an omnia habeamus...\""

# game/end_game2.rpy:2842
translate latin end_game2_89143bae:

    # "Amicus walks around the back of the ship, looking at various compartments, looking into the utility closet that I'd once been stuffed into."
    "Amicus per posteriorem navis partem ambulat, varia receptacula inspiciens, in armarium instrumentorum prospiciens quo olim inculcatus eram."

# game/end_game2.rpy:2843
translate latin end_game2_97e3d351:

    # "He opens the doors to his quarters, doing more checks."
    "Ianuas cubiculi sui aperit, plura inspiciens."

# game/end_game2.rpy:2844
translate latin end_game2_c3b679f2:

    # "I move to the seat that I'd sat in a year ago and look out the window."
    "Ad sedem venio in qua ante annum sederam, et per fenestram prospicio."

# game/end_game2.rpy:2845
translate latin end_game2_38570b17:

    # "Virginia and Neferu stand by the entrance of the palace, still watching."
    "Virginia et Neferu iuxta introitum palatii stant, adhuc spectantes."

# game/end_game2.rpy:2846
translate latin end_game2_2a45ab5d:

    # "I wave, and Neferu raises a paw in acknowledgment."
    "Manu saluto, et Neferu pedem anteriorem tollit ut respondeat."

# game/end_game2.rpy:2847
translate latin end_game2_a600e4b6:

    # a "\"Everything appears to be in order. Com, initiate liftoff.\""
    a "\"Omnia recte disposita videntur. Com, ascensum incipe.\""

# game/end_game2.rpy:2848
translate latin end_game2_95637af8:

    # com "\"Liftoff sequence engaged.\""
    com "\"Ordo ascendendi initus est.\""

# game/end_game2.rpy:2850
translate latin end_game2_78c011d4:

    # "The ship rumbles, though there isn't any sound as we begin to lift off the ground."
    "Navis tremit, quamquam nullus sonus est dum a terra tolli incipimus."

# game/end_game2.rpy:2851
translate latin end_game2_0ff2a25e:

    # "Amicus sits heavily in his seat with a thump, buckling his seatbelt while I do the same."
    "Amicus graviter cum ictu in sede sua sedet, cingulum securitatis alligans, dum ego idem facio."

# game/end_game2.rpy:2852
translate latin end_game2_6acb0d0a:

    # "I watch out the window as Neferu, Virginia, and the palace grow smaller and smaller, along with the entire city of Adastra."
    "Per fenestram specto Neferu, Virginiam et palatium minora minoraque fieri, una cum tota urbe Adastra."

# game/end_game2.rpy:2853
translate latin end_game2_12c335ff:

    # "It's not unlike taking off from the airport on my way to Rome, though this is much faster."
    "Non dissimile est ascensui ex aeroportu dum Romam ibam, quamquam hic multo celerior est."

# game/end_game2.rpy:2855
translate latin end_game2_c862bbb1:

    # "Before I know it, the glittering city fades into a small, sparkling spot of lights on the globe of the moon."
    "Mox urbs nitens evanescit in parvam scintillantem luminum maculam in globo lunae."

# game/end_game2.rpy:2856
translate latin end_game2_4125e5ab:

    # "I stare out at Adastra, at the little patches of glittering lights indicating the cities, and at the long stretches of dark blue that indicate the oceans."
    "Adastram prospiciens fixis oculis intueor, parvas luminum micantium maculas quae urbes indicant et longas plagas caerulei obscuri quae oceanos indicant."

# game/end_game2.rpy:2857
translate latin end_game2_1c76c4a1:

    # "That's when I notice Amicus watching me closely."
    "Tum Amicum me attente spectantem animadverto."

# game/end_game2.rpy:2858
translate latin end_game2_df8ec4bc_4:

    # m "\"What?\""
    m "\"Quid?\""

# game/end_game2.rpy:2859
translate latin end_game2_a5560a27:

    # "The big wolf shrugs."
    "Magnus lupus umeros levat."

# game/end_game2.rpy:2861
translate latin end_game2_76d44613:

    # a "\"Oh, just curious as to how you might feel at this moment. I must say, you seem less stressed than you had been last night.\""
    a "\"O, tantum curiosus sum quomodo hoc momento sentias. Fateor te minus sollicitum videri quam nocte superiore eras.\""

# game/end_game2.rpy:2862
translate latin end_game2_adf331fa:

    # "I go back to looking out the window, getting a last look at Adastra, along with the smaller {i}Torque{/i} and the much larger {i}Ancoris{/i}."
    "Rursus per fenestram prospicio, Adastram postremo intuens, una cum minore {i}Torque{/i} et multo maiore {i}Ancoris{/i}."

# game/end_game2.rpy:2864
translate latin end_game2_0532d63c:

    # m "\"I guess things just became...clearer, kind of like you said they would.\""
    m "\"Credo res tantum factas esse...clariores, fere ut dixisti futuras esse.\""

# game/end_game2.rpy:2866
translate latin end_game2_317af7b3:

    # "Amicus grins, though I'm pretty sure he doesn't know what I'm talking about."
    "Amicus late ridet, quamquam satis certus sum eum nescire de quo loquar."

# game/end_game2.rpy:2867
translate latin end_game2_e84713bc:

    # com "\"Sufficient distance achieved. Prepare to enter the stretch drive.\""
    com "\"Satis intervalli adepti sumus. Ad usum Propulsoris Distensionis vos parate.\""

# game/end_game2.rpy:2869
translate latin end_game2_0d43ae56:

    # "Amicus reaches out a paw and I take it."
    "Amicus pedem anteriorem porrigit et eum capio."

# game/end_game2.rpy:2871
translate latin end_game2_d0d0787d:

    # a "\"Then you know that there is much ahead of us, together.\""
    a "\"Tum scis multa ante nos esse, una.\""

# game/end_game2.rpy:2872
translate latin end_game2_30c12401:

    # "I nod, the Other's statement of suffering with Amicus forever echoing through my head as I watch Adastra get smaller, and smaller."
    "Annuo, verbis Alteri de me cum Amico in aeternum patiente per caput meum resonantibus, dum Adastram minorem minoremque fieri specto."

# game/end_game2.rpy:2873
translate latin end_game2_d54f0fae:

    # "Then—"
    "Tum—"

# game/end_game2.rpy:2875
translate latin end_game2_72e82585:

    # "It's gone, replaced with warped space and unimaginable distance."
    "Abiit, spatio curvato et intervallo quod mente capi non potest substitutis."

# game/end_game2.rpy:2880
translate latin end_game2_8600b4b3:

    # "About 10 hours."
    "Circiter 10 horae."

# game/end_game2.rpy:2881
translate latin end_game2_5c8a116a:

    # "That's how much time we have before we get to Earth."
    "Tantum temporis habemus antequam ad Terram pervenimus."

# game/end_game2.rpy:2882
translate latin end_game2_a2f721ce:

    # "We agree to stay up and treat it like having an entire day to ourselves."
    "Convenimus nos vigilaturos esse et rem quasi totum diem nobis solis haberemus tractaturos."

# game/end_game2.rpy:2883
translate latin end_game2_1e0e586d:

    # "Two hours pass quickly as we lie on the cot as Amicus entertains me with the various foods we have stashed in the compartments along the wall."
    "Duae horae celeriter transeunt dum in lectulo iacemus, Amico me oblectante variis cibis quos in receptaculis per parietem reposuimus."

# game/end_game2.rpy:2884
translate latin end_game2_db6279b1:

    # "He's brought plenty this time."
    "Hoc tempore copiam attulit."

# game/end_game2.rpy:2885
translate latin end_game2_03baccb4:

    # "He'd learned his lesson the first time after he ran out and had to rely on the less-than-savory protein mudshake."
    "Primo tempore rem didicerat, postquam cibis consumptis potione proteinica lutulenta minus sapida niti debuit."

# game/end_game2.rpy:2886
translate latin end_game2_ab4df8af:

    # "As for the space-travel food, they apparently can't go bad, so we open every single one, taste testing them and ranking them from worst to best."
    "Cibi itineris spatialis, ut videtur, corrumpi non possunt, ita singulos omnes aperimus, eos gustantes et a pessimo ad optimum ordinantes."

# game/end_game2.rpy:2887
translate latin end_game2_dcb287bd:

    # "Amicus is surprised that our rankings are nearly opposite each other, even though I expected it."
    "Amicus miratur ordinationes nostras paene contrarias esse, quamquam id exspectabam."

# game/end_game2.rpy:2888
translate latin end_game2_a55a1df7:

    # m "\"You're always wanting anything sweet, Amicus.\""
    m "\"Semper quidlibet dulce cupis, Amice.\""

# game/end_game2.rpy:2890
translate latin end_game2_deab9c0b:

    # a "\"Yes, because sweet is good.\""
    a "\"Ita, quia dulce bonum est.\""

# game/end_game2.rpy:2891
translate latin end_game2_b1f78d59:

    # m "\"Sometimes, but I'd rather have more of something that's salty and savory rather than sweet.\""
    m "\"Interdum, sed malo plus alicuius salsi et sapidi quam dulcis habere.\""

# game/end_game2.rpy:2893
translate latin end_game2_d7148917:

    # a "\"But why? It's like dessert all the time.\""
    a "\"Sed cur? Quasi semper bellaria edas.\""

# game/end_game2.rpy:2894
translate latin end_game2_b16b40e4:

    # m "\"There's a reason dessert is small and comes last, Amicus.\""
    m "\"Est causa cur bellaria parva sint et postrema veniant, Amice.\""

# game/end_game2.rpy:2896
translate latin end_game2_cd1fd17f:

    # a "\"I don't see the reason.\""
    a "\"Causam non video.\""

# game/end_game2.rpy:2897
translate latin end_game2_8273d56a:

    # m "\"Ever heard of too much of a good thing?\""
    m "\"Umquam audivisti etiam bona nimia esse posse?\""

# game/end_game2.rpy:2899
translate latin end_game2_344790fa:

    # a "\"If something is good, then there can never be enough of it.\""
    a "\"Si aliquid bonum est, numquam eius satis esse potest.\""

# game/end_game2.rpy:2900
translate latin end_game2_2a79ca43:

    # "Amicus flicks a round, blue, pebble-like pellet into his muzzle, that I assume is some kind of fruit-flavored candy."
    "Amicus globulum rotundum caeruleum et calculo similem in os iacit, quem quoddam dulciarium sapore fructuum esse credo."

# game/end_game2.rpy:2901
translate latin end_game2_9eaa2473:

    # "I settle with munching on my salty, potato chip-like dried vegetable, finding it sad that it's a bit better than most of the bland food on Adastra."
    "Contentus sum salsum olus siccatum, frustulo solani simile, manducare; triste invenio id paulum melius esse quam plerosque insipidos cibos Adastrae."

# game/end_game2.rpy:2902
translate latin end_game2_8842c6f0:

    # m "\"Did your parents like, ban you from eating anything sweet, or something?\""
    m "\"Parentes tui quasi tibi interdixerunt ne quid dulce ederes, aut aliquid tale?\""

# game/end_game2.rpy:2903
translate latin end_game2_1d179235:

    # "Amicus pauses, in the process of pouring half the bag into his muzzle before talking with his mouth full."
    "Amicus consistit dum dimidiam sacculi partem in os infundit, deinde ore pleno loquitur."

# game/end_game2.rpy:2905
translate latin end_game2_b8123cd3:

    # a "\"Oh, yeah, how didsh you knowfh?\""
    a "\"O, ita, quomodo scivishtih?\""

# game/end_game2.rpy:2906
translate latin end_game2_cd938aab_2:

    # "I grimace."
    "Vultum contraho."

# game/end_game2.rpy:2907
translate latin end_game2_7cc5d89d:

    # m "\"So that's how you ran out of food last time.\""
    m "\"Ita ergo superiore tempore cibi tibi defecerunt.\""

# game/end_game2.rpy:2908
translate latin end_game2_debf604d:

    # "Amicus chews for a while, then swallows."
    "Amicus aliquamdiu manducat, deinde deglutit."

# game/end_game2.rpy:2910
translate latin end_game2_6bf1ed18:

    # a "\"It's not like I'm always eating sweets. Virginia disallows me from doing so as well. I'm simply taking advantage of not being under supervision at the moment.\""
    a "\"Non quasi semper dulcia edam. Virginia quoque mihi id vetat. Tantum hac occasione utor quod nunc nemo me observat.\""

# game/end_game2.rpy:2911
translate latin end_game2_df07d238:

    # com "\"Amicus, your consumption of sugars has exceeded your daily limit. A report for Virginia has been filed and will be supplied to her upon our landing on Adastra.\""
    com "\"Amice, consumptio sacchari tui modum diurnum excessit. Relatio Virginiae destinata in tabulas relata est et ei tradetur cum in Adastram descenderimus.\""

# game/end_game2.rpy:2914
translate latin end_game2_c6cec3a0:

    # "Amicus pauses, then shrugs, pouring the rest of the bag into his mouth."
    "Amicus consistit, deinde umeros levat, reliquam sacculi partem in os infundens."

# game/end_game2.rpy:2915
translate latin end_game2_66683c06:

    # m "\"Well...as long as you have the parental tech to keep you healthy.\""
    m "\"Bene...dummodo artem Parentum habeas quae te sanum teneat.\""

# game/end_game2.rpy:2917
translate latin end_game2_2f669512:

    # a "\"We do. Everything in my body is regulated to normal levels once a month.\""
    a "\"Habemus. Omnia in corpore meo semel in mense ad solitos gradus temperantur.\""

# game/end_game2.rpy:2918
translate latin end_game2_6062bc35:

    # m "\"Wow, lucky you.\""
    m "\"Eho, felix es.\""

# game/end_game2.rpy:2919
translate latin end_game2_b8cafa0e:

    # a "\"So I am technically free from any poor choice I make diet-wise. I'm simply kept away from sweets to discipline my impulses.\""
    a "\"Ita re ipsa ab effectibus cuiuslibet mali consilii de victu tutus sum. Tantum a dulcibus arceor ut impetus mei disciplinentur.\""

# game/end_game2.rpy:2920
translate latin end_game2_7e169c95:

    # m "\"Well, that's clearly not working at all.\""
    m "\"Bene, id manifeste omnino non valet.\""

# game/end_game2.rpy:2921
translate latin end_game2_4dcc90dc:

    # "Amicus smirks at me before opening another bag of what looks like candy."
    "Amicus mihi subridet, deinde alium sacculum aperit eius quod dulciarium videtur."

# game/end_game2.rpy:2922
translate latin end_game2_7fefbd70:

    # "I glare at him, then poke him in the stomach, making him grunt."
    "Irate eum intueor, deinde ventrem eius digito impello, ita ut grunniat."

# game/end_game2.rpy:2923
translate latin end_game2_c4131717:

    # m "\"I think you're actually gaining a little more weight.\""
    m "\"Puto te vere paulum amplius ponderis adipisci.\""

# game/end_game2.rpy:2924
translate latin end_game2_16d95c51:

    # "The wolf clasps his stomach with a hard smack."
    "Lupus ventrem suum duro ictu complectitur."

# game/end_game2.rpy:2926
translate latin end_game2_1403f865:

    # a "\"This? It's part of my stature and is important for my center of gravity in combat.\""
    a "\"Hoc? Pars staturae meae est et ad centrum gravitatis meae in pugna magni momenti est.\""

# game/end_game2.rpy:2927
translate latin end_game2_6c6c25c1_1:

    # m "\"Oh really?\""
    m "\"Itane vero?\""

# game/end_game2.rpy:2928
translate latin end_game2_c299c7d5:

    # "I move to sit in Amicus's lap, rubbing my face against his bulk."
    "Me moveo ut in gremio Amici sedeam, vultum meum ad molem eius fricans."

# game/end_game2.rpy:2930
translate latin end_game2_07e892be:

    # a "\"Yes, you see how handily I handle you when we wrestle. Besides, you like it.\""
    a "\"Ita, vides quam facile te tractem cum luctamur. Praeterea tibi placet.\""

# game/end_game2.rpy:2931
translate latin end_game2_74308e0a:

    # "I rest my head against his chest, feeling the softness of his strong body swell around me with each breath he takes."
    "Caput pectori eius appono, mollitiem validi corporis eius sentiens, quod circa me singulis spiritibus intumescit."

# game/end_game2.rpy:2932
translate latin end_game2_596ed95f:

    # m "\"You got me there.\""
    m "\"Ibi me cepisti.\""

# game/end_game2.rpy:2935
translate latin end_game2_9a01d4e0:

    # "I listen to the candies clack around in his mouth, against his teeth and against each other."
    "Dulciaria in ore eius crepitantia audio, contra dentes et inter se."

# game/end_game2.rpy:2936
translate latin end_game2_c05ecdb2:

    # "I've been savoring everything about him that I can, even just these sounds of him eating candy."
    "Omnibus rebus quae de eo percipere possum attente fruor, etiam his sonis eius dulciaria edentis."

# game/end_game2.rpy:2937
translate latin end_game2_a1794a9f:

    # "We sit there in silence for a bit, becoming all too aware of the passage of time."
    "Ibi paulisper taciti sedemus, nimis conscii temporis praetereuntis facti."

# game/end_game2.rpy:2938
translate latin end_game2_a5e8d1c4:

    # "I take a deep breath."
    "Alte spiro."

# game/end_game2.rpy:2939
translate latin end_game2_b6ff93b6:

    # m "\"So...will we be able to communicate at all over the next eight years?\""
    m "\"Itaque...poterimusne omnino inter proximos octo annos colloqui?\""

# game/end_game2.rpy:2942
translate latin end_game2_101379c7:

    # "Amicus pauses, his mood lowering a bit to match mine."
    "Amicus consistit, animo eius paulum demisso ut meo similis fiat."

# game/end_game2.rpy:2944
translate latin end_game2_f6ac4877:

    # a "\"That's hard to say. I've wondered similar things, but I have not received an answer.\""
    a "\"Difficile est dicere. Similia miratus sum, sed responsum non accepi.\""

# game/end_game2.rpy:2945
translate latin end_game2_bfcf0b77:

    # "I sigh deeply."
    "Alte suspiro."

# game/end_game2.rpy:2946
translate latin end_game2_f9f0cc6b:

    # m "\"Sometimes I hate the parents.\""
    m "\"Interdum Parentes odi.\""

# game/end_game2.rpy:2948
translate latin end_game2_3b2f0338:

    # "Amicus laughs, a stark contrast to how he would have reacted to such a statement a year ago."
    "Amicus ridet, longe aliter ac tali dicto ante annum respondisset."

# game/end_game2.rpy:2949
translate latin end_game2_c6f31832:

    # a "\"They are frustrating, to say the least. I have a feeling that we will, though.\""
    a "\"Vexant nos, ut minimum dicam. Tamen fore ut colloquamur sentio.\""

# game/end_game2.rpy:2950
translate latin end_game2_9b78ca0f_3:

    # m "\"Yeah?\""
    m "\"Quid?\""

# game/end_game2.rpy:2952
translate latin end_game2_60095034:

    # a "\"Yes, they work in very mysterious ways. I believe it is clear now that the archives are not their only method of communication.\""
    a "\"Ita, valde occultis modis agunt. Credo iam manifestum esse tabularium non solam viam qua communicent esse.\""

# game/end_game2.rpy:2954
translate latin end_game2_d02e7e69:

    # a "\"I think the two of us joining together in say, a dream, would not be out of the realm of possibility.\""
    a "\"Puto nos ambos coniungi, exempli gratia in somnio, non extra fines rerum possibilium esse.\""

# game/end_game2.rpy:2955
translate latin end_game2_d2e44619:

    # "The confidence I'd originally felt while leaving Adastra is fading away at this point."
    "Fiducia quam initio sentiebam cum Adastram relinquerem nunc evanescit."

# game/end_game2.rpy:2956
translate latin end_game2_811249bf:

    # "Instead, I feel that familiar feeling of dread and uncertainty take over my mind."
    "Sed illum familiarem metus et dubitationis affectum mentem meam occupare sentio."

# game/end_game2.rpy:2957
translate latin end_game2_d4cccfa1:

    # "Yeah, I know what I'm doing now, but the whole process is so daunting."
    "Ita, iam scio quid faciam, sed totus processus tam formidolosus est."

# game/end_game2.rpy:2959
translate latin end_game2_ab7598f9:

    # "I hug Amicus harder, pressing my face into his fur, inhaling the lavender scent."
    "Amicum artius amplector, vultum meum in pilos eius premens, lavandulae odorem inhalans."

# game/end_game2.rpy:2960
translate latin end_game2_27dac8bf:

    # "I mumble into his chest."
    "In pectus eius murmuro."

# game/end_game2.rpy:2961
translate latin end_game2_98909c2e:

    # m "\"I'm scared.\""
    m "\"Timeo.\""

# game/end_game2.rpy:2963
translate latin end_game2_e6af50db:

    # a "\"Why's that? There is nothing to be afraid of.\""
    a "\"Cur? Nihil est quod timeas.\""

# game/end_game2.rpy:2964
translate latin end_game2_157e3bc7:

    # "I smile sadly, knowing just how untrue that is, that I have a hell of a struggle ahead of me."
    "Tristis rideo, sciens quam falsum id sit, quam ingens certamen ante me sit."

# game/end_game2.rpy:2965
translate latin end_game2_ba1b8208:

    # "Amicus hugs me tightly, nuzzling my hair."
    "Amicus me artius amplectitur, capillos meos rostro mulcens."

# game/end_game2.rpy:2966
translate latin end_game2_ccae94f4:

    # "Even now, he's managing to hold it together somehow, and that actually makes me feel a little grateful."
    "Etiam nunc nescio quomodo se continere potest, et id me re vera aliquantum gratum sentire facit."

# game/end_game2.rpy:2967
translate latin end_game2_aebded43:

    # "I don't know how I'd be able to do this if he was acting as unsure as I am right now."
    "Nescio quomodo hoc facere possem si tam incertus ageret quam ego nunc sum."

# game/end_game2.rpy:2968
translate latin end_game2_b4415a7e:

    # m "\"You know how big of a fuck up I am. What if I do something wrong?\""
    m "\"Scis quam magnus stultus sim. Quid si aliquid perperam facio?\""

# game/end_game2.rpy:2969
translate latin end_game2_292c202c:

    # "Amicus chuckles."
    "Amicus leniter ridet."

# game/end_game2.rpy:2971
translate latin end_game2_f0beb299:

    # a "\"I feel that the parents would not attempt this unless they themselves were certain of success. Simply follow their guidance.\""
    a "\"Sentio Parentes hoc non temptaturos esse nisi ipsi certi essent se successuros esse. Tantum ductum eorum sequere.\""

# game/end_game2.rpy:2972
translate latin end_game2_214d1e0a:

    # "I'm silent at that, and Amicus knows why."
    "His auditis taceo, et Amicus scit cur."

# game/end_game2.rpy:2974
translate latin end_game2_bbdca568:

    # a "\"I know that what we experienced with Cato was terrible. They weren't able to...{i}see{/i} as clearly. I know that they are much more confident here.\""
    a "\"Scio horribile fuisse quod cum Catone experti sumus. Non tam clare...{i}videre{/i} poterant. Scio eos hic multo fidentiores esse.\""

# game/end_game2.rpy:2975
translate latin end_game2_f62c6cee:

    # m "\"I don't know how I feel about being guided by gods that don't know what they're doing.\""
    m "\"Nescio quid sentiam de me a deis duci qui nesciunt quid faciant.\""

# game/end_game2.rpy:2977
translate latin end_game2_4261fb1e:

    # a "\"Well, they are not gods, which is why they are prone to mistakes, but the time I've spent communicating with them over the past year has left me a bit more confident in their capabilities.\""
    a "\"Bene, dei non sunt, ideo erroribus obnoxii sunt, sed tempus quod per annum proximum cum eis communicans egi me paulo magis facultatibus eorum confidere fecit.\""

# game/end_game2.rpy:2978
translate latin end_game2_61a16479:

    # "I squeeze my eyes, letting the small amount of tears that had built up get soaked into the wolf's fur so he doesn't see when I look up at him."
    "Oculos stringo, sinens paucas lacrimas quae cumulatae erant in pilos lupi imbibi, ne videat cum eum suspicio."

# game/end_game2.rpy:2979
translate latin end_game2_51e734c7:

    # m "\"Why's that?\""
    m "\"Cur?\""

# game/end_game2.rpy:2980
translate latin end_game2_7cb162c2:

    # "He smiles at me, placing a paw against my head and pushing it back down against his shoulder."
    "Mihi ridet, pedem anteriorem ad caput meum ponens et id rursus ad umerum suum deprimens."

# game/end_game2.rpy:2981
translate latin end_game2_3bc6f63c:

    # a "\"Well, they have far more tools at their disposal than we do. I mean, they actually see the future in some ways. If I must trust anyone with my future, it would be the parents.\""
    a "\"Bene, multo plura instrumenta in potestate habent quam nos. Hoc volo dicere: re vera futurum quibusdam modis vident. Si cuiquam de futuro meo confidere debeo, Parentibus confidam.\""

# game/end_game2.rpy:2982
translate latin end_game2_86105ec6:

    # m "\"Amicus, don't trust anyone but yourself.\""
    m "\"Amice, nemini nisi tibi ipsi confide.\""

# game/end_game2.rpy:2983
translate latin end_game2_d8fba367:

    # a "\"Hmph, I trust you.\""
    a "\"Hmph, tibi confido.\""

# game/end_game2.rpy:2984
translate latin end_game2_3f739ce1_5:

    # "I sigh."
    "Suspiro."

# game/end_game2.rpy:2985
translate latin end_game2_dba059f3:

    # m "\"I just don't wanna mess up and not be able to see you again.\""
    m "\"Tantum errare nolo et te rursus videre non posse.\""

# game/end_game2.rpy:2986
translate latin end_game2_91200abc:

    # "Amicus's expression grows stern."
    "Vultus Amici severus fit."

# game/end_game2.rpy:2988
translate latin end_game2_3be2d83d:

    # a "\"That will not happen. I will make sure of it, no matter what the parents say.\""
    a "\"Id non fiet. Ego curabo, quidquid Parentes dicant.\""

# game/end_game2.rpy:2989
translate latin end_game2_b176ac10:

    # m "\"But do we even have a choice? Does it bother you that it feels like we don't have a say in anything?\""
    m "\"Sed omnino eligere possumusne? Te vexat sentire quasi nihil decernere possimus?\""

# game/end_game2.rpy:2990
translate latin end_game2_f659f3eb:

    # "These are conversations we've had before, but for some reason, I keep flip-flopping on whether or not I actually do have a choice here."
    "Haec colloquia iam habuimus, sed nescio cur iterum iterumque sententiam mutem an re vera hic eligere possim necne."

# game/end_game2.rpy:2992
translate latin end_game2_9af128e7:

    # a "\"We do...we just have the advantage of knowing the alternatives, and that this path is much more desirable.\""
    a "\"Possumus...tantum commodum habemus quod alias vias novimus et hanc multo optabiliorem esse scimus.\""

# game/end_game2.rpy:2993
translate latin end_game2_5d3560b6:

    # "I'm reminded that while Amicus might be more open to criticizing the parents, he certainly still believes in their plan."
    "Admoneor Amicum, quamquam Parentes facilius vituperare possit, adhuc certe in consilium eorum credere."

# game/end_game2.rpy:2994
translate latin end_game2_b9b6913f:

    # "I don't know if I feel the same quite yet."
    "Nescio an iam idem sentiam."

# game/end_game2.rpy:2995
translate latin end_game2_5a5a7651:

    # m "\"You saw our future?\""
    m "\"Futurum nostrum vidisti?\""

# game/end_game2.rpy:2996
translate latin end_game2_a2303525:

    # "Amicus pauses, probably wondering if this is okay to share."
    "Amicus paulisper tacet, probabiliter mirans an hoc communicare liceat."

# game/end_game2.rpy:2997
translate latin end_game2_678190ea:

    # "He seems to make up his mind."
    "Decernere videtur."

# game/end_game2.rpy:2999
translate latin end_game2_35fc5f78:

    # a "\"Yes...it was beautiful.\""
    a "\"Ita...pulchrum erat.\""

# game/end_game2.rpy:3000
translate latin end_game2_c43ffbf0:

    # m "\"I just...I worry it's not really going to happen. I've only thought of it now, but what if they're leading us on?\""
    m "\"Tantum...timeo ne non re vera fiat. Modo id cogitavi, sed quid si nos vana spe ducunt?\""

# game/end_game2.rpy:3002
translate latin end_game2_0d249d23:

    # "Amicus grunts in surprise, clearly not having thought of that himself."
    "Amicus miratus grunnit, manifeste ipse de eo non cogitaverat."

# game/end_game2.rpy:3004
translate latin end_game2_3069fc0d:

    # a "\"They wouldn't do that...but I suppose there is some degree of trust that goes into this, yeah? We're here because of them, all of us are, and I have to trust that.\""
    a "\"Id non facerent...sed credo aliquam fidem hic requiri, ita? Hic propter eos sumus, omnes sumus, et ei rei confidere debeo.\""

# game/end_game2.rpy:3005
translate latin end_game2_bfcf0b77_1:

    # "I sigh deeply."
    "Alte suspiro."

# game/end_game2.rpy:3006
translate latin end_game2_7834fe91:

    # m "\"I just wish we could run away to some other peaceful planet, or something...\""
    m "\"Tantum cupio nos ad aliquem alium planetam tranquillum fugere posse, aut aliquid tale...\""

# game/end_game2.rpy:3007
translate latin end_game2_47b9dcbb:

    # m "\"...but I know we wouldn't be together unless we were meant to do this, so I guess that's partly why I'm going along with it.\""
    m "\"...sed scio: non una essemus nisi ad hoc faciendum destinati essemus, ita credo id partem causae esse cur consentiam.\""

# game/end_game2.rpy:3009
translate latin end_game2_fb78b564:

    # a "\"You know, judging by the vision, I think we will come to believe in our mission over time.\""
    a "\"Scis, ex visione iudicans, puto nos tempore in munus nostrum credere coepturos esse.\""

# game/end_game2.rpy:3010
translate latin end_game2_e2393303:

    # m "\"I hope so...\""
    m "\"Spero ita...\""

# game/end_game2.rpy:3013
translate latin end_game2_a1e3f2f4:

    # "Amicus slowly pulls me back to lie down with him, both of us lying on our sides as he spoons me."
    "Amicus lente me retrahit ut secum iaceam, ambo in lateribus iacentes dum ille me a tergo amplectitur."

# game/end_game2.rpy:3014
translate latin end_game2_f8eb9bc3:

    # "I try to think of something to say, anything, really."
    "Aliquid quod dicam excogitare conor, quidlibet re vera."

# game/end_game2.rpy:3015
translate latin end_game2_dbdca12e:

    # "Time is truly running out now, but I still come up short."
    "Tempus nunc vere deficit, sed adhuc nihil invenio."

# game/end_game2.rpy:3016
translate latin end_game2_a3821cb5:

    # "Instead, I lie back against Amicus, amongst the many silver wrappers of food, listening to him suck on his candies."
    "Sed Amico innixus iaceo, inter multa argentea ciborum involucra, eum dulciaria sugentem audiens."

# game/end_game2.rpy:3017
translate latin end_game2_8f4ffbe9:

    # "It's comfortable, and for a moment, I let go of my worries, and the tiredness of the night before catches up to me..."
    "Commodum est, et paulisper sollicitudines depono, lassitudoque noctis superioris me tandem assequitur..."

# game/end_game2.rpy:3021
translate latin end_game2_4a5495fc:

    # com "\"Exiting the stretch drive. Prepare for arrival in 20 minutes.\""
    com "\"Usus Propulsoris Distensionis finitur. Parate vos ad adventum post 20 minuta.\""

# game/end_game2.rpy:3022
translate latin end_game2_8d066a1b:

    # "I come to with a sudden jolt, Amicus jumping behind me as well."
    "Subito impetu ad me redeo, Amico quoque post me subsiliente."

# game/end_game2.rpy:3023
translate latin end_game2_56247dfb:

    # "I sit up, rubbing my eyes."
    "Me erigo et sedeo, oculos fricans."

# game/end_game2.rpy:3024
translate latin end_game2_e94f0c99:

    # m "\"Wait, already?\""
    m "\"Exspecta, iam?\""

# game/end_game2.rpy:3025
translate latin end_game2_d6eacefe:

    # "Amicus sits up next to me, a paw on my back."
    "Amicus iuxta me se erigit et sedet, pede anteriore in dorso meo posito."

# game/end_game2.rpy:3027
translate latin end_game2_012c0fd7_3:

    # a "\"Are you alright?\""
    a "\"Bene vales?\""

# game/end_game2.rpy:3028
translate latin end_game2_53dca22a:

    # m "\"Dammit, Amicus! We were supposed to stay up!\""
    m "\"Damnatio, Amice! Vigilare debebamus!\""

# game/end_game2.rpy:3029
translate latin end_game2_e8a5fa04:

    # "There's a sinking feeling in my chest as I realize we've slept away most of the time we had to travel."
    "Pectus mihi quasi cadit, cum intellego nos maximam temporis itineris partem dormiendo amisisse."

# game/end_game2.rpy:3030
translate latin end_game2_edc9a3e2:

    # m "\"Why'd you let me fall asleep?\""
    m "\"Cur me obdormire sivisti?\""

# game/end_game2.rpy:3031
translate latin end_game2_4c215b44:

    # "I look at him accusingly, even as my eyes start to blur with tears."
    "Accusans eum intueor, etiam dum oculi mei lacrimis turbari incipiunt."

# game/end_game2.rpy:3033
translate latin end_game2_179c0f6a:

    # a "\"Sorry, we were both so tired. You seemed at peace and I didn't—\""
    a "\"Ignosce, ambo tam fessi eramus. Pacatus videbaris et non...\""

# game/end_game2.rpy:3034
translate latin end_game2_f88c4071:

    # m "\"Ugh!\""
    m "\"Ah!\""

# game/end_game2.rpy:3035
translate latin end_game2_d6d833cf:

    # "I throw off the blanket that Amicus had pulled over us, and step out of bed, turning away in case I break down like a little kid."
    "Stragulum quod Amicus super nos traxerat abicio et e lecto surgo, me avertens ne quasi puerulus frangar."

# game/end_game2.rpy:3036
translate latin end_game2_804cd142_2:

    # a "\"[mc]?\""
    a "\"[mc]?\""

# game/end_game2.rpy:3038
translate latin end_game2_877825e2:

    # "I act like I don't hear him, moving to the cockpit area to look out the windows."
    "Fingo me eum non audire, ad locum navis regendae me movens ut per fenestras prospiciam."

# game/end_game2.rpy:3039
translate latin end_game2_34fc6f0f:

    # "Sure enough, we're no longer in the stretch, instead drifting toward a familiar globe in the distance."
    "Sane, non iam in Distensione sumus, sed ad familiarem globum in longinquo ferimur."

# game/end_game2.rpy:3040
translate latin end_game2_db9580bb:

    # com "\"Approaching Earth. Will arrive at [mc]'s residence in Rome, Italy.\""
    com "\"Ad Terram accedimus. Ad habitaculum [mc] Romae in Italia perveniemus.\""

# game/end_game2.rpy:3041
translate latin end_game2_5b2e4ab4:

    # "A heavy paw rests on my back."
    "Gravis pes anterior in dorso meo quiescit."

# game/end_game2.rpy:3043
translate latin end_game2_804cd142_3:

    # a "\"[mc]?\""
    a "\"[mc]?\""

# game/end_game2.rpy:3044
translate latin end_game2_439afc74:

    # m "\"We're out of time.\""
    m "\"Tempus nobis defecit.\""

# game/end_game2.rpy:3045
translate latin end_game2_70212395:

    # "The lump in my throat makes it hard to talk."
    "Nodus in gutture meo difficilem facit sermonem."

# game/end_game2.rpy:3046
translate latin end_game2_996d7d4c:

    # "Slowly, Amicus hugs me."
    "Lente Amicus me amplectitur."

# game/end_game2.rpy:3048
translate latin end_game2_1707b5d5:

    # a "\"[mc], we did have time. Several months, in fact. A few hours on a ship is no time lost.\""
    a "\"[mc], tempus habuimus. Aliquot menses, re vera. Paucae horae in nave non sunt tempus amissum.\""

# game/end_game2.rpy:3049
translate latin end_game2_3b638a02:

    # m "\"Any time is time lost at this point.\""
    m "\"Quodlibet tempus iam tempus amissum est.\""

# game/end_game2.rpy:3050
translate latin end_game2_4f81d612:

    # "Amicus doesn't say anything, and I lean my head back against him, swallowing down my bitter attitude because I'm not about to let it ruin our last moments together."
    "Amicus nihil dicit, et caput rursus ei appono, amaritudinem meam reprimens, quia eam ultima nostra momenta una corrumpere non sinam."

# game/end_game2.rpy:3051
translate latin end_game2_56db9361:

    # m "\"Sorry, I'm just...I'm not ready.\""
    m "\"Ignosce, tantum...paratus non sum.\""

# game/end_game2.rpy:3053
translate latin end_game2_c6ffc902:

    # a "\"I'll be able to come into your apartment. We do still have a bit of time left, you know.\""
    a "\"Habitaculum tuum intrare potero. Adhuc paulum temporis reliqui habemus, scis.\""

# game/end_game2.rpy:3054
translate latin end_game2_594ab045:

    # "I nod quietly, allowing Amicus to hold me for a bit until we have to get back in our seats for reentry."
    "Tacite annuo, sinens Amicum me paulisper tenere donec ad sedes nostras ad reditum in atmosphaeram redire debemus."

# game/end_game2.rpy:3055
translate latin end_game2_d83f97cc:

    # "I feel slightly queasy as we approach Earth at an unreal speed."
    "Aliquantum nauseae sentio dum celeritate incredibili ad Terram accedimus."

# game/end_game2.rpy:3056
translate latin end_game2_7243d27a:

    # "I quickly spot Europe, the brilliant sprawl of lights spanning the continent as a whole are far more intense than any city on Adastra."
    "Europam celeriter conspicio; splendida luminum copia totam continentem tegens multo vehementior est quam ulla urbs Adastrae."

# game/end_game2.rpy:3057
translate latin end_game2_06614ebd:

    # "Italy's characteristic, boot-like shape stands out from the darkness of the seas that surround it."
    "Propria Italiae forma, caligae similis, e tenebris marium quae eam circumdant eminet."

# game/end_game2.rpy:3058
translate latin end_game2_10650f21:

    # "I focus on the glittering patch that I know is Rome, and within seconds, we're descending into it."
    "In nitentem maculam, quam Romam esse scio, intentus sum, et intra secunda in eam descendimus."

# game/end_game2.rpy:3059
translate latin end_game2_93ef3f53:

    # m "\"Won't everyone see us?\""
    m "\"Nonne omnes nos videbunt?\""

# game/end_game2.rpy:3061
translate latin end_game2_33370920:

    # a "\"We're cloaked.\""
    a "\"Occultati sumus.\""

# game/end_game2.rpy:3062
translate latin end_game2_ff84f538:

    # "I trust what the wolf says, even though I haven't noticed any difference."
    "Lupi verbis confido, quamquam nullam differentiam animadverti."

# game/end_game2.rpy:3063
translate latin end_game2_f085db4d:

    # "We continue to descend at a rapid pace, and as we approach a block of apartments, I grip onto the seat in anticipation of a hard landing...but our sudden, yet gradual halt is gentle."
    "Celeriter descendere pergimus et, cum ad insulam habitaculorum accedimus, sedem stringo, durum descensum exspectans...sed subita, tamen gradatim facta, statio nostra lenis est."

# game/end_game2.rpy:3064
translate latin end_game2_306a1e01:

    # "We come to a rest on the roof of my residence."
    "In tecto habitationis meae consistimus."

# game/end_game2.rpy:3067
translate latin end_game2_3cbfe647:

    # m "\"You landed on the roof?\""
    m "\"In tecto descendisti?\""

# game/end_game2.rpy:3068
translate latin end_game2_17c9e486:

    # a "\"Indeed! There was no room elsewhere.\""
    a "\"Ita sane! Alibi locus non erat.\""

# game/end_game2.rpy:3071
translate latin end_game2_f60faedf:

    # "Amicus opens the door and jumps out, and again I'm worried about being seen."
    "Amicus ianuam aperit et desilit, et rursus timeo ne videamur."

# game/end_game2.rpy:3072
translate latin end_game2_2fe3ac56:

    # "But when he helps me out, I realize how dark it is."
    "Sed cum me egredi adiuvat, intellego quam tenebrosum sit."

# game/end_game2.rpy:3074
translate latin end_game2_971ddec4:

    # com "\"Stretch schedule indicates liftoff should commence in fifteen minutes.\""
    com "\"Ordo Distensionis indicat ascensum post quindecim minuta incipiendum esse.\""

# game/end_game2.rpy:3075
translate latin end_game2_0999bc16:

    # "Another twist in my chest as we're down to literally minutes."
    "Pectus mihi rursus torquetur, cum vere tantum minuta iam restant."

# game/end_game2.rpy:3076
translate latin end_game2_d5504aa5:

    # "Amicus leads the way to a fire escape, and I'm struck by how strange it is seeing my wolf framed by this human world."
    "Amicus ad scalam incendii praeeit, et me ferit quam mirum sit lupum meum in hoc mundo humano videre."

# game/end_game2.rpy:3077
translate latin end_game2_5e1a1860:

    # "The sights of Rome, the sounds of distant traffic...it almost makes me dizzy with how familiar it is despite having been away for so long."
    "Imagines Romae, soni vehiculorum longinquorum...paene vertiginem mihi faciunt, cum tam familiaria sint quamquam tamdiu afui."

# game/end_game2.rpy:3078
translate latin end_game2_2495cac8:

    # "Amicus stops at a balcony, and I trust that it's the one to my apartment as he boldly slides open the door, apparently aware that the landlord never seems to keep it locked."
    "Amicus ad maenianum consistit, quod meum habitaculum esse confido, dum audacter ianuam delabendo aperit, manifeste sciens dominum aedium numquam eam seratam tenere videri."

# game/end_game2.rpy:3080
translate latin end_game2_86f74186:

    # "I step inside, and through the darkness I can see that my personal belongings are gone, obviously."
    "Intro, et per tenebras videre possum res meas proprias abesse, sane."

# game/end_game2.rpy:3081
translate latin end_game2_cd8494ae:

    # "It's cleaned out and looks just about the same as when I first got there."
    "Purgatum est et fere idem videtur ac cum primum huc veni."

# game/end_game2.rpy:3082
translate latin end_game2_454f3fc6:

    # "It's empty, luckily, and I wonder if anyone has stayed here since I went missing...probably not if there was an investigation."
    "Vacuum est, feliciter, et miror an quisquam hic manserit ex quo evanui...probabiliter non, si inquisitio facta est."

# game/end_game2.rpy:3083
translate latin end_game2_1e7abf94:

    # "I swallow hard, remembering how much media coverage and documentaries there were about the two Canadian and British students that went missing here a few years ago."
    "Difficulter deglutio, memor quantum de duobus studentibus, Canadensi et Britannico, qui ante paucos annos hic evanuerunt, in nuntiis et pelliculis documentalibus dictum sit."

# game/end_game2.rpy:3084
translate latin end_game2_c0da18f8:

    # "And the coverage of an Australian student who disappeared a week before I arrived."
    "Et nuntiorum de studente Australiano qui una hebdomade ante adventum meum evanuit."

# game/end_game2.rpy:3085
translate latin end_game2_5cb97e2e:

    # "I hope I didn't get the same treatment while I was away, but I get the feeling that I must have."
    "Spero me non idem passum esse dum afui, sed sentio ita fuisse debere."

# game/end_game2.rpy:3086
translate latin end_game2_807ce233:

    # "I shake my head, once again wondering where to even begin."
    "Caput quatio, iterum mirans unde omnino incipiam."

# game/end_game2.rpy:3087
translate latin end_game2_0a6b7a02:

    # "I turn around, seeing Amicus standing there, and immediately I get a painful, stabbing feeling between my throat and chest."
    "Me verto et Amicum ibi stantem video, et statim dolor pungens inter guttur et pectus meum oritur."

# game/end_game2.rpy:3090
translate latin end_game2_31c4f819:

    # "His pose and demeanor, it's finally reflecting that our time together is coming to an end."
    "Status et habitus eius tandem ostendunt tempus nostrum una finiri."

# game/end_game2.rpy:3091
translate latin end_game2_9bd7486e:

    # "We both stand a few feet apart, unsure of what to say."
    "Ambo paucis pedibus inter nos distantibus stamus, incerti quid dicamus."

# game/end_game2.rpy:3092
translate latin end_game2_0fb53a3f:

    # a "\"Well...\""
    a "\"Bene...\""

# game/end_game2.rpy:3093
translate latin end_game2_bf023949_1:

    # m "\"Yeah...\""
    m "\"Ita...\""

# game/end_game2.rpy:3094
translate latin end_game2_970b8cff:

    # a "\"I suppose we should begin our farewells.\""
    a "\"Credo nos valedicere incipere debere.\""

# game/end_game2.rpy:3095
translate latin end_game2_5f9934dd:

    # m "\"Yeah, until next time, at least.\""
    m "\"Ita, saltem usque ad proximum congressum.\""

# game/end_game2.rpy:3097
translate latin end_game2_4931bf63:

    # a "\"Yes, it will only be a moment in the overall time that we will have together.\""
    a "\"Ita, momentum tantum erit in toto tempore quod una habebimus.\""

# game/end_game2.rpy:3098
translate latin end_game2_ee099986:

    # m "\"Yeah, I'll bet when you come back to get me we'll be like 'wow, it was only yesterday you dropped me off'.\""
    m "\"Ita, credo cum redieris ut me accipias dicemus 'Eho, heri tantum me hic deposuisti'.\""

# game/end_game2.rpy:3100
translate latin end_game2_fb02bdad:

    # a "\"Of course! Not even a full day. It will feel like hours, I'm sure.\""
    a "\"Sane! Ne totus quidem dies. Horis simile erit, certus sum.\""

# game/end_game2.rpy:3101
translate latin end_game2_1b3c39a4:

    # m "\"The parents called it a cosmic microsecond, or something.\""
    m "\"Parentes microsecundum cosmicum id appellaverunt, aut aliquid tale.\""

# game/end_game2.rpy:3103
translate latin end_game2_637c150f:

    # a "\"Ah, well, probably a bit longer than a microsecond, though I'm unsure of the length of a cosmic one.\""
    a "\"Ah, bene, probabiliter paulo longius quam microsecundum, quamquam nescio quam longum cosmicum sit.\""

# game/end_game2.rpy:3104
translate latin end_game2_172ae19f:

    # m "\"Eight years, I guess.\""
    m "\"Octo anni, credo.\""

# game/end_game2.rpy:3105
translate latin end_game2_f427483d:

    # a "\"I suppose that would be the case.\""
    a "\"Credo ita esse.\""

# game/end_game2.rpy:3107
translate latin end_game2_c69f7fea:

    # "I try not to think about all of the things that are gonna make me cry."
    "Conor de omnibus quae me flere facient non cogitare."

# game/end_game2.rpy:3108
translate latin end_game2_77d5c128:

    # "Like the thought of not waking up to Amicus for the first time in months."
    "Velut primum post menses non ad Amicum expergisci."

# game/end_game2.rpy:3109
translate latin end_game2_b6b7722a:

    # "Or the fact that I won't have someone to really talk to at the end of the day."
    "Aut quod non habebo quocum vere in fine diei loquar."

# game/end_game2.rpy:3110
translate latin end_game2_5dbfd66b:

    # "That I won't have someone who's just genuinely kind and loving toward me like no one ever was before."
    "Quod non habebo aliquem qui tantum vere benignus et amans erga me sit, ut nemo umquam antea fuit."

# game/end_game2.rpy:3111
translate latin end_game2_e78a2baf:

    # "I swallow the lump in my throat again."
    "Nodum in gutture rursus deglutio."

# game/end_game2.rpy:3112
translate latin end_game2_631d7925:

    # "No, I'll have time to fall apart as soon as he leaves."
    "Non, tempus habebo frangendi simul ac discesserit."

# game/end_game2.rpy:3113
translate latin end_game2_dd324444:

    # "I step forward and hug Amicus, burying my face in the warmth of his furry body, breathing in his scent."
    "Procedo et Amicum amplector, vultum in calore pilosi corporis eius mergens, odorem eius inhalans."

# game/end_game2.rpy:3114
translate latin end_game2_1e2c97cd:

    # "I'm determined to imprint this moment in my mind, something to help weather what I'm sure will be a hard eight years."
    "Hoc momentum menti meae imprimere constitui, aliquid quod adiuvet ferre octo annos quos certe difficiles fore credo."

# game/end_game2.rpy:3115
translate latin end_game2_b6ad4e45:

    # "He rocks us back and forth for a moment, kissing my head like he always does."
    "Nos paulisper huc illuc movet, caput meum osculans ut semper facit."

# game/end_game2.rpy:3117
translate latin end_game2_9c4740e4:

    # a "\"You are more than prepared for this. You're strong. Why else would you have been chosen?\""
    a "\"Plus quam paratus ad hoc es. Fortis es. Cur aliter electus esses?\""

# game/end_game2.rpy:3118
translate latin end_game2_9dba4ef2:

    # m "\"Thanks, and you'll continue to be an amazing emperor, Amicus.\""
    m "\"Gratias, et mirabilis imperator esse perges, Amice.\""

# game/end_game2.rpy:3119
translate latin end_game2_72ecb279:

    # a "\"Here's hoping.\""
    a "\"Ita speremus.\""

# game/end_game2.rpy:3120
translate latin end_game2_6d0db448:

    # m "\"Though I still don't even know what to do right now, to be honest. Like...do I just walk out into the street next?\""
    m "\"Quamquam adhuc ne scio quidem quid nunc faciam, ut verum dicam. Quasi...deinde tantum in viam egrediar?\""

# game/end_game2.rpy:3121
translate latin end_game2_0e2194aa:

    # a "\"Oh!\""
    a "\"Oh!\""

# game/end_game2.rpy:3123
translate latin end_game2_f6ddb43f:

    # "Amicus steps back, feeling around his cape and trousers."
    "Amicus recedit, pallium et bracas manibus explorans."

# game/end_game2.rpy:3124
translate latin end_game2_6df13a2b:

    # a "\"I really hope I remembered...ah! Here.\""
    a "\"Valde spero me meminisse...ah! Ecce.\""

# game/end_game2.rpy:3126
translate latin end_game2_52e7d62d:

    # "Amicus pulls out a slim, silver rod about a foot long."
    "Amicus tenuem argenteam virgam, pedem fere longam, profert."

# game/end_game2.rpy:3127
translate latin end_game2_55aa6726:

    # "It's one of those holographic tablets that I see the imperial family carrying around every now and then, aside from Amicus."
    "Una est ex illis tabulis holographicis quas familiam imperatoriam, excepto Amico, interdum portare video."

# game/end_game2.rpy:3128
translate latin end_game2_b9df3ae8:

    # "I've gotten the impression that he just isn't fond of electronics."
    "Intellexisse videor eum instrumentis electronicis tantum non delectari."

# game/end_game2.rpy:3129
translate latin end_game2_818ead87:

    # a "\"The parents have instructed me to give you this. It will connect to your lingua which will transmit and display information that you might need.\""
    a "\"Parentes mihi praeceperunt ut hoc tibi darem. Linguae tuae coniungetur, quae notitias quibus egere possis transmittet et ostendet.\""

# game/end_game2.rpy:3131
translate latin end_game2_f2641ef5:

    # a "\"Otherwise, all communication will be through the lingua.\""
    a "\"Alioquin omnis communicatio per Linguam fiet.\""

# game/end_game2.rpy:3132
translate latin end_game2_98848e85:

    # "I reach out, taking it, the cold metal light in my hands."
    "Manum porrigo et eam capio, frigido metallo levi in manibus meis."

# game/end_game2.rpy:3133
translate latin end_game2_8017a82f:

    # m "\"You almost forgot to give it to me.\""
    m "\"Paene oblitus es mihi eam dare.\""

# game/end_game2.rpy:3134
translate latin end_game2_cb0de06e:

    # a "\"Ah yeah, well, I did remember!\""
    a "\"Ah, ita, bene, memini tamen!\""

# game/end_game2.rpy:3135
translate latin end_game2_d2a45720:

    # "I sigh, turning the rod over in my hands."
    "Suspiro, virgam in manibus versans."

# game/end_game2.rpy:3136
translate latin end_game2_f7bdbd71:

    # a "\"You turn it on by tapping the top.\""
    a "\"Summam partem tangendo accendis.\""

# game/end_game2.rpy:3137
translate latin end_game2_3df08bdd:

    # "I do as I'm told, and a blue, glowing plane slides out from the rod, like a page attached to the spine of a book."
    "Ut iussus facio, et planum caeruleum lucens e virga elabitur, quasi pagina spinae libri coniuncta."

# game/end_game2.rpy:3138
translate latin end_game2_662adaae:

    # "It's blank for now, though I know what will appear soon enough."
    "Nunc vacuum est, quamquam scio quid satis mox apparebit."

# game/end_game2.rpy:3139
translate latin end_game2_acf47a32:

    # a "\"Just wait until they offer instructions.\""
    a "\"Tantum exspecta donec praecepta praebeant.\""

# game/end_game2.rpy:3140
translate latin end_game2_1f228d29:

    # m "\"Okay.\""
    m "\"Bene.\""

# game/end_game2.rpy:3141
translate latin end_game2_9fa62191:

    # "I tap the top of the rod again, and the hologram recedes."
    "Summam virgae partem rursus tango et hologramma recedit."

# game/end_game2.rpy:3142
translate latin end_game2_9b5d30f2:

    # "Another awkward moment of silence, then..."
    "Aliud incommodum silentii momentum, deinde..."

# game/end_game2.rpy:3144
translate latin end_game2_b8e2c1d4:

    # a "\"[mc], I am so happy to have met you, and I thank you. You have made me a better man, and though this will be painful...\""
    a "\"[mc], tam laetus sum quod tibi occurri, et gratias tibi ago. Meliorem virum me fecisti, et quamquam hoc dolorosum erit...\""

# game/end_game2.rpy:3145
translate latin end_game2_e85fc289:

    # "Amicus's voice cracks."
    "Vox Amici frangitur."

# game/end_game2.rpy:3146
translate latin end_game2_3096fbf9:

    # "His resolve to remain strong finally gives in."
    "Propositum eius fortem manendi tandem cedit."

# game/end_game2.rpy:3148
translate latin end_game2_517612c7:

    # a "\"I will think of you every day, and we will meet again in eight years, no matter what might happen between now and then. I will see you again.\""
    a "\"Cotidie de te cogitabo, et post octo annos rursus conveniemus, quidquid inter nunc et tum accidat. Te rursus videbo.\""

# game/end_game2.rpy:3149
translate latin end_game2_67d12781:

    # "His voice is strained as he struggles to get his words out."
    "Vox eius intenta est dum verba emittere laborat."

# game/end_game2.rpy:3150
translate latin end_game2_4132310d:

    # "Then the tears really begin spilling over."
    "Tum lacrimae vere effundi incipiunt."

# game/end_game2.rpy:3151
translate latin end_game2_b862337b:

    # a "\"Dammit...\""
    a "\"Malum...\""

# game/end_game2.rpy:3152
translate latin end_game2_def3bd9e:

    # "Amicus raises a paw to cover his face in frustration, like he actually planned on not crying before we parted ways."
    "Amicus pedem anteriorem tollit ut vultum vexatus tegat, quasi re vera non flere ante discessum nostrum proposuerit."

# game/end_game2.rpy:3153
translate latin end_game2_8bee5b33:

    # "And I find that silly, because of course we'd cry."
    "Idque stultum invenio, quia sane fleremus."

# game/end_game2.rpy:3154
translate latin end_game2_86e2be74:

    # "I'm doing the same as I move forward and wrap him up in a tight, almost desperate hug."
    "Idem facio dum procedo et eum artissimo, paene desperato amplexu complector."

# game/end_game2.rpy:3155
translate latin end_game2_46cb2b76:

    # "He crushes me to his body, letting out a loud, gasping sob through his teeth as I feel the wetness of his tears land on my head."
    "Me corpori suo comprimit, magnum anhelum singultum per dentes emittens, dum umorem lacrimarum eius in caput meum cadere sentio."

# game/end_game2.rpy:3156
translate latin end_game2_8803deb2:

    # a "\"I love you, so much, [mc].\""
    a "\"Te amo, tam vehementer, [mc].\""

# game/end_game2.rpy:3157
translate latin end_game2_58124b9d_1:

    # m "\"I love you, too.\""
    m "\"Ego quoque te amo.\""

# game/end_game2.rpy:3158
translate latin end_game2_508df55c:

    # a "\"Like I've said, this is simply a stone in the way of our chariot's wheel. These few years are simply the push, and we'll be on our way again.\""
    a "\"Ut dixi, hoc tantum lapis est in via rotae currus nostri. Hi pauci anni tantum impulsus sunt, et iter rursus faciemus.\""

# game/end_game2.rpy:3159
translate latin end_game2_a60f8192:

    # m "\"And things will get easier over time.\""
    m "\"Et res tempore faciliores fient.\""

# game/end_game2.rpy:3160
translate latin end_game2_5db79e76:

    # a "\"Without a doubt. And remember your ring. Though I might be moving away, I'm moving right toward you from the other side. We are permanently connected.\""
    a "\"Sine dubio. Et anulum tuum memento. Quamquam recedam, ex altera parte recta ad te moveor. In perpetuum coniuncti sumus.\""

# game/end_game2.rpy:3161
translate latin end_game2_39466036:

    # m "\"Yeah, the universe is spherical. I don't care about the other theories.\""
    m "\"Ita, universum sphaericum est. Ceteras doctrinas non curo.\""

# game/end_game2.rpy:3162
translate latin end_game2_d398dc15:

    # "We both stand there, holding each other, trembling and sobbing."
    "Ambo ibi stamus, nos invicem tenentes, trementes et singultientes."

# game/end_game2.rpy:3163
translate latin end_game2_a7dd8130:

    # "After a few minutes though, we both calm down a little, and eventually, I hear Com buzz faintly in Amicus's ear."
    "Post pauca tamen minuta ambo paulum sedamur, et tandem Com in aure Amici leniter crepitantem audio."

# game/end_game2.rpy:3164
translate latin end_game2_822054cf:

    # com "\"Liftoff sequence should be engaged in one minute.\""
    com "\"Ordo ascendendi post unum minutum ineundus est.\""

# game/end_game2.rpy:3165
translate latin end_game2_0a70f745:

    # "Amicus steps back, firmly gripping my shoulders."
    "Amicus recedit, umeros meos firmiter tenens."

# game/end_game2.rpy:3166
translate latin end_game2_6d15b3db:

    # "He's smiling through the tears."
    "Per lacrimas ridet."

# game/end_game2.rpy:3169
translate latin end_game2_6707c500:

    # a "\"And I think we shall see each other before then. The parents are mysterious, like I said.\""
    a "\"Et puto nos ante illud tempus invicem visuros esse. Parentes occultis modis agunt, ut dixi.\""

# game/end_game2.rpy:3170
translate latin end_game2_259ceaf3:

    # m "\"Definitely.\""
    m "\"Certe.\""

# game/end_game2.rpy:3171
translate latin end_game2_717dc03b:

    # a "\"[mc], my lover, my partner, my future husband...I love you.\""
    a "\"[mc], mi amans, mi consors, mi marite future...te amo.\""

# game/end_game2.rpy:3172
translate latin end_game2_5dc4852f:

    # m "\"And you know I love you too.\""
    m "\"Et scis me quoque te amare.\""

# game/end_game2.rpy:3173
translate latin end_game2_65b7c8ba:

    # "Amicus pulls me against his chest again, hard, squeezing me."
    "Amicus me rursus ad pectus suum vehementer trahit, stringens."

# game/end_game2.rpy:3174
translate latin end_game2_36d0c4c6:

    # a "\"You will have amazing success here. And I'll see you soon, very soon.\""
    a "\"Hic mirabiliter succedes. Et mox te videbo, valde mox.\""

# game/end_game2.rpy:3176
translate latin end_game2_2325f10f:

    # "He plants a kiss on my mouth, and I have just enough time to kiss back before my wolf turns away and disappears out the balcony door."
    "Os meum osculatur, et vix tempus habeo vicissim osculandi antequam lupus meus se avertit et per ianuam maeniani evanescit."

# game/end_game2.rpy:3178
translate latin end_game2_1b2fdbd5:

    # "I listen to the metallic sounds of his footsteps hurrying up the fire escape, then nothing until there's a soft hum that I can only imagine is the ship before it's silent again."
    "Metallicos passuum eius sonos audio, dum per scalam incendii sursum festinat, deinde nihil, donec lenis fremitus auditur, quem tantum navis esse fingere possum, antequam rursus silentium fit."

# game/end_game2.rpy:3179
translate latin end_game2_ddd0176b:

    # "I stand there in the dark room, feeling a little stunned before moving to turn on the light."
    "Ibi in tenebroso cubiculo sto, paulum attonitus, deinde ad lumen accendendum me moveo."

# game/end_game2.rpy:3182
translate latin end_game2_e065ae85:

    # "I stand there, staring, unsure of how to feel."
    "Ibi sto, fixis oculis intuens, incertus quid sentiam."

# game/end_game2.rpy:3183
translate latin end_game2_07d27da8:

    # "For the moment, it's mostly just an empty feeling, one that I'm sure will start to ache as I come to realize how lonely I actually am."
    "Nunc praecipue vacuus quidam affectus est, qui certe dolere incipiet cum intellexero quam solus re vera sim."

# game/end_game2.rpy:3184
translate latin end_game2_daa339cf:

    # "For now though, I move to the desk, waiting, thinking."
    "Nunc tamen ad mensam scriptoriam venio, exspectans, cogitans."

# game/end_game2.rpy:3185
translate latin end_game2_c4e50a7c:

    # "Then I set the metal rod on top of the desk and tap the top."
    "Tum virgam metallicam in mensa pono et summam partem tango."

# game/end_game2.rpy:3186
translate latin end_game2_c900e762:

    # "The blue plane appears again, and I stare at it."
    "Planum caeruleum rursus apparet, et id fixis oculis intueor."

# game/end_game2.rpy:3187
translate latin end_game2_ba915328:

    # "It's blank, and I start to wonder if I should keep it open."
    "Vacuum est, et mirari incipio an apertum tenere debeam."

# game/end_game2.rpy:3188
translate latin end_game2_c1cdcdec:

    # "I already know what I need to do."
    "Iam scio quid facere debeam."

# game/end_game2.rpy:3189
translate latin end_game2_05ec5fd3:

    # "Maybe I should try to get some more sleep before facing what I'm sure will be a chaotic day."
    "Fortasse plus dormire conari debeo antequam diem certe turbulentum obeam."

# game/end_game2.rpy:3190
translate latin end_game2_ab563208:

    # "At that moment though, I feel a twitch in my left eyelid."
    "Illo tamen momento motum in sinistra palpebra mea sentio."

# game/end_game2.rpy:3191
translate latin end_game2_48ade3ce:

    # "Then words appear on the blue plane."
    "Tum verba in plano caeruleo apparent."

# game/end_game2.rpy:3192
translate latin end_game2_773f7379:

    # "\"Proceed to the European Commission offices. The committee is expecting your arrival in one hour and twenty minutes.\""
    "\"Ad officia Commissionis Europaeae procede. Consilium adventum tuum post unam horam et viginti minuta exspectat.\""

# game/end_game2.rpy:3193
translate latin end_game2_c92339e8:

    # "I read the words, knowing that the parents have already made contact here."
    "Verba lego, sciens Parentes iam hic contactum fecisse."

# game/end_game2.rpy:3194
translate latin end_game2_f9b221ad:

    # "They didn't leave me alone to try and convince Earth of the {i}Galaxias{/i}."
    "Non me solum reliquerunt ut Terrae de {i}Galaxias{/i} persuadere conarer."

# game/end_game2.rpy:3195
translate latin end_game2_b3e1c93d:

    # "I look around, as if I have something to take with me."
    "Circumspicio, quasi aliquid habeam quod mecum feram."

# game/end_game2.rpy:3196
translate latin end_game2_ded7b988:

    # "But no, I'm still in my robes."
    "Sed non, adhuc tunicis indutus sum."

# game/end_game2.rpy:3197
translate latin end_game2_a3c2744b:

    # "People will probably just think I'm a street performer or a crazy tourist."
    "Homines probabiliter me tantum scaenicum viarum aut peregrinatorem insanum esse putabunt."

# game/end_game2.rpy:3198
translate latin end_game2_82a747e9:

    # "...At three in the morning."
    "...Hora tertia matutina."

# game/end_game2.rpy:3199
translate latin end_game2_9de2bada:

    # "My eyelid twitches again and a map appears on the screen, showing me a half hour walk through various alleys and backstreets, meant to keep me out of sight, I imagine."
    "Palpebra mea rursus tremit et tabula geographica in schermate apparet, dimidiae horae ambulationem per varios angiportus et vias posteriores ostendens, ad me occultandum, credo."

# game/end_game2.rpy:3200
translate latin end_game2_26cabae0:

    # "So, with a deep breath, I pocket my alien gadget, preparing myself to begin this journey."
    "Ita, alto spiritu hausto, instrumentum meum alienum in sinum pono, me ad hoc iter incipiendum parans."

# game/end_game2.rpy:3201
translate latin end_game2_272486b7:

    # "I still don't trust the parents, not at all, but knowing the ultimate goal helps me stay on this path that they have me on."
    "Adhuc Parentibus non confido, minime vero, sed ultimum propositum scire me adiuvat in hac via manere in qua me collocaverunt."

# game/end_game2.rpy:3202
translate latin end_game2_bfee21ce:

    # "Unify Europe, Africa, Asia, and the Americas."
    "Europam, Africam, Asiam et Americas coniunge."

# game/end_game2.rpy:3203
translate latin end_game2_0eed1827:

    # "Keep the powers in Washington, Beijing, and Moscow in the dark until they fall in line."
    "Potestates urbium Washington, Beijing et Moscow in tenebris tene donec se accommodent."

# game/end_game2.rpy:3204
translate latin end_game2_49809255:

    # "Then we all unify as equals..."
    "Tum omnes ut pares coniungimur..."

# game/end_game2.rpy:3205
translate latin end_game2_7f759a42:

    # "That's it, that's how you bring Earth together as one."
    "Hoc est, sic Terram in unum coniungis."

# game/end_game2.rpy:3206
translate latin end_game2_56be499c:

    # "Easy."
    "Facile."

# game/end_game2.rpy:3207
translate latin end_game2_6a20a80d_1:

    # "I shake my head."
    "Caput quatio."

# game/end_game2.rpy:3208
translate latin end_game2_9ecfc567:

    # "I'm scared, but also relieved that things are moving so quickly."
    "Timeo, sed etiam relevatus sum quod res tam celeriter procedunt."

# game/end_game2.rpy:3209
translate latin end_game2_15707183:

    # "I'm also relieved that this will keep my mind off the separation I'd just experienced."
    "Etiam relevatus sum quod hoc mentem meam a separatione quam modo passus sum avertet."

# game/end_game2.rpy:3210
translate latin end_game2_b70bbf22:

    # "With any luck, I'll be kept busy enough that I won't have to feel the full brunt of that agony all at once."
    "Si fortuna favet, tam occupatus tenebor ut totum illius doloris impetum simul sentire non debeam."

# game/end_game2.rpy:3211
translate latin end_game2_e6636299:

    # "I look back into the room where it all started, taking a deep breath."
    "In cubiculum ubi omnia inceperunt respicio, alte spiritum hauriens."

# game/end_game2.rpy:3212
translate latin end_game2_390b571d:

    # "I'm actually kind of excited; the thing I'd been dreading for months has now started, and that gives me a boost of adrenaline, preparing myself to face my duty."
    "Re vera paulum concitatus sum; res quam per menses timueram iam coepit, et id adrenalini impetum mihi dat, dum me ad officium meum obeundum paro."

# game/end_game2.rpy:3213
translate latin end_game2_829b5528:

    # "Then I turn off the light, leaving the apartment behind, ready to start another new life."
    "Tum lumen exstinguo, habitaculum relinquens, paratus aliam novam vitam incipere."

# game/end_game2.rpy:3228
translate latin end_game2_0657adc1:

    # "I make my way quickly to the throne room, trying my best to contain my excitement."
    "Celeriter ad aulam solii contendo, ardorem meum quam maxime continere conans."

# game/end_game2.rpy:3229
translate latin end_game2_07a794d9:

    # "The most difficult part of this exciting new life I have is pretending that I'm not excited at all."
    "Difficillima pars huius excitantis novae vitae quam habeo est fingere me omnino non concitatum esse."

# game/end_game2.rpy:3230
translate latin end_game2_7b60c490:

    # "So I try to look dignified as I walk into the throne room, toward Amicus seated at the back."
    "Ita dignus videri conor dum aulam solii intro, ad Amicum in posteriore parte sedentem."

# game/end_game2.rpy:3231
translate latin end_game2_d2d2ee9a:

    # "I stop and bow as low as I possibly can."
    "Consisto et quam maxime inclinare possum inclino."

# game/end_game2.rpy:3232
translate latin end_game2_c75f190b:

    # a "\"No need for that. What news do you have, Scipio?\""
    a "\"Id non necesse est. Quos nuntios habes, Scipio?\""

# game/end_game2.rpy:3233
translate latin end_game2_3ce20e56:

    # "Unfortunately, I can't stop the smile from spreading across my face as I hold up the message."
    "Infeliciter risum per vultum meum diffundi prohibere non possum, dum nuntium tollo."

# game/end_game2.rpy:3234
translate latin end_game2_9bba03e9:

    # sc "\"The pharaoh has accepted our request. The diplomatic mission may commence as soon as you are ready, Emperor Amicus.\""
    sc "\"Pharao petitionem nostram accepit. Legatio incipere potest simul ac paratus es, imperator Amice.\""

