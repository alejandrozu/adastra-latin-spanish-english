
# game/a1s2.rpy:3
translate latin a1s2_8a44ea3a:

    # "The dream I have is strange."
    "Somnium quod video mirum est."

# game/a1s2.rpy:4
translate latin a1s2_43ff70ee:

    # "I'm in a black void of some kind and despite the emptiness, I have some sort of purpose."
    "In vacuo quodam atro sum; quamquam nihil ibi est, propositum quoddam habeo."

# game/a1s2.rpy:5
translate latin a1s2_1a0c8c19:

    # "I don't know what that is, but I'm being driven towards it."
    "Quod sit nescio, sed ad illud impellor."

# game/a1s2.rpy:6
translate latin a1s2_1febd58a:

    # "It's not a good dream, it's a borderline nightmare."
    "Somnium bonum non est; paene horror nocturnus est."

# game/a1s2.rpy:7
translate latin a1s2_0a287a96:

    # "The empty void isn't the scary part, though."
    "Non tamen vacuum illud me terret."

# game/a1s2.rpy:8
translate latin a1s2_5906db9a:

    # "It's the feeling that I'm being watched by someone...or something."
    "Terret me quod sentio me ab aliquo...aut aliqua re observari."

# game/a1s2.rpy:9
translate latin a1s2_6e893e8b:

    # "It's the feeling that I have no say in where I'm going."
    "Terret me quod sentio me nihil de itinere meo decernere posse."

# game/a1s2.rpy:10
translate latin a1s2_9193d470:

    # "No choice at all..."
    "Nulla omnino electio..."

# game/a1s2.rpy:11
translate latin a1s2_a20cefa7:

    # "..."
    "..."

# game/a1s2.rpy:12
translate latin a1s2_cba5fa11:

    # "\"I'm very curious about you.\""
    "\"Multum de te cognoscere cupio.\""

# game/a1s2.rpy:13
translate latin a1s2_67aaa788:

    # "What?"
    "Quid?"

# game/a1s2.rpy:14
translate latin a1s2_d9a6576b:

    # "\"I'm limited in what I can ask, but I'll start with this—\""
    "\"Non omnia mihi quaerere licet, sed ab hoc incipiam—\""

# game/a1s2.rpy:15
translate latin a1s2_85193821:

    # "\"What is death to you?\""
    "\"Quid tibi mors est?\""

# game/a1s2.rpy:19
translate latin a1s2_a20cefa7_1:

    # "..."
    "..."

# game/a1s2.rpy:20
translate latin a1s2_d8acaf3d:

    # "Very interesting..."
    "Valde mirum..."

# game/a1s2.rpy:22
translate latin a1s2_a20cefa7_2:

    # "..."
    "..."

# game/a1s2.rpy:23
translate latin a1s2_408ac49c:

    # "I see..."
    "Intellego..."

# game/a1s2.rpy:26
translate latin a1s2_4260f8d1:

    # "Sometime just before I fully wake up, I hear something moving around behind me followed by a mumbled voice, then a soft padding sound that fades out after a few moments."
    "Paulo antequam prorsus expergiscar, aliquid post me moveri audio, deinde vocem mussitantem, tum mollium passuum sonum, qui paucis post momentis evanescit."

# game/a1s2.rpy:27
translate latin a1s2_fc15bdb3:

    # "I wonder if one of my flatmates just arrived and...looked into my room for some reason."
    "Fortasse aliquis e contubernalibus meis modo advenit et...nescio qua de causa in cubiculum meum respexit."

# game/a1s2.rpy:28
translate latin a1s2_b144e2ee:

    # "As I shift around, I frown at how weirdly firm the bed I'm laying on is."
    "Dum me verto, frontem contraho, miratus quam insolite durus sit lectus in quo iaceo."

# game/a1s2.rpy:29
translate latin a1s2_46065f1f:

    # "My bed was softer than this when I got into it...and where are the sheets?"
    "Lectus meus mollior erat cum in eum decumberem...et ubi sunt lintea?"

# game/a1s2.rpy:31
translate latin a1s2_46bede5c:

    # "I open my eyes and see a red, velvety surface in front of me."
    "Oculos aperio et superficiem rubram holoserico similem ante me video."

# game/a1s2.rpy:32
translate latin a1s2_5512fccf:

    # "Then I turn over and see an unfamiliar ceiling with a gold square pattern above me."
    "Tum me verto et lacunar ignotum supra me video, quadratis aureis ornatum."

# game/a1s2.rpy:33
translate latin a1s2_49dade07:

    # "Oh yeah..."
    "Ah, ita..."

# game/a1s2.rpy:34
translate latin a1s2_07718169:

    # "I look over toward the bed where I expect to see Amicus, but it's empty."
    "Lectum aspicio, ubi Amicum videre exspecto, sed vacuus est."

# game/a1s2.rpy:35
translate latin a1s2_b3f5448f:

    # "I stare again at the ceiling for a while, letting the sudden realization that I'm still here wash over me."
    "Rursus lacunar aliquamdiu aspicio, dum subito intellego me adhuc hic esse et id animo percipio."

# game/a1s2.rpy:36
translate latin a1s2_913068e9:

    # "I go over everything that happened yesterday, the last shred of hope that I'd been dreaming fading from my mind."
    "Omnia quae heri acciderunt mente repeto; ultima spes me somniavisse ex animo evanescit."

# game/a1s2.rpy:37
translate latin a1s2_e74544e5:

    # "I look over at Amicus's bed again, wondering if he'd gone into the bathroom."
    "Rursus lectum Amici aspicio, quaerens num in balneum abierit."

# game/a1s2.rpy:38
translate latin a1s2_086a1a09:

    # "I listen for a while, but I don't hear anything coming from the door across from the bed."
    "Aliquamdiu ausculto, sed nihil ex ostio quod contra lectum est audio."

# game/a1s2.rpy:39
translate latin a1s2_2958e213:

    # "There's a muffled sound of what I assume are birds chirping coming from behind the curtain."
    "Post velum sonus obtusus auditur, quem avium cantum esse arbitror."

# game/a1s2.rpy:40
translate latin a1s2_8d460263:

    # "Slowly, I slide off the sofa, feeling the cold marble against my bare feet as I do."
    "Lente de lectulo delabor, frigidum marmor nudis pedibus sentiens."

# game/a1s2.rpy:41
translate latin a1s2_18fd66c4:

    # "I shiver and decide to bring the blanket with me, wrapping it around my shoulders."
    "Horreo et stragulum mecum ferre statuo, umeris illud circumdans."

# game/a1s2.rpy:42
translate latin a1s2_66ed7d0b:

    # "I shuffle around the sofa and move to the side of the large curtain to pull it back just slightly."
    "Circum lectulum lente ambulo et ad latus magni veli accedo, ut illud paulum tantum reducam."

# game/a1s2.rpy:46
translate latin a1s2_ed024611:

    # "The air that comes through is fresh and immediately reminds me of camping by a lake during summer camp."
    "Aer qui intrat recens est et statim me admonet castrorum aestivorum, cum prope lacum tentoria poneremus."

# game/a1s2.rpy:47
translate latin a1s2_dadc88fa:

    # "That would make sense because ahead of me is what looks like a massive body of water that seems to come right up to the edge of the balcony."
    "Id verisimile est: ante me ingens aquarum spatium esse videtur, usque ad ipsum podium pertinens."

# game/a1s2.rpy:48
translate latin a1s2_e20f5370:

    # "It's warm, but not nearly as humid as it was last night."
    "Calet, sed aer multo minus umidus est quam nocte praeterita."

# game/a1s2.rpy:49
translate latin a1s2_408b2b7a:

    # "Pink and orange light paints the clouds on the horizon, and for a moment I take in the sight."
    "Lux rosea et aurantiaca nubes in horizonte tingit; paulisper spectaculum contemplor."

# game/a1s2.rpy:50
translate latin a1s2_d436acfb:

    # "The hills and mountains to either side of the lake are covered in lush, green trees."
    "Colles montesque utrimque lacus arboribus viridibus luxuriantibus teguntur."

# game/a1s2.rpy:51
translate latin a1s2_02b0020c:

    # "So is the little island a ways out to my left."
    "Item insula parva aliquanto ad sinistram distans."

# game/a1s2.rpy:52
translate latin a1s2_d1b3c85c:

    # "In the distance, on the other side of the lake is what looks like a city of some kind."
    "Procul, trans lacum, urbs quaedam esse videtur."

# game/a1s2.rpy:53
translate latin a1s2_0c39805c:

    # "It's hard to tell how big it is since it's a good ways away, but from what I can tell the buildings are massive, and the smaller structures that taper off to the side seem to stretch far off behind them."
    "Quia longe abest, difficile est magnitudinem eius iudicare; quantum tamen discernere possum, aedificia ingentia sunt, et minora, quae ad latera rarescunt, longe post illa patere videntur."

# game/a1s2.rpy:54
translate latin a1s2_d758265c:

    # "Dim lights from windows glitter in the distance and I wonder if that city is full of wolves like Amicus and Cassius."
    "Lumina obscura fenestrarum procul micant; quaero num urbs illa plena sit luporum quales sunt Amicus et Cassius."

# game/a1s2.rpy:55
translate latin a1s2_1883be0e:

    # "Despite my situation, I kind of want to go see it."
    "Quamvis in hac condicione sim, aliquatenus eam visere cupio."

# game/a1s2.rpy:56
translate latin a1s2_a42f5c39:

    # "As I watch, I see a small, dark oval shape descend down toward the city, blinking blue and red lights."
    "Dum specto, figuram parvam atram ovalem versus urbem descendere video, luminibus caeruleis rubrisque micantibus."

# game/a1s2.rpy:57
translate latin a1s2_54eb64cb:

    # "I have to smile and shake my head a little."
    "Non possum quin subrideam caputque leviter quatiam."

# game/a1s2.rpy:58
translate latin a1s2_71f77739:

    # "I still want to go back to Earth, but this is undeniably amazing."
    "Ad Terram redire adhuc cupio, sed hoc sane mirabile est."

# game/a1s2.rpy:59
translate latin a1s2_9fc12907:

    # "I let the curtain slide shut finally and turn back to the room."
    "Tandem velum claudi sino et ad cubiculum me converto."

# game/a1s2.rpy:62
translate latin a1s2_e880634a:

    # "So where did that big wolf go to?"
    "Quo igitur ille lupus magnus abiit?"

# game/a1s2.rpy:63
translate latin a1s2_533b966e:

    # "He could have at least told me before he ran off."
    "Saltem me certiorem facere potuit priusquam abiret."

# game/a1s2.rpy:64
translate latin a1s2_ddb8a70b:

    # com "\"Good morning, [mc].\""
    com "\"Bonum mane, [mc].\""

# game/a1s2.rpy:65
translate latin a1s2_f2edd6f0:

    # "I jump as the computer voice crackles overhead."
    "Exsilio, cum vox computatri supra me crepitat."

# game/a1s2.rpy:66
translate latin a1s2_c142d35f:

    # "I clutch my chest, breathing hard as the voice continues."
    "Pectus prehendo, anhelans, dum vox pergit."

# game/a1s2.rpy:67
translate latin a1s2_e3be3503:

    # com "\"Amicus has a message for you.\""
    com "\"Amicus nuntium tibi reliquit.\""

# game/a1s2.rpy:68
translate latin a1s2_1eb8d57e:

    # "There's a pause, then—"
    "Silentium fit, tum—"

# game/a1s2.rpy:69
translate latin a1s2_49b133c6:

    # a "\"Heeey, [mc]? I'm going to my morning meditation. It's in a room just down the hall and I'll be back in approximately an hour. Why don't you take the time to get familiar with the room?\""
    a "\"Heus, [mc]? Ad meditationem matutinam eo. In conclavi est paulo inferius in androne; circiter post horam redibo. Cur hoc tempore cubiculum cognoscere non conaris?\""

# game/a1s2.rpy:70
translate latin a1s2_1eb8d57e_1:

    # "There's a pause, then—"
    "Silentium fit, tum—"

# game/a1s2.rpy:71
translate latin a1s2_0490db8b:

    # a "\"Are you still recording, Com?\""
    a "\"Adhucne vocem meam servas, Com?\""

# game/a1s2.rpy:72
translate latin a1s2_8738045e:

    # com "\"Yes. To end recording, say 'end of message'.\""
    com "\"Ita. Ut vocem servare desinam, dic 'finis nuntii'.\""

# game/a1s2.rpy:73
translate latin a1s2_fe5b2d9b:

    # a "\"Oh, um, see you soon, [mc]. End message...is it still—\""
    a "\"Ah, eh, mox te videbo, [mc]. Fini nuntium...adhucne—\""

# game/a1s2.rpy:74
translate latin a1s2_1038cf99:

    # com "\"To end recording, say 'end of message'.\""
    com "\"Ut vocem servare desinam, dic 'finis nuntii'.\""

# game/a1s2.rpy:75
translate latin a1s2_6afc1ebc:

    # a "\"My gods, end of message!\""
    a "\"Di mei, finis nuntii!\""

# game/a1s2.rpy:76
translate latin a1s2_3587099e:

    # "I hear Amicus starting to curse again before the message cuts off."
    "Amicum rursus maledicere incipientem audio, antequam nuntius interrumpitur."

# game/a1s2.rpy:77
translate latin a1s2_85d42305:

    # "I look around the room a bit, noticing how little there is to get familiar with."
    "Cubiculum paulum circumspicio, animadvertens quam pauca hic sint quae cognoscam."

# game/a1s2.rpy:78
translate latin a1s2_949ea669:

    # "I could look through the dresser, but I assume that's mostly filled with Amicus's things and I doubt he wants me to get familiar with those."
    "Armarium perscrutari possem, sed plerumque res Amici continere arbitror; dubito eum velle ut eas cognoscam."

# game/a1s2.rpy:79
translate latin a1s2_b91021ad:

    # "I move across the room toward the bathroom door, standing in front of it for a moment before studying the black panel in the middle of it."
    "Cubiculum transgredior ad ostium balnei; paulisper ante illud sto, deinde tabulam nigram in medio examino."

# game/a1s2.rpy:80
translate latin a1s2_de8f3dae:

    # "It's similar to what Amicus used to open the door in the hallway."
    "Similis est ei qua Amicus ostium in androne aperuit."

# game/a1s2.rpy:81
translate latin a1s2_5473e3d7:

    # "I reach out to try and push it and the moment my fingers brush against the surface, the door slides to the side so fast that I jump."
    "Manum porrigo ut illam premam; statim ac digiti superficiem tangunt, ostium tam celeriter ad latus labitur ut exsiliam."

# game/a1s2.rpy:84
translate latin a1s2_de58eb57:

    # "The lights inside come on, slowly illuminating the interior."
    "Lumina intus accenduntur, interiores partes paulatim illustrantia."

# game/a1s2.rpy:85
translate latin a1s2_805dcab5:

    # "I poke my head inside, then quickly step in, imagining the sliding door suddenly closing and chopping my head off."
    "Caput intus insero, tum cito ingredior, cogitans ostium labens subito claudi posse et caput meum amputare."

# game/a1s2.rpy:86
translate latin a1s2_49fce4b8:

    # "It stays open until I'm halfway in the room, then it closes automatically."
    "Apertum manet donec in medium conclave pervenero; tum per se clauditur."

# game/a1s2.rpy:88
translate latin a1s2_7cf4c349:

    # "There's a large sink to my left and an even larger mirror above it."
    "Ad sinistram labrum magnum est, supra illud speculum etiam maius."

# game/a1s2.rpy:89
translate latin a1s2_5e15ffa2:

    # "In the corner, there's a marble-looking bench with a hole that I can only assume is the toilet."
    "In angulo scamnum marmoreum esse videtur, foramine praeditum, quod latrinam esse non possum quin arbitrer."

# game/a1s2.rpy:90
translate latin a1s2_9b7c07ab:

    # "Finally, across from that is a large bath and what I imagine to be the shower."
    "Postremo, contra illud, solium magnum est et aliquid quod imbrem balnearem esse puto."

# game/a1s2.rpy:91
translate latin a1s2_1c235e41:

    # "I actually really need to pee, so I head over to the bench and do my business down the hole, hoping that it's not something like a laundry shoot and I'm pissing on the servants below."
    "Mihi quidem vehementer mingere opus est; ad scamnum igitur accedo et in foramen mingo, sperans id non esse quasi tubum quo lintea lavanda deiciantur neque me in servos infra mingere."

# game/a1s2.rpy:92
translate latin a1s2_123b4ed3:

    # "As soon as I start though, water begins to pour down the sides of the tube, leaving me pretty sure that it is indeed a toilet."
    "Simul tamen atque incipio, aqua per latera tubi defluere incipit; itaque satis certus sum hanc vere latrinam esse."

# game/a1s2.rpy:93
translate latin a1s2_78c665fa:

    # "I guess I should be more confident in assuming things about this place."
    "De rebus huius loci coniecturas facere fortasse confidentius debeo."

# game/a1s2.rpy:94
translate latin a1s2_e2db21d6:

    # "Everything is fairly similar to what I had on Earth."
    "Omnia satis similia sunt iis quae in Terra habebam."

# game/a1s2.rpy:95
translate latin a1s2_d79e697b:

    # "I walk over to the sink and push at the faucet, then I stick my hand under it and water starts pouring out."
    "Ad labrum accedo et epitonium premo; tum manum sub illud pono et aqua effundi incipit."

# game/a1s2.rpy:96
translate latin a1s2_193d3813:

    # "I'm tempted to take a drink, but then I notice the water is bubbly and soapy-looking."
    "Aquam bibere paene cupio, sed tum eam bullis plenam et saponi similem esse animadverto."

# game/a1s2.rpy:97
translate latin a1s2_b46315d7:

    # "Having nothing left to do in the bathroom, I turn back to the door and find the black square again."
    "Cum nihil iam in balneo agendum sit, ad ostium me converto et quadratum nigrum rursus invenio."

# game/a1s2.rpy:98
translate latin a1s2_2497b418:

    # "I reach for it, and just like before the door slides open—"
    "Manum ad illud porrigo; et, sicut antea, ostium labitur apertum—"

# game/a1s2.rpy:102
translate latin a1s2_b6f159df:

    # c "\"—if he thinks he's going to get away with it.\""
    c "\"—si putat hoc sibi impune cessurum.\""

# game/a1s2.rpy:103
translate latin a1s2_e7b7bcb1:

    # "Cassius is facing away from me, his arms folded as his bushy white tail swishes from side to side."
    "Cassius aversus stat, bracchiis complicatis, dum cauda eius alba villosa huc illuc movetur."

# game/a1s2.rpy:104
translate latin a1s2_1edd442b:

    # "I freeze up, staring at him wide-eyed."
    "Dirigesco, oculis late apertis eum intuens."

# game/a1s2.rpy:105
translate latin a1s2_c5e2e6bd:

    # "I have plenty of time to jump to the side, maybe hide in the shower area, but I just stand there like an idiot as the wolf turns around, almost in slow-motion."
    "Satis temporis habeo ut ad latus saliam, fortasse apud imbrem balnearem me abscondam; sed ibi stulte sto, dum lupus se vertit, quasi tardissime."

# game/a1s2.rpy:107
translate latin a1s2_222ec7d4:

    # "He freezes just like I did when he spots me standing in the doorway."
    "Ille quoque, sicut ego, dirigescit cum me in ostio stantem conspicit."

# game/a1s2.rpy:108
translate latin a1s2_72c0324c:

    # "We stare at each other for a moment, for a very long moment."
    "Paulisper alter alterum aspicimus; diutissimum illud momentum est."

# game/a1s2.rpy:109
translate latin a1s2_70d3a3ef:

    # "Then he screeches, making me jump back in shock."
    "Tum stridet, ita ut territus retro saliam."

# game/a1s2.rpy:112
translate latin a1s2_9ae0b2f3:

    # c "\"OH GODS! EDEPOL! WHAT IS IT!?\""
    c "\"O DI! EDEPOL! QUID EST ILLUD!?\""

# game/a1s2.rpy:113
translate latin a1s2_6ab7d480:

    # "The wolf dodges back and forth, as if expecting me to try and run at him."
    "Lupus huc illuc se subducit, quasi me in se currere conaturum exspectet."

# game/a1s2.rpy:114
translate latin a1s2_242dd93b:

    # c "\"CATO! CATO! HELP! COME QUICK!\""
    c "\"CATO! CATO! SUCCURRE! VENI CITO!\""

# game/a1s2.rpy:116
translate latin a1s2_b8d211dc:

    # "Finally Cassius's little dance of terror ends with him sprinting to my left and out of the room."
    "Tandem Cassius saltatiunculam illam timoris finit, ad sinistram meam currens atque e cubiculo exiens."

# game/a1s2.rpy:117
translate latin a1s2_8e66f93d:

    # "I stand there for a moment, listening to his screams fade down the echoing hallway while wondering if I should hide or something, maybe go back into the bathroom and try to lock it..."
    "Paulisper ibi sto, clamores eius per andronem resonantem evanescentes audiens, dum quaero num me abscondam vel quid aliud faciam, fortasse in balneum redeam et illud claudere coner..."

# game/a1s2.rpy:118
translate latin a1s2_85f2c9c2:

    # "Instead, I hear more thudding, someone running up the hallway from the other end."
    "Sed plures strepitus audio: aliquis ab altero fine andronis accurrit."

# game/a1s2.rpy:120
translate latin a1s2_d9fe848a:

    # "Then Amicus comes running into the room, sliding to a stop in the middle of it."
    "Tum Amicus in cubiculum accurrit et in medio, labens, consistit."

# game/a1s2.rpy:122
translate latin a1s2_fe75917d:

    # "He spins in a circle, then spots me and runs up to me."
    "In orbem se vertit, tum me conspicit atque ad me accurrit."

# game/a1s2.rpy:123
translate latin a1s2_fd2ae0e5:

    # a "\"What happened!?\""
    a "\"Quid accidit!?\""

# game/a1s2.rpy:124
translate latin a1s2_b3e20cc1:

    # m "\"Uh, Cassius came in and saw me.\""
    m "\"Eh, Cassius intravit et me vidit.\""

# game/a1s2.rpy:126
translate latin a1s2_23224bec:

    # a "\"You let him see you!?\""
    a "\"Passusne es ut te videret!?\""

# game/a1s2.rpy:127
translate latin a1s2_65814a63:

    # m "\"Wha—No! He just came in! Where were YOU!?\""
    m "\"Qui—Non! Ipse intravit! Ubi TU eras!?\""

# game/a1s2.rpy:128
translate latin a1s2_cca47b7c:

    # a "\"Meditating! I left a message! Where did he go?\""
    a "\"Meditabar! Nuntium reliqui! Quo abiit?\""

# game/a1s2.rpy:129
translate latin a1s2_2603ad59:

    # m "\"Cassius? He just ran off.\""
    m "\"Cassius? Modo aufugit.\""

# game/a1s2.rpy:131
translate latin a1s2_58892681:

    # a "\"Dammit!\""
    a "\"Malum!\""

# game/a1s2.rpy:132
translate latin a1s2_ce19db78:

    # "Amicus stands there, his tail thrashing back and forth."
    "Amicus ibi stat, caudam ultro citroque vehementer agitando."

# game/a1s2.rpy:133
translate latin a1s2_af78b41c:

    # "I glare at him."
    "Eum torve aspicio."

# game/a1s2.rpy:134
translate latin a1s2_f167a100:

    # m "\"If you hadn't just left me here this wouldn't have happened!\""
    m "\"Si me hic non reliquisses, hoc non accidisset!\""

# game/a1s2.rpy:136
translate latin a1s2_9f9fd9ed:

    # a "\"Cassius shouldn't have even come in here!\""
    a "\"Cassius ne huc quidem intrare debuit!\""

# game/a1s2.rpy:137
translate latin a1s2_fdf6cc76:

    # "Amicus turns away and starts pacing back and forth."
    "Amicus se avertit et ultro citroque ambulare incipit."

# game/a1s2.rpy:138
translate latin a1s2_9e2304d6:

    # m "\"What are you doing?\""
    m "\"Quid agis?\""

# game/a1s2.rpy:139
translate latin a1s2_1b478010:

    # a "\"Shh! I'm thinking.\""
    a "\"Sst! Cogito.\""

# game/a1s2.rpy:140
translate latin a1s2_40c7c9b6:

    # "I bristle a little at being shushed, but I stay quiet, watching the wolf stalk back and forth."
    "Aliquantum indignor quod me tacere iubet, sed tacitus maneo, lupum ultro citroque incedentem observans."

# game/a1s2.rpy:141
translate latin a1s2_5c41f310:

    # "Then I hear voices again; Cassius's along with another, deeper voice."
    "Tum voces iterum audio: Cassii et aliam graviorem."

# game/a1s2.rpy:142
translate latin a1s2_2e1482f4:

    # "Amicus turns to me."
    "Amicus ad me vertitur."

# game/a1s2.rpy:144
translate latin a1s2_2c86e3f2:

    # a "\"Just be quiet for a moment as I try to explain things, understand?\""
    a "\"Paulisper modo tace dum res explicare conor, intellegis?\""

# game/a1s2.rpy:145
translate latin a1s2_bf9e3598:

    # "I glare at Amicus."
    "Amicum torve aspicio."

# game/a1s2.rpy:146
translate latin a1s2_0fd81109:

    # "His ears flatten and his expression becomes a bit more desperate."
    "Aures eius demittuntur et vultus aliquanto magis desperatus fit."

# game/a1s2.rpy:148
translate latin a1s2_62a6ee12:

    # a "\"Please?\""
    a "\"Quaeso?\""

# game/a1s2.rpy:149
translate latin a1s2_7961a2a6:

    # "I still don't say anything, but give him a curt nod."
    "Adhuc nihil dico, sed breviter ei annuo."

# game/a1s2.rpy:151
translate latin a1s2_01fab9fa:

    # "Amicus reaches out toward my shoulder, then pauses and instead offers his paw to me."
    "Amicus manum ad umerum meum porrigit, tum consistit atque pro eo manum mihi offert."

# game/a1s2.rpy:153
translate latin a1s2_114b7df8:

    # "I take it and he gently pulls me from the bathroom to stand next to him in the middle of the room, facing the open doorway to the hall."
    "Manum eius capio; ille me leniter e balneo trahit, ut iuxta eum in medio cubiculo stem, ad apertam andronis ianuam conversus."

# game/a1s2.rpy:155
translate latin a1s2_6f5aee91:

    # "Amicus fixes a confident smile on his face, though I can feel how tense he is next to me."
    "Amicus risum confidentem vultui suo imponit, quamquam sentio quam intentus iuxta me sit."

# game/a1s2.rpy:156
translate latin a1s2_1cbf1266:

    # "From around the corner comes Cassius, but he's hiding behind someone else; another wolf."
    "Cassius circa angulum apparet, sed post alium se celat: post alterum lupum."

# game/a1s2.rpy:161
translate latin a1s2_f2cdf292:

    # "They both stop in the doorway as the larger wolf takes in both Amicus and I."
    "Ambo in limine consistunt, dum lupus maior me et Amicum inspicit."

# game/a1s2.rpy:163
translate latin a1s2_7846d668:

    # c "\"Amicus! What are you doing with it!? Step away!\""
    c "\"Amice! Quid cum hoc agis!? Recede!\""

# game/a1s2.rpy:164
translate latin a1s2_8cc057a4:

    # "Amicus gently places his paw around my shoulders, drawing me in against his bulk."
    "Amicus leniter bracchium circa umeros meos ponit, me ad magnum corpus suum attrahens."

# game/a1s2.rpy:165
translate latin a1s2_b114000b:

    # "Cassius's eyes widen at that, though the wolf next to him seems to have no reaction."
    "Cassius eo viso oculos dilatat, quamquam lupus iuxta eum nihil moveri videtur."

# game/a1s2.rpy:166
translate latin a1s2_843f3879:

    # "Then again, that could just be because I can't see his eyes."
    "Fortasse tamen id tantum accidit quia oculos eius videre non possum."

# game/a1s2.rpy:168
translate latin a1s2_fc5b6b3c:

    # c "\"What are you doing, Amicus?\""
    c "\"Quid agis, Amice?\""

# game/a1s2.rpy:169
translate latin a1s2_256eb462:

    # "Amicus clears his throat."
    "Amicus tussicula fauces purgat."

# game/a1s2.rpy:171
translate latin a1s2_dedb99b5:

    # a "\"Cassius, Cato—\""
    a "\"Cassi, Cato—\""

# game/a1s2.rpy:172
translate latin a1s2_9287fe84:

    # "He nods to each of them in turn."
    "Singulis vicissim capite annuit."

# game/a1s2.rpy:174
translate latin a1s2_5c738518:

    # a "\"This is my pet, [mc]\""
    a "\"Hoc animal domesticum meum est, [mc]\""

# game/a1s2.rpy:178
translate latin a1s2_aee17479:

    # "Cassius's mouth falls open."
    "Cassius ore aperto stupet."

# game/a1s2.rpy:179
translate latin a1s2_f84b7833:

    # "The other wolf, Cato, seems to shift a bit at that."
    "Alter lupus, Cato, eo audito paulum moveri videtur."

# game/a1s2.rpy:180
translate latin a1s2_d69f2d9a:

    # "Silence drags out."
    "Silentium protrahitur."

# game/a1s2.rpy:181
translate latin a1s2_cb69578f:

    # "Then Cato shifts again."
    "Tum Cato iterum se movet."

# game/a1s2.rpy:183
translate latin a1s2_b34efece:

    # ca "\"Is this where you were the past two days, Amicus?\""
    ca "\"Hucne per hos duos dies abieras, Amice?\""

# game/a1s2.rpy:184
translate latin a1s2_b0cc2b9b:

    # "Amicus's arm tightens a bit around my shoulders, drawing me in closer."
    "Bracchium Amici circa umeros meos aliquantum contrahitur, me propius ad eum trahens."

# game/a1s2.rpy:186
translate latin a1s2_bcc81977:

    # a "\"Yes.\""
    a "\"Ita.\""

# game/a1s2.rpy:187
translate latin a1s2_21194a70:

    # ca "\"And that's where you took your father's ship?\""
    ca "\"Et illuc navem patris tui duxisti?\""

# game/a1s2.rpy:188
translate latin a1s2_edd197c8:

    # "A slight pause."
    "Brevis mora."

# game/a1s2.rpy:190
translate latin a1s2_a4cda055:

    # a "\"Y—yes\""
    a "\"I—ita\""

# game/a1s2.rpy:191
translate latin a1s2_e2c86cb4:

    # "Cassius gasps."
    "Cassius spiritum abrupte ducit."

# game/a1s2.rpy:193
translate latin a1s2_cf995e1f:

    # c "\"He can't do that!\""
    c "\"Id facere non potest!\""

# game/a1s2.rpy:194
translate latin a1s2_0df87e69:

    # "He glances at Cato."
    "Catonem aspicit."

# game/a1s2.rpy:196
translate latin a1s2_79a16a81:

    # c "\"Can he?\""
    c "\"An potest?\""

# game/a1s2.rpy:197
translate latin a1s2_2f8afe6c:

    # "The bigger wolf is quiet, and even though I can't see his eyes I get the feeling that he's watching me closely."
    "Lupus maior tacet; quamquam oculos eius videre non possum, sentio eum diligenter me observare."

# game/a1s2.rpy:198
translate latin a1s2_4a402e58:

    # "Cassius turns his glare back on Amicus."
    "Cassius rursus Amicum torve aspicit."

# game/a1s2.rpy:200
translate latin a1s2_be0e54b5:

    # c "\"Where did it come from?\""
    c "\"Unde hoc venit?\""

# game/a1s2.rpy:202
translate latin a1s2_6e5d1d44:

    # "Amicus rubs my arm."
    "Amicus bracchium meum fricat."

# game/a1s2.rpy:203
translate latin a1s2_8e2d4c9f:

    # a "\"HE...came from far away.\""
    a "\"ILLE... e regione longinqua venit.\""

# game/a1s2.rpy:205
translate latin a1s2_5b486f4c:

    # ca "\"Is he a Child?\""
    ca "\"Estne Liber?\""

# game/a1s2.rpy:206
translate latin a1s2_bcc81977_1:

    # a "\"Yes.\""
    a "\"Ita.\""

# game/a1s2.rpy:208
translate latin a1s2_0cbd54c8:

    # c "\"What!? He can't just take someone else's Child...can he?\""
    c "\"Quid!? Non potest Liberum alienum simpliciter rapere... an potest?\""

# game/a1s2.rpy:209
translate latin a1s2_824953f5:

    # "Again Cassius looks at Cato."
    "Cassius iterum Catonem aspicit."

# game/a1s2.rpy:210
translate latin a1s2_11f874b5:

    # "And once again, Cato is quiet, then he finally sighs."
    "Cato rursus tacet, deinde tandem suspirat."

# game/a1s2.rpy:212
translate latin a1s2_e246ee3a:

    # ca "\"We will discuss this over breakfast, Amicus. Get dressed and bring the creature with you...as long as he's safe?\""
    ca "\"De hac re inter ientandum disseremus, Amice. Vesti te et hanc creaturam tecum duc... modo tutus sit?\""

# game/a1s2.rpy:214
translate latin a1s2_d098c481:

    # a "\"Of course.\""
    a "\"Certe.\""

# game/a1s2.rpy:215
translate latin a1s2_5c863f59:

    # ca "\"Then we will continue the conversation there.\""
    ca "\"Tum sermonem ibi continuabimus.\""

# game/a1s2.rpy:217
translate latin a1s2_2827ce39:

    # "With that, Cato turns on his heel and walks out of the room, leaving Cassius to look after him with a gaping mouth."
    "His dictis Cato in calce se vertit et e cubiculo exit; Cassius eum ore hianti abeuntem aspicit."

# game/a1s2.rpy:218
translate latin a1s2_1550c74a:

    # "He turns back on us, snarling."
    "Ad nos rursus vertitur, ringens."

# game/a1s2.rpy:220
translate latin a1s2_94bb0c7d:

    # c "\"I don't know what you're planning with that {i}thing{/i}, Amicus, but if I know you, it's going to be incredibly stupid.\""
    c "\"Nescio quid cum ista {i}re{/i} moliaris, Amice, sed, si te novi, incredibiliter stultum erit.\""

# game/a1s2.rpy:221
translate latin a1s2_47024a58:

    # "He takes another second to look at me with unmistakable disgust."
    "Aliud breve tempus sumit ut me manifesta fastidii expressione aspiciat."

# game/a1s2.rpy:222
translate latin a1s2_0b38f296:

    # c "\"You could have at least obtained one that isn't quite so ugly you kno—\""
    c "\"Saltem unum obtinere potuisti quod non tam deforme esset, sci—\""

# game/a1s2.rpy:224
translate latin a1s2_ab2808da:

    # a "\"Leave, Cassius. And don't think about snooping around in my room again, understood?\""
    a "\"Abi, Cassi. Ne cogita quidem cubiculum meum rursus perscrutari, intellegis?\""

# game/a1s2.rpy:226
translate latin a1s2_38f2c568:

    # "Cassius doesn't respond and simply walks away, looking over his shoulder just before he leaves."
    "Cassius non respondet; tantum abit, super umerum respiciens paulo antequam exit."

# game/a1s2.rpy:227
translate latin a1s2_dafe5630:

    # c "\"And expect to receive punishment from Cato for stealing father's ship...Absolutely outrageous.\""
    c "\"Et exspecta ut Cato te puniat, quod navem patris furatus es... Prorsus indignum.\""

# game/a1s2.rpy:228
translate latin a1s2_a804a9f3:

    # "I watch Cassius's tail swish out of sight behind the doorway."
    "Caudam Cassii agitatam post limen e conspectu evanescere observo."

# game/a1s2.rpy:229
translate latin a1s2_b32acb6d:

    # "Amicus lets out a huge sigh and I feel his chest deflate against my shoulder."
    "Amicus ingens suspirium emittit, et pectus eius contra umerum meum laxari sentio."

# game/a1s2.rpy:231
translate latin a1s2_d443f2e7:

    # a "\"Damn-it\""
    a "\"Male sit\""

# game/a1s2.rpy:232
translate latin a1s2_534a1e50:

    # "I sigh as well."
    "Ego quoque suspiro."

# game/a1s2.rpy:233
translate latin a1s2_8a5eba1b:

    # m "\"You REALLY didn't think all of this through, did you?\""
    m "\"RE VERA haec omnia non diligenter cogitaveras, nonne?\""

# game/a1s2.rpy:234
translate latin a1s2_76983ee7:

    # "I slowly move out from under the wolf's heavy arm."
    "Lente e sub gravi bracchio lupi me expedio."

# game/a1s2.rpy:236
translate latin a1s2_d0a201d9:

    # a "\"Like I said, I made many mistakes. I'm just tired of lying now.\""
    a "\"Ut dixi, multos errores commisi. Iam tantum mentiendi me taedet.\""

# game/a1s2.rpy:238
translate latin a1s2_9466c201:

    # m "\"You still told them I'm a Child.\""
    m "\"Tamen eis dixisti me Liberum esse.\""

# game/a1s2.rpy:240
translate latin a1s2_519dcbbc:

    # "Amicus brings a paw abruptly up to his mouth, touching the pads of his fingers to his lips."
    "Amicus manum subito ad os tollit, digitorum pulvinula ad labra admovens."

# game/a1s2.rpy:241
translate latin a1s2_3d82bb3c:

    # "It might not be a shushing gesture that I'm familiar with, but I know what it means."
    "Fortasse non est ille gestus tacendi quem novi, sed quid significet intellego."

# game/a1s2.rpy:242
translate latin a1s2_bc905e24:

    # "Amicus listens, his ears straight up and eyes looking up at the ceiling."
    "Amicus auscultat, auribus recte erectis oculisque ad laquear sublatis."

# game/a1s2.rpy:243
translate latin a1s2_5ff447a1:

    # "Finally, he looks back at me, whispering."
    "Tandem ad me respicit, susurrans."

# game/a1s2.rpy:245
translate latin a1s2_5f89211f:

    # a "\"That...is something I can never tell them the truth about, and it would be best if you never mention it again...please.\""
    a "\"De ea re... verum eis numquam dicere possum; optimum erit si tu quoque eius numquam iterum mentionem feceris... quaeso.\""

# game/a1s2.rpy:246
translate latin a1s2_77d5e388:

    # "His suddenly serious demeanor cools my mood a little, so I just sigh again and sit on the edge of his bed."
    "Quod subito tam serio se gerit, iram meam aliquantum mitigat; itaque tantum iterum suspiro et in margine lecti eius consido."

# game/a1s2.rpy:247
translate latin a1s2_60e60de4:

    # "Amicus stands there awkwardly for a moment, then quickly moves over to the open door, placing a paw to the square to close it."
    "Amicus paulisper incommodus ibi stat, deinde celeriter ad apertam ianuam accedit et manum ad quadratum ponit ut eam claudat."

# game/a1s2.rpy:250
translate latin a1s2_9b2cd95b:

    # "He moves back over to me, his voice still lowered."
    "Ad me redit, voce adhuc summissa."

# game/a1s2.rpy:252
translate latin a1s2_26392d9f:

    # a "\"Well, if we're going to pass you off as a pet then I should probably get you familiar with your duties.\""
    a "\"Bene, si te pro animali domestico haberi volumus, fortasse officiis tuis te assuefacere debeo.\""

# game/a1s2.rpy:253
translate latin a1s2_e725dbf0:

    # m "\"My duties?\""
    m "\"Officiis meis?\""

# game/a1s2.rpy:254
translate latin a1s2_777dbd10:

    # "I raise an eyebrow at Amicus."
    "Alterum supercilium ad Amicum tollo."

# game/a1s2.rpy:255
translate latin a1s2_f334dfb6:

    # "Amicus sighs."
    "Amicus suspirat."

# game/a1s2.rpy:256
translate latin a1s2_cab39f97:

    # a "\"I understand your frustration, but we need to do this right if we want things to go as smoothly as possible. You don't {i}have{/i} to do anything, but it will help you blend in better.\""
    a "\"Intellego te frustrari, sed hoc recte facere debemus, si volumus res quam facillime procedere. Nihil facere {i}teneris{/i}, sed haec te adiuvabunt ut inter ceteros minus conspicuus sis.\""

# game/a1s2.rpy:257
translate latin a1s2_5242896a:

    # "I roll my eyes and lean back on my hands, looking up at Amicus."
    "Oculos circumverto et manibus post me innixus reclinor, Amicum sursum aspiciens."

# game/a1s2.rpy:258
translate latin a1s2_4f4fa258:

    # m "\"Alright...what do I do?\""
    m "\"Bene... quid facio?\""

# game/a1s2.rpy:260
translate latin a1s2_c663ed8d:

    # a "\"Well, first of all I take my shower and...\""
    a "\"Primum sub imbre lavari soleo et...\""

# game/a1s2.rpy:262
translate latin a1s2_b40bd464:

    # a "\"...you help me wash.\""
    a "\"...tu me lavare adiuvas.\""

# game/a1s2.rpy:264
translate latin a1s2_24e25e2c:

    # m "\"Help you wash?\""
    m "\"Te lavare adiuvare?\""

# game/a1s2.rpy:265
translate latin a1s2_7e4ea1cd:

    # a "\"...Yes. You would soap my fur and such.\""
    a "\"...Ita. Pilos meos sapone fricares et talia.\""

# game/a1s2.rpy:266
translate latin a1s2_fd1493a2:

    # "We stare at each other for a moment."
    "Paulisper alter alterum intuemur."

# game/a1s2.rpy:267
translate latin a1s2_ead37c6b:

    # a "\"Um, it's something that the others wouldn't see, so I suppose it's not necessary...unless you want to.\""
    a "\"Eh, hoc alii non viderent, itaque credo non necessarium esse... nisi tu vis.\""

# game/a1s2.rpy:268
translate latin a1s2_c651d0c8:

    # m "\"No.\""
    m "\"Non.\""

# game/a1s2.rpy:270
translate latin a1s2_d8ce4842:

    # a "\"Well, alright then. Nevermind on that one.\""
    a "\"Bene igitur. Hoc omitte.\""

# game/a1s2.rpy:271
translate latin a1s2_b03838d1:

    # "Amicus is clearly offended."
    "Amicus plane offensus est."

# game/a1s2.rpy:272
translate latin a1s2_449626f9:

    # m "\"Listen, I'm not gonna soap up your naked body.\""
    m "\"Audi: corpus tuum nudum sapone non fricabo.\""

# game/a1s2.rpy:274
translate latin a1s2_ba137c13:

    # a "\"Yeah, you made that clear.\""
    a "\"Ita, id perspicue ostendisti.\""

# game/a1s2.rpy:276
translate latin a1s2_865baf93:

    # a "\"Anyway, I'd honestly rather skip the shower today, but spending all of that time in the spaceship has left me rather unkempt.\""
    a "\"Utut est, re vera hodie balneum omittere mallem, sed totum illud tempus in nave spatiali consumptum me satis incomptum reliquit.\""

# game/a1s2.rpy:277
translate latin a1s2_b403fb21:

    # "Amicus turns to the bathroom and opens the door."
    "Amicus ad balneum vertitur et ianuam aperit."

# game/a1s2.rpy:279
translate latin a1s2_8023989e:

    # a "\"You should at least come into the bathroom while I shower in case Cassius decides to barge in again. You can stare at the wall, or something.\""
    a "\"Saltem in balneum intrare debes dum lavor, si forte Cassius rursus irruat. Parietem spectare potes, vel tale quid.\""

# game/a1s2.rpy:281
translate latin a1s2_a6787fc6:

    # "Amicus stalks into the bathroom and I have to smile as I follow him in, the door closing quietly behind me."
    "Amicus iratus in balneum incedit; ego eum sequens arridere cogor, dum ianua post me tacite clauditur."

# game/a1s2.rpy:283
translate latin a1s2_6227eec5:

    # "Amicus notices me smirking."
    "Amicus me subridentem animadvertit."

# game/a1s2.rpy:285
translate latin a1s2_3c8805f7:

    # a "\"What?\""
    a "\"Quid?\""

# game/a1s2.rpy:286
translate latin a1s2_8619f2c6:

    # "I shrug."
    "Umeros tollo."

# game/a1s2.rpy:287
translate latin a1s2_0a925965:

    # m "\"Nothing, just kind of funny that you got so huffy.\""
    m "\"Nihil; tantum aliquantum ridiculum est quod tam indignatus es.\""

# game/a1s2.rpy:288
translate latin a1s2_1bf89fc5:

    # a "\"I don't know what that means.\""
    a "\"Nescio quid id significet.\""

# game/a1s2.rpy:290
translate latin a1s2_60121d2a:

    # "Amicus is adjusting his underwear, then it suddenly drops and I quickly look away."
    "Amicus vestes interiores aptat, tum subito eae cadunt et ego celeriter oculos averto."

# game/a1s2.rpy:292
translate latin a1s2_305ad5b8:

    # a "\"Heh, I suppose your people prefer modesty?\""
    a "\"Heh, credo gentem tuam verecundiam malle?\""

# game/a1s2.rpy:293
translate latin a1s2_6cd10b12:

    # "Out of the corner of my eye, I can tell that Amicus has on a smirk of his own."
    "Ex obliquo intellego Amicum ipsum quoque subridere."

# game/a1s2.rpy:294
translate latin a1s2_ea881595:

    # m "\"Around others at least...and you guys don't just walk around naked, so don't you prefer modesty too?\""
    m "\"Saltem coram aliis... neque vos nudi passim ambulatis; ergo nonne etiam vos verecundiam mavultis?\""

# game/a1s2.rpy:295
translate latin a1s2_bffdd735:

    # a "\"It all depends on the time and place.\""
    a "\"Omnia a tempore et loco pendent.\""

# game/a1s2.rpy:296
translate latin a1s2_c32617d6:

    # "Amicus moves into the shower and for the next ten or so minutes, I sit on the counter while the room fills with steam."
    "Amicus sub imbrem intrat; ego per decem circiter minuta proxima in mensa balnei sedeo, dum cubiculum vapore impletur."

# game/a1s2.rpy:298
translate latin a1s2_0cffe57e:

    # "Once the water shuts off, a loud fan starts up and I glance over to see Amicus with his arms out, his fur blowing back and forth."
    "Cum aqua sistitur, ventilator strepens incipit; eo aspicio et Amicum bracchiis extensis video, pilis ultro citroque iactatis."

# game/a1s2.rpy:299
translate latin a1s2_e6ca6eef:

    # "He notices me look over then look away again."
    "Me eo aspicere et rursus oculos avertere animadvertit."

# game/a1s2.rpy:300
translate latin a1s2_f3d3aa58:

    # a "\"You know—\""
    a "\"Scis—\""

# game/a1s2.rpy:301
translate latin a1s2_46fc34ac:

    # "He has to almost shout over the fan."
    "Paene clamare debet, ut supra ventilatoris strepitum audiatur."

# game/a1s2.rpy:302
translate latin a1s2_89c93c5d:

    # a "\"You could have cleaned up too if you'd showered with me, but you won't have time with breakfast coming up. You'll have to do it after.\""
    a "\"Tu quoque te purgare potuisses, si mecum sub imbre lavatus esses; sed iam, cum ientaculum instet, tempus non habebis. Postea id facere debebis.\""

# game/a1s2.rpy:304
translate latin a1s2_9d7554fd:

    # "I shrug and wait as Amicus steps out and grabs clean undergarments hanging from a hook which he spends the next minute tying on."
    "Umeros tollo et exspecto, dum Amicus exit et vestes interiores mundas de unco pendentes capit; per proximum minutum eas alligare occupatur."

# game/a1s2.rpy:306
translate latin a1s2_b2249ffd:

    # a "\"Alright, balls are gone. You can look now.\""
    a "\"Bene, colei iam tecti sunt. Nunc aspicere potes.\""

# game/a1s2.rpy:308
translate latin a1s2_28238fc3:

    # a "\"Actually, do you even have those? I don't want to assume.\""
    a "\"Re vera, num tu quoque eos habes? Id temere assumere nolo.\""

# game/a1s2.rpy:310
translate latin a1s2_7014aa1c:

    # "I open the door and head back out."
    "Ianuam aperio et rursus exeo."

# game/a1s2.rpy:311
translate latin a1s2_65ff7458:

    # m "\"Guess you'll never know.\""
    m "\"Credo te numquam sciturum.\""

# game/a1s2.rpy:313
translate latin a1s2_0281ebdc:

    # a "\"Hehe...\""
    a "\"Haha...\""

# game/a1s2.rpy:315
translate latin a1s2_6ae87941:

    # "Amicus spends another minute in the bathroom opening a door under the sink and rifling around in it."
    "Amicus aliud minutum in balneo consumit, ianuam sub labro aperiens atque intus scrutans."

# game/a1s2.rpy:316
translate latin a1s2_94a05b9a:

    # a "\"The next thing you're supposed to do is get the brush and oils from here.\""
    a "\"Proximum officium tuum est peniculum et olea hinc sumere.\""

# game/a1s2.rpy:317
translate latin a1s2_719caeb4:

    # "He lifts up a brush and a few glass bottles with colorful liquids inside before coming over to stand in front of me."
    "Peniculum et aliquot ampullas vitreas liquoribus coloratis plenas tollit, deinde accedit et ante me stat."

# game/a1s2.rpy:319
translate latin a1s2_e80f5281:

    # "He sighs."
    "Suspirat."

# game/a1s2.rpy:320
translate latin a1s2_6d95ab5b:

    # a "\"I know you don't want to, and I realize now that I'm repulsive to you, but I can't really reach every part of my coat, and it would be strange if I called for a drone when I have a pet...\""
    a "\"Scio te nolle, et iam intellego me tibi abominabilem esse; sed non ad omnes pilorum meorum partes pervenire possum, atque mirum esset si automaton arcesserem cum animal domesticum habeam...\""

# game/a1s2.rpy:321
translate latin a1s2_13c2285a:

    # "I think about making another moody remark, but the expression on his face makes me pause."
    "Aliud responsum morosum dare cogito, sed vultus eius me dubitare facit."

# game/a1s2.rpy:322
translate latin a1s2_33ed9f08:

    # "I suppose I am being a little bratty right now."
    "Credo me iam aliquantum pueriliter agere."

# game/a1s2.rpy:323
translate latin a1s2_bf5dca75:

    # "Besides, what else am I going to do while I'm here?"
    "Praeterea quid aliud faciam dum hic sum?"

# game/a1s2.rpy:324
translate latin a1s2_7f13708d:

    # "Sit on the sofa all day?"
    "Totum diem in lecto recubitorio sedebo?"

# game/a1s2.rpy:325
translate latin a1s2_28c12c91:

    # "I get up and take the brush from Amicus and I see a surprised smile on his face."
    "Surgo et peniculum ab Amico capio; risum miratum in vultu eius video."

# game/a1s2.rpy:327
translate latin a1s2_35308536:

    # a "\"Thank you, [mc].\""
    a "\"Gratias tibi ago, [mc].\""

# game/a1s2.rpy:328
translate latin a1s2_e81337bb:

    # "He shows me how to apply one of the liquids, a honey-colored one, to the brush."
    "Ostendit quomodo unum liquorem, melleo colore, ad peniculum applicem."

# game/a1s2.rpy:330
translate latin a1s2_24f921d6:

    # a "\"It's a treatment for my fur. It keeps it soft and voluminous-looking. Here, you just take the brush and run it with the lay of my fur.\""
    a "\"Hoc ad pilos meos curandos adhibetur. Eos molles tumidosque servat. Ecce, peniculum tantum capis et secundum pilorum inclinationem ducis.\""

# game/a1s2.rpy:331
translate latin a1s2_984ef80d:

    # "He hands the brush to me and then stands facing away."
    "Peniculum mihi tradit et deinde aversus stat."

# game/a1s2.rpy:332
translate latin a1s2_641dfd30:

    # "I start slowly and run the brush through the fur between his ears and down his broad back, watching as the slightly disheveled hairs line up and lay down smoothly."
    "Lente incipio et peniculum per pilos inter aures eius atque deorsum per latum dorsum duco, spectans pilos aliquantum incomptos componi leniterque subsidere."

# game/a1s2.rpy:333
translate latin a1s2_6ccd2497:

    # "It accentuates his shoulder blades and the thick and smooth muscles in his back."
    "Hoc scapulas eius et crassos laevesque dorsi musculos magis conspicuos reddit."

# game/a1s2.rpy:334
translate latin a1s2_b8b08507:

    # "I'm hesitant at first, but I become more confident with each stroke."
    "Primum dubito, sed singulis tractibus confidentior fio."

# game/a1s2.rpy:335
translate latin a1s2_5db7e02d:

    # "Actually it's kind of relaxing, that is until I brush down the left side of his neck which makes him gasp."
    "Re vera quodammodo animum relaxat, donec peniculum deorsum per sinistrum colli eius latus duco; tum is spiritum abrupte ducit."

# game/a1s2.rpy:337
translate latin a1s2_2429b70e:

    # "I pull back quickly."
    "Celeriter manum retraho."

# game/a1s2.rpy:338
translate latin a1s2_c8a2c67e:

    # m "\"Sorry! Did I brush too hard?\""
    m "\"Ignosce! Nimisne vehementer pexui?\""

# game/a1s2.rpy:340
translate latin a1s2_292c202c:

    # "Amicus chuckles."
    "Amicus leniter ridet."

# game/a1s2.rpy:341
translate latin a1s2_253e1b09:

    # a "\"Heh, no, that's just where you hit me earlier.\""
    a "\"Heh, non; ibi tantum me antea percussisti.\""

# game/a1s2.rpy:342
translate latin a1s2_89357ba6:

    # m "\"Oh...\""
    m "\"O...\""

# game/a1s2.rpy:343
translate latin a1s2_36fa1c4c:

    # "I look closer and see that there is what looks like a lump under the fur."
    "Diligentius aspicio et quasi tumorem sub pilis video."

# game/a1s2.rpy:344
translate latin a1s2_108aaffa:

    # "I carefully brush around it and move to Amicus's front."
    "Circum eum caute pecto et ad partem anteriorem Amici accedo."

# game/a1s2.rpy:345
translate latin a1s2_18283920:

    # "Amicus, meanwhile, has his eyes closed with a smile on his face, clearly enjoying himself."
    "Amicus interea oculis clausis ridet, plane voluptate fruens."

# game/a1s2.rpy:346
translate latin a1s2_754e763f:

    # m "\"I am sorry about that, by the way. I was really scared when I did it.\""
    m "\"Ceterum me eius rei paenitet. Valde timebam cum id feci.\""

# game/a1s2.rpy:348
translate latin a1s2_b38e9c28:

    # a "\"Don't worry about it. I deserved it for tying you up so poorly.\""
    a "\"Noli de eo sollicitus esse. Merui quod te tam male vinxeram.\""

# game/a1s2.rpy:349
translate latin a1s2_960cd13e:

    # "Amicus gives me a wink."
    "Amicus altero oculo mihi connivet."

# game/a1s2.rpy:350
translate latin a1s2_3c0c1fbc:

    # "I feel my face grow a little hot as I focus on getting the fur to lay just right on his biceps."
    "Faciem meam paulum calescere sentio, dum animum intendo ut pili in musculis bracchiorum eius recte iaceant."

# game/a1s2.rpy:351
translate latin a1s2_8e012fce:

    # m "\"And you know, you're not repulsive to me at all. I was just being a dick earlier. You look...good.\""
    m "\"Et scis, minime mihi abominabilis es. Ego antea tantum improbe agebam. Tu... bene videris.\""

# game/a1s2.rpy:352
translate latin a1s2_835ea40f:

    # a "\"Well, I suppose I was too. I shouldn't have made fun of your sensibilities. All aliens have their own cultures which are different, but that doesn't mean less valuable.\""
    a "\"Bene, credo me quoque ita egisse. Sensibilitatem tuam deridere non debui. Omnes alienigenae suos cultus habent, qui diversi sunt, sed non ideo minoris pretii.\""

# game/a1s2.rpy:353
translate latin a1s2_93ccfcfe:

    # "Amicus's tone sounds weirdly rehearsed, like he's quoting something."
    "Vox Amici mire praeparata sonat, quasi aliquid recitet."

# game/a1s2.rpy:354
translate latin a1s2_a3b6968d:

    # a "\"And also thank you, [mc]. I think you look good too.\""
    a "\"Atque tibi quoque gratias, [mc]. Te quoque bene videri puto.\""

# game/a1s2.rpy:355
translate latin a1s2_c1c547c4:

    # "He might just be returning the compliment, but it's nice to hear after what Cassius said."
    "Fortasse tantum laudem reddit, sed id audire iucundum est post verba Cassii."

# game/a1s2.rpy:356
translate latin a1s2_614a0415:

    # "But I definitely wasn't lying, and now that I'm this close to him, I have to admit that he is a little handsome."
    "Ego autem certe non mentiebar; iamque, cum tam prope eum sim, confiteri debeo eum aliquantum formosum esse."

# game/a1s2.rpy:357
translate latin a1s2_fb57ba20:

    # "His face is expressive and kind of charming and there's just a generally friendly air about him."
    "Vultus eius expressivus est et quodammodo venustus, atque omnino amicus quidam habitus eum circumdat."

# game/a1s2.rpy:358
translate latin a1s2_f6fc5d4d:

    # "And...well, then there's his body."
    "Et... bene, deinde corpus eius est."

# game/a1s2.rpy:359
translate latin a1s2_1cd47be7:

    # "It's thick and masculine, just like a burly human, and I really can't deny that it's kind of appealing...kind of."
    "Crassum est et virile, sicut corpus hominis robusti; negare non possum id quodammodo allicere... quodammodo."

# game/a1s2.rpy:360
translate latin a1s2_09c59ac2:

    # "I start to brush down the wolf's front, feeling his chest and stomach rise against the brush with his breathing."
    "Partem anteriorem lupi deorsum pectere incipio, sentiens pectus eius ventremque spirando contra peniculum attolli."

# game/a1s2.rpy:361
translate latin a1s2_02808b30:

    # "I sculpt the lighter fur around his pecs to accentuate them better since it seems that's how he was keeping it earlier."
    "Pilos pallidiores circa musculos pectoris compono, ut eos magis efferam, quoniam sic antea curasse videtur."

# game/a1s2.rpy:362
translate latin a1s2_41e470d8:

    # "I can't blame him."
    "Eum reprehendere non possum."

# game/a1s2.rpy:363
translate latin a1s2_f69d137b:

    # "Then I move to his belly, moving the brush over its thick and slightly rounded form."
    "Tum ad ventrem transeo, peniculum per crassam eius formam paulo rotundatam ducens."

# game/a1s2.rpy:364
translate latin a1s2_88ba2c0d:

    # "The muscles are less defined here, but I can still sense the strength underneath it all."
    "Musculi hic minus distincti sunt, sed vim sub omnibus latentem adhuc sentire possum."

# game/a1s2.rpy:365
translate latin a1s2_ab3e24ca:

    # "As I brush the lower part of his midsection, I notice the crotch of his loincloth bulging out rather far—"
    "Dum inferiorem ventris partem pecto, animadverto inguinem subligaculi eius satis longe prominere—"

# game/a1s2.rpy:367
translate latin a1s2_60ac79c6:

    # a "\"Alright! Thank you, [mc], that should be good!\""
    a "\"Bene! Gratias, [mc]; iam satis erit!\""

# game/a1s2.rpy:369
translate latin a1s2_dd3a059c:

    # "He takes the brush from my hands and turns away, leaving me with the strong suspicion that he's adjusting himself, though he covers it up by pretending to mess with the other bottle."
    "Peniculum e manibus meis capit et se avertit; vehementer suspicor eum se componere, quamquam id dissimulat fingens se alteram ampullam tractare."

# game/a1s2.rpy:370
translate latin a1s2_307beea0:

    # "Finally he turns around, looking flushed."
    "Tandem revertitur, vultu rubente."

# game/a1s2.rpy:372
translate latin a1s2_fbda45cd:

    # a "\"Uh, hold out your paws, please?\""
    a "\"Eh, manus tuas porrige, quaeso?\""

# game/a1s2.rpy:373
translate latin a1s2_422e55a1:

    # "I stick out my hands and he tips the bottle over, the liquid in this one having a purplish tint to it."
    "Manus porrigo, et ille ampullam inclinat; liquor in hac aliquantum purpureus est."

# game/a1s2.rpy:374
translate latin a1s2_ee82a34c:

    # "Several drops fall into my hand."
    "Aliquot guttae in manum meam cadunt."

# game/a1s2.rpy:375
translate latin a1s2_ec0de495:

    # "Immediately, my nose is filled with that lavender scent that I've been smelling off of Amicus since I first met him."
    "Statim nares meae odore lavandulae implentur, quem ab Amico sensi ex quo primum convenimus."

# game/a1s2.rpy:376
translate latin a1s2_8fc9ba6d:

    # a "\"Rub them together then just sort of pat up my body and underarms, along my neck as well.\""
    a "\"Manus inter se frica, deinde corpus meum axillasque leniter tange, item secundum collum.\""

# game/a1s2.rpy:377
translate latin a1s2_ce3057c7:

    # "I can tell Amicus is still flustered, so I do it quickly, not wanting to linger and cause the wolf any other...problems."
    "Intellego Amicum adhuc confusum esse, itaque celeriter facio, ne diutius morans alias... difficultates lupo afferam."

# game/a1s2.rpy:378
translate latin a1s2_76e5b8cb:

    # "Maybe it just feels really good to be brushed like that?."
    "Fortasse tantum suavissimum est ita pecti?."

# game/a1s2.rpy:379
translate latin a1s2_9f2867e4:

    # m "\"Is this like, perfume?\""
    m "\"Hoc quasi unguentum est?\""

# game/a1s2.rpy:381
translate latin a1s2_f0ecf3e5:

    # a "\"Yes, it keeps the muskier scents hidden for the most part.\""
    a "\"Ita, odores moschatos plerumque tegit.\""

# game/a1s2.rpy:382
translate latin a1s2_0746d850:

    # m "\"I see.\""
    m "\"Intellego.\""

# game/a1s2.rpy:383
translate latin a1s2_70fa7cbd:

    # a "\"Do you use perfume?\""
    a "\"Tu unguento uteris?\""

# game/a1s2.rpy:384
translate latin a1s2_758da496:

    # m "\"Well, I guess I do wear something like that on my underarms.\""
    m "\"Bene, credo me aliquid simile sub axillis adhibere.\""

# game/a1s2.rpy:386
translate latin a1s2_3cd4d3ee:

    # a "\"Feel free to use it then!\""
    a "\"Tum eo libere utere!\""

# game/a1s2.rpy:387
translate latin a1s2_ab709298:

    # "I decide not to tell him that lavender scents are mostly for women on Earth...besides, it does smell nice."
    "Statuo ei non dicere odores lavandulae in Terra maxime feminis destinari... praeterea sane bene olet."

# game/a1s2.rpy:389
translate latin a1s2_9a3ec837:

    # "Once the perfume is done, Amicus moves on to getting dressed, showing me how to drape his cape over his shoulders."
    "Unguento adhibito, Amicus se vestire incipit, mihi ostendens quomodo pallium super umeros eius ponam."

# game/a1s2.rpy:391
translate latin a1s2_b08a7842:

    # a "\"Alright! So I know you only have the pair of clothes you came with, so I'll have a tailor drone come up later today to see if we can't make you more pairs of what you have.\""
    a "\"Bene! Scio te tantum vestes habere quibus venisti; itaque automaton sartoris postea hodie arcessam, ut videat an plura exemplaria vestium tuarum facere possimus.\""

# game/a1s2.rpy:392
translate latin a1s2_ac7e79cb:

    # m "\"Oh, okay.\""
    m "\"Oh, bene.\""

# game/a1s2.rpy:393
translate latin a1s2_b008dabd:

    # a "\"Now, lets head to the dining room before we're late.\""
    a "\"Nunc ad triclinium eamus, ne sero veniamus.\""

# game/a1s2.rpy:395
translate latin a1s2_5007375d:

    # "Amicus pauses, frowning."
    "Amicus consistit, frontem corrugans."

# game/a1s2.rpy:396
translate latin a1s2_d628d6e8:

    # a "\"Now...I know you won't like it, but you're going to have to feign some ignorance in front of the others.\""
    a "\"Iam... scio tibi non placiturum, sed coram ceteris aliquantum ignorantiae simulare debebis.\""

# game/a1s2.rpy:397
translate latin a1s2_09722dcb:

    # "I raise an eyebrow."
    "Supercilium tollo."

# game/a1s2.rpy:398
translate latin a1s2_707d2a10:

    # m "\"How so?\""
    m "\"Quomodo?\""

# game/a1s2.rpy:399
translate latin a1s2_89ebdce6:

    # a "\"Well, you're going to need to act a bit...dumb.\""
    a "\"Bene, aliquantum... stulte agere debebis.\""

# game/a1s2.rpy:400
translate latin a1s2_450a84b2:

    # "The antagonistic feelings that had been fading over the past few minutes start to rise up again."
    "Inimici animi sensus, qui per minuta praeterita languescebant, rursus exsurgere incipiunt."

# game/a1s2.rpy:401
translate latin a1s2_f141bf14:

    # m "\"And how do I do that?\""
    m "\"Et quomodo id facio?\""

# game/a1s2.rpy:402
translate latin a1s2_f887bb98:

    # "Amicus shrugs."
    "Amicus umeros tollit."

# game/a1s2.rpy:403
translate latin a1s2_601c2652:

    # a "\"I don't know, give them vacant stares, incoherent mumbles, act like you can't grasp more complex matters. The whole point is to make it seems like you're a typical Child.\""
    a "\"Nescio: eos vacuis oculis aspice, verba incomposita murmura, simula te res implicatiores comprehendere non posse. Hoc totum agitur ut Liber usitatus esse videaris.\""

# game/a1s2.rpy:404
translate latin a1s2_08f25cf9:

    # "I don't like it, but I don't want to have anything to do with those aliens so if it'll make them leave me alone..."
    "Non mihi placet, sed cum illis alienigenis nihil commune habere volo; si ita me quietum relinquent..."

# game/a1s2.rpy:405
translate latin a1s2_6f19d038:

    # m "\"Alright.\""
    m "\"Bene.\""

# game/a1s2.rpy:407
translate latin a1s2_9a3bb917:

    # "Amicus lets out a breath, clearly relieved."
    "Amicus spiritum emittit, plane levatus."

# game/a1s2.rpy:408
translate latin a1s2_e831ca56:

    # a "\"Thank you, [mc]. This may not always have to be the case, but for now we need to play on the safe side of things. Just let me do all of the talking.\""
    a "\"Gratias, [mc]. Fortasse non semper ita faciendum erit, sed nunc cautius agere debemus. Sine me tantum omnia dicere.\""

# game/a1s2.rpy:409
translate latin a1s2_7925e595:

    # m "\"You got it.\""
    m "\"Intellexi.\""

# game/a1s2.rpy:412
translate latin a1s2_a1172564:

    # a "\"Great! Now let's hurry to the dining room. I don't want to make Cato more angry than he already is.\""
    a "\"Optime! Nunc ad triclinium festinemus. Catonem iratiorem quam iam est reddere nolo.\""

# game/a1s2.rpy:415
translate latin a1s2_e14a2515:

    # "And with that, I follow Amicus out into the hallway."
    "His dictis Amicum in andronem sequor."

# game/a1s2.rpy:416
translate latin a1s2_f4db22b5:

    # m "\"So who's Cato?\""
    m "\"Quis ergo Cato est?\""

# game/a1s2.rpy:418
translate latin a1s2_94a3dc34:

    # a "\"The wolf you saw with my brother. He was my father's advisor and currently the acting emperor. I mentioned earlier that he'll be choosing between me and my brother.\""
    a "\"Lupus quem cum fratre meo vidisti. Consiliarius patris mei erat, et nunc imperatoris munere ad tempus fungitur. Antea dixi eum inter me et fratrem meum electurum.\""

# game/a1s2.rpy:419
translate latin a1s2_4fdffe79:

    # a "\"That's why I'm doing my best to keep him in a good mood, or at least not a bad mood. I don't think he has a good one.\""
    a "\"Ideo quantum possum curo ut bono animo sit, vel saltem ne malo. Non puto eum umquam bono esse.\""

# game/a1s2.rpy:420
translate latin a1s2_cea68322:

    # "I keep in mind to stay on Cato's good side as well."
    "Memini mihi quoque favorem Catonis servandum esse."

# game/a1s2.rpy:421
translate latin a1s2_faa34b17:

    # "Meanwhile, sunlight pours in through the open windows, and I can hear birds calling from outside again."
    "Interea lux solis per fenestras apertas effunditur, atque rursus aves foris clamantes audio."

# game/a1s2.rpy:422
translate latin a1s2_dc922423:

    # m "\"Birds.\""
    m "\"Aves.\""

# game/a1s2.rpy:423
translate latin a1s2_ac78218d:

    # a "\"What was that?\""
    a "\"Quid illud erat?\""

# game/a1s2.rpy:424
translate latin a1s2_f2416e81:

    # m "\"I can hear birds. I'm just surprised they sound the same as they do on Earth.\""
    m "\"Aves audio. Tantum miror eas eodem modo sonare ac in Terra.\""

# game/a1s2.rpy:425
translate latin a1s2_abecf708:

    # a "\"Ah, yes, you wouldn't know this; all life has the same origin and develops in a roughly similar way. It's only natural that life here is similar to your moon...planet, I mean.\""
    a "\"Ah, ita, hoc nescies: omnis vita eandem originem habet et fere simili modo crescit. Nihil mirum est vitam hic similem esse vitae in luna tua... planeta, dico.\""

# game/a1s2.rpy:426
translate latin a1s2_2d6ee573:

    # m "\"Oh.\""
    m "\"O.\""

# game/a1s2.rpy:428
translate latin a1s2_ca061006:

    # a "\"Well, all life on this side of the universe, at least. There may be another but we'll have to leave that conversation for later. For now—\""
    a "\"Saltem omnis vita in hac universi parte. Fortasse alia est, sed illum sermonem in posterum differemus. Nunc—\""

# game/a1s2.rpy:432
translate latin a1s2_93434cab:

    # "I follow Amicus around a corner and find myself standing in a large, spacious room."
    "Amicum circa angulum sequor atque in conclavi magno spatiosoque me stantem invenio."

# game/a1s2.rpy:433
translate latin a1s2_7737158a:

    # "The first things I notice are the large screens on each wall of the room, displaying colorful images of stars, galaxies, and spaceships."
    "Primum magnae tabulae visuales in singulis parietibus mihi occurrunt, stellas, galaxias navesque spatiales coloratis imaginibus ostendentes."

# game/a1s2.rpy:434
translate latin a1s2_8564f8f0:

    # "In the middle of the room are what look like beds surrounding a table."
    "In medio conclavi quasi lecti circa mensam positi sunt."

# game/a1s2.rpy:435
translate latin a1s2_1a812b21:

    # "In those beds are the two wolves I saw earlier."
    "In illis lectis duo lupi sunt quos antea vidi."

# game/a1s2.rpy:439
translate latin a1s2_8b89a9c5:

    # "Cato is sitting and leaning over toward Cassius who is draped luxuriously over one of the beds."
    "Cato sedet et ad Cassium inclinat, qui luxuriose in uno lectorum recumbit."

# game/a1s2.rpy:440
translate latin a1s2_0ae372cc:

    # "Cato is talking to Cassius while the other wolf has on his typical sour expression."
    "Cato cum Cassio loquitur, dum alter lupus solitum vultum acidum ostendit."

# game/a1s2.rpy:441
translate latin a1s2_56411634:

    # "Sitting on the floor in front of Cassius's bed is a creature that I've never seen before."
    "Ante lectum Cassii in solo sedet creatura quam numquam antea vidi."

# game/a1s2.rpy:443
translate latin a1s2_4ebd73ed:

    # "It's definitely not a wolf, more feline-like."
    "Certe lupus non est; feli potius similis est."

# game/a1s2.rpy:444
translate latin a1s2_039b5d68:

    # "Cassius has his paw on its head, idly scratching it while he listens to whatever Cato is saying."
    "Cassius manum super caput eius habet, id otiose scalpens dum auscultat quidquid Cato dicit."

# game/a1s2.rpy:446
translate latin a1s2_f3805fa2:

    # "He sees us and abruptly stops, sitting up."
    "Nos videt atque subito desinit, se erigens."

# game/a1s2.rpy:447
translate latin a1s2_549c02c4:

    # "Cato stops talking and looks over at us."
    "Cato loqui desinit et ad nos aspicit."

# game/a1s2.rpy:449
translate latin a1s2_58063df9:

    # c "\"You're late.\""
    c "\"Sero venitis.\""

# game/a1s2.rpy:451
translate latin a1s2_381ed571:

    # a "\"And good morning to you, Cass. And to you Cato, Alexios.\""
    a "\"Et tibi quoque bonum mane, Cass. Tibique, Cato, Alexie.\""

# game/a1s2.rpy:452
translate latin a1s2_488e7cf7:

    # "Amicus turns to Cato and the small cat creature, bowing to both of them."
    "Amicus ad Catonem et parvam creaturam felinam vertitur atque ambobus se inclinat."

# game/a1s2.rpy:454
translate latin a1s2_ec93fe0e:

    # ca "\"Good morning.\""
    ca "\"Bonum mane.\""

# game/a1s2.rpy:456
translate latin a1s2_226a8a1b:

    # al "\"Morning, Amicus.\""
    al "\"Bonum mane, Amice.\""

# game/a1s2.rpy:457
translate latin a1s2_ddd095a5:

    # "The cat, Alexios, nods at Amicus with a smile."
    "Felis, Alexios, Amico subridens annuit."

# game/a1s2.rpy:458
translate latin a1s2_53e436c3:

    # "At the same time I see Cassius tug on the gold collar around his neck."
    "Simul Cassium torquem aureum circa collum eius trahere video."

# game/a1s2.rpy:460
translate latin a1s2_a496e1bb:

    # "It isn't very much, but Alexios immediately drops the smile from his face, looking down."
    "Non multum trahit, sed Alexios statim ridere desinit atque deorsum aspicit."

# game/a1s2.rpy:462
translate latin a1s2_e77e00fb:

    # c "\"How many times do I have to tell you not to acknowledge him, Amicus?\""
    c "\"Quotiens tibi dicendum est ne eum agnoscas, Amice?\""

# game/a1s2.rpy:463
translate latin a1s2_4714c0b5:

    # "Amicus seems to ignore Cassius, walking to the empty bed while pulling me along with him."
    "Amicus Cassium neglegere videtur, ad lectum vacuum ambulans meque secum trahens."

# game/a1s2.rpy:464
translate latin a1s2_2e600917:

    # "He whispers in my ear."
    "In aurem meam susurrat."

# game/a1s2.rpy:466
translate latin a1s2_a0448d24:

    # a "\"Sit in front like Alex is doing.\""
    a "\"Ante lectum sede, sicut Alex facit.\""

# game/a1s2.rpy:468
translate latin a1s2_95d67972:

    # "I look over at the cat and see his ears perk up in our direction, though he continues to avoid looking at us."
    "Felem aspicio et aures eius ad nos erigi video, quamquam nos aspicere adhuc vitat."

# game/a1s2.rpy:469
translate latin a1s2_5d323290:

    # "He's in a kneeling position, so I do the same, starting to feel a little uneasy about this whole setup."
    "Genibus flexis sedet; idem ego facio, iam aliquantum de hac tota ratione sollicitus."

# game/a1s2.rpy:471
translate latin a1s2_9dbbf0a9:

    # "Amicus, meanwhile, stretches out across the bed, an elbow in the cushions as he props himself up."
    "Amicus interea per lectum extenditur, cubito in pulvinos innixo quo se sustineat."

# game/a1s2.rpy:473
translate latin a1s2_3a76fbdd:

    # ca "\"Com, send in breakfast.\""
    ca "\"Com, ientaculum mitte.\""

# game/a1s2.rpy:474
translate latin a1s2_6123227d:

    # com "\"Yes, Cato.\""
    com "\"Ita, Cato.\""

# game/a1s2.rpy:475
translate latin a1s2_d33d62dd:

    # "A few seconds later, literal flying saucers levitate into the room from beyond another archway."
    "Paucis secundis post patellae vere volantes per alium arcum in conclave levitant."

# game/a1s2.rpy:476
translate latin a1s2_7153f104:

    # "I get a moment to see some sort of black device on the underside of the plates before they gently come to rest on the table."
    "Aliquid quasi instrumentum nigrum sub patellis paulisper videre possum, antequam leniter in mensa considunt."

# game/a1s2.rpy:477
translate latin a1s2_8a7fd14f:

    # "I blink, but don't say anything, deciding to just take everything in without question."
    "Nicto, sed nihil dico, statuens omnia sine interrogatione tantum observare."

# game/a1s2.rpy:478
translate latin a1s2_8056d513:

    # "I decide instead to focus on the food."
    "Potius cibum curare statuo."

# game/a1s2.rpy:479
translate latin a1s2_570e4b49:

    # "I can at least identify a few of the portions, one of them being what looks like bread."
    "Saltem aliquot cibi partes agnoscere possum, quarum una panis esse videtur."

# game/a1s2.rpy:480
translate latin a1s2_611fe424:

    # "Then there's a plate of a odd, white, crumbly substance and next to that is a bowl of what I'm pretty sure are olives."
    "Tum patella est plena mira substantia alba friabili, et iuxta eam patera cum rebus quas certe olivas esse puto."

# game/a1s2.rpy:481
translate latin a1s2_bfb6e750:

    # "There's a glass bottle filled with some type of red liquid, probably wine."
    "Ampulla vitrea est quodam liquore rubro plena, probabiliter vino."

# game/a1s2.rpy:482
translate latin a1s2_ee560e10:

    # "Finally, in the middle, next to some towel-like napkins, is roasted poultry, golden-colored and steaming."
    "Denique in medio, iuxta mappas linteis similes, avis assa est, aurea vaporeque fumans."

# game/a1s2.rpy:483
translate latin a1s2_dad3b324:

    # "It actually smells really, really good and, considering that I haven't eaten any real food in over day, I feel my mouth water."
    "Re vera valde, valde bene olet; cumque verum cibum plus die non ederim, salivam mihi moveri sentio."

# game/a1s2.rpy:484
translate latin a1s2_b47000a8:

    # "Still, I have enough common sense to know that I probably can't just dig in, so I keep an eye on the cat, waiting to see what he does next."
    "Tantum tamen prudentiae habeo ut sciam me probabiliter non posse statim edere; itaque felem observo, exspectans quid deinde faciat."

# game/a1s2.rpy:486
translate latin a1s2_9d686435:

    # "He grabs four small plates from the tall stack and sets them down in front of himself."
    "Quattuor patellas e magna strue capit et ante se ponit."

# game/a1s2.rpy:487
translate latin a1s2_2feb6f2d:

    # "Then he starts to grab some slices of bread which he sets down on one of the plates."
    "Tum aliquot panis crustas sumere incipit easque in una patella ponit."

# game/a1s2.rpy:489
translate latin a1s2_c10096e7:

    # "I look back at Amicus and he nods."
    "Ad Amicum respicio, et ille annuit."

# game/a1s2.rpy:490
translate latin a1s2_3acd0c7f:

    # "So I do the same, grabbing four plates and setting them out in front of myself on the table, starting to grab the separate portions of food to set them on their own plate."
    "Itaque idem facio: quattuor patellas capio et ante me in mensa dispono, deinde singulas cibi partes capere incipio ut cuique suam patellam tribuam."

# game/a1s2.rpy:491
translate latin a1s2_f198907d:

    # "Meanwhile, Cato just leans over to grab his own while Cassius clears his throat."
    "Cato interea tantum inclinat ut sibi cibum sumat, dum Cassius tussicula fauces purgat."

# game/a1s2.rpy:493
translate latin a1s2_d0fa9262:

    # c "\"So...Amicus. What is this?\""
    c "\"Ergo... Amice. Quid est hoc?\""

# game/a1s2.rpy:494
translate latin a1s2_f838fbc4:

    # "I look up and immediately find Cassius's eyes boring into mine."
    "Sursum aspicio et statim oculos Cassii meos intentissime figentes invenio."

# game/a1s2.rpy:495
translate latin a1s2_f7ffd426:

    # "I quickly look back down and grab up the wood-handled knife that Alexios just set down, using it to spread the white stuff onto the slices of bread."
    "Celeriter deorsum respicio et cultrum capulo ligneo capio quem Alexios modo deposuit, eo utens ut substantiam albam super panis crustas linam."

# game/a1s2.rpy:496
translate latin a1s2_7fb7500c:

    # "I wrinkle my nose at how stinky it is and I realize it's probably some type of cheese."
    "Nasum corrugo, adeo male olet, atque intellego id probabiliter genus quoddam casei esse."

# game/a1s2.rpy:498
translate latin a1s2_e244f5c9:

    # a "\"This is [mc]. He's my pet.\""
    a "\"Hic est [mc]. Animal domesticum meum est.\""

# game/a1s2.rpy:499
translate latin a1s2_bf12df44:

    # c "\"No, Amicus. WHAT is it. It's not one of our Children. Does it belong to a Sibling?\""
    c "\"Non, Amice. QUID est. Non est unus ex Liberis nostris. Ad Fratrem aliquem pertinet?\""

# game/a1s2.rpy:500
translate latin a1s2_ac80555b:

    # "I'm half-listening to the conversation while I see Alexios reach out with his bare paws and just pull a chunk of meat off of the poultry."
    "Sermonem partim ausculto, dum Alexium video manus nudas porrigentem et simpliciter carnis frustum ab ave avellentem."

# game/a1s2.rpy:501
translate latin a1s2_87be0276:

    # "I hesitate, kind of wishing I'd had a chance to wash my hands, but do it anyway, wincing at how hot it is."
    "Haesito, quodammodo optans mihi tempus manus lavandi fuisse, sed tamen facio, vultum contrahens quia tam calida est."

# game/a1s2.rpy:502
translate latin a1s2_001d9267:

    # "The temptation is strong just to stuff it in my mouth, but I manage to set it down on the plate."
    "Vehementer cupio id statim in os inferre, sed possum me continere et in patella ponere."

# game/a1s2.rpy:503
translate latin a1s2_e93bca62:

    # "Finally, I grab up a bunch of olives and put them on their own plate."
    "Denique plures olivas capio et in sua patella pono."

# game/a1s2.rpy:504
translate latin a1s2_d05e8246:

    # "At this point, I can see that Alexios is lining his plates up in front of Cassius on the bed."
    "Iam video Alexium patellas ante Cassium in lecto ordine disponere."

# game/a1s2.rpy:505
translate latin a1s2_0f3b0677:

    # "Carefully, I do the same for Amicus, though I lose an olive in the process."
    "Caute idem Amico facio, quamquam interea olivam unam amitto."

# game/a1s2.rpy:506
translate latin a1s2_d27e1bce:

    # "I watch it roll across the ground, but decide to ignore it, and Amicus just pats my head with a muttered \"thank you\"."
    "Eam per solum volvi observo, sed neglegere statuo; Amicus tantum caput meum leniter pulsat, \"gratias\" murmurans."

# game/a1s2.rpy:507
translate latin a1s2_d799b5d9:

    # a "\"No....he's from a failed uplift.\""
    a "\"Non... e specie venit quae frustra ad altiorem cultum provehi temptata est.\""

# game/a1s2.rpy:512
translate latin a1s2_c16b096d:

    # "I watch as Alexios starts filling a goblet with the red liquid, but look up when I realize there's complete silence."
    "Alexium calicem liquore rubro implere incipientem observo, sed sursum aspicio cum summum silentium esse intellego."

# game/a1s2.rpy:513
translate latin a1s2_c622b876:

    # "Cassius and Cato are both staring at Amicus."
    "Cassius et Cato ambo Amicum intuentur."

# game/a1s2.rpy:514
translate latin a1s2_ad698a2e:

    # "I look back at him and see that he looks pretty calm, though I can see him picking at his claws."
    "Ad eum respicio; satis tranquillus videtur, quamquam ungues suos tractantem video."

# game/a1s2.rpy:515
translate latin a1s2_91020728:

    # c "\"A—are you serious?\""
    c "\"S—serio loqueris?\""

# game/a1s2.rpy:517
translate latin a1s2_bcc81977_2:

    # a "\"Yes.\""
    a "\"Ita.\""

# game/a1s2.rpy:518
translate latin a1s2_ab92db27:

    # c "\"Wh—Why!? He's a barbarian!\""
    c "\"Qu—cur!? Barbarus est!\""

# game/a1s2.rpy:519
translate latin a1s2_c95f8e88:

    # a "\"Because I've decided the abandoned Children deserve to re-establish regular contact. If we're to unite with the Khemians then we also need to unite ourselves—\""
    a "\"Quia decrevi Liberos desertos mereri ut contactum assiduum restituant. Si cum Khemianis coniungendi sumus, etiam nos ipsi coniungi debemus—\""

# game/a1s2.rpy:520
translate latin a1s2_d230f365:

    # "I start filling Amicus's goblet as I feel his eyes on me."
    "Calicem Amici implere incipio, dum oculos eius in me sentio."

# game/a1s2.rpy:522
translate latin a1s2_843658d4:

    # a "\"—Child or not. Having a pet like this will show the Khemians my intentions.\""
    a "\"—sive Liber est sive non. Tale animal domesticum habere Khemianis consilia mea ostendet.\""

# game/a1s2.rpy:524
translate latin a1s2_fe22bf13:

    # "Cassius scoffs loudly, popping an olive into his his mouth and chewing it vigorously."
    "Cassius clare irridet, olivam in os coniciens et vehementer mandens."

# game/a1s2.rpy:525
translate latin a1s2_e036495c:

    # c "\"Masterful stunt, Amicus, but you still stole father's ship to get there. Using Stretch tech without authorization from the emperor is a violation of the law, is it not, Cato?\""
    c "\"Dolus egregius, Amice, sed tamen navem patris furatus es ut illuc pervenires. Arte Distensionis uti sine imperatoris auctoritate legem violat, nonne, Cato?\""

# game/a1s2.rpy:526
translate latin a1s2_9195a762:

    # "I hand the goblet to Amicus, silently wondering if the wolf is going to be thrown in jail my first day here."
    "Calicem Amico trado, tacitus quaerens an lupus primo meo die hic in carcerem mittatur."

# game/a1s2.rpy:527
translate latin a1s2_338d5517:

    # "What would happen to me then?"
    "Quid tum mihi accideret?"

# game/a1s2.rpy:528
translate latin a1s2_dc6f95fe:

    # "Still, Amicus looks calm and when he sees my wide eyes he just winks."
    "Amicus tamen tranquillus videtur, et cum oculos meos dilatatos videt, tantum connivet."

# game/a1s2.rpy:530
translate latin a1s2_b0cc8a74:

    # ca "\"It could be, but there is no emperor is there, Cassius?\""
    ca "\"Fortasse violaret, sed imperator nullus est, nonne, Cassi?\""

# game/a1s2.rpy:531
translate latin a1s2_d5f13764:

    # "Cato finally lays back, his small plates heaped high with food."
    "Cato tandem reclinatur, patellis suis cibo alte cumulatis."

# game/a1s2.rpy:532
translate latin a1s2_3cd51fc0:

    # "He turns his head back to Amicus."
    "Caput rursus ad Amicum vertit."

# game/a1s2.rpy:533
translate latin a1s2_3e50271f:

    # ca "\"Are you saying you piloted the ship to the outer reaches of our empire? Voice commands only work for the emperor, if I'm not mistaken.\""
    ca "\"Dicisne te navem ad extremas imperii nostri regiones gubernavisse? Mandata vocalia soli imperatori parent, nisi fallor.\""

# game/a1s2.rpy:534
translate latin a1s2_35ff6831:

    # a "\"That is correct. I learned to navigate the ship on my own. I was also able to communicate with their people, negotiate, AND sign a, uh, contract with him.\""
    a "\"Recte. Navem ipse gubernare didici. Cum gente eorum quoque loqui et pacisci potui, ET pactionem, eh, cum eo subsignare.\""

# game/a1s2.rpy:535
translate latin a1s2_4041811a:

    # "This is where I start to hear Amicus's voice falter."
    "Hic vocem Amici vacillare audire incipio."

# game/a1s2.rpy:536
translate latin a1s2_b0b88c08:

    # "I actually do believe now that he doesn't lie often, because it's clear that he's so bad at it."
    "Iam re vera credo eum non saepe mentiri, quia plane tam male id facit."

# game/a1s2.rpy:537
translate latin a1s2_3981907b:

    # "I copy Alexios and return to my kneeling position next to the bed, then switch to a cross-legged one when my knees get too sore."
    "Alexium imitor et rursus genibus flexis iuxta lectum consido; tum, cum genua nimium dolent, cruribus decussatis sedeo."

# game/a1s2.rpy:538
translate latin a1s2_14228008:

    # "Cato watches from his bed silently, and I again feel unnerved at the feeling that he might be looking at me."
    "Cato e lecto tacitus observat; iterum me perturbat cogitatio eum fortasse me aspicere."

# game/a1s2.rpy:540
translate latin a1s2_4c4725d5:

    # ca "\"Fascinating.\""
    ca "\"Mirabile.\""

# game/a1s2.rpy:541
translate latin a1s2_9cc7cfc0:

    # "Cassius curls his lips back."
    "Cassius labra retrahit."

# game/a1s2.rpy:543
translate latin a1s2_ab82ceee:

    # c "\"Fascinating!? He used the Stretch Drive! He's going to get away with it because father is dead? What does that make of all the other laws?\""
    c "\"Mirabile!? Propulsore Distensionis usus est! Impune abibit quia pater mortuus est? Quid tum de omnibus ceteris legibus fit?\""

# game/a1s2.rpy:544
translate latin a1s2_1b06a644:

    # c "\"Can a beggar now steal from the market because there is no authority to tell him not to? Can a Child rebel from the empire because there is no emperor to tell them—\""
    c "\"Potestne mendicus iam in foro furari, quia nemo est qui eum prohibeat? Potestne Liber ab imperio desciscere, quia imperator nullus est qui ei dicat—\""

# game/a1s2.rpy:546
translate latin a1s2_de6e75c6:

    # ca "\"Quiet, Cassius. You know the circumstances as well as I do.\""
    ca "\"Tace, Cassi. Res non minus bene quam ego nosti.\""

# game/a1s2.rpy:548
translate latin a1s2_97213013:

    # "Cassius snaps his mouth shut with a huff, turning his attention back to his food which he starts to pick at."
    "Cassius ore subito clauso fremit, deinde rursus cibum curat, quem carpere incipit."

# game/a1s2.rpy:549
translate latin a1s2_00acec2b:

    # "The conversation seems to stop there, and I wonder if Amicus is in the clear."
    "Sermo ibi finiri videtur, et quaero an Amicus iam extra periculum sit."

# game/a1s2.rpy:550
translate latin a1s2_f05a2fd1:

    # "While Cassius sure seemed indignant, I get the feeling that Amicus wasn't in any danger in the first place."
    "Quamquam Cassius certe indignatus videbatur, sentio Amicum numquam vere in periculo fuisse."

# game/a1s2.rpy:551
translate latin a1s2_3b4fde8e:

    # "I guess being the emperor's son has its perks."
    "Credo imperatoris filium esse sua commoda habere."

# game/a1s2.rpy:553
translate latin a1s2_f6250603:

    # a "\"Could you get me some more of the {i}azure{/i}, [mc]?\""
    a "\"Possisne mihi paulo plus de {i}azure{/i} dare, [mc]?\""

# game/a1s2.rpy:554
translate latin a1s2_7cfc7e60:

    # "I look over to the table for a moment in confusion."
    "Paulisper confusus mensam aspicio."

# game/a1s2.rpy:555
translate latin a1s2_db77bf0f:

    # m "\"Um...what's that?\""
    m "\"Eh... quid est id?\""

# game/a1s2.rpy:556
translate latin a1s2_e4606685:

    # "I try to keep my voice low, but that's when Cassius suddenly yowls, clapping a paw to his head."
    "Vocem summissam servare conor, sed tum Cassius subito ululat, manum ad caput applicans."

# game/a1s2.rpy:558
translate latin a1s2_14dceecf:

    # c "\"Oh Gods! It doesn't speak the Language?\""
    c "\"O di! Nonne Linguam loquitur?\""

# game/a1s2.rpy:559
translate latin a1s2_1fd42929:

    # "I look between Cassius and Amicus in confusion."
    "Modo Cassium, modo Amicum confusus aspicio."

# game/a1s2.rpy:561
translate latin a1s2_6269c0ee:

    # a "\"Of course not, they were abandoned.\""
    a "\"Certe non; deserti sunt.\""

# game/a1s2.rpy:562
translate latin a1s2_7b548e96:

    # ca "\"Most of the abandoned still speak the Language...how far away is his home star?\""
    ca "\"Plerique desertorum adhuc Linguam loquuntur... quam longe stella eius patria abest?\""

# game/a1s2.rpy:563
translate latin a1s2_519840f4:

    # a "\"Roughly fifty thousand light years.\""
    a "\"Quinquaginta fere milibus annorum lucis.\""

# game/a1s2.rpy:564
translate latin a1s2_24329983:

    # c "\"I don't care! Don't have it speak again. The last thing I need is a headache from the Lingua manually translating everything he says. It's barbaric.\""
    c "\"Nihil mea refert! Noli sinere id rursus loqui. Minime mihi opus est dolore capitis, dum Lingua singula quae dicit sine notitia praeparata vertit. Barbarum est.\""

# game/a1s2.rpy:565
translate latin a1s2_a872124c:

    # "I don't know if he's calling the headache barbaric, or me...probably me."
    "Nescio an dolorem capitis barbarum dicat an me... probabiliter me."

# game/a1s2.rpy:567
translate latin a1s2_ea9b3f44:

    # c "\"Upload its language to the Nexus before you let it out in public again, Amicus.\""
    c "\"Linguam eius in Nexum immitte priusquam id rursus in publicum emittas, Amice.\""

# game/a1s2.rpy:568
translate latin a1s2_4063fbd7:

    # "I decide I really don't like Cassius."
    "Statuo Cassium mihi vere displicere."

# game/a1s2.rpy:569
translate latin a1s2_db7e4bf0:

    # "He's talking about me like I'm like I'm just a piece of property..."
    "De me loquitur quasi res tantum possessa sim..."

# game/a1s2.rpy:571
translate latin a1s2_2a62d5dc:

    # "Then I feel Amicus's paw on my shoulder for a moment, giving a soft squeeze before pulling back again."
    "Tum manum Amici paulisper super umerum meum sentio; eum leniter comprimit, deinde iterum retrahit."

# game/a1s2.rpy:572
translate latin a1s2_1b0812e0:

    # "The conversation topic then shifts to stuff I don't really understand, mostly politics and the Khemians, whatever that is."
    "Tum sermo ad res transit quas parum intellego, maxime ad rem publicam et Khemianos, quidquid ii sunt."

# game/a1s2.rpy:573
translate latin a1s2_43854a2c:

    # "Despite their fight earlier, Amicus and Cassius are pretty animated in their conversation."
    "Quamquam antea litigaverunt, Amicus et Cassius satis alacriter colloquuntur."

# game/a1s2.rpy:574
translate latin a1s2_6be02b8d:

    # "Amicus keeps sticking empty plates in my face, indicating that I should refill them."
    "Amicus patellas vacuas identidem ante faciem meam porrigit, significans eas mihi rursus implendas esse."

# game/a1s2.rpy:575
translate latin a1s2_c9fded95:

    # "It's clear that I'm not going to be eating while the wolves are, and I feel my irritation grow."
    "Manifestum est me non esurum dum lupi edunt, atque irritationem meam crescere sentio."

# game/a1s2.rpy:576
translate latin a1s2_f936b600:

    # "I'm not a servant, I didn't agree to this, and even if this is supposed to help me blend in, I can't help but feel Amicus could have put me in a better position than this."
    "Servus non sum neque huic rei consensi; quamquam haec fieri dicuntur ut inter ceteros lateam, facere non possum quin putem Amicum meliore condicione quam hac me ponere potuisse."

# game/a1s2.rpy:577
translate latin a1s2_b1b4bde1:

    # c "\"Virginia sent me a letter last night saying that she'd be bringing back a Khemian tomorrow. He got trapped here after the Stretch Drive depletion.\""
    c "\"Virginia mihi heri nocte litteras misit, dicens se cras Khemianum adducturam. Hic haesit postquam energia Propulsoris Distensionis defecit.\""

# game/a1s2.rpy:579
translate latin a1s2_1ee0b7af:

    # a "\"Oh? He wasn't able to return on the retrieval ship?\""
    a "\"O? Non potuit in nave ad eos repetendos missa redire?\""

# game/a1s2.rpy:581
translate latin a1s2_3585f6c9:

    # c "\"He was on Ancoris at the time, so it took him several months to get back to Adastra. He's going to be our guest until the next ship arrives.\""
    c "\"Tunc in Ancoris erat, itaque aliquot menses ad Adastram redeundo consumpsit. Hospes noster erit donec proxima navis adveniat.\""

# game/a1s2.rpy:582
translate latin a1s2_88bbe683:

    # c "\"I think it will be quite interesting to see one in person. Who can say that they've met two Siblings?\""
    c "\"Puto valde iucundum fore unum coram videre. Quis dicere potest se duos Fratres convenisse?\""

# game/a1s2.rpy:583
translate latin a1s2_0eb2d3fa:

    # "Cassius reaches down and starts stroking Alexios's head fur."
    "Cassius manum demittit et pilos capitis Alexii mulcere incipit."

# game/a1s2.rpy:586
translate latin a1s2_e74f35cf:

    # "The green and gray cat closes his eyes, smiling and purring."
    "Felis viridis cinereusque oculos claudit, subridens fremitumque blandum edens."

# game/a1s2.rpy:587
translate latin a1s2_b6a7bc17:

    # "I watch this for a moment, then freeze up as I feel Amicus's paw on my head."
    "Hoc paulisper observo, deinde rigesco cum manum Amici super caput meum sentio."

# game/a1s2.rpy:589
translate latin a1s2_8ed68839:

    # "He starts to gently scratch his blunt claws into my scalp, ruffling my hair around."
    "Ungues obtusos in cute capitis mei leniter scalpere incipit, capillos meos turbans."

# game/a1s2.rpy:590
translate latin a1s2_402c8ef5:

    # "It actually feels really good, but knowing what he's doing gets me pissed off all over again."
    "Re vera suavissimum est, sed cum intellego quid agat, rursus totus irascor."

# game/a1s2.rpy:591
translate latin a1s2_4bce8420:

    # "He already knows I don't want to be doing this, that he brought me here against my own will."
    "Iam scit me hoc facere nolle et me invito huc adductum esse."

# game/a1s2.rpy:592
translate latin a1s2_51f0daa7:

    # "Now he's stroking me in public like I actually am his pet?"
    "Iam me coram aliis mulcet quasi vere animal eius domesticum sim?"

# game/a1s2.rpy:593
translate latin a1s2_78bb1f0e:

    # "Well...I guess it makes sense, I guess he's doing his part to help me blend in just like I'm doing mine."
    "Bene... credo id rationem habere; puto eum suam partem agere ut lateam, sicut ego meam ago."

# game/a1s2.rpy:594
translate latin a1s2_29c02ec4:

    # "But that doesn't mean I don't hate it, and then his other paw sticks his empty goblet down under my nose."
    "Sed id non significat me non odisse; tum altera manus eius calicem vacuum sub nasum meum ponit."

# game/a1s2.rpy:596
translate latin a1s2_37797830:

    # a "\"More wine, please.\""
    a "\"Plus vini, quaeso.\""

# game/a1s2.rpy:597
translate latin a1s2_ec136ab9:

    # "I let the goblet hang in the air for a moment, then take it and reach out robotically for the heavy wine bottle, getting up on my knees to better pour it into the empty goblet."
    "Calicem paulisper in aere pendere sino, deinde capio et quasi machina ad gravem vini ampullam manum porrigo; in genua me erigo ut facilius in calicem vacuum infundam."

# game/a1s2.rpy:598
translate latin a1s2_e7e1f3c3:

    # "I fill it up as Amicus continues to stroke me."
    "Calicem impleo, dum Amicus me mulcere pergit."

# game/a1s2.rpy:600
translate latin a1s2_7552b017:

    # a "\"I'll bet even fewer can say they've met an abandoned species, wouldn't you think?\""
    a "\"Spondeo etiam pauciores dicere posse se speciem desertam convenisse, nonne putas?\""

# game/a1s2.rpy:602
translate latin a1s2_8e4432cd:

    # "Cassius glares at Amicus, and I glare at the wine."
    "Cassius Amicum torve aspicit; ego vinum."

# game/a1s2.rpy:603
translate latin a1s2_9fc0aa6b:

    # "I try to remind myself that this is just to help get me home..."
    "Conor me admonere hoc tantum fieri ut domum redeam..."

# game/a1s2.rpy:604
translate latin a1s2_7ed2e7b5:

    # "...Or maybe he actually is just showing me off because he likes how he's getting under Cassius's fur."
    "...Aut fortasse tantum me ostentat, quia gaudet se Cassium irritare."

# game/a1s2.rpy:605
translate latin a1s2_7f33f140:

    # "I turn on my knees to face the wolf and hand back his goblet, noticing how full it is, the wine almost sloshing over the rim."
    "Genibus nixus ad lupum me verto et calicem reddo, animadvertens quam plenus sit, vino paene super labrum fluctuante."

# game/a1s2.rpy:606
translate latin a1s2_fdbd8de0:

    # "Amicus reaches out for the goblet."
    "Amicus manum ad calicem porrigit."

# game/a1s2.rpy:607
translate latin a1s2_b6f05c99:

    # "My fingers twitch, then I feel the goblet slip out of my hand, watching as it seems to fall in slow motion onto its side on the bed."
    "Digiti mei moventur; tum calicem e manu mea labi sentio atque observo eum quasi lento motu in latus super lectum cadere."

# game/a1s2.rpy:608
translate latin a1s2_25220006:

    # "The wine shoots out in a red gush, splashing across Amicus's lighter furred front."
    "Vinum rubro impetu effunditur et partem anteriorem Amici pallidioribus pilis tectam conspergit."

# game/a1s2.rpy:616
translate latin a1s2_185c6dad:

    # "The wolf gasps, sitting up suddenly as the wine pours down his chest and stomach and onto his pants."
    "Lupus spiritum abrupte ducit et subito se erigit, dum vinum per pectus ventremque in bracas eius fluit."

# game/a1s2.rpy:618
translate latin a1s2_651eb7c3:

    # a "\"Damn!\""
    a "\"Male sit!\""

# game/a1s2.rpy:622
translate latin a1s2_dcc34f01:

    # "Meanwhile, Cassius bursts out laughing behind me, snorting obnoxiously."
    "Cassius interea post me in risum erumpit, importune fremens."

# game/a1s2.rpy:624
translate latin a1s2_92c452f9:

    # c "\"Hahahahaha! Maybe there's a reason so few have ventured out to meet them, Amicus.\""
    c "\"Hahahahaha! Fortasse causa est cur tam pauci eos convenire ausi sint, Amice.\""

# game/a1s2.rpy:625
translate latin a1s2_e2985ed9:

    # "I see Alex staring at me, but when I meet eyes with him he looks down."
    "Alexium me intuentem video, sed cum oculos eius meis obviam facio, deorsum aspicit."

# game/a1s2.rpy:627
translate latin a1s2_1723562b:

    # "Amicus reaches over me for one of the towels, glancing down at me as he does."
    "Amicus supra me ad unum linteorum manum porrigit, dum me deorsum breviter aspicit."

# game/a1s2.rpy:628
translate latin a1s2_cfbd0e5a:

    # "I try to keep myself from smirking, but I think I fail."
    "Conor risum occultare, sed credo me frustra conari."

# game/a1s2.rpy:630
translate latin a1s2_8db5a7a3:

    # "He pauses, staring at me in astonishment as I guess he realizes that I did it on purpose."
    "Consistit et stupens me aspicit; credo eum intellegere me consulto fecisse."

# game/a1s2.rpy:631
translate latin a1s2_71d66afa:

    # "He doesn't look angry though, and instead grabs up the towel and starts patting down his front, the fur still stained a dark, maroon color."
    "Iratus tamen non videtur; potius linteum capit et partem anteriorem corporis leniter tergere incipit, pilis adhuc obscuro purpureo colore maculatis."

# game/a1s2.rpy:633
translate latin a1s2_fc5b6b3c_1:

    # c "\"What are you doing, Amicus?\""
    c "\"Quid agis, Amice?\""

# game/a1s2.rpy:634
translate latin a1s2_2b9c0f94:

    # "Cassius has finished his laughing and I look over to see him staring at us."
    "Cassius risum finivit; eo aspicio et nos intuentem video."

# game/a1s2.rpy:636
translate latin a1s2_2be62cd3:

    # a "\"What do you mean 'what am I doing' I'm cleaning up the mess.\""
    a "\"Quid sibi vult istud 'quid ago'? Sordes purgo.\""

# game/a1s2.rpy:637
translate latin a1s2_c4da8284:

    # "Amicus growls at Cassius, continuing to pat himself down."
    "Amicus in Cassium ringitur, se leniter tergere pergens."

# game/a1s2.rpy:639
translate latin a1s2_a96d1882:

    # c "\"Dear gods, you really don't know how to do this. Punish it.\""
    c "\"O di, hoc re vera facere nescis. Puni id.\""

# game/a1s2.rpy:640
translate latin a1s2_0a935f20:

    # "Cassius lazily flops his paw in the air in a slapping motion."
    "Cassius manum ignave in aere iactat, quasi alapam det."

# game/a1s2.rpy:641
translate latin a1s2_1722ffbc:

    # "I snap my gaze to Amicus, glaring again."
    "Statim Amicum aspicio et rursus eum torve intueor."

# game/a1s2.rpy:643
translate latin a1s2_f42a3566:

    # a "\"Wh—N—No, I can't do that.\""
    a "\"Qu—n—non, id facere non possum.\""

# game/a1s2.rpy:644
translate latin a1s2_130539d6:

    # c "\"Why not?\""
    c "\"Cur non?\""

# game/a1s2.rpy:645
translate latin a1s2_9d572312:

    # a "\"It's...in the contract; no physical punishments, just like Alexios's.\""
    a "\"Id... in pactione est: nullae poenae corporales, sicut in pactione Alexii.\""

# game/a1s2.rpy:647
translate latin a1s2_ad11fa37:

    # c "\"What!?\""
    c "\"Quid!?\""

# game/a1s2.rpy:648
translate latin a1s2_c8ca2ef2:

    # a "\"You heard me.\""
    a "\"Me audivisti.\""

# game/a1s2.rpy:650
translate latin a1s2_5d77d65e:

    # c "\"Alexios is a Sibling! It's barely even a Child.\""
    c "\"Alexios Frater est! Hoc vix Liber est.\""

# game/a1s2.rpy:652
translate latin a1s2_09e2cc6a:

    # a "\"HE is mine and none of your business.\""
    a "\"ILLE meus est neque tua res est.\""

# game/a1s2.rpy:654
translate latin a1s2_14f30288:

    # c "\"Punishment is the only way to teach the lesser species, Amicus.\""
    c "\"Poena sola via est species inferiores docendi, Amice.\""

# game/a1s2.rpy:655
translate latin a1s2_6cc60c45:

    # "He looks at me."
    "Me intuetur."

# game/a1s2.rpy:656
translate latin a1s2_f5706e47:

    # c "\"You, creature, up. I'll hit you instead.\""
    c "\"Tu, creatura, surge. Ego te pro eo percutiam.\""

# game/a1s2.rpy:660
translate latin a1s2_b9e58b62:

    # a "\"CASSIUS!\""
    a "\"CASSI!\""

# game/a1s2.rpy:661
translate latin a1s2_d0fac158:

    # "I jump, so does Cassius, ears ringing as Amicus's deep voice bellows over me."
    "Subsilio, item Cassius; aures meae tinniunt, dum profunda vox Amici supra me tonat."

# game/a1s2.rpy:663
translate latin a1s2_c495ab36:

    # "Meanwhile, Cato just lounges on his bed, listening...or maybe not."
    "Cato interea tantum in lecto recumbit, auscultans... aut fortasse non."

# game/a1s2.rpy:664
translate latin a1s2_bdad78a6:

    # a "\"I'll make this very clear right now. You are NEVER to lay a paw on him, or give him orders of any kind.\""
    a "\"Hoc nunc clarissime dicam. NUMQUAM ei manum inferes neque quidquam iubebis.\""

# game/a1s2.rpy:666
translate latin a1s2_811fa4fd:

    # "Cassius, having recovered, raises an eyebrow at Amicus."
    "Cassius, iam se recipiens, alterum supercilium ad Amicum tollit."

# game/a1s2.rpy:667
translate latin a1s2_fe6ec585:

    # c "\"And if I do, brother?\""
    c "\"Et si fecero, frater?\""

# game/a1s2.rpy:668
translate latin a1s2_dcb26ff4:

    # "Amicus's fur starts to lay flat on his shoulders again as he shrugs."
    "Pili Amici in umeris rursus subsidere incipiunt, dum umeros tollit."

# game/a1s2.rpy:670
translate latin a1s2_0df24276:

    # a "\"I'll punch you.\""
    a "\"Pugno te percutiam.\""

# game/a1s2.rpy:672
translate latin a1s2_c910f606:

    # c "\"Wh—you....You can't do that, we're not pups anymore!\""
    c "\"Qu—tu... Non potes id facere; iam non catuli sumus!\""

# game/a1s2.rpy:674
translate latin a1s2_74af6d72:

    # a "\"And if you call him \"it\" again, I'll do the same.\""
    a "\"Et si eum \"hoc\" rursus appellaveris, idem faciam.\""

# game/a1s2.rpy:675
translate latin a1s2_2253c315:

    # "Cassius seems to choke for a moment."
    "Cassius paulisper quasi suffocatur."

# game/a1s2.rpy:676
translate latin a1s2_587dd5ad:

    # c "\"What in the world has gotten into you, Amicus!?\""
    c "\"Quid malum tibi accidit, Amice!?\""

# game/a1s2.rpy:677
translate latin a1s2_fdd9b06d:

    # "He looks at the older wolf."
    "Lupum seniorem aspicit."

# game/a1s2.rpy:678
translate latin a1s2_9d988211:

    # c "\"Cato!\""
    c "\"Cato!\""

# game/a1s2.rpy:680
translate latin a1s2_1946d33b:

    # ca "\"Yes, Cassius?\""
    ca "\"Ita, Cassi?\""

# game/a1s2.rpy:682
translate latin a1s2_5876107d:

    # c "\"Well, DO something! He can't threaten me like that!\""
    c "\"Age, aliquid FAC! Non potest ita mihi minari!\""

# game/a1s2.rpy:684
translate latin a1s2_880706f5:

    # ca "\"Amicus, be nice to your brother.\""
    ca "\"Amice, benigne cum fratre tuo age.\""

# game/a1s2.rpy:686
translate latin a1s2_33ac6adb:

    # "Cassius's ears turn bright red and he slumps on the bed, glaring at his remaining food."
    "Aures Cassii valde rubescunt; in lectum recidit et reliquum cibum suum torve aspicit."

# game/a1s2.rpy:688
translate latin a1s2_788ae458:

    # ca "\"Anyway, if you two are finished then be off to your studies. Don't be late this time, Amicus. Your tutor complained again last week.\""
    ca "\"Utut est, si ambo perfecistis, ad studia abite. Noli hac vice sero venire, Amice. Praeceptor tuus superiore hebdomade iterum questus est.\""

# game/a1s2.rpy:690
translate latin a1s2_58dceb7a:

    # a "\"That's today?\""
    a "\"Id hodie est?\""

# game/a1s2.rpy:691
translate latin a1s2_7c3ec472:

    # ca "\"You know, you should take care to start paying more attention. After seeing what you accomplished, I'm starting to lean toward trials in making my decision.\""
    ca "\"Scis, curare debes ut maiorem attentionem adhibere incipias. Postquam vidi quid perfeceris, magis ad certamina inclino quibus consilium meum capiam.\""

# game/a1s2.rpy:695
translate latin a1s2_1f70008d:

    # "The room suddenly goes very quiet."
    "Conclave subito quietissimum fit."

# game/a1s2.rpy:696
translate latin a1s2_136150b2:

    # ca "\"And Cassius, I need to speak with you for a moment before you leave.\""
    ca "\"Et, Cassi, paulisper tecum loqui debeo antequam abis.\""

# game/a1s2.rpy:700
translate latin a1s2_9f90d194:

    # "Amicus gets to his feet and I do the same."
    "Amicus surgit, et ego idem facio."

# game/a1s2.rpy:702
translate latin a1s2_7eea2940:

    # "The wolf glances at Cassius and Cato, but they're deep in conversation."
    "Lupus Cassium et Catonem breviter aspicit, sed illi penitus in sermone occupantur."

# game/a1s2.rpy:703
translate latin a1s2_880bc6a6:

    # "He turns back to me."
    "Rursus ad me vertitur."

# game/a1s2.rpy:704
translate latin a1s2_2d18bba1:

    # a "\"I forgot that It's my study day, so I'll be gone for a little while. I'm going to ask Alexios to show you around and give you something to do while I'm away.\""
    a "\"Oblitus sum hunc diem studiis meis destinatum esse, itaque aliquamdiu abero. Alexium rogabo ut te circumducat et aliquid tibi det faciendum dum absum.\""

# game/a1s2.rpy:705
translate latin a1s2_4c82c4ed:

    # "I feel myself grow tense at the idea of being without the only person I know around here."
    "Me intendi sentio, cum cogito me sine sola persona mansurum quam hic novi."

# game/a1s2.rpy:706
translate latin a1s2_1cdd7b14:

    # m "\"Seriously?\""
    m "\"Serio?\""

# game/a1s2.rpy:707
translate latin a1s2_c3091da2:

    # a "\"Listen, you don't have to do anything, I'll make that clear to everyone, but I feel you might rather have {i}something{/i} to do rather than sit in my room all day.\""
    a "\"Audi: nihil facere teneris; id omnibus clare dicam. Sed puto te malle {i}aliquid{/i} facere quam totum diem in cubiculo meo sedere.\""

# game/a1s2.rpy:708
translate latin a1s2_8e15c38d:

    # "He seems to think it's the chores that I'm upset about rather than him leaving me alone."
    "Putare videtur me propter opera indignari, non quod solum me relinquat."

# game/a1s2.rpy:709
translate latin a1s2_6f19d038_1:

    # m "\"Alright.\""
    m "\"Bene.\""

# game/a1s2.rpy:711
translate latin a1s2_04fd5def:

    # "Amicus frowns at me and I can't help but feel a little bad."
    "Amicus frontem ad me corrugat, et facere non possum quin aliquantum male me sentiam."

# game/a1s2.rpy:712
translate latin a1s2_e2fd859e:

    # "He does seem to be trying to make things as easy as possible for me."
    "Sane omnia mihi quam facillima reddere conari videtur."

# game/a1s2.rpy:713
translate latin a1s2_ac0b2d65:

    # m "\"And...sorry.\""
    m "\"Et... ignosce.\""

# game/a1s2.rpy:714
translate latin a1s2_3b53705e:

    # "I gesture at his still-stained front."
    "Partem anteriorem eius adhuc maculatam manu indico."

# game/a1s2.rpy:716
translate latin a1s2_73f89c76:

    # a "\"Don't worry. Yes, wine isn't easy to get out of the fur, but I know why you did it, and I deserved it.\""
    a "\"Noli sollicitus esse. Ita, vinum e pilis tollere difficile est; sed scio cur id feceris, et merui.\""

# game/a1s2.rpy:717
translate latin a1s2_f94763a9:

    # c "\"Ugh, Is it—he speaking it's—his language again?\""
    c "\"Ugh, num hoc—ille rursus lingua istius—sua loquitur?\""

# game/a1s2.rpy:718
translate latin a1s2_2d17b800:

    # a "\"Shut up, Cassius.\""
    a "\"Tace, Cassi.\""

# game/a1s2.rpy:719
translate latin a1s2_ad11fa37_1:

    # c "\"What!?\""
    c "\"Quid!?\""

# game/a1s2.rpy:720
translate latin a1s2_f639ccad:

    # a "\"Alexios.\""
    a "\"Alexie.\""

# game/a1s2.rpy:721
translate latin a1s2_50a29f9b:

    # "Amicus gestures at the small cat who is currently stacking the dirty dishes on top of each other."
    "Amicus parvum felem indicat, qui nunc patellas sordidas alteram super alteram ponit."

# game/a1s2.rpy:723
translate latin a1s2_4e61b8ea:

    # a "\"Could you please show [mc] around the palace along with the tasks and activities you do? He's unfamiliar with nearly everything.\""
    a "\"Potesne, quaeso, [mc] per palatium circumducere atque opera occupationesque tuas ostendere? Paene omnia ei ignota sunt.\""

# game/a1s2.rpy:725
translate latin a1s2_1c8e23ee:

    # al "\"I would be happy to, Amicus!\""
    al "\"Libenter faciam, Amice!\""

# game/a1s2.rpy:728
translate latin a1s2_1ccf5ebd:

    # c "\"So you can order {i}my{/i} pet around?\""
    c "\"Ergo animali {i}meo{/i} imperare potes?\""

# game/a1s2.rpy:729
translate latin a1s2_ac02d2eb:

    # "Cato, standing over by the doorway and clearly eager to leave, sighs."
    "Cato, prope limen stans et plane abire cupiens, suspirat."

# game/a1s2.rpy:730
translate latin a1s2_820f2861:

    # ca "\"Enough. Try to be reasonable Cassius. Now both of you be off to your studies...and a quick shower for you, Amicus.\""
    ca "\"Satis. Conare rationi parere, Cassi. Nunc ambo ad studia abite... et tu celeriter lavare, Amice.\""

# game/a1s2.rpy:735
translate latin a1s2_507a2eb9:

    # "Amicus grumbles and starts to turn away, then turns back to me, resting a paw on my shoulder."
    "Amicus murmurat et se avertere incipit; deinde ad me revertitur et manum super umerum meum ponit."

# game/a1s2.rpy:737
translate latin a1s2_a1b4dff1:

    # a "\"I'll be back toward the evening...\""
    a "\"Sub vesperum redibo...\""

# game/a1s2.rpy:738
translate latin a1s2_526c5691:

    # "The big wolf pauses, as if wanting to say more, but leaves me with a simple—"
    "Lupus magnus consistit, quasi plura dicere velit, sed tantum haec mihi relinquit—"

# game/a1s2.rpy:740
translate latin a1s2_915f7f2b:

    # a "\"I'll see you then.\""
    a "\"Tum te videbo.\""

# game/a1s2.rpy:742
translate latin a1s2_d3e64003:

    # "And with that, he gives me a little wave and another wink before following Cassius and Cato through the archway."
    "His dictis manu leviter me salutat et iterum connivet, antequam Cassium et Catonem per arcum sequitur."

# game/a1s2.rpy:743
translate latin a1s2_f32e56ef:

    # "Just as Amicus leaves, Cassius pauses to give me a sour look...then again, most of his expressions are pretty sour, but it still makes me uncomfortable."
    "Cum Amicus abit, Cassius paulisper consistit ut me acerbe aspiciat... quamquam pleraeque eius expressionum acerbae sunt, id tamen me perturbat."

# game/a1s2.rpy:744
translate latin a1s2_f26394de:

    # "Then I'm left alone with the cat."
    "Tum solus cum fele relinquor."

# game/a1s2.rpy:745
translate latin a1s2_46a0e515:

    # "I feel an odd sense of loneliness at seeing Amicus just leave like that."
    "Miram solitudinem sentio, cum Amicum ita abire video."

# game/a1s2.rpy:746
translate latin a1s2_b68fd52f:

    # "It's like my mother just dropped me off at preschool, or something."
    "Quasi mater mea modo me in schola infantium reliquerit, aut tale quid."

# game/a1s2.rpy:747
translate latin a1s2_76c7bd05:

    # "He's the only one that's been treating me like an actual person...mostly, at least."
    "Solus est qui me velut personam veram tractavit... saltem plerumque."

# game/a1s2.rpy:748
translate latin a1s2_19c1e994:

    # "I hear the small sound of someone clearing their throat behind me."
    "Post me levem sonum alicuius tussicula fauces purgantis audio."

# game/a1s2.rpy:751
translate latin a1s2_c9ec3eba:

    # al "\"Hello.\""
    al "\"Salve.\""

# game/a1s2.rpy:752
translate latin a1s2_0339fe98:

    # "The small cat smiles at me pleasantly, his paws clasped neatly in front of himself."
    "Parvus felis mihi comiter arridet, manibus concinne ante se iunctis."

# game/a1s2.rpy:753
translate latin a1s2_5f10ad5e:

    # "I say he's small, but he's really about the same height as me."
    "Parvum eum dico, sed re vera fere eadem altitudine ac ego est."

# game/a1s2.rpy:754
translate latin a1s2_f4c46d9d:

    # "It's just odd seeing another alien that's my size when I always have to look up at the wolves."
    "Tantum mirum est alium alienigenam meae magnitudinis videre, cum lupos semper sursum aspicere debeam."

# game/a1s2.rpy:755
translate latin a1s2_8deedb54:

    # m "\"Uh, hi.\""
    m "\"Eh, salve.\""

# game/a1s2.rpy:756
translate latin a1s2_3e54bc9b:

    # "I see Alexios's left eye twitch and he raises a paw to his head."
    "Sinistrum oculum Alexii moveri video, et ille manum ad caput tollit."

# game/a1s2.rpy:758
translate latin a1s2_97aa9e44:

    # al "\"Oh dear. This is going to be an interesting day.\""
    al "\"O di. Hic dies sane mirus erit.\""

# game/a1s2.rpy:759
translate latin a1s2_90a98242:

    # m "\"...Is something wrong?\""
    m "\"...Num quid mali est?\""

# game/a1s2.rpy:760
translate latin a1s2_704564fb:

    # "More twitching."
    "Iterum oculus movetur."

# game/a1s2.rpy:762
translate latin a1s2_72abc14e:

    # al "\"Just my Lingua. It will take a while to learn your language, but it gets better the more you speak...so if you don't mind, I'd like to know more about you. I'm very curious.\""
    al "\"Tantum Lingua mea est. Aliquantum temporis requiret ut linguam tuam discat, sed quo plura dicis eo melius vertit... itaque, si tibi non molestum est, plura de te scire velim. Valde curiosus sum.\""

# game/a1s2.rpy:763
translate latin a1s2_104f1665:

    # m "\"Uhhh...\""
    m "\"Ehhh...\""

# game/a1s2.rpy:764
translate latin a1s2_92942840:

    # "Amicus told me to act dumb, so I try to figure out how I might do that."
    "Amicus me stulte agere iussit, itaque quomodo id faciam excogitare conor."

# game/a1s2.rpy:765
translate latin a1s2_d0e4b396:

    # "I fix a distant look on my face."
    "Vultui meo expressionem absentem impono."

# game/a1s2.rpy:766
translate latin a1s2_16b38454:

    # m "\"Far away...\""
    m "\"Longe...\""

# game/a1s2.rpy:768
translate latin a1s2_b72e84bb:

    # "Alexios blinks, then giggles."
    "Alexios nictat, deinde cachinnat."

# game/a1s2.rpy:770
translate latin a1s2_c8883100:

    # al "\"Oh.\""
    al "\"O.\""

# game/a1s2.rpy:771
translate latin a1s2_c1c9b46f:

    # "We both stand there awkwardly for a moment before he gestures at the table."
    "Ambo paulisper incommodi ibi stamus, antequam ille mensam indicat."

# game/a1s2.rpy:773
translate latin a1s2_481413f1:

    # al "\"Well, why don't we have a seat? We eat their leftovers when they've finished.\""
    al "\"Bene, cur non considimus? Reliquias eorum edimus cum perfecerunt.\""

# game/a1s2.rpy:775
translate latin a1s2_4a3f2436:

    # "The cat moves over to sit on Cato's bed, reaching out for his own small plate."
    "Felis ad lectum Catonis accedit et considit, manum ad suam patellam porrigens."

# game/a1s2.rpy:776
translate latin a1s2_ce1596f2:

    # "I'm reminded of how hungry I am, so I quickly do the same, choosing to sit on Cassius's bed since Amicus's is covered in wine."
    "Admonitus quam esuriam, celeriter idem facio, lectum Cassii eligens quia Amici vino coopertus est."

# game/a1s2.rpy:778
translate latin a1s2_5551d7bd:

    # al "\"Will this food agree with your stomach?\""
    al "\"Hic cibus ventri tuo conveniet?\""

# game/a1s2.rpy:779
translate latin a1s2_d85bfd68:

    # m "\"I think so. It actually looks kind of like some of the stuff I eat back home. I mean, it's basically olives, bread, and meat.\""
    m "\"Credo. Re vera aliquantum similis est cibis quos domi edo. Scilicet fere olivae, panis caroque sunt.\""

# game/a1s2.rpy:780
translate latin a1s2_2884fd33:

    # "I point to each of the dishes."
    "Singulas cibi patellas indico."

# game/a1s2.rpy:781
translate latin a1s2_ae11f0c4:

    # "Alexios puts his paw back up to his head."
    "Alexios manum rursus ad caput tollit."

# game/a1s2.rpy:783
translate latin a1s2_da7e4a3f:

    # al "\"Oh my, so many words, and in full sentences too!\""
    al "\"O di, tot verba, immo plenis sententiis!\""

# game/a1s2.rpy:784
translate latin a1s2_0f77cfd7:

    # "I freeze."
    "Rigesco."

# game/a1s2.rpy:785
translate latin a1s2_79f79fb1:

    # m "\"Oh uh...I mean, I don't really know what this food is, I'm just guessing...\""
    m "\"O, eh... scilicet, non re vera scio quid hic cibus sit; tantum conicio...\""

# game/a1s2.rpy:787
translate latin a1s2_c41f9e3e:

    # al "\"No, I mean, it's your words. So many of them and in complete, complex sentences.\""
    al "\"Non, de verbis tuis loquor. Tam multa, et sententiis plenis atque implicatis.\""

# game/a1s2.rpy:788
translate latin a1s2_203b7786:

    # "Fuck, I'm bad at this."
    "Mehercule, quam male hoc facio."

# game/a1s2.rpy:789
translate latin a1s2_d1b39c8b:

    # al "\"I guess the Wolves uplifted intelligence a lot more back then.\""
    al "\"Credo Lupos tunc intelligentiam multo altius provexisse.\""

# game/a1s2.rpy:790
translate latin a1s2_3d8789fb:

    # m "\"Oh, maybe...\""
    m "\"O, fortasse...\""

# game/a1s2.rpy:791
translate latin a1s2_7d06fa6a:

    # "I wonder if I've ruined our plan already, but Alexios doesn't seem alarmed, just curious, so I turn my attention back to the food."
    "Quaero an iam consilium nostrum corruperim, sed Alexios non territus, tantum curiosus videtur; itaque rursus cibum curare incipio."

# game/a1s2.rpy:792
translate latin a1s2_0b932806:

    # "There isn't much left on the table."
    "Parum cibi in mensa reliquum est."

# game/a1s2.rpy:793
translate latin a1s2_53909f3e:

    # "The meat was mostly cleaned off the bones by Cato."
    "Cato maximam carnis partem ex ossibus abstulit."

# game/a1s2.rpy:794
translate latin a1s2_d72c159d:

    # "Next to it are four slices of bread and the bowl of olives."
    "Iuxta eam quattuor panis crustae sunt et patera olivarum."

# game/a1s2.rpy:795
translate latin a1s2_53b2dc39:

    # "Alexios starts on the poultry, working at it with his claws until it comes apart in two pieces with a loud tearing sound."
    "Alexios avem tractare incipit, unguibus incumbens donec magno sonitu avulsionis in duas partes dividitur."

# game/a1s2.rpy:796
translate latin a1s2_05247ad7:

    # "He hands me one half."
    "Dimidiam partem mihi tradit."

# game/a1s2.rpy:798
translate latin a1s2_98eb2578:

    # al "\"You should be able to find a little meat on there.\""
    al "\"Paulum carnis ibi invenire poteris.\""

# game/a1s2.rpy:799
translate latin a1s2_5e17bc44:

    # "I take it from him, trying not to show my disappointment."
    "Ab eo accipio, conans ne ostendam me spe deceptum esse."

# game/a1s2.rpy:800
translate latin a1s2_778b044e:

    # "Then he puts two slices of bread on a plate and slides it toward me before taking the remaining two."
    "Tum duas panis crustas in patella ponit eamque ad me impellit, antequam reliquas duas sibi sumit."

# game/a1s2.rpy:801
translate latin a1s2_ab8726ea:

    # al "\"Make sure to use the cheese. The bread is a bit bland without it.\""
    al "\"Caseum certe adhibe. Panis sine eo aliquantum insipidus est.\""

# game/a1s2.rpy:802
translate latin a1s2_ac8d7695:

    # "I pull a few thin strips of meat off of the bone and taste it."
    "Aliquot tenues carnis fascias ex osse avello et gusto."

# game/a1s2.rpy:803
translate latin a1s2_cb06ebc0:

    # "It's good, really, really good and I quickly search the bones for more, but there isn't much at all."
    "Bona est, valde, valde bona; celeriter ossa perscrutor plus carnis quaerens, sed paene nihil est."

# game/a1s2.rpy:805
translate latin a1s2_2997fbe5:

    # al "\"Hungry?\""
    al "\"Esuris?\""

# game/a1s2.rpy:806
translate latin a1s2_4436ab69:

    # "I look up and see Alexios delicately picking at his own half of bird."
    "Sursum aspicio et Alexium video suam avis dimidiam partem delicate carpentem."

# game/a1s2.rpy:807
translate latin a1s2_e5fa1b7e:

    # m "\"Yeah...haven't eaten in a few days.\""
    m "\"Ita... paucos dies non edi.\""

# game/a1s2.rpy:809
translate latin a1s2_07483129:

    # al "\"Oh really? Why not?\""
    al "\"O, re vera? Cur non?\""

# game/a1s2.rpy:810
translate latin a1s2_3a5c37a7:

    # m "\"The...trip here was a bit rough. I guess I did eat on the ship, but it wasn't very filling.\""
    m "\"Iter... huc aliquantum difficile fuit. Credo me in nave edisse, sed parum satiavit.\""

# game/a1s2.rpy:812
translate latin a1s2_6267f1d8:

    # al "\"Oh, like the protein sludge they have? Yeah, that stuff is quite terrible. I can understand why you're hungry. Well, you won't have to worry.\""
    al "\"O, sicut lutum illud proteinicum quod habent? Ita, id sane pessimum est. Intellego cur esurias. Sed nihil tibi curandum erit.\""

# game/a1s2.rpy:813
translate latin a1s2_2558be92:

    # m "\"Why not?\""
    m "\"Cur non?\""

# game/a1s2.rpy:815
translate latin a1s2_9a378adc:

    # al "\"We eat dinner with our masters in their rooms. Amicus always serves himself very large portions and also sneaks me my own food since Cassius doesn't take much himself.\""
    al "\"Cum dominis nostris in cubiculis eorum cenamus. Amicus semper sibi maximas portiones sumit et mihi quoque cibum meum furtim dat, quia Cassius sibi parum sumit.\""

# game/a1s2.rpy:816
translate latin a1s2_09cb548d:

    # "Alexios slowly spreads cheese onto his bread."
    "Alexios lente caseum super panem linit."

# game/a1s2.rpy:817
translate latin a1s2_802c9c42:

    # al "\"He will take good care of you in that respect.\""
    al "\"In ea re te bene curabit.\""

# game/a1s2.rpy:818
translate latin a1s2_8143642b:

    # "With the mention of Amicus, I start to feel a bit lonely again."
    "Amico nominato, rursus aliquantum solus me sentire incipio."

# game/a1s2.rpy:819
translate latin a1s2_b970660c:

    # "Actually, something I've noticed is that the whole palace seems to be lonely."
    "Re vera animadverti totum palatium solitarium videri."

# game/a1s2.rpy:820
translate latin a1s2_e3111ddd:

    # m "\"So...where is everyone?\""
    m "\"Ergo... ubi sunt omnes?\""

# game/a1s2.rpy:821
translate latin a1s2_80f7bba3:

    # "Alexios chews thoughtfully on his bread."
    "Alexios cogitabundus panem mandat."

# game/a1s2.rpy:823
translate latin a1s2_2f2437b8:

    # al "\"Hm?\""
    al "\"Hm?\""

# game/a1s2.rpy:824
translate latin a1s2_866e82c1:

    # "I try to think of a way to phrase things stupidly, then give up as I decide he already knows I'm able to form \"complex\" sentences."
    "Excogitare conor quomodo rem stulte exprimam, tum desisto, statuens eum iam scire me sententias \"implicatas\" formare posse."

# game/a1s2.rpy:825
translate latin a1s2_b8bc8318:

    # m "\"This palace doesn't seem to have very many people around.\""
    m "\"Hoc palatium non multos habitantes habere videtur.\""

# game/a1s2.rpy:826
translate latin a1s2_09186dac:

    # al "\"Oh! Well, do you expect others to be here?\""
    al "\"O! Bene, alios hic esse exspectas?\""

# game/a1s2.rpy:827
translate latin a1s2_9f2b7e98:

    # m "\"Well, I guess like servants, or guards, or some other officials?\""
    m "\"Bene, credo servos, aut custodes, aut alios quosdam magistratus?\""

# game/a1s2.rpy:829
translate latin a1s2_d3bf062d:

    # al "\"Most needs in the palace are covered by artificial intelligence and drones. Same goes for the palace defense.\""
    al "\"Plerisque necessitatibus palatii intelligentia artificialis et automata satisfaciunt. Idem ad defensionem palatii valet.\""

# game/a1s2.rpy:830
translate latin a1s2_973b3835:

    # al "\"I suppose it may be different where you're from, but the Siblings learned long ago that the fewer sapients you have in a location that needs to be secure, the better. You and I are an exception.\""
    al "\"Credo aliter fieri posse unde venisti, sed Fratres iam pridem didicerunt: quo pauciores Sapientes in loco tuto servando habes, eo melius. Tu et ego exceptio sumus.\""

# game/a1s2.rpy:831
translate latin a1s2_36ae8111:

    # "The bread tastes like literal chalk, so I decide to spread a little bit of the cheese on it despite the smell."
    "Panis vere quasi creta sapit; itaque, quamquam odor molestus est, paulum casei super eum linere statuo."

# game/a1s2.rpy:832
translate latin a1s2_4b0bfc54:

    # "To my surprise, it's salty and creamy and not bad at all."
    "Miror eum salsum, cremosum, minime malum esse."

# game/a1s2.rpy:833
translate latin a1s2_e7772f62:

    # "The smell {i}is{/i} hard to ignore, though."
    "Odorem tamen neglegere difficile {i}est{/i}."

# game/a1s2.rpy:834
translate latin a1s2_25baa188:

    # m "\"So...what is the point of having a pet, then?\""
    m "\"Ergo... quid tandem prodest animal domesticum habere?\""

# game/a1s2.rpy:836
translate latin a1s2_fbb81565:

    # al "\"Amicus didn't tell you?\""
    al "\"Amicus tibi non dixit?\""

# game/a1s2.rpy:837
translate latin a1s2_a3a0009b:

    # m "\"Well, he did. He just mentioned status and stuff. Is there any other reason? Why do we have to do stuff for them if they have robots that can do it instead?\""
    m "\"Immo dixit. Tantum dignitatem et talia memoravit. Alia causa est? Cur pro eis opera facere debemus, si automata habent quae pro nobis facere possunt?\""

# game/a1s2.rpy:839
translate latin a1s2_05a7be1f:

    # al "\"Status is the main reason, yes. Our duty is to be by their side during public appearances, or in official meetings. Obviously having an artificial sapient doing the same isn't impressive at all.\""
    al "\"Dignitas causa maxima est, ita. Officium nostrum est iuxta eos esse cum in publicum prodeunt vel in conventibus officialibus. Sane Sapientem artificialem idem facientem habere minime admirationem movet.\""

# game/a1s2.rpy:840
translate latin a1s2_3cf5b252:

    # al "\"We don't really have to do anything manual in the palace, but Cassius likes the idea of a Sapient being his servant. He says it reminds him of the old days.\""
    al "\"Nullum opus manibus in palatio facere re vera debemus, sed Cassio placet Sapientem servum suum esse. Dicit id veterum temporum eum admonere.\""

# game/a1s2.rpy:841
translate latin a1s2_a220874f:

    # m "\"I see. Amicus told me that I don't really have to do anything for him...except brush his fur.\""
    m "\"Intellego. Amicus mihi dixit me nihil re vera pro eo facere debere... nisi pilos eius pectere.\""

# game/a1s2.rpy:843
translate latin a1s2_c44cf66d:

    # al "\"Ah yes, Amicus is very meticulous about that.\""
    al "\"Ah, ita, Amicus id accuratissime curat.\""

# game/a1s2.rpy:844
translate latin a1s2_a55e30ad:

    # m "\"Do you know him well?\""
    m "\"Eum bene nosti?\""

# game/a1s2.rpy:846
translate latin a1s2_02bc0c64:

    # al "\"Fairly well. I've been here for a few months now, so I've had my fair share of interactions with him even though Cassius doesn't like it.\""
    al "\"Satis bene. Iam aliquot menses hic sum, itaque saepe cum eo versatus sum, quamquam Cassio id displicet.\""

# game/a1s2.rpy:847
translate latin a1s2_43e47f41:

    # m "\"I see...what do you think of him?\""
    m "\"Intellego... quid de eo putas?\""

# game/a1s2.rpy:849
translate latin a1s2_f3f1df32:

    # al "\"I think that you're very lucky to have a master like Amicus.\""
    al "\"Puto te valde fortunatum esse quod talem dominum qualis Amicus est habeas.\""

# game/a1s2.rpy:850
translate latin a1s2_51e734c7:

    # m "\"Why's that?\""
    m "\"Cur?\""

# game/a1s2.rpy:852
translate latin a1s2_dbb30b8b:

    # al "\"Well, Amicus is very...kind. Sometimes he tries to be all official and assertive, and he likes to tease me, but he comes off as more open, whether he intends to or not.\""
    al "\"Bene, Amicus valde... benignus est. Interdum conatur omni modo gravis et imperiosus esse, meque lacessere amat; sed apertior videtur, sive id intendit sive non.\""

# game/a1s2.rpy:854
translate latin a1s2_dfd32244:

    # al "\"This is all compared to Cassius, of course.\""
    al "\"Haec omnia cum Cassio comparantur, sane.\""

# game/a1s2.rpy:855
translate latin a1s2_a3506f66:

    # "I think for a moment."
    "Paulisper cogito."

# game/a1s2.rpy:856
translate latin a1s2_dd1d0d1e:

    # m "\"Do you not like being Cassius's pet?\""
    m "\"Non tibi placet animal domesticum Cassii esse?\""

# game/a1s2.rpy:857
translate latin a1s2_35d1faa0:

    # "There's a pause, though Alexios continues to smile."
    "Mora fit, quamquam Alexios subridere pergit."

# game/a1s2.rpy:858
translate latin a1s2_5aeb8639:

    # al "\"Cassius is very...specific about how he wants to be talked to and such, but this is a great quality for a prospective emperor to have, for sure.\""
    al "\"Cassius valde... certam rationem exigit qua sibi loquamur et talia; sed hoc sane egregium est in eo qui imperator fieri possit.\""

# game/a1s2.rpy:860
translate latin a1s2_ba28ce9f:

    # al "\"But in casual conversation, it's much easier to talk to someone like Amicus.\""
    al "\"In familiari autem sermone multo facilius est cum aliquo qualis Amicus est loqui.\""

# game/a1s2.rpy:861
translate latin a1s2_dcbe3993:

    # "I take a sip of the wine and as far as I can tell, it's similar to the few times I've had it on Earth."
    "Vinum paulum sorbeo; quantum iudicare possum, simile est illi quod paucis vicibus in Terra gustavi."

# game/a1s2.rpy:862
translate latin a1s2_93507c1a:

    # m "\"He has been really nice to me.\""
    m "\"Mecum valde benignus fuit.\""

# game/a1s2.rpy:863
translate latin a1s2_b7473222:

    # "At least after the whole kidnapping thing."
    "Saltem post totam illam rem raptus."

# game/a1s2.rpy:864
translate latin a1s2_36a96f06:

    # al "\"He is a very nice person. He just tends to...not think everything through.\""
    al "\"Persona valde benigna est. Tantum solet... non omnia diligenter cogitare.\""

# game/a1s2.rpy:866
translate latin a1s2_a030ab49:

    # "Alexios's eyes flick to look behind me before he focuses back on my face."
    "Oculi Alexii breviter post me aspiciunt, deinde rursus in vultu meo defiguntur."

# game/a1s2.rpy:868
translate latin a1s2_6b6eab41:

    # al "\"Understand that normally we shouldn't speak so candidly about our masters. This is just a conversation between pets.\""
    al "\"Intellege nos plerumque de dominis nostris tam aperte loqui non debere. Hic tantum sermo inter animalia domestica est.\""

# game/a1s2.rpy:869
translate latin a1s2_b0e8415c:

    # m "\"Oh...Yeah, I understand.\""
    m "\"O... ita, intellego.\""

# game/a1s2.rpy:870
translate latin a1s2_f1f9c6a9:

    # "There's a moment of silence that goes on just long enough to be uncomfortable."
    "Silentium est quod satis diu protrahitur ut molestum fiat."

# game/a1s2.rpy:872
translate latin a1s2_99e1627d:

    # al "\"Yes, I thought you would...I have to say that you're extremely perceptive, almost on the same level as a Sibling.\""
    al "\"Ita, te intellecturum putabam... dicere debeo te acerrimi ingenii esse, paene eodem gradu ac Frater.\""

# game/a1s2.rpy:873
translate latin a1s2_9db314e0:

    # "I wince internally as Alexios points out my intelligence again."
    "Intus animo contrahor, cum Alexios intelligentiam meam rursus indicat."

# game/a1s2.rpy:874
translate latin a1s2_65d1615e:

    # "Only took me 10 minutes to fail my one and only job."
    "Tantum 10 minutis uno atque unico officio meo defeci."

# game/a1s2.rpy:875
translate latin a1s2_3adc3816:

    # "Alexios smiles at me again."
    "Alexios iterum mihi arridet."

# game/a1s2.rpy:877
translate latin a1s2_33ab2369:

    # al "\"Ah, was I not supposed to know that?\""
    al "\"Ah, num id scire non debebam?\""

# game/a1s2.rpy:878
translate latin a1s2_f9541be3:

    # "Apparently he's perceptive as well."
    "Ut videtur, ille quoque acerrimi ingenii est."

# game/a1s2.rpy:879
translate latin a1s2_fe10ab79:

    # m "\"Uh...\""
    m "\"Eh...\""

# game/a1s2.rpy:881
translate latin a1s2_aa29cd82:

    # al "\"Don't worry. Like I said, this is between pets—\""
    al "\"Noli sollicitus esse. Ut dixi, haec inter animalia domestica manent—\""

# game/a1s2.rpy:882
translate latin a1s2_a3fb7e9b:

    # "Alexios leans in conspiratorially."
    "Alexios quasi consilii conscius propius inclinat."

# game/a1s2.rpy:884
translate latin a1s2_b2ea1110:

    # al "\"I don't just blab everything I know to my master. I'm simply his servant, not spy.\""
    al "\"Non omnia quae scio domino meo temere effutio. Tantum servus eius sum, non explorator.\""

# game/a1s2.rpy:886
translate latin a1s2_c927b1f8:

    # "He leans back again."
    "Rursus reclinatur."

# game/a1s2.rpy:887
translate latin a1s2_a9a74465:

    # al "\"Though he might wish I was, but honestly it's really nice to be able to talk to someone other than my superiors. Amicus was the only one to treat me as an equal, but Cassius usually keeps our contact minimal.\""
    al "\"Quamquam fortasse vellet me exploratorem esse; sed re vera valde iucundum est cum aliquo praeter superiores meos loqui posse. Solus Amicus me parem tractavit, sed Cassius plerumque contactum nostrum ad minimum redigit.\""

# game/a1s2.rpy:888
translate latin a1s2_c16e70ea:

    # "I put the last bit of bread into my mouth and as soon as I do, Alexios sits up."
    "Ultimum panis frustum in os infero; statim Alexios se erigit."

# game/a1s2.rpy:889
translate latin a1s2_885a6926:

    # al "\"Com, we're finished.\""
    al "\"Com, perfecimus.\""

# game/a1s2.rpy:890
translate latin a1s2_0c99ccbc:

    # com "\"Yes, Alexios.\""
    com "\"Ita, Alexie.\""

# game/a1s2.rpy:891
translate latin a1s2_d2e4f520:

    # "I watch with fascination as the dishes levitate off the table and float away through the archway they originally came through."
    "Fascinatus observo patellas e mensa levitari et per eundem arcum abire quo primum intraverunt."

# game/a1s2.rpy:892
translate latin a1s2_6f9eba33:

    # al "\"Do you want to go outside? Like I said, there's not much to do, but the gardens do require a more sapient touch to keep them presentable.\""
    al "\"Visne foras ire? Ut dixi, non multum est faciendum, sed horti tactu magis sapiente egent ut decori maneant.\""

# game/a1s2.rpy:893
translate latin a1s2_c2e0d6c0:

    # m "\"Yeah, sure.\""
    m "\"Ita, certe.\""

# game/a1s2.rpy:894
translate latin a1s2_e9291f4c:

    # "I brush crumbs off of my jeans and stand up."
    "Micas e bracis meis denim factis detergo et surgo."

# game/a1s2.rpy:895
translate latin a1s2_d1b0c1c8:

    # "I'm still hungry, but the amount that I've eaten has taken the edge off of it, at least."
    "Adhuc esurio, sed id quod edi famis aciem saltem mitigavit."

# game/a1s2.rpy:898
translate latin a1s2_f4565f4b:

    # "I follow Alexios quietly through the halls, really enjoying the architecture of the palace for the first time."
    "Alexium tacitus per andrones sequor, primum architectura palatii vere delectatus."

# game/a1s2.rpy:899
translate latin a1s2_daf201b2:

    # "We enter the main hall and Alexios stands in the sunlight pouring in through the archways."
    "In aulam principalem intramus, et Alexios in luce solis per arcus effusa stat."

# game/a1s2.rpy:901
translate latin a1s2_8024ee09:

    # al "\"Ahh, aren't the mornings beautiful here? This is the best time to do work in the gardens. I'd say we have a good three hours before it gets too hot.\""
    al "\"Ahh, nonne matutina hic pulchra sunt? Hoc optimum tempus est in hortis operandi. Credo tres horas integras habere nos antequam nimis calidum fiat.\""

# game/a1s2.rpy:902
translate latin a1s2_c72d3f9e:

    # "We start walking out into the gardens when I'm suddenly struck by something odd."
    "In hortos exire incipimus, cum aliquid mirum subito mihi occurrit."

# game/a1s2.rpy:903
translate latin a1s2_2c8bfe1b:

    # m "\"So, you just said we have three hours?\""
    m "\"Ergo modo dixisti nos tres horas habere?\""

# game/a1s2.rpy:905
translate latin a1s2_2081b889:

    # al "\"Yes?\""
    al "\"Volui?\""

# game/a1s2.rpy:906
translate latin a1s2_011991b9:

    # m "\"Well...how long is an hour here?\""
    m "\"Bene... quantum hic hora durat?\""

# game/a1s2.rpy:910
translate latin a1s2_c144fe6a:

    # al "\"The same.\""
    al "\"Idem.\""

# game/a1s2.rpy:911
translate latin a1s2_1e61d9a2:

    # m "\"Oh, we use the same minutes and hours and stuff?\""
    m "\"O, iisdem minutis et horis et talibus utimur?\""

# game/a1s2.rpy:912
translate latin a1s2_ea3af38a:

    # "That didn't seem possible."
    "Id fieri posse non videbatur."

# game/a1s2.rpy:913
translate latin a1s2_69fe056b:

    # "Alexios thinks, rubbing the spot above his left eyebrow."
    "Alexios cogitat, locum supra sinistrum supercilium fricans."

# game/a1s2.rpy:915
translate latin a1s2_ec8f17ee:

    # al "\"Ah, well, the Lingua is a complicated device. It's Parental tech, so it's something that we don't really understand at all, but what we do know is that it translates language in a way that offers the best understanding possible for the host.\""
    al "\"Ah, bene, Lingua instrumentum implicatum est. Ars Parentum est, itaque eam re vera omnino non intellegimus; sed scimus eam linguam ita vertere ut is qui ea utitur quam optime intellegat.\""

# game/a1s2.rpy:916
translate latin a1s2_0c861436:

    # "Alexios crouches by a pillar, examining the ivy growing around its surface."
    "Alexios iuxta columnam se demittit, hederam circa eius superficiem crescentem examinans."

# game/a1s2.rpy:918
translate latin a1s2_5dac72bf:

    # al "\"I used a measurement of time specific to the Wolves and their language, and the Lingua simply translated it to a measurement you'd better understand.\""
    al "\"Mensura temporis propria Luporum linguaeque eorum usus sum; Lingua tantum eam in mensuram vertit quam tu melius intellegas.\""

# game/a1s2.rpy:919
translate latin a1s2_d3f03835:

    # "The small cat chuckles."
    "Parvus felis subridet."

# game/a1s2.rpy:921
translate latin a1s2_5fc92f74:

    # al "\"It's something I've given up on understanding myself. It's not perfect and can create really confusing situations. Especially when it comes to certain words and numbers.\""
    al "\"Hoc ipse intellegere iam destiti. Perfecta non est et res valde confusas efficere potest, praesertim ubi de quibusdam verbis et numeris agitur.\""

# game/a1s2.rpy:922
translate latin a1s2_2d6ee573_1:

    # m "\"Oh.\""
    m "\"O.\""

# game/a1s2.rpy:923
translate latin a1s2_0d465942:

    # "I see Alexios single out a small, white flower growing at the base of the pillar before he plucks it out and sets it to the side."
    "Video Alexium parvum florem album ad imum columnae crescentem eligere, antequam eum evellit et ad latus ponit."

# game/a1s2.rpy:924
translate latin a1s2_104ff302:

    # "I start to wonder if I should maybe learn the language."
    "Quaerere incipio an fortasse linguam discere debeam."

# game/a1s2.rpy:925
translate latin a1s2_74865867:

    # "The lingua is impressive and all, but it doesn't seem like it's very specific."
    "Lingua quidem mirabilis est, sed non valde accurata esse videtur."

# game/a1s2.rpy:927
translate latin a1s2_5d62d9ac:

    # "Alexios grins."
    "Alexios late arridet."

# game/a1s2.rpy:928
translate latin a1s2_50fe4569:

    # al "\"Don't think too much about it.\""
    al "\"Noli nimium de eo cogitare.\""

# game/a1s2.rpy:930
translate latin a1s2_5e28fb95:

    # al "\"Just try to remember that that doesn't mean everything actually {i}is{/i} the same. There are 19 hours in a day on Adastra which I imagine is at least somewhat different compared to your own planet.\""
    al "\"Tantum meminisse conare id non significare omnia vere eadem {i}esse{/i}. Dies in Adastra 19 horas habet, quod credo saltem aliquantum a planeta tuo differre.\""

# game/a1s2.rpy:932
translate latin a1s2_273eab8b:

    # al "\"Anyway, what I'm doing right now is pulling up some weeds. The drones do a good job of watering and pest control, but they often miss smaller weeds like these.\""
    al "\"Utut est, nunc herbas inutiles evello. Automata rigationem et animalium noxiorum moderationem bene curant, sed saepe has herbas minores neglegunt.\""

# game/a1s2.rpy:933
translate latin a1s2_493b9d0c:

    # "I crouch at the pillar next to Alexios, searching through the ivy for weeds to pull at the base."
    "Iuxta Alexium ad columnam me demitto, inter hederam herbas inutiles quaerens quas ab imo evellam."

# game/a1s2.rpy:934
translate latin a1s2_d01c02f1:

    # m "\"So...there are 19 hours in a day here?\""
    m "\"Ergo... dies hic 19 horas habet?\""

# game/a1s2.rpy:935
translate latin a1s2_8c7583c6:

    # al "\"Yes.\""
    al "\"Ita.\""

# game/a1s2.rpy:936
translate latin a1s2_cf4a1970:

    # m "\"That's a bit shorter than back home.\""
    m "\"Paulo brevior quam domi est.\""

# game/a1s2.rpy:937
translate latin a1s2_ce11235d:

    # al "\"Oh I get that. There are 30 hours in a day where I'm from. You get used to it after a few weeks, though. I prefer it, actually\""
    al "\"O, intellego. Unde venio, dies 30 horas habet. Post paucas tamen hebdomades assuescis. Re vera hoc malo\""

# game/a1s2.rpy:939
translate latin a1s2_5a7f84bc:

    # "I turn my attention back to the pillar and suddenly find myself staring right at a strange, crab-like thing sticking to the stone."
    "Rursus columnam curare incipio et subito miram rem cancro similem in lapide haerentem recta aspicio."

# game/a1s2.rpy:940
translate latin a1s2_ef9706e7:

    # "At first I wonder if it's a carving of some kind, since it's so big."
    "Primum quaero an quaedam sculptura sit, cum tam magna sit."

# game/a1s2.rpy:941
translate latin a1s2_aa761f44:

    # "But as I look closer, it moves and I realize that it's a massive living spider."
    "Sed cum propius aspicio, movetur, atque intellego araneum ingentem vivum esse."

# game/a1s2.rpy:942
translate latin a1s2_78eb7d9f:

    # "The next thing I know, I'm rolling away from the pillar action movie-style before popping back up to my feet."
    "Statim a columna volvor sicut in pellicula pugnarum, antequam in pedes rursus subsilio."

# game/a1s2.rpy:944
translate latin a1s2_101de74d:

    # m "\"OH MY GOD!\""
    m "\"O DEUS MEUS!\""

# game/a1s2.rpy:946
translate latin a1s2_6c40df1c:

    # al "\"What is it!?\""
    al "\"Quid est!?\""

# game/a1s2.rpy:947
translate latin a1s2_54d75537:

    # m "\"A spider...thing!\""
    m "\"Araneus... res quaedam!\""

# game/a1s2.rpy:948
translate latin a1s2_cfbd50cc:

    # "I'm standing a good ten feet away from the pillar now, but I can still see the massive spider, its thick legs fanned out to the width of a clock."
    "Iam decem saltem pedes a columna absum, sed araneum ingentem adhuc video, cruribus crassis ad latitudinem horologii expansis."

# game/a1s2.rpy:949
translate latin a1s2_d0845102:

    # "I shiver."
    "Horresco."

# game/a1s2.rpy:950
translate latin a1s2_70bf172e:

    # m "\"Eugh!\""
    m "\"Eugh!\""

# game/a1s2.rpy:952
translate latin a1s2_5ce1d28b:

    # al "\"Ah...hahaha. Oh, I see.\""
    al "\"Ah... hahaha. O, intellego.\""

# game/a1s2.rpy:953
translate latin a1s2_e3a5312e:

    # "I stare at him."
    "Eum fixis oculis intueor."

# game/a1s2.rpy:954
translate latin a1s2_fc953caf:

    # m "\"How is that funny!?\""
    m "\"Quomodo hoc ridiculum est!?\""

# game/a1s2.rpy:955
translate latin a1s2_eaab0b86:

    # al "\"I'm sorry. They {i}are{/i} very startling when you first encounter them.\""
    al "\"Ignosce. Certe valde terribiles {i}sunt{/i} cum eos primum convenis.\""

# game/a1s2.rpy:956
translate latin a1s2_6e8b2074:

    # "Alexios walks up to the spider and starts making shooing motions at it."
    "Alexios ad araneum accedit et gestibus eum abigere incipit."

# game/a1s2.rpy:957
translate latin a1s2_e435d079:

    # "Even from here I can see its black, beady eyes."
    "Etiam hinc oculos eius nigros globulis similes videre possum."

# game/a1s2.rpy:958
translate latin a1s2_1a9bfb53:

    # "It doesn't move at all, choosing to sit motionlessly on its pillar."
    "Nihil movetur, in columna sua immotus sedere malens."

# game/a1s2.rpy:959
translate latin a1s2_a9e5d4f0:

    # al "\"Adastran arachnids and insects are disturbingly large compared to the ones on my home moon.\""
    al "\"Arachnida et insecta Adastrae moleste magna sunt, si cum eis in luna patria mea compares.\""

# game/a1s2.rpy:960
translate latin a1s2_7562ef55:

    # "I look around, suddenly feeling like I'm in danger, imagining giant wasps descending from the skies."
    "Circum aspicio, subito quasi in periculo sim sentiens, vespas ingentes e caelo descendentes fingens."

# game/a1s2.rpy:962
translate latin a1s2_d8d2381f:

    # "Alexios starts to look more frustrated as the spider refuses to be intimidated by his limp-wristed swipes."
    "Alexios frustratior videri incipit, cum araneus blandis manus ictibus terreri recuset."

# game/a1s2.rpy:963
translate latin a1s2_7d6ae32f:

    # al "\"Nothing in the gardens is dangerous though, and they're needed to balance the ecosystem. This creature's venom is far too mild to cause much more than an itchy bump, if it bites at all.\""
    al "\"Nihil tamen in hortis periculosum est, et haec ad aequilibrium oecosystematis servandum requiruntur. Venenum huius animalis multo nimis debile est ut ultra tumorem prurientem quidquam fere efficiat, si omnino mordet.\""

# game/a1s2.rpy:964
translate latin a1s2_67e58f8f:

    # "Alexios gives another weak swipe at the spider and it takes the opportunity to bolt up his arm so fast that it becomes a blur before stopping on his face."
    "Alexios alterum ictum debilem ad araneum dirigit; ille occasione usus tam celeriter per bracchium eius currit ut vix cernatur, antequam in facie eius consistit."

# game/a1s2.rpy:966
translate latin a1s2_f8b80a75:

    # "For a moment, we both stand there in shock as it clings to him like a facehugger."
    "Paulisper ambo attoniti stamus, dum ei adhaeret quasi monstrum quod faciem amplectitur."

# game/a1s2.rpy:967
translate latin a1s2_d54f0fae:

    # "Then—"
    "Tum—"

# game/a1s2.rpy:969
translate latin a1s2_b5169fba:

    # al "\"BY GALEN! GET IT OFF!\""
    al "\"PER GALENUM! TOLLE HOC!\""

# game/a1s2.rpy:971
translate latin a1s2_c11d1566:

    # "He dances around in place for a moment as I simply watch in fascinated horror."
    "Paulisper in loco salit, dum ego tantum horrore fascinatus observo."

# game/a1s2.rpy:972
translate latin a1s2_0307a515:

    # "Finally, he shakes his head hard and the spider runs down his front to scuttle across the ground and into some bushes."
    "Tandem caput vehementer quatit; araneus per partem anteriorem eius descendit, tum per solum in quosdam frutices currit."

# game/a1s2.rpy:973
translate latin a1s2_8372e6ee:

    # "Alexios heaves for breath for a moment, trembling."
    "Alexios paulisper tremens spiritum aegre ducit."

# game/a1s2.rpy:974
translate latin a1s2_5845060f:

    # "Despite myself, I have to laugh in amazement at what I just saw."
    "Invitus ridere cogor, miratus id quod modo vidi."

# game/a1s2.rpy:976
translate latin a1s2_8d7560cb:

    # al "\"Wh—Why are you laughing?\""
    al "\"Qu—cur rides?\""

# game/a1s2.rpy:977
translate latin a1s2_26b4b9cf:

    # m "\"Sorry, it was just...so surprising, and you were so sure of yourself until—\""
    m "\"Ignosce, tantum... tam mirum fuit, et tam confidens eras, donec—\""

# game/a1s2.rpy:978
translate latin a1s2_a1b457bf:

    # "I chuckle again."
    "Iterum subrideo."

# game/a1s2.rpy:979
translate latin a1s2_6ee32396:

    # al "\"Well, it surprised me!\""
    al "\"Bene, me terruit!\""

# game/a1s2.rpy:980
translate latin a1s2_1ac54111:

    # "He shivers, rubbing his shoulders."
    "Horrescit, umeros suos fricans."

# game/a1s2.rpy:982
translate latin a1s2_be54b025:

    # al "\"There's honestly nothing to be afraid of when it comes to those, but it was right on me, and the way they move—\""
    al "\"Re vera nihil in illis timendum est, sed mihi ipsi adhaerebat, atque ille modus quo moventur—\""

# game/a1s2.rpy:983
translate latin a1s2_31e4409e:

    # "He shudders again."
    "Iterum horrescit."

# game/a1s2.rpy:985
translate latin a1s2_0586c78d:

    # al "\"And you just stood there and watched!\""
    al "\"Et tu tantum ibi stabas et spectabas!\""

# game/a1s2.rpy:986
translate latin a1s2_16ae6eba:

    # m "\"I mean, what could I have done? If that had happened to me I would have jumped in the pond.\""
    m "\"Scilicet, quid facere potui? Si mihi accidisset, in stagnum desiluissem.\""

# game/a1s2.rpy:987
translate latin a1s2_6ffa5567:

    # "Alexios sighs and I see his fur start to flatten down again."
    "Alexios suspirat, et pilos eius rursus subsidere video."

# game/a1s2.rpy:989
translate latin a1s2_eb73ca0b:

    # "Then he also chuckles."
    "Tum ille quoque subridet."

# game/a1s2.rpy:990
translate latin a1s2_ca534027:

    # al "\"Well...I was about to.\""
    al "\"Bene... iam paene id faciebam.\""

# game/a1s2.rpy:992
translate latin a1s2_5731b3ad:

    # al "\"Anyway, let's get back to work. If you see another spider...just work around it.\""
    al "\"Utut est, ad opus redeamus. Si alium araneum videris... tantum circa eum operare.\""

# game/a1s2.rpy:996
translate latin a1s2_81516678:

    # "For the next hour, we move from pillar to pillar, cleaning up the unwanted weeds."
    "Per proximam horam a columna ad columnam procedimus, herbas inutiles evellentes."

# game/a1s2.rpy:997
translate latin a1s2_b20c3514:

    # "I'm way more vigilant now, checking every pillar for spiders before we start."
    "Iam multo vigilantior sum, singulas columnas ante initium operis araneis perscrutans."

# game/a1s2.rpy:998
translate latin a1s2_f40438e8:

    # "Luckily, we don't come across anymore."
    "Feliciter nullos alios invenimus."

# game/a1s2.rpy:999
translate latin a1s2_c68e04f7:

    # "After a while, we finally sit on a bench under some trees and Com floats out a few platters of tiny pastries that remind me of quiches."
    "Post aliquantum temporis tandem in scamno sub arboribus considimus; Com aliquot lances parvarum placentarum levitando mittit, quae me tartarum ovis factarum admonent."

# game/a1s2.rpy:1000
translate latin a1s2_e03ef98e:

    # "Those are followed by glasses of cold, green, vegetable-tasting drinks."
    "Eas sequuntur pocula frigidorum potuum viridium, sapore holerum."

# game/a1s2.rpy:1001
translate latin a1s2_2f14ec83:

    # "It's delicious."
    "Suavissimum est."

# game/a1s2.rpy:1002
translate latin a1s2_6e93ee64:

    # m "\"So, can I ask where you're from?\""
    m "\"Ergo, possumne quaerere unde venias?\""

# game/a1s2.rpy:1004
translate latin a1s2_d5fc82e4:

    # al "\"Very far away. Even further than your home.\""
    al "\"E regione longinqua. Etiam longius quam domus tua.\""

# game/a1s2.rpy:1005
translate latin a1s2_9a481618:

    # m "\"What brought you here?\""
    m "\"Quid te huc adduxit?\""

# game/a1s2.rpy:1007
translate latin a1s2_0150198a:

    # "The cat sighs and pauses with a pastry halfway to his mouth."
    "Felis suspirat et consistit, placenta dimidia via ad os sublata."

# game/a1s2.rpy:1008
translate latin a1s2_a29d23d9:

    # al "\"It's a bit complicated, but I was here as a sort of ambassador. I arrived just as the Stretch Drive depletion occurred.\""
    al "\"Res aliquantum implicata est, sed hic quasi legatus eram. Adveni ipso tempore quo energia Propulsoris Distensionis defecit.\""

# game/a1s2.rpy:1009
translate latin a1s2_ccbc40c2:

    # m "\"What was that?\""
    m "\"Quid illud erat?\""

# game/a1s2.rpy:1010
translate latin a1s2_79946525:

    # "Alexios shrugs."
    "Alexios umeros tollit."

# game/a1s2.rpy:1011
translate latin a1s2_7c802cf3:

    # al "\"Well, for whatever reason, the Romanus stopped supplying the Wolves with Stretch Drive power when the emperor died. They're starbound right now, so they can't shuttle me back to my planet.\""
    al "\"Bene, nescio qua de causa Romanus Lupis energiam Propulsoris Distensionis suppeditare desiit cum imperator mortuus est. Nunc intra systema stellae suae continentur, itaque ad planetam meum me reducere non possunt.\""

# game/a1s2.rpy:1013
translate latin a1s2_f425a0dd:

    # al "\"The situation between the wolves and their parents is worrying, and we don't know how long the wolves will be without the Stretch, so my people sent their own ship to retrieve everyone on Adastra, but I, uh, missed it.\""
    al "\"Res inter Lupos et Parentes eorum nos sollicitat, nec scimus quam diu Lupi sine Distensione futuri sint; itaque gens mea navem suam misit ut omnes in Adastra repeteret, sed ego, eh, eam amisi.\""

# game/a1s2.rpy:1014
translate latin a1s2_cd0fd914:

    # m "\"Missed it?\""
    m "\"Amisisti?\""

# game/a1s2.rpy:1015
translate latin a1s2_827e39f7:

    # "Alexios frowns, looking embarrassed again."
    "Alexios frontem corrugat, iterum erubescens."

# game/a1s2.rpy:1017
translate latin a1s2_3214a64b:

    # al "\"Well...I slept in and missed the departure.\""
    al "\"Bene... nimis diu dormivi et profectionem amisi.\""

# game/a1s2.rpy:1018
translate latin a1s2_2ef7a377:

    # m "\"Wow, really?\""
    m "\"O, re vera?\""

# game/a1s2.rpy:1019
translate latin a1s2_80e4ef55:

    # al "\"I mean, it happens to the best of us, no?\""
    al "\"Scilicet, etiam optimis nostrum accidit, nonne?\""

# game/a1s2.rpy:1020
translate latin a1s2_d74e015b:

    # m "\"I guess...why didn't they wait for you? That's kind of messed up that they'd just leave.\""
    m "\"Credo... cur te non exspectaverunt? Satis turpe est ita abire.\""

# game/a1s2.rpy:1021
translate latin a1s2_a0c663bf:

    # al "\"When using Stretch tech, time is important. Everything runs on a specific schedule, so if you miss it, you miss it. And they're certainly not going to send another one out for one person.\""
    al "\"Cum arte Distensionis uteris, tempus magni momenti est. Omnia secundum certum ordinem temporum fiunt; si profectionem amiseris, amissa est. Nec alteram navem unius tantum causa certe mittent.\""

# game/a1s2.rpy:1022
translate latin a1s2_4f15939a:

    # m "\"Wow, didn't you have an alarm clock, or someone to wake you?\""
    m "\"O, nonne horologium excitatorium habebas, aut aliquem qui te excitaret?\""

# game/a1s2.rpy:1024
translate latin a1s2_ee07f5d2:

    # al "\"Trust me, it was a series of many unfortunate events that lead to that happening, the main one being that even though I woke up with enough time to reach the starport, I got lost in Adastra City's terrible public transportation system.\""
    al "\"Crede mihi, multa infelicia deinceps acciderunt ut hoc fieret; praecipuum erat quod, quamquam satis mature experrectus sum ut ad portum stellarum pervenirem, in pessimo publico vecturae systemate urbis Adastrae erravi.\""

# game/a1s2.rpy:1025
translate latin a1s2_f6dbe5be:

    # al "\"I was running from platform to platform, Wolves all around me trying to touch me because they've never seen a Cat before, and I could barely read the signs because...well, for my species water comes from the eyes when we're stressed, so...\""
    al "\"Ab alia ad aliam stationis crepidinem currebam, Lupis circum me me tangere conantibus quia Felem numquam viderant; signa vix legere poteram, quia... bene, speciei meae aqua ex oculis exit cum angimur, itaque...\""

# game/a1s2.rpy:1026
translate latin a1s2_f673a852:

    # m "\"Oh, you were crying.\""
    m "\"O, flebas.\""

# game/a1s2.rpy:1028
translate latin a1s2_5732aa7b:

    # al "\"...You know what that is?\""
    al "\"...Scis quid id sit?\""

# game/a1s2.rpy:1029
translate latin a1s2_b35a7eba:

    # m "\"Yeah, my species does it too.\""
    m "\"Ita, mea species quoque facit.\""

# game/a1s2.rpy:1030
translate latin a1s2_1c602544:

    # "He looks away and I can see the insides of his ears turn red."
    "Oculos avertit et partes interiores aurium eius rubescere video."

# game/a1s2.rpy:1031
translate latin a1s2_e23494f6:

    # al "\"Ah, I did not know that. It's a shared trait among us and the Wolves, but I don't know many others that do it, aside from the Khemians.\""
    al "\"Ah, id nesciebam. Haec proprietas nobis et Lupis communis est, sed paucos alios novi qui id faciant, praeter Khemianos.\""

# game/a1s2.rpy:1033
translate latin a1s2_97966f67:

    # al "\"Anyway, I eventually decided to use my situation to continue my work and build a relationship with the imperial family. So, I became Cassius's pet.\""
    al "\"Utut est, tandem statuens hac condicione uti ut opus meum continuarem et cum familia imperiali necessitudinem aedificarem, animal domesticum Cassii factus sum.\""

# game/a1s2.rpy:1034
translate latin a1s2_27975603:

    # "Alexios's situation doesn't sound all that different from mine, even though the reasons for us getting here were very different."
    "Condicio Alexii non tam diversa a mea videtur, quamquam causae ob quas huc venimus valde diversae erant."

# game/a1s2.rpy:1035
translate latin a1s2_fd48e769:

    # m "\"When does the next ship come?\""
    m "\"Quando proxima navis venit?\""

# game/a1s2.rpy:1037
translate latin a1s2_79946525_1:

    # "Alexios shrugs."
    "Alexios umeros tollit."

# game/a1s2.rpy:1038
translate latin a1s2_dd9b588f:

    # al "\"Years. At least one a decade, but sometimes more. I'm hoping within the next few years, though.\""
    al "\"Post annos. Saltem una singulis decenniis venit, sed interdum plures. Spero tamen intra paucos annos proximos.\""

# game/a1s2.rpy:1039
translate latin a1s2_623e858c:

    # m "\"I'm sorry to hear that.\""
    m "\"Me paenitet id audire.\""

# game/a1s2.rpy:1041
translate latin a1s2_f0ffb6a1:

    # al "\"Heh, it's not the worst life, and the Wolves treat me well enough. We do have a special relationship.\""
    al "\"Heh, non pessima vita est, et Lupi satis bene me tractant. Peculiarem sane necessitudinem habemus.\""

# game/a1s2.rpy:1042
translate latin a1s2_8bad55a7:

    # m "\"...With Cassius?\""
    m "\"...Cum Cassio?\""

# game/a1s2.rpy:1043
translate latin a1s2_9ff6788d:

    # al "\"Between us and the Wolves. Unlike the other siblings, our parents originated in the same galaxy. Though our views are very different, there's a bond there.\""
    al "\"Inter nos et Lupos. Dissimiles ceteris Fratribus, Parentes nostri ex eadem galaxia orti sunt. Quamquam sententiae nostrae valde diversae sunt, vinculum ibi est.\""

# game/a1s2.rpy:1044
translate latin a1s2_8124da43:

    # "Alexios brushes his paws together."
    "Alexios manus inter se deterget."

# game/a1s2.rpy:1046
translate latin a1s2_830cef67:

    # al "\"Are you done?\""
    al "\"Perfecisti?\""

# game/a1s2.rpy:1047
translate latin a1s2_c806ebc0:

    # m "\"Yeah.\""
    m "\"Ita.\""

# game/a1s2.rpy:1050
translate latin a1s2_885a6926_1:

    # al "\"Com, we're finished.\""
    al "\"Com, perfecimus.\""

# game/a1s2.rpy:1051
translate latin a1s2_17b3b225:

    # "And with that, the platters and glasses float away."
    "His dictis lances et pocula volando abeunt."

# game/a1s2.rpy:1052
translate latin a1s2_36b4f2e4:

    # "I'm starting to get used to all of this."
    "His omnibus assuescere incipio."

# game/a1s2.rpy:1053
translate latin a1s2_cd0555d4:

    # al "\"But...[mc], was it?\""
    al "\"Sed...[mc] eras, nonne?\""

# game/a1s2.rpy:1054
translate latin a1s2_c806ebc0_1:

    # m "\"Yeah.\""
    m "\"Ita.\""

# game/a1s2.rpy:1056
translate latin a1s2_2dbe5665:

    # al "\"Haha, I'm sorry. I guess we skipped introductions. You already know me as Alexios, but you can call me Alex.\""
    al "\"Haha, ignosce. Credo nos nomina dare omisisse. Iam me Alexium nosti, sed Alex me appellare potes.\""

# game/a1s2.rpy:1057
translate latin a1s2_3d6eceba:

    # m "\"Hello, Alex.\""
    m "\"Salve, Alex.\""

# game/a1s2.rpy:1059
translate latin a1s2_1491604e:

    # al "\"Hello [mc]. So now that we're no longer pretending that you're not so sapient anymore, where are you from? Tell me about yourself.\""
    al "\"Salve, [mc]. Nunc ergo, cum desierimus fingere te minus sapientem esse, unde venis? Narra mihi de te.\""

# game/a1s2.rpy:1060
translate latin a1s2_c9bb9e8f:

    # "That gives me some pause."
    "Haec me paulisper haesitare faciunt."

# game/a1s2.rpy:1061
translate latin a1s2_df88383f:

    # "While he's been really nice to me so far, I know I can't just reveal everything to Alex, so I settle on being vague like he was."
    "Quamquam hactenus mecum valde benignus fuit, scio me non posse omnia Alex aperire; itaque eodem modo quo ille vage loqui statuo."

# game/a1s2.rpy:1062
translate latin a1s2_e8e20806:

    # m "\"Well, I'm from far away, but less far away than you. I'm a primate.\""
    m "\"Bene, e regione longinqua venio, sed minus longinqua quam tu. Primas sum.\""

# game/a1s2.rpy:1064
translate latin a1s2_b31a9693:

    # al "\"I see. Are you important among your people?\""
    al "\"Intellego. Magni momenti inter gentem tuam es?\""

# game/a1s2.rpy:1065
translate latin a1s2_c643a623:

    # m "\"No, I'm just a student.\""
    m "\"Non, tantum discipulus sum.\""

# game/a1s2.rpy:1066
translate latin a1s2_7e5ba029:

    # al "\"Oh...do you know why Amicus chose you, then?\""
    al "\"O... scis ergo cur Amicus te elegerit?\""

# game/a1s2.rpy:1067
translate latin a1s2_c34bce1a:

    # m "\"...I think he just chose me at random. I just happened to be where the uplift occurred.\""
    m "\"...Puto eum tantum forte me elegisse. Forte ibi eram ubi ad altiorem cultum provecti eramus.\""

# game/a1s2.rpy:1069
translate latin a1s2_86dd4e2a:

    # "Alexios blinks, then laughs."
    "Alexios nictat, deinde ridet."

# game/a1s2.rpy:1071
translate latin a1s2_ba1b4055:

    # al "\"That's just like Amicus.\""
    al "\"Hoc prorsus Amicus est.\""

# game/a1s2.rpy:1072
translate latin a1s2_481f6938:

    # m "\"Yeah, it is, actually.\""
    m "\"Ita, sane est.\""

# game/a1s2.rpy:1074
translate latin a1s2_946a60df:

    # al "\"But I guess it makes sense to choose a commoner if he wants to unite the abandoned Children again.\""
    al "\"Sed credo rationem habere plebeium eligere, si Liberos desertos rursus coniungere vult.\""

# game/a1s2.rpy:1075
translate latin a1s2_73453da0:

    # m "\"Oh yeah?\""
    m "\"O, ita?\""

# game/a1s2.rpy:1076
translate latin a1s2_01bc9f84:

    # "I decide that shifting the conversation away from me is a good tactic for now."
    "Statuo bonam rationem nunc esse sermonem a me avertere."

# game/a1s2.rpy:1077
translate latin a1s2_193fefbb:

    # al "\"Yeah, didn't he explain that to you?\""
    al "\"Ita, nonne tibi hoc explicavit?\""

# game/a1s2.rpy:1078
translate latin a1s2_26ed9dea:

    # m "\"Um, maybe a little. He didn't tell me all that much.\""
    m "\"Eh, fortasse aliquantum. Non multa mihi dixit.\""

# game/a1s2.rpy:1080
translate latin a1s2_3ca05756:

    # al "\"Hehe, don't take it personally. Amicus doesn't often think ahead.\""
    al "\"Hehe, noli ad te pertinere putare. Amicus non saepe futura cogitat.\""

# game/a1s2.rpy:1082
translate latin a1s2_c3c31ac6:

    # al "\"Right now, the Wolves are in a bit of a strange situation. Again, this is between you and me, but they've fallen behind the other Siblings in terms of spread and resources.\""
    al "\"Nunc Lupi in condicione aliquantum mira sunt. Iterum dico, haec inter te et me manent, sed a ceteris Fratribus amplitudine imperii et opibus superantur.\""

# game/a1s2.rpy:1083
translate latin a1s2_a4e846c6:

    # al "\"The main reason being that they don't uplift their Children to similar intelligence levels as themselves.\""
    al "\"Praecipua causa est quod Liberos suos ad gradus intelligentiae suis similes non provehunt.\""

# game/a1s2.rpy:1084
translate latin a1s2_f7d0adc9:

    # m "\"Intelligence levels? I thought they just spread their culture?\""
    m "\"Gradus intelligentiae? Putabam eos tantum cultum suum propagare.\""

# game/a1s2.rpy:1085
translate latin a1s2_9b01fea0:

    # "Alex frowns at me."
    "Alex frontem ad me corrugat."

# game/a1s2.rpy:1087
translate latin a1s2_3eac882a:

    # al "\"You don't know? I guess you were abandoned but...you should know that your intelligence, every Child's intelligence, was uplifted by a Sibling.\""
    al "\"Nescis? Credo vos desertos esse, sed... scire debes intelligentiam tuam, intelligentiam cuiusque Liberi, a Fratre auctam esse.\""

# game/a1s2.rpy:1088
translate latin a1s2_46bc8eee:

    # m "\"Oh...no, I guess we lost that bit of information.\""
    m "\"O... non, credo nos eam notitiam amisisse.\""

# game/a1s2.rpy:1090
translate latin a1s2_01a4cfcc:

    # al "\"Well, that's not the end of their problems. These Children are indentured servants in a way. In exchange for having their intelligence...mostly...uplifted, they have to serve the empire until the debt is repaid.\""
    al "\"Sed non hic mala eorum finiuntur. Hi Liberi quodammodo servitutis pactione obligantur. Pro intelligentia sua... plerumque... aucta, imperio servire debent donec debitum redditum sit.\""

# game/a1s2.rpy:1091
translate latin a1s2_f2f89ae6:

    # "That doesn't sound good."
    "Id parum bonum sonat."

# game/a1s2.rpy:1092
translate latin a1s2_4635cb3f:

    # m "\"Oh. And how long has that been going on?\""
    m "\"O. Et quam diu hoc fit?\""

# game/a1s2.rpy:1094
translate latin a1s2_44d7c62b:

    # al "\"Heh, well, let's just say that the first successfully uplifted Wolf Children haven't quite finished repaying their debt.\""
    al "\"Heh, bene, dicamus tantum primos Liberos Luporum feliciter ad altiorem cultum provectos nondum omnino debitum suum reddidisse.\""

# game/a1s2.rpy:1095
translate latin a1s2_7147f701:

    # m "\"That...sounds like slavery?\""
    m "\"Hoc... servitus esse videtur?\""

# game/a1s2.rpy:1096
translate latin a1s2_a92a2638:

    # "Alex glances at me."
    "Alex me breviter aspicit."

# game/a1s2.rpy:1098
translate latin a1s2_82fa8fde:

    # al "\"It does, doesn't it?\""
    al "\"Videtur, nonne?\""

# game/a1s2.rpy:1099
translate latin a1s2_969239f4:

    # "That's confusing to me."
    "Hoc me confundit."

# game/a1s2.rpy:1100
translate latin a1s2_f93f7622:

    # m "\"But, if they have all of these robots and stuff, why do they need sapients to be their slaves?\""
    m "\"Sed, si haec omnia automata et talia habent, cur Sapientibus egent qui servi eorum sint?\""

# game/a1s2.rpy:1101
translate latin a1s2_a25375e5:

    # al "\"Advanced artificial sapients are gifted by the parents. We can't build them. We're a bit spoiled here in the palace, but outside not so much.\""
    al "\"Sapientes artificiales provecti a Parentibus dono dantur. Eos efficere non possumus. Hic in palatio aliquantum deliciis assueti sumus, sed foris non ita.\""

# game/a1s2.rpy:1102
translate latin a1s2_9d4c4702:

    # al "\"And even then, artificial sapience isn't perfect and likely never will be. Actual thinking machines don't exist. This is why uplifting Children to the same intelligence level as a Sibling is important; good ideas can come from anywhere.\""
    al "\"Ac ne sic quidem sapientia artificialis perfecta est nec probabiliter umquam erit. Machinae vere cogitantes non exstant. Ideo Liberos ad eundem intelligentiae gradum ac Fratres provehere magni momenti est: bona consilia undecumque venire possunt.\""

# game/a1s2.rpy:1103
translate latin a1s2_431d7115:

    # m "\"I guess your people don't do what the wolves do?\""
    m "\"Credo gentem tuam non idem facere quod Lupi faciunt?\""

# game/a1s2.rpy:1104
translate latin a1s2_ac020722:

    # al "\"No, we uplift our Children as much as we can. This practice is isolated to the Wolves. They're seen by the other siblings as...harsh on their own Children, and the rights of Sapients in general.\""
    al "\"Non; Liberos nostros quantum possumus ad altiorem cultum provehimus. Hic mos Lupis solis proprius est. Ceteri Fratres eos putant... duros erga Liberos suos et erga iura Sapientium in universum.\""

# game/a1s2.rpy:1105
translate latin a1s2_0746d850_1:

    # m "\"I see.\""
    m "\"Intellego.\""

# game/a1s2.rpy:1106
translate latin a1s2_27a63515:

    # "I'm starting to see the Wolves and even Amicus in a whole new light."
    "Lupos atque ipsum Amicum omnino aliter videre incipio."

# game/a1s2.rpy:1107
translate latin a1s2_ffa8b15d:

    # "As if reading my mind, Alex goes on."
    "Quasi cogitationes meas legat, Alex pergit."

# game/a1s2.rpy:1109
translate latin a1s2_661b489d:

    # al "\"But things are changing. Amicus choosing you as his pet shows that he sees you as close to an equal...but then there's Cassius.\""
    al "\"Sed res mutantur. Quod Amicus te animal domesticum elegit, ostendit eum paene parem te videre... sed Cassius quoque est.\""

# game/a1s2.rpy:1111
translate latin a1s2_c3b94c1e:

    # "Alex's tail swishes around on the bench between us."
    "Cauda Alex in scamno inter nos ultro citroque movetur."

# game/a1s2.rpy:1112
translate latin a1s2_6fdcfddd:

    # al "\"He'd rather things stay the same...or even regress. That's why he's made a strong challenge against Amicus. There are many Wolves who are unsure of the change Amicus suggests, and the proposed alliance between the Wolves and the Khemians is only adding to it.\""
    al "\"Ille mavult res easdem manere... aut etiam regredi. Ideo Amico vehementer thronum disputavit. Multi Lupi de mutatione quam Amicus proponit dubitant, atque foedus propositum inter Lupos et Khemianos dubitationem tantum auget.\""

# game/a1s2.rpy:1113
translate latin a1s2_12e34a6e:

    # m "\"Khemians?\""
    m "\"Khemiani?\""

# game/a1s2.rpy:1114
translate latin a1s2_9b9ab98e:

    # al "\"They're another Sibling species, the most powerful in the galaxy, in fact. But that worries a lot of people here. There hasn't been a war between Siblings in over a hundred years, but the last one was between the Khemians and the Wolves.\""
    al "\"Alia species Fratrum sunt, immo potentissima in galaxia. Sed id multos hic sollicitat. Bellum inter Fratres plus centum annis non fuit, sed ultimum inter Khemianos et Lupos fuit.\""

# game/a1s2.rpy:1115
translate latin a1s2_bd70a32d:

    # al "\"You can imagine what sort of problems that might create. So Cassius, wanting the Wolves to stay independent and in complete control of their Children, is rather popular.\""
    al "\"Fingere potes quae difficultates inde oriantur. Itaque Cassius, qui Lupos sui iuris et pleno dominatu in Liberos suos manere vult, satis popularis est.\""

# game/a1s2.rpy:1117
translate latin a1s2_b0914675:

    # al "\"You might wonder why I'm telling you this, but I want you to understand the empire that you're in. It will make it easier to...navigate.\""
    al "\"Fortasse quaeris cur haec tibi dicam, sed volo ut imperium in quo es intellegas. Ita facilius tibi erit... viam invenire.\""

# game/a1s2.rpy:1118
translate latin a1s2_99d8415f:

    # "I was in fact wondering why he's telling me all of this."
    "Re vera quaerebam cur haec omnia mihi diceret."

# game/a1s2.rpy:1119
translate latin a1s2_b1cfa4e9:

    # "Does he have some other motive that he's not telling me?"
    "Num aliam causam habet quam mihi non aperit?"

# game/a1s2.rpy:1120
translate latin a1s2_845e65b7:

    # "I look over at him."
    "Eum aspicio."

# game/a1s2.rpy:1121
translate latin a1s2_18bfa22f:

    # m "\"Do you want Cassius to become emperor?\""
    m "\"Vis Cassium imperatorem fieri?\""

# game/a1s2.rpy:1123
translate latin a1s2_8103a934:

    # al "\"I like that we can discuss a lot of things, and being a Sibling allows me to have more freedom than most, but that's one thing that I should probably keep silent on.\""
    al "\"Placet mihi nos de multis rebus disputare posse; quod Frater sum, mihi plus libertatis quam plerisque dat. Sed haec una res est de qua probabiliter tacere debeam.\""

# game/a1s2.rpy:1124
translate latin a1s2_301c2927:

    # "That only confuses me more, but it doesn't sound like he's on Cassius's side."
    "Hoc me tantum magis confundit, sed a parte Cassii stare non videtur."

# game/a1s2.rpy:1125
translate latin a1s2_1d1912c3:

    # "Maybe Amicus and I could find an ally in him?"
    "Fortasse ego et Amicus in eo socium invenire possimus?"

# game/a1s2.rpy:1126
translate latin a1s2_f05e6cd2:

    # m "\"Well, I think I would prefer Amicus if his whole thing is to treat other sapients equally.\""
    m "\"Bene, puto me Amicum malle, si totum eius consilium est ceteros Sapientes aequaliter tractare.\""

# game/a1s2.rpy:1127
translate latin a1s2_c965b0d5:

    # "From what I can tell, that seems to please Alex."
    "Quantum intellegere possum, hoc Alex placere videtur."

# game/a1s2.rpy:1129
translate latin a1s2_44261159:

    # al "\"Well, we'll find out soon enough after the trials.\""
    al "\"Bene, satis mox post certamina sciemus.\""

# game/a1s2.rpy:1130
translate latin a1s2_f474c86e:

    # "Alex's mood suddenly brightens."
    "Animus Alex subito laetior fit."

# game/a1s2.rpy:1132
translate latin a1s2_4c394e07:

    # al "\"But anyway, I've really been enjoying our time together today. Like I said, it's so nice to be able to talk to someone who isn't my superior. I hope we can do this often while you're here.\""
    al "\"Sed utut est, nostro tempore hodie simul acto valde delectatus sum. Ut dixi, iucundissimum est cum aliquo loqui posse qui superior meus non sit. Spero nos saepe hoc facturos dum hic es.\""

# game/a1s2.rpy:1133
translate latin a1s2_95bcc563:

    # m "\"Yeah, of course.\""
    m "\"Ita, certe.\""

# game/a1s2.rpy:1135
translate latin a1s2_315d3ba8:

    # al "\"Wonderful.\""
    al "\"Optime.\""

# game/a1s2.rpy:1136
translate latin a1s2_725b3471:

    # "Alex raises a paw to look up at the sun...at Vita."
    "Alex manum tollit ut ad solem... ad Vitam... aspiciat."

# game/a1s2.rpy:1137
translate latin a1s2_4320230e:

    # al "\"We should keep working. It's starting to get too hot out here.\""
    al "\"Operari pergamus. Hic foris nimis calidum fieri incipit.\""

# game/a1s2.rpy:1139
translate latin a1s2_db0a6eaf:

    # "For the next several hours, we work around the garden before finally moving inside to walk around the palace a bit."
    "Per proximas aliquot horas circa hortum operamur, donec tandem intus paulum per palatium ambulamus."

# game/a1s2.rpy:1141
translate latin a1s2_d079b7eb:

    # "He points to doors for things like the throne room and communal bath, but we never go inside and he tells me I should only do so when I'm with Amicus."
    "Ianuas conclavis throni, balnei communis et talium locorum indicat, sed numquam intramus; dicit me tantum cum Amico intrare debere."

# game/a1s2.rpy:1143
translate latin a1s2_99a227e6:

    # "Eventually, we move back to the dining room where Alexios suggests we watch the screens until our masters return."
    "Tandem ad triclinium redimus, ubi Alexios proponit ut tabulas visuales spectemus donec domini nostri redeant."

# game/a1s2.rpy:1144
translate latin a1s2_4ba303f3:

    # "He says it will better acquaint me with Wolvish culture."
    "Dicit id me cultui Luporum melius assuefacturum."

# game/a1s2.rpy:1145
translate latin a1s2_f416f60f:

    # "It takes me a moment to realize that I'm watching a sort of film starring wolves similar to Amicus."
    "Paulisper requiro ut intellegam me quasi pelliculam spectare cuius actores lupi Amico similes sunt."

# game/a1s2.rpy:1146
translate latin a1s2_77f64e1e:

    # "They're acting out scenarios about traveling into space and finding more sapients."
    "Res agunt de itineribus per spatium et de pluribus Sapientibus inveniendis."

# game/a1s2.rpy:1147
translate latin a1s2_91bfa1b1:

    # "The sapient species they find are wolves in masks...I guess they don't really have CGI because every effect looks practical."
    "Species Sapientium quas inveniunt lupi personati sunt... credo eos imagines computatro factas non vere habere, quia omnes effectus rebus veris facti videntur."

# game/a1s2.rpy:1148
translate latin a1s2_ada185d1:

    # "It's long, boring, and the acting is overly-exaggerated, like they're in a silent film."
    "Longa est, taediosa, et actores nimium exaggerant, quasi in pellicula muta sint."

# game/a1s2.rpy:1149
translate latin a1s2_7893aee6:

    # "Finally, after what seems like a good three hours, Alex tells me that Amicus will be returning soon and that I might want to tidy up his room before he gets back."
    "Tandem post tres fere horas, ut videtur, Alex mihi dicit Amicum mox rediturum et fortasse me cubiculum eius componere velle antequam redeat."

# game/a1s2.rpy:1150
translate latin a1s2_edce29a1:

    # "I'm relieved to cut the film short, and Alex and I part ways to go to our respective rooms."
    "Gaudeo pelliculam ante finem relinquere; ego et Alex discedimus ut ad nostra quisque cubicula eamus."

# game/a1s2.rpy:1154
translate latin a1s2_9ce7f88d:

    # "I'm surprised to see that it's already dark outside."
    "Miror iam foris tenebras esse."

# game/a1s2.rpy:1155
translate latin a1s2_2ad39894:

    # "Even with the shorter day, I guess mindlessly watching wolves overacting to other wolves in masks took up more time than I thought."
    "Etiam die breviore, credo me, lupos personatos lupis nimium agentes sine cogitatione spectando, plus temporis consumpsisse quam putaveram."

# game/a1s2.rpy:1156
translate latin a1s2_d733242e:

    # "On my way through the marble halls, I pause every now and then to look at the large murals on the walls depicting everything from wolves swimming to wolves swinging swords at other canines."
    "Per andrones marmoreos ambulans interdum consisto ut magnas picturas murales aspiciam, omnia ostendentes a lupis natantibus ad lupos gladio alios caninos petentes."

# game/a1s2.rpy:1157
translate latin a1s2_39b310dd:

    # "In the great hall is the largest mural, and it depicts five wolves."
    "In aula magna maxima pictura muralis est, quinque lupos ostendens."

# game/a1s2.rpy:1158
translate latin a1s2_eaba72e1:

    # "The features are flat and lack any sort of perspective, making the muzzles look a bit askew."
    "Formae planae sunt nec prospectus rationem ullam habent, ita ut rostra aliquantum obliqua videantur."

# game/a1s2.rpy:1159
translate latin a1s2_147236b2:

    # "Two larger wolves loom over the other three; one is white with a feminine shape while the larger of the two is black and holding his paw to his chest."
    "Duo lupi maiores supra alios tres eminent: alter albus est forma feminina, alter maior niger est et manum ad pectus habet."

# game/a1s2.rpy:1160
translate latin a1s2_c7f2302a:

    # "Around his head is a wreath."
    "Caput eius corona cingitur."

# game/a1s2.rpy:1161
translate latin a1s2_91134f11:

    # "Of the three smaller wolves, one is also clearly feminine while another is white."
    "Ex tribus lupis minoribus unus quoque plane forma feminina est, alter albus."

# game/a1s2.rpy:1162
translate latin a1s2_e123e43b:

    # "I wonder if this might be Cassius and Virginia which would leave the remaining wolf in the middle to be Amicus."
    "Quaero an hi Cassius et Virginia sint, quo reliquus lupus in medio Amicus sit."

# game/a1s2.rpy:1163
translate latin a1s2_be0b261c:

    # "He's skinnier, and I wonder if this might be him as a child, or teenager."
    "Macrior est, et quaero an hic ille puer aut adulescens sit."

# game/a1s2.rpy:1164
translate latin a1s2_0cbc64f4:

    # "A glowing wreath floats above his head."
    "Corona fulgens supra caput eius fluit."

# game/a1s2.rpy:1165
translate latin a1s2_8b6852a6:

    # unk "\"Ahem.\""
    unk "\"Hem.\""

# game/a1s2.rpy:1166
translate latin a1s2_4045e4a4:

    # "I jump as someone clears their throat very loudly next to me."
    "Subsilio, cum aliquis iuxta me fauces clarissime purgat."

# game/a1s2.rpy:1168
translate latin a1s2_b1e67082:

    # "I turn around and find myself staring at Cato, the advisor."
    "Me verto et Catonem, consiliarium, recta aspicio."

# game/a1s2.rpy:1169
translate latin a1s2_37a4c5f8:

    # "He looks me up and down for a moment...at least I think he does."
    "Paulisper me a capite ad pedes inspicit... saltem puto eum facere."

# game/a1s2.rpy:1170
translate latin a1s2_486859e8:

    # "More silence."
    "Plus silentii."

# game/a1s2.rpy:1171
translate latin a1s2_6b2d0cd2:

    # "I open my mouth to respond, then remember what Amicus told me."
    "Os aperio ut respondeam, tum memini quid Amicus mihi dixerit."

# game/a1s2.rpy:1172
translate latin a1s2_5c75b8a8:

    # "I let my eyes unfocus and my mouth droop open a bit."
    "Oculos intentos esse desinere sino et os paulum apertum relinquo."

# game/a1s2.rpy:1173
translate latin a1s2_930c7fa2:

    # m "\"Uhhhh...\""
    m "\"Ehhhh...\""

# game/a1s2.rpy:1174
translate latin a1s2_4a8e5a08:

    # "Cato's ears twitch at the sound I make then clears his throat again."
    "Aures Catonis ad sonum meum moventur, deinde ille rursus fauces purgat."

# game/a1s2.rpy:1176
translate latin a1s2_1566c53f:

    # ca "\"Hello...[mc], was it? How are you enjoying your first day in the palace?\""
    ca "\"Salve...[mc] eras, nonne? Quomodo primus dies in palatio tibi placet?\""

# game/a1s2.rpy:1177
translate latin a1s2_4dc486e9:

    # "I wonder if I should keep droning, or if I should at least answer the question."
    "Quaero an murmurare pergam an saltem quaestioni respondere debeam."

# game/a1s2.rpy:1178
translate latin a1s2_1f486f77:

    # "I am technically a sapient, so I suppose it's okay if I sort of understand."
    "Proprie Sapientem me esse constat, itaque credo licere si aliquantum intellegam."

# game/a1s2.rpy:1179
translate latin a1s2_5355b285:

    # m "\"Uhhh...goood.\""
    m "\"Ehhh... beeene.\""

# game/a1s2.rpy:1180
translate latin a1s2_eeb39dae:

    # "The left side of Cato's scarred face twitches as he waits for more, but I don't give him anything."
    "Sinistrum latus vultus Catonis cicatricibus notati movetur dum plura exspectat, sed nihil ei do."

# game/a1s2.rpy:1182
translate latin a1s2_b147edb8:

    # ca "\"Good, good...I trust that Alexios showed you around the palace? It's a bit of a stifling life behind these walls, but hopefully with time we will be able to take you out to the city.\""
    ca "\"Bene, bene... credo Alexium te per palatium circumduxisse? Vita intra hos parietes aliquantum suffocans est, sed spero nos tempore te in urbem ducere posse.\""

# game/a1s2.rpy:1183
translate latin a1s2_af79f5dd:

    # "I cross my eyes a little."
    "Oculos paulum converto, quasi strabus sim."

# game/a1s2.rpy:1184
translate latin a1s2_807298db:

    # m "\"Oh...I like it...\""
    m "\"O... mihi placet...\""

# game/a1s2.rpy:1186
translate latin a1s2_fdd4e045:

    # ca "\"Heh, yes. So...where are you from again, exactly?\""
    ca "\"Heh, ita. Ergo... unde exacte venis, rursus dic mihi?\""

# game/a1s2.rpy:1187
translate latin a1s2_75430a35:

    # "There's something behind this wolf's words, something there that's a little more than innocent curiosity."
    "Aliquid sub verbis huius lupi latet, aliquid paulo plus quam curiositas innocens."

# game/a1s2.rpy:1188
translate latin a1s2_bdd11a48:

    # m "\"Uh, big rock planet by star...\""
    m "\"Eh, magnus lapideus planeta prope stellam...\""

# game/a1s2.rpy:1189
translate latin a1s2_28426738:

    # "Cato waits and again I don't say anything more."
    "Cato exspectat, et ego iterum nihil amplius dico."

# game/a1s2.rpy:1191
translate latin a1s2_e51bbb65:

    # ca "\"Do you have a name for the planet?\""
    ca "\"Nomen planetae habetis?\""

# game/a1s2.rpy:1192
translate latin a1s2_8869eeb4:

    # m "\"Yeah....Big Rock Planet.\""
    m "\"Ita... Magnus Planeta Lapideus.\""

# game/a1s2.rpy:1193
translate latin a1s2_dda95eca:

    # "Cato massages the left side of his forehead, looking a little bit annoyed."
    "Cato sinistrum frontis latus fricat, aliquantum irritatus."

# game/a1s2.rpy:1194
translate latin a1s2_b5a562b5:

    # ca "\"Big Rock Planet?\""
    ca "\"Magnus Planeta Lapideus?\""

# game/a1s2.rpy:1195
translate latin a1s2_a5eba605:

    # m "\"With water...\""
    m "\"Cum aqua...\""

# game/a1s2.rpy:1196
translate latin a1s2_829d69ab:

    # "Cato stares."
    "Cato intente aspicit."

# game/a1s2.rpy:1197
translate latin a1s2_55b6469d:

    # ca "\"So...Big Rock Planet With Water?\""
    ca "\"Ergo... Magnus Planeta Lapideus Cum Aqua?\""

# game/a1s2.rpy:1198
translate latin a1s2_30afb6b6:

    # "I nod dumbly."
    "Stulte annuo."

# game/a1s2.rpy:1200
translate latin a1s2_8ebb9a82:

    # "Cato sighs loudly and stalks off, not even bothering to end the conversation."
    "Cato clare suspirat et iratus abit, ne sermonem quidem finire curans."

# game/a1s2.rpy:1201
translate latin a1s2_d476e00e:

    # ca "\"Wonderful...now I have a headache.\""
    ca "\"Mirifice... iam caput mihi dolet.\""

# game/a1s2.rpy:1202
translate latin a1s2_21bdeddb:

    # "And with that, he disappears around the corner."
    "His dictis post angulum evanescit."

# game/a1s2.rpy:1203
translate latin a1s2_c521083d:

    # "I decide that I did an okay job as Cato seems to think that I'm a massive idiot."
    "Statuo me satis bene egisse, quoniam Cato me ingentem stultum putare videtur."

# game/a1s2.rpy:1205
translate latin a1s2_31151c4a:

    # "I make my way quickly to Amicus's room, glad to not run into anyone else."
    "Celeriter ad cubiculum Amici procedo, laetus quod nemo alius mihi occurrit."

# game/a1s2.rpy:1208
translate latin a1s2_211d7ec3:

    # "There isn't much to do; Amicus's room is spotless, so after meandering around and smoothing the bed covers over, I choose to sit down on the sofa and wait."
    "Non multum est faciendum: cubiculum Amici immaculatum est. Itaque postquam circum vagatus stragula lecti levigavi, in lecto recubitorio sedere et exspectare eligo."

# game/a1s2.rpy:1209
translate latin a1s2_0ddd9d39:

    # "Despite the fact that I've only been up for what's probably been ten hours, I'm exhausted."
    "Quamquam probabiliter tantum decem horas vigilavi, prorsus fessus sum."

# game/a1s2.rpy:1210
translate latin a1s2_7a67ea9c:

    # "Maybe I won't have any trouble adjusting to the shorter days."
    "Fortasse diebus brevioribus assuescere mihi minime difficile erit."

# game/a1s2.rpy:1211
translate latin a1s2_73e4b145:

    # "As I start to doze, there's a sudden clattering sound toward the door."
    "Dum dormitare incipio, subito prope ianuam strepitus crepitans auditur."

# game/a1s2.rpy:1212
translate latin a1s2_a420519d:

    # "I jump and see Amicus come in, wheeling in a tray with several plates on top of it, heaped high with food."
    "Subsilio et Amicum intrantem video, mensulam rotis instructam cum patellis cibo alte cumulatis impellentem."

# game/a1s2.rpy:1213
translate latin a1s2_3f7411bc:

    # "He grins at me and I get a feeling of relief at seeing him."
    "Mihi late arridet; eo viso levamen sentio."

# game/a1s2.rpy:1215
translate latin a1s2_60a46165:

    # a "\"Hello! Sorry, I suppose Alex didn't tell you that they set these outside the door on the 15th hour. He treat you well?\""
    a "\"Salve! Ignosce, credo Alex tibi non dixisse haec extra ianuam hora 15 poni. Bene te tractavit?\""

# game/a1s2.rpy:1216
translate latin a1s2_821479e2:

    # m "\"Yeah, he was nice.\""
    m "\"Ita, benignus erat.\""

# game/a1s2.rpy:1217
translate latin a1s2_960af5e1:

    # "Amicus wheels the cart up to the sofa, then flops back onto it next to me, making the whole thing shake."
    "Amicus mensulam ad lectum recubitorium impellit, tum iuxta me in eum recumbit, totum lectum quatiens."

# game/a1s2.rpy:1221
translate latin a1s2_57160742:

    # a "\"Uggghhhh, that was a long day.\""
    a "\"Uggghhhh, longus dies fuit.\""

# game/a1s2.rpy:1222
translate latin a1s2_994f6c7b:

    # m "\"Are you okay?\""
    m "\"Vales?\""

# game/a1s2.rpy:1223
translate latin a1s2_8e024646:

    # "Amicus opens one eye at me."
    "Amicus alterum oculum ad me aperit."

# game/a1s2.rpy:1224
translate latin a1s2_b0f1dcb9:

    # a "\"Barely. Had to go over maths today and my head feels as if it's going to explode. Didn't help that Balbus kept cracking me over the head with his stick when I answered wrong.\""
    a "\"Vix. Hodie mathematica repetere debui, et caput meum quasi dissiliat sentio. Nec profuit quod Balbus identidem baculo caput meum percutiebat cum male responderem.\""

# game/a1s2.rpy:1225
translate latin a1s2_8e8f54ba:

    # m "\"Wow, that sounds harsh.\""
    m "\"O, id durum videtur.\""

# game/a1s2.rpy:1227
translate latin a1s2_c16bf740:

    # a "\"Don't worry, it was nothing compared to the one you gave me.\""
    a "\"Noli sollicitus esse; nihil erat prae illo ictu quem tu mihi dedisti.\""

# game/a1s2.rpy:1228
translate latin a1s2_8d9fc9d0:

    # "Amicus smirks, and I can't help but smile back at his teasing."
    "Amicus subridet, et facere non possum quin ioco eius ego quoque arrideam."

# game/a1s2.rpy:1229
translate latin a1s2_b62e1276:

    # "He seems to have become more comfortable around me with how relaxed he is."
    "Iam commodius iuxta me se habere videtur, tam relaxatus est."

# game/a1s2.rpy:1230
translate latin a1s2_54534ed4:

    # m "\"I am sorry about that.\""
    m "\"Re vera me eius rei paenitet.\""

# game/a1s2.rpy:1232
translate latin a1s2_842df785:

    # a "\"Don't be, and stop apologizing for it. Now let's wash and eat. My stomach's felt hollow since breakfast.\""
    a "\"Ne te paeniteat, et desine eius rei veniam petere. Nunc lavemur et edamus. Venter meus ex ientaculo vacuus videtur.\""

# game/a1s2.rpy:1234
translate latin a1s2_1ba942ca:

    # "We both go to the restroom to rinse our paws/hands in the sink before heaping our plates with food."
    "Ambo ad balneum imus, ut manus eius measque in labro abluamus, antequam patellas nostras cibo cumulamus."

# game/a1s2.rpy:1235
translate latin a1s2_85fe1e8c:

    # "It's more of the same with bread and meat and olives, but there's also a good amount of other vegetables and fruit that I have a hard time identifying."
    "Plura eiusdem generis sunt: panis, caro olivaeque; sed etiam multa alia holera pomaque adsunt, quae aegre agnosco."

# game/a1s2.rpy:1236
translate latin a1s2_d8077a89:

    # "Amicus shows me how to combine the fruit and cheese on the bread and I find myself really starting to like the smelly spread...as long as I ignore the smell."
    "Amicus ostendit quomodo poma et caseum in pane coniungam; vere illud linimentum male olens mihi placere incipit... modo odorem neglegam."

# game/a1s2.rpy:1237
translate latin a1s2_c212bdbe:

    # "Compared to breakfast, Amicus really wolfs down a lot of food."
    "Ientaculo comparato, Amicus sane plurimum cibi vorat."

# game/a1s2.rpy:1238
translate latin a1s2_46e5e678:

    # "He probably ends up eating about three times as much as me."
    "Tandem probabiliter ter tantum quantum ego edit."

# game/a1s2.rpy:1239
translate latin a1s2_8b31963c:

    # "All the while, he tells me about his scary instructor and how he punishes him way more than Cassius."
    "Interea mihi narrat de praeceptore suo terribili et quomodo eum multo magis quam Cassium puniat."

# game/a1s2.rpy:1240
translate latin a1s2_9593aa52:

    # m "\"Well, does he usually get the answers right?\""
    m "\"Bene, ille plerumque recte respondet?\""

# game/a1s2.rpy:1242
translate latin a1s2_5bcb5137:

    # a "\"Well...yeah, but he should help me understand rather than smack my ears. That doesn't help anything unless he has the information in his stick and is bashing it into my brain somehow.\""
    a "\"Bene... ita, sed adiuvare me intellegere debet, non aures meas percutere. Id nihil prodest, nisi notitiam in baculo habet eamque nescio quomodo in cerebrum meum impellit.\""

# game/a1s2.rpy:1243
translate latin a1s2_1b6cab7b:

    # m "\"Don't worry; I hate math too.\""
    m "\"Noli sollicitus esse; ego quoque mathematica odi.\""

# game/a1s2.rpy:1244
translate latin a1s2_eabc578e:

    # a "\"Well, I'm better in other things like literature and history. Ha! Cassius is hopeless at remembering battles.\""
    a "\"Bene, aliis rebus peritior sum, velut litteris et historia. Ha! Cassius proelia meminisse omnino nescit.\""

# game/a1s2.rpy:1246
translate latin a1s2_45564791:

    # "Amicus flexes a bicep."
    "Amicus musculum bicipitem contrahit."

# game/a1s2.rpy:1247
translate latin a1s2_911f78fb:

    # a "\"And he can forget about wrestling. He could never beat me in a fight.\""
    a "\"Et luctationem oblivisci potest. Numquam me in pugna vinceret.\""

# game/a1s2.rpy:1248
translate latin a1s2_945448f8:

    # m "\"Yeah, I wouldn't think so.\""
    m "\"Ita, non putarem.\""

# game/a1s2.rpy:1250
translate latin a1s2_64b1ad54:

    # a "\"So yes, he can have the maths all he wants. The trials don't involve that anyway.\""
    a "\"Itaque sane mathematica sibi quantum vult habeat. Certamina tamen ea non complectuntur.\""

# game/a1s2.rpy:1251
translate latin a1s2_009937b3:

    # m "\"What are these trials you guys keep talking about?\""
    m "\"Quae sunt ista certamina de quibus identidem loquimini?\""

# game/a1s2.rpy:1252
translate latin a1s2_c2014a1e:

    # "Amicus takes a big gulp of wine, gasping when he finally pulls the goblet away from his face."
    "Amicus magnum vini haustum sumit, anhelans cum tandem calicem a facie removet."

# game/a1s2.rpy:1254
translate latin a1s2_d0322fc2:

    # a "\"What Cato is considering using to decide the next emperor. Essentially three trials; music and dance, rhetoric, and finally, combat.\""
    a "\"Quibus Cato uti deliberat ut proximum imperatorem eligat. Fere tria certamina: musica et saltatio, ars rhetorica, denique pugna.\""

# game/a1s2.rpy:1255
translate latin a1s2_2d3e5061:

    # m "\"And whoever wins those becomes emperor?\""
    m "\"Et qui vincit imperator fit?\""

# game/a1s2.rpy:1256
translate latin a1s2_946fc1ed:

    # a "\"Well, whoever wins two out of three. Combat is last so that if one of us wins the first two it won't come to that.\""
    a "\"Bene, qui duo ex tribus vincit. Pugna ultima est, ut, si alter nostrum prima duo vicerit, ad eam non veniatur.\""

# game/a1s2.rpy:1257
translate latin a1s2_45f57007:

    # a "\"I'm really just hoping that Cato chooses me in the next few days now that he's seen you. But if the trials do happen, you have nothing to worry about.\""
    a "\"Re vera tantum spero Catonem me intra paucos dies proximos electurum, iam te viso. Sed, si certamina fiant, nihil tibi timendum est.\""

# game/a1s2.rpy:1258
translate latin a1s2_19b09768:

    # "Amicus grins at me confidently."
    "Amicus confidenter mihi arridet."

# game/a1s2.rpy:1259
translate latin a1s2_d383f180:

    # m "\"I don't?\""
    m "\"Non habeo?\""

# game/a1s2.rpy:1261
translate latin a1s2_4356dda9:

    # a "\"I'm better than Cassius in at least two of those things, perhaps even in music and dance.\""
    a "\"Saltem duabus earum artium Cassio praesto, fortasse etiam musica et saltatione.\""

# game/a1s2.rpy:1262
translate latin a1s2_3a87e188:

    # m "\"You know, I'd believe you, but one thing I know about you is how, um...overly confident you are when it comes to certain things.\""
    m "\"Scis, tibi crederem, sed unum de te novi: quam, eh... nimium tibi confidas in quibusdam rebus.\""

# game/a1s2.rpy:1264
translate latin a1s2_90dcf11c:

    # a "\"Why do you say that?\""
    a "\"Cur id dicis?\""

# game/a1s2.rpy:1265
translate latin a1s2_d375f87e:

    # m "\"Our entire experience on the ship, maybe?\""
    m "\"Fortasse propter omnia quae in nave acciderunt?\""

# game/a1s2.rpy:1267
translate latin a1s2_7d52f1ff:

    # a "\"That's...different. I was doing something I didn't really understand. I understand my studies...aside from maths.\""
    a "\"Id... aliud est. Aliquid faciebam quod non re vera intellegebam. Studia mea intellego... praeter mathematica.\""

# game/a1s2.rpy:1268
translate latin a1s2_9721d4da:

    # "Amicus leans back finally, one paw on his stomach."
    "Amicus tandem reclinatur, una manu super ventrem posita."

# game/a1s2.rpy:1270
translate latin a1s2_e8f41995:

    # a "\"Anyway, how was your day? Did Alex show you around?\""
    a "\"Utut est, qualis tibi dies fuit? Alex te circumduxit?\""

# game/a1s2.rpy:1271
translate latin a1s2_0e02ba13:

    # "Amicus starts to grab the remaining food to set aside on its own plate."
    "Amicus reliquum cibum capere incipit, ut in patella separata reponat."

# game/a1s2.rpy:1272
translate latin a1s2_e3129f8c:

    # m "\"Yeah. I've realized that there isn't much to do.\""
    m "\"Ita. Intellexi non multum esse faciendum.\""

# game/a1s2.rpy:1273
translate latin a1s2_6e1fc375:

    # a "\"Ah, yeah, it was a bit of a bad day. I have tomorrow off from studies though, so we can do something entertaining.\""
    a "\"Ah, ita, hodie aliquantum infelix tempus fuit. Cras tamen a studiis liber sum, itaque aliquid iucundum facere possumus.\""

# game/a1s2.rpy:1274
translate latin a1s2_20defb42:

    # m "\"Like what?\""
    m "\"Quid, exempli gratia?\""

# game/a1s2.rpy:1276
translate latin a1s2_ce41f054:

    # a "\"Oh, I don't know. Go swimming, go to the baths, talk. You name it. Maybe eventually we can go to the city too.\""
    a "\"O, nescio. Natare, ad balnea ire, loqui. Quidquid vis. Fortasse aliquando in urbem quoque ire possumus.\""

# game/a1s2.rpy:1277
translate latin a1s2_0f029412:

    # m "\"The city outside?\""
    m "\"Urbem foris?\""

# game/a1s2.rpy:1279
translate latin a1s2_766a5398:

    # a "\"Well, everything's outside.\""
    a "\"Bene, omnia foris sunt.\""

# game/a1s2.rpy:1280
translate latin a1s2_64865567:

    # m "\"I mean, the one that I can see across the lake.\""
    m "\"Illam dico quam trans lacum videre possum.\""

# game/a1s2.rpy:1281
translate latin a1s2_0535cdf3:

    # a "\"Yes, that one. Adastra city, the capital of our empire.\""
    a "\"Ita, illam. Urbem Adastram, caput imperii nostri.\""

# game/a1s2.rpy:1282
translate latin a1s2_f1d87d0f:

    # m "\"Oh...isn't it kind of small for that? I mean, it looks really nice, but it kind of just looks like an average-sized city.\""
    m "\"O... nonne ad id aliquantum parva est? Scilicet valde pulchra videtur, sed quasi urbs mediocris magnitudinis tantum videtur.\""

# game/a1s2.rpy:1283
translate latin a1s2_e0a11c00:

    # "Amicus frowns."
    "Amicus frontem corrugat."

# game/a1s2.rpy:1285
translate latin a1s2_5cc395ef:

    # a "\"I think it's quite large. How big are cities on Earth?\""
    a "\"Puto eam satis magnam esse. Quam magnae sunt urbes in Terra?\""

# game/a1s2.rpy:1286
translate latin a1s2_8619f2c6_1:

    # "I shrug."
    "Umeros tollo."

# game/a1s2.rpy:1287
translate latin a1s2_fb2014a1:

    # m "\"I dunno, pretty big? Millions of people.\""
    m "\"Nescio, satis magnae? Miliones hominum.\""

# game/a1s2.rpy:1288
translate latin a1s2_d72f068f:

    # "Amicus raises an eyebrow."
    "Amicus supercilium tollit."

# game/a1s2.rpy:1290
translate latin a1s2_9ab32876:

    # a "\"Millions?\""
    a "\"Miliones?\""

# game/a1s2.rpy:1291
translate latin a1s2_7d1f6ae1:

    # m "\"Uh, yeah.\""
    m "\"Eh, ita.\""

# game/a1s2.rpy:1292
translate latin a1s2_eb2bd6a4:

    # "I wonder if the Lingua is translating everything correctly."
    "Quaero an Lingua omnia recte vertat."

# game/a1s2.rpy:1293
translate latin a1s2_b4647cc4:

    # m "\"Why? How big is Adastra?\""
    m "\"Cur? Quam magna Adastra est?\""

# game/a1s2.rpy:1294
translate latin a1s2_6bf0b8c4:

    # a "\"The city? Just over five million. The Wolf population is 80 million.\""
    a "\"Urbs? Paulo plus quinque miliones. Luporum multitudo 80 miliones est.\""

# game/a1s2.rpy:1295
translate latin a1s2_2d6ee573_2:

    # m "\"Oh.\""
    m "\"O.\""

# game/a1s2.rpy:1296
translate latin a1s2_8c68dece:

    # a "\"How many humans are there?\""
    a "\"Quot homines sunt?\""

# game/a1s2.rpy:1297
translate latin a1s2_ab5ee15b:

    # m "\"Like, seven billion.\""
    m "\"Circiter septem milia milionum.\""

# game/a1s2.rpy:1299
translate latin a1s2_ff7d4933:

    # "Amicus chokes."
    "Amicus suffocatur."

# game/a1s2.rpy:1300
translate latin a1s2_946a040d:

    # a "\"What!?\""
    a "\"Quid!?\""

# game/a1s2.rpy:1301
translate latin a1s2_54cbc9c0:

    # m "\"Is that a lot?\""
    m "\"Multum est?\""

# game/a1s2.rpy:1303
translate latin a1s2_4cbcc7b7:

    # a "\"That's preposterous! Do you not have population control measures put in place?\""
    a "\"Absurdum est! Nonne consilia ad numerum incolarum temperandum constituta habetis?\""

# game/a1s2.rpy:1304
translate latin a1s2_f225d6f0:

    # m "\"Well, not in most places.\""
    m "\"Bene, non in plerisque locis.\""

# game/a1s2.rpy:1305
translate latin a1s2_3122b23f:

    # "Amicus shakes his head."
    "Amicus caput quatit."

# game/a1s2.rpy:1307
translate latin a1s2_b3d044b9:

    # a "\"Well, you are Parent-less, so I guess it makes sense your species might be so...misguided?\""
    a "\"Bene, Parentibus caretis; itaque credo rationem habere quod species vestra tam... errans esse possit?\""

# game/a1s2.rpy:1308
translate latin a1s2_78c74b2a:

    # "Amicus seems to try very hard to choose the last word even though he's still being very condescending."
    "Amicus ultimum verbum diligentissime eligere conari videtur, quamquam adhuc me valde despicit."

# game/a1s2.rpy:1309
translate latin a1s2_93dae0df:

    # "He seems to notice my annoyance, though."
    "Irritationem tamen meam animadvertere videtur."

# game/a1s2.rpy:1310
translate latin a1s2_f058c007:

    # a "\"Well, is your species doing well? Is your planet able to sustain such a population?\""
    a "\"Bene, species tua bene se habet? Planeta tuus tantam multitudinem sustinere potest?\""

# game/a1s2.rpy:1311
translate latin a1s2_45297acc:

    # m "\"...Sort of. I guess there are problems.\""
    m "\"...Quodammodo. Credo difficultates esse.\""

# game/a1s2.rpy:1312
translate latin a1s2_75935e50:

    # "Amicus strokes his chin."
    "Amicus mentum mulcet."

# game/a1s2.rpy:1313
translate latin a1s2_3d50fd7d:

    # a "\"Well, I suppose when I become emperor I could ask the Parent about your species. The whole thing is a real mystery, but it's clear that we must have overlooked your people somehow.\""
    a "\"Bene, credo me, cum imperator factus ero, Parentem de specie tua rogare posse. Tota res vere obscura est, sed constat nos gentem tuam nescio quomodo neglexisse.\""

# game/a1s2.rpy:1315
translate latin a1s2_513a3f23:

    # "He smiles at me."
    "Mihi subridet."

# game/a1s2.rpy:1316
translate latin a1s2_1033c97c:

    # a "\"Maybe we could even bring you into our fold again!\""
    a "\"Fortasse etiam in communionem nostram vos rursus recipere possimus!\""

# game/a1s2.rpy:1317
translate latin a1s2_e06843d3:

    # m "\"Whoa, hang on a second.\""
    m "\"Heus, paulisper exspecta.\""

# game/a1s2.rpy:1318
translate latin a1s2_0d61e198:

    # "Images of roman spaceships descending from the heavens to enslave the human race all because of me flash through my mind."
    "Imagines navium spatialium Romanarum e caelo descendentium ut genus humanum in servitutem redigant, totum propter me, per animum meum fulgurant."

# game/a1s2.rpy:1319
translate latin a1s2_59c4c81f:

    # m "\"You know, Alex told me about what you do to the other sapients. It doesn't sound like something humans would want to be a part of.\""
    m "\"Scis, Alex mihi dixit quid ceteris Sapientibus faciatis. Non videtur res cuius homines participes esse velint.\""

# game/a1s2.rpy:1321
translate latin a1s2_297fcc3e:

    # a "\"What did he tell you?\""
    a "\"Quid tibi dixit?\""

# game/a1s2.rpy:1322
translate latin a1s2_e342b0b6:

    # m "\"The whole enslavement thing.\""
    m "\"Totam illam in servitutem redigendi rationem.\""

# game/a1s2.rpy:1323
translate latin a1s2_e0cc054a:

    # a "\"Enslavement?\""
    a "\"In servitutem redigendi?\""

# game/a1s2.rpy:1324
translate latin a1s2_162f2fd8:

    # m "\"What you do to your Children.\""
    m "\"Quod Liberis vestris facitis.\""

# game/a1s2.rpy:1325
translate latin a1s2_a2c1c5d1:

    # a "\"Well...that's a harsh word for it.\""
    a "\"Bene... durum verbum est ad eam rem.\""

# game/a1s2.rpy:1326
translate latin a1s2_29b081bb:

    # m "\"No, it's the right word. Humans have done the whole 'indentured servant' thing back on Earth, and it never turned out well for the 'servant'.\""
    m "\"Non, rectum verbum est. Homines in Terra totam illam rationem 'servi ex pacto' experti sunt, neque umquam bene 'servo' evenit.\""

# game/a1s2.rpy:1327
translate latin a1s2_22372221:

    # "Amicus's ears go down a bit."
    "Aures Amici paulum demittuntur."

# game/a1s2.rpy:1328
translate latin a1s2_85f23be3:

    # m "\"And as misguided as humans might be, we've at least abolished slavery.\""
    m "\"Et quantumvis homines a recta via aberrent, saltem servitutem sustulimus.\""

# game/a1s2.rpy:1329
translate latin a1s2_d503dfa0:

    # "I notice Amicus's ears turning red."
    "Aures Amici rubescere animadverto."

# game/a1s2.rpy:1330
translate latin a1s2_0268013b:

    # "Maybe he never expected to be lectured on ethics by a human."
    "Fortasse numquam exspectavit se ab homine de moribus doceri."

# game/a1s2.rpy:1331
translate latin a1s2_585945a6:

    # a "\"Ah, well, I—I do mean to change things a bit when I become emperor.\""
    a "\"Ah, bene, ego—ego sane res paulum mutare intendo cum imperator factus ero.\""

# game/a1s2.rpy:1332
translate latin a1s2_41354dc7:

    # m "\"A bit?\""
    m "\"Paulum?\""

# game/a1s2.rpy:1334
translate latin a1s2_e8c88c63:

    # a "\"I mean, things can't just be changed all at once; it has to be gradual.\""
    a "\"Scilicet, omnia simul mutari non possunt; paulatim fieri debet.\""

# game/a1s2.rpy:1335
translate latin a1s2_95283c70:

    # m "\"Hm.\""
    m "\"Hm.\""

# game/a1s2.rpy:1337
translate latin a1s2_f58fca45:

    # "Amicus flicks his tail in annoyance at me."
    "Amicus caudam irritatus ad me movet."

# game/a1s2.rpy:1338
translate latin a1s2_7d45a625:

    # a "\"Listen, I agree with you. We've been trying to change the way we've treated our Children for generations. My grandfather and father both worked towards this.\""
    a "\"Audi: tibi assentior. Iam per multas aetates rationem qua Liberos nostros tractavimus mutare conamur. Avus meus et pater meus ambo ad hoc laboraverunt.\""

# game/a1s2.rpy:1339
translate latin a1s2_b9dae068:

    # m "\"Well, while that's messed up and definitely wrong, I think the intelligence thing might be even worse.\""
    m "\"Bene, quamquam id pravum et certe iniustum est, puto rem intelligentiae etiam peiorem esse posse.\""

# game/a1s2.rpy:1341
translate latin a1s2_e18572b7:

    # a "\"What intelligence thing?\""
    a "\"Quam rem intelligentiae?\""

# game/a1s2.rpy:1342
translate latin a1s2_5baa84ca:

    # "The grimace on Amicus's face tells me that he might already know the answer."
    "Contractus vultus Amici ostendit eum fortasse responsum iam scire."

# game/a1s2.rpy:1343
translate latin a1s2_99a6b5e5:

    # m "\"The way you stunted intelligence in the Children you uplifted.\""
    m "\"Quomodo progressum intelligentiae in Liberis quos ad altiorem cultum provexistis cohibuistis.\""

# game/a1s2.rpy:1344
translate latin a1s2_fddd570b:

    # "Amicus is silent for a moment."
    "Amicus paulisper tacet."

# game/a1s2.rpy:1345
translate latin a1s2_64f9b663:

    # "I can tell that all of this is making him very uncomfortable."
    "Intellego haec omnia eum valde perturbare."

# game/a1s2.rpy:1346
translate latin a1s2_e642e719:

    # "I have to ask myself again how I got to this point; sitting on a sofa debating ethics with a prospective emperor wolf"
    "Iterum mihi quaerendum est quomodo ad hunc locum venerim: in lecto recubitorio sedens de moribus cum lupo qui imperator fieri possit disputo"

# game/a1s2.rpy:1347
translate latin a1s2_32498308:

    # "He finally folds his arms and huffs."
    "Tandem bracchia complicat et fremit."

# game/a1s2.rpy:1349
translate latin a1s2_5d5947dd:

    # a "\"Again, I agree with you on all of this. I don't like the way we've treated our Children. In the end I truly feel that becoming a more compassionate and united empire will lead to a better outcome for everyone.\""
    a "\"Iterum dico me in omnibus his tibi assentiri. Non mihi placet quomodo Liberos nostros tractavimus. Denique vere credo imperium clementius et coniunctius omnibus melius eventurum.\""

# game/a1s2.rpy:1350
translate latin a1s2_d232aa6b:

    # a "\"It's going to take small steps, but understand that it's something I mean to fix.\""
    a "\"Parvis gradibus fiet, sed intellege id esse quod corrigere intendo.\""

# game/a1s2.rpy:1351
translate latin a1s2_9c6ecaff:

    # a "\"And stop saying \"you\" like {i}I{/i} did it. I was born into this.\""
    a "\"Et desine \"vos\" dicere quasi {i}ego{/i} fecerim. In hac condicione natus sum.\""

# game/a1s2.rpy:1352
translate latin a1s2_e4ce469c:

    # "I've come to realize how much of an open book Amicus is as a person, so I don't doubt his words."
    "Iam intellexi quam apertus Amicus ut persona sit, itaque verbis eius non diffido."

# game/a1s2.rpy:1353
translate latin a1s2_60f63dcc:

    # m "\"Well, as long as Cassius doesn't become emperor.\""
    m "\"Bene, modo Cassius imperator non fiat.\""

# game/a1s2.rpy:1354
translate latin a1s2_3d26ee22:

    # "Amicus snorts."
    "Amicus naribus fremit."

# game/a1s2.rpy:1355
translate latin a1s2_7b1d242b:

    # a "\"Not a chance.\""
    a "\"Fieri non potest.\""

# game/a1s2.rpy:1356
translate latin a1s2_2643cc57:

    # m "\"Well, if he DOES it sounds like he's going to reverse all of that.\""
    m "\"Bene, si FIT, omnia illa revocaturus videtur.\""

# game/a1s2.rpy:1357
translate latin a1s2_aa278c36:

    # a "\"And I'm saying there's no chance of it...Wait, how much has Alex been telling you?\""
    a "\"Et dico fieri non posse... exspecta, quantum Alex tibi dixit?\""

# game/a1s2.rpy:1358
translate latin a1s2_b26b8f67:

    # m "\"It was a short conversation. I asked him about the empire.\""
    m "\"Brevis sermo fuit. Eum de imperio rogavi.\""

# game/a1s2.rpy:1359
translate latin a1s2_9cc70cbf:

    # "I didn't, but I don't want to get Alex in trouble in case he wasn't just supposed to tell me."
    "Non rogavi, sed Alex in difficultatem adducere nolo, si fortasse mihi simpliciter dicere non debuit."

# game/a1s2.rpy:1360
translate latin a1s2_e32c6eaa:

    # m "\"Cassius seems like a terrible person by the way, and I'm not just talking about his personality. He wants to keep people enslaved.\""
    m "\"Ceterum Cassius persona terribilis videtur; non tantum de ingenio eius loquor. Alios in servitute retinere vult.\""

# game/a1s2.rpy:1362
translate latin a1s2_1d27e59b:

    # a "\"It's...complicated. He's just very traditional, but again, there's no chance.\""
    a "\"Res... implicata est. Tantum veterum morum tenacissimus est; sed iterum dico fieri non posse.\""

# game/a1s2.rpy:1363
translate latin a1s2_67e428d4:

    # "I sigh at the wolf's overconfidence, but he does know his brother far better than I do."
    "Suspiro quod lupus nimis sibi confidit, sed fratrem suum multo melius quam ego novit."

# game/a1s2.rpy:1364
translate latin a1s2_3b2cd58c:

    # m "\"Well, I'm at least glad that I'm behind the right wolf in getting myself home.\""
    m "\"Bene, saltem gaudeo me recto lupo favere, dum domum redire conor.\""

# game/a1s2.rpy:1366
translate latin a1s2_a37c35e8:

    # a "\"The right wolf?\""
    a "\"Recto lupo?\""

# game/a1s2.rpy:1367
translate latin a1s2_e1d72bd6:

    # m "\"Yeah, I can't imagine being under your brother.\""
    m "\"Ita, fingere non possum me sub potestate fratris tui esse.\""

# game/a1s2.rpy:1368
translate latin a1s2_efd7db80:

    # "Amicus glances at the plate he'd been building with food."
    "Amicus patellam aspicit quam cibo instruebat."

# game/a1s2.rpy:1369
translate latin a1s2_b37d97b8:

    # a "\"Speaking of, I'm going to bring this to Alex in the garden. Did you want to accompany me?\""
    a "\"De quo loquentes, hoc Alex in horto feram. Visne mecum venire?\""

# game/a1s2.rpy:1370
translate latin a1s2_83f9967a:

    # "I run a hand through my hair, feeling the griminess from two days of no shower."
    "Manum per capillos duco, sordes post duos dies sine lavatione sentiens."

# game/a1s2.rpy:1371
translate latin a1s2_9ae1bebf:

    # m "\"Actually, can I use the shower while you're gone? I feel kind of gross.\""
    m "\"Re vera, possumne sub imbre lavari dum abes? Aliquantum sordidus me sentio.\""

# game/a1s2.rpy:1372
translate latin a1s2_b9291c0a:

    # a "\"Oh yeah, sure. Uh, just step in and it starts up. There's a screen on the wall that controls temperature. It has a color spectrum that you can drag a finger across—\""
    a "\"O, ita, certe. Eh, tantum intra et incipit. Tabula visualis in pariete est qua calor moderatur. Spectrum colorum habet per quod digitum trahere potes—\""

# game/a1s2.rpy:1373
translate latin a1s2_a8e7ff93:

    # m "\"I'll figure it out.\""
    m "\"Ipse inveniam.\""

# game/a1s2.rpy:1375
translate latin a1s2_2ccc4927:

    # a "\"Ah, right. Well, I should be back by the time you're finished.\""
    a "\"Ah, recte. Bene, ego iam rediisse debebo cum perfeceris.\""

# game/a1s2.rpy:1378
translate latin a1s2_bebc03b1:

    # "And with that, Amicus balances his plate of food in his paws as he strides out of the room, leaving me to go into the bathroom."
    "His dictis Amicus patellam cibi in manibus librat et e cubiculo magnis passibus exit, dum ego in balneum eo."

# game/a1s2.rpy:1380
translate latin a1s2_1974a40f:

    # "I quickly use the toilet again, suddenly glad that I don't have to use a \"public\" toilet like the ones I'd seen drawings of in my Roman history books."
    "Celeriter latrina iterum utor, subito gaudens mihi non esse utendum latrina \"publica\" qualium picturas in libris historiae Romanae videram."

# game/a1s2.rpy:1381
translate latin a1s2_0df79a94:

    # "The shower is easy enough to understand, and the water is immediately warm and pleasant, so I don't have to bother with the temperature."
    "Imbrem satis facile intellego, et aqua statim calida iucundaque est; itaque calorem moderari non debeo."

# game/a1s2.rpy:1382
translate latin a1s2_922c5928:

    # "There are several glass bottles of soap, so I choose the one that smells the best and give myself a quick wash."
    "Aliquot ampullae vitreae saponis sunt; itaque eam eligo quae suavissime olet et celeriter me lavo."

# game/a1s2.rpy:1383
translate latin a1s2_2807a82d:

    # "When I'm done, I grab a towel off the wall and dry off before wrapping it around my waist."
    "Cum perfeci, linteum e pariete capio et me sicco, antequam circa lumbos meos circumdo."

# game/a1s2.rpy:1384
translate latin a1s2_e31caa1a:

    # "I think about putting my clothes back on, but the idea of stepping back into that underwear has me hesitating."
    "Cogito vestes meas rursus induere, sed in easdem vestes interiores reverti cogitans haesito."

# game/a1s2.rpy:1386
translate latin a1s2_568a0af8:

    # "Instead, I open the door and am greeted to the sight of Amicus sitting on the edge of the bed, looking off to the side, a paw in his lap holding a brush."
    "Potius ianuam aperio et Amicum in margine lecti sedentem video, ad latus spectantem, manu in gremio peniculum tenente."

# game/a1s2.rpy:1387
translate latin a1s2_519428b0:

    # "His head snaps in my direction before he immediately averts his eyes."
    "Caput subito ad me vertit, deinde statim oculos avertit."

# game/a1s2.rpy:1390
translate latin a1s2_112cc59e:

    # a "\"Sorry! Sorry! I didn't mean to see, I thought you'd be dressed—\""
    a "\"Ignosce! Ignosce! Non videre volui; te vestitum fore putabam—\""

# game/a1s2.rpy:1391
translate latin a1s2_e856f8e5:

    # m "\"Hey, it's fine. I've got the towel on.\""
    m "\"Heus, nihil est. Linteo tectus sum.\""

# game/a1s2.rpy:1393
translate latin a1s2_d5c3c29e:

    # "Slowly, Amicus turns his gaze back to me, eyes drifting down my torso before immediately snapping back up again."
    "Lente Amicus rursus me aspicit; oculi per truncum corporis mei descendunt, deinde statim sursum redeunt."

# game/a1s2.rpy:1394
translate latin a1s2_c6e1ba8a:

    # a "\"Oh! Uh, I thought you hated any sort of nudity?\""
    a "\"O! Eh, putabam te omnem nuditatem odisse?\""

# game/a1s2.rpy:1395
translate latin a1s2_34c2370e:

    # m "\"Not really, just the...genitals. Even then, I don't hate it. It's just...more private.\""
    m "\"Non sane, tantum... genitalia. Etiam ea non odi. Tantum... magis privata sunt.\""

# game/a1s2.rpy:1396
translate latin a1s2_c2f7d8b7:

    # a "\"Ah...\""
    a "\"Ah...\""

# game/a1s2.rpy:1397
translate latin a1s2_141dc44d:

    # "Amicus seems to be staring at me and I start to feel a little self-conscious."
    "Amicus me intente aspicere videtur, et aliquantum pudere me incipit."

# game/a1s2.rpy:1398
translate latin a1s2_622cf053:

    # m "\"Is everything okay?\""
    m "\"Omnia bene se habent?\""

# game/a1s2.rpy:1400
translate latin a1s2_bb93de92:

    # "Amicus looks away again."
    "Amicus oculos iterum avertit."

# game/a1s2.rpy:1401
translate latin a1s2_f4241193:

    # a "\"Sorry, I—I'm just not used to seeing you like that. I've only seen humans with clothing, so I just sort of imagined you to always be that way.\""
    a "\"Ignosce, ego—non soleo te ita videre. Homines tantum vestitos vidi, itaque quodammodo semper tales esse te fingebam.\""

# game/a1s2.rpy:1402
translate latin a1s2_fe053ea6:

    # m "\"Well...my clothes are dirty so I was going to ask you about maybe getting some clean ones, at least until you can get me that tailor?\""
    m "\"Bene... vestes meae sordidae sunt; itaque te rogare volebam an mundas accipere possem, saltem donec illum sartorem mihi arcessas?\""

# game/a1s2.rpy:1404
translate latin a1s2_60b31c75:

    # a "\"Oh, of course! Com! Send us some robes from storage...children's robes, please.\""
    a "\"O, certe! Com! Aliquot tunicas e conditorio mitte... tunicas pueriles, quaeso.\""

# game/a1s2.rpy:1405
translate latin a1s2_80ed182b:

    # com "\"Yes, Amicus.\""
    com "\"Ita, Amice.\""

# game/a1s2.rpy:1406
translate latin a1s2_1dfc7b4e:

    # m "\"Thanks.\""
    m "\"Gratias.\""

# game/a1s2.rpy:1408
translate latin a1s2_d098c481_1:

    # a "\"Of course.\""
    a "\"Certe.\""

# game/a1s2.rpy:1409
translate latin a1s2_c8dab678:

    # "I stand there awkwardly for another few seconds until Amicus seems to snap back to reality again."
    "Aliquot secundas iterum incommodus ibi sto, donec Amicus quasi rursus ad rem praesentem redit."

# game/a1s2.rpy:1411
translate latin a1s2_b28f051a:

    # "He holds up the brush."
    "Peniculum tollit."

# game/a1s2.rpy:1413
translate latin a1s2_af88cfbc:

    # a "\"Anyway, I thought maybe you'd like to be groomed too? I feel it's only fair after what you did for me.\""
    a "\"Utut est, cogitabam fortasse te quoque pecti velle? Aequum tantum puto post id quod mihi fecisti.\""

# game/a1s2.rpy:1414
translate latin a1s2_5b16e983:

    # m "\"Oh, well, it's only on my head.\""
    m "\"O, bene, tantum in capite pilos habeo.\""

# game/a1s2.rpy:1416
translate latin a1s2_3578b807:

    # a "\"All the easier for me, then.\""
    a "\"Tum mihi eo facilius.\""

# game/a1s2.rpy:1417
translate latin a1s2_ef76e4fb:

    # "Amicus grins."
    "Amicus late arridet."

# game/a1s2.rpy:1418
translate latin a1s2_6f0215a6:

    # m "\"Well...alright.\""
    m "\"Bene... fiat.\""

# game/a1s2.rpy:1420
translate latin a1s2_8ef74f2b:

    # "I walk over to the bed and sit with my back to the wolf."
    "Ad lectum accedo et dorso ad lupum verso consido."

# game/a1s2.rpy:1421
translate latin a1s2_f865b33a:

    # "Amicus adjusts his seating to face me more directly, then starts to run the brush gently through my hair."
    "Amicus sedem suam aptat ut rectius ad me conversus sit, deinde peniculum leniter per capillos meos ducere incipit."

# game/a1s2.rpy:1422
translate latin a1s2_5f3bf54c:

    # "We sit in silence for a bit, and I start to enjoy the feeling of the brushing especially the way the firm bristles run across my scalp, giving me shivers up and down my neck."
    "Paulisper taciti sedemus; sensu pectendi frui incipio, praesertim cum firmae setae per cutem capitis currunt et tremores per collum sursum deorsum mihi movent."

# game/a1s2.rpy:1424
translate latin a1s2_a68f716a:

    # a "\"Sorry for talking so much earlier. I...I'm not used to being able to talk to someone. The palace is a bit lonely, so having a friendly conversation with someone other than Com is a bit of a novelty.\""
    a "\"Ignosce quod antea tam multa dixi. Ego... non soleo cum aliquo loqui posse. Palatium aliquantum solitarium est; itaque amice cum aliquo praeter Com colloqui res nova est.\""

# game/a1s2.rpy:1426
translate latin a1s2_292c202c_1:

    # "Amicus chuckles."
    "Amicus leniter ridet."

# game/a1s2.rpy:1427
translate latin a1s2_bd1efd7a:

    # a "\"That was probably why I was having so much trouble focusing on my studies today; I was so excited to come back home and speak with you.\""
    a "\"Fortasse ideo hodie animum studiis intendere tam difficile mihi erat: tam cupiebam domum redire et tecum loqui.\""

# game/a1s2.rpy:1428
translate latin a1s2_e384c613:

    # "Hearing that makes me feel a little bad for the wolf."
    "His auditis aliquantum lupi miseret me."

# game/a1s2.rpy:1429
translate latin a1s2_49df8019:

    # "I suppose being the prospective emperor doesn't allow you to have many friends, and being in such an empty palace definitely seems lonesome."
    "Credo eum qui imperator fieri possit multos amicos habere non posse, atque in tam vacuo palatio esse sane solitarium videtur."

# game/a1s2.rpy:1430
translate latin a1s2_3a577f75:

    # "I guess this is why Alex told me basically the same thing."
    "Credo ideo Alex fere idem mihi dixisse."

# game/a1s2.rpy:1431
translate latin a1s2_b863eb08:

    # m "\"You're fine. And I didn't mean to be too harsh earlier. I know it's not your fault.\""
    m "\"Nihil mali facis. Neque antea nimis durus esse volui. Scio non tuam culpam esse.\""

# game/a1s2.rpy:1433
translate latin a1s2_f8d5df02:

    # a "\"No, I think we're on the same page on that one. All the more reason to unite against Cassius, eh? Oh!\""
    a "\"Non, puto nos de ea re consentire. Eo magis contra Cassium coniungi debemus, eh? O!\""

# game/a1s2.rpy:1434
translate latin a1s2_02ac4082:

    # "As if he'd forgotten something, Amicus's other paw comes around my side and on his palm I see two purple grapes."
    "Quasi aliquid oblitus sit, altera manus Amici circa latus meum venit; in palma duas uvas purpureas video."

# game/a1s2.rpy:1436
translate latin a1s2_0dbb0ef2:

    # a "\"I managed to snatch a few of those off of Alexios's earring. He wasn't too happy about that, haha! Want one?\""
    a "\"Aliquot ex inauri Alexii rapere potui. Non valde eo laetatus est, haha! Vis unam?\""

# game/a1s2.rpy:1437
translate latin a1s2_1cdd7b14_1:

    # m "\"Seriously?\""
    m "\"Serio?\""

# game/a1s2.rpy:1438
translate latin a1s2_819cc8b4:

    # "I take one, more out of being nice to Amicus than anything, but when I bite into it, I can't help but notice how juicy and sweet it is."
    "Unam capio, potius ut Amico comis sim quam alia de causa; sed cum mordeo, animadvertere cogor quam suculenta dulcisque sit."

# game/a1s2.rpy:1440
translate latin a1s2_036aaf99:

    # "Amicus talks to me with the grape in his mouth."
    "Amicus uva in ore posita mecum loquitur."

# game/a1s2.rpy:1441
translate latin a1s2_efd14536:

    # a "\"Mmmh, I don't know why, but his grape earring always tastes the best. By the way, if you don't mind, I invited Alex to our outing tomorrow.\""
    a "\"Mmmh, nescio cur, sed inauris eius uvis facta semper suavissime sapit. Ceterum, si tibi non molestum est, Alex ad excursionem nostram crastinam invitavi.\""

# game/a1s2.rpy:1443
translate latin a1s2_df86aa6d:

    # a "\"Cassius is going to be away to do some speeches and is leaving Alex behind for once.\""
    a "\"Cassius orationes aliquot habiturus aberit, et Alex semel domi relinquet.\""

# game/a1s2.rpy:1444
translate latin a1s2_9274fa7a:

    # m "\"Of course not. We got along really well.\""
    m "\"Certe non molestum est. Optime inter nos convenit.\""

# game/a1s2.rpy:1445
translate latin a1s2_c031109e:

    # "I lean my head back, allowing the wolf to continue the brushing."
    "Caput reclino, sinens lupum pectere pergere."

# game/a1s2.rpy:1446
translate latin a1s2_168531ba:

    # a "\"Your fur...hair, you call it? It's not like a wolf's fur, but it's rather nice.\""
    a "\"Pili tui... capilli, ita eos appellas? Non sunt sicut pili lupi, sed satis suaves sunt.\""

# game/a1s2.rpy:1447
translate latin a1s2_ad10a89a:

    # "I smile."
    "Arrideo."

# game/a1s2.rpy:1448
translate latin a1s2_b4bc3da3:

    # m "\"Thank you, Amicus.\""
    m "\"Gratias tibi ago, Amice.\""

# game/a1s2.rpy:1449
translate latin a1s2_f7bd3374:

    # a "\"If you'd like, I can do this for you everyday. I feel that's fair.\""
    a "\"Si vis, hoc tibi cotidie facere possum. Id aequum puto.\""

# game/a1s2.rpy:1450
translate latin a1s2_c085982d:

    # "I have to admit that I really like this, so I accept."
    "Confiteri debeo hoc mihi valde placere, itaque consentio."

# game/a1s2.rpy:1451
translate latin a1s2_012ca863:

    # m "\"Yeah, sure. It feels really nice.\""
    m "\"Ita, certe. Valde suave est.\""

# game/a1s2.rpy:1452
translate latin a1s2_1eac73d2:

    # "I hear some thumping sounds and I imagine it's Amicus's tail wagging against the bed."
    "Aliquot ictus audio et fingo caudam Amici contra lectum moveri."

# game/a1s2.rpy:1453
translate latin a1s2_2aae652c:

    # m "\"So washing you, brushing you, and making you smell nice are all my duties?\""
    m "\"Ergo te lavare, pectere et efficere ut bene oleas omnia officia mea sunt?\""

# game/a1s2.rpy:1454
translate latin a1s2_f1281076:

    # a "\"Well, that and accompanying me to important meetings and public outings, but all you do during those is stand there and look civilized.\""
    a "\"Bene, et mecum ad conventus magni momenti atque in publicum exire; sed ibi tantum stare et cultum videri debes.\""

# game/a1s2.rpy:1455
translate latin a1s2_667b148f:

    # m "\"Yeah, that's what you all keep telling me. This all seems pretty easy.\""
    m "\"Ita, omnes hoc mihi identidem dicitis. Haec omnia satis facilia videntur.\""

# game/a1s2.rpy:1457
translate latin a1s2_5c975e1e:

    # a "\"Though...there is one thing you can do for me before I go to bed.\""
    a "\"Sed... unum est quod mihi facere potes antequam cubitum eo.\""

# game/a1s2.rpy:1458
translate latin a1s2_df8ec4bc:

    # m "\"What?\""
    m "\"Quid?\""

# game/a1s2.rpy:1459
translate latin a1s2_fc799be6:

    # a "\"Well, a—a full-body massage.\""
    a "\"Bene, c—corporis totius frictionem.\""

# game/a1s2.rpy:1460
translate latin a1s2_0acc1b82:

    # "I look over my shoulder at him."
    "Super umerum ad eum respicio."

# game/a1s2.rpy:1461
translate latin a1s2_e25345a0:

    # a "\"Ooor, we can just stick with the other duties.\""
    a "\"Aaaaut aliis tantum officiis contenti esse possumus.\""

# game/a1s2.rpy:1462
translate latin a1s2_c85af38f:

    # "I laugh and Amicus's ears come back up."
    "Rideo et aures Amici rursus eriguntur."

# game/a1s2.rpy:1464
translate latin a1s2_4ea4fe5b:

    # "He continues to brush for a while longer before finally setting it aside."
    "Aliquantum diutius pectere pergit, antequam tandem peniculum reponit."

# game/a1s2.rpy:1466
translate latin a1s2_78b586a6:

    # a "\"There, looks much better now!\""
    a "\"Ecce, iam multo melius videntur!\""

# game/a1s2.rpy:1467
translate latin a1s2_9312bea8:

    # "I gently run a hand over my hair, and I have to agree that it feels softer than it's ever felt before."
    "Manum leniter per capillos meos duco, et assentiri debeo eos molliores esse quam umquam antea."

# game/a1s2.rpy:1470
translate latin a1s2_26c7b1ee:

    # a "\"But anyway, [mc], I am looking forward to these months ahead with you, even though we started off a bit...poorly.\""
    a "\"Sed utut est, [mc], menses proximos tecum agere cupio, quamquam initium aliquantum... male fecimus.\""

# game/a1s2.rpy:1471
translate latin a1s2_6bf14fb4:

    # "I look back at the wolf, at his earnest, but tentative smile."
    "Ad lupum respicio, ad risum eius sincerum sed dubitantem."

# game/a1s2.rpy:1472
translate latin a1s2_61b24e1b:

    # "He's definitely a man of contradictions; rash half of the time, but considerate most of the time."
    "Certe vir contrariis moribus est: dimidia temporis parte temerarius, sed plerumque aliorum rationem habens."

# game/a1s2.rpy:1473
translate latin a1s2_feef93af:

    # "I'm not sure what to make of him, but at this point I feel like I can at least trust him, and that's saying a lot after what he put me through."
    "Nescio quid de eo iudicem; sed iam sentio me saltem ei credere posse, quod magni momenti est post omnia quae is me pati coegit."

# game/a1s2.rpy:1474
translate latin a1s2_985b8804:

    # "I smile back."
    "Ego quoque ei arrideo."

# game/a1s2.rpy:1475
translate latin a1s2_b7543e9b:

    # m "\"Yeah, me too.\""
    m "\"Ita, ego quoque.\""

translate latin strings:

    # a1s2.rpy:16
    old "Infinity"
    new "Infinitas"

    # a1s2.rpy:16
    old "Oblivion"
    new "Oblivio"

