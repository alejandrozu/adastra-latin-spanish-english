
# game/a1s1.rpy:7
translate latin a1s1_77486a68:

    # unk "\"It's so...large.\""
    unk "\"Tam...magnum est.\""

# game/a1s1.rpy:8
translate latin a1s1_74c91a88:

    # unk "\"It's too much. How do they get anything done?\""
    unk "\"Nimium est. Quomodo quidquam efficere possunt?\""

# game/a1s1.rpy:9
translate latin a1s1_96bd9843:

    # com "\"Sensing doubt. Shall we proceed with the directive, Amicus?\""
    com "\"Dubitationem percipio. Pergamusne mandatum exsequi, Amicus?\""

# game/a1s1.rpy:10
translate latin a1s1_47478835:

    # a "\"I don't know...Are you sure they're level five?\""
    a "\"Nescio...Certusne es eos intelligentiam quinti gradus habere?\""

# game/a1s1.rpy:11
translate latin a1s1_b8ca3f57:

    # com "\"Data from mission 32-65-193 indicates primate species with level five intelligence and—\""
    com "\"Data expeditionis 32-65-193 indicant speciem primatum intelligentia quinti gradus praeditam et—\""

# game/a1s1.rpy:12
translate latin a1s1_d83ceef6:

    # a "\"Understood. Thank you.\""
    a "\"Intellego. Gratias ago.\""

# game/a1s1.rpy:13
translate latin a1s1_4392f7c4:

    # com "\"Most recent data indicates that all uplift attempts failed.\""
    com "\"Data recentissima indicant omnes conatus species ad altiorem cultum evehendi defecisse.\""

# game/a1s1.rpy:14
translate latin a1s1_a986817b:

    # a "\"Ha, that figures. Why did we try to uplift here in the first place?\""
    a "\"Ha! Non miror. Cur hic omnino species ad altiorem cultum evehere conati sumus?\""

# game/a1s1.rpy:15
translate latin a1s1_932c06f3:

    # com "\"Sensing doubt. Shall we procee—\""
    com "\"Dubitationem percipio. Pergamusne—\""

# game/a1s1.rpy:16
translate latin a1s1_18bdccdf:

    # a "\"Name of the planet?\""
    a "\"Quod planetae nomen est?\""

# game/a1s1.rpy:17
translate latin a1s1_ed058531:

    # com "\"Earth.\""
    com "\"Terra.\""

# game/a1s1.rpy:18
translate latin a1s1_5af60aea:

    # a "\"Location of Romanus uplift?\""
    a "\"Ubi gens Romana ad altiorem cultum provecta est?\""

# game/a1s1.rpy:19
translate latin a1s1_182bff7d:

    # com "\"The city of Rome, in the state of Italy.\""
    com "\"Urbs Roma, in Italiae civitate.\""

# game/a1s1.rpy:20
translate latin a1s1_859172a1:

    # a "\"Is the probe there?\""
    a "\"Estne illic navicula exploratoria?\""

# game/a1s1.rpy:21
translate latin a1s1_283efa32:

    # com "\"It has arrived.\""
    com "\"Pervenit.\""

# game/a1s1.rpy:22
translate latin a1s1_8a70dce5:

    # a "\"Give me a visual...Zoom in.\""
    a "\"Imaginem mihi ostende...Amplifica.\""

# game/a1s1.rpy:23
translate latin a1s1_a20cefa7:

    # "..."
    "..."

# game/a1s1.rpy:24
translate latin a1s1_e1fda613:

    # a "\"That...doesn't look like Adastra at all.\""
    a "\"Istud...ab Adastra specie omnino differt.\""

# game/a1s1.rpy:25
translate latin a1s1_03043a4b:

    # com "\"Reminder that uplift failed. Ruins of uplift attempt remain.\""
    com "\"Memento conatum ad altiorem cultum evehendi defecisse. Ruinae illius conatus restant.\""

# game/a1s1.rpy:26
translate latin a1s1_3e9384a3:

    # a "\"Show me the ruins.\""
    a "\"Ruinas mihi ostende.\""

# game/a1s1.rpy:27
translate latin a1s1_a20cefa7_1:

    # "..."
    "..."

# game/a1s1.rpy:28
translate latin a1s1_1124cc1e:

    # com "\"Showing the Roman Forum.\""
    com "\"Forum Romanum ostendo.\""

# game/a1s1.rpy:29
translate latin a1s1_abaf999a:

    # a "\"...\""
    a "\"...\""

# game/a1s1.rpy:30
translate latin a1s1_3f3d25dd:

    # com "\"Sensing doubt—\""
    com "\"Dubitationem percipio—\""

# game/a1s1.rpy:31
translate latin a1s1_bf7a2451:

    # a "\"Shut up, please.\""
    a "\"Tace, quaeso.\""

# game/a1s1.rpy:32
translate latin a1s1_2160ca6a:

    # com "\"...\""
    com "\"...\""

# game/a1s1.rpy:33
translate latin a1s1_11cb2ffa:

    # a "\"What the hell are they even saying? That's not the Language. It's all messed up.\""
    a "\"Quid, malum, isti dicunt? Ista non est Lingua. Omnia depravata sunt.\""

# game/a1s1.rpy:34
translate latin a1s1_a20cefa7_2:

    # "..."
    "..."

# game/a1s1.rpy:35
translate latin a1s1_11847be3:

    # com "\"Sensing—\""
    com "\"Percipio—\""

# game/a1s1.rpy:36
translate latin a1s1_f76ffc40:

    # a "\"That creature there.\""
    a "\"Istud animal illic.\""

# game/a1s1.rpy:37
translate latin a1s1_636be05a:

    # com "\"They are called humans.\""
    com "\"Homines vocantur.\""

# game/a1s1.rpy:38
translate latin a1s1_8f687ee2:

    # a "\"Get closer.\""
    a "\"Propius accede.\""

# game/a1s1.rpy:39
translate latin a1s1_a20cefa7_3:

    # "..."
    "..."

# game/a1s1.rpy:40
translate latin a1s1_ba943069:

    # a "\"It's a human?\""
    a "\"Homo est?\""

# game/a1s1.rpy:41
translate latin a1s1_14fbafac:

    # com "\"Collecting data...he appears to be a young male human.\""
    com "\"Data colliguntur...Homo masculus iuvenis esse videtur.\""

# game/a1s1.rpy:42
translate latin a1s1_a20cefa7_4:

    # "..."
    "..."

# game/a1s1.rpy:43
translate latin a1s1_97898fd5:

    # a "\"Initiate landing sequence.\""
    a "\"Ordinem ad terram descendendi incipe.\""

# game/a1s1.rpy:44
translate latin a1s1_1f33b800:

    # com "\"Have you located the directive?\""
    com "\"Mandati obiectum repperisti?\""

# game/a1s1.rpy:45
translate latin a1s1_bcc81977:

    # a "\"Yes.\""
    a "\"Ita.\""

# game/a1s1.rpy:46
translate latin a1s1_47cb0a76:

    # com "\"Warning that full Nexus analysis is incomple—\""
    com "\"Monitum: plena Nexus investigatio non est perfec—\""

# game/a1s1.rpy:47
translate latin a1s1_cb929e37:

    # a "\"Now, please. We cannot waste time outside of the Stretch Drive.\""
    a "\"Iam, quaeso. Tempus terere non possumus dum Propulsione Dilatatoria non utimur.\""

# game/a1s1.rpy:48
translate latin a1s1_a20cefa7_5:

    # "..."
    "..."

# game/a1s1.rpy:49
translate latin a1s1_b208b2a0:

    # com "\"Initiating landing sequence.\""
    com "\"Ordinem ad terram descendendi incipio.\""

# game/a1s1.rpy:55
translate latin a1s1_eb0977cc:

    # "It's hard to believe that I'm actually here."
    "Difficile est credere me re vera hic esse."

# game/a1s1.rpy:56
translate latin a1s1_6d8e1a2e:

    # "After years of fantasizing about it, I'm in Rome..."
    "Post tot annos quibus de hac re somniavi, Romae sum..."

# game/a1s1.rpy:57
translate latin a1s1_8c69ffb6:

    # "I've been bouncing around with my friends like an idiot all day."
    "Totum diem cum amicis quasi stultus huc illuc cucurri."

# game/a1s1.rpy:58
translate latin a1s1_579c818a:

    # "Yeah, I look like a total tourist, but this is what I've been saving up for for the past two years.."
    "Ita, plane peregrinator videor; sed ad hoc per hos duos annos pecuniam servavi.."

# game/a1s1.rpy:59
translate latin a1s1_aa3b9076:

    # "A whole semester in Rome with the study abroad program."
    "Totum semestre Romae, in programmate studiorum peregre faciendorum."

# game/a1s1.rpy:60
translate latin a1s1_6237c183:

    # "All the conversations I've had with my parents about what a waste of money it would be evaporates from my brain as I take in the view."
    "Omnes sermones quos cum parentibus habui de pecunia frustra consumenda ex animo evanescunt, dum prospectum contemplor."

# game/a1s1.rpy:61
translate latin a1s1_e3fca3b1:

    # "We only have a few hours, so we move from the Forum to Palatine Hill, then finally to a nearby disco where I get just a little drunk."
    "Paucas tantum horas habemus; itaque e Foro ad Palatium imus, deinde ad discothecam propinquam, ubi paululum inebrior."

# game/a1s1.rpy:62
translate latin a1s1_fb087acd:

    # "Before I know it, it's two in the morning and somehow my friends and I are able to stumble to a taxi that takes us back to our apartments."
    "Antequam sentio, hora secunda post mediam noctem est; amici et ego quoquo modo ad autoraedam meritoriam titubamus, quae nos ad diaetas reducit."

# game/a1s1.rpy:64
translate latin a1s1_51699130:

    # "I walk unsteadily through the darkness, glad that I have the place to myself for now."
    "Per tenebras incertis passibus ambulo, gaudens diaetam nunc mihi soli esse."

# game/a1s1.rpy:65
translate latin a1s1_f27ceb0a:

    # "Apparently my group was the first to arrive and my assigned flatmates won't be here for a few days at least."
    "Ut videtur, coetus noster primus advenit; contubernales autem mihi destinati non ante paucos saltem dies aderunt."

# game/a1s1.rpy:66
translate latin a1s1_0ebb061a:

    # "I open the door to my room and move my hand along the wall."
    "Ianuam cubiculi aperio et manum per parietem duco."

# game/a1s1.rpy:69
translate latin a1s1_b12fd0d3:

    # "I stumble in then sit on my bed, bouncing happily for a moment."
    "Titubans ingredior, deinde in lecto sedeo et paulisper laetus subsilio."

# game/a1s1.rpy:70
translate latin a1s1_b8fd2e60:

    # "I think about going out onto the balcony, but I've been walking all day and it feels too nice to be sitting down."
    "Cogito de egrediendo in maenianum; sed totum diem ambulavi, et nunc sedere nimis iucundum est."

# game/a1s1.rpy:71
translate latin a1s1_2e1bfeb1:

    # "Plus it might not be a great idea considering the state I'm in right now."
    "Praeterea, ut nunc me habeo, id facere fortasse non est prudentissimum."

# game/a1s1.rpy:72
translate latin a1s1_84af68c2:

    # "Still, just knowing the magic of the city is just outside my window is going to make it hard to sleep."
    "Attamen sola cogitatio urbis mirabilia statim extra fenestram esse faciet ut difficile obdormiscam."

# game/a1s1.rpy:73
translate latin a1s1_e8a976a1:

    # "I sigh happily and look around my little room."
    "Laetus suspiro et parvum cubiculum meum circumspicio."

# game/a1s1.rpy:74
translate latin a1s1_47dfdd03:

    # "Actually I'm told that it's kinda big by this city's standards."
    "Immo mihi dicitur id pro huius urbis more satis magnum esse."

# game/a1s1.rpy:75
translate latin a1s1_4f58cf74:

    # "It's still a little bare since I just moved in today."
    "Adhuc paulum nudum est, quoniam hodie demum huc transmigravi."

# game/a1s1.rpy:76
translate latin a1s1_3e2aaead:

    # "I'd basically just dropped my suitcases next to the door before running out again."
    "Vidulos fere tantum iuxta ianuam deposui, antequam rursus foras cucurri."

# game/a1s1.rpy:77
translate latin a1s1_6215143f:

    # "I glance at them, but decide I'm way too tired right now to unpack even if my pajamas are in there."
    "Eos aspicio, sed statuo me nunc multo fessiorem esse quam ut eos exonerem, etsi vestimenta nocturna intus sunt."

# game/a1s1.rpy:78
translate latin a1s1_0eec5d81:

    # "It's fine if I'm just laying on top of the covers."
    "Nihil refert, si tantum super stragula iaceo."

# game/a1s1.rpy:79
translate latin a1s1_90c175e6:

    # "I'll get to it tomorrow."
    "Cras hoc faciam."

# game/a1s1.rpy:80
translate latin a1s1_80c63e49:

    # "In the meantime I just lay back, smiling in the afterglow of today's excitement."
    "Interim recumbo, subridens dum laetitia hodierna adhuc in animo viget."

# game/a1s1.rpy:81
translate latin a1s1_dc73bb42:

    # "And tomorrow I'll get to see even more!"
    "Et cras plura etiam videbo!"

# game/a1s1.rpy:82
translate latin a1s1_8bfc9a3d:

    # "Damn it, I need to calm down."
    "Malum! Me ipsum sedare debeo."

# game/a1s1.rpy:83
translate latin a1s1_1a007b80:

    # "No way am I gonna have the energy I'll need tomorrow if I'm up all night."
    "Si totam noctem vigilavero, nullo modo cras satis virium habebo."

# game/a1s1.rpy:84
translate latin a1s1_9d4782e4:

    # "I've got the whole semester and on top of that school doesn't actually start for another two weeks!"
    "Semestre totum mihi est; praeterea lectiones duabus demum hebdomadibus incipient!"

# game/a1s1.rpy:85
translate latin a1s1_e391e053:

    # "There's plenty of time."
    "Tempus abunde est."

# game/a1s1.rpy:86
translate latin a1s1_27b7ecc1:

    # "Just relax for now and enjoy it."
    "Nunc modo quiesce et hac re fruere."

# game/a1s1.rpy:87
translate latin a1s1_665fd18a:

    # "With that thought in my head, I start to drift off..."
    "Hoc cogitans paulatim obdormiscere incipio..."

# game/a1s1.rpy:90
translate latin a1s1_d0394d24:

    # "Something moves..."
    "Aliquid movetur..."

# game/a1s1.rpy:91
translate latin a1s1_ccfa018c:

    # "I lay there in the dark, wondering if I'd dreamed it."
    "In tenebris iaceo, dubitans num id tantum somniaverim."

# game/a1s1.rpy:92
translate latin a1s1_0ab0e04b:

    # "I had been dreaming, even though I can't remember exactly what it was about."
    "Somniabam quidem, quamquam qua de re somniaverim non iam satis memini."

# game/a1s1.rpy:93
translate latin a1s1_32ef38ec:

    # "Something about a portal, maybe?"
    "Fortasse de quadam porta?"

# game/a1s1.rpy:94
translate latin a1s1_8fb59446:

    # "I listen for a while, but there's no other sound...just the occasional soft {i}whoosh{/i} of a car passing by outside my balcony."
    "Paulisper ausculto, sed nullus alius sonus est...solum interdum mollis {i}susurrus{/i} autocineti quod foris praeter maenianum transit."

# game/a1s1.rpy:95
translate latin a1s1_05af45b3:

    # "I shift around a little; the suffocating humidity is making the sheets stick to my skin and I wonder if maybe there's a fan in the closet."
    "Me paulum verto; aer suffocans atque umidus facit ut lintea cuti haereant. Cogito num fortasse in armario ventilator sit."

# game/a1s1.rpy:96
translate latin a1s1_08870c26:

    # "I finally sit up in bed, realizing that there's no way I'm going to fall back to sleep like this."
    "Tandem in lecto consido, intellegens me sic nullo modo rursus obdormiturum esse."

# game/a1s1.rpy:97
translate latin a1s1_a4812f89:

    # "I could at least try sliding open the balcony door, though I'm not sure that will do me any good."
    "Saltem ianuam maeniani aperire conari possum, quamquam nescio num id mihi quidquam prosit."

# game/a1s1.rpy:98
translate latin a1s1_362ef336:

    # "Worth a try, I guess."
    "Conari tamen operae pretium est, opinor."

# game/a1s1.rpy:99
translate latin a1s1_252d7c3a:

    # "I groggily slide out of bed and try to slide the glass door open, but it doesn't budge."
    "Adhuc somniculosus e lecto descendo et vitream ianuam movere conor, sed ne tantillum quidem movetur."

# game/a1s1.rpy:100
translate latin a1s1_04a30081:

    # "I struggle for a few more seconds before sighing and moving toward the door to find the light switch."
    "Pauca alia momenta contendo, deinde suspiro et ad ianuam eo ut clavem lucis inveniam."

# game/a1s1.rpy:101
translate latin a1s1_e69927e9:

    # "My feet slide along the semi-cool wooden floor, which feels great, while my hands stretch out in front of me, searching for the wall."
    "Pedes per pavimentum ligneum satis frigidulum duco, quod perquam iucundum est; manus autem ante me extendo, parietem quaerens."

# game/a1s1.rpy:102
translate latin a1s1_b318b6c4:

    # "Right then I remember that I was woken up by noises, and I imagine some intruder standing there in the dark, waiting for me to bump into him."
    "Tum memini me sonis excitatum esse, atque animo fingo aliquem intrusum in tenebris stantem, exspectantem dum in eum incurram."

# game/a1s1.rpy:103
translate latin a1s1_c34a963b:

    # "Feeling the hairs stand up on the back of my neck, I quicken my pace and find the wall, fumbling around until—"
    "Cum pilos in cervice horrere sentiam, gradum accelero et parietem invenio; manibus huc illuc quaero, donec..."

# game/a1s1.rpy:106
translate latin a1s1_c0f5fb34:

    # "I quickly glance around the room, relieved that it's empty."
    "Cubiculum celeriter circumspicio, levatus quod vacuum est."

# game/a1s1.rpy:107
translate latin a1s1_8e109e4e:

    # "My parents had warned me about the crime rate here."
    "Parentes me de frequentia scelerum hic monuerant."

# game/a1s1.rpy:108
translate latin a1s1_78091602:

    # "While the city is technically safe in terms of murder, robberies and muggings are apparently pretty common."
    "Quamquam urbs, si de homicidiis agitur, satis tuta est, furta et rapinae in viis satis frequentes esse dicuntur."

# game/a1s1.rpy:109
translate latin a1s1_d7a03ac3:

    # "I had shrugged it off at the time, but now that I'm alone—."
    "Tum id parvi duxeram; nunc autem, cum solus sim..."

# game/a1s1.rpy:110
translate latin a1s1_898503d3:

    # "I make my way to the balcony, looking for the lock before finally seeing that there's a latch near the top of the door."
    "Ad maenianum eo, seram quaerens, donec tandem video claustrum prope summam ianuam esse."

# game/a1s1.rpy:111
translate latin a1s1_5da9fad8:

    # "I unhook it and slowly slide the door open."
    "Id solvo et ianuam lente aperio."

# game/a1s1.rpy:112
translate latin a1s1_2e2d6b3d:

    # "I'm disappointed to find that the air wafting from outside is almost as stuffy as the air inside."
    "Moleste fero quod aer qui foris influit paene tam gravis est quam aer intus."

# game/a1s1.rpy:113
translate latin a1s1_c35db7eb:

    # "Still, I take the moment to stare out at the lights of the city for a while."
    "Nihilo minus hac occasione lumina urbis aliquamdiu contemplor."

# game/a1s1.rpy:114
translate latin a1s1_da1a8ad6:

    # "Even though I'm more interested in the ruins, the city itself is undeniably beautiful."
    "Quamquam ruinae me magis alliciunt, ipsam urbem pulcherrimam esse negari non potest."

# game/a1s1.rpy:115
translate latin a1s1_b7f5d943:

    # "Nothing like my hometown."
    "Minime similis oppido meo natali."

# game/a1s1.rpy:116
translate latin a1s1_6904e3bb:

    # "That's when I notice that there's a strange smell in the air, like burning rubber."
    "Tum animadverto odorem quendam insolentem in aere esse, quasi gummi urentis."

# game/a1s1.rpy:117
translate latin a1s1_daf99835:

    # "I stick my head out a bit further, looking around for the source, but I see nothing."
    "Caput paulo longius exsero et circumspicio ut fontem odoris inveniam, sed nihil video."

# game/a1s1.rpy:118
translate latin a1s1_6c43b34c:

    # "Maybe that's normal here?"
    "Fortasse hoc hic usitatum est?"

# game/a1s1.rpy:119
translate latin a1s1_4992f925:

    # "I look back at the clock on the wall."
    "Oculos rursus ad horologium in pariete converto."

# game/a1s1.rpy:120
translate latin a1s1_e806431f:

    # "4 A.M."
    "Hora 4 post mediam noctem."

# game/a1s1.rpy:121
translate latin a1s1_6be2e3e0:

    # "I sigh and shuffle back to the bed, only realizing that I've left the light on once I've already fallen back-first onto the covers."
    "Suspiro et pedes trahens ad lectum redeo; me lucem accensam reliquisse tum demum intellego cum iam in stragula supinus cecidi."

# game/a1s1.rpy:122
translate latin a1s1_02c81aa4:

    # "I sigh and will myself to get up, but the tiredness has returned and the heavy humidity is almost like a warm blanket pressing down on me."
    "Suspiro et me ipsum surgere iubeo; sed lassitudo rediit, aerque gravis et umidus quasi calidum stragulum me opprimit."

# game/a1s1.rpy:123
translate latin a1s1_5ac8571f:

    # "I close my eyes..."
    "Oculos claudo..."

# game/a1s1.rpy:124
translate latin a1s1_57d42554:

    # "I'll get up and turn it off in a second, just need to rest my eyes for a bit."
    "Mox surgam eamque exstinguam; modo oculis paulisper quiescendum est."

# game/a1s1.rpy:125
translate latin a1s1_cd8e5236:

    # "Just for a bit..."
    "Paulisper tantum..."

# game/a1s1.rpy:127
translate latin a1s1_8611e73d:

    # "Something moves again."
    "Aliquid rursus movetur."

# game/a1s1.rpy:128
translate latin a1s1_381269ae:

    # "And there's another smell in the air."
    "Et alius odor in aere est."

# game/a1s1.rpy:129
translate latin a1s1_5e98d232:

    # "A good smell this time."
    "Hac vice iucundus."

# game/a1s1.rpy:130
translate latin a1s1_029b4424:

    # "Something floral."
    "Quasi florum odor."

# game/a1s1.rpy:131
translate latin a1s1_6a7dbfa7:

    # "It reminds me of lavender."
    "Lavandulae me admonet."

# game/a1s1.rpy:132
translate latin a1s1_0c804584:

    # "And that's when something hard and sharp presses into my left eye socket, just above the eye."
    "Tum aliquid durum atque acutum in orbitam oculi sinistri, statim supra ipsum oculum, premitur."

# game/a1s1.rpy:133
translate latin a1s1_7600de99:

    # "It doesn't really hurt, but it shocks me awake."
    "Non sane dolet, sed repente me expergefacit."

# game/a1s1.rpy:138
translate latin a1s1_a20cefa7_6:

    # "..."
    "..."

# game/a1s1.rpy:139
translate latin a1s1_3fe64fc1:

    # "It leans over me, something shiny in its grip which it's pulling back from my head."
    "Supra me inclinatur, aliquid nitidum manu tenens, quod a capite meo retrahit."

# game/a1s1.rpy:143
translate latin a1s1_dc3047f8:

    # unk "\"Av—\""
    unk "\"Av—\""

# game/a1s1.rpy:144
translate latin a1s1_15c53b8c:

    # m "\"AH!\""
    m "\"AH!\""

# game/a1s1.rpy:149
translate latin a1s1_b9d9d082:

    # "I kick out with both feet, hitting the thing leaning over me in its body."
    "Ambobus pedibus calces fero et corpus eius rei supra me inclinatae percutio."

# game/a1s1.rpy:150
translate latin a1s1_20f11e71:

    # unk "\"{i}Edapol{/i}!\""
    unk "\"{i}Edapol{/i}!\""

# game/a1s1.rpy:151
translate latin a1s1_d7dc44a6:

    # "It lets out a surprised grunt, stumbling back and falling on its rear while I scramble back on my bed, pressing myself against the wall."
    "Grunnitum mirantis edit, retro titubat et in nates cadit; ego autem in lecto retro me expedio et parieti me applico."

# game/a1s1.rpy:153
translate latin a1s1_8c3ac6c9:

    # "Almost immediately it scrambles back up, revealing its massive build and its masculine shape."
    "Paene statim rursus surgit, ita ut corporis magnitudo et forma virilis pateant."

# game/a1s1.rpy:154
translate latin a1s1_76328ece:

    # "It...he adjusts his cape and smooths down his fur before rubbing at his chest, giving me an odd look."
    "Illud...ille pallium componit et pilos demulcet; deinde pectus fricat, insolito quodam vultu me intuens."

# game/a1s1.rpy:156
translate latin a1s1_19d89cff:

    # "Then he fixes a smile back on his face."
    "Tum rursus subridere se cogit."

# game/a1s1.rpy:158
translate latin a1s1_46e56750:

    # unk "\"{i}Ave{/i}!\""
    unk "\"{i}Ave{/i}!\""

# game/a1s1.rpy:159
translate latin a1s1_a20cefa7_7:

    # "..."
    "..."

# game/a1s1.rpy:160
translate latin a1s1_61f958ee:

    # "I stare."
    "Eum fixis oculis intueor."

# game/a1s1.rpy:161
translate latin a1s1_8ecf0e79:

    # "That's all I can do is stare."
    "Nihil aliud facere possum quam eum intueri."

# game/a1s1.rpy:163
translate latin a1s1_4ac0e2c9:

    # "He stares back at me for a moment, then clears his throat."
    "Ille quoque me paulisper intuetur, deinde fauces purgat."

# game/a1s1.rpy:165
translate latin a1s1_ef18f8da:

    # unk "\"{i}Ave/{/i}Hello!\""
    unk "\"{i}Ave/{/i}Salve!\""

# game/a1s1.rpy:166
translate latin a1s1_1f3dc6b4:

    # "The space above my left eye throbs and it sounds like I'm hearing two things at once from the same voice."
    "Locus supra oculum sinistrum pulsat; mihi videtur eadem vox duo simul dicere."

# game/a1s1.rpy:168
translate latin a1s1_3abe4791:

    # unk "\"Erm...{i}Potes intellegere{/i}?/Do you understand?\""
    unk "\"Hem...{i}Potes intellegere{/i}?/Intellegisne?\""

# game/a1s1.rpy:169
translate latin a1s1_bad04be6:

    # "Again the bizarre twitching in my eye, in my brain, and hearing two things at once."
    "Rursus ille insolitus motus in oculo, in cerebro, et duo simul audio."

# game/a1s1.rpy:170
translate latin a1s1_5110002c:

    # "I feel like I'm going to be sick."
    "Nauseam sentio."

# game/a1s1.rpy:171
translate latin a1s1_75456ed8:

    # "The room shifts and swirls a bit, then slowly starts to settle again."
    "Cubiculum quasi labitur ac vertitur, deinde paulatim rursus consistit."

# game/a1s1.rpy:172
translate latin a1s1_fc81a5c8:

    # "The twitching in my head turns into a dull throb."
    "Motus ille in capite in obtusum dolorem pulsantem mutatur."

# game/a1s1.rpy:173
translate latin a1s1_a30a72be:

    # "I'm having a nightmare."
    "Somnium horrendum video."

# game/a1s1.rpy:174
translate latin a1s1_58a88ee1:

    # unk "\"Do you understand me?\""
    unk "\"Me intellegisne?\""

# game/a1s1.rpy:175
translate latin a1s1_52f2f765:

    # "I stare at him and he stares back."
    "Eum intueor, et ille me."

# game/a1s1.rpy:176
translate latin a1s1_1a5a09c6:

    # unk "\"Com, I don't know if the chip is working...\""
    unk "\"Com, nescio num microcircuitus operetur...\""

# game/a1s1.rpy:177
translate latin a1s1_b675898e:

    # m "\"Wh—what?\""
    m "\"Qu—quid?\""

# game/a1s1.rpy:178
translate latin a1s1_9866d76f:

    # "The creature raises its hand to its head, rubbing at it."
    "Creatura manum ad caput tollit idque fricat."

# game/a1s1.rpy:179
translate latin a1s1_e334ae29:

    # unk "\"Well, he can speak, and it's translating. Can you understand me?\""
    unk "\"Saltem loqui potest, et interpretatio fit. Me intellegisne?\""

# game/a1s1.rpy:180
translate latin a1s1_250b5d45:

    # "When am I going to wake up?"
    "Quando tandem expergiscar?"

# game/a1s1.rpy:181
translate latin a1s1_bfea2ba9:

    # "He keeps staring at me and automatically I respond to him."
    "Pergit me intueri, atque ei sine cogitatione respondeo."

# game/a1s1.rpy:182
translate latin a1s1_6cd16775:

    # m "\"Y—yes?\""
    m "\"I—ita?\""

# game/a1s1.rpy:184
translate latin a1s1_9b656bf8:

    # unk "\"Ah! Good, seems it's finally working now. They take a moment to adjust to the host brain.\""
    unk "\"Ah! Bene, tandem operari videtur. Paululum temporis opus est ut cerebro hospitis se accommodent.\""

# game/a1s1.rpy:185
translate latin a1s1_f2c92989:

    # "I struggle to keep up with his words."
    "Verba eius aegre sequor."

# game/a1s1.rpy:186
translate latin a1s1_eab50ecf:

    # "I'm still hearing what he's saying."
    "Adhuc audio quae ille dicit."

# game/a1s1.rpy:187
translate latin a1s1_adf532a3:

    # "It's almost Italian with the inflections and the rolling R's, but at the same time it's definitely not Italian..."
    "Vocis flexus litteraeque R volutae paene Italicam linguam referunt, sed simul certo scio hanc Italicam non esse..."

# game/a1s1.rpy:188
translate latin a1s1_1190b528:

    # "Still, I can understand what he's saying, like he's speaking my own language at the same time."
    "Tamen quae dicit intellego, quasi simul lingua mea loquatur."

# game/a1s1.rpy:189
translate latin a1s1_21fe1f2e:

    # "It makes it hard to concentrate."
    "Hoc difficilem facit animi attentionem."

# game/a1s1.rpy:191
translate latin a1s1_3ffcf84d:

    # unk "\"What is your name?\""
    unk "\"Quod tibi nomen est?\""

# game/a1s1.rpy:196
translate latin a1s1_cdacc0ec:

    # "His expectant look almost forces the answer out of my mouth."
    "Vultus eius responsum exspectantis paene responsionem ex ore meo exprimit."

# game/a1s1.rpy:197
translate latin a1s1_31294dd3:

    # m "\"[mc]...\""
    m "\"[mc]...\""

# game/a1s1.rpy:198
translate latin a1s1_aaa503b5:

    # unk "\"[mc]? Beautiful! I am Amicus.\""
    unk "\"[mc]? Quam pulchrum! Ego Amicus sum.\""

# game/a1s1.rpy:199
translate latin a1s1_cd4de8f7:

    # "The confusing double language I was hearing is starting to fade, and now only my own language comes from his mouth."
    "Ille confusus duarum linguarum sonus paulatim evanescit; iam ex ore eius sola lingua mea auditur."

# game/a1s1.rpy:200
translate latin a1s1_5ef2ce8b:

    # "It's odd, the words not quite matching up with his lips."
    "Mirum est: verba motibus labiorum non satis congruunt."

# game/a1s1.rpy:201
translate latin a1s1_b08d468a:

    # "What's even more distracting are the massive canines that continue to flash behind those lips."
    "Maius etiam impedimentum sunt ingentes dentes canini, qui post labia identidem micant."

# game/a1s1.rpy:202
translate latin a1s1_9c9f6724:

    # "I need to get the hell out of here."
    "Hinc mihi effugiendum est, malum!"

# game/a1s1.rpy:203
translate latin a1s1_158b9c11:

    # "Dream or not, I don't like the look of the teeth and claws on this thing."
    "Sive somnium est sive non, dentes unguesque huius rei mihi minime placent."

# game/a1s1.rpy:205
translate latin a1s1_5e7e3d67:

    # a "\"Ah, is the Lingua having troubles again?\""
    a "\"Ah, Lingua rursus laborat?\""

# game/a1s1.rpy:206
translate latin a1s1_07641443:

    # "I don't respond, instead glancing at the door just to the right and behind this...Amicus."
    "Non respondeo; pro eo ianuam aspicio, quae paulum ad dextram et post hunc...Amicum est."

# game/a1s1.rpy:207
translate latin a1s1_b4002846:

    # "He frowns."
    "Frontem contrahit."

# game/a1s1.rpy:209
translate latin a1s1_2fb5f55d:

    # a "\"Com, you told me they're level 5. I can't even speak with it!\""
    a "\"Com, mihi dixisti eos gradum 5 habere. Ne loqui quidem cum illo possum!\""

# game/a1s1.rpy:210
translate latin a1s1_7de0ee82:

    # "It takes me a moment to realize he's not talking to me."
    "Paulo post intellego eum non mecum loqui."

# game/a1s1.rpy:211
translate latin a1s1_4bbc02a0:

    # "I hear a soft chatter coming from the wolf, like someone's talking to him from a phone, but I can't see anything."
    "Tenue murmur a lupo veniens audio, quasi quis ei per telephonum loquatur; sed nihil video."

# game/a1s1.rpy:212
translate latin a1s1_db48a3ea:

    # a "\"Yeah? Well he kicked me in the chest!\""
    a "\"Itane? At calce me in pectus percussit!\""

# game/a1s1.rpy:213
translate latin a1s1_75f5601c:

    # "Amicus rubs at his chest with a frown."
    "Amicus frontem contrahens pectus fricat."

# game/a1s1.rpy:214
translate latin a1s1_636bc604:

    # "More muffled speaking."
    "Vox rursus obscura auditur."

# game/a1s1.rpy:216
translate latin a1s1_59ab6cfe:

    # a "\"Of course I didn't! He just kicked me! He's looking at me like he has no idea—\""
    a "\"Certe non feci! Modo me calce percussit! Me intuetur quasi nihil intellegat—\""

# game/a1s1.rpy:217
translate latin a1s1_ef6a8ae0:

    # "More muffled speaking interrupts him."
    "Alia vox obscura eum interpellat."

# game/a1s1.rpy:219
translate latin a1s1_a34128dd:

    # a "\"Oh...Wait, what!?\""
    a "\"Oh...Exspecta, quid!?\""

# game/a1s1.rpy:221
translate latin a1s1_e0f3c827:

    # a "\"Are you serious?\""
    a "\"Serione dicis?\""

# game/a1s1.rpy:222
translate latin a1s1_cd9f95da:

    # "Now he looks pissed and I press myself harder against the wall, trying to work up the courage to make a break for the door."
    "Iam iratus videtur; ego me vehementius parieti applico, animum ad ianuam effugiendi colligere conans."

# game/a1s1.rpy:223
translate latin a1s1_2d88f30a:

    # a "\"How—Wait, so you're always offering me opinions on my mood, but you couldn't offer THAT!?\""
    a "\"Quomodo—Exspecta: tu semper de animi mei statu sententias mihi dicis, sed ILLUD mihi dicere non potuisti!?\""

# game/a1s1.rpy:224
translate latin a1s1_ae57adfd:

    # "More muffled babbling, but the wolf thing interrupts it with a snarl."
    "Murmur obscurum pergit, sed res illa lupina fremitu id interrumpit."

# game/a1s1.rpy:225
translate latin a1s1_17fe186c:

    # a "\"Well what the hell do I do now!?\""
    a "\"Quid, malum, nunc faciam!?\""

# game/a1s1.rpy:226
translate latin a1s1_f892c4df:

    # "His lips are drawn back and now I get to have a real good view of those canines."
    "Labia retraxit; nunc dentes illos caninos plane videre possum."

# game/a1s1.rpy:227
translate latin a1s1_3b34be8e:

    # "I stare wide-eyed at them, and that's when he seems to notice me again."
    "Eos patulis oculis intueor; tum ille me rursus animadvertere videtur."

# game/a1s1.rpy:229
translate latin a1s1_e51d5ae8:

    # "He readjusts his expression into a smile, but I can still see a fang poking out."
    "Vultum rursus in risum componit, sed unus adhuc dens eminere videtur."

# game/a1s1.rpy:230
translate latin a1s1_5c894071:

    # a "\"Heeey, listen...\""
    a "\"Heuus, audi...\""

# game/a1s1.rpy:231
translate latin a1s1_17f03fa3:

    # "Something about the way he acts; his expressions, demeanor..."
    "Quiddam est in modo quo se gerit: vultus, habitus..."

# game/a1s1.rpy:232
translate latin a1s1_6a959af9:

    # "He's so...human."
    "Tam...humanus est."

# game/a1s1.rpy:233
translate latin a1s1_faded846:

    # a "\"Could you...could you come with me outside for a quick moment?\""
    a "\"Possesne...possesne mecum paulisper foras venire?\""

# game/a1s1.rpy:234
translate latin a1s1_d6527c60:

    # "For some reason the realization of his human-ness makes me absolutely positive that this is a dream."
    "Nescio cur, sed ut intellego eum tam humanum esse, certissime scio hoc somnium esse."

# game/a1s1.rpy:235
translate latin a1s1_54d3d854:

    # "This must be a character from a game, or movie that I'd seen."
    "Hic certe persona est ex ludo aut pellicula quam vidi."

# game/a1s1.rpy:236
translate latin a1s1_c953fec1:

    # "I shake my head slowly at him."
    "Caput ei lente quatio."

# game/a1s1.rpy:237
translate latin a1s1_ea632bd1:

    # a "\"Ah..um, please?\""
    a "\"Ah..hem, quaeso?\""

# game/a1s1.rpy:238
translate latin a1s1_6b056a7b:

    # "I just stare, still waiting to wake up."
    "Eum tantum intueor, adhuc exspectans dum expergiscar."

# game/a1s1.rpy:239
translate latin a1s1_bcd268af:

    # "I've had dreams where I couldn't wake up before. This is just one of those."
    "Iam antea somniavi nec expergisci potui. Hoc unum ex illis somniis est."

# game/a1s1.rpy:240
translate latin a1s1_f5dad1d4:

    # "I remember reading somewhere that if you aren't sure you're dreaming you can plug your nose."
    "Memini me alicubi legisse: si nescis num somnies, nares premere potes."

# game/a1s1.rpy:241
translate latin a1s1_fdb04c62:

    # "If you can still breathe, then it's definitely a dream."
    "Si adhuc respirare potes, certe somnium est."

# game/a1s1.rpy:242
translate latin a1s1_12fe202d:

    # "But I remain frozen against the wall."
    "Sed parieti adhaerens immobilis maneo."

# game/a1s1.rpy:244
translate latin a1s1_6e2be873:

    # "The massive wolf sighs."
    "Ingenti lupo suspirium excidit."

# game/a1s1.rpy:245
translate latin a1s1_89e0fbad:

    # "Then his paw suddenly moves to his waist."
    "Tum repente manum ad lumbos admovet."

# game/a1s1.rpy:246
translate latin a1s1_ff6d139f:

    # "I only have a moment to see some sort of device with multi-colored lights before he moves and my entire body seizes up and things go black..."
    "Vix instrumentum quoddam luminibus variis coloribus micantibus video, antequam ille movetur et corpus meum totum rigescit atque omnia in tenebras abeunt..."

# game/a1s1.rpy:250
translate latin a1s1_b4e715e2:

    # "My body feels strangely numb."
    "Corpus meum mirum in modum torpet."

# game/a1s1.rpy:251
translate latin a1s1_76ffee5f:

    # "It's like when I wake up with a dead leg or arm, except right now it's my entire body."
    "Sic est ut cum experrectus crus aut brachium torpere sentio, nisi quod nunc totum corpus ita se habet."

# game/a1s1.rpy:252
translate latin a1s1_d03f3ae5:

    # "The only thing I can really feel is a sharp, cold pain behind and above my left eye."
    "Unum fere sentio: acrem gelidumque dolorem post oculum sinistrum et supra eum."

# game/a1s1.rpy:253
translate latin a1s1_d2021c3d:

    # "I try to wiggle my fingers and hands, wondering if I'm having some sort of sleep paralysis."
    "Conor digitos manusque movere, dubitans num paralysi somni affectus sim."

# game/a1s1.rpy:254
translate latin a1s1_10f45fad:

    # "They move, at least I think they do; everything's so dark."
    "Moventur, saltem ita puto; omnia tam obscura sunt."

# game/a1s1.rpy:255
translate latin a1s1_9c3ec7b9:

    # "Am I still in the apartment?"
    "Sumne adhuc in diaeta?"

# game/a1s1.rpy:256
translate latin a1s1_00f2b5db:

    # "Usually there's a little bit of light coming from the balcony because of the street lamps, but everything is pitch-black."
    "Plerumque aliquid lucis e maeniano venit propter lucernas viae; nunc autem omnia sunt atra."

# game/a1s1.rpy:257
translate latin a1s1_9b39a63c:

    # "I start to feel a little panicky, both from the numb feeling and also the idea that I might have gone blind somehow."
    "Paululum iam pavesco, tum propter corporis torporem, tum quia cogito num nescio quo modo caecus factus sim."

# game/a1s1.rpy:258
translate latin a1s1_dae82f25:

    # "I try to remember what happened last."
    "Meminisse conor quid proxime acciderit."

# game/a1s1.rpy:259
translate latin a1s1_289b5d1f:

    # "Did I go out somewhere, maybe a club?"
    "Num alicubi exivi, fortasse in aliquam discothecam?"

# game/a1s1.rpy:260
translate latin a1s1_6e857eba:

    # "The disco."
    "Discotheca."

# game/a1s1.rpy:261
translate latin a1s1_ee08ab67:

    # "Did I take something?"
    "Num aliquid sumpsi?"

# game/a1s1.rpy:262
translate latin a1s1_075ec059:

    # "I start to push myself up and that's when I feel something soft under my hands...and something very hard under it, like concrete."
    "Me attollere incipio; tum aliquid molle sub manibus sentio...et sub eo aliquid durissimum, quasi caementum."

# game/a1s1.rpy:263
translate latin a1s1_73cf309b:

    # "I'm definitely not in a bed right now."
    "Certe nunc in lecto non sum."

# game/a1s1.rpy:264
translate latin a1s1_cef37a22:

    # "Now I really am starting to panic, wondering if I've been kidnapped."
    "Iam vero pavor me corripit: cogito num raptus sim."

# game/a1s1.rpy:265
translate latin a1s1_7e1507a7:

    # "I get on my hands and knees, thankful that at least the numb feeling is going away."
    "Manibus genibusque innitor, gratus quod saltem torpor corporis abit."

# game/a1s1.rpy:266
translate latin a1s1_31be5b3f:

    # "I'm also relieved to find out I'm not blind; I see a soft glow of light outlining what's roughly the shape of a door in front of me."
    "Etiam levatus sum quod caecus non sum: tenuem lucem video, quae ante me aliquid fere instar ianuae circumdat."

# game/a1s1.rpy:267
translate latin a1s1_4fdbaef1:

    # "I open my mouth, about to call out before I force it shut again."
    "Os aperio clamaturus, sed me ipsum cogo ut id rursus claudam."

# game/a1s1.rpy:268
translate latin a1s1_0ba1121e:

    # "I have no idea where I am, or how I got here, but I'm not liking the signs."
    "Nescio omnino ubi sim aut quomodo huc venerim; sed ea quae sentio mihi minime placent."

# game/a1s1.rpy:269
translate latin a1s1_835e8790:

    # "My head throbs a little and I close my eyes tight, trying to steady my breathing, listening to my heart pound."
    "Caput paulum pulsat; oculos arcte claudo et respirationem aequare conor, cordis pulsus audiens."

# game/a1s1.rpy:270
translate latin a1s1_dc20e7df:

    # "I definitely got back to my apartment and I remember going to bed, and then I remember..."
    "Certe ad diaetam redii et memini me cubitum isse; deinde memini..."

# game/a1s1.rpy:271
translate latin a1s1_a0aa26ec:

    # "My eyes fly open as I remember that...wolf creature, staring at me with those blue eyes."
    "Oculi mihi repente aperiuntur cum illius...creaturae lupinae memini, quae me caeruleis illis oculis intuebatur."

# game/a1s1.rpy:272
translate latin a1s1_cb7874a8:

    # "And those teeth!"
    "Et illos dentes!"

# game/a1s1.rpy:273
translate latin a1s1_0103c0fe:

    # "Oh my God, there's no way, there's no fucking way."
    "Deus meus, fieri non potest; nullo modo fieri potest, malum!"

# game/a1s1.rpy:274
translate latin a1s1_ec49e5ca:

    # "I open my eyes again and stare at the soft light, trying to listen."
    "Oculos rursus aperio et tenuem lucem intueor, auscultare conans."

# game/a1s1.rpy:275
translate latin a1s1_d61f7ee1:

    # "There's a constant hum of some kind, a whirring of a large machine."
    "Murmur quoddam continuum est, quasi magnae machinae fremitus."

# game/a1s1.rpy:276
translate latin a1s1_ab5e021d:

    # "It's gentle and almost soothing, but it makes me think I'm in some sort of vehicle."
    "Sonus mollis et paene leniens est, sed facit ut putem me in aliquo vehiculo esse."

# game/a1s1.rpy:277
translate latin a1s1_30bd4fdc:

    # "But I don't feel anything, no bumps or turns..."
    "Nihil tamen sentio: neque succussus neque flexus..."

# game/a1s1.rpy:278
translate latin a1s1_e291e558:

    # "I slowly crawl toward the door, listening as hard as I can for voices, or movement, anything that might tell me someone's nearby."
    "Lente ad ianuam adrepo, quam attentissime auscultans voces aut motus aut quidquid indicare possit aliquem propinquum esse."

# game/a1s1.rpy:279
translate latin a1s1_0f6961e2:

    # "As I get closer to the door I do hear something, a type of beeping and chirping."
    "Cum ianuae appropinquo, aliquid sane audio: sonos breves, quasi pipitus."

# game/a1s1.rpy:280
translate latin a1s1_805651df:

    # "I stay in that position for what feels like a solid fifteen minutes, not hearing anything more."
    "In eo habitu maneo per tempus quod mihi quindecim integra minuta durare videtur, nihil amplius audiens."

# game/a1s1.rpy:281
translate latin a1s1_59eadde4:

    # "I think about trying to open the door, but I realize that might not be a great idea."
    "Cogito de ianua aperienda, sed intellego id fortasse non esse prudentissimum."

# game/a1s1.rpy:282
translate latin a1s1_10bc3e4b:

    # "I still don't know if that wolf is real...no, I know he isn't real."
    "Adhuc nescio num lupus ille verus sit...immo scio eum verum non esse."

# game/a1s1.rpy:283
translate latin a1s1_f05fef11:

    # "What's more likely is that someone slipped something into my drink and I hallucinated everything."
    "Probabilius est aliquem aliquid in potionem meam furtim infudisse atque me omnia mente finxisse."

# game/a1s1.rpy:284
translate latin a1s1_c63e16de:

    # "I had laughed off my parents' warnings that tourists are vulnerable in Rome, but now that doesn't seem so crazy."
    "Monita parentum, peregrinatores Romae periculis obnoxios esse, deriseram; iam vero ea non tam inepta videntur."

# game/a1s1.rpy:285
translate latin a1s1_538547c6:

    # "Someone had drugged me, followed me to my apartment, then kidnapped me."
    "Aliquis me medicamento stupefecit, ad diaetam secutus est, deinde rapuit."

# game/a1s1.rpy:286
translate latin a1s1_fc6ea5f3:

    # "I need something, a weapon, before I try opening the door."
    "Aliqua re, aliquo telo mihi opus est, antequam ianuam aperire conor."

# game/a1s1.rpy:287
translate latin a1s1_539b7556:

    # "I feel like I'm in a closet of some kind so there's probably something here that I can use..."
    "In quodam armario me esse puto; hic igitur fortasse aliquid est quo uti possim..."

# game/a1s1.rpy:288
translate latin a1s1_36d81232:

    # "Slowly, I get on my knees and start moving forward, waving my hands out in front of me."
    "Lente genibus innitor et progredior, manus ante me huc illuc agitando."

# game/a1s1.rpy:289
translate latin a1s1_0f0e81ad:

    # "If I can find the shelves then I can just feel around for something solid and—"
    "Si pluteos invenero, manibus quaerere potero aliquid solidum et—"

# game/a1s1.rpy:291
translate latin a1s1_70ae9824:

    # "My hand sweeps what feels like a box and what follows is a clang of metal as something falls to the floor."
    "Manu id quod arca videtur perstringo; tum clangor ferri auditur, cum aliquid in pavimentum cadit."

# game/a1s1.rpy:292
translate latin a1s1_a8aedc81:

    # "I cringe, squeezing my eyes shut as the sound echoes around the room I'm in."
    "Contremisco et oculos arcte claudo, dum sonus per cubiculum ubi sum resonat."

# game/a1s1.rpy:293
translate latin a1s1_97acbeef:

    # "I kneel there in complete silence, stunned."
    "Illic genibus innixus, stupens, omnino taceo."

# game/a1s1.rpy:294
translate latin a1s1_74d4cc3a:

    # "And that's when light spills over my body, followed by a large shadow."
    "Tum lux corpus meum perfundit, deinde magna umbra."

# game/a1s1.rpy:295
translate latin a1s1_8a1ee62e:

    # a "\"Oh hey, you're awake! Did you know he was awake?\""
    a "\"Oh, heus, vigilas! Sciebasne eum vigilare?\""

# game/a1s1.rpy:296
translate latin a1s1_153b1bf3:

    # unk "\"Yes, for approximately .2 hours—\""
    unk "\"Ita, iam per .2 fere horas—\""

# game/a1s1.rpy:297
translate latin a1s1_dcb96c62:

    # a "\"I swear to the Gods, why are you so useless?\""
    a "\"Per Deos iuro: cur tam inutilis es?\""

# game/a1s1.rpy:298
translate latin a1s1_a5c77630:

    # "I sit there, not having turned around yet, but the shadow gets bigger and I feel him looming over me."
    "Illic sedeo nondum me convertens; umbra autem crescit, eumque supra me imminere sentio."

# game/a1s1.rpy:299
translate latin a1s1_2d45f00c:

    # "I get a whiff of lavender."
    "Lavandulae odor ad me pervenit."

# game/a1s1.rpy:300
translate latin a1s1_758ccfed:

    # "Finally, I slowly turn my head and see the wolf."
    "Tandem caput lente verto et lupum video."

# game/a1s1.rpy:304
translate latin a1s1_d58c4651:

    # "He towers over me, his broad muzzle pointed down so that he can look me right in the eye."
    "Supra me eminet, lato rostro demisso ut recta mihi in oculos aspicere possit."

# game/a1s1.rpy:305
translate latin a1s1_a0f5fdc4:

    # "While his size and general demeanor are intimidating, his eyes are warm and friendly."
    "Quamquam magnitudo eius habitusque terrent, oculi benigni et amicales sunt."

# game/a1s1.rpy:306
translate latin a1s1_88fd5c4f:

    # "That doesn't really matter to me right now as I realize that I hadn't been dreaming or hallucinating earlier..."
    "Hoc nunc mihi parum refert, cum intellegam me antea neque somniavisse neque mente falsas imagines vidisse..."

# game/a1s1.rpy:307
translate latin a1s1_9389d513:

    # "...or the dream/hallucination is ongoing."
    "...aut somnium illaeve falsae imagines adhuc perseverant."

# game/a1s1.rpy:308
translate latin a1s1_38aad77c:

    # "The wolf moves toward me and I immediately scoot back until the shelves behind me dig into my spine."
    "Lupus ad me accedit; ego statim retro me traho, donec plutei a tergo spinam mihi premunt."

# game/a1s1.rpy:309
translate latin a1s1_8a6c55e4:

    # "I vaguely notice the metal thing that I'd knocked over earlier."
    "Rem metallicam quam antea deieceram vix animadverto."

# game/a1s1.rpy:310
translate latin a1s1_053230ef:

    # "It's a polygon-shaped thing with a long cord running out of it."
    "Res pluribus lateribus est, longo funiculo ex ea exeunte."

# game/a1s1.rpy:311
translate latin a1s1_b526df15:

    # unk "\"Remember the human doesn't know about the {i}Galaxias{/i}; proceed with caution.\""
    unk "\"Memento: homo {i}Galaxias{/i} nondum novit; caute procede.\""

# game/a1s1.rpy:312
translate latin a1s1_790bfe0c:

    # "The wolf's ears flick before he visibly tries to right his expression into a smile."
    "Aures lupi moventur; deinde aperte conatur vultum in risum componere."

# game/a1s1.rpy:314
translate latin a1s1_fc469198:

    # a "\"H—hello human, sorry, I mean [mc], right?\""
    a "\"S—salve, homo; ignosce, [mc] dicere volui, nonne?\""

# game/a1s1.rpy:315
translate latin a1s1_038f75e9:

    # "Again, I get caught up in watching the movements of his mouth counter to what I'm hearing in my brain."
    "Rursus intentus sum motibus oris eius, qui iis quae in cerebro audio non congruunt."

# game/a1s1.rpy:316
translate latin a1s1_96ce96fd:

    # "Then I notice that he's waiting, watching me intently."
    "Tum animadverto eum exspectare, me intentis oculis observantem."

# game/a1s1.rpy:317
translate latin a1s1_0027a5a0:

    # "I open my mouth, then close it, then nod."
    "Os aperio, deinde claudo, tum annuo."

# game/a1s1.rpy:319
translate latin a1s1_b1003efd:

    # "The wolf still stares at me, seeming not to understand."
    "Lupus adhuc me intuetur, quasi non intellegat."

# game/a1s1.rpy:320
translate latin a1s1_128c51ae:

    # a "\"Right?\""
    a "\"Nonne?\""

# game/a1s1.rpy:321
translate latin a1s1_c8af9c77:

    # "The silence stretches on until I finally force myself to speak."
    "Silentium producitur, donec tandem me ipsum loqui cogo."

# game/a1s1.rpy:322
translate latin a1s1_499b85ea:

    # m "\"Yes.\""
    m "\"Ita.\""

# game/a1s1.rpy:323
translate latin a1s1_ac0729a6:

    # "It comes out in barely a whisper."
    "Vox mihi vix ultra susurrum exit."

# game/a1s1.rpy:325
translate latin a1s1_8dad4b44:

    # a "\"Great! So now that we understand that, I can tell you that I'm from the star {i}Stella Vita{/i}, very far from here.\""
    a "\"Optime! Nunc igitur, cum id intellegamus, tibi dicere possum me a stella {i}Stella Vita{/i} venire, quae longissime hinc abest.\""

# game/a1s1.rpy:326
translate latin a1s1_d2535d3d:

    # "The wolf sets his paws far apart, his eyes wide as he emphasizes the distance."
    "Lupus manus longe inter se diducit, oculis late apertis ut spatium significet."

# game/a1s1.rpy:327
translate latin a1s1_960bba08:

    # "He's talking to me in a way one might to a very dumb two-year-old."
    "Sic mecum loquitur ut quis cum infante duos annos nato, mente tardissimo, loquatur."

# game/a1s1.rpy:328
translate latin a1s1_80b66eda:

    # a "\"I live on a moon called Adastra. Do you know what a moon is? You live on what's called a planet.\""
    a "\"Lunam incolo cui nomen Adastra est. Scisne quid sit luna? Tu id incolis quod planeta vocatur.\""

# game/a1s1.rpy:329
translate latin a1s1_b4df7430:

    # "I stare at him for a moment, almost offended despite my continuing shock."
    "Eum paulisper intueor, paene offensus quamquam adhuc stupeo."

# game/a1s1.rpy:331
translate latin a1s1_5b7aec9d:

    # "Amicus smiles gently."
    "Amicus leniter subridet."

# game/a1s1.rpy:332
translate latin a1s1_769c331f:

    # a "\"A moon is a large—\""
    a "\"Luna est magna—\""

# game/a1s1.rpy:333
translate latin a1s1_6900e072:

    # m "\"I know what a moon is.\""
    m "\"Scio quid sit luna.\""

# game/a1s1.rpy:335
translate latin a1s1_f77dfa4a:

    # "Amicus blinks at me."
    "Amicus palpebras movens me intuetur."

# game/a1s1.rpy:336
translate latin a1s1_a482770e:

    # m "\"We have one.\""
    m "\"Unam habemus.\""

# game/a1s1.rpy:337
translate latin a1s1_2cbda01f:

    # "My words feel automatic...actually everything feels like it's on auto-pilot right now."
    "Verba mihi paene sponte excidunt...immo nunc omnia quasi gubernatione automatica fiunt."

# game/a1s1.rpy:339
translate latin a1s1_f54a9733:

    # a "\"Oh! Well, I didn't know that. That's great!\""
    a "\"Oh! Id sane nesciebam. Quam bonum!\""

# game/a1s1.rpy:340
translate latin a1s1_6a9a5981:

    # "There's an awkward silence as the two of us stare at each other."
    "Silentium incommodum est, dum alter alterum intuetur."

# game/a1s1.rpy:341
translate latin a1s1_2d16ed10:

    # "The initial fear is wearing off."
    "Primus ille pavor paulatim remittitur."

# game/a1s1.rpy:342
translate latin a1s1_365e654c:

    # "I feel that if this alien is meaning to hurt me, he would have done it by now."
    "Hic alienigena, si mihi nocere vellet, id, opinor, iam fecisset."

# game/a1s1.rpy:343
translate latin a1s1_7fcc53a5:

    # "At least...for now."
    "Saltem...adhuc."

# game/a1s1.rpy:344
translate latin a1s1_f36df3b1:

    # "Amicus rubs his paws together nervously."
    "Amicus sollicitus manus inter se fricat."

# game/a1s1.rpy:345
translate latin a1s1_68298918:

    # a "\"Um...are you hungry?\""
    a "\"Hem...esurisne?\""

# game/a1s1.rpy:346
translate latin a1s1_0a18126c:

    # "He motions at his mouth, then rubs his stomach while licking his lips."
    "Ad os suum significat, deinde ventrem fricat et labia lingit."

# game/a1s1.rpy:348
translate latin a1s1_ead8f92b:

    # a "\"Mmmmmh.\""
    a "\"Mmmmmh.\""

# game/a1s1.rpy:349
translate latin a1s1_16af2423:

    # "Again, gestures and expressions that I have no trouble interpreting."
    "Rursus gestus vultusque quos facile intellego."

# game/a1s1.rpy:350
translate latin a1s1_f4de058d:

    # "The only alien thing about him is his appearance."
    "Sola eius species aliena est."

# game/a1s1.rpy:351
translate latin a1s1_15ceed41:

    # m "\"I—I don't know.\""
    m "\"N—nescio.\""

# game/a1s1.rpy:353
translate latin a1s1_92b2af0b:

    # "The wolf frowns, almost looking frustrated."
    "Lupus frontem contrahit, paene frustratus."

# game/a1s1.rpy:354
translate latin a1s1_e91da4e9:

    # "His slow speech gets even slower."
    "Iam lente loquebatur; nunc etiam tardius."

# game/a1s1.rpy:355
translate latin a1s1_bca898d5:

    # a "\"Well...why don't we give it a try, then?\""
    a "\"Bene...quin igitur experimur?\""

# game/a1s1.rpy:356
translate latin a1s1_362b6ad3:

    # "I guess my answers don't exactly make me seem intelligent."
    "Credo responsa mea me non admodum intellegentem ostendere."

# game/a1s1.rpy:357
translate latin a1s1_3d741ce9:

    # "But I don't know how else to respond."
    "Sed nescio quo alio modo respondeam."

# game/a1s1.rpy:359
translate latin a1s1_84865bfb:

    # a "\"Why don't you come out onto the deck with me? I'll make something.\""
    a "\"Quin mecum in tabulatum venis? Aliquid parabo.\""

# game/a1s1.rpy:360
translate latin a1s1_643c336d:

    # "Amicus gives an exaggerated \"come on\" gesture with both paws as he walks backwards...straight into the wall as he misses the door."
    "Amicus utraque manu insigni gestu significat \"age\", dum retro incedit...recta in parietem, ab ianua aberrans."

# game/a1s1.rpy:364
translate latin a1s1_216c9f25:

    # a "\"Ow! Uh, yeah, let's go human.\""
    a "\"Au! Hem, ita, eamus, homo.\""

# game/a1s1.rpy:365
translate latin a1s1_1ee0652a:

    # "He rubs the back of his head with a wince before turning and walking out the door."
    "Occiput fricat, vultu dolentis; deinde se vertit et per ianuam exit."

# game/a1s1.rpy:368
translate latin a1s1_209a8389:

    # "I stare at the open door for a moment before slowly getting up and following him, walking over a brown shag rug; the soft thing I'd been laying on."
    "Ianuam apertam paulisper intueor; deinde lente surgo eumque sequor, super tapetem fuscum villosum incedens, id molle super quod iacueram."

# game/a1s1.rpy:371
translate latin a1s1_1c3668e4:

    # "That's when I'm standing in the middle of what looks like something straight out of a sci-fi movie."
    "Tum inter ea sto quae prorsus e pellicula fictionis scientificae sumpta esse videntur."

# game/a1s1.rpy:372
translate latin a1s1_d3aafc8b:

    # "It's small and cramped, but the amount of unfamiliar, glowing technology is almost overwhelming."
    "Locus parvus et angustus est; sed tanta vis instrumentorum ignotorum atque lucentium me paene obruit."

# game/a1s1.rpy:373
translate latin a1s1_2f49535c:

    # "Glass panels cover almost every inch of the walls around me, displaying images and characters that I can't even come close to understanding."
    "Tabulae vitreae fere totos parietes circa me tegunt, imagines litterasque exhibentes quas intellegere prorsus nequeo."

# game/a1s1.rpy:374
translate latin a1s1_a16ecf0e:

    # "Straight ahead of me are large windows, looking out into blackness dotted with specks of light."
    "Recta ante me magnae fenestrae sunt, per quas tenebrae parvis luminibus distinctae videntur."

# game/a1s1.rpy:375
translate latin a1s1_9faf8a1c:

    # "Specks of light..."
    "Puncta lucis..."

# game/a1s1.rpy:376
translate latin a1s1_b8d229da:

    # "I'm in a space ship."
    "In nave spatiali sum."

# game/a1s1.rpy:377
translate latin a1s1_e4f61777:

    # "Where the hell is he taking me?"
    "Quo me, malum, ducit?"

# game/a1s1.rpy:378
translate latin a1s1_3ea9be29:

    # "Amicus is over to my right side, messing with what I can only describe as a large Espresso machine growing out of the side of the spaceship."
    "Amicus ad dextram meam est, tractans id quod nonnisi magnam machinam coffeae expressae parandae e latere navis spatialis quasi excrescentem appellare possum."

# game/a1s1.rpy:379
translate latin a1s1_2d070ccd:

    # "He's holding a cup under a nozzle, ducking down a little to stare at the opening."
    "Calicem sub fistula tenet, paululum se demittens ut foramen aspiciat."

# game/a1s1.rpy:380
translate latin a1s1_56536181:

    # "He notices me looking."
    "Animadvertit me spectare."

# game/a1s1.rpy:382
translate latin a1s1_eac2e36f:

    # a "\"Heh, takes a while to warm up...I have to warn you that it's not very good, but it's probably better than most of what you eat on your moon...planet, I mean.\""
    a "\"Heh, aliquantum temporis opus est ut incalescat...Monendus es hoc non valde sapidum esse, sed fortasse melius quam pleraque quae in luna vestra editis...in planeta, dicere volui.\""

# game/a1s1.rpy:383
translate latin a1s1_eef02891:

    # "Just as he's talking a very thick globule of brown sludge shoots out of the nozzle, half of it missing the cup."
    "Dum loquitur, globus crassissimae materiae lutosae fuscae e fistula erumpit, cuius dimidia pars extra calicem cadit."

# game/a1s1.rpy:385
translate latin a1s1_8b9e4bab:

    # a "\"Ah, dammit.\""
    a "\"Ah, malum!\""

# game/a1s1.rpy:386
translate latin a1s1_e3acdd97:

    # "The wolf hastily moves the cup to catch the rest of it while reaching over with his other paw to snatch up a rag from a hook on the side of the machine."
    "Lupus calicem festinanter movet ut reliquum excipiat; altera manu pannum e hamo in latere machinae rapit."

# game/a1s1.rpy:388
translate latin a1s1_7edc4041:

    # a "\"Sorry, this thing is near broken. Do you want to sit down?\""
    a "\"Ignosce, hoc instrumentum paene fractum est. Visne sedere?\""

# game/a1s1.rpy:389
translate latin a1s1_a133266e:

    # "He nods his head over at one of the two seats in front of the windows."
    "Capite ad alteram duarum sellarum ante fenestras annuit."

# game/a1s1.rpy:390
translate latin a1s1_39269607:

    # a "\"Just, uh, don't touch any of the bright lights, okay?\""
    a "\"Modo, hem, ne quid ex luminibus claris tangas, bene?\""

# game/a1s1.rpy:392
translate latin a1s1_fce7187e:

    # "I make my way over to the front of the deck, still waiting to wake up."
    "Ad partem priorem tabulati eo, adhuc exspectans dum expergiscar."

# game/a1s1.rpy:393
translate latin a1s1_68e55c7a:

    # "I stand beside the seat, reaching out to touch the soft red bristles of the helmet and the wings on the sides."
    "Iuxta sellam sto et manum porrigo ut molles setas rubras galeae atque alas ad latera eius attingam."

# game/a1s1.rpy:394
translate latin a1s1_ab97a796:

    # "This only enforces the feeling that I'm hallucinating or dreaming."
    "Hoc eo magis me falsas imagines videre aut somniare credere facit."

# game/a1s1.rpy:395
translate latin a1s1_64650b80:

    # "There's a strange Roman influence to Amicus and the ship, one that's almost cartoonish."
    "Amicus et navis mirum quendam morem Romanum referunt, paene ut in picturis animatis."

# game/a1s1.rpy:396
translate latin a1s1_bcab87f8:

    # "Has my obsession over Rome gone too far?"
    "Num amor meus Romae iam nimius est?"

# game/a1s1.rpy:397
translate latin a1s1_24c0ed8a:

    # "I can just imagine myself in some Italian hospital right now, babbling about Roman wolf aliens."
    "Facile me nunc in aliquo valetudinario Italico fingo, alienigenas lupinos Romanos garriens."

# game/a1s1.rpy:399
translate latin a1s1_972bf95c:

    # a "\"Go on and sit.\""
    a "\"Age, sede.\""

# game/a1s1.rpy:400
translate latin a1s1_a849b504:

    # "Amicus plants himself heavily in the seat next to mine, holding two cups of what looks like brown sludge."
    "Amicus in sellam iuxta meam graviter considit, duos calices tenens materiae quae lutum fuscum esse videtur."

# game/a1s1.rpy:401
translate latin a1s1_0cec13dc:

    # "He holds one out to me."
    "Alterum mihi porrigit."

# game/a1s1.rpy:402
translate latin a1s1_d081d670:

    # "I take it gingerly before sitting down."
    "Eum caute accipio antequam sedeo."

# game/a1s1.rpy:403
translate latin a1s1_1b119778:

    # "Looking into the cup, the \"food\" has the consistency and look of half-melted chocolate ice cream."
    "Calicem inspicio; \"cibus\" formam crassitudinemque gelati socolatae semiliquefacti habet."

# game/a1s1.rpy:404
translate latin a1s1_6b4da191:

    # "Except it's warm and smells like dirt, like literal mud."
    "Nisi quod calet et terram olet, quasi verum lutum."

# game/a1s1.rpy:405
translate latin a1s1_a1137124:

    # "I scrunch my nose up at it, which Amicus notices."
    "Nasum corrugo, quod Amicus animadvertit."

# game/a1s1.rpy:407
translate latin a1s1_cee7e6e4:

    # a "\"Haha! yeah, it's not the best. I actually had some good food that I brought along with me, but I ate it all before I got here.\""
    a "\"Haha! Ita, non optimus est. Bonum quidem cibum mecum attuleram, sed omnem antequam huc veni comedi.\""

# game/a1s1.rpy:408
translate latin a1s1_a167fbc5:

    # "The wolf shrugs then settles excitedly into his seat."
    "Lupus umeros tollit, deinde alacer in sella se componit."

# game/a1s1.rpy:410
translate latin a1s1_1ec87302:

    # a "\"So tell me about where you're from! What's life like on Earth?\""
    a "\"Narra igitur mihi de loco unde venis! Qualis in Terra vita est?\""

# game/a1s1.rpy:411
translate latin a1s1_ddb84a43:

    # m "\"Um, it's...okay?\""
    m "\"Hem, vita...haud mala est?\""

# game/a1s1.rpy:413
translate latin a1s1_b7935aed:

    # a "\"Okay, well, what's your occupation?\""
    a "\"Bene igitur, quod munus exerces?\""

# game/a1s1.rpy:414
translate latin a1s1_71d94276:

    # m "\"I'm...a student.\""
    m "\"Ego...discipulus sum.\""

# game/a1s1.rpy:415
translate latin a1s1_41b525ab:

    # a "\"Oh, what discipline?\""
    a "\"Oh, cui disciplinae studes?\""

# game/a1s1.rpy:416
translate latin a1s1_37fe3f5e:

    # "I try to adjust to the surreal feeling of talking to this wolf."
    "Huic insolitae rei assuescere conor: cum hoc lupo loquor."

# game/a1s1.rpy:417
translate latin a1s1_26b29875:

    # m "\"I don't know yet. I was looking into history; Greek and Roman studies.\""
    m "\"Nondum scio. De historia cogitabam, de studiis Graecis et Romanis.\""

# game/a1s1.rpy:418
translate latin a1s1_5d398362:

    # a "\"Hm...\""
    a "\"Hm...\""

# game/a1s1.rpy:419
translate latin a1s1_582f5743:

    # "That seems confusing to him for some reason."
    "Id eum nescio cur confundere videtur."

# game/a1s1.rpy:420
translate latin a1s1_d36b52a8:

    # a "\"Do you have an emperor? What's he like?\""
    a "\"Imperatorem habetis? Qualis est?\""

# game/a1s1.rpy:421
translate latin a1s1_9197e014:

    # "I catch myself staring at his mouth again, at the weird way his mouth is un-synced with his words."
    "Me rursus os eius spectantem invenio, illum mirum modum quo motus oris cum verbis non congruunt."

# game/a1s1.rpy:422
translate latin a1s1_544f5dd5:

    # m "\"N—no...\""
    m "\"N—non...\""

# game/a1s1.rpy:424
translate latin a1s1_8a6defb9:

    # a "\"Then how—\""
    a "\"Tum quomodo—\""

# game/a1s1.rpy:425
translate latin a1s1_4fd30174:

    # "I interrupt him."
    "Eum interpello."

# game/a1s1.rpy:426
translate latin a1s1_3d9c52d8:

    # m "\"Why isn't your mouth matching up with the sounds you're making?\""
    m "\"Cur motus oris tui sonis quos edis non congruunt?\""

# game/a1s1.rpy:427
translate latin a1s1_72e548c1:

    # a "\"Eh?\""
    a "\"Eh?\""

# game/a1s1.rpy:428
translate latin a1s1_88475498:

    # "Even with the space ship and alien around me, it's the weird distortion of feeling like I'm watching a dubbed movie that has me most unsettled."
    "Ne navis quidem spatialis aut alienigena circa me tam me perturbant quam haec insolita dissensio, quasi pelliculam aliis vocibus redditam spectem."

# game/a1s1.rpy:430
translate latin a1s1_0e2194aa:

    # a "\"Oh!\""
    a "\"Oh!\""

# game/a1s1.rpy:431
translate latin a1s1_11b8dc0c:

    # "Amicus points a finger at me to a spot just above my left eye."
    "Amicus digito locum statim supra oculum sinistrum mihi monstrat."

# game/a1s1.rpy:432
translate latin a1s1_6ea5a501:

    # a "\"I gave you a Lingua. It helps you understand me.\""
    a "\"Linguam tibi dedi. Ea te adiuvat ut me intellegas.\""

# game/a1s1.rpy:433
translate latin a1s1_c67597be:

    # "I stare at him, but he doesn't offer anything more."
    "Eum intueor, sed nihil amplius explicat."

# game/a1s1.rpy:434
translate latin a1s1_98dbe3cb:

    # m "\"...How?\""
    m "\"...Quomodo?\""

# game/a1s1.rpy:436
translate latin a1s1_ac8a2ce6:

    # a "\"Oh, well it, uh, sort of attaches to the language center in the brain.\""
    a "\"Oh, ea, hem, quodam modo parti cerebri ubi lingua tractatur adhaeret.\""

# game/a1s1.rpy:437
translate latin a1s1_08791113:

    # a "\"It's very smart; it learns from the host brain and is able to interpret the eight major Galaxias languages for them.\""
    a "\"Valde sollers est: e cerebro hospitis discit et octo praecipuas linguas Galaxias ei interpretari potest.\""

# game/a1s1.rpy:438
translate latin a1s1_920b6365:

    # m "\"And...how does it do that?\""
    m "\"Et...quomodo id facit?\""

# game/a1s1.rpy:440
translate latin a1s1_d4fc81df:

    # a "\"Uh, well, our brains are structured in similar ways, at least among Sapients, so it works almost universally.\""
    a "\"Hem, cerebra nostra simili modo structa sunt, saltem inter Sapientes; itaque paene omnibus convenit.\""

# game/a1s1.rpy:441
translate latin a1s1_7827e68d:

    # a "\"Honestly, it's parental tech, so I'm not fully sure of how it works. None of us do, but it does work.\""
    a "\"Ut verum dicam, ars Parentum est; itaque non plane scio quomodo operetur. Nemo nostrum scit, sed operatur.\""

# game/a1s1.rpy:442
translate latin a1s1_bd610ca3:

    # "Amicus continues to look at me, clearly concerned about something."
    "Amicus me adhuc intuetur, aperte de aliqua re sollicitus."

# game/a1s1.rpy:443
translate latin a1s1_8417fadc:

    # "But I'm concerned, too."
    "Sed ego quoque sollicitus sum."

# game/a1s1.rpy:444
translate latin a1s1_e023eaa1:

    # m "\"How did you get it...into my brain.\""
    m "\"Quomodo eam...in cerebrum meum immisisti.\""

# game/a1s1.rpy:445
translate latin a1s1_1ecffb06:

    # a "\"Uh...\""
    a "\"Eh...\""

# game/a1s1.rpy:447
translate latin a1s1_42570b6d:

    # a "\"You know, you ask a lot of questions.\""
    a "\"Scis, multas quaestiones proponis.\""

# game/a1s1.rpy:448
translate latin a1s1_e3a5312e:

    # "I stare at him."
    "Eum fixis oculis intueor."

# game/a1s1.rpy:449
translate latin a1s1_d2d0a020:

    # m "\"Well, this is all kind of new to me. Should I not be asking questions?\""
    m "\"Haec omnia mihi nova sunt. Num quaestiones proponere non debeo?\""

# game/a1s1.rpy:451
translate latin a1s1_dc36b687:

    # a "\"It's fine. I've just never had a child ask me questions, really. Anyway, there's a device that inserts it. I was lucky to find one left over on the ship.\""
    a "\"Licet. Modo nemo e Liberis umquam me interrogavit, re vera. Ceterum instrumentum est quo immittitur. Forte in nave unum relictum inveni.\""

# game/a1s1.rpy:452
translate latin a1s1_fa44efc7:

    # "Inserts it."
    "Quo immittitur."

# game/a1s1.rpy:453
translate latin a1s1_1868ae8c:

    # "I rub the spot between my eye and eye socket, the skin slightly tender."
    "Locum inter oculum et orbitam frico; cutis paulum dolet."

# game/a1s1.rpy:455
translate latin a1s1_ff482f7a:

    # a "\"Does it hurt? That should wear off in a few hours.\""
    a "\"Doletne? Paucis horis dolor cessare debet.\""

# game/a1s1.rpy:456
translate latin a1s1_1756ca87:

    # "I stare at Amicus for a few moments, then down into my cup, feeling a bit sick."
    "Amicum pauca momenta intueor, deinde in calicem aspicio, paulum nauseans."

# game/a1s1.rpy:457
translate latin a1s1_04aa5eb6:

    # "Staring at the brown mush isn't helping."
    "Illam pultem fuscam intueri nihil adiuvat."

# game/a1s1.rpy:459
translate latin a1s1_fcf502c8:

    # a "\"Need help with that? You can eat it like this.\""
    a "\"Visne auxilium? Sic edere potes.\""

# game/a1s1.rpy:460
translate latin a1s1_d7063bef:

    # "He dips his muzzle down toward his own cup."
    "Rostrum ad calicem suum inclinat."

# game/a1s1.rpy:461
translate latin a1s1_a4e5521c:

    # "He sticks out a long, thick, pink tongue, pressing it into the sludge before cupping it and bringing it back up into his mouth."
    "Linguam longam crassam roseam exserit et in pultem premit; deinde eam concavam facit atque rursus in os tollit."

# game/a1s1.rpy:462
translate latin a1s1_ad6356a8:

    # "He pulls a bit of a face before smiling."
    "Vultum paulum contorquet, deinde subridet."

# game/a1s1.rpy:464
translate latin a1s1_4be88848:

    # a "\"Not terrible!\""
    a "\"Non pessimum est!\""

# game/a1s1.rpy:465
translate latin a1s1_11a936d8:

    # "Then he looks at me a bit closer."
    "Tum propius me aspicit."

# game/a1s1.rpy:467
translate latin a1s1_8971992d:

    # a "\"Wait, you do have a tongue, right?\""
    a "\"Exspecta, linguam sane habes, nonne?\""

# game/a1s1.rpy:468
translate latin a1s1_a4fc5b6b:

    # "I stare back at him for a moment before setting the cup to the side on the armrest."
    "Eum paulisper vicissim intueor, deinde calicem ad latus in fulcrum brachii depono."

# game/a1s1.rpy:471
translate latin a1s1_9e2304d6:

    # m "\"What are you doing?\""
    m "\"Quid agis?\""

# game/a1s1.rpy:473
translate latin a1s1_c42c8b9e:

    # a "\"Huh?\""
    a "\"Hem?\""

# game/a1s1.rpy:474
translate latin a1s1_d63c7aaa:

    # m "\"What is all this, where are you taking me?\""
    m "\"Quid haec omnia sunt, quo me ducis?\""

# game/a1s1.rpy:475
translate latin a1s1_601967be:

    # "At this point I'm starting to get over the shock."
    "Iam primus stupor remitti incipit."

# game/a1s1.rpy:476
translate latin a1s1_a2a6a213:

    # "I'm also starting to get annoyed at this alien's complete disregard for...basically everything to do with me."
    "Etiam irasci incipio, quod hic alienigena omnino neglegit...fere omnia quae ad me pertinent."

# game/a1s1.rpy:477
translate latin a1s1_2551b837:

    # m "\"You kidnapped me, you left me in a closet, you're feeding me what looks like shit, and now you tell me you jabbed something into my brain?\""
    m "\"Me rapuisti, in armario reliquisti, pascis cibo qui stercus esse videtur; nunc vero dicis te aliquid in cerebrum meum infixisse?\""

# game/a1s1.rpy:479
translate latin a1s1_96863100:

    # "Amicus actually flinches at that."
    "Amicus ad haec vere expavescit."

# game/a1s1.rpy:480
translate latin a1s1_af059a4e:

    # a "\"D-does it still hurt? I can give you a pain manager—\""
    a "\"A—adhuc dolet? Moderatorem doloris tibi dare possum—\""

# game/a1s1.rpy:481
translate latin a1s1_76231e5e:

    # m "\"I don't really want anything from you. What is all of this?\""
    m "\"Nihil sane a te volo. Quid sunt haec omnia?\""

# game/a1s1.rpy:482
translate latin a1s1_d841db44:

    # "The wolf just stares at me, wide-eyed."
    "Lupus me tantum oculis late apertis intuetur."

# game/a1s1.rpy:483
translate latin a1s1_4da4b17f:

    # "It's like he didn't even consider me being capable of being upset."
    "Quasi ne cogitaverit quidem me posse irasci."

# game/a1s1.rpy:484
translate latin a1s1_39a9302d:

    # a "\"Hey, it's okay—\""
    a "\"Heus, nihil mali est—\""

# game/a1s1.rpy:485
translate latin a1s1_d274d0cb:

    # m "\"You kidnapped me.\""
    m "\"Me rapuisti.\""

# game/a1s1.rpy:486
translate latin a1s1_5b62667a:

    # "I feel myself getting more panicked, both from the realization of what's happened and what's currently happening."
    "Pavor me magis magisque corripit, cum intellegam tum quid acciderit, tum quid nunc accidat."

# game/a1s1.rpy:487
translate latin a1s1_e9db3d3f:

    # a "\"No! Well, I mean—\""
    a "\"Non! Immo, dicere volui—\""

# game/a1s1.rpy:488
translate latin a1s1_7eb2e208:

    # m "\"You like, tazed me or something!\""
    m "\"Me quasi telo electrico stupefecisti aut nescio quid!\""

# game/a1s1.rpy:489
translate latin a1s1_3c8805f7:

    # a "\"What?\""
    a "\"Quid?\""

# game/a1s1.rpy:490
translate latin a1s1_f0910897:

    # m "\"You electrocuted me.\""
    m "\"Me electricitate percussisti.\""

# game/a1s1.rpy:491
translate latin a1s1_7c665dcb:

    # a "\"No! It's not electricity.\""
    a "\"Non! Non est electricitas.\""

# game/a1s1.rpy:492
translate latin a1s1_45fa820f:

    # m "\"That doesn't make it better!\""
    m "\"Hoc rem meliorem non facit!\""

# game/a1s1.rpy:493
translate latin a1s1_1ae3b06c:

    # "For a brief moment I think about overpowering this wolf, somehow turning the ship around if I can figure it out."
    "Paulisper cogito num hunc lupum vi superare possim et quoquo modo navem convertere, si artem regendi invenero."

# game/a1s1.rpy:494
translate latin a1s1_ebed2e1c:

    # com "\"Sensing hostile intent. Proceed with caution, Amicus.\""
    com "\"Infestum animum percipio. Caute procede, Amice.\""

# game/a1s1.rpy:496
translate latin a1s1_bb80c469:

    # "Amicus doesn't say anything and I see him gripping into his cup tightly."
    "Amicus nihil dicit; eum calicem arcte prehendere video."

# game/a1s1.rpy:497
translate latin a1s1_482cc6e6:

    # "I get the odd feeling that he didn't expect me to point these things out to him."
    "Mirum mihi videtur eum non exspectavisse me haec sibi obiecturum esse."

# game/a1s1.rpy:498
translate latin a1s1_fa40c7d5:

    # "Did he think that I was that unintelligent?"
    "Num me tam stultum esse putabat?"

# game/a1s1.rpy:499
translate latin a1s1_f133bbd8:

    # "I can tell he's calculating something in his head right now, and that makes me nervous."
    "Video eum nunc aliquid animo reputare, quod me sollicitat."

# game/a1s1.rpy:500
translate latin a1s1_32db0c6a:

    # "Maybe I should have just played dumb."
    "Fortasse stultitiam simulare debui."

# game/a1s1.rpy:501
translate latin a1s1_4877c7bc:

    # "We stare at each other for a long while until Amicus's steely gaze forces me to look away."
    "Diu alter alterum intuemur, donec durus Amici obtutus me cogit oculos avertere."

# game/a1s1.rpy:502
translate latin a1s1_323887e5:

    # "I choose to glance up at the ceiling, deciding to change the subject and give myself some time to just think."
    "Laquear aspicere eligo, rem mutaturus ut mihi tempus detur quo tantum cogitem."

# game/a1s1.rpy:503
translate latin a1s1_03388e1b:

    # m "\"What is that thing?\""
    m "\"Quid illud est?\""

# game/a1s1.rpy:504
translate latin a1s1_256eb462:

    # "Amicus clears his throat."
    "Amicus tussicula fauces purgat."

# game/a1s1.rpy:505
translate latin a1s1_3c8805f7_1:

    # a "\"What?\""
    a "\"Quid?\""

# game/a1s1.rpy:506
translate latin a1s1_b8592b9d:

    # m "\"That voice.\""
    m "\"Vox illa.\""

# game/a1s1.rpy:507
translate latin a1s1_938ffb0c:

    # "I nod up at the ceiling, in the vague direction where I heard the sound come from."
    "Capite ad laquear annuo, fere ad locum unde sonum audivi."

# game/a1s1.rpy:508
translate latin a1s1_cdb07352:

    # "The thing that can apparently sense my hostile intents."
    "Res illa quae, ut videtur, infestum animum meum sentire potest."

# game/a1s1.rpy:510
translate latin a1s1_0e2194aa_1:

    # a "\"Oh!\""
    a "\"Oh!\""

# game/a1s1.rpy:511
translate latin a1s1_886f7b57:

    # "Amicus looks up at the ceiling too."
    "Amicus quoque laquear aspicit."

# game/a1s1.rpy:513
translate latin a1s1_63cb0efc:

    # a "\"That's Computatrum, or Com. He's pretty annoying, aren't you Com?\""
    a "\"Computatrum est, sive Com. Valde molestus est, nonne, Com?\""

# game/a1s1.rpy:514
translate latin a1s1_2d68c962:

    # com "\"I can provide diagnostics on the ship, on the mood and competence of crew mates, on—\""
    com "\"Notitias praebere possum de statu navis, de animis et facultatibus sodalium, de—\""

# game/a1s1.rpy:515
translate latin a1s1_59602e0d:

    # a "\"Thank you, Com. Anyway, he's not actually a sapient. He's a program that can process language and spit out information stored in his database.\""
    a "\"Gratias, Com. Ceterum non est vere Sapiens. Programma est quod linguam tractare potest et notitias in basi datorum repositas proferre.\""

# game/a1s1.rpy:516
translate latin a1s1_54bca475:

    # "Amicus pauses."
    "Amicus paulisper tacet."

# game/a1s1.rpy:517
translate latin a1s1_8192385a:

    # a "\"I'm sorry, you probably don't understand what I'm talking about.\""
    a "\"Ignosce, fortasse non intellegis de quo loquar.\""

# game/a1s1.rpy:518
translate latin a1s1_e2564d96:

    # m "\"Um, I think I do. Artificial intelligence, maybe?\""
    m "\"Hem, opinor me intellegere. Fortasse intellegentia artificialis?\""

# game/a1s1.rpy:519
translate latin a1s1_8ff60a1b:

    # "I reach instinctively for the pocket of my jeans, but I remember that I left my phone on the bedside table."
    "Manum sponte ad sinum bracarum caerulearum admoveo; sed memini me telephonum in mensula iuxta lectum reliquisse."

# game/a1s1.rpy:521
translate latin a1s1_047dc754:

    # "Amicus's eyes widen once again, and again I wonder if I should be keeping my mouth shut."
    "Oculi Amici rursus dilatantur; rursus dubito num os clausum tenere debeam."

# game/a1s1.rpy:522
translate latin a1s1_dacff7bd:

    # "Revealing how much I know seems to be some sort of trigger for him."
    "Ostendere quantum sciam aliquid in eo concitare videtur."

# game/a1s1.rpy:524
translate latin a1s1_ac9ae423:

    # a "\"Ah...So, have you been in space before?\""
    a "\"Ah...Ergo, iam antea in spatio fuisti?\""

# game/a1s1.rpy:525
translate latin a1s1_2088f2ec:

    # m "\"Um, no.\""
    m "\"Hem, non.\""

# game/a1s1.rpy:526
translate latin a1s1_0d90c929:

    # "I look out the window, staring at the stars."
    "Per fenestram aspicio, stellas intuens."

# game/a1s1.rpy:527
translate latin a1s1_c3e08507:

    # a "\"Okay...have your people ever been to space?\""
    a "\"Bene...vestra gens umquam in spatium venit?\""

# game/a1s1.rpy:528
translate latin a1s1_edee423f:

    # m "\"Uh, no, no we haven't.\""
    m "\"Hem, non, non fuimus.\""

# game/a1s1.rpy:529
translate latin a1s1_c05066d5:

    # a "\"Do you know what atoms are, nuclear energy, maybe?\""
    a "\"Scisne quid sint atomi, fortasse vis nuclearis?\""

# game/a1s1.rpy:530
translate latin a1s1_c651d0c8:

    # m "\"No.\""
    m "\"Non.\""

# game/a1s1.rpy:531
translate latin a1s1_59475080:

    # com "\"Based on Nexus analysis on Earth, these statements appear to be misleading, Amicus.\""
    com "\"Secundum Nexus de Terra investigationem, haec dicta fallere videntur, Amice.\""

# game/a1s1.rpy:532
translate latin a1s1_98066696:

    # "I glance at the ceiling again, realizing now that I've got a constant spy above me."
    "Laquear rursus aspicio, iam intellegens me speculatorem perpetuum supra me habere."

# game/a1s1.rpy:533
translate latin a1s1_c5ee7b6e:

    # "I look back at Amicus and we stare at each other in silence for a long moment."
    "Oculos rursus ad Amicum converto; diu alter alterum taciti intuemur."

# game/a1s1.rpy:534
translate latin a1s1_26559216:

    # "Then I realize how absurd all of this is."
    "Tum intellego quam absurda haec omnia sint."

# game/a1s1.rpy:535
translate latin a1s1_f5a3b597:

    # m "\"What do you want with me?\""
    m "\"Quid a me vis?\""

# game/a1s1.rpy:536
translate latin a1s1_96fb641a:

    # "Amicus looks away, seeming to think."
    "Amicus oculos avertit, cogitare videtur."

# game/a1s1.rpy:538
translate latin a1s1_3b13900b:

    # a "\"Well, it's...it's part of a program on my planet to introduce new aliens to the Galaxias.\""
    a "\"Bene, haec...haec pars est programmatis in planeta meo quo novi alienigenae ad Galaxias adducuntur.\""

# game/a1s1.rpy:539
translate latin a1s1_d18dcfb8:

    # m "\"What is that?\""
    m "\"Quid est illud?\""

# game/a1s1.rpy:541
translate latin a1s1_e2ed25f4:

    # a "\"It's the greater galactic civilization, [mc]. It's a gradual strategy to slowly introduce Earth to the idea of other Sapients.\""
    a "\"Maior illa est civilizatio galactica, [mc]. Consilium gradatim exsequendum est, ut Terra paulatim de aliis Sapientibus cognoscat.\""

# game/a1s1.rpy:542
translate latin a1s1_86b13a5c:

    # m "\"Oh...is this happening to other humans?\""
    m "\"Oh...hocne aliis quoque hominibus accidit?\""

# game/a1s1.rpy:543
translate latin a1s1_bcc81977_1:

    # a "\"Yes.\""
    a "\"Ita.\""

# game/a1s1.rpy:544
translate latin a1s1_1ead6d40:

    # "I contemplate this for a moment."
    "De hoc paulisper cogito."

# game/a1s1.rpy:545
translate latin a1s1_d543c2a0:

    # m "\"And...when you're done showing me you'll take me back?\""
    m "\"Et...cum haec mihi ostenderis, me reduces?\""

# game/a1s1.rpy:546
translate latin a1s1_ae8abdc8:

    # "There's a momentary pause that I don't like very much."
    "Brevis mora est quae mihi minime placet."

# game/a1s1.rpy:547
translate latin a1s1_4eb44ffd:

    # a "\"...Yes.\""
    a "\"...Ita.\""

# game/a1s1.rpy:548
translate latin a1s1_b50e6068:

    # "I imagine that I'd hear \"these statements appear to be misleading\" from Com right now, if he were on my side."
    "Fingo me nunc a Com auditurum \"haec dicta fallere videntur\", si partes meas tueretur."

# game/a1s1.rpy:549
translate latin a1s1_c759c599:

    # "I look into my cup of brown sludge again."
    "Rursus in calicem meum lutosae materiae fuscae aspicio."

# game/a1s1.rpy:550
translate latin a1s1_2d777753:

    # m "\"Well, to be honest I'm not all that interested. So could you just take me back...now?\""
    m "\"Ut verum dicam, non admodum me haec alliciunt. Potesne igitur me reducere...nunc?\""

# game/a1s1.rpy:552
translate latin a1s1_594096e1:

    # "Amicus stares at me."
    "Amicus me intuetur."

# game/a1s1.rpy:553
translate latin a1s1_b5dc73e5:

    # m "\"I've got school and...and a family...they don't know where I am right now.\""
    m "\"Lectiones mihi sunt et...et familia...nunc nesciunt ubi sim.\""

# game/a1s1.rpy:555
translate latin a1s1_47f76efe:

    # a "\"Wh—uh—I, I mean, don't you want to see the galaxy? I really think that it would be amazing for someone like you that hasn't seen it before.\""
    a "\"Qu—hem—ego, dicere volui, nonne vis galaxiam videre? Vere puto id mirificum fore alicui tui simili qui eam nondum viderit.\""

# game/a1s1.rpy:556
translate latin a1s1_a10d5c8a:

    # "The wolf starts fidgeting with his paws, not looking at me, choosing to stare out the windows."
    "Lupus manus inquietus movet; me non intuetur, sed per fenestras aspicere eligit."

# game/a1s1.rpy:557
translate latin a1s1_4bae6b94:

    # "He isn't wrong."
    "Non errat."

# game/a1s1.rpy:558
translate latin a1s1_b60f3d48:

    # "It would be pretty cool to see the galaxy, but not with someone like him who kidnapped me, taking me somewhere for a reason that he isn't telling me."
    "Galaxiam videre sane iucundum esset, sed non cum eo qui me rapuit et aliquo ducit ob causam quam mihi non dicit."

# game/a1s1.rpy:559
translate latin a1s1_bb1aa492:

    # m "\"No, no I actually want to go home right now.\""
    m "\"Non, non; nunc revera domum redire volo.\""

# game/a1s1.rpy:560
translate latin a1s1_762e3985:

    # "Amicus stares at me for a full ten seconds before looking away."
    "Amicus me per decem integra secunda intuetur, deinde oculos avertit."

# game/a1s1.rpy:562
translate latin a1s1_0d413744:

    # a "\"How about we wait until we get to my home then we can discuss it?\""
    a "\"Quid si exspectemus donec domum meam perveniamus, tum de hoc colloquamur?\""

# game/a1s1.rpy:563
translate latin a1s1_7daae42b:

    # m "\"No. Take me back.\""
    m "\"Non. Me reduce.\""

# game/a1s1.rpy:564
translate latin a1s1_42720994:

    # "I feel my heart hammering in my chest as I start to realize that this alien is definitely not going to take me back."
    "Cor mihi in pectore vehementer pulsat, cum intellegere incipiam hunc alienigenam certe me non reducturum esse."

# game/a1s1.rpy:566
translate latin a1s1_b3660930:

    # "I stand up and Amicus flinches and brings his paws up to his chest, as if I'm going to attack him."
    "Surgo; Amicus refugit et manus ad pectus tollit, quasi eum oppugnaturus sim."

# game/a1s1.rpy:568
translate latin a1s1_f8f0cd8e:

    # "We stay like that for a moment."
    "Sic paulisper manemus."

# game/a1s1.rpy:569
translate latin a1s1_5f8a45ea:

    # "I'm breathing hard, staring down at the wolf while Amicus stares back up at me, wide-eyed."
    "Graviter respiro, lupum infra me intuens; Amicus autem me suspicit, oculis late apertis."

# game/a1s1.rpy:570
translate latin a1s1_c09f5fab:

    # "Finally, Amicus lets out a big sigh, looking back out the window."
    "Tandem Amicus magnum suspirium edit et rursus per fenestram aspicit."

# game/a1s1.rpy:572
translate latin a1s1_a8c26014:

    # a "\"Okay, I'm going to take you back. I'm sorry.\""
    a "\"Bene, te reducam. Ignosce.\""

# game/a1s1.rpy:573
translate latin a1s1_7a4687bc:

    # "I watch him for a moment, looking for signs of sincerity, but he still won't look at me."
    "Eum paulisper observo, sinceritatis indicia quaerens; sed adhuc me aspicere recusat."

# game/a1s1.rpy:574
translate latin a1s1_0b4eb0fa:

    # m "\"Really?\""
    m "\"Revera?\""

# game/a1s1.rpy:575
translate latin a1s1_1f433de6:

    # a "\"Yes...but it's complicated. We're, uh, on a trajectory for Adastra. It'll take time for us to turn around.\""
    a "\"Ita...sed res difficilis est. Hem, cursum ad Adastram tenemus. Aliquantum temporis opus est ut navem convertamus.\""

# game/a1s1.rpy:576
translate latin a1s1_faeab43b:

    # "I keep watching him, not sure what to do."
    "Eum adhuc observo, nesciens quid agam."

# game/a1s1.rpy:577
translate latin a1s1_23bbffc2:

    # "I feel like he's lying, but if he is there's really nothing I can do about it."
    "Suspicor eum mentiri; sed, si mentitur, nihil re vera facere possum."

# game/a1s1.rpy:578
translate latin a1s1_40d8d1c1:

    # "I'm stuck here with him, probably millions of miles from Earth, with no way of knowing how to get back."
    "Hic cum eo inclusus sum, fortasse complures milliones milium passuum a Terra, nec ullo modo scire possum quomodo redeam."

# game/a1s1.rpy:579
translate latin a1s1_7da27250:

    # "So I just stand there, arms folded tightly against my chest, staring out the window, too."
    "Itaque illic tantum sto, brachiis contra pectus arcte complicatis, ego quoque per fenestram aspiciens."

# game/a1s1.rpy:580
translate latin a1s1_f617df9b:

    # "That's when I see a star brighter than all of the others, almost too bright to look at."
    "Tum stellam video omnibus aliis clariorem, paene clariorem quam ut aspici possit."

# game/a1s1.rpy:581
translate latin a1s1_f23bde36:

    # m "\"Is that the sun?\""
    m "\"Estne ille sol?\""

# game/a1s1.rpy:582
translate latin a1s1_66a01596:

    # a "\"The what?\""
    a "\"Quid?\""

# game/a1s1.rpy:583
translate latin a1s1_8418c46f:

    # m "\"Is that my star? My planet's star.\""
    m "\"Estne mea stella? Stella planetae mei.\""

# game/a1s1.rpy:584
translate latin a1s1_8b5fc7d5:

    # "Amicus squints in the direction I'm looking in."
    "Amicus oculis contractis illuc aspicit quo ego specto."

# game/a1s1.rpy:586
translate latin a1s1_a2889e7f:

    # a "\"Oh...Oh, yeah! Yeah, that's your star...I can't remember the name we have for it. It's a bunch of numbers.\""
    a "\"Oh...Oh, ita! Ita, illa vestra stella est...Nomen quo eam appellamus non memini. Numeri quidam sunt.\""

# game/a1s1.rpy:587
translate latin a1s1_6358c0bf:

    # m "\"How far away are we?\""
    m "\"Quantum absumus?\""

# game/a1s1.rpy:589
translate latin a1s1_e5c37924:

    # a "\"Not far. We could get back there in no time.\""
    a "\"Non longe. Brevissimo tempore illuc redire possumus.\""

# game/a1s1.rpy:590
translate latin a1s1_2f21f96b:

    # "Amicus stands up next to me, seeming to stretch."
    "Amicus iuxta me surgit, corpus extendere videtur."

# game/a1s1.rpy:592
translate latin a1s1_dd30b674:

    # m "\"So...are we going back?\""
    m "\"Ergo...redimusne?\""

# game/a1s1.rpy:593
translate latin a1s1_7bbd1710:

    # a "\"Yeah, yeah, just gotta do it in a way that doesn't waste too much energy. I still have to get back to Adastra after all.\""
    a "\"Ita, ita; modo sic faciendum est ut non nimiam vim consumamus. Mihi tamen ad Adastram redeundum est.\""

# game/a1s1.rpy:594
translate latin a1s1_b37ab19d:

    # "I stare in the direction of the Sun again, my gaze slightly averted from the piercing dot."
    "Rursus ad Solem aspicio, oculos paulum avertens a puncto illo quod eos pungit."

# game/a1s1.rpy:595
translate latin a1s1_2b87c86d:

    # "How long has it been since I was kidnapped?"
    "Quantum temporis praeteriit ex quo raptus sum?"

# game/a1s1.rpy:596
translate latin a1s1_11b65f7b:

    # "I wonder if my friends have alerted the school, or even the authorities."
    "Cogito num amici iam academiam aut magistratus certiores fecerint."

# game/a1s1.rpy:597
translate latin a1s1_92830ed6:

    # "How am I going to explain this?"
    "Quomodo hoc explicabo?"

# game/a1s1.rpy:598
translate latin a1s1_7a0cd758:

    # "There's a movement to my right and just as I'm turning to look, something cold presses into the side of my neck."
    "Aliquid ad dextram meam movetur; dum oculos illuc converto, res frigida lateri cervicis meae admovetur."

# game/a1s1.rpy:599
translate latin a1s1_647ea463:

    # "A familiar sensation of my muscles tightening up makes me slam back into the seat."
    "Familiaris ille sensus musculorum qui se contrahunt me retrorsum in sellam deicit."

# game/a1s1.rpy:600
translate latin a1s1_2ea99556:

    # "At the same time my mind seems to wipe clean...empty."
    "Simul mens mea quasi purgatur...vacua."

# game/a1s1.rpy:601
translate latin a1s1_d377dc01:

    # "Suddenly I'm surrounded by soft and warm gray fur."
    "Repente molli calidoque vello cano circumdor."

# game/a1s1.rpy:602
translate latin a1s1_b3271f6c:

    # "I feel like a limp blanket as I'm flopped around, my muscles like jelly."
    "Cum huc illuc iactor, stragulum pendulum esse mihi videor; musculi mei quasi gelatina sunt."

# game/a1s1.rpy:603
translate latin a1s1_edc4567c:

    # "It's not a bad feeling, in fact I kinda feel great."
    "Non mala est sensatio; immo quodam modo optime me habeo."

# game/a1s1.rpy:604
translate latin a1s1_7e971bed:

    # "I would smile if my facial muscles were working."
    "Subriderem si musculi vultus operarentur."

# game/a1s1.rpy:605
translate latin a1s1_29b03dcb:

    # "I'm laid on the ground and then my arms are pushed behind me."
    "In pavimentum deponor, deinde brachia mihi post tergum aguntur."

# game/a1s1.rpy:606
translate latin a1s1_b0c2122b:

    # "Something starts to wind around my wrists."
    "Aliquid carpos meos circumvolvi incipit."

# game/a1s1.rpy:607
translate latin a1s1_d4ebc398:

    # com "\"Still detecting consciousness from the human. Insufficient charge used.\""
    com "\"Hominem adhuc sui conscium esse deprehendo. Vis adhibita non sufficit.\""

# game/a1s1.rpy:608
translate latin a1s1_3b3358d1:

    # a "\"I used it on the lowest setting. I think I hit him with too much last time. Looks like he's mostly out anyway, though.\""
    a "\"Minimam vim adhibui. Priore vice eum nimia vi percussisse me puto. Nunc tamen fere inscius videtur.\""

# game/a1s1.rpy:609
translate latin a1s1_9ede3f11:

    # "I hear ragged breathing in my ear as my arms are jerked around."
    "Spiritus anhelos iuxta aurem audio, dum brachia mihi huc illuc trahuntur."

# game/a1s1.rpy:610
translate latin a1s1_c0c447f0:

    # a "\"Dammit! He's more sapient than any child I've known!\""
    a "\"Malum! Sapientior est quam ullus e Liberis quem novi!\""

# game/a1s1.rpy:611
translate latin a1s1_b5be8675:

    # com "\"Sensing distress. Would you like a stress tablet Amicus?\""
    com "\"Angorem percipio. Visne pastillum ad sollicitudinem sedandam, Amice?\""

# game/a1s1.rpy:612
translate latin a1s1_b83d63f0:

    # a "\"Maybe even as intelligent as a Wolf...Well, almost. If they've been to space then they're far past level five.\""
    a "\"Fortasse etiam tam intellegens quam Lupus...saltem paene. Si in spatium venerunt, longe supra quintum gradum sunt.\""

# game/a1s1.rpy:613
translate latin a1s1_eb0264fc:

    # "I try to open my eyes but the eyelids are too heavy to lift."
    "Oculos aperire conor, sed palpebrae graviores sunt quam ut tollantur."

# game/a1s1.rpy:614
translate latin a1s1_979b3334:

    # a "\"Maybe level ten?\""
    a "\"Fortasse decimus gradus?\""

# game/a1s1.rpy:615
translate latin a1s1_83d8c327:

    # "My brain isn't really working either."
    "Ne cerebrum quidem meum bene operatur."

# game/a1s1.rpy:616
translate latin a1s1_56b2818a:

    # "I can't seem to focus."
    "Animum intendere non possum."

# game/a1s1.rpy:617
translate latin a1s1_28de12eb:

    # "Padded footsteps move around my head."
    "Molles pedum passus circa caput meum audio."

# game/a1s1.rpy:620
translate latin a1s1_2f8c7d04:

    # "Then I hear what sounds like an alarm, followed by something I can't really explain..."
    "Tum aliquid quasi monitum sonans audio, deinde aliquid quod vix explicare possum..."

# game/a1s1.rpy:621
translate latin a1s1_bff90061:

    # "My mind startles as that deep voice starts up again."
    "Mens mea repente excitatur cum vox illa gravis rursus incipit."

# game/a1s1.rpy:622
translate latin a1s1_9d5bb6ba:

    # a "\"What do I do now? I've messed this up about as badly as I could have.\""
    a "\"Quid nunc faciam? Hanc rem tam male gessi quam fieri potuit.\""

# game/a1s1.rpy:623
translate latin a1s1_a20cefa7_8:

    # "..."
    "..."

# game/a1s1.rpy:624
translate latin a1s1_f066ccfb:

    # a "\"Solutions, Com?\""
    a "\"Quae solutiones sunt, Com?\""

# game/a1s1.rpy:625
translate latin a1s1_65b6956e:

    # com "\"Solutions: Consider returning the human back to Earth. If no evidence is left behind it is unlikely his statements would be believed.\""
    com "\"Solutiones: considera hominem ad Terram reducere. Si nulla vestigia relinquuntur, veri simile non est dictis eius fidem habitum iri.\""

# game/a1s1.rpy:626
translate latin a1s1_b0ab74af:

    # a "\"...Uh, too late for that since I just activated the Stretch Drive.\""
    a "\"...Hem, sero iam est, quoniam modo Propulsionem Dilatatoriam activavi.\""

# game/a1s1.rpy:627
translate latin a1s1_e96ce7c7:

    # com "\"Yes, that was inadvisable.\""
    com "\"Ita, id non erat prudens.\""

# game/a1s1.rpy:628
translate latin a1s1_f0807289:

    # a "\"Yeah, well, I don't know how advanced his species is. If he was being misleading then that means they're space-faring. They could have patrols in their star system.\""
    a "\"Ita, sed nescio quantum species eius profecerit. Si nos fallebat, tum in spatio navigare possunt. Fortasse navigia custodiae in suo stellarum systemate habent.\""

# game/a1s1.rpy:629
translate latin a1s1_6e20bf3e:

    # a "\"I wanted to get out as soon as possible...You know you could have offered the solution before I did that.\""
    a "\"Quam primum effugere volebam...Scis, potuisti solutionem offerre antequam id facerem.\""

# game/a1s1.rpy:630
translate latin a1s1_9d17ba6e:

    # com "\"You've set me to minimal interruptions.\""
    com "\"Me ita constituisti ut quam rarissime interpellarem.\""

# game/a1s1.rpy:631
translate latin a1s1_4b9d9830:

    # a "\"Next solution.\""
    a "\"Proxima solutio.\""

# game/a1s1.rpy:632
translate latin a1s1_770172aa:

    # com "\"Consider termination of the human and incineration of the remains through the radiation of the Stretch Drive—\""
    com "\"Considera num homo necandus sit et reliquiae eius radiatione Propulsionis Dilatatoriae comburendae—\""

# game/a1s1.rpy:633
translate latin a1s1_a7afb2bf:

    # a "\"{i}Edapol! {/i}No! Next solution.\""
    a "\"{i}Edapol! {/i}Non! Proxima solutio.\""

# game/a1s1.rpy:634
translate latin a1s1_69dd9dd2:

    # com "\"Consider taking the human to Adastra and use him as your pet as you originally planned.\""
    com "\"Considera hominem ad Adastram ducere atque in deliciis habere, sicut initio cogitabas.\""

# game/a1s1.rpy:635
translate latin a1s1_1db081d4:

    # com "\"From there you may pass him off as less sapient. It is unlikely you will be questioned.\""
    com "\"Illic eum minus sapientem esse simulare potes. Veri simile non est te interrogatum iri.\""

# game/a1s1.rpy:636
translate latin a1s1_a20cefa7_9:

    # "..."
    "..."

# game/a1s1.rpy:637
translate latin a1s1_6359f6b8:

    # a "\"I don't know. He already despises me and after what I just did...\""
    a "\"Nescio. Iam me spernit, et post id quod modo feci...\""

# game/a1s1.rpy:638
translate latin a1s1_84de36c4:

    # com "\"Amicus, alternative solutions point to a higher likelihood that the Monitors will be alerted to your actions.\""
    com "\"Amice, aliae solutiones efficiunt ut probabilius sit Monitores de factis tuis certiores fieri.\""

# game/a1s1.rpy:639
translate latin a1s1_a20cefa7_10:

    # "..."
    "..."

# game/a1s1.rpy:640
translate latin a1s1_b378af8d:

    # com "\"Proceed with caution.\""
    com "\"Caute procede.\""

# game/a1s1.rpy:641
translate latin a1s1_5fe437de:

    # a "\"Com, please wipe the last ten minutes of conversation...then go into sleep mode until I wake you. I need to think.\""
    a "\"Com, colloquium decem minutorum praeteritorum dele, quaeso...deinde dormi donec te expergefecero. Mihi cogitandum est.\""

# game/a1s1.rpy:642
translate latin a1s1_beb8c686:

    # com "\"Wiping memory. Entering sleep mode.\""
    com "\"Memoriam deleo. Modum quietis ineo.\""

# game/a1s1.rpy:643
translate latin a1s1_9683989d:

    # "A few more moments of silence go by and I feel a wave of fatigue."
    "Pauca alia momenta silentii praetereunt et lassitudo me unda quadam perfundit."

# game/a1s1.rpy:644
translate latin a1s1_519e54d3:

    # "I start to fall asleep."
    "Obdormiscere incipio."

# game/a1s1.rpy:645
translate latin a1s1_9caf9af4:

    # "The padded footsteps move closer to me and I feel a presence looming."
    "Molles passus propius accedunt, et aliquem supra me imminere sentio."

# game/a1s1.rpy:646
translate latin a1s1_5684fecb:

    # "Then something heavy and soft rests on my forearm."
    "Tum aliquid grave et molle brachio meo incumbit."

# game/a1s1.rpy:647
translate latin a1s1_8a44d64c:

    # a "\"I'm sorry...This was a mistake.\""
    a "\"Ignosce...Hoc error fuit.\""

# game/a1s1.rpy:648
translate latin a1s1_87b70147:

    # "Then I'm dragged for a short while before I come to rest on something shaggy and soft."
    "Deinde paulisper trahor, donec in re molli villosaque quiesco."

# game/a1s1.rpy:649
translate latin a1s1_e765c4d6:

    # "Then silence...."
    "Deinde silentium...."

# game/a1s1.rpy:650
translate latin a1s1_be52cd10:

    # "Then sleep..."
    "Deinde somnus..."

# game/a1s1.rpy:655
translate latin a1s1_af4532e8:

    # "I float in a void of nothingness."
    "In vacuo nihili fluito."

# game/a1s1.rpy:656
translate latin a1s1_22cb48e2:

    # "Not even blackness...nothingness."
    "Ne tenebrae quidem...nihil."

# game/a1s1.rpy:657
translate latin a1s1_e84417a1:

    # "The feeling of having no sense of self, the boundaries of my being having no boundaries..."
    "Nullum mei sensum habeo; fines mei ipsius nullis finibus continentur..."

# game/a1s1.rpy:658
translate latin a1s1_60c108bb:

    # "It makes me panic."
    "Hinc pavor me corripit."

# game/a1s1.rpy:659
translate latin a1s1_a97e4f67:

    # "I'm still here, but nothing else exists."
    "Adhuc hic sum, sed nihil aliud exsistit."

# game/a1s1.rpy:660
translate latin a1s1_36dfb867:

    # "Am I all there is?"
    "Sumne ego omnia quae sunt?"

# game/a1s1.rpy:661
translate latin a1s1_0242aa20:

    # "I feel the borders of my sanity start to bend and break."
    "Sanitatis mentis meae fines flecti frangique sentio."

# game/a1s1.rpy:662
translate latin a1s1_80384914:

    # "It only lasts a moment before something massive and all-encompassing grabs hold of me."
    "Hoc momento tantum durat, antequam aliquid ingens et omnia complectens me apprehendit."

# game/a1s1.rpy:663
translate latin a1s1_d3cfade7:

    # "Instantly I'm comforted, calmed by a sense of complete security."
    "Statim solacium sentio, sensu perfectae securitatis placatus."

# game/a1s1.rpy:664
translate latin a1s1_3a72158c:

    # "\"All is as it should be...\""
    "\"Omnia ita sunt ut esse debent...\""

# game/a1s1.rpy:669
translate latin a1s1_3b6ab3ad:

    # "I crack my eyes open to a gray ceiling, the familiar hum of the ship in my ears."
    "Oculos paulum aperio et laquear canum video; familiaris navis murmur auribus sonat."

# game/a1s1.rpy:670
translate latin a1s1_adc8153d:

    # "My back aches as I feel my hands bunched up underneath me, making me arch uncomfortably."
    "Tergum dolet: manus sub me constrictae sunt, ita ut me incommode incurvem."

# game/a1s1.rpy:671
translate latin a1s1_d65aa1ab:

    # "The numbness isn't there like last time."
    "Torpor prioris vicis abest."

# game/a1s1.rpy:672
translate latin a1s1_e3cf1733:

    # "Instead it just feels like I woke up from a deep sleep."
    "Immo tantum e somno alto experrectus esse videor."

# game/a1s1.rpy:673
translate latin a1s1_f9acd018:

    # "I can tell I'm back in the utility closet laying on the shag rug, but the door is open, allowing me to actually see."
    "Video me rursus in armario instrumentorum, super tapetem villosum iacere; sed ianua aperta est, ita ut nunc videre possim."

# game/a1s1.rpy:674
translate latin a1s1_04820179:

    # "Slowly, I turn my head just a bit and I'm able to vaguely make out the small deck that I'd just been in."
    "Lente caput paululum verto et angustum tabulatum ubi modo fui vix distinguere possum."

# game/a1s1.rpy:675
translate latin a1s1_082f61b0:

    # "I see Amicus to the far right, both his paws resting on the counter with the food dispenser, looking down at a panel."
    "Amicum longe ad dextram video, utraque manu mensae ubi cibus distribuitur innixum, tabulam inspicientem."

# game/a1s1.rpy:676
translate latin a1s1_ca0a79ee:

    # "He's got his back to me at an angle, one foot crossed behind the other, his tail swishing back and forth while he mumbles to himself."
    "Tergum oblique mihi vertit, altero pede post alterum transverso; caudam huc illuc movet et secum murmurat."

# game/a1s1.rpy:677
translate latin a1s1_92dd477f:

    # "As slowly as I can, I turn over onto my side, trying not to let out a groan of relief as my back and hands are relieved of pressure."
    "Quam lentissime in latus me converto, gemitum levationis reprimens, cum tergi manuumque pressio solvatur."

# game/a1s1.rpy:678
translate latin a1s1_3cfc9d0c:

    # "I grimace through the pain of having blood rush back into my fingers."
    "Vultum dolore contraho cum sanguis in digitos redit."

# game/a1s1.rpy:679
translate latin a1s1_b2fce196:

    # "That's when I realize that my hands are tied at the wrists behind my back with a cord of some kind."
    "Tum intellego manus meas post tergum ad carpos funiculo quodam vinctas esse."

# game/a1s1.rpy:680
translate latin a1s1_c41ac249:

    # "The ends of it dangle through my fingers and it feels smooth and metallic."
    "Fines eius inter digitos meos pendent; funiculum levem ac metallicum sentio."

# game/a1s1.rpy:681
translate latin a1s1_35e07eeb:

    # "Some slow movements with my hands tells me immediately that they haven't been tied well."
    "Paucis lentis motibus manuum statim intellego eas male vinctas esse."

# game/a1s1.rpy:682
translate latin a1s1_3fe34707:

    # "My left hand is fairly secure, but the loop around my right is loose."
    "Manus sinistra satis arcte tenetur, sed laqueus dextrae laxus est."

# game/a1s1.rpy:683
translate latin a1s1_f12e3d58:

    # "I get the feeling that if I pull hard enough, I might be able to slip it—"
    "Sentio me, si satis vehementer traxero, fortasse manum expedire posse—"

# game/a1s1.rpy:684
translate latin a1s1_ffb8948f:

    # "And just like that it comes out."
    "Et tam facile exit."

# game/a1s1.rpy:685
translate latin a1s1_95e75613:

    # "My shoulder jerks when I do it and I freeze, waiting to see if Amicus might notice."
    "Umerus eo motu trepidat; statim immobilis maneo, exspectans num Amicus animadvertat."

# game/a1s1.rpy:686
translate latin a1s1_d2661139:

    # "He goes on staring down at the panel, leaning forward to rest his chin on a fist."
    "Tabulam adhuc inspicit, prorsum incumbens ut mentum pugno fulciat."

# game/a1s1.rpy:687
translate latin a1s1_07d78f36:

    # a "\"Cassius is probably going to figure it out right away. I know it.\""
    a "\"Cassius fortasse statim rem intelleget. Scio.\""

# game/a1s1.rpy:688
translate latin a1s1_2306b59a:

    # "Amicus sighs and hunches over further."
    "Amicus suspirat et magis se incurvat."

# game/a1s1.rpy:689
translate latin a1s1_9590e57c:

    # "I let out the breath I'm holding as quietly as I can before I start looking around, moving my head as little as possible."
    "Spiritum quem tenebam quam silentissime emitto; deinde circumspicere incipio, caput quam minimum movens."

# game/a1s1.rpy:690
translate latin a1s1_9ebb5349:

    # "On the shelves are a variety of different objects that I can't identify."
    "In pluteis multae variae res sunt quas agnoscere non possum."

# game/a1s1.rpy:691
translate latin a1s1_d6144df5:

    # "They all have a heavy, industrial look to them and I know that I could use any of them as a weapon."
    "Omnes graves et ad opus fabricile aptae videntur; scio me quavis earum pro telo uti posse."

# game/a1s1.rpy:692
translate latin a1s1_96f64e4f:

    # "There's a long, pipe-like object at the end of the bottom shelf and I imagine hefting that in both hands, bringing the end of it down on the top of that stupid wolf's—"
    "In extremo pluteo infimo res longa est quasi fistula; fingo me eam ambabus manibus tollere atque extremo eius stulti illius lupi caput percutere—"

# game/a1s1.rpy:693
translate latin a1s1_e03e911f:

    # "Amicus suddenly straightens up and I stiffen, closing my eyes."
    "Amicus repente se erigit; ego rigesco et oculos claudo."

# game/a1s1.rpy:695
translate latin a1s1_afa08184:

    # "I hear the wolf move, padding in my direction."
    "Lupum moveri audio, mollibus passibus ad me venientem."

# game/a1s1.rpy:696
translate latin a1s1_9c2c94b7:

    # "That continues until there's a pause and I can feel his presence standing in the doorway."
    "Sic progreditur, donec subsistit; eum in limine stantem sentire possum."

# game/a1s1.rpy:697
translate latin a1s1_dad04d86:

    # "I crack open an eye, just a tiny bit to see what he might be doing."
    "Oculum vix paulum aperio ut videam quid agat."

# game/a1s1.rpy:698
translate latin a1s1_fd0775d1:

    # "I get a vague image of him standing over me, looking down."
    "Eum vix video supra me stantem et deorsum aspicientem."

# game/a1s1.rpy:699
translate latin a1s1_fa90945b:

    # a "\"Hello? Uh, human? [mc]?\""
    a "\"Heus? Hem, homo? [mc]?\""

# game/a1s1.rpy:700
translate latin a1s1_f4b1201a:

    # "I don't move and I breathe as evenly as I can."
    "Non moveor et quam aequissime respiro."

# game/a1s1.rpy:701
translate latin a1s1_ea4eb6bf:

    # a "\"Hello?\""
    a "\"Heus?\""

# game/a1s1.rpy:702
translate latin a1s1_5ca5b8e6:

    # "He must know I'm awake; I can feel myself shaking from all the tension."
    "Sine dubio scit me vigilare; sentio me ex tota hac contentione tremere."

# game/a1s1.rpy:703
translate latin a1s1_b862337b:

    # a "\"Dammit...\""
    a "\"Malum...\""

# game/a1s1.rpy:704
translate latin a1s1_04afa751:

    # "Amicus mumbles to himself as he turns away, moving back towards the deck."
    "Amicus secum murmurat dum se avertit et ad tabulatum redit."

# game/a1s1.rpy:706
translate latin a1s1_c26fdbfc:

    # "That's when I realize that this might be my best chance to make my move."
    "Tum intellego hanc fortasse optimam occasionem esse aliquid agendi."

# game/a1s1.rpy:707
translate latin a1s1_d75d5f2c:

    # "He's not going to take me back."
    "Me non reducet."

# game/a1s1.rpy:708
translate latin a1s1_4dffe11b:

    # "He's knocked me out twice and that's reason enough to do what I'm about to do."
    "Bis me inscium reddidit; hoc satis est ad id faciendum quod nunc facturus sum."

# game/a1s1.rpy:709
translate latin a1s1_4c26b911:

    # "As quietly as I can, I roll over and reach out for the metal pipe."
    "Quam silentissime me verto et manum ad fistulam metallicam porrigo."

# game/a1s1.rpy:710
translate latin a1s1_e1ba0061:

    # "By some miracle I manage not to clang it against the metal rack it's on."
    "Mirum in modum eam non ad pluteum metallicum percutio, in quo iacet."

# game/a1s1.rpy:711
translate latin a1s1_79ce504e:

    # "Quietly, I bring it up in both hands as I stand."
    "Tacitus eam ambabus manibus tollo dum surgo."

# game/a1s1.rpy:712
translate latin a1s1_0ccb14a2:

    # "It's heavy, a lot heavier than I expected, but I can manage it."
    "Gravis est, multo gravior quam putabam; sed eam tractare possum."

# game/a1s1.rpy:713
translate latin a1s1_df41eb16:

    # "I focus on the retreating wolf's back and move at a half-run, my bare feet allowing me to quietly pad toward him."
    "Tergum lupi abeuntis intueor et quasi cursu dimidio progredior; nudis pedibus ad eum tacite accedere possum."

# game/a1s1.rpy:714
translate latin a1s1_3eea3b93:

    # "Despite that, I see his ears come up at the last second, his body starting to shift in a way that tells me he's about to turn around."
    "Tamen extremo momento aures eius attolli video et corpus ita moveri ut eum se conversurum esse intellegam."

# game/a1s1.rpy:715
translate latin a1s1_1fbcb7e8:

    # "And I swing."
    "Et ictum fero."

# game/a1s1.rpy:716
translate latin a1s1_07f83414:

    # "What happens next is something that I can't explain."
    "Quod deinde accidit explicare non possum."

# game/a1s1.rpy:717
translate latin a1s1_e11232a2:

    # "I aim for his head, wanting to cause as much damage as possible, not really thinking about the consequences of what might happen if I seriously injure, or even kill him."
    "Caput peto, quam gravissime eum laedere cupiens, neque revera cogitans quid eventurum sit si eum graviter vulneravero aut etiam necavero."

# game/a1s1.rpy:718
translate latin a1s1_1e68a446:

    # "But for some inexplicable reason, the trajectory of my swing suddenly dips down, as if caused by some invisible magnet, making me miss Amicus's head."
    "Sed nescio qua causa via ictus mei repente deorsum flectitur, quasi vi magnetis invisibilis, ita ut caput Amici praeteream."

# game/a1s1.rpy:719
translate latin a1s1_1a3b3c7e:

    # "The strange force doesn't lessen the power of my swing though, and it carries through to land with a hard, meaty thump into the side of the wolf's thick neck."
    "Illa vis insolita tamen impetum ictus non minuit; fistula graviter in latus crassae cervicis lupi, sono carnis percussae, incidit."

# game/a1s1.rpy:722
translate latin a1s1_c55b5547:

    # a "\"AAAGH!\""
    a "\"AAAGH!\""

# game/a1s1.rpy:725
translate latin a1s1_220f1ecb:

    # "Amicus cringes, both paws moving to cover the back and side of his neck, dropping into a crouch."
    "Amicus dolore se contrahit; utraque manu posteriorem partem ac latus cervicis tegit et in flexis genibus subsidit."

# game/a1s1.rpy:726
translate latin a1s1_e12b7851:

    # "He looks back at me, his eyes wide and wild, an expression that sends a shot of fear into my body."
    "Me respicit, oculis patulis atque feris; ille vultus subito corpus meum terrore percutit."

# game/a1s1.rpy:727
translate latin a1s1_41594fa7:

    # "I suddenly see him as a wild animal; a wild, scared, and very angry animal."
    "Repente eum velut ferum animal video: ferum, pavidum et valde iratum."

# game/a1s1.rpy:728
translate latin a1s1_33f5552a:

    # "I raise the pipe again, over my head to bring down on the head I'd just missed."
    "Fistulam rursus supra caput meum tollo, in illud caput deiecturus quod modo non percussi."

# game/a1s1.rpy:729
translate latin a1s1_7acd7c83:

    # "But Amicus is fast."
    "Sed Amicus celer est."

# game/a1s1.rpy:731
translate latin a1s1_82b5acdc:

    # "He leaps up from the crouch, in an upward and forward motion straight into my chest."
    "E flexis genibus sursum et prorsum exsilit, recta in pectus meum."

# game/a1s1.rpy:734
translate latin a1s1_1477c2fa:

    # "I wheeze, but manage to stay on my feet as the wolf carries me backward to slam against the wall of the deck."
    "Anhelo, sed pedibus stare possum, dum lupus me retrorsum pellit et ad parietem tabulati allidit."

# game/a1s1.rpy:735
translate latin a1s1_5a041a38:

    # "Amicus snarls into my face, teeth bared, one eye wincing shut."
    "Amicus in vultum meum fremit, dentibus nudatis, altero oculo dolore clauso."

# game/a1s1.rpy:736
translate latin a1s1_2a6c6991:

    # "I struggle but there's no way; he handles me like a rag doll, like a toy."
    "Luctor, sed frustra: me velut pupam pannosam, velut ludicrum tractat."

# game/a1s1.rpy:737
translate latin a1s1_4c3fd121:

    # "This must be how someone feels during a wild animal attack, completely helpless, suddenly wondering why evolution left us so damn defenseless."
    "Sic quis se habere debet cum a fera oppugnatur: omnino impotens, repente quaerens cur evolutio nos tam inermes reliquerit."

# game/a1s1.rpy:738
translate latin a1s1_d9341b94:

    # a "\"What the HELL are you doing!? AGH!\""
    a "\"Quid, MALUM, facis!? AGH!\""

# game/a1s1.rpy:739
translate latin a1s1_9fa68862:

    # "Amicus yells at me as he lets go of one of my wrists to put a paw to his neck, cringing as he does."
    "Amicus in me clamat; alterum carpum meum dimittit ut manum ad cervicem admoveat, dolore se contrahens."

# game/a1s1.rpy:740
translate latin a1s1_58892681:

    # a "\"Dammit!\""
    a "\"Malum!\""

# game/a1s1.rpy:741
translate latin a1s1_fe75f468:

    # "I struggle with my freed hand, grabbing Amicus's face and trying to gouge his eyes and nose."
    "Manu libera luctor, vultum Amici prehendens et oculos nasumque effodere conans."

# game/a1s1.rpy:742
translate latin a1s1_775d77b6:

    # "The wolf immediately lets go of his neck and grabs the pipe."
    "Lupus statim cervicem dimittit et fistulam prehendit."

# game/a1s1.rpy:743
translate latin a1s1_fb846981:

    # "He wrenches it away, but I try to hold on and almost get lifted off my feet."
    "Eam vi avellit; sed tenere conor et paene a terra tollor."

# game/a1s1.rpy:744
translate latin a1s1_51b243f1:

    # "He swings it one way, then violently in the other direction, throwing me to the floor of the deck as I lose my grip on my weapon."
    "Eam in alteram partem movet, tum violenter in contrariam; telo e manibus meis elapso, me in pavimentum tabulati deicit."

# game/a1s1.rpy:745
translate latin a1s1_f4107cda:

    # "Amicus advances on me as I lay flat on my back, staring up at him wide-eyed, realizing how big of a mistake I've made thinking I could handle a seven foot tall, muscle-bound wolf."
    "Amicus ad me accedit dum supinus iaceo et patulis oculis eum suspicio; intellego quam graviter erraverim, putans me lupum septem pedes altum et musculis praeditum domare posse."

# game/a1s1.rpy:746
translate latin a1s1_fff456f7:

    # "I wonder if he's going to come at me with the pipe, but he throws it to the side."
    "Cogito num fistula me petiturus sit; sed eam ad latus proicit."

# game/a1s1.rpy:748
translate latin a1s1_cce65878:

    # "He starts to lean over me, still snarling."
    "Supra me inclinari incipit, adhuc fremens."

# game/a1s1.rpy:749
translate latin a1s1_99b67aba:

    # a "\"You little prick! This time I'll bind you up to your shoulders, how does that sound?\""
    a "\"Furcifer parve! Hac vice usque ad umeros te vinciam; quid de hoc putas?\""

# game/a1s1.rpy:750
translate latin a1s1_2743c03b:

    # "He grabs up one of my arms, trying to pull me up, but I go limp."
    "Alterum brachium meum arripit ut me attollat; sed corpus laxum reddo."

# game/a1s1.rpy:751
translate latin a1s1_af93e9d1:

    # a "\"Get UP! Otherwise I'll make you.\""
    a "\"SURGE! Aliter te cogam.\""

# game/a1s1.rpy:752
translate latin a1s1_2f997317:

    # "He grabs my other arm."
    "Alterum quoque brachium meum prehendit."

# game/a1s1.rpy:753
translate latin a1s1_697276fd:

    # "That's when I notice his wide stance over me and a particular bulge between his legs."
    "Tum animadverto eum cruribus late diductis supra me stare et quandam eminentiam inter crura habere."

# game/a1s1.rpy:754
translate latin a1s1_ff041fc3:

    # "I hardly think about it; drawing back one foot I launch it as hard as I can into his crotch."
    "Vix cogito: alterum pedem retraho, deinde quam maxima vi in inguina eius impello."

# game/a1s1.rpy:757
translate latin a1s1_aeb647aa:

    # "I feel a distinctly soft form get flattened under my foot as it gets trapped between the force of my kick and the substantial weight of Amicus's body."
    "Formam plane mollem sub pede meo complanari sentio, inter vim calcis meae et grave Amici corpus compressam."

# game/a1s1.rpy:758
translate latin a1s1_571ab292:

    # "If there was any doubt in my mind that this male alien would be affected any differently compared to a male human, his reaction quashed it."
    "Si dubitabam num hic alienigena mas aliter quam homo mas afficeretur, motus eius omnem dubitationem sustulit."

# game/a1s1.rpy:759
translate latin a1s1_4c281ae3:

    # "Amicus freezes, eyes wide, hunching over me even further while his thighs snap together, trapping my foot."
    "Amicus immobilis fit, oculis late apertis; magis etiam supra me incurvatur, dum femora repente coniungit et pedem meum includit."

# game/a1s1.rpy:760
translate latin a1s1_8dbecf4c:

    # "We both stay frozen for an awkward length of time as I stare at what I'd just done."
    "Ambo per tempus incommode longum immobiles manemus, dum id quod modo feci intueor."

# game/a1s1.rpy:761
translate latin a1s1_c3b7dacc:

    # "And that's when I see that device hanging on his waistband, the one that he'd been using to knock me out."
    "Tum illud instrumentum e cingulo eius pendens video, quo me inscium reddere solebat."

# game/a1s1.rpy:763
translate latin a1s1_5fba915e:

    # "I struggle to pull my foot free of the surprisingly tight embrace of his thighs while at the same time pulling my hands out of his now limp grasp."
    "Pedem e femoribus eius mire arcte clausis expedire conor; simul manus e prehensione eius iam laxa retraho."

# game/a1s1.rpy:764
translate latin a1s1_49e943ab:

    # "I reach for his waist, grabbing the device."
    "Manum ad lumbos eius porrigo et instrumentum arripio."

# game/a1s1.rpy:765
translate latin a1s1_54fda360:

    # "Amicus, probably distracted by the unexpected nutshot, doesn't seem to notice and I finally yank my foot free."
    "Amicus, fortasse ictu in testiculos inopinato distractus, id non animadvertere videtur; tandem pedem vi libero."

# game/a1s1.rpy:766
translate latin a1s1_7fafa09b:

    # "As I stumble to my feet the alien half-heartedly grabs at me and I struggle against his paws before reaching for his red cape and pulling it over his head."
    "Dum titubans surgo, alienigena me languide prehendere conatur; manibus eius resisto, deinde pallium rubrum arripio et super caput eius traho."

# game/a1s1.rpy:767
translate latin a1s1_dde9d034:

    # "Amicus finally stumbles back, one paw flying to his crotch, the other struggling with his cape as he stays bent over, mouth hanging open, making a weird gasping sound like he was holding his breath."
    "Amicus tandem retro titubat, altera manu ad inguina volante, altera cum pallio luctante; adhuc incurvatus, ore aperto, mirum anhelum sonum edit, quasi spiritum tenuerit."

# game/a1s1.rpy:768
translate latin a1s1_1b1c7a26:

    # "I look at the device in my hands, desperately trying to understand how to use it."
    "Instrumentum in manibus meis aspicio, desperatione plenus conans intellegere quomodo adhibeatur."

# game/a1s1.rpy:769
translate latin a1s1_d8d7ebee:

    # "A glass panel takes up most of the face of the device, like a phone, but two metal prongs stick out one end."
    "Tabula vitrea maximam eius faciei partem occupat, velut in telephono; sed duo dentes metallici ex altero extremo eminent."

# game/a1s1.rpy:770
translate latin a1s1_7e8b5f55:

    # "I frantically push at the screen and it comes to life, displaying a vertical bar."
    "Tabulam trepidus premo; ea accenditur et lineam crassam erectam exhibet."

# game/a1s1.rpy:771
translate latin a1s1_cd09a14c:

    # "About a tenth of it is filled from the bottom with a light blue color."
    "Circiter decima eius pars ab imo colore caeruleo claro plena est."

# game/a1s1.rpy:772
translate latin a1s1_39f052cf:

    # "I push at it with my thumb, waiting for something to happen, for electricity to start arcing between the prongs, or something."
    "Pollice eam premo, exspectans ut aliquid accidat, ut vis electrica inter dentes micare incipiat aut aliquid simile."

# game/a1s1.rpy:773
translate latin a1s1_e92443cf:

    # "Instead the bar fills with the slide of my thumb."
    "Pro eo linea, pollice meo tracto, impletur."

# game/a1s1.rpy:774
translate latin a1s1_be8eec5a:

    # "I push it all the way up until the color turns a dark violet."
    "Eam usque ad summum traho, donec color fit violaceus obscurus."

# game/a1s1.rpy:776
translate latin a1s1_46741042:

    # "I hear a snarl and see Amicus finally tear the cape off before he comes at me again, one paw still over his crotch, the other reaching out for me."
    "Fremitum audio et video Amicum tandem pallium avellere; rursus me petit, altera manu adhuc inguina tegente, altera ad me porrecta."

# game/a1s1.rpy:777
translate latin a1s1_ed1dce34:

    # "I don't have time to think, I just duck under his approaching paw and press the prongs as hard as I can into his body."
    "Cogitare non possum: modo sub manu eius accedente me demitto et dentes metallicos quam maxime in corpus eius premo."

# game/a1s1.rpy:781
translate latin a1s1_b14259cd:

    # "It sinks into his stomach and I hear the wolf make a {i}huff{/i} sound into my ear."
    "In ventrem eius deprimitur, et lupum prope aurem meam {i}uff{/i} facere audio."

# game/a1s1.rpy:782
translate latin a1s1_9108ee77:

    # "There's a pause as nothing seems to happen, then I press harder and squeeze the device and the result is instant."
    "Paulisper nihil accidere videtur; tum vehementius premo et instrumentum comprimo, statimque effectus sequitur."

# game/a1s1.rpy:784
translate latin a1s1_84491e6b:

    # "There's no sound, but Amicus's body seizes violently, shaking as if he's having a seizure."
    "Nullus sonus est, sed corpus Amici vehementer contrahitur atque tremit, quasi spasmo correptus sit."

# game/a1s1.rpy:785
translate latin a1s1_e9ac8279:

    # "The muscles in his stomach tense hard and push the device back out a few inches."
    "Musculi ventris fortiter tenduntur et instrumentum aliquot uncias retro propellunt."

# game/a1s1.rpy:786
translate latin a1s1_4058744f:

    # "I hold it there, not wanting to let up in case it isn't enough, in case he'll just recover and come at me again."
    "Ibi id teneo, premere desinere nolens, ne parum sit et ille mox se recipiat meque rursus petat."

# game/a1s1.rpy:787
translate latin a1s1_399e17e7:

    # "After a few seconds the wolf's seizing and shuddering stops on its own."
    "Paucis secundis post, contractiones tremorque lupi sua sponte cessant."

# game/a1s1.rpy:788
translate latin a1s1_1bbe88f5:

    # "I start to pull back and get a glimpse of Amicus's face."
    "Retrorsum moveri incipio et vultum Amici breviter video."

# game/a1s1.rpy:789
translate latin a1s1_020ecd18:

    # "His muzzle hangs open, foam and drool hanging from his chin, his eyes rolling back in his head."
    "Rostrum apertum pendet; spuma salivaque e mento pendent, oculi autem retrorsum volvuntur."

# game/a1s1.rpy:790
translate latin a1s1_b9306b4e:

    # "It's a scary sight, so I try to back away and Amicus comes with me, the contact with the device having been the only thing keeping him balanced."
    "Horrendum visu est; itaque recedere conor. Amicus autem mecum venit, quoniam solus contactus instrumenti eum in aequilibrio tenebat."

# game/a1s1.rpy:793
translate latin a1s1_0ac79c93:

    # "His weight takes me down and the next thing I know is that I'm flat on my back, struggling to breathe as Amicus's incredible weight crushes me into the metal deck."
    "Pondere eius deicior; mox supinus iaceo, respirare conans, dum immane pondus Amici me ad tabulatum metallicum comprimit."

# game/a1s1.rpy:794
translate latin a1s1_af2c94a3:

    # "He practically envelopes me with his soft, furry body, his big head resting on my chest."
    "Molli villosoque corpore paene totum me tegit, magno capite in pectore meo posito."

# game/a1s1.rpy:795
translate latin a1s1_fa4bd332:

    # "I stare down at him, watching as his black lips and eyelids twitch, his tongue hanging out as he makes sporadic snorting sounds."
    "Eum infra me intueor et video labia nigra palpebrasque moveri, linguam exsertam esse, dum interdum stertentes sonos edit."

# game/a1s1.rpy:796
translate latin a1s1_20d70cce:

    # "I gasp and strain as I spend the next minute working myself out from under him, grimacing as his foamy drool smears on my chest."
    "Anhelo et contendo, per proximum minutum me sub eo expediens; vultum contraho cum saliva spumosa pectus meum inquinat."

# game/a1s1.rpy:797
translate latin a1s1_52e804e4:

    # "Finally, I manage to break free of his dead weight and crawl a few feet away, spending a few moments catching my breath."
    "Tandem a pondere corporis inerti me libero et aliquot pedes adrepo; paulisper spiritum recipio."

# game/a1s1.rpy:798
translate latin a1s1_b7cd334b:

    # "I look back at his still-twitching form, his rump stuck slightly up in the air."
    "Eum respicio adhuc trementem, natibus paulum in aera sublatis."

# game/a1s1.rpy:799
translate latin a1s1_10de3b99:

    # "I wonder how long I have before he wakes up."
    "Cogito quantum temporis habeam antequam expergiscatur."

# game/a1s1.rpy:800
translate latin a1s1_43a040f6:

    # "There's a long, shiny, thin cord around my left wrist and I start to work at the knot."
    "Longus funiculus nitidus tenuisque carpum sinistrum circumdat; nodum solvere incipio."

# game/a1s1.rpy:801
translate latin a1s1_d447fbee:

    # "It's a strange material; smooth and metallic, yet it bends as easily as rope."
    "Materia insolita est: levis et metallica, sed tam facile quam funis flectitur."

# game/a1s1.rpy:802
translate latin a1s1_66c4f01b:

    # "It's a pain in the ass getting it undone, though."
    "Solvere eum tamen ingens molestia est."

# game/a1s1.rpy:803
translate latin a1s1_8714ba7d:

    # "It's like the dumb wolf just put as many knots into it as he could."
    "Quasi stultus ille lupus tot nodos fecerit quot facere potuerit."

# game/a1s1.rpy:804
translate latin a1s1_b9dbd443:

    # "He probably had no idea of what he was doing and now it makes sense why I was able to get out of it so easily."
    "Fortasse nesciebat omnino quid faceret; iam intellego cur tam facile me expedire potuerim."

# game/a1s1.rpy:805
translate latin a1s1_a8d0a848:

    # "While I'm undoing the mess I keep looking over at him."
    "Dum hanc confusionem solvo, eum identidem respicio."

# game/a1s1.rpy:806
translate latin a1s1_39ecb235:

    # "The twitches and snorts are subsiding, which I'm not sure is a good thing or not."
    "Spasmi et fremitus languescunt; id bonum sit necne, nescio."

# game/a1s1.rpy:807
translate latin a1s1_b2333d2b:

    # m "\"Come on...\""
    m "\"Age...\""

# game/a1s1.rpy:808
translate latin a1s1_bc3ed4a0:

    # "I grunt as I finally pull the last tangle out, straightening the metal rope thing out in both my hands."
    "Gemo dum ultimum tandem nodum expedio, funem illum metallicum utraque manu extendens."

# game/a1s1.rpy:809
translate latin a1s1_a1c28065:

    # "I look between it and the knocked out wolf in front of me, giving my head a little shake."
    "Modo funem, modo lupum ante me exanimatum aspicio, caput leviter quatiens."

# game/a1s1.rpy:810
translate latin a1s1_24765329:

    # m "\"What the fuck is even happening.\""
    m "\"Quid mehercule hic omnino agitur.\""

# game/a1s1.rpy:811
translate latin a1s1_7ce057fa:

    # "I get to work, planting my butt on Amicus's as I pull both of his paws behind his back."
    "Operi me accingo, natibus meis super nates Amici positis, dum ambas eius manus post tergum traho."

# game/a1s1.rpy:812
translate latin a1s1_dd88d670:

    # "I have some difficulty keeping my balance as I lift his heavy arms and start winding the rope around his wrists."
    "Aequilibrium servare aegre possum dum bracchia eius gravia tollo et funem circa carpos volvere incipio."

# game/a1s1.rpy:813
translate latin a1s1_507b671e:

    # "I'm not exactly an expert at tying hands behind backs either, but I feel far more confident in my work than Amicus ever should have in his own."
    "Neque ego sane peritus sum manus post tergum vinciendi, sed operi meo multo magis confido quam Amicus umquam suo confidere debuit."

# game/a1s1.rpy:814
translate latin a1s1_8858af24:

    # "I guess his carelessness makes some sort of sense considering I'm a tiny human and he's a giant canine."
    "Neglegentiam eius aliquatenus intellegi posse arbitror, cum ego homunculus sim, ille canis immanis."

# game/a1s1.rpy:815
translate latin a1s1_4069dac7:

    # "He probably thought he'd just be able to toss me back in the closet if I got free."
    "Probabiliter putabat se, si me expedissem, in armarium iterum conicere posse."

# game/a1s1.rpy:816
translate latin a1s1_f6e11450:

    # "I look over my work, somewhat satisfied with how neat and tight the binding is."
    "Opus meum inspicio, satis contentus quod vinculum tam concinne arcteque ligatum est."

# game/a1s1.rpy:817
translate latin a1s1_1865a3ba:

    # "I shift and almost slide off the wolf's ass, forcing me to put my hands back and steady myself on his thighs."
    "Me moveo et paene de culo lupi delabor; itaque manus retrorsum pono atque femoribus eius innixus me stabilio."

# game/a1s1.rpy:818
translate latin a1s1_e75ff83a:

    # "They're thick and heavily muscled, and that makes me realize that they might also be a problem."
    "Crassa sunt et validis musculis praedita, quod me monet ea quoque mihi difficultatem allatura esse."

# game/a1s1.rpy:819
translate latin a1s1_83bbf679:

    # "While binding his arms is a start, I have no doubt in my mind he'd be able to take me out with a few nasty kicks."
    "Bracchia eius vincire initium quidem est, sed minime dubito quin paucis calcibus saevis me prosternere possit."

# game/a1s1.rpy:820
translate latin a1s1_2a9735f5:

    # "I stand up and start looking around for more of that rope, but that's when I notice something strange happening outside the windows."
    "Surgo et alium funem quaerere incipio, sed tum animadverto aliquid mirum extra fenestras fieri."

# game/a1s1.rpy:821
translate latin a1s1_fe576099:

    # "Thin streaks of white light stretch and bend, moving slowly from the front before arcing in long lines to the sides and disappearing from sight."
    "Tenues lineae lucis albae extenduntur flectunturque, lente a parte anteriore venientes, deinde longis arcubus ad latera abeunt atque e conspectu evanescunt."

# game/a1s1.rpy:822
translate latin a1s1_53ea1c99:

    # "I stare, mesmerized, then suddenly feel sick at the sight."
    "Attonitus specto, deinde aspectu illo subito nauseam sentio."

# game/a1s1.rpy:823
translate latin a1s1_6600e992:

    # "I avert my eyes, looking at the wall while I watch the strange light show out of the corner of my eye."
    "Oculos averto et parietem aspicio, dum mirum illud lucis spectaculum ex obliquo observo."

# game/a1s1.rpy:824
translate latin a1s1_1e9902e6:

    # "Are those stars? Are we in some sort of worm hole or, what was it called, hyperspace?"
    "Suntne illae stellae? In quodam cuniculo vermiformi sumus, an in... quomodo vocabatur... hyperspatio?"

# game/a1s1.rpy:825
translate latin a1s1_c8290883:

    # "I start to get the feeling that I'm very, very far from Earth now, which makes me feel even more sick."
    "Sentire incipio me iam longissime, longissime a Terra abesse, quod nauseam etiam auget."

# game/a1s1.rpy:826
translate latin a1s1_cbc3592a:

    # "I want to keep my mind off of it, so I set about searching the deck for more of the metal rope, trying to ignore that we might be moving at the speed of light into the depths of space."
    "Hoc cogitare nolo; itaque tabulatum perscrutor, alium funem metallicum quaerens, atque conor neglegere nos fortasse celeritate lucis in ima spatii ferri."

# game/a1s1.rpy:827
translate latin a1s1_87c99906:

    # "I don't have much luck; most everything in the ship is flush to its surface with very few moving parts."
    "Parum mihi succedit; paene omnia in nave plana sunt cum superficie sua, paucis admodum partibus mobilibus."

# game/a1s1.rpy:828
translate latin a1s1_ceb823a8:

    # "I end up going back to the utility closet and that's when I see that metal polygon with the long cord sticking out of it, the one I'd knocked off the shelf earlier."
    "Tandem ad armarium instrumentorum redeo; ibi polygonum illud metallicum conspicio, e quo longus funiculus exit, quod antea de pluteo deieceram."

# game/a1s1.rpy:829
translate latin a1s1_82aeb659:

    # "I lean over and pull at it, deciding that it should hold, even if it's more plastic-y and not metal."
    "Inclino me et funiculum traho, statuens eum satis firmum fore, etsi potius plasticus quam metallicus est."

# game/a1s1.rpy:830
translate latin a1s1_97c8d841:

    # "Five minutes later and I have his legs bound together."
    "Quinque minutis post crura eius inter se ligata sunt."

# game/a1s1.rpy:831
translate latin a1s1_4fda4b14:

    # "I search around for the taser for another minute before finding it pinned between Amicus's chest and the deck."
    "Percussorem electricum aliud minutum quaero, donec eum inter pectus Amici et tabulatum pressum invenio."

# game/a1s1.rpy:832
translate latin a1s1_033398ee:

    # "I'm hot and sweaty as I finally sit back against the opposite wall, staring at the face-down wolf and his bindings."
    "Calidus sudoreque madidus tandem contra parietem oppositum consido, lupum pronum eiusque vincula intuens."

# game/a1s1.rpy:833
translate latin a1s1_337cc2e4:

    # "I weigh the taser in my hand, going over scenarios in my mind for what I'm going to say to him when he wakes back up..."
    "Percussorem electricum in manu pondero, animo varias res volvens quas illi, cum experrectus erit, dicere possim..."

# game/a1s1.rpy:836
translate latin a1s1_24963ce4:

    # "I'm not sure how long it takes; an hour, maybe two before Amicus starts to stir."
    "Quantum tempus praeterierit nescio: hora, fortasse duae, antequam Amicus moveri incipit."

# game/a1s1.rpy:837
translate latin a1s1_7693e9e2:

    # "First he groans, then he rolls over a few times, then draws up his bound legs before trying to work his paws free."
    "Primum gemit, deinde aliquotiens se volvit; tum crura ligata contrahit, priusquam manus expedire conetur."

# game/a1s1.rpy:838
translate latin a1s1_dc4b67b0:

    # "Finally, he opens his eyes and because he's on his side, I'm the first thing he sees."
    "Tandem oculos aperit et, cum in latere iaceat, me primum videt."

# game/a1s1.rpy:839
translate latin a1s1_2e497fe4:

    # "He squints, frowns, then groans again, turning over onto his stomach."
    "Oculos contrahit, frontem corrugat, deinde iterum gemit et in ventrem se vertit."

# game/a1s1.rpy:843
translate latin a1s1_fcdd355c:

    # a "\"What the hell?\""
    a "\"Quid malum?\""

# game/a1s1.rpy:844
translate latin a1s1_1479e231:

    # "I clear my throat and swallow, trying not to show how nervous I am."
    "Tussicula fauces purgo et deglutio, conans occultare quam anxius sim."

# game/a1s1.rpy:845
translate latin a1s1_d90b82a6:

    # m "\"Yeah, what the hell. You tazed me again.\""
    m "\"Ita, quid malum. Iterum mihi ictum electricum intulisti.\""

# game/a1s1.rpy:847
translate latin a1s1_3c8805f7_2:

    # a "\"What?\""
    a "\"Quid?\""

# game/a1s1.rpy:848
translate latin a1s1_48ae054f:

    # "Amicus turns his head to look at me again, then looks away, letting out another groan."
    "Amicus caput vertit ut me iterum aspiciat, tum oculos avertit atque rursus gemit."

# game/a1s1.rpy:850
translate latin a1s1_7a736a4b:

    # a "\"Ohh, my stomach. What did you do?\""
    a "\"Ooh, venter meus. Quid fecisti?\""

# game/a1s1.rpy:851
translate latin a1s1_44f6da45:

    # m "\"Exactly what you did to me.\""
    m "\"Id ipsum quod mihi tu fecisti.\""

# game/a1s1.rpy:852
translate latin a1s1_2afb3018:

    # "I hold up my taser, turning it in the light so that the wolf can fully see it."
    "Percussorem electricum tollo et in lumine verto, ut lupus totum videre possit."

# game/a1s1.rpy:853
translate latin a1s1_2fa5552f:

    # "Amicus stares at it for a moment before letting his face fall back to the floor of the deck."
    "Amicus eum paulisper intuetur, antequam faciem ad tabulatum relabi sinit."

# game/a1s1.rpy:855
translate latin a1s1_631c3f7d:

    # a "\"Oh Gods, I feel like I'm on fire...did you use it at full power? What the hell is wrong with you!?\""
    a "\"O di, quasi ardeam sentio... summamne vim adhibuisti? Quid malum tibi est!?\""

# game/a1s1.rpy:856
translate latin a1s1_dbfd776e:

    # "Despite my fear and anxiety over this entire situation, I'm able to feel indignant."
    "Quamquam totius rei metu anxietateque premor, indignari tamen possum."

# game/a1s1.rpy:857
translate latin a1s1_f79d6da1:

    # m "\"Me!? You did the same to me, then lied to me, then tazed me AGAIN, then tied me up. You're crazy!\""
    m "\"Mihi!? Idem mihi fecisti, deinde mentitus es, deinde me ITERUM electropercussisti, tum ligasti. Insanus es!\""

# game/a1s1.rpy:859
translate latin a1s1_241eb306:

    # a "\"I would NEVER use full power on ANYONE. Uggghhh.\""
    a "\"Ego NEMINI UMQUAM summam vim adhiberem. Uggghhh.\""

# game/a1s1.rpy:860
translate latin a1s1_2aa72739:

    # "Amicus seems to ignore my rant as he rolls onto his back, arching over his tied paws, probably stretching out the muscles that I'd hit with the taser."
    "Amicus querelas meas neglegere videtur dum supinus se volvit atque super manus vinctas dorsum curvat, fortasse musculos percussore electrico ictos extendens."

# game/a1s1.rpy:861
translate latin a1s1_3544bdcb:

    # "I wait a while longer, listening to the grunts, groans, and complaints as Amicus continues to whine."
    "Aliquantum diutius exspecto, fremitus, gemitus querelasque audiens, dum Amicus plorare pergit."

# game/a1s1.rpy:862
translate latin a1s1_d2816400:

    # "I'm not that stupid, though."
    "Non tamen tam stultus sum."

# game/a1s1.rpy:863
translate latin a1s1_db16d373:

    # "I can tell he's stalling for time, trying to figure out a way to get out of this."
    "Intellego eum tempus terere, viam excogitantem qua se ex his rebus expedire possit."

# game/a1s1.rpy:864
translate latin a1s1_1950528a:

    # "I stand up."
    "Surgo."

# game/a1s1.rpy:865
translate latin a1s1_a05f8ccf:

    # m "\"Take me home.\""
    m "\"Me domum reduc.\""

# game/a1s1.rpy:866
translate latin a1s1_cef44645:

    # "Amicus opens one eye, glaring at me."
    "Amicus alterum oculum aperit et me torve aspicit."

# game/a1s1.rpy:868
translate latin a1s1_3c8805f7_3:

    # a "\"What?\""
    a "\"Quid?\""

# game/a1s1.rpy:869
translate latin a1s1_3e0e781e:

    # m "\"I said take me home.\""
    m "\"Dixi ut me domum reduceres.\""

# game/a1s1.rpy:871
translate latin a1s1_f8801f6f:

    # "Amicus goes quiet for a moment, his eyes closed, then he forces himself to sit up, visibly cringing as he's forced to use his stomach muscles."
    "Amicus paulisper tacet, oculis clausis; deinde se erigit, dolore manifesto vultum contrahens, cum musculis ventris uti cogatur."

# game/a1s1.rpy:872
translate latin a1s1_052ed4a0:

    # "He scoots back with more complaints until he plants his back against the wall behind him."
    "Plura querens retro se trahit, donec dorsum parieti post se posito applicat."

# game/a1s1.rpy:873
translate latin a1s1_8ef55b42:

    # "I see his shoulders shift, his biceps bulging and can tell that he's working and testing the restraints."
    "Umeros eius moveri video et musculos bracchiorum intumescere; intellego eum vincula moliri eorumque firmitatem temptare."

# game/a1s1.rpy:874
translate latin a1s1_773caa22:

    # "I raise the taser."
    "Percussorem electricum tollo."

# game/a1s1.rpy:875
translate latin a1s1_0a4c5353:

    # m "\"Stop moving or I'm gonna hit you again.\""
    m "\"Desine moveri, alioquin te iterum percutiam.\""

# game/a1s1.rpy:877
translate latin a1s1_249f2c03:

    # a "\"Fuck off.\""
    a "\"Abi in malam rem.\""

# game/a1s1.rpy:878
translate latin a1s1_211ba9fb:

    # "I move toward him, brandishing the taser like a sword."
    "Ad eum accedo, percussorem electricum quasi gladium vibrans."

# game/a1s1.rpy:880
translate latin a1s1_6e0e0854:

    # a "\"Hey, hey, HEY!\""
    a "\"Heus, heus, HEUS!\""

# game/a1s1.rpy:881
translate latin a1s1_9de7b642:

    # "Amicus kicks his feet up, trying to block my attack."
    "Amicus pedes sursum iactat, impetum meum arcere conans."

# game/a1s1.rpy:883
translate latin a1s1_bb38f7d4:

    # "Now I see real fear in his eyes."
    "Iam verum metum in oculis eius video."

# game/a1s1.rpy:884
translate latin a1s1_209e064c:

    # m "\"Then stop moving and tell me how we get back!\""
    m "\"Tum desine moveri et dic mihi quomodo redeamus!\""

# game/a1s1.rpy:885
translate latin a1s1_42ea5d47:

    # "I don't really want to shock him again."
    "Re vera alterum ictum electricum ei inferre nolo."

# game/a1s1.rpy:886
translate latin a1s1_a1394111:

    # "It did look really painful and on top of that I don't want to knock him out for hours while our little ship is hurtling through space."
    "Ictus sane dolore plenus videbatur; praeterea nolo eum per horas exanimare, dum navicula nostra per spatium rapitur."

# game/a1s1.rpy:887
translate latin a1s1_4c3706c6:

    # "Amicus glares at me for a moment, his feet still in the air before he slowly lowers them."
    "Amicus paulisper me torve intuetur, pedibus adhuc sublatis, antequam eos lente demittit."

# game/a1s1.rpy:889
translate latin a1s1_987ecee1:

    # a "\"I'll...show you if you let me go.\""
    a "\"Ego... tibi ostendam, si me solveris.\""

# game/a1s1.rpy:890
translate latin a1s1_77da021f:

    # "I actually laugh and the sound seems to startle the wolf."
    "Re vera rideo, cuius sonus lupum perterrere videtur."

# game/a1s1.rpy:891
translate latin a1s1_d861dde5:

    # m "\"Are you kidding me? Why should I trust you at ALL after what you've done to me.\""
    m "\"Ludisne me? Cur tibi post ea quae mihi fecisti OMNINO credam.\""

# game/a1s1.rpy:892
translate latin a1s1_2fcfdb70:

    # "Amicus's ears flatten."
    "Amicus aures demittit."

# game/a1s1.rpy:893
translate latin a1s1_03ac5185:

    # m "\"Tell me where the hell you're taking me and why, otherwise I WILL zap you again.\""
    m "\"Dic mihi quo malum me ducas et cur; alioquin te iterum CERTE electropercutiam.\""

# game/a1s1.rpy:895
translate latin a1s1_bec79dea:

    # a "\"Wh—I...\""
    a "\"Qu... ego...\""

# game/a1s1.rpy:896
translate latin a1s1_6e5ab8a9:

    # "He seems at a loss for words."
    "Quid dicat invenire non posse videtur."

# game/a1s1.rpy:897
translate latin a1s1_082d1406:

    # m "\"Hm?\""
    m "\"Hm?\""

# game/a1s1.rpy:899
translate latin a1s1_203d9ea9:

    # a "\"I...can't tell you.\""
    a "\"Ego... tibi dicere non possum.\""

# game/a1s1.rpy:900
translate latin a1s1_c7b19f48:

    # "I glare and for a moment I consider just jabbing him again right then and there."
    "Eum torve aspicio atque paulisper cogito an ilico iterum percussorem in eum impellam."

# game/a1s1.rpy:901
translate latin a1s1_2558be92:

    # m "\"Why not?\""
    m "\"Cur non?\""

# game/a1s1.rpy:903
translate latin a1s1_a316e54e:

    # "The wolf remains silent as he looks away from me."
    "Lupus tacet, oculos a me avertens."

# game/a1s1.rpy:904
translate latin a1s1_15ba54a7:

    # "I feel myself getting even more angry."
    "Sentio iram meam magis etiam crescere."

# game/a1s1.rpy:905
translate latin a1s1_66882f4d:

    # "I'm tired of this alien holding me hostage."
    "Taedet me ab hoc alienigena captivum teneri."

# game/a1s1.rpy:906
translate latin a1s1_300292c4:

    # m "\"Well, I guess I'll just have to figure it out on my own, then.\""
    m "\"Bene, tum mihi ipsi rem explorandam esse puto.\""

# game/a1s1.rpy:909
translate latin a1s1_2104fa6c:

    # "I turn away and start moving toward the front of the deck."
    "Me averto et ad partem anteriorem tabulati ire incipio."

# game/a1s1.rpy:910
translate latin a1s1_00cfaef0:

    # "Amicus shifts around behind me."
    "Amicus post me se movet."

# game/a1s1.rpy:912
translate latin a1s1_55026a02:

    # a "\"What!? You don't know the first thing about this ship. Don't—\""
    a "\"Quid!? Ne primam quidem rem de hac nave scis. Noli—\""

# game/a1s1.rpy:913
translate latin a1s1_bfc07adc:

    # "The big wolf grunts as he tries to get his feet under him."
    "Lupus magnus fremit, dum pedes sub corpus adducere conatur."

# game/a1s1.rpy:915
translate latin a1s1_cd38769c:

    # a "\"Don't touch anything!\""
    a "\"Noli quidquam tangere!\""

# game/a1s1.rpy:917
translate latin a1s1_fac31667:

    # "I ignore him and move to the panels, looking them over."
    "Eum neglego et ad tabulas gubernandi accedo easque inspicio."

# game/a1s1.rpy:918
translate latin a1s1_04238e7f:

    # "The big one in the middle looks promising and I start poking at it."
    "Magna illa in medio posita utilis videtur, itaque eam digito pulsare incipio."

# game/a1s1.rpy:919
translate latin a1s1_61bfbf1e:

    # "I know I won't be able to figure out how to turn the ship around, but the wolf's worry over me touching the panels gives me an idea."
    "Scio me rationem convertendae navis invenire non posse, sed sollicitudo lupi quod tabulas tango consilium mihi suggerit."

# game/a1s1.rpy:920
translate latin a1s1_a5cb80d7:

    # "I can probably mess things up to the point where he'll HAVE to tell me what he's doing, or even how I might be able to get back."
    "Fortasse omnia ita perturbare possum ut is mihi quid agat dicere COGATUR, vel etiam quomodo redire possim."

# game/a1s1.rpy:921
translate latin a1s1_34c56a12:

    # "There aren't many other options aside from torturing him, something I don't really want to do."
    "Praeter eum cruciare paucae aliae viae patent, nec id re vera facere volo."

# game/a1s1.rpy:922
translate latin a1s1_ac0fd900:

    # "The lines and shapes move with my finger and Roman numerals pop up randomly here and there."
    "Lineae figuraeque digitum meum sequuntur, atque numeri Romani passim temere apparent."

# game/a1s1.rpy:923
translate latin a1s1_de82b99b:

    # a "\"Hey...what...are you doing?\""
    a "\"Heus... quid... agis?\""

# game/a1s1.rpy:924
translate latin a1s1_816b3a4b:

    # "Amicus huffs and puffs behind me, just as a circle appears and compresses around my finger, like it's zeroed in on something."
    "Amicus post me anhelat, eo ipso tempore quo circulus apparet et circa digitum meum contrahitur, quasi aliquid destinaverit."

# game/a1s1.rpy:925
translate latin a1s1_6ef00a2c:

    # "I look back to see Amicus hobbling up onto his tied together feet, looking just about ready to topple over."
    "Retro aspicio et Amicum video aegre in pedes inter se ligatos surgentem, quasi iam iamque casurum."

# game/a1s1.rpy:927
translate latin a1s1_60384470:

    # a "\"You have no idea what—\""
    a "\"Ne cogitationem quidem habes quid—\""

# game/a1s1.rpy:928
translate latin a1s1_df946a3b:

    # "I feel a soft vibration under my finger not unlike my phone's haptic feedback."
    "Sub digito levem vibrationem sentio, haud dissimilem tactili responsioni telephoni mei."

# game/a1s1.rpy:929
translate latin a1s1_21f2d835:

    # com "\"Overriding sleep mode. Locked on to Stella 556425.\""
    com "\"Modus quietis tollitur. Stella 556425 destinata est.\""

# game/a1s1.rpy:931
translate latin a1s1_b509f5b1:

    # a "\"NO! Com, stop last directive!\""
    a "\"NON! Com, ultimum imperatum siste!\""

# game/a1s1.rpy:932
translate latin a1s1_29c57a0f:

    # com "\"Voice commands for piloting are reserved for the emperor, Amicus.\""
    com "\"Mandata vocalia ad navem gubernandam soli imperatori reservantur, Amice.\""

# game/a1s1.rpy:934
translate latin a1s1_dfff6d75:

    # a "\"Human, stop!\""
    a "\"Homo, desiste!\""

# game/a1s1.rpy:935
translate latin a1s1_cf0ce5d4:

    # "Amicus starts hopping toward me on his bound feet and I scramble to the side so he doesn't run into me."
    "Amicus pedibus vinctis ad me subsilire incipit; ego festinanter in latus me recipio, ne in me incurrat."

# game/a1s1.rpy:936
translate latin a1s1_f34a2ef9:

    # a "\"No, no, no!\""
    a "\"Non, non, non!\""

# game/a1s1.rpy:937
translate latin a1s1_b9556f4d:

    # "The wolf stares down at the panel and I look out the window as the stars seem to curve all the way to my right, making me feel sick again and the next thing I know—"
    "Lupus tabulam gubernandi intuetur; ego per fenestram aspicio, dum stellae omnes ad dextram curvari videntur, iterum mihi nauseam moventes, ac subito—"

# game/a1s1.rpy:941
translate latin a1s1_b2799851:

    # "The cabin is lit up by an ominous red glow."
    "Cubiculum navis luce rubra minaci illuminatur."

# game/a1s1.rpy:943
translate latin a1s1_4e63b230:

    # "The windows suddenly tint, blocking the worst of the light and that's when I'm able to see a massive ball of fire in front of the ship."
    "Fenestrae subito obscurantur et acerrimam lucem arcent; tum tandem immensam ignis sphaeram ante navem videre possum."

# game/a1s1.rpy:944
translate latin a1s1_c14b867c:

    # "The size of it is incredible."
    "Magnitudo eius incredibilis est."

# game/a1s1.rpy:945
translate latin a1s1_43e0695f:

    # com "\"Orbital trajectory will intersect with photosphere. Ensure safety straps are in place. Making corrective maneuvers.\""
    com "\"Traiectus orbitalis photosphaeram secabit. Curate ut lora securitatis alligata sint. Motus ad cursum corrigendum fiunt.\""

# game/a1s1.rpy:946
translate latin a1s1_2d5b5342:

    # "I only have a moment to wonder what the hell Com is talking about before Amicus and I are thrown sideways into the left window of the ship."
    "Vix mihi tempus est quaerendi quid malum Com dicat, antequam ego et Amicus in latus proiecti sinistram navis fenestram ferimur."

# game/a1s1.rpy:947
translate latin a1s1_c4817402:

    # "The impact is mostly cushioned by Amicus's body and I hear him yell and curse under me."
    "Corpus Amici maximam ictus partem excipit; eum sub me clamantem maledicentemque audio."

# game/a1s1.rpy:949
translate latin a1s1_ff1f31fe:

    # a "\"MOVE! GET IN THE SEAT!\""
    a "\"MOVE TE! IN SEDEM CONSCENDE!\""

# game/a1s1.rpy:950
translate latin a1s1_a7217bce:

    # "I struggle to reach out to the seat in front of me, but I can barely lift my hand."
    "Ad sedem ante me positam manum porrigere conor, sed vix eam tollere possum."

# game/a1s1.rpy:951
translate latin a1s1_e2f00504:

    # "The gravity of the star is so powerful it feels like it's going to suck out my soul."
    "Stellae vis gravitatis tam valida est ut animam ipsam mihi exsugere videatur."

# game/a1s1.rpy:952
translate latin a1s1_1319dd6f:

    # "Then I'm suddenly boosted up by something behind me and I look back, the movement making me feel like my neck is going to break."
    "Tum subito aliquid post me positum sursum me propellit; retro aspicio, atque eo motu sentio quasi collum meum frangatur."

# game/a1s1.rpy:953
translate latin a1s1_e626bc22:

    # "I see Amicus with his back planted against the window, his feet pushing me up to the seat."
    "Amicum video dorso contra fenestram innixum, pedibus me ad sedem sursum impellentem."

# game/a1s1.rpy:954
translate latin a1s1_c271fa10:

    # "I manage to grab the armrest and pull myself into it."
    "Fulcrum bracchii arripere possum atque me in sedem traho."

# game/a1s1.rpy:955
translate latin a1s1_b1825b6e:

    # "Now the left armrest is digging painfully into my back, making it feel as if a professional wrestler is slamming me into a back breaker."
    "Iam sinistrum bracchii fulcrum in dorsum meum dolorose premit, quasi luctator professionalis me ictu dorsum frangente prosternat."

# game/a1s1.rpy:956
translate latin a1s1_92835a48:

    # "Amicus jumps from the window, high enough that his feet land against the right side of my chair."
    "Amicus a fenestra tam alte subsilit ut pedes eius dextrum sedis meae latus attingant."

# game/a1s1.rpy:958
translate latin a1s1_2dba6ea7:

    # "Then he jumps again, managing to wedge himself in the footwell of the opposite seat."
    "Deinde iterum subsilit atque se in locum pedibus destinatum sub sede opposita insinuare potest."

# game/a1s1.rpy:959
translate latin a1s1_cd243b41:

    # com "\"Heat shields are compromised. Expect heat damage to outer layer of ship in 30 seconds.\""
    com "\"Scuta contra calorem laesa sunt. Post 30 secundas pars exterior navis calore laedi incipiet.\""

# game/a1s1.rpy:960
translate latin a1s1_5f694945:

    # "With a great deal of snarling and gasping, he pushes himself awkwardly into the seat, both feet planted against the panels in front of him for leverage."
    "Multum ringens et anhelans se aegre in sedem propellit, utroque pede in tabulas ante se positas fixo, quo nixum habeat."

# game/a1s1.rpy:961
translate latin a1s1_8bf1646e:

    # "He turns to me, teeth bared, a determined look in his eyes."
    "Ad me vertitur, dentibus nudatis et oculis pertinacibus."

# game/a1s1.rpy:962
translate latin a1s1_bc262306:

    # a "\"Look at your right armrest! Do you see the green panel between the red buttons!?\""
    a "\"Aspice dextrum bracchii fulcrum! Videsne tabulam viridem inter globulos rubros!?\""

# game/a1s1.rpy:963
translate latin a1s1_88e05b31:

    # "Through the shock I'm somehow able to understand him and look down."
    "Quamquam attonitus sum, nescio quomodo eum intellego et deorsum aspicio."

# game/a1s1.rpy:964
translate latin a1s1_fdcef024:

    # a "\"Now, drag your finger across it to the left, it'll steer the ship!\""
    a "\"Nunc digitum per eam ad sinistram trahe; navem gubernabit!\""

# game/a1s1.rpy:965
translate latin a1s1_1b074d8a:

    # "I feel panic starting to rise in my chest at the idea of steering a goddamn spaceship."
    "Pavor pectus meum occupare incipit, cum navem spatialem execrandam mihi gubernandam cogito."

# game/a1s1.rpy:966
translate latin a1s1_486a0250:

    # m "\"What!?\""
    m "\"Quid!?\""

# game/a1s1.rpy:967
translate latin a1s1_ce8eb89f:

    # a "\"Just do it! Point us away from the star!\""
    a "\"Fac modo! Navem a stella averte!\""

# game/a1s1.rpy:968
translate latin a1s1_1f4abbb6:

    # "I do as I'm told, sliding a thumb gingerly over the green panel."
    "Facio quod iubet, pollicem caute per tabulam viridem ducens."

# game/a1s1.rpy:969
translate latin a1s1_f9d2d076:

    # "And slowly the ship turns, pointing away from the star, shifting the incredible force of gravity until it's pulling us back into the seats."
    "Navis lente vertitur et a stella avertitur; ingens gravitatis vis directionem mutat, donec nos retrorsum in sedes premit."

# game/a1s1.rpy:970
translate latin a1s1_e4599b3d:

    # a "\"Now...now see that lever in between us!?\""
    a "\"Nunc... nunc videsne vectem illum inter nos!?\""

# game/a1s1.rpy:971
translate latin a1s1_ba9c3ac4:

    # m "\"Yeah!\""
    m "\"Ita!\""

# game/a1s1.rpy:972
translate latin a1s1_f663d1d7:

    # a "\"Pull it down!\""
    a "\"Deorsum trahe!\""

# game/a1s1.rpy:973
translate latin a1s1_459ab3e4:

    # "Now reaching my hand out is almost impossible as it gets pulled back toward the star behind us."
    "Iam manum porrigere paene impossibile est, cum retrorsum ad stellam post nos positam trahatur."

# game/a1s1.rpy:974
translate latin a1s1_0a5dfde7:

    # "Gritting my teeth, I lean forward as hard as I can, practically throwing myself forward and grabbing onto the lever."
    "Dentibus compressis, quantum possum in anteriorem partem inclino, paene totum me eo coniciens, atque vectem arripio."

# game/a1s1.rpy:975
translate latin a1s1_ce9fad3a:

    # "Then gravity does the rest of the work and the lever comes down hard."
    "Tum gravitas reliquum opus perficit, atque vectis violenter descendit."

# game/a1s1.rpy:976
translate latin a1s1_1afa6c1e:

    # "I lose my grip and get thrown back into my seat."
    "Manus mihi labitur, et in sedem retrorsum proicior."

# game/a1s1.rpy:979
translate latin a1s1_f0172b9a:

    # "The gravity increases two-fold and for a moment it feels like my entire body is being crushed into a pancake."
    "Vis gravitatis duplicatur, atque paulisper sentio quasi totum corpus meum in placentam planam comprimatur."

# game/a1s1.rpy:983
translate latin a1s1_b95a3d23:

    # "And then the burning orange light is gone and the deck goes black."
    "Tum lux ardens aurantiaca evanescit et tabulatum tenebris obtegitur."

# game/a1s1.rpy:985
translate latin a1s1_79c1dcbe:

    # com "\"Running diagnostics...Amicus?\""
    com "\"Examen diagnosticum fit... Amice?\""

# game/a1s1.rpy:986
translate latin a1s1_a20cefa7_11:

    # "..."
    "..."

# game/a1s1.rpy:987
translate latin a1s1_c36a13ce:

    # a "\"Yes, Com?\""
    a "\"Ita, Com?\""

# game/a1s1.rpy:988
translate latin a1s1_0c2a0d72:

    # com "\"Damage to the ship is severe. Recovery mode is required.\""
    com "\"Navis graviter laesa est. Modus recuperationis requiritur.\""

# game/a1s1.rpy:989
translate latin a1s1_a20cefa7_12:

    # "..."
    "..."

# game/a1s1.rpy:990
translate latin a1s1_e6f10430:

    # a "\"Enter recovery mode.\""
    a "\"Modum recuperationis incipe.\""

# game/a1s1.rpy:991
translate latin a1s1_b36aba0c:

    # com "\"Standby.\""
    com "\"Exspectate.\""

# game/a1s1.rpy:992
translate latin a1s1_a20cefa7_13:

    # "..."
    "..."

# game/a1s1.rpy:997
translate latin a1s1_53ebd070:

    # "We sit in silence for a long, long time."
    "Diu, diutissime taciti sedemus."

# game/a1s1.rpy:998
translate latin a1s1_a3762f20:

    # "I lean against the seat with both feet drawn up to my chest, feeling numb and shaky."
    "In sede reclinatus ambos pedes ad pectus contraho, torpidus tremensque."

# game/a1s1.rpy:999
translate latin a1s1_60553089:

    # "I also feel stupid, embarrassed, and kind of guilty."
    "Etiam stultum me sentio, pudet me, et quodammodo reum me puto."

# game/a1s1.rpy:1000
translate latin a1s1_05993c8d:

    # "On one hand I nearly just got us both killed."
    "Hinc enim paene modo effeci ut ambo moreremur."

# game/a1s1.rpy:1001
translate latin a1s1_17873bdb:

    # "But on the other hand this crazy alien almost killed {i}me{/i} by bringing me here in the first place."
    "Illinc tamen hic alienigena insanus {i}me{/i} paene necavit, cum me huc primum adduxit."

# game/a1s1.rpy:1002
translate latin a1s1_350830fa:

    # "At least it feels that way."
    "Saltem ita mihi videtur."

# game/a1s1.rpy:1003
translate latin a1s1_34178ec1:

    # "I still don't know what his ultimate plan is with me."
    "Adhuc nescio quid tandem de me facere in animo habeat."

# game/a1s1.rpy:1004
translate latin a1s1_49786a05:

    # "I wonder for the hundredth time if I'm going to wake up."
    "Centies iam quaero an tandem experrecturus sim."

# game/a1s1.rpy:1005
translate latin a1s1_7b4eb03b:

    # "I plug my nose and try to breathe through my nostrils."
    "Nasum comprimo et per nares spirare conor."

# game/a1s1.rpy:1006
translate latin a1s1_061ad74f:

    # "No air comes through."
    "Nihil aeris transit."

# game/a1s1.rpy:1007
translate latin a1s1_9c1278a5:

    # "I sigh and look out the window, at the blue glow that we've found ourselves in."
    "Suspiro et per fenestram caeruleum illum fulgorem aspicio in quo versamur."

# game/a1s1.rpy:1008
translate latin a1s1_b8e14a66:

    # "The star that we'd just escaped is far away now, though it's still an almost-blinding tiny orb far to my left, kind of like the sun was not too long ago."
    "Stella quam modo effugimus iam longe abest, quamquam exigua sphaera paene caecans procul ad sinistram adhuc apparet, fere ut sol non ita pridem."

# game/a1s1.rpy:1009
translate latin a1s1_a8f16323:

    # "It's lighting up all of this dust that's around us with an eerie blue glow."
    "Omnem hunc pulverem circa nos positum miro fulgore caeruleo illuminat."

# game/a1s1.rpy:1010
translate latin a1s1_035489b0:

    # "It's kind of calming."
    "Quodammodo animum sedat."

# game/a1s1.rpy:1012
translate latin a1s1_c80a7ea9:

    # "I look over at Amicus and see him slumped in his chair, looking out the window."
    "Amicum aspicio et in sede collapsum video, per fenestram spectantem."

# game/a1s1.rpy:1013
translate latin a1s1_63be3a5d:

    # "His shoulders are hunched, ears drooping, and his head down."
    "Umeri eius incurvati sunt, aures languent, caput demissum est."

# game/a1s1.rpy:1014
translate latin a1s1_8db324c3:

    # "He's on the edge of his seat because his arms are still tied behind his back, forcing him to lean forward a bit."
    "In margine sedis sedet, quia bracchia adhuc post tergum ligata sunt, quae eum aliquantum in anteriorem partem inclinare cogunt."

# game/a1s1.rpy:1015
translate latin a1s1_fe5cde7c:

    # "Com hasn't spoken since we went into \"recovery mode\" and the ship hasn't moved at all."
    "Com nihil dixit ex quo in \"modum recuperationis\" intravimus, nec navis omnino mota est."

# game/a1s1.rpy:1016
translate latin a1s1_fdf72a54:

    # "The usual hum isn't even there."
    "Ne fremitus quidem solitus auditur."

# game/a1s1.rpy:1017
translate latin a1s1_94397e0d:

    # "It's like everything is turned off."
    "Quasi omnia exstincta sint."

# game/a1s1.rpy:1018
translate latin a1s1_19de60eb:

    # "I finally decide to break the silence."
    "Tandem silentium rumpere statuo."

# game/a1s1.rpy:1019
translate latin a1s1_2e87079d:

    # m "\"Amicus?\""
    m "\"Amice?\""

# game/a1s1.rpy:1020
translate latin a1s1_40f454f2:

    # "I see his ears flick, but he keeps his head down, not even looking at me."
    "Aures eius moveri video, sed caput demissum retinet nec me quidem aspicit."

# game/a1s1.rpy:1021
translate latin a1s1_a12bf6c9:

    # "I swallow, then try again."
    "Deglutio, deinde iterum conor."

# game/a1s1.rpy:1022
translate latin a1s1_74b1ef73:

    # m "\"Amicus.\""
    m "\"Amice.\""

# game/a1s1.rpy:1023
translate latin a1s1_74b02210:

    # "I see his shoulders rise and fall in a deep sigh, but he keeps silent."
    "Umeros eius alto suspirio attolli et demitti video, sed tacet."

# game/a1s1.rpy:1024
translate latin a1s1_0f7586f5:

    # "I'm about to just give up and slump back in my seat when he suddenly responds."
    "Iam paene desisto et in sede reclinor, cum ille subito respondet."

# game/a1s1.rpy:1025
translate latin a1s1_3c8805f7_4:

    # a "\"What?\""
    a "\"Quid?\""

# game/a1s1.rpy:1026
translate latin a1s1_604e6184:

    # m "\"What's happening?\""
    m "\"Quid accidit?\""

# game/a1s1.rpy:1028
translate latin a1s1_f20929c0:

    # "The wolf turns to glare at me."
    "Lupus vertitur et me torve intuetur."

# game/a1s1.rpy:1029
translate latin a1s1_d0761464:

    # a "\"What do you mean 'what's happening'? you broke the ship.\""
    a "\"Quid sibi vult istud 'quid accidit'? Navem fregisti.\""

# game/a1s1.rpy:1031
translate latin a1s1_d45b6579:

    # "He turns away and continues to sulk."
    "Se avertit atque indignabundus tacere pergit."

# game/a1s1.rpy:1032
translate latin a1s1_4f9b6fbc:

    # "I feel a little anger at that and I realize that this alien isn't alien at all."
    "Hoc aliquantum me irritat, atque intellego hunc alienigenam minime alienum esse."

# game/a1s1.rpy:1033
translate latin a1s1_3982a2ed:

    # "He's acting just like an upset human kid that didn't get his way."
    "Prorsus se gerit ut puer humanus iratus, cui non omnia ex sententia evenerunt."

# game/a1s1.rpy:1034
translate latin a1s1_734730b6:

    # "It makes me a little less afraid of him."
    "Ita eum paulo minus timeo."

# game/a1s1.rpy:1035
translate latin a1s1_def4f1e1:

    # m "\"Excuse me? Do I have to go through the list of shit that you did to me?\""
    m "\"Quid ais? Oportetne me omnia scelera recensere quae mihi fecisti?\""

# game/a1s1.rpy:1037
translate latin a1s1_c653dfba:

    # "Amicus turns to me again and I can almost see his mind working to think of some sort of comeback."
    "Amicus ad me iterum vertitur, et paene mentem eius video responsum aliquod mordax excogitantem."

# game/a1s1.rpy:1038
translate latin a1s1_36cafdff:

    # a "\"Well, I think you topped it by nearly throwing us into a star, human!\""
    a "\"Ego tamen puto te omnia superavisse, cum nos paene in stellam coniecisti, homo!\""

# game/a1s1.rpy:1039
translate latin a1s1_671aad74:

    # m "\"You shouldn't have kidnapped me in the first place, {i}wolf{/i}.\""
    m "\"Non debuisti me omnino rapere, {i}lupe{/i}.\""

# game/a1s1.rpy:1040
translate latin a1s1_1dc9a05f:

    # a "\"I should be calling you child since that's what you are.\""
    a "\"Te Liberum appellare debeo, quia id es.\""

# game/a1s1.rpy:1041
translate latin a1s1_3523184b:

    # m "\"Well this child outsmarted you, zapped you, and tied you up.\""
    m "\"At hic Liber te consilio vicit, electropercussit et vinxit.\""

# game/a1s1.rpy:1043
translate latin a1s1_9a8a2db3:

    # "I see him bristle, the hackles rising on his shoulders like a dog."
    "Video eum horrere, pilis in umeris sicut canis erectis."

# game/a1s1.rpy:1044
translate latin a1s1_81cbce4e:

    # a "\"You could have KILLED me. That setting is meant for creatures three times my size!\""
    a "\"Me NECARE potuisti. Ille gradus animalibus destinatur quae ter maiora quam ego sunt!\""

# game/a1s1.rpy:1045
translate latin a1s1_cef052dc:

    # m "\"How was I supposed to know!? I don't know anything about what's going on!\""
    m "\"Quomodo id scire debui!? Nihil scio de his quae fiunt!\""

# game/a1s1.rpy:1046
translate latin a1s1_5333b4c9:

    # a "\"I told you what's going on—\""
    a "\"Tibi dixi quid fiat—\""

# game/a1s1.rpy:1047
translate latin a1s1_99efae27:

    # m "\"You really think I'm stupid, don't you.\""
    m "\"Re vera me stultum putas, nonne.\""

# game/a1s1.rpy:1049
translate latin a1s1_a0a98c03:

    # "Amicus pouts and turns away again."
    "Amicus labra protrudit et iterum se avertit."

# game/a1s1.rpy:1050
translate latin a1s1_64a84c4f:

    # m "\"I think you thought I was some stupid alien you could just take advantage of. I can tell you've been lying to me this whole time.\""
    m "\"Credo te putavisse me esse alienigenam stultum quo facile abuti posses. Intellego te hoc toto tempore mihi mentitum esse.\""

# game/a1s1.rpy:1051
translate latin a1s1_70ea6b73:

    # "Amicus flattens his ears even more, shoulders bunching up."
    "Amicus aures magis etiam demittit et umeros contrahit."

# game/a1s1.rpy:1052
translate latin a1s1_b1b9128c:

    # m "\"Is that what you and your people do? Kidnapping and lying to everyone you meet—\""
    m "\"Hocne tu et gens tua facitis? Omnes quos convenitis rapitis et mendaciis fallitis—\""

# game/a1s1.rpy:1054
translate latin a1s1_157d5187:

    # "Now his hackles really raise up and he turns on me fast."
    "Iam pili eius vere eriguntur, et celeriter in me se vertit."

# game/a1s1.rpy:1055
translate latin a1s1_d41bc9db:

    # "I try not to lean back."
    "Conor ne retrorsum incliner."

# game/a1s1.rpy:1056
translate latin a1s1_7f1a5b27:

    # "Despite the similarities, he's still a wolf, and those teeth are terrifying."
    "Quamvis similis sit, lupus adhuc est, et dentes illi terribiles sunt."

# game/a1s1.rpy:1057
translate latin a1s1_d93bf076:

    # a "\"I do NOT lie...I—I...\""
    a "\"Ego NON mentior... ego—ego...\""

# game/a1s1.rpy:1058
translate latin a1s1_923bd551:

    # "The wolf's righteous indignation seems to deflate."
    "Indignatio lupi quasi iustissima deficere videtur."

# game/a1s1.rpy:1060
translate latin a1s1_dfdb5c47:

    # a "\"The situation is too complicated for you to understand.\""
    a "\"Res nimis implicata est quam ut intellegere possis.\""

# game/a1s1.rpy:1061
translate latin a1s1_af78b41c:

    # "I glare at him."
    "Eum torve aspicio."

# game/a1s1.rpy:1062
translate latin a1s1_7d7dd8f5:

    # m "\"Who's tied up again?\""
    m "\"Dic mihi rursus: quis vinctus est?\""

# game/a1s1.rpy:1063
translate latin a1s1_c0c56b45:

    # "Amicus doesn't take the bait this time and remains slumped."
    "Amicus hoc tempore in laqueum non cadit et demissus manet."

# game/a1s1.rpy:1064
translate latin a1s1_ea48f145:

    # a "\"I guess it doesn't matter now. We're probably going to die out here with how badly the ship is burned.\""
    a "\"Credo id iam nihil interesse. Verisimile est nos hic morituros esse, adeo navis combusta est.\""

# game/a1s1.rpy:1065
translate latin a1s1_96350b7d:

    # "That makes my stomach twist a bit."
    "Quibus verbis venter mihi aliquantum torquetur."

# game/a1s1.rpy:1066
translate latin a1s1_d945d777:

    # "I want to ask him if he's just moping or if he actually thinks we're going to die."
    "Quaerere volo an tantum se miserum fingat, an re vera nos morituros putet."

# game/a1s1.rpy:1067
translate latin a1s1_2c49dbb6:

    # "But another long moment of silence stretches between us."
    "Sed aliud longum silentium inter nos intercedit."

# game/a1s1.rpy:1068
translate latin a1s1_e1ab004f:

    # "I look out the window again, at the towering clouds of dust in front of us."
    "Iterum per fenestram aspicio altas pulveris nubes ante nos exsurgentes."

# game/a1s1.rpy:1069
translate latin a1s1_6ad35356:

    # m "\"Well...if that's the case, then can you just tell me what's going on?\""
    m "\"Bene... si ita est, potesne saltem mihi dicere quid fiat?\""

# game/a1s1.rpy:1070
translate latin a1s1_b378ae4f:

    # "Amicus goes on staring out his window."
    "Amicus per fenestram suam spectare pergit."

# game/a1s1.rpy:1071
translate latin a1s1_f10d1e85:

    # "I sigh and lean back, resigned to the idea that I might not ever know why I was dragged out to space to simply get stuck and die in a dust cloud."
    "Suspiro et reclinor, iam ferens me fortasse numquam sciturum cur in spatium tractus sim, ut tantum haererem atque in nube pulveris morerer."

# game/a1s1.rpy:1072
translate latin a1s1_fa931998:

    # "Then Amicus speaks."
    "Tum Amicus loquitur."

# game/a1s1.rpy:1074
translate latin a1s1_a33e8585:

    # a "\"I...made some mistakes.\""
    a "\"Ego... aliquot errores commisi.\""

# game/a1s1.rpy:1075
translate latin a1s1_3819ac9d:

    # "I glance at him, waiting, not wanting to say anything in case he stops talking."
    "Eum aspicio atque exspecto; nihil dicere volo, ne tacere incipiat."

# game/a1s1.rpy:1076
translate latin a1s1_fb06a620:

    # a "\"I didn't know your species wasn't part of the {i}Galaxias{/i}. It's...very illegal to make First Contact without authorization from a parent.\""
    a "\"Nesciebam speciem tuam ad {i}Galaxias{/i} non pertinere. Primus Contactus sine Parentis auctoritate... gravissime vetitus est.\""

# game/a1s1.rpy:1077
translate latin a1s1_c3385ac4:

    # m "\"Parent?\""
    m "\"Parentis?\""

# game/a1s1.rpy:1078
translate latin a1s1_bb90bd34:

    # a "\"The authorities of the galaxy.\""
    a "\"Eorum qui galaxiae praesunt.\""

# game/a1s1.rpy:1079
translate latin a1s1_ff1a0c0a:

    # "I frown and Amicus looks at the confusion on my face."
    "Frontem corrugo, et Amicus confusionem in vultu meo aspicit."

# game/a1s1.rpy:1080
translate latin a1s1_e7759761:

    # a "\"How can I put this simply...\""
    a "\"Quomodo hoc simpliciter explicem...\""

# game/a1s1.rpy:1081
translate latin a1s1_a366f2f7:

    # a "\"There are three levels in the {i}Galaxias{/i}. At the very top are the parents. They arrived from beyond our galaxy to spread their culture here.\""
    a "\"Tres gradus sunt in {i}Galaxias{/i}. Summum locum Parentes tenent. Ii ex regionibus ultra galaxiam nostram venerunt, ut cultum suum hic propagarent.\""

# game/a1s1.rpy:1082
translate latin a1s1_4ad4d594:

    # "Amicus glances at me."
    "Amicus me breviter intuetur."

# game/a1s1.rpy:1083
translate latin a1s1_4039690e:

    # a "\"You know what a galaxy is, that there are others outside of our own?\""
    a "\"Scis quid galaxia sit, aliasque praeter nostram esse?\""

# game/a1s1.rpy:1084
translate latin a1s1_c806ebc0:

    # m "\"Yeah.\""
    m "\"Ita.\""

# game/a1s1.rpy:1086
translate latin a1s1_670bed70:

    # "Amicus lets out a breathy chuckle."
    "Amicus risum levem cum suspirio emittit."

# game/a1s1.rpy:1087
translate latin a1s1_55d88b3e:

    # a "\"Of course, I probably should have expected that. So you must know then that intergalactic travel is incredibly advanced, almost god-like and that's what they are—\""
    a "\"Certe; id fortasse exspectare debui. Tum scire debes artem inter galaxias itineris faciendi incredibiliter provectam esse, paene divinam; atque hoc illi sunt—\""

# game/a1s1.rpy:1088
translate latin a1s1_c594d0e2:

    # a "\"—Gods. There are eight of them that are still present in our Galaxy, though they rarely communicate with us these days\""
    a "\"—Di. Octo eorum in galaxia nostra adhuc adsunt, quamquam his temporibus raro nobiscum colloquuntur.\""

# game/a1s1.rpy:1089
translate latin a1s1_8f680690:

    # a "\"Then there are the siblings. That's what my species is a part of. The galaxy was scoped out by the parents at the very start to find the most intelligent and capable species.\""
    a "\"Deinde sunt Fratres. Ad hunc gradum species mea pertinet. Parentes ab ipso initio galaxiam exploraverunt, ut species sollertissimas maximeque idoneas invenirent.\""

# game/a1s1.rpy:1090
translate latin a1s1_61dfd3ff:

    # a "\"They each selected one, and we were the ones chosen and uplifted by the Romanus.\""
    a "\"Singuli unam elegerunt, et nos a Romano electi atque ad altiorem cultum provecti sumus.\""

# game/a1s1.rpy:1091
translate latin a1s1_c619cdb1:

    # "The note of pride in Amicus's voice is obvious."
    "Manifestum est quantum superbiae in voce Amici insit."

# game/a1s1.rpy:1092
translate latin a1s1_635ad1d4:

    # a "\"From then on it has been our mission to increase intelligence in promising species and to teach them our philosophy and culture, to uplift.\""
    a "\"Ex eo tempore munus nostrum est intelligentiam augere in speciebus quae spem praebent, easque philosophiam et cultum nostrum docere: eas ad altiorem cultum provehere.\""

# game/a1s1.rpy:1093
translate latin a1s1_27e1df5d:

    # "I try to make sense of that in terms I can understand."
    "Conor hoc rebus mihi notis comparando intellegere."

# game/a1s1.rpy:1094
translate latin a1s1_f7cd4eb2:

    # m "\"So you spread their culture for the parents? They're like your God and your species are like missionaries?\""
    m "\"Ergo cultum eorum pro Parentibus propagatis? Illi quasi deus vester sunt, et species vestra quasi coetus missionariorum?\""

# game/a1s1.rpy:1095
translate latin a1s1_f887bb98:

    # "Amicus shrugs."
    "Amicus umeros tollit."

# game/a1s1.rpy:1096
translate latin a1s1_ed35e5da:

    # a "\"Yeah, sort of like that.\""
    a "\"Ita, fere sic.\""

# game/a1s1.rpy:1097
translate latin a1s1_5e7f358c:

    # "That doesn't sound so great, especially when I compare it to things that have happened on Earth."
    "Id parum bonum sonat, praesertim cum rebus in Terra gestis comparo."

# game/a1s1.rpy:1098
translate latin a1s1_e1a51d7b:

    # "Mass galactic assimilation..."
    "Assimilatio universae galaxiae..."

# game/a1s1.rpy:1099
translate latin a1s1_f28e91c5:

    # m "\"So...why are they doing this? If they got here at the same time and did the same thing, does that mean they're working together—\""
    m "\"Ergo... cur hoc faciunt? Si eodem tempore huc venerunt idemque fecerunt, significatne eos una operari—\""

# game/a1s1.rpy:1100
translate latin a1s1_3122b23f:

    # "Amicus shakes his head."
    "Amicus caput quatit."

# game/a1s1.rpy:1101
translate latin a1s1_9247501e:

    # a "\"We don't really know all of the reasons for what the parents do, but we compete with the other siblings.\""
    a "\"Non re vera omnes causas eorum quae Parentes faciunt novimus, sed cum ceteris Fratribus certamus.\""

# game/a1s1.rpy:1102
translate latin a1s1_8a3b9f50:

    # a "\"But that brings me to the rest of the Sapients in the galaxy; the children. The siblings uplift these children and bring them into our fold under the direction of our parents.\""
    a "\"Sed hoc me ad ceteros Sapientes galaxiae ducit: Liberos. Fratres hos Liberos ad altiorem cultum provehunt et in communionem nostram recipiunt, Parentibus nostris moderantibus.\""

# game/a1s1.rpy:1103
translate latin a1s1_13387842:

    # a "\"Again, they haven't told us exactly what's going on, but we came to the conclusion that it's some sort of competition, and we mean to win for our parents.\""
    a "\"Iterum dico: quid exacte fiat nobis non explicaverunt, sed rem genus quoddam certaminis esse conclusimus, et pro Parentibus nostris vincere intendimus.\""

# game/a1s1.rpy:1104
translate latin a1s1_9ac126e6:

    # m "\"So, I'm a...child?\""
    m "\"Ergo ego sum... Liber?\""

# game/a1s1.rpy:1106
translate latin a1s1_52720943:

    # a "\"Well...no, not really. I've been calling you that, but you're not part of the {i}Galaxias{/i}, and that's where I've made my mistake.\""
    a "\"Immo... non, non re vera. Ita te appellavi, sed ad {i}Galaxias{/i} non pertines, atque hic erravi.\""

# game/a1s1.rpy:1108
translate latin a1s1_57a4b39c:

    # a "\"Like I said, it was illegal for me to contact you, but I didn't know.\""
    a "\"Ut dixi, mihi te contingere vetitum erat, sed nesciebam.\""

# game/a1s1.rpy:1109
translate latin a1s1_13508b9d:

    # m "\"How did you not know that? Shouldn't you have a...record of this type of stuff?\""
    m "\"Quomodo id nesciebas? Nonne debetis habere... documenta de rebus huiusmodi?\""

# game/a1s1.rpy:1110
translate latin a1s1_39c46f91:

    # a "\"That's the confusing part to me. I found Earth in the Library, so there was a record of it, but there wasn't much. Just a few footnotes about a sapient species there.\""
    a "\"Hoc ipsum me confundit. Terram in Bibliotheca inveni; ergo de ea documenta erant, sed pauca. Tantum aliquot annotationes de specie sapiente ibi habitante.\""

# game/a1s1.rpy:1111
translate latin a1s1_6ff16e36:

    # a "\"But because that record exists, I know that your species was uplifted to child status at some point.\""
    a "\"Sed quia illud documentum exstat, scio speciem tuam aliquando ad Liberorum gradum provectam esse.\""

# game/a1s1.rpy:1112
translate latin a1s1_75c6be41:

    # m "\"In Rome?\""
    m "\"Romae?\""

# game/a1s1.rpy:1113
translate latin a1s1_7072f7b6:

    # a "\"Presumably, but sometimes the species is unable to be uplifted for different reasons; too aggressive, too docile, too unintelligent.\""
    a "\"Ut videtur; interdum tamen species variis de causis ad altiorem cultum provehi non potest: nimis ferox est, nimis obsequens, nimis parum intellegens.\""

# game/a1s1.rpy:1114
translate latin a1s1_4ad4d594_1:

    # "Amicus glances at me."
    "Amicus me breviter intuetur."

# game/a1s1.rpy:1115
translate latin a1s1_c5c3332b:

    # a "\"I thought this is what happened to your species.\""
    a "\"Hoc speciei tuae accidisse putabam.\""

# game/a1s1.rpy:1116
translate latin a1s1_0be68fb6:

    # m "\"Then if we've been uplifted doesn't that mean that you've already made First Contact?\""
    m "\"Tum, si iam ad altiorem cultum provecti sumus, nonne significat vos Primum Contactum iam fecisse?\""

# game/a1s1.rpy:1117
translate latin a1s1_9a0ba985:

    # a "\"Yes, but you're still not part of the Galaxias. That's why I made the mistake. You {i}should{/i} know about it, but you don't. Knowledge of other intelligent life is sacred and for whatever reason your species lost it.\""
    a "\"Ita, sed ad Galaxias adhuc non pertines. Ideo erravi. Tu de ea {i}scire deberes{/i}, sed nescis. Notitia alterius vitae intellegentis sacra est, atque species tua eam, nescio qua de causa, amisit.\""

# game/a1s1.rpy:1118
translate latin a1s1_222f62dc:

    # a "\"So it doesn't matter that we've made contact before; if the knowledge of the {i}Galaxias{/i} has been lost, then any form of communication between us is First Contact all over again.\""
    a "\"Itaque nihil interest nos antea contactum habuisse: si notitia {i}Galaxias{/i} amissa est, quaevis inter nos communicatio rursus Primus Contactus est.\""

# game/a1s1.rpy:1119
translate latin a1s1_392197d0:

    # a "\"And while uplift has been canceled with species in the past, we don't completely cut off contact; they're permanently part of the {i}Galaxias{/i}. I've never heard of something like this happening before, so I panicked. Com—\""
    a "\"Quamquam antea nonnullarum specierum ad altiorem cultum evectio intermissa est, contactum non omnino abscindimus: ad {i}Galaxias{/i} perpetuo pertinent. Numquam audivi rem talem accidisse, itaque pavore correptus sum. Com—\""

# game/a1s1.rpy:1120
translate latin a1s1_fb1be156:

    # "Amicus glances at the ceiling."
    "Amicus cameram aspicit."

# game/a1s1.rpy:1121
translate latin a1s1_82350eb8:

    # a "\"—wasn't able to tell me that until he connected to your Nexus.\""
    a "\"—hoc mihi dicere non potuit, donec cum Nexu vestro coniunctus est.\""

# game/a1s1.rpy:1122
translate latin a1s1_6d4e410e:

    # m "\"Nexus?\""
    m "\"Nexus?\""

# game/a1s1.rpy:1123
translate latin a1s1_e6d6088e:

    # "Another word that doesn't translate."
    "Aliud verbum quod non vertitur."

# game/a1s1.rpy:1124
translate latin a1s1_48340125:

    # a "\"Like, the technology that connects places, people, information—\""
    a "\"Velut ars technica qua loca, homines, notitia coniunguntur—\""

# game/a1s1.rpy:1125
translate latin a1s1_626d9018:

    # m "\"The internet?\""
    m "\"Interrete?\""

# game/a1s1.rpy:1126
translate latin a1s1_7d75dc6c:

    # a "\"If that's your word for it.\""
    a "\"Si ita id appellatis.\""

# game/a1s1.rpy:1127
translate latin a1s1_fd7e81eb:

    # m "\"So...\""
    m "\"Ergo...\""

# game/a1s1.rpy:1128
translate latin a1s1_98b63e80:

    # "I try to understand everything I'm being told."
    "Omnia quae mihi dicuntur intellegere conor."

# game/a1s1.rpy:1129
translate latin a1s1_38d8cc39:

    # m "\"Why didn't you just tell me all of this before you kidnapped me...or knocked me out.\""
    m "\"Cur haec omnia mihi non dixisti, antequam me rapuisti... vel exanimasti.\""

# game/a1s1.rpy:1130
translate latin a1s1_1d3dd843:

    # "I see Amicus's ears flatten and he looks away, clearly ashamed."
    "Aures Amici demitti video; oculos avertit, plane pudore affectus."

# game/a1s1.rpy:1131
translate latin a1s1_846465a3:

    # a "\"I don't know. I didn't fully understand the intelligence of your species yet. I thought I could just...lead you to believe things.\""
    a "\"Nescio. Intelligentiam speciei tuae nondum plene intellexeram. Putabam me simpliciter... te ad certa credenda ducere posse.\""

# game/a1s1.rpy:1132
translate latin a1s1_0180610d:

    # "I don't say anything and Amicus shifts uncomfortably."
    "Nihil dico, et Amicus anxius se movet."

# game/a1s1.rpy:1133
translate latin a1s1_6b053d84:

    # a "\"Leaving you on Earth after you saw me...you might have gone to the authorities on your planet with that knowledge which might have lead to a Monitor being alerted.\""
    a "\"Si te in Terra reliquissem postquam me vidisti... cum hac notitia fortasse ad magistratus planetae tui iisses, quo Monitor aliquis certior fieri potuisset.\""

# game/a1s1.rpy:1134
translate latin a1s1_e27fdc8d:

    # "Amicus answers my question before I can ask it."
    "Amicus quaestioni meae respondet antequam eam proponere possum."

# game/a1s1.rpy:1135
translate latin a1s1_daea3945:

    # a "\"Monitors are basically the ears and eyes of the parents. They monitor the galaxy.\""
    a "\"Monitores sunt fere aures et oculi Parentum. Galaxiam observant.\""

# game/a1s1.rpy:1136
translate latin a1s1_dfb54641:

    # m "\"And what happens if they're alerted?\""
    m "\"Et quid accidit, si certiores fiunt?\""

# game/a1s1.rpy:1137
translate latin a1s1_6d85daed:

    # "Amicus sighs deeply."
    "Amicus alte suspirat."

# game/a1s1.rpy:1138
translate latin a1s1_02271e86:

    # a "\"I don't know. It hasn't happened in a long time and I don't think anyone has ever broken this particular law. It's one of the most important laws we're supposed to follow. Knowing I'd broken it...\""
    a "\"Nescio. Iam diu id non accidit, nec quemquam umquam hanc ipsam legem violavisse puto. Inter maximas leges est quas servare debemus. Cum me eam violavisse scirem...\""

# game/a1s1.rpy:1139
translate latin a1s1_54bca475_1:

    # "Amicus pauses."
    "Amicus paulisper tacet."

# game/a1s1.rpy:1140
translate latin a1s1_f8f87ce5:

    # m "\"Scared you?\""
    m "\"Te terruit?\""

# game/a1s1.rpy:1141
translate latin a1s1_8f726726:

    # "Amicus shakes his head but doesn't say anything."
    "Amicus caput quatit, sed nihil dicit."

# game/a1s1.rpy:1142
translate latin a1s1_fedb4933:

    # "I try to piece all of this together in my head."
    "Haec omnia in animo meo inter se coniungere conor."

# game/a1s1.rpy:1143
translate latin a1s1_dec48a5e:

    # m "\"So then you panicked and kidnapped me?\""
    m "\"Ergo tum pavore correptus me rapuisti?\""

# game/a1s1.rpy:1144
translate latin a1s1_ca821773:

    # a "\"It was either that or kill you...or leave you and hope for the best, but that was a risk that I felt I couldn't take at the time.\""
    a "\"Aut id faciendum erat, aut tu occidendus... aut relinquendus, sperandumque omnia bene eventura esse; sed id periculum tunc subire me non posse sentiebam.\""

# game/a1s1.rpy:1145
translate latin a1s1_1c4605d3:

    # "Amicus seems to shrink in his seat."
    "Amicus in sede sua minor fieri videtur."

# game/a1s1.rpy:1146
translate latin a1s1_d53ef6e5:

    # a "\"And I guess I just didn't want to tell you because I knew I'd disrupted your life in a terrible way...I thought I might be able to make you forget and want to stay with me if you saw my home.\""
    a "\"Atque credo me tibi dicere noluisse, quia sciebam me vitam tuam atrociter perturbavisse... putabam me efficere posse ut obliviscereris et mecum manere velles, si domum meam vidisses.\""

# game/a1s1.rpy:1147
translate latin a1s1_a5b92aaa:

    # m "\"But why? Why did you do it in the first place? What do you want from me?\""
    m "\"Sed cur? Cur id omnino fecisti? Quid a me vis?\""

# game/a1s1.rpy:1148
translate latin a1s1_a5ebcc0b:

    # "Amicus looks at me for a long while, probably debating on how much to tell me, then he turns away."
    "Amicus diu me aspicit, fortasse deliberans quantum mihi dicat; deinde se avertit."

# game/a1s1.rpy:1149
translate latin a1s1_ca8be25f:

    # a "\"I needed a pet.\""
    a "\"Animali domestico mihi opus erat.\""

# game/a1s1.rpy:1150
translate latin a1s1_61d5f247:

    # m "\"Excuse me?\""
    m "\"Quid ais?\""

# game/a1s1.rpy:1151
translate latin a1s1_e9a7f917:

    # "Amicus shrinks up even more in his chair."
    "Amicus magis etiam in sede se contrahit."

# game/a1s1.rpy:1152
translate latin a1s1_d6e9d058:

    # a "\"It's a very long story.\""
    a "\"Res longissima est narratu.\""

# game/a1s1.rpy:1153
translate latin a1s1_57c93327:

    # "I glare at the back of his head."
    "Occiput eius torve intueor."

# game/a1s1.rpy:1154
translate latin a1s1_1fba1f80:

    # m "\"Well, if we're going to be here a while then I have time.\""
    m "\"Bene, si hic aliquamdiu manebimus, mihi tempus est.\""

# game/a1s1.rpy:1155
translate latin a1s1_59e1c99b:

    # "Amicus goes on staring out the window."
    "Amicus per fenestram spectare pergit."

# game/a1s1.rpy:1156
translate latin a1s1_301e94d3:

    # a "\"My father was the emperor. The throne was mine to take, but my brother has challenged me, so now we're both competing for it.\""
    a "\"Pater meus imperator erat. Thronus mihi paratus erat, sed frater meus ius meum provocavit; itaque nunc ambo de eo certamus.\""

# game/a1s1.rpy:1157
translate latin a1s1_5295c07b:

    # "Amicus looks at me out of the corner of his eye for my reaction."
    "Amicus ex obliquo me aspicit, ut videat quomodo id accipiam."

# game/a1s1.rpy:1158
translate latin a1s1_a5e86746:

    # "His expression tells me I should be impressed, but learning he might be an influential figure among his people doesn't really seem too crazy after the events of the past day or so."
    "Vultus eius ostendit me admirari debere; sed eum inter suos magni momenti esse posse cognoscere parum mirum videtur post ea quae ultimo die aut circiter acciderunt."

# game/a1s1.rpy:1159
translate latin a1s1_b7fd9907:

    # m "\"And getting a 'pet' will help you how?\""
    m "\"Et quomodo te 'animal domesticum' iuvabit?\""

# game/a1s1.rpy:1160
translate latin a1s1_b902c878:

    # a "\"My brother has one...a sibling species, which means that his pet is on the same level of the hierarchy as us.\""
    a "\"Frater meus iam unum habet... e specie Fratrum, quod significat animal eius eundem gradum ordinis ac nos tenere.\""

# game/a1s1.rpy:1161
translate latin a1s1_e499761a:

    # "I frown."
    "Frontem contraho."

# game/a1s1.rpy:1162
translate latin a1s1_5e66bbc7:

    # m "\"Oh? And that's unusual?\""
    m "\"O? Et id insolens est?\""

# game/a1s1.rpy:1163
translate latin a1s1_c02d8683:

    # a "\"Definitely. It shouldn't even be legal, but somehow he {i}negotiated{/i} it. They signed a contract and everything.\""
    a "\"Omnino. Ne licitum quidem esse debet, sed nescio quomodo id {i}pactus est{/i}. Pactionem subscripserunt et cetera omnia.\""

# game/a1s1.rpy:1164
translate latin a1s1_6a20a80d:

    # "I shake my head."
    "Caput quatio."

# game/a1s1.rpy:1165
translate latin a1s1_f5cfbdcd:

    # m "\"So what does having a pet do?\""
    m "\"Ergo quid confert animal domesticum habere?\""

# game/a1s1.rpy:1166
translate latin a1s1_f887bb98_1:

    # "Amicus shrugs."
    "Amicus umeros tollit."

# game/a1s1.rpy:1167
translate latin a1s1_df4a18ee:

    # a "\"It's a good status symbol to have. The fact that my brother was able to obtain such a prestigious pet shows his skill at negotiation and has put me at a huge disadvantage.\""
    a "\"Bonum dignitatis indicium est. Quod frater meus tam nobile animal obtinere potuit, artem eius paciscendi ostendit atque me in multo peiore condicione posuit.\""

# game/a1s1.rpy:1168
translate latin a1s1_24a774ec:

    # a "\"I needed to do something even more grand to impress my father's advisor. He's the one that will choose between us.\""
    a "\"Aliquid etiam magnificentius facere debebam, ut consiliarium patris mei admiratione afficerem. Ille ex nobis alterum eliget.\""

# game/a1s1.rpy:1169
translate latin a1s1_669cc616:

    # m "\"By kidnapping me?\""
    m "\"Me rapiendo?\""

# game/a1s1.rpy:1170
translate latin a1s1_2df92d67:

    # "Amicus growls."
    "Amicus fremit."

# game/a1s1.rpy:1171
translate latin a1s1_a77916e8:

    # a "\"That wasn't part of the plan. I thought you'd know what I was and be amazed that a Wolf had come back to your species.\""
    a "\"Id in consilio non erat. Putabam te sciturum quid essem et miraturum Lupum ad speciem tuam rediisse.\""

# game/a1s1.rpy:1172
translate latin a1s1_dd423124:

    # a "\"I was going to make a deal with you, like my brother did with his pet. I wanted a sapient that no one had seen in a long time.\""
    a "\"Tecum pacisci volebam, sicut frater meus cum suo animali pactus est. Sapientem volebam quem iam diu nemo vidisset.\""

# game/a1s1.rpy:1177
translate latin a1s1_f0acabc1:

    # "So that's why I'm here; to be used as some pawn in some power struggle in some alien empire far away?"
    "Ideone hic sum, ut velut calculus adhibear in certamine potestatis imperii alieni longe remoti?"

# game/a1s1.rpy:1178
translate latin a1s1_f5aa93b2:

    # m "\"So why can't you take me back? What if I promise not to say anything?\""
    m "\"Cur ergo me reducere non potes? Quid si promitto me nihil dicturum?\""

# game/a1s1.rpy:1179
translate latin a1s1_875dd49e:

    # a "\"I...would take you back if I could. I realize now that that would have been the better option, but I can't.\""
    a "\"Ego... te reducerem, si possem. Iam intellego id melius fuisse, sed non possum.\""

# game/a1s1.rpy:1180
translate latin a1s1_2558be92_1:

    # m "\"Why not?\""
    m "\"Cur non?\""

# game/a1s1.rpy:1182
translate latin a1s1_0fca803d:

    # a "\"First of all, the ship might be damaged beyond repair. Secondly, there isn't enough power to get back. Earth was on the outer reaches of how far I could travel. I need the rest to return home.\""
    a "\"Primum navis fortasse adeo laesa est ut reparari nequeat. Deinde non satis energiae est ad redeundum. Terra prope extremum spatium erat quod percurrere poteram. Reliqua mihi opus est ut domum redeam.\""

# game/a1s1.rpy:1183
translate latin a1s1_16c59561:

    # "I manage to stop myself from telling the wolf that all of this is his fault and shouldn't be my problem at all."
    "Me contineo ne lupo dicam haec omnia ipsius culpa accidisse neque omnino mihi esse curanda."

# game/a1s1.rpy:1184
translate latin a1s1_7690c5ed:

    # m "\"Well, can we get more power when we get to your home, then go back to Earth?\""
    m "\"Bene, possumusne plus energiae accipere cum ad domum tuam venerimus, tum ad Terram redire?\""

# game/a1s1.rpy:1185
translate latin a1s1_d90afce6:

    # a "\"No, it's...it's a type of power that the parents produce. We're not able to harness it...yet.\""
    a "\"Non; ea est... genus quoddam energiae quod Parentes efficiunt. Nos ea uti non possumus... adhuc.\""

# game/a1s1.rpy:1186
translate latin a1s1_8a740824:

    # m "\"So get more from them, from wherever you got the power in the first place.\""
    m "\"Tum plus ab eis accipe, unde energiam primum accepisti.\""

# game/a1s1.rpy:1188
translate latin a1s1_07745109:

    # "Amicus leans his head against the headrest."
    "Amicus caput ad fulcrum capitis reclinat."

# game/a1s1.rpy:1189
translate latin a1s1_c88d4de4:

    # a "\"Our parents authorizes and distributes it, and for whatever reason, they stopped supplying it when we lost our emperor.\""
    a "\"Parentes nostri usum eius probant eamque distribuunt; nescio qua de causa, cum imperatorem nostrum amisimus, eam suppeditare desierunt.\""

# game/a1s1.rpy:1190
translate latin a1s1_73e42e69:

    # "I feel myself growing more and more frustrated."
    "Me magis magisque frustratum sentio."

# game/a1s1.rpy:1191
translate latin a1s1_1f0624bf:

    # m "\"Then how the hell are you using it now?\""
    m "\"Tum quomodo malum ea nunc uteris?\""

# game/a1s1.rpy:1192
translate latin a1s1_f5f4dc21:

    # "A moment of silence goes by."
    "Paulisper silentium est."

# game/a1s1.rpy:1193
translate latin a1s1_19effa26:

    # a "\"This was my father's ship. Only the emperor has constant access to the technology. I...borrowed it to get to you.\""
    a "\"Haec navis patris mei erat. Solus imperator hac arte technica semper uti potest. Ego... eam mutuatus sum ut ad te pervenirem.\""

# game/a1s1.rpy:1194
translate latin a1s1_af78b41c_1:

    # "I glare at him."
    "Eum torve aspicio."

# game/a1s1.rpy:1195
translate latin a1s1_75bbb209:

    # m "\"You mean stole it? You know, you're pretty dishonest for someone who says they never lie.\""
    m "\"Furatus es, dicis? Scisne te satis fraudulentum esse, cum te numquam mentiri dicas.\""

# game/a1s1.rpy:1197
translate latin a1s1_c592f25a:

    # "Another soft, rumbling growl from him."
    "Iterum levem fremitum profundum emittit."

# game/a1s1.rpy:1198
translate latin a1s1_0ef784a3:

    # a "\"Times are desperate.\""
    a "\"Tempora desperata sunt.\""

# game/a1s1.rpy:1199
translate latin a1s1_ae3bea37:

    # m "\"Ask your dad to take me back, then.\""
    m "\"Tum patrem tuum roga ut me reducat.\""

# game/a1s1.rpy:1200
translate latin a1s1_c537b6ab:

    # a "\"If you didn't gather from earlier, he's dead. So no one has access to it right now...I'm just using up what was left.\""
    a "\"Si ex prioribus non intellexisti, mortuus est. Itaque nemo ea nunc uti potest... ego tantum reliquias absumo.\""

# game/a1s1.rpy:1201
translate latin a1s1_81a185a8:

    # "I stare at Amicus for a while, words failing me."
    "Amicum aliquamdiu intueor, verbis deficientibus."

# game/a1s1.rpy:1202
translate latin a1s1_7e4cc33e:

    # a "\"Listen, I didn't want to do all those things I did to you. I'm protecting us both.\""
    a "\"Audi: nolui omnia illa facere quae tibi feci. Nos ambos protego.\""

# game/a1s1.rpy:1203
translate latin a1s1_e33f02ef:

    # "I laugh."
    "Rideo."

# game/a1s1.rpy:1204
translate latin a1s1_de93a4a7:

    # m "\"Oh, really?\""
    m "\"Re vera?\""

# game/a1s1.rpy:1205
translate latin a1s1_4495ce05:

    # a "\"Yes! I was planning to bring you to the palace to live a good life and forget your old one...then when you started asking those questions I realized your intelligence is much higher than I thought it would be. Then Com thought you might attack me...I made mistakes.\""
    a "\"Ita! Te ad palatium ducere in animo habebam, ut bene viveres vitamque priorem obliviscereris... tum, cum quaestiones illas proponere coepisti, intellexi te multo intellegentiorem esse quam putaveram. Deinde Com putavit te fortasse me oppugnaturum... errores commisi.\""

# game/a1s1.rpy:1207
translate latin a1s1_d1a4dc23:

    # "Amicus lets out another huge sigh and slumps in the seat, looking away."
    "Amicus aliud ingens suspirium emittit et in sede collapsus oculos avertit."

# game/a1s1.rpy:1208
translate latin a1s1_4222a394:

    # "Several minutes go by in silence, both of us staring out into the eerie blue."
    "Aliquot minuta taciti consumimus, ambo in mirum caeruleum fulgorem prospicientes."

# game/a1s1.rpy:1209
translate latin a1s1_6795a6f1:

    # m "\"So what now? What are your plans?\""
    m "\"Quid ergo nunc? Quid facere in animo habes?\""

# game/a1s1.rpy:1210
translate latin a1s1_979ad8ae:

    # "Amicus is the one to laugh this time."
    "Hoc tempore Amicus ridet."

# game/a1s1.rpy:1212
translate latin a1s1_ea8f4e03:

    # a "\"Get out of these bonds, if you'd let me.\""
    a "\"Ex his vinculis expediri, si sinas.\""

# game/a1s1.rpy:1213
translate latin a1s1_1e0866bf:

    # "I look at him incredulously."
    "Incredulus eum aspicio."

# game/a1s1.rpy:1215
translate latin a1s1_f334dfb6:

    # "Amicus sighs."
    "Amicus suspirat."

# game/a1s1.rpy:1216
translate latin a1s1_97bb4540:

    # a "\"Listen, you have no idea how to handle this ship. I can at least run diagnostics to see what we can do about this.\""
    a "\"Audi: hanc navem tractare omnino nescis. Ego saltem examen diagnosticum facere possum, ut videam quid de hac re facere liceat.\""

# game/a1s1.rpy:1217
translate latin a1s1_f5fc74a4:

    # m "\"What's to stop you from knocking me out again?\""
    m "\"Quid te prohibebit me iterum exanimare?\""

# game/a1s1.rpy:1218
translate latin a1s1_89843a26:

    # a "\"If you don't attack me or hit me with the Nervo again, then I won't have to.\""
    a "\"Si me non oppugnaveris neque iterum Nervo percusseris, id facere non cogar.\""

# game/a1s1.rpy:1219
translate latin a1s1_1a929e36:

    # "I look to my left armrest and pick up the little taser device."
    "Sinistrum bracchii fulcrum aspicio et parvum percussorem electricum tollo."

# game/a1s1.rpy:1220
translate latin a1s1_45972660:

    # m "\"This?\""
    m "\"Hoc?\""

# game/a1s1.rpy:1222
translate latin a1s1_9ad83078:

    # "Amicus eyes it uneasily."
    "Amicus id sollicitus aspicit."

# game/a1s1.rpy:1223
translate latin a1s1_a61ebafe:

    # a "\"Yeah...\""
    a "\"Ita...\""

# game/a1s1.rpy:1224
translate latin a1s1_9943ddc6:

    # m "\"How can I trust you after everything that's happened?\""
    m "\"Quomodo tibi credere possum post omnia quae acciderunt?\""

# game/a1s1.rpy:1225
translate latin a1s1_4f2092c2:

    # a "\"I give you my word.\""
    a "\"Fidem tibi do.\""

# game/a1s1.rpy:1226
translate latin a1s1_e499761a_1:

    # "I frown."
    "Frontem contraho."

# game/a1s1.rpy:1227
translate latin a1s1_d2b6b47a:

    # m "\"And you could go back on it just as easily.\""
    m "\"Quam aeque facile fallere posses.\""

# game/a1s1.rpy:1229
translate latin a1s1_93d01137:

    # a "\"I would never do that! I don't make promises lightly, [mc].\""
    a "\"Numquam id facerem! Non temere promitto, [mc].\""

# game/a1s1.rpy:1230
translate latin a1s1_215d03c2:

    # "Amicus is so indignant that I actually believe him."
    "Amicus tam indignatur ut ei re vera credam."

# game/a1s1.rpy:1231
translate latin a1s1_29333bbf:

    # "Or he's just a really good actor."
    "Aut histrio egregius est."

# game/a1s1.rpy:1232
translate latin a1s1_2a6088ff:

    # "Either way, I'm going to have to let him go at some point, especially if we really can't get back to Earth."
    "Utut est, aliquando eum solvere debebo, praesertim si re vera ad Terram redire non possumus."

# game/a1s1.rpy:1233
translate latin a1s1_a4e12baa:

    # "So I make my decision."
    "Itaque decerno."

# game/a1s1.rpy:1234
translate latin a1s1_a008448f:

    # m "\"If I let you go, you have to find a way to get me back to Earth.\""
    m "\"Si te solvero, viam invenire debes qua me ad Terram reducas.\""

# game/a1s1.rpy:1236
translate latin a1s1_fb81144d:

    # "Amicus thinks for a moment."
    "Amicus paulisper cogitat."

# game/a1s1.rpy:1237
translate latin a1s1_2c36f1a9:

    # a "\"I can do that if I become emperor.\""
    a "\"Id facere possum, si imperator factus ero.\""

# game/a1s1.rpy:1238
translate latin a1s1_0d4dae44:

    # m "\"And how long will that take?\""
    m "\"Et quantum temporis id requiret?\""

# game/a1s1.rpy:1239
translate latin a1s1_f887bb98_2:

    # "Amicus shrugs."
    "Amicus umeros tollit."

# game/a1s1.rpy:1240
translate latin a1s1_51161834:

    # a "\"A few months if all goes well. With your help it could be even faster. You're...very clever. More intelligent than some wolves I know, even.\""
    a "\"Paucos menses, si omnia bene evenerint. Te adiuvante etiam citius fieri potest. Tu... valde sollers es. Immo nonnullis lupis quos novi intellegentior.\""

# game/a1s1.rpy:1241
translate latin a1s1_be8a4a84:

    # m "\"Months? My parents are probably freaking out by now...school starts in a few weeks!\""
    m "\"Menses? Parentes mei iam probabiliter metu insaniunt... studia post paucas hebdomades incipiunt!\""

# game/a1s1.rpy:1242
translate latin a1s1_bc78ac5f:

    # "All of these things seem so distant now."
    "Haec omnia iam tam remota videntur."

# game/a1s1.rpy:1243
translate latin a1s1_e0a11c00:

    # "Amicus frowns."
    "Amicus frontem corrugat."

# game/a1s1.rpy:1244
translate latin a1s1_afb8ae99:

    # a "\"I'm sorry, but I can't do anything. I need to be an emperor to even talk to the parents.\""
    a "\"Paenitet me, sed nihil facere possum. Imperator esse debeo ut vel cum Parentibus loquar.\""

# game/a1s1.rpy:1245
translate latin a1s1_4b66f979:

    # "I think, but again I don't have many options."
    "Cogito, sed rursus non multae viae mihi patent."

# game/a1s1.rpy:1246
translate latin a1s1_45748d7b:

    # "I look Amicus in the eye."
    "In oculos Amici aspicio."

# game/a1s1.rpy:1247
translate latin a1s1_1ff0bd1f:

    # m "\"You promise?\""
    m "\"Promittis?\""

# game/a1s1.rpy:1249
translate latin a1s1_13415661:

    # a "\"You have my word.\""
    a "\"Fidem meam habes.\""

# game/a1s1.rpy:1250
translate latin a1s1_304d84c2:

    # "For a moment I sit there, contemplating."
    "Paulisper ibi sedeo, rem animo versans."

# game/a1s1.rpy:1251
translate latin a1s1_b4225f49:

    # "Then I sit up straight."
    "Tum rectus in sede me erigo."

# game/a1s1.rpy:1252
translate latin a1s1_67ff07f9:

    # m "\"Alright, stand up.\""
    m "\"Bene, surge.\""

# game/a1s1.rpy:1254
translate latin a1s1_47563fc0:

    # "Amicus perks up then hops to his bound feet, almost falling over."
    "Amicus alacrior fit et in pedes vinctos subsilit, paene cadens."

# game/a1s1.rpy:1256
translate latin a1s1_a4ac641e:

    # "I'm sure to place the Nervo close by behind me, just in case."
    "Nervo prope post me pono, quo paratus sit si opus fuerit."

# game/a1s1.rpy:1257
translate latin a1s1_313097f8:

    # "A few minutes later and the wolf is free."
    "Paucis minutis post lupus liber est."

# game/a1s1.rpy:1259
translate latin a1s1_3a039d30:

    # "We both regard each other wearily for a few moments before Amicus finally sighs."
    "Ambo paulisper fessi alter alterum intuemur, donec Amicus tandem suspirat."

# game/a1s1.rpy:1260
translate latin a1s1_c2ca825f:

    # a "\"Listen, I have no reason to...incapacitate you now that you know everything, but if it makes you feel better you can hang on to the Nervo until we get to Adastra.\""
    a "\"Audi: iam nullam causam habeo te... impotentem reddendi, cum omnia scias; sed, si ita securior eris, Nervo retinere potes donec ad Adastram perveniamus.\""

# game/a1s1.rpy:1261
translate latin a1s1_0b848ce8:

    # a "\"That a fair exchange?\""
    a "\"Estne id aequa condicio?\""

# game/a1s1.rpy:1262
translate latin a1s1_37a44bcc:

    # "I look back at the little device."
    "Retro parvum illud instrumentum aspicio."

# game/a1s1.rpy:1263
translate latin a1s1_28e9eca7:

    # "While I have little reason to trust Amicus, the wolf has virtually no reason to trust me."
    "Quamquam parvam causam habeo Amico credendi, lupus paene nullam habet mihi credendi."

# game/a1s1.rpy:1264
translate latin a1s1_e98ea258:

    # "I consider it, then shake my head."
    "Id considero, deinde caput quatio."

# game/a1s1.rpy:1265
translate latin a1s1_ac33b6fb:

    # m "\"Can we put it away somewhere? I'd rather just not be thinking about it.\""
    m "\"Possumusne id alicubi reponere? Malo de eo omnino non cogitare.\""

# game/a1s1.rpy:1267
translate latin a1s1_ef689f1d:

    # "Amicus looks at me in surprise, then rubs his stomach where I jabbed him."
    "Amicus miratus me aspicit, deinde ventrem fricat ubi eum percussi."

# game/a1s1.rpy:1268
translate latin a1s1_d5f0f775:

    # a "\"Okay, yeah, that sounds like a deal to me.\""
    a "\"Bene, ita, mihi id placet.\""

# game/a1s1.rpy:1270
translate latin a1s1_35dd5f05:

    # "Amicus holds out a paw and I look down at the thick, black pads on his fingers and palm before picking up the Nervo and handing it to him carefully."
    "Amicus manum porrigit; crassa nigraque pulvinula in digitis et palma aspicio, deinde Nervo tollo et ei caute trado."

# game/a1s1.rpy:1271
translate latin a1s1_ad1f344e:

    # "For a moment I imagine him immediately turning the thing around and jabbing it into my face, but instead he turns and walks toward the back of the ship."
    "Paulisper fingo eum statim instrumentum conversurum atque in faciem meam impacturum; sed ille se vertit et ad posteriorem navis partem ambulat."

# game/a1s1.rpy:1273
translate latin a1s1_79ff2228:

    # "I notice his stance is slightly bow-legged and he adjusts himself a few times."
    "Animadverto eum cruribus aliquantum divaricatis stare et se aliquotiens componere."

# game/a1s1.rpy:1274
translate latin a1s1_6f4c20bc:

    # "That makes me feel a little guilty about fighting dirty earlier."
    "Id facit ut aliquantum reum me sentiam quod antea dolose pugnaverim."

# game/a1s1.rpy:1275
translate latin a1s1_e73c6f47:

    # "But only a little."
    "Sed tantum aliquantum."

# game/a1s1.rpy:1276
translate latin a1s1_1af4d09d:

    # "On his way he sweeps up his cape in one fluid motion before wrapping it around his shoulders."
    "Dum ambulat, pallium uno motu fluido tollit atque umeris circumdat."

# game/a1s1.rpy:1277
translate latin a1s1_a1095ca6:

    # "Then he moves to the back wall and, sticking out a paw, he presses a panel and a small portion of the wall slides back, revealing another smaller room."
    "Tum ad parietem posteriorem accedit et, manu porrecta, tabulam premit; exigua parietis pars retro labitur atque aliud cubiculum minus aperit."

# game/a1s1.rpy:1278
translate latin a1s1_fcb0a8e0:

    # "From where I am I can see what looks like a little cot and various cupboards."
    "Unde sum, parvum quasi lectulum et varia armaria videre possum."

# game/a1s1.rpy:1279
translate latin a1s1_a1e911d8:

    # "He opens one of these and places the Nervo inside before shutting it."
    "Unum eorum aperit et Nervo intus ponit, deinde claudit."

# game/a1s1.rpy:1280
translate latin a1s1_65cf3021:

    # "He comes back out and notices me staring."
    "Rursus exit atque me spectantem animadvertit."

# game/a1s1.rpy:1282
translate latin a1s1_2e46bd5c:

    # a "\"That's my quarters. It's where I sleep. If you, uh, need to urinate or...whatever else you do, there's a toilet in there.\""
    a "\"Hoc cubiculum meum est. Ibi dormio. Si tibi, eh, mingere opus est aut... quidquid aliud facitis, latrina ibi est.\""

# game/a1s1.rpy:1283
translate latin a1s1_03425764:

    # m "\"I'm fine for now...\""
    m "\"Nunc bene me habeo...\""

# game/a1s1.rpy:1284
translate latin a1s1_11010a2b:

    # "I feel my stomach gurgle, something that it's been doing for a while now."
    "Ventrem meum murmurare sentio, quod iam aliquamdiu facit."

# game/a1s1.rpy:1285
translate latin a1s1_36782e7c:

    # m "\"I am a little hungry, though.\""
    m "\"Aliquantum tamen esurio.\""

# game/a1s1.rpy:1286
translate latin a1s1_8e4c05e6:

    # "Amicus raises a brow."
    "Amicus alterum supercilium tollit."

# game/a1s1.rpy:1287
translate latin a1s1_74984fcc:

    # a "\"You want to try it again?\""
    a "\"Visne iterum gustare?\""

# game/a1s1.rpy:1288
translate latin a1s1_7b7bde3d:

    # m "\"...Sure.\""
    m "\"...Certe.\""

# game/a1s1.rpy:1292
translate latin a1s1_f38a0a8d:

    # "It's not the worst food I've ever had."
    "Non est pessimus cibus quem umquam gustavi."

# game/a1s1.rpy:1293
translate latin a1s1_e5c20a63:

    # "The earthy smell translates into the taste, but there's a strange hint of sweetness to it, like chocolate and that makes it a little more palatable."
    "Odor terreus etiam in sapore sentitur, sed mira quaedam dulcedo inest, quasi socolatae, qua paulo suavior fit."

# game/a1s1.rpy:1294
translate latin a1s1_c2da015e:

    # "I can at least swallow it down without gagging, so that's good, I guess."
    "Saltem sine vomendi conatu deglutire possum; id bonum esse credo."

# game/a1s1.rpy:1295
translate latin a1s1_88cf08df:

    # "Amicus has his own cup, though he's paying more attention to the panels than to his food."
    "Amicus suum quoque poculum habet, sed tabulas gubernandi magis quam cibum curat."

# game/a1s1.rpy:1297
translate latin a1s1_786145ac:

    # a "\"I may have been exaggerating a bit earlier. Damage appears to be minimal. We're actually lucky that you didn't lock onto something worse like a pit. There was one very near that star.\""
    a "\"Fortasse antea aliquantum exaggeravi. Damnum exiguum esse videtur. Re vera fortuna nobis favit quod nihil peius, velut voraginem, destinavisti. Una prope illam stellam erat.\""

# game/a1s1.rpy:1298
translate latin a1s1_30a93cb2:

    # m "\"A pit?\""
    m "\"Voraginem?\""

# game/a1s1.rpy:1299
translate latin a1s1_b0283289:

    # "Amicus shrugs, waving his hand in the air, as if brushing my question aside."
    "Amicus umeros tollit et manum in aere movet, quasi quaestionem meam repellat."

# game/a1s1.rpy:1300
translate latin a1s1_563cf217:

    # a "\"A very strong gravitational singularity that sucks everything up around it—\""
    a "\"Singularitatem gravitatis potentissimam, quae omnia circa se exsugit—\""

# game/a1s1.rpy:1301
translate latin a1s1_f6d33be0:

    # m "\"Like a black hole?\""
    m "\"Velut foramen nigrum?\""

# game/a1s1.rpy:1302
translate latin a1s1_95dd1f3d:

    # a "\"Black hole?\""
    a "\"Foramen nigrum?\""

# game/a1s1.rpy:1303
translate latin a1s1_4e776e18:

    # m "\"Like, its gravity is so powerful that even light gets pulled into it. That's why they're black.\""
    m "\"Scilicet gravitas eius tam valida est ut ipsa lux in illud trahatur. Ideo nigra sunt.\""

# game/a1s1.rpy:1304
translate latin a1s1_bbcecb2f:

    # "Amicus looks at me in susprise."
    "Amicus miratus me aspicit."

# game/a1s1.rpy:1306
translate latin a1s1_4c83ddc4:

    # a "\"Oh, you know what that is? Guess I should stop being surprised, honestly.\""
    a "\"O, scis quid id sit? Re vera credo me desinere mirari debere.\""

# game/a1s1.rpy:1308
translate latin a1s1_b4678981:

    # a "\"You humans really are something. You basically uplifted yourselves.\""
    a "\"Vos homines sane mirabiles estis. Vos ipsos fere ad altiorem cultum provexistis.\""

# game/a1s1.rpy:1309
translate latin a1s1_8619f2c6:

    # "I shrug."
    "Umeros tollo."

# game/a1s1.rpy:1310
translate latin a1s1_299014b4:

    # m "\"We touched on it in my astronomy 101 class. I don't know much about them.\""
    m "\"De eis breviter egimus in schola introductoria astronomiae. Non multa de eis scio.\""

# game/a1s1.rpy:1311
translate latin a1s1_952fec56:

    # a "\"But the fact that your species found out about them in the first place...Anyway—\""
    a "\"Sed quod species tua ea omnino invenit... Utut est—\""

# game/a1s1.rpy:1313
translate latin a1s1_d9425616:

    # "Amicus presses a button before suddenly the hum of the ship comes back to life."
    "Amicus globulum premit et subito solitus navis fremitus reviviscit."

# game/a1s1.rpy:1314
translate latin a1s1_04ea1466:

    # com "\"Systems back online.\""
    com "\"Systemata rursus operantur.\""

# game/a1s1.rpy:1315
translate latin a1s1_cde03927:

    # a "\"And—\""
    a "\"Et—\""

# game/a1s1.rpy:1321
translate latin a1s1_abea6c9f:

    # "Amicus pulls the lever and suddenly the blue disappears and the windows are filled with warping stars again."
    "Amicus vectem trahit; subito fulgor caeruleus evanescit et fenestrae rursus stellis distortis implentur."

# game/a1s1.rpy:1322
translate latin a1s1_a1a1db76:

    # "I immediately look away, feeling the chocolate mud start to work its way up my throat."
    "Statim oculos averto, sentiens lutum socolatae simile per guttur ascendere incipere."

# game/a1s1.rpy:1323
translate latin a1s1_813a3f78:

    # a "\"We were actually almost to Adastra when you...took control.\""
    a "\"Re vera iam prope Adastram eramus, cum tu... gubernationem suscepisti.\""

# game/a1s1.rpy:1324
translate latin a1s1_1fb09630:

    # "Amicus rubs the side of his neck, wincing as he stretches it out."
    "Amicus latus colli fricat et, dum id extendit, vultum dolore contrahit."

# game/a1s1.rpy:1325
translate latin a1s1_9cea1886:

    # a "\"Should be there fairly soon.\""
    a "\"Satis mox perveniemus.\""

# game/a1s1.rpy:1326
translate latin a1s1_a4e2bc7d:

    # m "\"What is this.\""
    m "\"Quid est hoc.\""

# game/a1s1.rpy:1327
translate latin a1s1_0ea100a9:

    # "I wave my hand at the window, not looking."
    "Manu ad fenestram indico, non aspiciens."

# game/a1s1.rpy:1328
translate latin a1s1_56f1ccb2:

    # a "\"The bending light? It's the Stretch Drive. Basically space is being shortened ahead of us—\""
    a "\"Lux incurvata? Propulsor Distensionis est. Fere spatium ante nos contrahitur—\""

# game/a1s1.rpy:1329
translate latin a1s1_96270e5d:

    # "Amicus puts his paws close together in front of himself."
    "Amicus manus ante se prope inter se admovet."

# game/a1s1.rpy:1330
translate latin a1s1_db1a3fd7:

    # a "\"—and stretched out behind us.\""
    a "\"—et post nos extenditur.\""

# game/a1s1.rpy:1331
translate latin a1s1_7fb0886d:

    # "Amicus stretches his paws out wide."
    "Amicus manus late diducit."

# game/a1s1.rpy:1332
translate latin a1s1_4c4ab36f:

    # a "\"I, uh, don't really know how it works; only the parents can build this kind of tech and it's the only way I could get to Earth, or anywhere outside our star system, really.\""
    a "\"Ego, eh, non re vera scio quomodo operetur; soli Parentes artem technicam huiusmodi efficere possunt, et haec sola via erat qua ad Terram pervenire poteram, aut re vera quovis extra systema stellae nostrae.\""

# game/a1s1.rpy:1333
translate latin a1s1_9a608588:

    # a "\"They even figured out a way to make time stand still around us when we travel, otherwise waaay too much time would have passed back home.\""
    a "\"Etiam rationem invenerunt qua tempus circa nos, dum iter facimus, immotum maneat; alioquin domi nimis, nimis multum temporis praeteriisset.\""

# game/a1s1.rpy:1334
translate latin a1s1_38773d0a:

    # "I'm starting to get a picture of how powerful these \"parents\" actually are; beings capable of warping space and time to their will."
    "Intellegere incipio quam potentes illi \"Parentes\" re vera sint: entia quae spatium tempusque pro arbitrio flectere possunt."

# game/a1s1.rpy:1335
translate latin a1s1_8a03ef56:

    # m "\"So...how much more time—\""
    m "\"Ergo... quantum adhuc temporis—\""

# game/a1s1.rpy:1337
translate latin a1s1_53507c50:

    # com "\"Arriving at Stella Vita.\""
    com "\"Ad Stellam Vitam pervenitur.\""

# game/a1s1.rpy:1339
translate latin a1s1_a2029dcf:

    # "And just like that the stars become still again."
    "Et statim stellae rursus immotae fiunt."

# game/a1s1.rpy:1340
translate latin a1s1_ef76e4fb:

    # "Amicus grins."
    "Amicus late arridet."

# game/a1s1.rpy:1341
translate latin a1s1_c53bb988:

    # a "\"Welcome to Adastra, [mc].\""
    a "\"Bene ad Adastram venisti, [mc].\""

# game/a1s1.rpy:1343
translate latin a1s1_31ccc244:

    # "I look out the window and see a large, green and blue sphere shimmer below me."
    "Per fenestram aspicio et magnam sphaeram viridem caeruleamque sub me micantem video."

# game/a1s1.rpy:1344
translate latin a1s1_f2321a6f:

    # "Beyond it there's another globe, this one chalky and gray."
    "Ultra eam alius globus est, hic cretosus cinereusque."

# game/a1s1.rpy:1345
translate latin a1s1_6c9b88bd:

    # "A smaller and even brighter orb floats further to the right, its color almost pure white."
    "Minor sphaera etiam lucidior longius ad dextram fluit, colore paene puro albo."

# game/a1s1.rpy:1346
translate latin a1s1_6d735c90:

    # "Amicus points at the more Earth-like sphere."
    "Amicus sphaeram Terrae similiorem indicat."

# game/a1s1.rpy:1348
translate latin a1s1_a1e7b60e:

    # a "\"That specifically is Adastra, the planet to the left is {i}Ancoris{/i}. There aren't many people there aside from miners. The smallest is {i}Torque{/i}, another moon.\""
    a "\"Haec ipsa Adastra est; planeta ad sinistram {i}Ancoris{/i} appellatur. Pauci praeter fossores ibi habitant. Minima est {i}Torque{/i}, alia luna.\""

# game/a1s1.rpy:1349
translate latin a1s1_5b381c11:

    # a "\"I know you live on a planet, so Adastra might seem a bit small to you.\""
    a "\"Scio te in planeta habitare, itaque Adastra tibi paulo parva videri potest.\""

# game/a1s1.rpy:1350
translate latin a1s1_5802e7c0:

    # "I press a hand to the window and notice that it's ice-cold."
    "Manum contra fenestram premo atque eam glacialem esse animadverto."

# game/a1s1.rpy:1351
translate latin a1s1_7fbca651:

    # m "\"Looks pretty big from here.\""
    m "\"Hinc satis magna videtur.\""

# game/a1s1.rpy:1352
translate latin a1s1_ebd15aed:

    # "Amicus leans over the console and starts touching at the screen."
    "Amicus super tabulam gubernandi inclinat et superficiem digitis tangere incipit."

# game/a1s1.rpy:1353
translate latin a1s1_97d616b2:

    # com "\"Re entry sequence engaged.\""
    com "\"Series reingressus coepta est.\""

# game/a1s1.rpy:1354
translate latin a1s1_49e30f0d:

    # a "\"Go ahead and put your safety straps on. Re-entry is never comfortable in smaller ships.\""
    a "\"Age, lora securitatis alliga. Reingressus in navibus minoribus numquam commodus est.\""

# game/a1s1.rpy:1356
translate latin a1s1_99993fde:

    # "I hurriedly do as he says, sitting down and trying to figure out the seatbelt."
    "Festinanter facio quod dicit: consido et quomodo loris utar intellegere conor."

# game/a1s1.rpy:1357
translate latin a1s1_c6141103:

    # "Eventually, Amicus has to come over and help, showing me how the strap just feeds into a slot."
    "Tandem Amicus accedere atque me adiuvare debet, ostendens lorum tantum in rimam inserendum esse."

# game/a1s1.rpy:1358
translate latin a1s1_b3c1cd02:

    # "This automatically pulls the straps tightly across my waist and chest."
    "Ita lora sponte arcte circa lumbos pectusque meum trahuntur."

# game/a1s1.rpy:1359
translate latin a1s1_620a887b:

    # "As Amicus gets in his own seat, we start to curve around to the darker side of Adastra."
    "Dum Amicus in suam sedem conscendit, ad obscuriorem Adastrae partem curvo itinere circumire incipimus."

# game/a1s1.rpy:1363
translate latin a1s1_f822a901:

    # "Every now and then there's a bit of a downward tug on my stomach, sort of like when when the passenger jet I was in was landing in Rome."
    "Interdum venter mihi aliquantum deorsum trahitur, fere sicut cum aeroplanum vectorium quo vehebar Romae descendebat."

# game/a1s1.rpy:1364
translate latin a1s1_9a354312:

    # "I had imagined that things would rattle around, along with a bunch of fire and heat like in a Hollywood movie."
    "Putaveram omnia crepitatura esse, ignibus caloreque abundante, sicut in pellicula Hollywoodiana."

# game/a1s1.rpy:1365
translate latin a1s1_084e4e08:

    # "Instead, there's only a rumbling sound that accompanies a gentle vibration through the seat."
    "Sed tantum sonus fremens auditur, cum levi vibratione per sedem sentienda."

# game/a1s1.rpy:1366
translate latin a1s1_f7e924ea:

    # "There isn't any fire, but I do start to see blue flashes on the otherwise black windows."
    "Nullus ignis est, sed fulgores caeruleos in fenestris ceterum nigris videre incipio."

# game/a1s1.rpy:1367
translate latin a1s1_e53fd1ba:

    # "I look over at Amicus and see that he's got his eyes closed, looking relaxed."
    "Amicum aspicio et oculis clausis tranquilloque vultu video."

# game/a1s1.rpy:1368
translate latin a1s1_511a7243:

    # m "\"Um...\""
    m "\"Ehm...\""

# game/a1s1.rpy:1369
translate latin a1s1_755fa1f6:

    # "The wolf opens his eyes and smiles gently at me."
    "Lupus oculos aperit et mihi leniter arridet."

# game/a1s1.rpy:1370
translate latin a1s1_608c5144:

    # a "\"Don't worry. This is all normal.\""
    a "\"Noli sollicitus esse. Haec omnia usitata sunt.\""

# game/a1s1.rpy:1371
translate latin a1s1_8d8c3040:

    # "I realize how nervous I must look, so I nod and lean my head back in the seat."
    "Intellego quam anxius videri debeam; itaque annuo et caput in sede reclino."

# game/a1s1.rpy:1373
translate latin a1s1_6e06c5a5:

    # "The electric blue flashes stop after a while and then I feel one final downward pull on my body before the rumbling fades out."
    "Fulgores caerulei electrici post aliquantum temporis cessant; tum ultimum tractum deorsum per corpus sentio, priusquam fremitus evanescit."

# game/a1s1.rpy:1374
translate latin a1s1_f2f602be:

    # "We sit in complete silence and darkness for a moment before I hear Amicus moving next to me."
    "Paulisper in summo silentio tenebrisque sedemus, antequam Amicum prope me moveri audio."

# game/a1s1.rpy:1375
translate latin a1s1_0d1e01e8:

    # a "\"Okay, we're in the hanger right now. Just follow me into the palace.\""
    a "\"Bene, nunc in receptaculo navium sumus. Sequere me modo in palatium.\""

# game/a1s1.rpy:1376
translate latin a1s1_7d840b05:

    # "Amicus gets up, but the ship stays dark."
    "Amicus surgit, sed navis obscura manet."

# game/a1s1.rpy:1377
translate latin a1s1_a5a4759a:

    # "So does the hanger."
    "Receptaculum navium quoque."

# game/a1s1.rpy:1378
translate latin a1s1_ed2cc2b7:

    # m "\"Okay...why aren't there any lights?\""
    m "\"Bene... cur nulla lumina sunt?\""

# game/a1s1.rpy:1379
translate latin a1s1_2a52e8d5:

    # a "\"Uh, everyone's probably asleep. I don't want to wake them up.\""
    a "\"Eh, probabiliter omnes dormiunt. Eos excitare nolo.\""

# game/a1s1.rpy:1380
translate latin a1s1_abc921e0:

    # "I get the feeling that he just doesn't want anyone to catch us, but I don't say anything."
    "Sentio eum tantum nolle quemquam nos deprehendere, sed nihil dico."

# game/a1s1.rpy:1381
translate latin a1s1_db3c6603:

    # "I fiddle with my seat belt, unable to get it undone until I feel Amicus lean over me, breathing in my ear as his large paw covers mine, pressing something that releases the strap."
    "Lora securitatis tracto nec solvere possum, donec Amicum super me inclinari sentio; ad aurem meam spirat dum magna manus eius meam tegit et aliquid premit quo lorum solvitur."

# game/a1s1.rpy:1382
translate latin a1s1_1d2ec602:

    # "I stand up, feeling around blindly as I hold onto the seat, only barely able to make out the red bristles of the headrest in front of me."
    "Surgo, caecus circum me palpans dum sedem teneo; vix saetas rubras fulcri capitis ante me positi discernere possum."

# game/a1s1.rpy:1383
translate latin a1s1_3e1976e0:

    # "I reach out a hand."
    "Manum porrigo."

# game/a1s1.rpy:1384
translate latin a1s1_cd3315d1:

    # m "\"Hey...\""
    m "\"Heus...\""

# game/a1s1.rpy:1385
translate latin a1s1_9776826b:

    # "Amicus's rough paw pads envelop my hand."
    "Aspera pulvinula manus Amici manum meam amplectuntur."

# game/a1s1.rpy:1386
translate latin a1s1_33446be8:

    # a "\"What's wrong?\""
    a "\"Quid mali est?\""

# game/a1s1.rpy:1387
translate latin a1s1_5f787939:

    # m "\"I can't see anything.\""
    m "\"Nihil videre possum.\""

# game/a1s1.rpy:1388
translate latin a1s1_c38a0bd1:

    # a "\"Oh! Can you not see in low light?\""
    a "\"O! Nonne in tenui luce videre potes?\""

# game/a1s1.rpy:1389
translate latin a1s1_6930ca1d:

    # "Amicus starts pulling me along before I hear a soft beep, then a whooshing sound."
    "Amicus me secum trahere incipit; tum levem sonum acutum audio, deinde sibilum."

# game/a1s1.rpy:1390
translate latin a1s1_3a1f371a:

    # m "\"Not really.\""
    m "\"Non sane.\""

# game/a1s1.rpy:1392
translate latin a1s1_3cab8726:

    # "Another sound catches my attention...crickets."
    "Alius sonus animum meum advertit... grylli."

# game/a1s1.rpy:1393
translate latin a1s1_36a1b9ab:

    # "They have crickets here too?"
    "Etiam hic gryllos habent?"

# game/a1s1.rpy:1394
translate latin a1s1_55aa36bb:

    # "At the same time I'm hit by a wall of humid warmth, almost like walking in to a sauna."
    "Simul quasi murus caloris umidi in me incurrit, paene sicut si in sudatorium ingrediar."

# game/a1s1.rpy:1395
translate latin a1s1_032b6a72:

    # "Amicus puts a paw against my chest."
    "Amicus manum contra pectus meum ponit."

# game/a1s1.rpy:1396
translate latin a1s1_683444a1:

    # a "\"Wait a second.\""
    a "\"Paulisper exspecta.\""

# game/a1s1.rpy:1397
translate latin a1s1_fae3bfe3:

    # "Then I hear a soft thud followed by a grunt."
    "Tum levem ictum audio, quem fremitus sequitur."

# game/a1s1.rpy:1398
translate latin a1s1_f702c6de:

    # m "\"Hello?\""
    m "\"Heus?\""

# game/a1s1.rpy:1399
translate latin a1s1_69a57f73:

    # a "\"Lean down.\""
    a "\"Inclina te.\""

# game/a1s1.rpy:1400
translate latin a1s1_6d182cad:

    # "My eyes have adjusted a bit more to the dark and I'm barely able to make out what I think are paws reaching up toward me."
    "Oculi mei paulo magis tenebris assueverunt; vix discernere possum quae manus ad me sursum porrectae esse puto."

# game/a1s1.rpy:1401
translate latin a1s1_c7d16218:

    # "I crouch down and Amicus grabs me under the arms before pulling me clumsily off the deck of the ship."
    "Me demitto; Amicus sub bracchiis me arripit, deinde inepte de tabulato navis trahit."

# game/a1s1.rpy:1402
translate latin a1s1_644d4ef4:

    # "My face mashes up against his furry chest before I'm set down on my feet."
    "Facies mea contra pectus eius pilosum premitur, antequam me in pedes ponit."

# game/a1s1.rpy:1403
translate latin a1s1_93ef6329:

    # a "\"Alright, so we're just going to go straight to my room. Try not to make too much noise.\""
    a "\"Bene, recta in cubiculum meum ibimus. Conare ne nimium strepitum facias.\""

# game/a1s1.rpy:1404
translate latin a1s1_6a1f00f6:

    # "I start to nod, but Amicus is already pulling me along."
    "Annuere incipio, sed Amicus iam me secum trahit."

# game/a1s1.rpy:1405
translate latin a1s1_2cbe14b8:

    # "The humidity presses down on me like a physical force and I start to worry that I might actually have trouble surviving on this moon."
    "Umor quasi vis corporea me premit, et timere incipio ne re vera in hac luna superesse mihi difficile sit."

# game/a1s1.rpy:1406
translate latin a1s1_5520fe34:

    # m "\"It's...really hot.\""
    m "\"Est... valde calidum.\""

# game/a1s1.rpy:1407
translate latin a1s1_7cbc1110:

    # a "\"Things will cool off once we're inside.\""
    a "\"Frigidius erit, cum intus fuerimus.\""

# game/a1s1.rpy:1408
translate latin a1s1_8f4cb2e0:

    # "I can hear him panting heavily as we move through the hanger."
    "Eum graviter anhelantem audio, dum per navium receptaculum procedimus."

# game/a1s1.rpy:1409
translate latin a1s1_f5c7754d:

    # "I still can't see much, just angular shapes in the darkness, but finally I see some light ahead along with some cold air."
    "Adhuc parum video, tantum figuras angulosas in tenebris; sed tandem lumen ante nos aspicio atque simul aerem frigidum sentio."

# game/a1s1.rpy:1411
translate latin a1s1_2ad5fe10:

    # "We turn a corner and I have to blink against how bright it suddenly becomes."
    "Angulum vertimus, et nictare debeo, adeo subito splendet."

# game/a1s1.rpy:1414
translate latin a1s1_fb8e1c44:

    # "I look around at the pillars and marble floor, the bright lights above me, and what looks like a garden complete with statues extending out through the archways."
    "Circum aspicio columnas solumque marmoreum, lumina clara supra me posita, et quasi hortum statuis ornatum per arcus patentem."

# game/a1s1.rpy:1415
translate latin a1s1_19dea63a:

    # "Well, at least I know Amicus wasn't lying about living in a palace."
    "Bene, saltem scio Amicum non mentitum esse se in palatio habitare."

# game/a1s1.rpy:1416
translate latin a1s1_615b956e:

    # a "\"What do you think?\""
    a "\"Quid tu censes?\""

# game/a1s1.rpy:1418
translate latin a1s1_cab4dfcb:

    # m "\"Wow, I mean, it looks really cool, really expensive.\""
    m "\"O, scilicet, valde pulchrum videtur, valde pretiosum.\""

# game/a1s1.rpy:1419
translate latin a1s1_1876a0b8:

    # "I don't know if that last part was such a great compliment, but Amicus seems happy."
    "Nescio an ultimum illud tam bona laus fuerit, sed Amicus laetus videtur."

# game/a1s1.rpy:1421
translate latin a1s1_27bb6ef5:

    # a "\"Thanks! It's going to be your home for a while, so I'm glad you like it.\""
    a "\"Gratias! Hic aliquamdiu domus tua erit, itaque gaudeo tibi placere.\""

# game/a1s1.rpy:1422
translate latin a1s1_93bd351e:

    # "Amicus adjusts his cape, fanning it out a little."
    "Amicus pallium aptat et aliquantum expandit."

# game/a1s1.rpy:1425
translate latin a1s1_ce6f0ada:

    # a "\"This is only a small portion of the palace, of course. I'll show you around later, but for now I want to go to my room and dry out a little.\""
    a "\"Haec sane exigua tantum palatii pars est. Te postea circumducam, sed nunc in cubiculum meum ire et paulum siccari volo.\""

# game/a1s1.rpy:1427
translate latin a1s1_45bbb629:

    # a "\"I must look like a mess right now. The humidity doesn't do my fur any favors.\""
    a "\"Iam satis incomptus videri debeo. Umor pilis meis minime prodest.\""

# game/a1s1.rpy:1428
translate latin a1s1_3c1c4b3d:

    # "I can tell Amicus is genuinely embarrassed, even if he's trying to joke, so I put a hand up to my hair."
    "Intellego Amicum vere erubescere, quamquam iocari conatur; itaque manum ad capillos meos tollo."

# game/a1s1.rpy:1429
translate latin a1s1_11d886df:

    # m "\"I have a little less to worry about, but I'm sure my hair is pretty crazy right now.\""
    m "\"Mihi paulo minus curandum est, sed certe capilli mei iam satis efferi sunt.\""

# game/a1s1.rpy:1431
translate latin a1s1_68759124:

    # a "\"True. That patch of fur really is something, though.\""
    a "\"Verum. Fasciculus tamen ille pilorum sane mirabilis est.\""

# game/a1s1.rpy:1432
translate latin a1s1_219c87e3:

    # "The wolf reaches out and touches my hair, rubbing it between the pads on his fingers."
    "Lupus manum porrigit et capillos meos tangit, eos inter digitorum pulvinula fricans."

# game/a1s1.rpy:1433
translate latin a1s1_64a54630:

    # "We've made physical contact several times over the last day, but this is the first time that it really feels friendly."
    "Ultimo die aliquotiens corpora nostra tetigimus, sed hoc primum fit ut contactus vere amicus videatur."

# game/a1s1.rpy:1434
translate latin a1s1_fe7e1d2e:

    # "We stand there for a moment, just long enough for things to get awkward."
    "Paulisper ibi stamus, satis diu ut res incommodior fiat."

# game/a1s1.rpy:1436
translate latin a1s1_71db700d:

    # "Amicus pulls his hand back suddenly, as if realizing what he's doing."
    "Amicus subito manum retrahit, quasi tum demum intellegat quid agat."

# game/a1s1.rpy:1437
translate latin a1s1_af6538ef:

    # a "\"Oh, uh—\""
    a "\"O, eh—\""

# game/a1s1.rpy:1438
translate latin a1s1_837eb71f:

    # "He's saved from having to think of something to say as we both hear footsteps coming up the hall to our right."
    "Ab excogitando quod dicat liberatur, cum ambo gradus per andronem ad dextram appropinquantes audimus."

# game/a1s1.rpy:1440
translate latin a1s1_9894b2cf:

    # a "\"Shit!\""
    a "\"Merda!\""

# game/a1s1.rpy:1441
translate latin a1s1_df8ec4bc:

    # m "\"What?\""
    m "\"Quid?\""

# game/a1s1.rpy:1442
translate latin a1s1_1e069919:

    # a "\"Hide and be quiet!\""
    a "\"Absconde te et tace!\""

# game/a1s1.rpy:1444
translate latin a1s1_661fff36:

    # "Amicus whispers loudly at me and suddenly pushes me hard back the way we came."
    "Amicus voce summissa sed clara mihi loquitur atque subito me valide in partem unde venimus impellit."

# game/a1s1.rpy:1445
translate latin a1s1_6e2b5c7a:

    # "I stumble before scrambling around the corner."
    "Titubo, deinde festinanter post angulum me recipio."

# game/a1s1.rpy:1446
translate latin a1s1_3eda09ab:

    # "The footsteps get louder as I stand up and press my back against the wall, listening."
    "Gradus clariores fiunt dum me erigo et dorsum parieti applico, auscultans."

# game/a1s1.rpy:1447
translate latin a1s1_120f6972:

    # unk "\"Amicus!\""
    unk "\"Amice!\""

# game/a1s1.rpy:1448
translate latin a1s1_14e760c5:

    # "I jump, the person almost shouting Amicus's name."
    "Subsilio: advena paene clamat nomen Amici."

# game/a1s1.rpy:1449
translate latin a1s1_42f6c8ee:

    # a "\"Cassius.\""
    a "\"Cassius.\""

# game/a1s1.rpy:1450
translate latin a1s1_3aa62c9a:

    # "Amicus's deeper voice responds, sounding cool and collected."
    "Vox Amici gravior respondet, tranquilla compositaque."

# game/a1s1.rpy:1451
translate latin a1s1_496a92c2:

    # c "\"Where the HELL have you been?\""
    c "\"Ubi MALUM fuisti?\""

# game/a1s1.rpy:1452
translate latin a1s1_ad49212a:

    # "His voice is higher-pitched and a little more articulate than Amicus's."
    "Vox eius acutior est et paulo distinctius verba pronuntiat quam Amicus."

# game/a1s1.rpy:1453
translate latin a1s1_aa6956c4:

    # "I start to look around the corner, then hesitate...then I do it anyway, wanting to see who this person is."
    "Circa angulum prospicere incipio, tum haesito... tum tamen facio, scire cupiens quis ille sit."

# game/a1s1.rpy:1454
translate latin a1s1_8b6d0f56:

    # "Luckily, Amicus has moved further down the room so that I'm slightly behind this Cassius guy."
    "Feliciter Amicus longius in conclave processit, ita ut ego paulum post hunc Cassium sim."

# game/a1s1.rpy:1457
translate latin a1s1_6d6d622c:

    # "I see a white wolf, quite a bit smaller compared to Amicus, but no less intimidating...maybe even more so."
    "Lupum album video, multo minorem quam Amicum, sed non minus terribilem... fortasse etiam magis."

# game/a1s1.rpy:1458
translate latin a1s1_551d2447:

    # "I can tell by his demeanor that he's probably not a fun person to be around."
    "Ex modo quo se gerit intellego eius societatem probabiliter parum iucundam esse."

# game/a1s1.rpy:1460
translate latin a1s1_35799fc1:

    # a "\"I was out hunting. Is something wrong?\""
    a "\"Venatum ieram. Num quid mali est?\""

# game/a1s1.rpy:1462
translate latin a1s1_8d03c841:

    # c "\"Hunting!? For two days? Is that a joke?\""
    c "\"Venatum!? Per duos dies? Estne iocus?\""

# game/a1s1.rpy:1464
translate latin a1s1_6931456d:

    # a "\"Was it that long?\""
    a "\"Tam diu afui?\""

# game/a1s1.rpy:1466
translate latin a1s1_36448747:

    # c "\"Yes! You were supposed to make a speech in Lux yesterday! How many times did we remind you of it?\""
    c "\"Ita! Heri in Luce orationem habere debebas! Quotiens te eius admonuimus?\""

# game/a1s1.rpy:1468
translate latin a1s1_55965de7:

    # "Cassius suddenly takes a deep breath."
    "Cassius subito alte spiritum ducit."

# game/a1s1.rpy:1470
translate latin a1s1_6328b991:

    # c "\"Really, Amicus, you seem to expect everyone to cover up your mistakes. I can't comprehend how you could have forgotten.\""
    c "\"Re vera, Amice, exspectare videris ut omnes errores tuos tegant. Intellegere non possum quomodo oblivisci potueris.\""

# game/a1s1.rpy:1471
translate latin a1s1_318eda86:

    # a "\"I...lost track of time.\""
    a "\"Ego... temporis rationem amisi.\""

# game/a1s1.rpy:1472
translate latin a1s1_42c24d75:

    # c "\"That's not an excuse. How do you expect to become emperor if you act this way?\""
    c "\"Ista non est excusatio. Quomodo imperator fieri speras, si ita te geris?\""

# game/a1s1.rpy:1474
translate latin a1s1_2df92d67_1:

    # "Amicus growls."
    "Amicus fremit."

# game/a1s1.rpy:1475
translate latin a1s1_4c663d3c:

    # a "\"Don't even pretend, Cass. You're probably happy I missed it!\""
    a "\"Ne simules quidem, Cass. Probabiliter gaudes quod non adfui!\""

# game/a1s1.rpy:1476
translate latin a1s1_3046bf22:

    # c "\"That's ridiculous. Amicus, I only want what's best for the empire.\""
    c "\"Ridiculum est. Amice, tantum id volo quod imperio optimum est.\""

# game/a1s1.rpy:1477
translate latin a1s1_e2a1422a:

    # "Amicus opens his mouth, then shuts it suddenly."
    "Amicus os aperit, deinde subito claudit."

# game/a1s1.rpy:1479
translate latin a1s1_cf31936b:

    # a "\"No, I'm not doing this tonight. I'm tired and I want to go to bed.\""
    a "\"Non, hoc hac nocte non agam. Fessus sum et cubitum ire volo.\""

# game/a1s1.rpy:1480
translate latin a1s1_9dfa6cbf:

    # "Cassius quietly regards Amicus for a moment, then shakes his head."
    "Cassius paulisper tacitus Amicum aspicit, deinde caput quatit."

# game/a1s1.rpy:1482
translate latin a1s1_cd56fee5:

    # c "\"Well, Virginia went in your stead, so you have her to thank when she returns.\""
    c "\"Bene, Virginia pro te ivit, itaque ei gratias agere debes cum redierit.\""

# game/a1s1.rpy:1484
translate latin a1s1_b9f94f87:

    # a "\"She's better at that sort of thing anyway.\""
    a "\"Illa tamen rebus huiusmodi peritior est.\""

# game/a1s1.rpy:1485
translate latin a1s1_59a7fbbc:

    # c "\"The point was to show Lux that the next possible emperor stands in solidarity with them. Sending your sister is not a good look.\""
    c "\"Id agebatur ut Luci ostenderes imperatorem qui proximus esse posset cum eis stare. Sororem tuam mittere male te ostendit.\""

# game/a1s1.rpy:1487
translate latin a1s1_25a6c897:

    # a "\"Well...walking around in undergarments doesn't look good either. You think that's how an emperor should behave?\""
    a "\"Bene... in vestibus interioribus ambulare ne id quidem bene videtur. Putasne imperatorem ita se gerere debere?\""

# game/a1s1.rpy:1489
translate latin a1s1_8fefcb05:

    # c "\"No one's awake, Amicus. Don't be such a pup.\""
    c "\"Nemo vigilat, Amice. Noli tamquam catulus te gerere.\""

# game/a1s1.rpy:1490
translate latin a1s1_c4e3cfc3:

    # a "\"I'm just saying you look really small without your armor. Now THAT is not a good look for an emperor.\""
    a "\"Tantum dico te sine armatura valde parvum videri. HOC vero imperatorem male ostendit.\""

# game/a1s1.rpy:1492
translate latin a1s1_ca3d8a7c:

    # c "\"Excuse me?\""
    c "\"Quid ais?\""

# game/a1s1.rpy:1493
translate latin a1s1_8ec8b806:

    # a "\"What? I only want what's best for the empire and a little runt like you definitely isn't.\""
    a "\"Quid? Tantum id volo quod imperio optimum est, et tantulus homunculus qualis tu es id certe non est.\""

# game/a1s1.rpy:1495
translate latin a1s1_3e290ecb:

    # "They stare at each other for a long time and though I have no idea what's going on, I can almost see the electricity arcing between them."
    "Diu alter alterum intuetur; quamquam nescio quid agatur, paene video scintillas inter eos salientes."

# game/a1s1.rpy:1497
translate latin a1s1_91fe7a34:

    # "Finally, Cassius turns on his heel and stalks away, tail swishing furiously."
    "Tandem Cassius in calce se vertit et iratus abit, caudam vehementer agitando."

# game/a1s1.rpy:1498
translate latin a1s1_36272402:

    # c "\"Goodnight, Amicus.\""
    c "\"Bonam noctem, Amice.\""

# game/a1s1.rpy:1500
translate latin a1s1_b1120e2f:

    # "Amicus stands there for a moment, still puffed out a little before he finally deflates."
    "Amicus paulisper ibi stat, adhuc aliquantum tumidus, antequam tandem se remittit."

# game/a1s1.rpy:1502
translate latin a1s1_97c20039:

    # a "\"Dammit.\""
    a "\"Male sit.\""

# game/a1s1.rpy:1504
translate latin a1s1_5346bd85:

    # "I stand quietly around the corner, waiting for Amicus to call me back."
    "Tacitus post angulum sto, exspectans ut Amicus me revocet."

# game/a1s1.rpy:1505
translate latin a1s1_0ca229dc:

    # "When he doesn't, I whisper at him."
    "Cum non revocat, eum summissa voce appello."

# game/a1s1.rpy:1506
translate latin a1s1_2e87079d_1:

    # m "\"Amicus?\""
    m "\"Amice?\""

# game/a1s1.rpy:1508
translate latin a1s1_e628232f:

    # "His ears prick up and he turns to me."
    "Aures eius eriguntur et ad me vertitur."

# game/a1s1.rpy:1510
translate latin a1s1_398bda04:

    # a "\"Hey, come on. We should go before anyone else decides to show up.\""
    a "\"Heus, age. Eamus priusquam alius quisquam venire statuat.\""

# game/a1s1.rpy:1511
translate latin a1s1_1f228d29:

    # m "\"Okay.\""
    m "\"Bene.\""

# game/a1s1.rpy:1514
translate latin a1s1_98291688:

    # "I can tell by the way the wolf walks, his ears slightly down, his tail almost dragging, that he's not in a good mood."
    "Ex modo quo lupus ambulat, auribus paulum demissis caudaque paene humum trahente, intellego eum maesto animo esse."

# game/a1s1.rpy:1515
translate latin a1s1_702cfbe4:

    # m "\"You alright?\""
    m "\"Valesne?\""

# game/a1s1.rpy:1516
translate latin a1s1_56b926d2:

    # a "\"Hm? Yeah, yeah, I'm fine. My brother just knows how to irritate me...and I shouldn't have said that to him.\""
    a "\"Hm? Ita, ita, bene valeo. Frater meus me irritare novit... neque illa ei dicere debui.\""

# game/a1s1.rpy:1517
translate latin a1s1_fbabd804:

    # "We quietly walk through the marble halls, the echoing of our footsteps the only sound."
    "Per andrones marmoreos taciti ambulamus; solus gradus nostrorum repercussus auditur."

# game/a1s1.rpy:1518
translate latin a1s1_a9f4ea58:

    # m "\"Is he not supposed to see me?\""
    m "\"Vetitumne ei est me videre?\""

# game/a1s1.rpy:1519
translate latin a1s1_fb181d28:

    # a "\"I just...need to think of the right way to introduce you. Now isn't the best time.\""
    a "\"Tantum... excogitare debeo quo recto modo te inducam. Nunc tempus non est optimum.\""

# game/a1s1.rpy:1520
translate latin a1s1_27dcc0f2:

    # m "\"Is he the one that challenged you for the throne?\""
    m "\"Ille est qui tibi thronum disputavit?\""

# game/a1s1.rpy:1521
translate latin a1s1_bb61b276:

    # "Amicus is quiet for a moment before heaving a huge sigh."
    "Amicus paulisper tacet, deinde ingens suspirium emittit."

# game/a1s1.rpy:1522
translate latin a1s1_e0a3b7c8:

    # a "\"Yes, and he's really starting to turn my life upside down because of it. Sometimes I think he just sees this all as a game.\""
    a "\"Ita, atque ob eam rem vitam meam vere invertere incipit. Interdum puto eum haec omnia tantum ludum putare.\""

# game/a1s1.rpy:1523
translate latin a1s1_59527240:

    # "We come to a stop at what looks like a door."
    "Consistimus ante id quod ianua esse videtur."

# game/a1s1.rpy:1524
translate latin a1s1_6866551c:

    # "It's completely smooth though, made of what also looks like marble."
    "Tota tamen levis est, facta ex materia quae ipsa quoque marmor esse videtur."

# game/a1s1.rpy:1525
translate latin a1s1_65feb50d:

    # "Amicus doesn't make any move to open it."
    "Amicus nullum motum facit ut eam aperiat."

# game/a1s1.rpy:1527
translate latin a1s1_58d42db2:

    # a "\"And you know, he never seemed concerned for me and my duties until AFTER he made his challenge. That's what bothers me the most, knowing that it's all an act.\""
    a "\"Atque scis, numquam de me officiisque meis sollicitus videbatur nisi POSTQUAM provocavit. Hoc maxime me vexat: scire omnia esse simulationem.\""

# game/a1s1.rpy:1528
translate latin a1s1_e9b2a73b:

    # m "\"I guess you're not really close with him, then?\""
    m "\"Ergo, ut puto, non valde coniuncti estis?\""

# game/a1s1.rpy:1529
translate latin a1s1_1372a054:

    # a "\"Not since we were pups, no.\""
    a "\"Non, ex quo catuli eramus.\""

# game/a1s1.rpy:1530
translate latin a1s1_b92b890e:

    # "A disturbing thought suddenly hits me."
    "Subito cogitatio inquieta mihi venit."

# game/a1s1.rpy:1531
translate latin a1s1_be6bbf0d:

    # m "\"Well...you know in Earth's ancient Rome, the place where you guys uplifted, people would kill each other over the throne, like a lot...does that happen here?\""
    m "\"Bene... scisne in antiqua Roma Terrae, ubi homines ad altiorem cultum provexistis, homines propter thronum inter se necavisse, saepissime... hic quoque id fit?\""

# game/a1s1.rpy:1533
translate latin a1s1_e0a11c00_1:

    # "Amicus frowns."
    "Amicus frontem corrugat."

# game/a1s1.rpy:1534
translate latin a1s1_fd516fb4:

    # a "\"Uh...I suppose it's happened in the past, but that was a long time ago. Besides, Cassius would never do something like that.\""
    a "\"Eh... credo antea accidisse, sed iam pridem. Praeterea Cassius numquam rem talem faceret.\""

# game/a1s1.rpy:1536
translate latin a1s1_92f1c9fd:

    # "Amicus sticks out his paw and presses it to a black square on the wall."
    "Amicus manum porrigit et ad quadratum nigrum in pariete premit."

# game/a1s1.rpy:1537
translate latin a1s1_f600264a:

    # "The door slides open without a sound."
    "Ianua nullo sono labitur et aperitur."

# game/a1s1.rpy:1539
translate latin a1s1_0907a4b7:

    # "I feel a rush of cool air come out of the room and Amicus lets out a happy sigh as he steps inside."
    "Impetum aeris frigidi e cubiculo exeuntem sentio; Amicus laetus suspirat dum intrat."

# game/a1s1.rpy:1541
translate latin a1s1_ef87675d:

    # a "\"Ahhhh, that's much better. My dad's advisor keeps the climate way too hot in the rest of the palace.\""
    a "\"Ahhhh, multo melius. Consiliarius patris mei aerem in reliquo palatio multo nimis calidum servat.\""

# game/a1s1.rpy:1543
translate latin a1s1_6d34af9f:

    # "I follow the wolf inside and look around."
    "Lupum intus sequor et circum aspicio."

# game/a1s1.rpy:1544
translate latin a1s1_eb0631f2:

    # "Aside from a few quirks, the room looks like it could have come straight out of any luxury hotel on Earth."
    "Paucis rebus insolitis exceptis, cubiculum quasi ex quovis deversorio luxuoso Terrae translatum videtur."

# game/a1s1.rpy:1545
translate latin a1s1_03aeed76:

    # "Amicus sits heavily on the bed, making it squeak."
    "Amicus graviter in lecto considit, ut ille stridat."

# game/a1s1.rpy:1546
translate latin a1s1_a893d3be:

    # "He starts to strip off his clothing."
    "Vestes exuere incipit."

# game/a1s1.rpy:1548
translate latin a1s1_2fe005d6:

    # a "\"Toilet and bath are in there.\""
    a "\"Latrina et balneum ibi sunt.\""

# game/a1s1.rpy:1549
translate latin a1s1_5c0f7e77:

    # "He nods ahead at another door across from the bed."
    "Capite ad aliam ianuam contra lectum positam annuit."

# game/a1s1.rpy:1550
translate latin a1s1_2dd50623:

    # "Then he jabs a thumb back at the large curtain."
    "Tum pollice retrorsum magnum velum indicat."

# game/a1s1.rpy:1552
translate latin a1s1_92a9da45:

    # a "\"That's the balcony if you want to get some air, though I don't know why you would in this weather.\""
    a "\"Ibi maenianum est, si aerem haurire vis, quamquam nescio cur tali caelo id velis.\""

# game/a1s1.rpy:1553
translate latin a1s1_c57f6e52:

    # "Then he points at the couch."
    "Tum lectum recubitorium indicat."

# game/a1s1.rpy:1554
translate latin a1s1_6c3d91f7:

    # a "\"And that can be where you sleep, if that's alright with you. I've known other aliens to prefer the floor, though.\""
    a "\"Et ibi dormire potes, si tibi placet. Alios tamen alienigenas novi qui solum malebant.\""

# game/a1s1.rpy:1556
translate latin a1s1_424ee26a:

    # m "\"The couch is fine.\""
    m "\"Lectus recubitorius mihi convenit.\""

# game/a1s1.rpy:1558
translate latin a1s1_73002da7:

    # "I walk over to the red sofa, sizing it up."
    "Ad lectum recubitorium rubrum accedo eiusque magnitudinem aestimo."

# game/a1s1.rpy:1559
translate latin a1s1_2bcdcf55:

    # "It's more than big enough, but as I pick up the little black pillow I notice it's covered in fur."
    "Plus quam satis magnus est, sed cum parvum pulvinum nigrum tollo, animadverto eum pilis coopertum esse."

# game/a1s1.rpy:1560
translate latin a1s1_cb3b3bc4:

    # "I inconspicuously pick some of it off before a light blanket smacks into the back of my head."
    "Aliquot pilos furtim tollo, antequam leve stragulum occiput meum percutit."

# game/a1s1.rpy:1562
translate latin a1s1_2d9d5641:

    # a "\"Haha! There you go. Is that all okay?\""
    a "\"Haha! Ecce. Bene se omnia habent?\""

# game/a1s1.rpy:1563
translate latin a1s1_9ad1e2eb:

    # m "\"Yeah, this is good.\""
    m "\"Ita, haec bona sunt.\""

# game/a1s1.rpy:1564
translate latin a1s1_6fe613fb:

    # "I hope the blanket will be enough to keep off the cold that seems to be wafting down from the ceiling."
    "Spero stragulum satis fore ad frigus arcendum quod e laqueari descendere videtur."

# game/a1s1.rpy:1566
translate latin a1s1_6b596c54:

    # a "\"Good. Like I said earlier, I'll show you the rest of the palace tomorrow. We'll get some real food too.\""
    a "\"Bene. Ut antea dixi, cras reliquum palatium tibi ostendam. Verum quoque cibum accipiemus.\""

# game/a1s1.rpy:1568
translate latin a1s1_30066ee1:

    # "Amicus sprawls back on the bed, not bothering to draw up any blankets, his eyes closed."
    "Amicus in lecto supinus extenditur, nullum stragulum super se ducere curans, oculis clausis."

# game/a1s1.rpy:1569
translate latin a1s1_c5dded50:

    # "I actually want real food now, but I don't say anything and instead lay down, the sofa a bit harder than I'd expected."
    "Re vera iam verum cibum volo, sed nihil dico atque potius decumbo; lectus recubitorius paulo durior est quam exspectaveram."

# game/a1s1.rpy:1570
translate latin a1s1_5e7694b6:

    # "Good support, I guess."
    "Corpus bene sustinet, credo."

# game/a1s1.rpy:1571
translate latin a1s1_1bcf068a:

    # "As I'm settling in, I think Amicus has already fallen asleep, but that's when he speaks again."
    "Dum me compono, Amicum iam obdormivisse puto, sed tum iterum loquitur."

# game/a1s1.rpy:1572
translate latin a1s1_5abd6ccb:

    # a "\"And thanks, [mc].\""
    a "\"Et gratias, [mc].\""

# game/a1s1.rpy:1573
translate latin a1s1_521ba82e:

    # "I don't know what he's thanking me for."
    "Nescio cur mihi gratias agat."

# game/a1s1.rpy:1574
translate latin a1s1_de396717:

    # "For not killing him on the ship?"
    "Quia eum in nave non necavi?"

# game/a1s1.rpy:1575
translate latin a1s1_04f18c2a:

    # "For agreeing to help him become emperor?"
    "Quia consensi eum iuvare ut imperator fiat?"

# game/a1s1.rpy:1576
translate latin a1s1_7c78f5b9:

    # "For the way I took this shitty sofa and flimsy blanket without complaint?"
    "Quia hunc pessimum lectum recubitorium et tenue stragulum sine querela accepi?"

# game/a1s1.rpy:1577
translate latin a1s1_90dc5502:

    # "I'm not sure, so all I say is:"
    "Incertus sum, itaque tantum dico:"

# game/a1s1.rpy:1578
translate latin a1s1_910f899d:

    # m "\"Sure.\""
    m "\"Sane.\""

# game/a1s1.rpy:1579
translate latin a1s1_098fa350:

    # "Then I hear the wolf snoring softly and the lights suddenly dim down until they're off."
    "Tum lupum leviter stertentem audio, et lumina subito obscurantur, donec exstincta sunt."

# game/a1s1.rpy:1582
translate latin a1s1_95d6b7d6:

    # "I lay there a while, though I'm not sure for how long."
    "Aliquamdiu ibi iaceo, sed quam diu nescio."

# game/a1s1.rpy:1583
translate latin a1s1_4d9868cc:

    # "In fact, time seems to have lost all meaning since I was abducted."
    "Re vera tempus omnem sensum amisisse videtur ex quo raptus sum."

# game/a1s1.rpy:1584
translate latin a1s1_5a20cc71:

    # "Amicus's brother said it had been two days, but didn't Amicus say that time freezes when traveling in the Stretch Drive?"
    "Frater Amici duos dies praeteriisse dixit, sed nonne Amicus dixit tempus consistere cum Propulsore Distensionis vehamur?"

# game/a1s1.rpy:1585
translate latin a1s1_73eec06f:

    # "Had we really spent that much time idling around?"
    "Re verane tantum temporis otiosi consumpsimus?"

# game/a1s1.rpy:1586
translate latin a1s1_2e9eaf01:

    # "I need to stop thinking about everything that doesn't make sense...because that's basically everything."
    "Desinere debeo de omnibus cogitare quae sensu carent... quia fere omnia talia sunt."

# game/a1s1.rpy:1587
translate latin a1s1_2165491e:

    # "I just need to help this wolf so I can get the hell back home."
    "Tantum hunc lupum iuvare debeo, ut tandem, malum, domum redire possim."

# game/a1s1.rpy:1588
translate latin a1s1_5d07c304:

    # "Then I can pick apart everything I've been through all I want."
    "Tum omnia quae passus sum quantum voluero examinare potero."

# game/a1s1.rpy:1589
translate latin a1s1_8da8f1cd:

    # "For now I just need to help things move along as smoothly as possible."
    "Nunc tantum curandum est ut res quam facillime procedant."

# game/a1s1.rpy:1590
translate latin a1s1_40f74d8a:

    # "With that thought in my head, and with the soft sounds of Amicus's gentle snoring, I'm lulled into a light and troubled sleep."
    "Hac cogitatione animum occupante et levi sono Amici placide stertentis, in somnum tenuem inquietumque delabor."

