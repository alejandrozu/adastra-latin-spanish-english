
# game/a2s3.rpy:2
translate latin a2s3_2e56e6d9:

    # "Behind me..."
    "Post me..."

# game/a2s3.rpy:3
translate latin a2s3_2d0ee2da:

    # "There is no \"behind me\" because I don't have a body anymore."
    "Nullum est \"post me\", quia corpus iam non habeo."

# game/a2s3.rpy:4
translate latin a2s3_9fcec8f9:

    # "Instead, the feeling creeps just outside of my awareness."
    "Sensus potius paulo extra conscientiam meam insinuatur."

# game/a2s3.rpy:5
translate latin a2s3_8424101f:

    # "Whenever I try to focus on it, it slips away."
    "Quoties ei animum intendere conor, elabitur."

# game/a2s3.rpy:6
translate latin a2s3_c5efb80b:

    # "So instead I just let it go, floating in space, feeling almost nothing."
    "Ita eum dimitto, per spatium fluctuans ac paene nihil sentiens."

# game/a2s3.rpy:7
translate latin a2s3_e74765a9:

    # "And feeling nothing right now, after everything, feels good."
    "Nihil autem nunc, post omnia, sentire iucundum est."

# game/a2s3.rpy:8
translate latin a2s3_4666fda3:

    # "But after a moment, I start to get vague, far-off feelings."
    "Sed paulo post vagos remotosque affectus percipere incipio."

# game/a2s3.rpy:9
translate latin a2s3_6857104c:

    # "Not my own feelings, but the feelings of others, and I pick them up like distant whispers."
    "Non meos affectus, sed aliorum, quos velut longinquos susurros percipio."

# game/a2s3.rpy:10
translate latin a2s3_bd5e49c1:

    # "\"We've interfered far too much already.\""
    "\"Iam multo nimis intervenimus.\""

# game/a2s3.rpy:11
translate latin a2s3_66ead535:

    # "\"Nothing goes to plan with the wolves. It must be done...\""
    "\"Cum lupis nihil ex consilio procedit. Faciendum est...\""

# game/a2s3.rpy:12
translate latin a2s3_054f2c18:

    # "I'm only half-listening, coasting on the waves of soothing, empty space."
    "Dimidio tantum animo audio, per lenientis vacuique spatii undas vectus."

# game/a2s3.rpy:13
translate latin a2s3_db10d9a5:

    # "If this is how the drug makes you feel, I'm pretty into it."
    "Si medicamentum talem sensum affert, mihi valde placet."

# game/a2s3.rpy:14
translate latin a2s3_eafda6cc:

    # "\"The more we interfere the harder it will be to predict anything.\""
    "\"Quo magis intervenimus, eo difficilius erit quidquam praedicere.\""

# game/a2s3.rpy:15
translate latin a2s3_6a881e53:

    # "\"There is no other choice.\""
    "\"Nulla alia optio est.\""

# game/a2s3.rpy:16
translate latin a2s3_7c1eb45c:

    # "The voice-feelings cease at that point, and I continue to ripple on the waves of the universe."
    "Tum voces atque affectus cessant; ego per universi undas fluctuare pergo."

# game/a2s3.rpy:17
translate latin a2s3_4e8fa7ea:

    # "That's when I notice something appearing in the center of my infinite space."
    "Tum aliquid in medio spatio meo infinito apparere video."

# game/a2s3.rpy:19
translate latin a2s3_1e350b05:

    # "I've...seen this thing before...I think."
    "Hanc rem...antea vidi...ut puto."

# game/a2s3.rpy:20
translate latin a2s3_078635c2:

    # "Dreams that had fled my mind the moment I'd woken up suddenly come flooding back."
    "Somnia quae simul ac evigilaveram ex animo fugerant subito memoria redeunt."

# game/a2s3.rpy:21
translate latin a2s3_867e541d:

    # "I focus on this being, this creature that's been following me since I was abducted."
    "Huic enti animum intendo, creaturae quae me ex quo raptus sum secuta est."

# game/a2s3.rpy:22
translate latin a2s3_85642ea2:

    # "He looms there, staring at me, even though I'm everywhere at once."
    "Ille magnus ibi adest meque intuetur, quamquam ego ubique simul sum."

# game/a2s3.rpy:23
translate latin a2s3_b93b5446:

    # "The silence goes on for a while...or maybe not."
    "Silentium aliquantisper manet...aut fortasse non."

# game/a2s3.rpy:24
translate latin a2s3_25301166:

    # "I still don't have any sense of time."
    "Temporis sensum adhuc nullum habeo."

# game/a2s3.rpy:25
translate latin a2s3_c1502248:

    # "That is until the creature speaks."
    "Donec creatura loquitur."

# game/a2s3.rpy:27
translate latin a2s3_6db03bd5:

    # unk "\"[mc].\""
    unk "\"[mc].\""

# game/a2s3.rpy:28
translate latin a2s3_47816b5e:

    # "The voice is deep and masculine, rumbling through my being."
    "Vox gravis virilisque est, per totam essentiam meam resonans."

# game/a2s3.rpy:29
translate latin a2s3_2ff8dc86:

    # "I wait a moment, then try to acknowledge him, made difficult by the fact that I don't have a mouth to speak with."
    "Paulisper exspecto, deinde eum agnoscere conor; difficile est, quia os quo loquar non habeo."

# game/a2s3.rpy:30
translate latin a2s3_d3da1ea5:

    # unk "\"If you wish to communicate then do so. I can hear you.\""
    unk "\"Si communicare vis, fac. Audire te possum.\""

# game/a2s3.rpy:31
translate latin a2s3_41578c0b:

    # "\"What?\""
    "\"Quid?\""

# game/a2s3.rpy:32
translate latin a2s3_7b718084:

    # "I try to think the word at him, but it's slow and clumsy in my mind, and I just wish that I could talk."
    "Verbum ei cogitatione mittere conor, sed in animo meo tardum atque inconcinnum est; loqui tantum posse cupio."

# game/a2s3.rpy:33
translate latin a2s3_ef50485a:

    # "There's a rumble of amusement through the air."
    "Risus quidam per aerem resonat."

# game/a2s3.rpy:34
translate latin a2s3_319344a4:

    # unk "\"If you desire a body, simply will it to be. The loss of self is a disturbing feeling for you creatures, I know.\""
    unk "\"Si corpus desideras, tantum velis ut sit. Scio sui ipsius iacturam vos perturbare.\""

# game/a2s3.rpy:35
translate latin a2s3_3475e454:

    # "What he's saying doesn't make all that much sense, but I try anyway, and just like that, I feel my being start to pull together."
    "Quae dicit parum intellego, sed tamen conor; statim essentiam meam in unum contrahi sentio."

# game/a2s3.rpy:36
translate latin a2s3_74bad230:

    # "I start to materialize right in front of the creature, and I see my hands in front of myself again."
    "Recta ante creaturam corpore apparere incipio atque manus meas rursus ante me video."

# game/a2s3.rpy:37
translate latin a2s3_fe7405ca:

    # "When I look down, I see my body, naked."
    "Cum despicio, corpus meum nudum video."

# game/a2s3.rpy:38
translate latin a2s3_aff7e4b2:

    # "As soon as I see that, I feel a shock of embarrassment, and my robe suddenly appears on my body."
    "Simul ac id video, pudore percellor, atque vestis subito corpori meo apparet."

# game/a2s3.rpy:39
translate latin a2s3_5b19ce2e:

    # "I still don't feel right, like I'm still not in this body that I see."
    "Adhuc non recte me habeo, velut in hoc corpore quod video nondum sim."

# game/a2s3.rpy:40
translate latin a2s3_a47d0f02:

    # "Still, it does feel better, and I'm able to open my mouth."
    "Tamen melius est, atque os aperire possum."

# game/a2s3.rpy:41
translate latin a2s3_c2d19494:

    # m "\"What is this?\""
    m "\"Quid est hoc?\""

# game/a2s3.rpy:42
translate latin a2s3_ae5159c1:

    # "My mouth feels strange and rubbery, and at the same time it feels like cotton is coating the inside."
    "Os mirum ac gummi simile sentitur, simulque velut intus lana gossypina tectum sit."

# game/a2s3.rpy:43
translate latin a2s3_6c2a3d0c:

    # unk "\"This is...\""
    unk "\"Hoc est...\""

# game/a2s3.rpy:44
translate latin a2s3_a1af0e1d:

    # "For the first time, the creature seems unsure of what he should say."
    "Primum creatura quid dicere debeat incerta videtur."

# game/a2s3.rpy:45
translate latin a2s3_1ae033dd:

    # unk "\"Well, it's a bit complicated to explain, but it's simply a space where you and I might be able to communicate peacefully."
    unk "\"Aliquantum difficile est explicare; sed tantum spatium est ubi tu et ego placide communicare possumus."

# game/a2s3.rpy:46
translate latin a2s3_7791008c:

    # "That's not really an answer."
    "Id non verum responsum est."

# game/a2s3.rpy:47
translate latin a2s3_0a2cc1a2:

    # unk "\"No, but if I were to explain it in-depth, it would waste the small amount of time we have together and confuse you even further.\""
    unk "\"Non; sed si penitus explicarem, breve tempus quod una habemus consumerem teque magis etiam confunderem.\""

# game/a2s3.rpy:48
translate latin a2s3_2003d2f3:

    # "I try to stay focused, wanting to know as much about this guy as I can before the drug wears off."
    "Animum intentum servare conor, quantum possum de hoc viro cognoscere cupiens antequam medicamenti vis desinat."

# game/a2s3.rpy:49
translate latin a2s3_0707f63b:

    # m "\"You're a parent?\""
    m "\"Esne Parens?\""

# game/a2s3.rpy:50
translate latin a2s3_1238f0c9:

    # "That rumbling laughter tickles at the edge of my existence again."
    "Risus ille rursus in finibus essentiae meae titillat."

# game/a2s3.rpy:51
translate latin a2s3_6848f276:

    # unk "\"No, definitely not. I am a monitor.\""
    unk "\"Non, minime. Monitor sum.\""

# game/a2s3.rpy:52
translate latin a2s3_18956410:

    # "Monitor."
    "Monitor."

# game/a2s3.rpy:53
translate latin a2s3_c59db4f7:

    # "Icy fear trickles down my imagined spine as I realize what this all might mean."
    "Glacialis metus per spinam quam mihi fingo fluit, cum intellego quid haec omnia significare possint."

# game/a2s3.rpy:54
translate latin a2s3_10e9a801:

    # "The monitor quickly holds up a paw."
    "Monitor celeriter manum tollit."

# game/a2s3.rpy:55
translate latin a2s3_b6ffdd9f:

    # mon "\"No, no, don't worry. You're not in trouble.\""
    mon "\"Non, non; noli timere. In nulla culpa es.\""

# game/a2s3.rpy:56
translate latin a2s3_8f2cc6ad:

    # "I watch him cautiously, as if he's only lulling me into a false sense of security before annihilating me on the spot."
    "Eum caute observo, velut falsa securitate me sopiat antequam statim deleat."

# game/a2s3.rpy:57
translate latin a2s3_4bdc7545:

    # "Again, that feeling of amusement."
    "Rursus hilaritatem illam sentio."

# game/a2s3.rpy:58
translate latin a2s3_cd47d5d1:

    # mon "\"Now that would be impossible to do here.\""
    mon "\"Id quidem hic facere impossibile esset.\""

# game/a2s3.rpy:59
translate latin a2s3_e303116c:

    # "I try to keep my thoughts focused."
    "Cogitationes meas intentas tenere conor."

# game/a2s3.rpy:60
translate latin a2s3_c58b8321:

    # m "\"What about Amicus? Is he in trouble?\""
    m "\"Quid de Amico? Num ille in culpa est?\""

# game/a2s3.rpy:61
translate latin a2s3_0f8637cd:

    # mon "\"No. He only did what we had planned for him to do.\""
    mon "\"Non. Id tantum fecit quod ei faciendum destinaveramus.\""

# game/a2s3.rpy:62
translate latin a2s3_21c64e60:

    # m "\"Planned?\""
    m "\"Destinaveratis?\""

# game/a2s3.rpy:63
translate latin a2s3_e6567a05:

    # "There's a pause, as if the monitor is gathering his thoughts."
    "Paulum tacet, velut Monitor cogitationes suas colligat."

# game/a2s3.rpy:64
translate latin a2s3_ab7d06d0:

    # mon "\"No, I'm simply receiving instructions.\""
    mon "\"Non, mandata tantum accipio.\""

# game/a2s3.rpy:65
translate latin a2s3_6d813ddb:

    # m "\"From?\""
    m "\"A quibus?\""

# game/a2s3.rpy:66
translate latin a2s3_69702861:

    # mon "\"The parents.\""
    mon "\"A Parentibus.\""

# game/a2s3.rpy:67
translate latin a2s3_e3a5312e:

    # "I stare at him."
    "Eum fixis oculis intueor."

# game/a2s3.rpy:68
translate latin a2s3_0f2606e1:

    # m "\"They're talking to you?\""
    m "\"Tecum loquuntur?\""

# game/a2s3.rpy:69
translate latin a2s3_417de913:

    # mon "\"Yes, about you and what I can and cannot tell you.\""
    mon "\"Ita, de te et de iis quae tibi dicere possum vel non possum.\""

# game/a2s3.rpy:70
translate latin a2s3_e28421cc:

    # m "\"Why don't {i}they{/i} just talk to me then?\""
    m "\"Cur igitur {i}ipsi{/i} mecum non loquuntur?\""

# game/a2s3.rpy:71
translate latin a2s3_e691c5cd:

    # mon "\"Because they cannot. Direct communication is impossible.\""
    mon "\"Quia nequeunt. Directa communicatio impossibilis est.\""

# game/a2s3.rpy:72
translate latin a2s3_4d73dc43:

    # m "\"Then how—\""
    m "\"Tum quomodo—\""

# game/a2s3.rpy:73
translate latin a2s3_820fcbad:

    # mon "\"I was specifically designed to be a bridge between your...let's say dimension, and theirs.\""
    mon "\"Creatus sum ut pons essem inter vestram...dicamus dimensionem, et ipsorum.\""

# game/a2s3.rpy:74
translate latin a2s3_1a01ea41:

    # "I don't really know what to think about that, but I get the feeling that I shouldn't be distracted by these things right now."
    "Quid de hac re sentiam nescio; sed sentio me his rebus nunc distrahi non debere."

# game/a2s3.rpy:75
translate latin a2s3_87b39766:

    # mon "\"That would be wise.\""
    mon "\"Id prudens esset.\""

# game/a2s3.rpy:76
translate latin a2s3_8086576c:

    # m "\"So what do you mean 'planned'? The parents set Amicus up somehow?\""
    m "\"Quid igitur significat 'destinaveratis'? Num Parentes res Amico quodam modo paraverunt?\""

# game/a2s3.rpy:77
translate latin a2s3_80bdddc4:

    # mon "\"Your abduction and introduction to the wolven empire was meant to happen.\""
    mon "\"Raptus tuus atque introductio in imperium Luporum evenire debebant.\""

# game/a2s3.rpy:78
translate latin a2s3_fdcfd18e:

    # m "\"Why?\""
    m "\"Cur?\""

# game/a2s3.rpy:79
translate latin a2s3_52229fd7:

    # "Another slight pause."
    "Alia brevis mora."

# game/a2s3.rpy:80
translate latin a2s3_592336d1:

    # mon "\"The wolves could single-handedly undo the {i}Galaxias{/i}, but you can change that.\""
    mon "\"Lupi soli {i}Galaxias{/i} dissolvere possunt; tu tamen id mutare potes.\""

# game/a2s3.rpy:81
translate latin a2s3_a0d83c4e:

    # "I frown, feeling some anxiety slip through the drug-induced calm."
    "Frontem contraho, paulum anxietatis per tranquillitatem medicamento allatam sentiens."

# game/a2s3.rpy:82
translate latin a2s3_70a1eda3:

    # m "\"What? How?\""
    m "\"Quid? Quomodo?\""

# game/a2s3.rpy:83
translate latin a2s3_0d2dc043:

    # mon "\"The wolves are...a stubborn sibling, possibly a mistake made at the very beginning, but the parents can still see the correct path and destination.\""
    mon "\"Lupi...Frater obstinatus sunt, fortasse error ipso initio factus; sed Parentes rectam viam metamque adhuc videre possunt.\""

# game/a2s3.rpy:84
translate latin a2s3_26d69e3b:

    # m "\"See? Can they see the future, or something?\""
    m "\"Videre? Num futura vident, an quid tale?\""

# game/a2s3.rpy:85
translate latin a2s3_4c8dd750:

    # mon "\"In a way, yes. Their minds exist in many times at once.\""
    mon "\"Quodam modo, ita. Mentes eorum pluribus temporibus simul exstant.\""

# game/a2s3.rpy:86
translate latin a2s3_d7e2ebce:

    # "I'm starting to become lost and suddenly, I begin to feel like a primitive life-form, incapable of understanding this ancient, alien monolith before me."
    "Confundi incipio; subito velut rudis vitae forma mihi videor, quae antiquum illum alienumque monolithum ante me intellegere nequeat."

# game/a2s3.rpy:87
translate latin a2s3_8a7468ec:

    # mon "\"Do not feel that way. You yourself may not understand, but your species as a whole is more than capable.\""
    mon "\"Noli ita sentire. Tu ipse fortasse non intellegis, sed species tua universa plane capax est.\""

# game/a2s3.rpy:88
translate latin a2s3_dd391805:

    # "My mind automatically thinks back to how we were abandoned by the wolves, by maybe even the jackals too."
    "Animus meus sponte repetit quomodo a lupis, fortasse etiam a chacalis, relicti simus."

# game/a2s3.rpy:89
translate latin a2s3_d6e52837:

    # mon "\"You were abandoned by all the siblings.\""
    mon "\"Ab omnibus Fratribus relicti estis.\""

# game/a2s3.rpy:90
translate latin a2s3_871ccb49:

    # "For a single moment, multiple images of several different creatures cross my mind; a bear, a wolf, a jackal, a lion, a ram..."
    "Uno momento complura imaginum variarum creaturarum per animum meum transeunt: ursus, lupus, chacalus, leo, aries..."

# game/a2s3.rpy:91
translate latin a2s3_fa8b478f:

    # "They're all recognizable, and what they wear is recognizable too, reminding me of several different cultures on Earth."
    "Omnes agnosci possunt, et vestes quoque agnosco, quae varios Terrae cultus mihi in memoriam revocant."

# game/a2s3.rpy:92
translate latin a2s3_ce2e65c0:

    # "The images finally stop on a tiger in a flowing dress with intricate designs and patterns, and what looks like a sari draped over her shoulder."
    "Imagines tandem in tigride consistunt, veste fluente, exquisitis ornamentis formisque induta, et quod sari esse videtur per umerum demisso."

# game/a2s3.rpy:93
translate latin a2s3_f12d0bf1:

    # "As the image fades from my mind, somehow I know immediately that it's Meera."
    "Cum imago ex animo meo evanescit, statim quodam modo scio Meeram esse."

# game/a2s3.rpy:94
translate latin a2s3_d155c615:

    # mon "\"Yes, we reigned in the wolves once before with the help of the Hindos, but it lasted for a far shorter period of time than we'd foreseen. That's why we've turned to you, to play her ancient role.\""
    mon "\"Lupos iam olim auxilio Hindorum coercuimus, sed multo brevius mansit quam praevideramus. Ideo ad te conversi sumus, ut antiquam eius personam agas.\""

# game/a2s3.rpy:95
translate latin a2s3_7238d718:

    # m "\"But...we're not part of the {i}Galaxias{/i}. Everyone failed at uplifting us, so isn't something wrong with us?\""
    m "\"Sed...non ad {i}Galaxias{/i} pertinemus. Omnes nos provehere frustra conati sunt; num igitur aliquid in nobis vitii est?\""

# game/a2s3.rpy:96
translate latin a2s3_156a8c4f:

    # "Another pause."
    "Alia mora."

# game/a2s3.rpy:97
translate latin a2s3_797d26d5:

    # mon "\"In a way, yes, but after the attempts, all of the parents realized that humans would factor into the {i}Galaxias{/i} later...now.\""
    mon "\"Quodam modo, ita; sed post conatus omnes Parentes intellexerunt homines postea ad {i}Galaxias{/i} pertinere debere...nunc.\""

# game/a2s3.rpy:98
translate latin a2s3_85ba7560:

    # m "\"All? Aren't the parents competing with each other?\""
    m "\"Omnes? Nonne Parentes inter se certant?\""

# game/a2s3.rpy:99
translate latin a2s3_5fe0e287:

    # "This time I only get silence in response."
    "Hoc tempore silentium tantum pro responso accipio."

# game/a2s3.rpy:100
translate latin a2s3_32b181b3:

    # "I wonder if he's just been told that he can't tell me that."
    "Quaero an modo iussus sit mihi rem non dicere."

# game/a2s3.rpy:101
translate latin a2s3_e8e25570:

    # m "\"So...what am I supposed to do? What do you want with me?\""
    m "\"Quid igitur...facere debeo? Quid a me vultis?\""

# game/a2s3.rpy:102
translate latin a2s3_64a0c5ed:

    # "The answer this time is immediate."
    "Hoc tempore responsum statim datur."

# game/a2s3.rpy:103
translate latin a2s3_dc5c8b76:

    # mon "\"Restore Amicus to his rightful place on the throne.\""
    mon "\"Amicum ad iustum suum locum in solio restitue.\""

# game/a2s3.rpy:104
translate latin a2s3_94255d80:

    # "I wait, but there isn't any other explanation."
    "Exspecto, sed nihil aliud explicatur."

# game/a2s3.rpy:106
translate latin a2s3_9399816c:

    # m "\"And...how do I do that?\""
    m "\"Et...quomodo id faciam?\""

# game/a2s3.rpy:107
translate latin a2s3_16b8cb94:

    # "Silence."
    "Silentium."

# game/a2s3.rpy:108
translate latin a2s3_9b1e5155:

    # m "\"Why me?\""
    m "\"Cur ego?\""

# game/a2s3.rpy:109
translate latin a2s3_486859e8:

    # "More silence."
    "Plus silentii."

# game/a2s3.rpy:110
translate latin a2s3_5bfdce14:

    # "I blow out air in frustration, or try to since nothing comes out."
    "Aerem iratus efflare conor; nihil tamen exit."

# game/a2s3.rpy:111
translate latin a2s3_77f8545c:

    # m "\"Why can't you all just {i}tell{/i} me what to do? You brought me here, didn't you? Just tell me.\""
    m "\"Cur mihi tantum {i}dicere{/i} non potestis quid faciam? Vos me huc adduxistis, nonne? Dicite tantum.\""

# game/a2s3.rpy:112
translate latin a2s3_9850f53c:

    # "Nothing."
    "Nihil."

# game/a2s3.rpy:113
translate latin a2s3_92296a2b:

    # "I'm about to just give up, wait out the trip when the monitor begins speaking again."
    "Iam cedere et medicamenti effectum praeterire exspectare volo, cum Monitor rursus loqui incipit."

# game/a2s3.rpy:114
translate latin a2s3_d42f9c47:

    # mon "\"Interference often leads to destabilization of the events that should follow. The {i}Galaxias{/i} must develop and learn in its own way.\""
    mon "\"Interventus saepe ordinem eorum quae sequi debent perturbat. {i}Galaxias{/i} suo modo crescere atque discere debet.\""

# game/a2s3.rpy:115
translate latin a2s3_0d1a0de0:

    # m "\"Except for now, right? This is interfering, isn't it?\""
    m "\"Praeter nunc, nonne? Hoc interventus est, nonne?\""

# game/a2s3.rpy:116
translate latin a2s3_786fb9c0:

    # mon "\"Except for in various instances where the children and siblings stray too far off course.\""
    mon "\"Praeter varia tempora quibus Liberi Fratresque nimis longe a via declinant.\""

# game/a2s3.rpy:117
translate latin a2s3_9a8bcdb8:

    # "This time I'm the one left unsure of what to say."
    "Hoc tempore ego quid dicere debeam nescio."

# game/a2s3.rpy:118
translate latin a2s3_00f46889:

    # "I'd always seen the parents as all-knowing beings with only good intentions for their children, but now..."
    "Parentes semper omnia scientes putaveram, qui tantum bonum Liberis suis vellent; nunc autem..."

# game/a2s3.rpy:119
translate latin a2s3_807a397a:

    # "How do I know they can even be trusted?"
    "Quomodo scio eis omnino confidi posse?"

# game/a2s3.rpy:120
translate latin a2s3_84d6ec58:

    # "What I do know is that the monitor is apparently able to hear all my thoughts, so he definitely heard that."
    "Hoc tamen scio: Monitor omnes cogitationes meas audire posse videtur, itaque certe illam audivit."

# game/a2s3.rpy:121
translate latin a2s3_c2997c7d:

    # "Still, he doesn't say anything, just regarding me silently."
    "Tamen nihil dicit, tantum me tacitus observans."

# game/a2s3.rpy:122
translate latin a2s3_db9027ae:

    # m "\"So...I guess you can't tell me what the purpose of all of this is, then? The {i}Galaxias{/i} as a whole?\""
    m "\"Puto igitur te mihi dicere non posse cuius rei causa haec omnia sint? Universa {i}Galaxias{/i}?\""

# game/a2s3.rpy:123
translate latin a2s3_c4bd107d:

    # mon "\"That knowledge has not been earned by the sapients yet.\""
    mon "\"Sapientes eam scientiam nondum meruerunt.\""

# game/a2s3.rpy:124
translate latin a2s3_7a7f80f4:

    # "My mistrust grows."
    "Diffidentia mea crescit."

# game/a2s3.rpy:125
translate latin a2s3_169e12b2:

    # m "\"Well...can you give me something, {i}anything{/i} that might help me with getting Amicus out of the dungeon? If I'm straying off the course then tell me how to get back on it.\""
    m "\"Potesne mihi aliquid, {i}quidquam{/i} dare quod ad Amicum e carcere liberandum prosit? Si a via aberro, dic quomodo in eam redeam.\""

# game/a2s3.rpy:126
translate latin a2s3_ae3283b7:

    # "The monitor pauses for a moment, as if getting more information from the parents."
    "Monitor paulisper tacet, velut plura a Parentibus discat."

# game/a2s3.rpy:127
translate latin a2s3_fecefe41:

    # mon "\"Watch the cat.\""
    mon "\"Felem observa.\""

# game/a2s3.rpy:128
translate latin a2s3_8374eeb7:

    # "The cat."
    "Felem."

# game/a2s3.rpy:129
translate latin a2s3_2a2df911:

    # m "\"Alexios?\""
    m "\"Alexios?\""

# game/a2s3.rpy:130
translate latin a2s3_810a73bf:

    # "I wait, but again I get silence."
    "Exspecto, sed rursus silentium accipio."

# game/a2s3.rpy:131
translate latin a2s3_6a20a80d:

    # "I shake my head."
    "Caput quatio."

# game/a2s3.rpy:132
translate latin a2s3_f7d17162:

    # "If the parents really are all-knowing and all-powerful, then why can't they just tell me—"
    "Si Parentes vere omnia sciunt atque omnia possunt, cur mihi tantum dicere nequeunt—"

# game/a2s3.rpy:133
translate latin a2s3_66fa897a:

    # mon "\"We are neither of these things, hence why we must be so careful.\""
    mon "\"Neutrum sumus; ideo tanta cautione uti debemus.\""

# game/a2s3.rpy:134
translate latin a2s3_9d5b8253:

    # "I just stand there, unsure of what else to do."
    "Ibi tantum sto, nesciens quid aliud faciam."

# game/a2s3.rpy:135
translate latin a2s3_02513e4d:

    # "I look around."
    "Circumspicio."

# game/a2s3.rpy:136
translate latin a2s3_31f27818:

    # m "\"Is uh, is Cassius alright?\""
    m "\"Estne, hem, Cassius bene?\""

# game/a2s3.rpy:137
translate latin a2s3_2b056f1f:

    # mon "\"The false emperor? Yes, he's somewhere around here.\""
    mon "\"Falsus imperator? Est quidem; alicubi circa nos est.\""

# game/a2s3.rpy:138
translate latin a2s3_d3acc7e5:

    # "The monitor looks about dismissively."
    "Monitor neglegenter circumspicit."

# game/a2s3.rpy:139
translate latin a2s3_a70d69f1:

    # m "\"Did he hear us?\""
    m "\"Num nos audivit?\""

# game/a2s3.rpy:140
translate latin a2s3_2a5220f9:

    # mon "\"No, he's too busy panicking. A side-effect of being a coward imposter.\""
    mon "\"Non; nimis timendo occupatus est. Hoc ignavis impostoribus accidit.\""

# game/a2s3.rpy:141
translate latin a2s3_c000bb8e:

    # "I frown, feeling that's a bit harsh, even on someone like Cassius."
    "Frontem contraho; paulo acerbius esse sentio, etiam in eum qui Cassius est."

# game/a2s3.rpy:142
translate latin a2s3_7d5f75c2:

    # m "\"Can you...can you help him, maybe bring him here?\""
    m "\"Potesne...eum adiuvare, fortasse huc adducere?\""

# game/a2s3.rpy:143
translate latin a2s3_ce014a87:

    # "I get a feeling from the monitor that I can only describe as an annoyed sigh."
    "A Monitore sensum accipio quem tantum suspirium molestum describere possum."

# game/a2s3.rpy:144
translate latin a2s3_95dab2d7:

    # mon "\"I suppose.\""
    mon "\"Puto posse.\""

# game/a2s3.rpy:145
translate latin a2s3_474309d5:

    # "A few moments pass before I start to see something appear next to me."
    "Post pauca momenta aliquid iuxta me apparere incipit."

# game/a2s3.rpy:147
translate latin a2s3_5a414fc1:

    # "The unmistakable shape of Cassius materializes, frightened and shaking."
    "Forma Cassii facile agnoscenda apparet, territa atque tremens."

# game/a2s3.rpy:148
translate latin a2s3_5648e05a:

    # "He immediately sees me."
    "Statim me videt."

# game/a2s3.rpy:150
translate latin a2s3_688b3c80:

    # c "\"[mc]!? Where are we? What's happened? Are you—\""
    c "\"[mc]!? Ubi sumus? Quid accidit? Esne—\""

# game/a2s3.rpy:151
translate latin a2s3_02bf1091:

    # "Then he sees the monitor."
    "Deinde Monitorem videt."

# game/a2s3.rpy:153
translate latin a2s3_0c05a9bf:

    # c "\"Agh!\""
    c "\"Ah!\""

# game/a2s3.rpy:154
translate latin a2s3_13537808:

    # "He jumps behind me, shielding himself from the creature."
    "Post me salit, se a creatura protegens."

# game/a2s3.rpy:155
translate latin a2s3_1808daf1:

    # c "\"The demon! Help me!\""
    c "\"Daemon! Adiuva me!\""

# game/a2s3.rpy:156
translate latin a2s3_c1a58595:

    # "I get that feeling of amusement from the dragon creature again, and I frown."
    "Rursus hilaritatem ex creatura draconina sentio atque frontem contraho."

# game/a2s3.rpy:157
translate latin a2s3_bb5d41bd:

    # m "\"Have you been scaring him?\""
    m "\"Num eum terrebas?\""

# game/a2s3.rpy:158
translate latin a2s3_16f93144:

    # "I get the feeling of a shrug from the creature."
    "Sensum umerorum attollendorum a creatura accipio."

# game/a2s3.rpy:159
translate latin a2s3_e8225aa7:

    # mon "\"If he's scared that's his choice.\""
    mon "\"Si timet, ipse elegit.\""

# game/a2s3.rpy:160
translate latin a2s3_7e7eed74:

    # m "\"And the parents are okay with you doing that?\""
    m "\"Et Parentes id te facere approbant?\""

# game/a2s3.rpy:161
translate latin a2s3_c08ba5e9:

    # mon "\"Possibly not, but the white wolf means little to them.\""
    mon "\"Fortasse non; sed albus lupus eis parum valet.\""

# game/a2s3.rpy:163
translate latin a2s3_fb70ab3e:

    # c "\"What?\""
    c "\"Quid?\""

# game/a2s3.rpy:164
translate latin a2s3_a9684113:

    # "That seems to get Cassius's attention, and he pokes his head around my side to glare at the monitor."
    "Id Cassium attendere facere videtur: caput circa latus meum profert ut Monitorem truculenter aspiciat."

# game/a2s3.rpy:165
translate latin a2s3_06b24b95:

    # ca "\"E-excuse me, but I am the emperor—\""
    ca "\"I—ignosce, sed imperator sum—\""

# game/a2s3.rpy:166
translate latin a2s3_024a03ea:

    # mon "\"No, you are not.\""
    mon "\"Non, non es.\""

# game/a2s3.rpy:167
translate latin a2s3_91076a2c:

    # "I frown, the scene growing more and more surreal before me."
    "Frontem contraho; res ante me magis magisque a vera vita aliena videtur."

# game/a2s3.rpy:169
translate latin a2s3_1ddc86d2:

    # c "\"Excuse me!?\""
    c "\"Quid dicis!?\""

# game/a2s3.rpy:171
translate latin a2s3_a2a6a5df:

    # "Cassius seems unable to think of anything else to say."
    "Cassius quid aliud dicere possit invenire nequit."

# game/a2s3.rpy:172
translate latin a2s3_422db174:

    # "Just as I'm about to step between the two of them, I find myself unable to hold my consciousness together any longer and I begin to drift off..."
    "Cum inter ambos ingredi paror, conscientiam meam diutius continere nequeo atque evanescere incipio..."

# game/a2s3.rpy:175
translate latin a2s3_5b6b3f6b:

    # "Slowly, I come to on the sofa, my eyes cracking open as I wince at the throbbing headache I have."
    "Lente in lecto molli ad me redeo, oculis paulum apertis, dum propter pulsantem capitis dolorem vultum contraho."

# game/a2s3.rpy:176
translate latin a2s3_5249355a:

    # "There's a cold sensation around my mouth and I reach up to feel that I've been drooling all over myself."
    "Frigus circa os sentio; manum tollo et intellego salivam per me fluere passum esse."

# game/a2s3.rpy:177
translate latin a2s3_9b14a9d3:

    # "I roll over, feeling a wave of dizziness as I do."
    "In latus me verto atque vertiginis impetum sentio."

# game/a2s3.rpy:178
translate latin a2s3_8a0d55cc:

    # "I pause there, waiting for the wooziness to pass."
    "Ibi maneo, vertiginem praeterire exspectans."

# game/a2s3.rpy:179
translate latin a2s3_c6ab2354:

    # "When it finally does, I'm able to focus better on my surroundings."
    "Cum tandem praeterit, melius quae circum me sunt attendere possum."

# game/a2s3.rpy:180
translate latin a2s3_78051807:

    # "I stare a full ten seconds before I remember where I am, and what I'm doing there."
    "Decem plena secunda intueor antequam memini ubi sim et quid hic agam."

# game/a2s3.rpy:181
translate latin a2s3_c3359226:

    # "I look over at the bed and see Cassius lying spread-eagle on the covers, his eyes fluttering."
    "Ad lectum aspicio et Cassium in stragulis expansum iacentem video, oculis palpitantibus."

# game/a2s3.rpy:182
translate latin a2s3_d2616c92:

    # "I watch him for a while, realizing that he's still unconscious."
    "Eum aliquantisper observo, intellegens adhuc inscium esse."

# game/a2s3.rpy:183
translate latin a2s3_0c37fe87:

    # "He did take in a lot more of the drug than I had, so I guess that makes sense."
    "Multo plus medicamenti quam ego sumpserat, itaque hoc rationem habet."

# game/a2s3.rpy:184
translate latin a2s3_b524dd81:

    # "Very slowly, I slide my legs off of the sofa and sit there as a second dizzy spell overtakes me."
    "Lentissime crura e lecto molli demitto atque ibi sedeo, dum secundus vertiginis impetus me corripit."

# game/a2s3.rpy:185
translate latin a2s3_20d4865f:

    # "I wait a solid minute for this one to pass so that when I stand up I don't end up just falling over."
    "Plenum minutum exspecto dum praeterit, ne surgens statim corruam."

# game/a2s3.rpy:186
translate latin a2s3_991cd81c:

    # "When I'm able to do that, I stumble to the bathroom, feeling more and more clear-headed by the second."
    "Cum id facere possum, ad balneum titubo, animo singulis momentis clariore facto."

# game/a2s3.rpy:189
translate latin a2s3_7bf77408:

    # "When I get to the sink, I rest there, staring at myself in the mirror."
    "Ad labrum perveniens ibi quiesco meque in speculo intueor."

# game/a2s3.rpy:190
translate latin a2s3_f8110bc5:

    # "My eyes are red and my hair is messed up in every direction."
    "Oculi mei rubent et capilli in omnes partes turbati sunt."

# game/a2s3.rpy:191
translate latin a2s3_37f5657b:

    # "I wet one of the towels and wash my face and by the time I'm finished, I feel mostly better."
    "Unum linteorum madefacio atque vultum lavo; opere perfecto, fere melius me habeo."

# game/a2s3.rpy:192
translate latin a2s3_0392df0b:

    # "As I rest there against the sink, I think back to what just happened."
    "Dum labro innixus quiesco, animo repeto quae modo acciderunt."

# game/a2s3.rpy:193
translate latin a2s3_886664fc:

    # "Not just the drug trip I'd been sent on, but what I'd been told."
    "Non tantum visiones quas medicamentum attulit, sed etiam quae mihi dicta sunt."

# game/a2s3.rpy:194
translate latin a2s3_c0be3eb7:

    # "All the dreams I'd had since being on this moon; I remember everything."
    "Omnium somniorum quae in hac luna habui memini."

# game/a2s3.rpy:195
translate latin a2s3_31ecaf90:

    # "I don't know if it's real or not, if I'd really just spoken to the parents."
    "Nescio an verum sit, an modo vere cum Parentibus locutus sim."

# game/a2s3.rpy:196
translate latin a2s3_1c31f360:

    # "It had seemed too intricate to not be real."
    "Nimis intricatum visum erat ut falsum esset."

# game/a2s3.rpy:197
translate latin a2s3_35afd58c:

    # "My mind wouldn't be able to make up something like that, would it?"
    "Animus meus tale aliquid fingere non posset, nonne?"

# game/a2s3.rpy:198
translate latin a2s3_968ddef1:

    # "Then again, I don't know what Cassius was smoking."
    "Ceterum, nescio quid Cassius fumaverit."

# game/a2s3.rpy:199
translate latin a2s3_bde2a58d:

    # "As if on cue, I hear the wolf snort in the bedroom and I make my way out of the bathroom, finding Cassius on his side now, facing away from me."
    "Quasi signo dato, lupum in cubiculo fremere audio; e balneo egredior et Cassium iam in latere iacentem, a me aversum, invenio."

# game/a2s3.rpy:201
translate latin a2s3_16cf3218:

    # m "\"Cassius?\""
    m "\"Cassi?\""

# game/a2s3.rpy:202
translate latin a2s3_7100a56d:

    # "Slowly, I walk around the bed and see that the wolf's eyes, just as red as mine, are open, staring off into space."
    "Lente circa lectum ambulo et oculos lupi, aeque ac meos rubentes, apertos ac inane spatium intuentes video."

# game/a2s3.rpy:203
translate latin a2s3_aa593a1b:

    # "I try again."
    "Iterum conor."

# game/a2s3.rpy:204
translate latin a2s3_19c32e41:

    # m "\"Cassius? You okay?\""
    m "\"Cassi? Bene vales?\""

# game/a2s3.rpy:205
translate latin a2s3_be700a8a:

    # "The wolf mumbles something, not even looking at me."
    "Lupus aliquid murmurat, ne me quidem aspiciens."

# game/a2s3.rpy:206
translate latin a2s3_7b1cc89c:

    # "I walk up to the side of the bed, reaching out tentatively before gently touching him on the arm."
    "Ad lecti latus accedo, manum dubitanter porrigens; deinde brachium eius leniter tango."

# game/a2s3.rpy:207
translate latin a2s3_a1964722:

    # "That seems to jolt him from his daze and he jerks away, gasping in surprise and fear as he pulls back and looks up at me."
    "Id eum e stupore revocare videtur: subito se retrahit, admiratione metuque anhelans, atque ad me suspicit."

# game/a2s3.rpy:208
translate latin a2s3_fc9be712:

    # "I hold my hands up to show him that I mean no harm, and he stares at me for what feels like over a minute."
    "Manus tollo ut ostendam me nocere nolle; ille me diutius quam minutum intueri videtur."

# game/a2s3.rpy:209
translate latin a2s3_6ee5a5a0:

    # "Finally, he mumbles out my name."
    "Tandem nomen meum murmurat."

# game/a2s3.rpy:212
translate latin a2s3_b6a1573b:

    # c "\"[mc]...\""
    c "\"[mc]...\""

# game/a2s3.rpy:213
translate latin a2s3_6a4fe0df:

    # "I nod slowly, not wanting to make any sudden movements."
    "Lente annuo, nolens subitos motus facere."

# game/a2s3.rpy:214
translate latin a2s3_7bb2dc1f:

    # m "\"Yes, I'm [mc]. You're in the palace, in Amicus's old ro—\""
    m "\"Ita, [mc] sum. In palatio es, in priore Amici cu—\""

# game/a2s3.rpy:216
translate latin a2s3_cabcb19c:

    # c "\"I know where I am, idiot.\""
    c "\"Scio ubi sim, stulte.\""

# game/a2s3.rpy:217
translate latin a2s3_5e90c62d:

    # "Seems like he's returning to his old self."
    "Ad pristinum se redire videtur."

# game/a2s3.rpy:218
translate latin a2s3_4eb17ed0:

    # m "\"Well, that's good. You had a pretty bad reaction to...whatever that was.\""
    m "\"Bene est igitur. Satis male illud...quidquid erat te affecit.\""

# game/a2s3.rpy:219
translate latin a2s3_de0b6e59:

    # "Cassius is pushing himself up to a sitting position, doing it slowly just like I had."
    "Cassius se erigit ut sedeat, tam lente quam ego feci."

# game/a2s3.rpy:221
translate latin a2s3_2d149393:

    # "He lets his head hang for a while, probably going through the same dizzy spells I'd just experienced."
    "Caput aliquantisper demittit, eadem fortasse vertigine laborans quam modo passus sum."

# game/a2s3.rpy:222
translate latin a2s3_45d3e3ca:

    # "I wait patiently, deciding to move back over to the sofa while I do."
    "Patienter exspecto; interim ad lectum mollem redire constituo."

# game/a2s3.rpy:223
translate latin a2s3_0b7801e4:

    # "His ears perk up as I sit down, and he looks back up at me."
    "Cum consido, aures erigit atque rursus ad me suspicit."

# game/a2s3.rpy:225
translate latin a2s3_17392bd3:

    # c "\"What are you doing?\""
    c "\"Quid agis?\""

# game/a2s3.rpy:226
translate latin a2s3_e499761a:

    # "I frown."
    "Frontem contraho."

# game/a2s3.rpy:227
translate latin a2s3_9d3344cb:

    # m "\"What do you mean?\""
    m "\"Quid dicis?\""

# game/a2s3.rpy:229
translate latin a2s3_8f096ec6:

    # c "\"I mean why are you still here? You may leave.\""
    c "\"Dico, cur adhuc hic es? Abire potes.\""

# game/a2s3.rpy:230
translate latin a2s3_6aeeb2fb:

    # m "\"Uh, I guess I could. I just want to make sure you're okay first.\""
    m "\"Hem, possum, ut puto. Tantum prius te bene valere scire volo.\""

# game/a2s3.rpy:231
translate latin a2s3_0cd26afd:

    # "Cassius lets out a soft, indignant snort."
    "Cassius leniter indignatus fremit."

# game/a2s3.rpy:233
translate latin a2s3_715926ff:

    # c "\"You think I believe that? You're dismissed.\""
    c "\"Putas me hoc credere? Dimissus es.\""

# game/a2s3.rpy:234
translate latin a2s3_612ffb84:

    # "I give him an incredulous look."
    "Incredulus eum aspicio."

# game/a2s3.rpy:235
translate latin a2s3_c35973a7:

    # m "\"Seriously? First of all, this is Amicus's room, second, I'm a Khemian. I don't see you ordering Neferu around like that.\""
    m "\"Re vera? Primum, hoc Amici cubiculum est; deinde, Khemianus sum. Neferu ita imperare te non video.\""

# game/a2s3.rpy:236
translate latin a2s3_957d5db4:

    # "This time Cassius lets out a louder snort."
    "Hoc tempore Cassius clarius fremit."

# game/a2s3.rpy:238
translate latin a2s3_45893df9:

    # c "\"Ha! He's royalty, and an actual Khemian, you think that I'd pay you the same—\""
    c "\"Ha! Ille regia stirpe natus est atque verus Khemianus; putas me tibi eundem—\""

# game/a2s3.rpy:239
translate latin a2s3_d264ff08:

    # m "\"Khemians see all their citizens as equals. I'm worth just as much as he is in their eyes.\""
    m "\"Khemiani omnes cives suos pares habent. In eorum oculis ego tantum valeo quantum ille.\""

# game/a2s3.rpy:240
translate latin a2s3_33747a4c:

    # "Instead of snapping back, Cassius just lowers his head, eyes closed before he lets out a deep, forlorn sigh."
    "Cassius, potius quam acerbe respondeat, caput tantum demittit oculosque claudit; deinde alte ac tristiter suspirat."

# game/a2s3.rpy:242
translate latin a2s3_243d2427:

    # c "\"I'm tired, if you wish to antagonize me please leave it for another time.\""
    c "\"Fessus sum; si me vexare vis, quaeso, in aliud tempus differ.\""

# game/a2s3.rpy:243
translate latin a2s3_7abd3a7f:

    # "I've been pushing the boundaries with Cassius on purpose to see what the limits are, and I'm getting more comfortable conversing with him without fear."
    "Fines Cassii de industria temptavi ut scirem quousque progredi possem; iam commodius sine metu cum eo colloquor."

# game/a2s3.rpy:244
translate latin a2s3_9924f442:

    # "Still, I'm a bit taken aback at Cassius's sudden tone of defeat."
    "Subita tamen desperatio vocis Cassii paulum me obstupefacit."

# game/a2s3.rpy:245
translate latin a2s3_03173735:

    # "It's one that I haven't heard often."
    "Hanc vocem raro audivi."

# game/a2s3.rpy:246
translate latin a2s3_81b471df:

    # "We're both silent for a minute or so, then I finally speak up."
    "Ambo unum fere minutum tacemus; deinde tandem loquor."

# game/a2s3.rpy:247
translate latin a2s3_0d25a391:

    # m "\"Um...so what was that? That smoke stuff? It was a drug, right?\""
    m "\"Hem...quid igitur illud erat? Res illa fumosa? Medicamentum erat, nonne?\""

# game/a2s3.rpy:248
translate latin a2s3_cd2f6cf9:

    # "Cassius is silent for a bit longer, and I wonder if he's going to ask me to leave again, but instead he just sighs and finally looks up, his eyes looking a bit more clear now."
    "Cassius paulo diutius tacet; quaero an rursus me abire iubeat; sed tantum suspirat ac tandem suspicit, oculis iam paulo clarioribus."

# game/a2s3.rpy:250
translate latin a2s3_be6baee5:

    # c "\"It's called {i}somni{/i}, a plant from the southern region of this continent. It helps us connect to the parents.\""
    c "\"{i}Somni{/i} vocatur, planta e regione australi huius continentis. Nos cum Parentibus coniungi adiuvat.\""

# game/a2s3.rpy:251
translate latin a2s3_6604d52a:

    # m "\"Yeah...you said it's the traditional way?\""
    m "\"Ita...dixisti hanc viam traditam esse?\""

# game/a2s3.rpy:252
translate latin a2s3_16ef3920:

    # c "\"The old way, yes. Usually we communicate through parental tech, but as you know, they're not currently speaking to with us with that method.\""
    c "\"Antiquam viam, ita. Plerumque arte Parentum communicamus; sed, ut scis, nunc illa ratione nobiscum non loquuntur.\""

# game/a2s3.rpy:253
translate latin a2s3_9d772693:

    # m "\"Sooo...this forces it to happen?\""
    m "\"Ergooo...hoc rem fieri cogit?\""

# game/a2s3.rpy:254
translate latin a2s3_8af938f0:

    # c "\"In a way.\""
    c "\"Quodam modo.\""

# game/a2s3.rpy:255
translate latin a2s3_189a1c5e:

    # m "\"Does it work?\""
    m "\"Valetne?\""

# game/a2s3.rpy:257
translate latin a2s3_9aedace5:

    # "Cassius glares at me."
    "Cassius truculenter me aspicit."

# game/a2s3.rpy:258
translate latin a2s3_effd5a14:

    # c "\"You would know. You were there.\""
    c "\"Ipse scias. Ibi eras.\""

# game/a2s3.rpy:259
translate latin a2s3_c106b8c3:

    # "I go silent, that statement coming as a surprise to me."
    "Taceo, sententia illa admiratus."

# game/a2s3.rpy:260
translate latin a2s3_7e1b3886:

    # "I'd seen Cassius, of course, but I'd thought it had only been part of the hallucination."
    "Cassium quidem videram, sed tantum partem visionis esse putaveram."

# game/a2s3.rpy:261
translate latin a2s3_f8335145:

    # m "\"You...saw me?\""
    m "\"Me...vidisti?\""

# game/a2s3.rpy:262
translate latin a2s3_b0981877:

    # c "\"Oh please, simian...or whatever the hell you are. You're only trying to humiliate me further. I was right next to you.\""
    c "\"Quaeso, simie...vel quidquid, malum, es. Me magis tantum humiliare conaris. Recta iuxta te eram.\""

# game/a2s3.rpy:263
translate latin a2s3_3012968a:

    # "So that had been real?"
    "Ergo verum fuerat?"

# game/a2s3.rpy:264
translate latin a2s3_49e934c9:

    # "I sit back on my hands, contemplating all of this."
    "Manibus innixus sedeo, haec omnia contemplans."

# game/a2s3.rpy:265
translate latin a2s3_f8afc45d:

    # "I've read about DMT experiences back on Earth, how if you break through, you can meet extra-dimensional beings that tell you the secrets of the universe."
    "In Terra de experientiis DMT legi: si limites transgressus sis, entia extra dimensionem nostram posita convenire possis, quae universi arcana tibi dicant."

# game/a2s3.rpy:266
translate latin a2s3_40a40030:

    # "I would have considered my experience to be all in my head, but if Cassius was actually there..."
    "Experientiam meam tantum ab animo fictam esse putavissem; sed si Cassius vere ibi erat..."

# game/a2s3.rpy:268
translate latin a2s3_3ee5b5fb:

    # "I notice then that Cassius is looking very closely at me, gauging my expression."
    "Tum animadverto Cassium diligentissime me aspicere, vultum meum aestimantem."

# game/a2s3.rpy:269
translate latin a2s3_df8ec4bc:

    # m "\"What?\""
    m "\"Quid?\""

# game/a2s3.rpy:270
translate latin a2s3_5048311e:

    # c "\"He spoke to you, didn't he? What did he say?\""
    c "\"Tecum locutus est, nonne? Quid dixit?\""

# game/a2s3.rpy:271
translate latin a2s3_104f1665:

    # m "\"Uhhh...\""
    m "\"Ehhh...\""

# game/a2s3.rpy:272
translate latin a2s3_d5c3c8d7:

    # "I try to think of what to say."
    "Quid dicam excogitare conor."

# game/a2s3.rpy:273
translate latin a2s3_5af18bd8:

    # "If this is real, then I doubt telling Cassius everything will help me out in any way."
    "Si verum est, dubito an omnia Cassio narrare ullo modo mihi prosit."

# game/a2s3.rpy:274
translate latin a2s3_14a6c9af:

    # "He must see the hesitation on my face, because his fur bristles."
    "Cunctationem in vultu meo videre debet, nam pili eius horrent."

# game/a2s3.rpy:276
translate latin a2s3_b95026ea:

    # c "\"The emperor demands you tell him what they told you!\""
    c "\"Imperator iubet te dicere quid tibi dixerint!\""

# game/a2s3.rpy:277
translate latin a2s3_df069bc9:

    # "I glance up at Cassius, feeling less and less afraid of him with every threat he sends my way."
    "Ad Cassium suspicio, singulis eius minis minus minusque eum metuens."

# game/a2s3.rpy:278
translate latin a2s3_26fdfb6e:

    # "He really is all bark and no bite."
    "Vere latrat tantum neque mordet."

# game/a2s3.rpy:279
translate latin a2s3_f826fe04:

    # m "\"He just sort of asked me what I was doing there. That's it.\""
    m "\"Tantum quodam modo quaesivit quid ibi agerem. Nihil aliud.\""

# game/a2s3.rpy:280
translate latin a2s3_ac9af600:

    # "Cassius glares at me before finally seeming defeated once again, looking down."
    "Cassius me truculenter aspicit, deinde rursus victus videtur, oculis demissis."

# game/a2s3.rpy:282
translate latin a2s3_337ac9ab:

    # m "\"But he seemed okay with me being here. He was a monitor too. I don't think Amicus is in trouble.\""
    m "\"Sed me hic esse approbare videbatur. Monitor quoque erat. Non puto Amicum in culpa esse.\""

# game/a2s3.rpy:283
translate latin a2s3_1050aea7:

    # "Cassius shakes his head."
    "Cassius caput quatit."

# game/a2s3.rpy:284
translate latin a2s3_fb41345e:

    # c "\"I don't trust anything he said. He was a demon.\""
    c "\"Nullis eius verbis credo. Daemon erat.\""

# game/a2s3.rpy:285
translate latin a2s3_3f739ce1:

    # "I sigh."
    "Suspiro."

# game/a2s3.rpy:286
translate latin a2s3_58e334f2:

    # m "\"What did they say to {i}you{/i}? You looked pretty scared.\""
    m "\"Quid {i}tibi{/i} dixerunt? Satis territus videbaris.\""

# game/a2s3.rpy:288
translate latin a2s3_aaecfd3a:

    # c "\"I was not scared!\""
    c "\"Non terrebar!\""

# game/a2s3.rpy:289
translate latin a2s3_5195cedf:

    # "I let out an involuntary laugh before I can stop it."
    "Invitus rideo antequam me cohibere possim."

# game/a2s3.rpy:291
translate latin a2s3_f9563f37:

    # c "\"Damn you! I was simply unprepared for the experience; it was much more intense than the previous one I had. That's all.\""
    c "\"Pereas! Tantum huic experientiae imparatus eram: multo vehementior erat quam prior quam habueram. Nihil aliud.\""

# game/a2s3.rpy:293
translate latin a2s3_10943343:

    # "Cassius looks at the ground again, and I can see that the insides of his ears are a burning red."
    "Cassius rursus terram aspicit; interiores aurium partes ardente rubore perfusas video."

# game/a2s3.rpy:294
translate latin a2s3_1cbf4704:

    # "I know that laughing at him was a shitty move on my part."
    "Scio me male egisse quod eum irrisi."

# game/a2s3.rpy:295
translate latin a2s3_bfe057cf:

    # "I should be working to get him on my side, to help Amicus."
    "Eum mihi conciliare conari debeo, ut Amicum adiuvem."

# game/a2s3.rpy:296
translate latin a2s3_da66a371:

    # "I make an effort to get my expression under control."
    "Vultum meum moderari conor."

# game/a2s3.rpy:297
translate latin a2s3_632a46c3:

    # m "\"Listen, I'm not against you Cassius. Actually, I think we're working together here. I'm just...trying to figure out how best to help your brother.\""
    m "\"Audi, Cassi: non contra te sum. Immo, puto nos hic una laborare. Tantum...quaero quomodo optime fratrem tuum adiuvem.\""

# game/a2s3.rpy:298
translate latin a2s3_fd9f219c:

    # "Cassius continues to stare silently at the floor, though I see an ear twitch as if acknowledging what I'd just said."
    "Cassius adhuc terram tacitus intuetur; tamen aurem moveri video, velut verba mea agnoscat."

# game/a2s3.rpy:299
translate latin a2s3_26625c55:

    # m "\"If we're going to work together, we need to be at least a little bit honest with each other. Maybe I could help you figure some stuff out.\""
    m "\"Si una laboraturi sumus, saltem paulum sinceri inter nos esse debemus. Fortasse te quasdam res intellegentem adiuvare possum.\""

# game/a2s3.rpy:300
translate latin a2s3_2244dadb:

    # "I realize how hypocritical that is, especially considering that I'm hiding what the parents had just told me."
    "Intellego quam parum hoc moribus meis respondeat, praesertim cum quae Parentes modo mihi dixerunt celem."

# game/a2s3.rpy:301
translate latin a2s3_72597da9:

    # "Cassius lets out a skeptical huff."
    "Cassius incredulus anhelat."

# game/a2s3.rpy:303
translate latin a2s3_96858bb3:

    # c "\"You, help me?\""
    c "\"Tu me adiuvare?\""

# game/a2s3.rpy:304
translate latin a2s3_499b85ea:

    # m "\"Yes.\""
    m "\"Ita.\""

# game/a2s3.rpy:306
translate latin a2s3_987694ec:

    # "Cassius seems to contemplate, then shakes his head."
    "Cassius cogitare videtur, deinde caput quatit."

# game/a2s3.rpy:307
translate latin a2s3_3ea7a89e:

    # c "\"Well, nothing there could help us. They simply torment me when I try to communicate with them.\""
    c "\"Nihil ibi nobis prodesse poterat. Tantum me cruciant cum cum eis communicare conor.\""

# game/a2s3.rpy:308
translate latin a2s3_9ba15f5d:

    # m "\"Torment?\""
    m "\"Cruciant?\""

# game/a2s3.rpy:310
translate latin a2s3_0d89b7c4:

    # c "\"They appear as demons and taunt me. It seems that the parents truly do want to cut off contact with us...which I'm fine with.\""
    c "\"Daemones apparent et me ludibrio habent. Parentes vere commercium nobiscum intercludere videntur...quod mihi placet.\""

# game/a2s3.rpy:311
translate latin a2s3_18d06ade:

    # "Cassius says that last bit with such meek defiance that I almost feel sorry for him."
    "Cassius ultima illa tam timida contumacia dicit ut eum paene miserear."

# game/a2s3.rpy:312
translate latin a2s3_e312ddd5:

    # m "\"Maybe it was just the drug? I've heard plenty of stories of people freaking out on mind-altering stuff, especially if they have problems with anxiety—\""
    m "\"Fortasse tantum medicamentum erat? Multa de hominibus audivi qui, rebus animum mutantibus sumptis, expavescunt, praesertim si anxietate laborant—\""

# game/a2s3.rpy:314
translate latin a2s3_df0a3e5c:

    # c "\"I do not have a weak mind, [mc].\""
    c "\"Non infirmo animo sum, [mc].\""

# game/a2s3.rpy:315
translate latin a2s3_9f208e16:

    # m "\"Th—that doesn't mean you have a weak mind, sometimes you just—\""
    m "\"H—hoc non significat animum infirmum esse; interdum tantum—\""

# game/a2s3.rpy:317
translate latin a2s3_1c779b3e:

    # c "\"Enough. I will not have you speculating about my mental capacities.\""
    c "\"Satis. Te de facultatibus mentis meae coniectare non sinam.\""

# game/a2s3.rpy:318
translate latin a2s3_30409fb6:

    # "This time I'm the one sighing, wondering for the hundredth time how the hell this wolf is Amicus's brother."
    "Hoc tempore ego suspiro, centies iam quaerens quomodo, malum, hic lupus Amici frater sit."

# game/a2s3.rpy:319
translate latin a2s3_cdbbedc4:

    # m "\"So they didn't say anything to you?\""
    m "\"Ergo nihil tibi dixerunt?\""

# game/a2s3.rpy:320
translate latin a2s3_37ba7ed3:

    # "Cassius pauses, a frown tugging at the corners of his mouth."
    "Cassius haeret, oris angulis in tristitiam retractis."

# game/a2s3.rpy:322
translate latin a2s3_b6cb7ad3:

    # c "\"No.\""
    c "\"Non.\""

# game/a2s3.rpy:323
translate latin a2s3_83b2a1c1:

    # "I raise an eyebrow at him."
    "Supercilium ad eum tollo."

# game/a2s3.rpy:325
translate latin a2s3_610c980e:

    # c "\"What? Of course they said things to me, but nothing useful.\""
    c "\"Quid? Certe aliquid dixerunt, sed nihil utile.\""

# game/a2s3.rpy:326
translate latin a2s3_4dd72ad2:

    # m "\"You sure?\""
    m "\"Certus es?\""

# game/a2s3.rpy:328
translate latin a2s3_8a85f49b:

    # c "\"Of course I'm sure! The parents have turned on us. That's all that I need to know.\""
    c "\"Certissimus! Parentes contra nos conversi sunt. Id tantum scire debeo.\""

# game/a2s3.rpy:330
translate latin a2s3_5945acb3:

    # "I think back to the conversation we'd had in the hallucination."
    "Sermonem quem in visione habuimus memoria repeto."

# game/a2s3.rpy:331
translate latin a2s3_fdacc4f0:

    # "The monitor had told both of us that Cassius isn't the emperor, and if Cassius had heard what I heard, then that's probably what he's thinking about right now."
    "Monitor nobis ambobus dixit Cassium imperatorem non esse; si Cassius eadem audivit atque ego, de hac re nunc fortasse cogitat."

# game/a2s3.rpy:332
translate latin a2s3_c7109cc4:

    # "But I know now isn't the time to challenge him, and I can tell that he's still trying to recover from the trip."
    "Sed scio nunc eum provocandi tempus non esse; adhuc a visione se reficere conatur."

# game/a2s3.rpy:333
translate latin a2s3_47d846b6:

    # "Still, looking at him right now, staring at the ground, looking disheveled and defeated...I feel myself wanting to help him."
    "Tamen, eum nunc aspiciens, terram intuentem, turbatum victumque...eum adiuvare cupio."

# game/a2s3.rpy:334
translate latin a2s3_173823de:

    # "Out of everyone on this moon, he seems to be the most stressed out, and I feel bad for him despite everything that's happened."
    "Omnium in hac luna maxime anxius esse videtur; eum miseror, quamquam omnia illa acciderunt."

# game/a2s3.rpy:336
translate latin a2s3_3e8aa343:

    # "But I know he doesn't want my pity right now."
    "Sed scio eum nunc misericordiam meam nolle."

# game/a2s3.rpy:337
translate latin a2s3_f800d3e7:

    # "So, I eventually leave Cassius alone on the bed and wander back out into the halls, feeling as if weeks had past since I'd last been out here."
    "Tandem igitur Cassium solum in lecto relinquo atque in porticus redeo, velut hebdomades ex quo hic novissime eram praeterierint."

# game/a2s3.rpy:340
translate latin a2s3_ce0e3b47:

    # "I think back to what that dragon-like creature had told me, about how I'm here for a reason, that this has all been planned out."
    "Memoria repeto quae creatura illa draconina mihi dixit: me causa certa hic esse, omnia ex consilio evenisse."

# game/a2s3.rpy:341
translate latin a2s3_c5b97e3c:

    # "Planned out by parents who seem to be completely frustrated at the behavior of the wolves and their inability to follow through on their \"plans\"."
    "Ex consilio Parentum, quos mores Luporum atque impotentia eorum \"consilia\" perficiendi prorsus frustrari videntur."

# game/a2s3.rpy:342
translate latin a2s3_913db4f3:

    # "For a brief moment, I wonder how much more smoothly things would have gone if I'd been abducted by someone like Neferu and taken to somewhere like Khemia."
    "Brevi momento quaero quanto facilius res cessissent si a Neferu vel simili raptus atque in Khemiam vel locum talem ductus essem."

# game/a2s3.rpy:343
translate latin a2s3_587b5766:

    # "But then I wouldn't have met Amicus."
    "Sed tum Amicum non convenissem."

# game/a2s3.rpy:344
translate latin a2s3_0a2e958e:

    # "Besides, it seems like it's just the wolves that are giving the parents problems, not the other siblings."
    "Praeterea, Lupi soli Parentibus difficultates facere videntur, non ceteri Fratres."

# game/a2s3.rpy:345
translate latin a2s3_0c2dcd59:

    # "Which reminds me of the only bit of advice that the parents had given me; \"watch the cat\"."
    "Id mihi in memoriam revocat unum consilium quod Parentes dederunt: \"felem observa\"."

# game/a2s3.rpy:346
translate latin a2s3_858a1c91:

    # "Spy on Alexios."
    "Alexios speculari."

# game/a2s3.rpy:347
translate latin a2s3_e16fb8bb:

    # "That's something that I think I can do, if I'm careful."
    "Puto hoc me facere posse, si cautus sim."

# game/a2s3.rpy:348
translate latin a2s3_d8606503:

    # "Despite the new level of scrutiny I've fallen under, I've also been walking around the halls of the palace for the past few days without incidence."
    "Quamquam diligentius nunc observor, his ultimis diebus etiam sine ullo casu per palatii porticus ambulavi."

# game/a2s3.rpy:349
translate latin a2s3_d37519ed:

    # "I've even come across Cato a few times, but for whatever reason, he's completely ignored me."
    "Catonem quoque aliquotiens offendi; sed nescio cur prorsus me neglexit."

# game/a2s3.rpy:350
translate latin a2s3_85150b3e:

    # "All for the better."
    "Tanto melius."

# game/a2s3.rpy:351
translate latin a2s3_f079bab7:

    # "So, I start to scour the palace for the cat."
    "Ita per palatium felem quaerere incipio."

# game/a2s3.rpy:352
translate latin a2s3_6998aa33:

    # "He's actually pretty hard to find when he's not looking for you, but I at least know that he's usually in the gardens, if not in the hallways watering the plants."
    "Re vera difficile est eum invenire cum ipse te non quaerit; sed saltem scio eum plerumque in hortis esse, nisi plantas in porticibus rigat."

# game/a2s3.rpy:353
translate latin a2s3_45312fb4:

    # "So after eating a quick lunch, I decide to start my search in the gardens."
    "Post breve igitur prandium quaestionem in hortis incipere constituo."

# game/a2s3.rpy:355
translate latin a2s3_5f517eab:

    # "I look back and forth through the foliage as I walk quietly along the various pathways."
    "Huc atque illuc per frondes aspicio, dum tacitus per varias semitas ambulo."

# game/a2s3.rpy:356
translate latin a2s3_cfdef975:

    # "It's quiet, pleasant, and peaceful, but after everything that's happened, it has an ominous edge to it, like something could jump out at me at any moment."
    "Quietum, iucundum ac pacatum est; sed post omnia quae acciderunt aliquid ominosum habet, velut quidquam quovis momento in me prosilire possit."

# game/a2s3.rpy:357
translate latin a2s3_86f667ea:

    # "I do this for about half-an-hour before I start to realize how fruitless this search might be."
    "Dimidiam fere horam ita ago, deinde intellegere incipio quam vana haec quaestio esse possit."

# game/a2s3.rpy:358
translate latin a2s3_f4df9b11:

    # "Alex would be hard to find even if he {i}was{/i} out here, and besides, he could even be all the way out in the city doing his \"ambassador work\", whatever that is."
    "Alex difficile inventu esset etiam si hic {i}esset{/i}; praeterea, fortasse usque in urbe \"munera legati\" agit, quidquid illa sunt."

# game/a2s3.rpy:359
translate latin a2s3_ccc9dcb1:

    # "Just as I'm about to give up though, I hear something."
    "Cum iam cedere velim, aliquid audio."

# game/a2s3.rpy:360
translate latin a2s3_e5ceecfd:

    # "Sniffling, gasping, and...crying?"
    "Narium sonos, anhelitus et...fletum?"

# game/a2s3.rpy:362
translate latin a2s3_3e1f701d:

    # "I pause, listening."
    "Consisto et audio."

# game/a2s3.rpy:363
translate latin a2s3_d90eda6c:

    # "It's a bit difficult to hear through the slight rustling of leaves in the wind, but there's definitely someone out here that sounds upset."
    "Per lenem frondium vento motarum susurrum difficile est audire; sed certe aliquis hic est qui perturbatus sonat."

# game/a2s3.rpy:364
translate latin a2s3_26cbff0c:

    # "I can't really tell who it might be since it sounds like they're trying to keep quiet."
    "Quis sit discernere nequeo, quia quietus manere conari videtur."

# game/a2s3.rpy:365
translate latin a2s3_7b9d1168:

    # "That, and there's another sound too; another voice, and this one I recognize."
    "Praeterea alius quoque sonus est: alia vox, hanc autem agnosco."

# game/a2s3.rpy:366
translate latin a2s3_6f35370e:

    # "Alex."
    "Alex."

# game/a2s3.rpy:367
translate latin a2s3_72efeb62:

    # "It's a soft murmuring sound, like he's soothing someone, probably the person who's crying."
    "Molliter murmurat, velut aliquem soletur, fortasse eum qui flet."

# game/a2s3.rpy:368
translate latin a2s3_485c967e:

    # "I wait there a few moments, waiting to see if the sound fades or gets closer which would tell me if they're moving, but it stays constant."
    "Aliquot momenta exspecto ut videam an sonus recedat vel appropinquet, quod eos moveri ostendat; sed idem manet."

# game/a2s3.rpy:369
translate latin a2s3_b09a401a:

    # "So, convinced that they're sitting down, or at least standing in the same spot, I creep closer to where the sound is coming from."
    "Persuasum igitur habeo eos sedere, vel saltem eodem loco stare; propius ad locum unde sonus venit repo."

# game/a2s3.rpy:370
translate latin a2s3_fd499d2a:

    # "It's in a secluded part of the garden, coming from a small square that's surrounded by trees and bushes."
    "In remota horti parte est, ex parva area arboribus fruticibusque circumdata veniens."

# game/a2s3.rpy:371
translate latin a2s3_adfdb3fb:

    # "I'm familiar with this square, the one with the statue of Drusus, where I'd been laid out to die."
    "Hanc aream novi, ubi statua Drusi est et ubi moriturus depositus eram."

# game/a2s3.rpy:372
translate latin a2s3_0da0a36a:

    # "I know that I can't use the little path that leads to the statue; I'd be seen for sure, so I walk up to the bushes that surround it and start looking for a break in the various branches and leaves."
    "Scio me semita parva ad statuam ducente uti non posse, quippe qui certe viderer; itaque ad frutices circumstantes accedo atque intervallum in ramis foliisque quaero."

# game/a2s3.rpy:373
translate latin a2s3_fc10204f:

    # "The sobbing sound continues, and I can hear Alex's voice more clearly now."
    "Fletus pergit; nunc vocem Alex clarius audio."

# game/a2s3.rpy:374
translate latin a2s3_3b0cca7e:

    # "I still can't quite tell exactly what he's saying, but I catch the occasional \"don't worry\" and, \"all is well\"."
    "Quidnam dicat adhuc non plane intellego, sed interdum \"noli timere\" atque \"omnia bene sunt\" percipio."

# game/a2s3.rpy:375
translate latin a2s3_ecc925d8:

    # "I can't imagine what's happening in there."
    "Quid ibi fiat fingere nequeo."

# game/a2s3.rpy:376
translate latin a2s3_2cc0fe8f:

    # "I start to wonder if this is exactly what the parents had hoped I would come across, and my heart starts to hammer in my chest."
    "Quaero an hoc ipsum sit quod Parentes me inventurum speraverint; cor meum in pectore vehementer pulsare incipit."

# game/a2s3.rpy:377
translate latin a2s3_badb0621:

    # "Am I about to find something that's going to help me out of the mess we're in?"
    "Num iam aliquid inveniam quod me e difficultatibus nostris liberare possit?"

# game/a2s3.rpy:378
translate latin a2s3_9262a26e:

    # "I finally find a thinner coverage in the foliage and I'm able to see through."
    "Tandem rariores frondes invenio et per eas videre possum."

# game/a2s3.rpy:380
translate latin a2s3_cabdd85a:

    # "First, I see Alex, his back to me, crouched on the ground in front of the statue."
    "Primum Alex video, tergo ad me verso, ante statuam humi contractis cruribus sedentem."

# game/a2s3.rpy:381
translate latin a2s3_e2d160f6:

    # "He's draped over something...someone, hugging them, his face pressed to the side of their head."
    "Super rem quandam...aliquem incumbit eumque amplectitur, vultu lateri capitis eius adpresso."

# game/a2s3.rpy:382
translate latin a2s3_c2442cc4:

    # "I can only see their ears and parts of their shoulder, but I know right away that it's Cassius."
    "Aures tantum atque partes umeri videre possum, sed statim scio Cassium esse."

# game/a2s3.rpy:383
translate latin a2s3_cf2bae17:

    # "He's got his head bowed deeply toward the ground, his paws to his face, shaking with his sobs."
    "Caput alte ad terram demittit, manibus vultui admotis, fletu tremens."

# game/a2s3.rpy:384
translate latin a2s3_53dd5f61:

    # "Alex hugs him tightly, whispering into his ear, clearly trying to comfort him."
    "Alex arcte eum amplectitur et in aurem susurrat, manifeste eum consolari conatus."

# game/a2s3.rpy:385
translate latin a2s3_2b021a44:

    # "Cassius only responds with an occasional shake of his head before finally blurting out;"
    "Cassius tantum interdum caput quatit; deinde tandem effundit:"

# game/a2s3.rpy:386
translate latin a2s3_3ed77c9e:

    # c "\"But am I a fraud?\""
    c "\"Sed num impostor sum?\""

# game/a2s3.rpy:387
translate latin a2s3_0871b487:

    # "His voice squeaks uncharacteristically on the last word and Alex responds with a gentle \"shh\" before nuzzling the wolf's muzzle."
    "In ultimo verbo vox eius praeter consuetudinem stridet; Alex miti \"ssh\" respondet, deinde rostrum lupi rostro suo mulcet."

# game/a2s3.rpy:388
translate latin a2s3_7dcc6237:

    # "I watch for a few more moments before drawing back, feeling uncomfortable, knowing that this is a private moment between the two of them."
    "Pauca adhuc momenta specto, deinde recedo, incommodus factus, sciens hanc privatam inter ambos rem esse."

# game/a2s3.rpy:389
translate latin a2s3_0e0e52bc:

    # "I know now that this won't exactly help me in any way aside from making me feel even worse for Cassius."
    "Iam scio hoc prorsus mihi non profuturum esse, nisi ut Cassium magis etiam miserear."

# game/a2s3.rpy:390
translate latin a2s3_5b14b0a5:

    # "Still, I've found Alex, so I move away, toward a bench that's further up the path, one that gives me a good view of the entrance to the square and at a distance that won't make me seem suspicious."
    "Tamen Alex inveni; itaque recedo ad subsellium longius in semita positum, unde introitum areae bene videre possim, satis longe ne suspectus videar."

# game/a2s3.rpy:391
translate latin a2s3_77413236:

    # "A good ten minutes pass before there's any movement."
    "Decem plena minuta transeunt antequam quidquam movetur."

# game/a2s3.rpy:394
translate latin a2s3_da1c4d63:

    # "First, Cassius comes out, in the process of straightening out his armor, his expression blank as he stalks off up the path, away from me."
    "Primum Cassius egreditur, arma sua componens, vultu inani, dum per semitam a me longe abit."

# game/a2s3.rpy:395
translate latin a2s3_9e9ce8ee:

    # "I wait a while...a good while, maybe another five minutes, wondering if Alex somehow took a different exit from the square."
    "Aliquantisper exspecto...diu quidem, fortasse alia quinque minuta, quaerens an Alex alio areae exitu usus sit."

# game/a2s3.rpy:396
translate latin a2s3_159c8fd3:

    # "But at that moment, I see him walk out, looking completely neutral as he looks around."
    "Sed tum eum egredientem video, neutrum affectum ostendentem dum circumspicit."

# game/a2s3.rpy:397
translate latin a2s3_1afed2a8:

    # "I freeze up, positive that he's about to see me even though that would be okay, but he instead walks straight ahead, toward the pond."
    "Rigidus fio, certus eum me iam visurum esse, quamquam id bene esset; sed recta ante se ad stagnum ambulat."

# game/a2s3.rpy:398
translate latin a2s3_564d4111:

    # "I watch him go for a while, then follow."
    "Eum aliquantisper abeuntem observo, deinde sequor."

# game/a2s3.rpy:399
translate latin a2s3_f7698bbb:

    # "It feels strange trying to spy on the pet ambassador like this, especially when I have no idea what I'm doing."
    "Mirum est legatum Deliciarum ita speculari, praesertim cum quid agam prorsus nesciam."

# game/a2s3.rpy:400
translate latin a2s3_c068850d:

    # "But this is the only hint I was given to free Amicus, and if this is the only way, then I'm going to do it."
    "Sed hoc unum indicium ad Amicum liberandum accepi; si sola via est, id faciam."

# game/a2s3.rpy:404
translate latin a2s3_07921d2d:

    # "I find the cat at the pillars, already pulling away at the weeds."
    "Felem ad columnas invenio, iam herbas inutiles evellentem."

# game/a2s3.rpy:405
translate latin a2s3_b13fc527:

    # "I sigh and wait, watching for a while, realizing that this could last hours since Alex always seemed to enjoy weeding for some reason."
    "Suspiro et aliquantisper exspecto atque specto; intellego hoc horas durare posse, nam Alex nescio cur semper herbas evellere libenter videtur."

# game/a2s3.rpy:406
translate latin a2s3_0f08c69c:

    # "The cat is so meticulous about gardening here, and I have to wonder why considering his efforts really wouldn't be all that visible in a garden this big."
    "Feles tam diligenter hic hortum colit ut quaeram cur, cum labor eius in tam magno horto vix conspiciatur."

# game/a2s3.rpy:407
translate latin a2s3_645aac99:

    # "But I remind myself of why I'm here and settle down on another bench, one that's also a good distance away so that I won't seem too suspicious if he sees me."
    "Sed causam cur hic sim mihi in memoriam revoco et in alio subsellio consido, satis etiam remoto ne valde suspectus videar si me aspiciat."

# game/a2s3.rpy:409
translate latin a2s3_83160dea:

    # "This time, I sit there for a few hours, occasionally adjusting the way I'm seated as my ass gets sore on the stone bench, and as the sun sets, I realize how boring spying actually is."
    "Hoc tempore aliquot horas ibi sedeo, sedendi modum subinde mutans cum nates in lapideo subsellio doleant; sole occidente intellego quam taediosum sit re vera speculari."

# game/a2s3.rpy:412
translate latin a2s3_3ff4889b:

    # "Around the second hour, the sun has completely set, and I debate just giving up and trying another day."
    "Circa secundam horam sol omnino occidit; quaero an cedam atque alio die rursus coner."

# game/a2s3.rpy:413
translate latin a2s3_2908d44b:

    # "At that moment, a drone suddenly drifts up to me, making me jump and duck my head down a little bit, as if that will help hide me from Alex."
    "Tum automaton subito ad me advolat; resilio et caput paulum demitto, quasi id me ab Alex celare iuvet."

# game/a2s3.rpy:414
translate latin a2s3_bc7eacdd:

    # com "\"Neferu requests—\""
    com "\"Neferu requirit—\""

# game/a2s3.rpy:415
translate latin a2s3_075fbd39:

    # m "\"Shh!\""
    m "\"Ssh!\""

# game/a2s3.rpy:416
translate latin a2s3_e73188bb:

    # "I hiss at the drone, and Com's voice automatically dips into a whisper and goes on as if nothing had happened."
    "Automato sibilo; vox Com sponte in susurrum demittitur et pergit quasi nihil acciderit."

# game/a2s3.rpy:417
translate latin a2s3_b3e7e2c9:

    # com "\"—your location and if you need his assistance.\""
    com "\"—ubi sis atque an auxilio eius egeas.\""

# game/a2s3.rpy:418
translate latin a2s3_df1716ff:

    # "Of course, at that exact moment, I see Alex strolling up the path, though he doesn't move toward the palace."
    "Eodem ipso momento Alex per semitam accedentem video; non tamen ad palatium contendit."

# game/a2s3.rpy:419
translate latin a2s3_711a1ab9:

    # "Instead, he starts walking up the path in my direction and I quickly stumble off the bench and into the bushes, praying that he didn't see me as I hide myself amongst the leaves."
    "Potius per semitam in meam partem ambulat; statim e subsellio in frutices titubo, sperans eum me non vidisse dum inter folia me abscondo."

# game/a2s3.rpy:420
translate latin a2s3_61b29b73:

    # "The drone follows me, then pauses at the edge of the sidewalk."
    "Automaton me sequitur, deinde in semitae margine consistit."

# game/a2s3.rpy:421
translate latin a2s3_ac271b31:

    # "I'm reminded that these things probably can't move off of the grid of the pathways."
    "Mihi in memoriam redit haec fortasse extra semitarum ordinem moveri non posse."

# game/a2s3.rpy:422
translate latin a2s3_93332754:

    # "Just through the leaves, I can see the damn thing's lights on, stubbornly waiting for my answer."
    "Per folia lumina illius rei molestae ardentia video, obstinate responsum meum exspectantis."

# game/a2s3.rpy:423
translate latin a2s3_58e52d55:

    # "At the same time, I hear the soft scraping of Alex's sandals on the pathway as he moves closer."
    "Eodem tempore levem sandaliorum Alex sonum in semita audio, dum propius accedit."

# game/a2s3.rpy:424
translate latin a2s3_735724c0:

    # "Damn it."
    "Malum."

# game/a2s3.rpy:425
translate latin a2s3_08595fdf:

    # "It would have been better if I'd just stayed on the bench."
    "Melius esset si in subsellio mansissem."

# game/a2s3.rpy:426
translate latin a2s3_e4ef89bb:

    # "Now this drone is gonna reveal me to Alex while I'm hiding in the bushes like the most suspicious person in the palace."
    "Nunc hoc automaton me Alex prodet, dum inter frutices quasi suspectissimus omnium palatii hominum lateo."

# game/a2s3.rpy:427
translate latin a2s3_05e56529:

    # "I see the green tips of the cat's ears poke above the bushes as he hums softly."
    "Viridia cacumina aurium felis supra frutices apparent, dum ille leniter cantillat."

# game/a2s3.rpy:428
translate latin a2s3_028f0fde:

    # "I crouch lower in the foliage until I can't even see that."
    "Inferius inter frondes me contraho donec ne illa quidem videre possim."

# game/a2s3.rpy:429
translate latin a2s3_4bcb9725:

    # "I will the cat to just ignore the drone, but the humming stops and so do his footsteps, and I know that he's spotted it."
    "Opto ut feles automaton neglegat; sed cantus vestigiaque cessant, atque scio eum id vidisse."

# game/a2s3.rpy:430
translate latin a2s3_b2db93a1:

    # al "\"Hmm, do you have a stray drone out here, Com?\""
    al "\"Hmm, num automaton tuum hic errat, Com?\""

# game/a2s3.rpy:431
translate latin a2s3_395e81c6:

    # com "\"All drone machinery are accounted for, Alexios.\""
    com "\"Omnes machinae automatariae notae sunt, Alexios.\""

# game/a2s3.rpy:432
translate latin a2s3_65843de9:

    # al "\"What's this one doing?\""
    al "\"Quid hoc agit?\""

# game/a2s3.rpy:433
translate latin a2s3_60b8627f:

    # "I feel my heart stop, swallowing hard."
    "Cor meum subsistere sentio atque aegre deglutio."

# game/a2s3.rpy:434
translate latin a2s3_167504cc:

    # "There's a pause, as if Com is calculating something."
    "Mora fit, velut Com aliquid computet."

# game/a2s3.rpy:435
translate latin a2s3_9e0f1a19:

    # com "\"That information is classified, Alex.\""
    com "\"Haec notitia arcana est, Alex.\""

# game/a2s3.rpy:436
translate latin a2s3_ffa4ea36:

    # al "\"By whom?\""
    al "\"Cuius iussu?\""

# game/a2s3.rpy:437
translate latin a2s3_46622987:

    # com "\"Neferu.\""
    com "\"Neferu.\""

# game/a2s3.rpy:438
translate latin a2s3_40d45b29:

    # "There's a pause, then a chuckle as Alex's footsteps pick up again, moving further away to my left."
    "Post moram risus auditur; vestigia Alex rursus moventur, longius ad sinistram meam recedentia."

# game/a2s3.rpy:439
translate latin a2s3_2d1ab0ce:

    # al "\"Oh, that jackal.\""
    al "\"Oh, chacalus ille.\""

# game/a2s3.rpy:440
translate latin a2s3_c9720e2f:

    # "I'm still holding my breath as I listen to the footsteps fade up the path before slowly rising up from my crouch, glaring at the drone."
    "Adhuc spiritum retineo dum vestigia in semita recedunt; deinde lente e situ contracto surgo et automaton truculenter aspicio."

# game/a2s3.rpy:441
translate latin a2s3_0806f81e:

    # m "\"Tell Neferu that I'm busy, but that I'll be back tonight. I have some things to tell him.\""
    m "\"Dic Neferu me occupatum esse, sed hac nocte rediturum. Quaedam ei dicenda habeo.\""

# game/a2s3.rpy:442
translate latin a2s3_6cb70e13:

    # com "\"Message received. Thank you [mc].\""
    com "\"Nuntius acceptus est. Gratias, [mc].\""

# game/a2s3.rpy:443
translate latin a2s3_3b1ce1f7:

    # m "\"Yeah, no problem.\""
    m "\"Ita, nihil est.\""

# game/a2s3.rpy:444
translate latin a2s3_ccc186fd:

    # "I say it sarcastically as the drone floats off in its slow, lazy way."
    "Id ironice dico, dum automaton lento otiosoque modo avolat."

# game/a2s3.rpy:445
translate latin a2s3_50b32fe0:

    # "At this point, the sun has set completely, and I have to wonder why Alexios has headed in that particular direction, leading either toward the gates of the palace, or the lake."
    "Iam sol omnino occidit; quaero cur Alexios in illam certam partem contenderit, quae aut ad portas palatii aut ad lacum ducit."

# game/a2s3.rpy:446
translate latin a2s3_d121d419:

    # "I follow the path slowly, keeping my eyes peeled for the cat."
    "Lente semitam sequor, oculis felem quaerentibus."

# game/a2s3.rpy:447
translate latin a2s3_a3670907:

    # "At first, I'm almost positive that he would be heading for the gate, maybe on his way to the city."
    "Initio paene certus sum eum ad portam contendere, fortasse in urbem profecturum."

# game/a2s3.rpy:448
translate latin a2s3_c560c87b:

    # "This would be the end of my little mission since I know I can't leave the boundaries of the palace without being...hurt somehow, probably killed."
    "Ita munus meum parvum finiretur, nam scio me e finibus palatii egredi non posse quin...aliquo modo laedar, fortasse interficiar."

# game/a2s3.rpy:450
translate latin a2s3_11959ebd:

    # "But instead, I spot the cat's form, just barely visible in front of the lake, its surface glinting from the light of the moon."
    "Sed felis formam ante lacum vix conspicuam video, cuius superficies lunae luce scintillat."

# game/a2s3.rpy:451
translate latin a2s3_6fa1e399:

    # "I stop and hide behind a tree, making sure that I'm not close to any of the lamp posts."
    "Consisto et post arborem lateo, cavens ne prope ullam columnam luminis sim."

# game/a2s3.rpy:452
translate latin a2s3_e0832dd9:

    # "I watch as Alex moves around under the little gazebo with the watercrafts under it."
    "Alex sub parvo umbraculo, ubi naves servantur, circumire observo."

# game/a2s3.rpy:453
translate latin a2s3_0ca70b0d:

    # "Sure enough, a few minutes later, he comes gliding out on the Sightseer."
    "Et certe, paucis post minutis, in Spectatrice vectus delabitur."

# game/a2s3.rpy:454
translate latin a2s3_642c10c5:

    # "He floats over the shore, then out onto the lake...in the direction of the island."
    "Supra litus fertur, deinde in lacum...ad insulam."

# game/a2s3.rpy:455
translate latin a2s3_1de5f45b:

    # "I know right away that I'm seeing something important."
    "Statim scio me rem gravem videre."

# game/a2s3.rpy:456
translate latin a2s3_de60c42a:

    # "There's nothing on the island for the cat to take care of, as far as I know, and unless he's going out there for a nighttime outing on the beach (extremely doubtful), then he's definitely doing something suspicious."
    "In insula nihil est cui feles, quantum scio, consulere debeat; nisi noctu in litore deambulare vult, quod valde dubium est, certe aliquid suspectum agit."

# game/a2s3.rpy:457
translate latin a2s3_14b2b93f:

    # "I wait for a while, watching as the dark form of the cat and the craft get smaller and smaller until they basically disappear, out in the direction of the island."
    "Aliquantisper exspecto, observans obscuram felis navisque formam minui atque minui, donec fere evanescit versus insulam."

# game/a2s3.rpy:459
translate latin a2s3_0b3eacd5:

    # "Of course, I know I can't follow him out there right now, but I can definitely tell Neferu about it..."
    "Scio quidem me eum nunc illo sequi non posse; sed certe Neferu de hac re certiorem facere possum..."

# game/a2s3.rpy:462
translate latin a2s3_a94e54e2:

    # "Neferu is in his room when I arrive, tapping away at what looks like a transparent tablet."
    "Neferu in cubiculo suo est cum advenio, quod tabula pellucida esse videtur digitis pulsans."

# game/a2s3.rpy:463
translate latin a2s3_0f7de105:

    # "It's an odd thing to see considering the non-existence of portable technology in this palace."
    "Mirum est videre, cum ars portatilis in hoc palatio nulla sit."

# game/a2s3.rpy:464
translate latin a2s3_b94520a5:

    # "Maybe it's a Khemian thing."
    "Fortasse res Khemiana est."

# game/a2s3.rpy:465
translate latin a2s3_4e8bc6c1:

    # "As soon as he sees me though, the display slides back into into the small metal bar that it had been projecting out of as he turns to face me."
    "Simul autem ac me videt, imago in parvam virgam metallicam unde proiecta erat se recipit, dum ille ad me se vertit."

# game/a2s3.rpy:468
translate latin a2s3_dfb0a9a7:

    # n "\"Hello, [mc]. You were gone for quite a while.\""
    n "\"Salve, [mc]. Satis diu aberas.\""

# game/a2s3.rpy:469
translate latin a2s3_7d1f6ae1:

    # m "\"Uh, yeah.\""
    m "\"Eh, ita.\""

# game/a2s3.rpy:471
translate latin a2s3_3eaaca64:

    # n "\"Care to share how your visit went with Cassius and, hopefully, Amicus?\""
    n "\"Visne narrare quomodo visitatio Cassii et, ut spero, Amici evenerit?\""

# game/a2s3.rpy:472
translate latin a2s3_75e0b58a:

    # "It takes me a moment to remember exactly what he's talking about."
    "Paulisper mihi opus est ut quid dicat plane meminerim."

# game/a2s3.rpy:473
translate latin a2s3_9b63365d:

    # "After my little trip, everything that happened before it seems so distant."
    "Post brevem illam visionem omnia quae ante acciderunt tam remota videntur."

# game/a2s3.rpy:474
translate latin a2s3_70fbdc9b:

    # "I try to tell Neferu as much as I remember involving Cassius before the parent thing, and he seems impressed."
    "Neferu quantum memini de Cassio ante rem Parentum narrare conor; ille admiratus videtur."

# game/a2s3.rpy:476
translate latin a2s3_c794ba4a:

    # n "\"Hm, I suppose bringing Cassius to our side won't be as difficult as I had previously thought. It seems he has similar misgivings about Cato.\""
    n "\"Hm, puto Cassium nobis conciliare non tam difficile fore quam antea putaveram. Similes de Catone suspiciones habere videtur.\""

# game/a2s3.rpy:477
translate latin a2s3_5d26a9db:

    # m "\"Yeah, and Amicus is doing okay, just a bit depressed about everything that's happening, obviously.\""
    m "\"Ita; Amicus quoque bene se habet, tantum de omnibus quae fiunt paulum tristis est, ut patet.\""

# game/a2s3.rpy:478
translate latin a2s3_ad277b9e:

    # "I pause then, which Neferu notices."
    "Tum haereo, quod Neferu animadvertit."

# game/a2s3.rpy:480
translate latin a2s3_0e424b69:

    # n "\"Is there something else that happened?\""
    n "\"Num aliud aliquid accidit?\""

# game/a2s3.rpy:481
translate latin a2s3_2d6e9d1a:

    # "I take a deep breath, thinking how best to describe what I went through."
    "Alte spiro, quaerens quomodo optime quae expertus sum describam."

# game/a2s3.rpy:482
translate latin a2s3_761a4a6f:

    # m "\"Well, when I was coming back, there was this weird smell coming from the meditation room...\""
    m "\"Cum redirem, mirus quidam odor e conclavi meditationis veniebat...\""

# game/a2s3.rpy:484
translate latin a2s3_dbf18efa:

    # "Neferu raises an eyebrow and I go on to explain how I'd ran into Cassius again, then everything that happened afterwards."
    "Neferu supercilium tollit; explicare pergo quomodo rursus Cassium offenderim, deinde omnia quae post acciderunt."

# game/a2s3.rpy:485
translate latin a2s3_ff8d4d14:

    # "When I finish, the jackal is quiet, just watching me with a narrowed gaze."
    "Cum finio, chacalus tacet et me contracto vultu observat."

# game/a2s3.rpy:486
translate latin a2s3_cd12aeec:

    # "This is usually the look he gives me when he's thinking hard about something, so I give him some time to respond."
    "Hunc vultum plerumque ostendit cum rem alte cogitat; itaque aliquantum temporis ei ad respondendum do."

# game/a2s3.rpy:487
translate latin a2s3_8a672997:

    # "When he does, it's hesitant and reserved, not usually something I hear from Neferu."
    "Cum respondet, cunctans atque reservatus est, quod a Neferu audire non soleo."

# game/a2s3.rpy:489
translate latin a2s3_b46c039a:

    # n "\"So it was a drug-induced hallucination, yes?\""
    n "\"Ergo visio medicamento allata erat, nonne?\""

# game/a2s3.rpy:490
translate latin a2s3_5daaa888:

    # m "\"Well, I guess so, but I think it was real too. Like, Cassius was there, and he remembers seeing me with him.\""
    m "\"Puto ita, sed veram quoque fuisse credo. Cassius enim ibi erat; meminit se me secum vidisse.\""

# game/a2s3.rpy:491
translate latin a2s3_87959007:

    # n "\"Hmm...\""
    n "\"Hmm...\""

# game/a2s3.rpy:492
translate latin a2s3_3c6a4d52:

    # m "\"What's wrong?\""
    m "\"Quid mali est?\""

# game/a2s3.rpy:494
translate latin a2s3_ebb48fdf:

    # n "\"Well, that is a very...primitive way to contact the parents. To put it bluntly, it does not work. It was a method used in the early days, during First Contact between sibling and parent.\""
    n "\"Satis...rudis via Parentibus communicandi est. Aperte dicam: non valet. In primis diebus haec ratio adhibebatur, tempore Primi Contactus inter Fratrem atque Parentem.\""

# game/a2s3.rpy:495
translate latin a2s3_af0f2387:

    # n "\"They visited multiple times and in between visits some siblings, especially the wolves, would try to contact them again via psychotropic drug use. This could occasionally bring visions of higher beings, though they were not the parents, of course—\""
    n "\"Aliquotiens venerunt; inter visitationes quidam Fratres, praesertim Lupi, rursus cum eis communicare conabantur medicamentis animum mutantibus usi. Interdum superiorum entium visiones afferebantur; non tamen Parentes erant, sane—\""

# game/a2s3.rpy:496
translate latin a2s3_8c760ca8:

    # n "\"—simply imagined beings conjured up by a chemically-imbalanced brain.\""
    n "\"—tantum entia ficta, quae cerebrum chemice perturbatum finxerat.\""

# game/a2s3.rpy:497
translate latin a2s3_bba76c1a:

    # n "\"This is likely what you experienced.\""
    n "\"Hoc fortasse expertus es.\""

# game/a2s3.rpy:499
translate latin a2s3_9381e4eb:

    # n "\"To truly contact the parents you must do it through parental tech; complicated machinery that is able to transcend dimensions.\""
    n "\"Ut vere cum Parentibus communicare possis, arte Parentum uti debes: machinis intricatis quae dimensiones transcendere possunt.\""

# game/a2s3.rpy:500
translate latin a2s3_d071f605:

    # n "\"It is usually only usable by a single person, such as the emperor for the wolves or the pharaoh for my people.\""
    n "\"Plerumque unus tantum ea uti potest, velut imperator Luporum aut Pharao gentis meae.\""

# game/a2s3.rpy:501
translate latin a2s3_62ae0fbc:

    # "Neferu stops talking at this point, allowing me to take all that information in."
    "Tum Neferu tacet, ut hanc omnem notitiam intellegere possim."

# game/a2s3.rpy:502
translate latin a2s3_20552333:

    # "So maybe I had imagined it all...even if it had seemed so real."
    "Fortasse igitur omnia finxeram...quamquam tam vera visa erant."

# game/a2s3.rpy:503
translate latin a2s3_69f43a32:

    # m "\"They told me they had a plan for me and everything.\""
    m "\"Dixerunt se consilium de me omnibusque rebus habere.\""

# game/a2s3.rpy:505
translate latin a2s3_5fe7770c:

    # n "\"Often times such drugs stroke the ego of the user. They make you feel as if you are at the center of the universe, as if you are important...not saying that you aren't.\""
    n "\"Saepe talia medicamenta sui amorem fovent. Te velut in universi medio, velut magnum aliquid esse sentire faciunt...non quod te nihil valere dicam.\""

# game/a2s3.rpy:506
translate latin a2s3_72a7a166:

    # m "\"Have you tried it before?\""
    m "\"Antea expertus es?\""

# game/a2s3.rpy:508
translate latin a2s3_8f053829:

    # n "\"I've had brushes with such substances in my youth. Good for experiencing the fragility of reality and how we perceive it...but little else.\""
    n "\"Adulescens aliquantum talibus rebus usus sum. Bonae sunt ad fragilitatem rerum verarum atque perceptionis nostrae experiendam...sed ad parum aliud.\""

# game/a2s3.rpy:509
translate latin a2s3_0746d850:

    # m "\"I see.\""
    m "\"Intellego.\""

# game/a2s3.rpy:511
translate latin a2s3_9881b883:

    # n "\"Still, it sounds like you caught Cassius in a moment of vulnerability. He could trust you more because of it, if you treated the situation delicately.\""
    n "\"Tamen Cassium tempore infirmitatis offendisse videris. Inde tibi magis confidere possit, si rem delicate tractasti.\""

# game/a2s3.rpy:512
translate latin a2s3_8b3cd524:

    # m "\"Eh, maybe.\""
    m "\"Hem, fortasse.\""

# game/a2s3.rpy:513
translate latin a2s3_225eba54:

    # "I think back to when I saw him crying in front of the statue, but I don't want to tell Neferu about that, not really feeling it would be all that useful...or appropriate to share."
    "Memoria repeto eum ante statuam flentem, sed Neferu hoc narrare nolo: neque utile neque aptum communicatu esse sentio."

# game/a2s3.rpy:514
translate latin a2s3_4b7395dc:

    # "But this reminds me of what else the \"parents\" had said to me."
    "Id tamen mihi in memoriam revocat quid aliud \"Parentes\" mihi dixerint."

# game/a2s3.rpy:515
translate latin a2s3_eeff0b6f:

    # m "\"Well, they also told me something else; to watch Alex.\""
    m "\"Aliud quoque mihi dixerunt: Alex observarem.\""

# game/a2s3.rpy:517
translate latin a2s3_d09b5451:

    # n "\"Did they now?\""
    n "\"Ita dixerunt?\""

# game/a2s3.rpy:518
translate latin a2s3_7825d8aa:

    # m "\"Yeah, and I did. He's been acting weird ever since I got here, so I spied on him today and he sailed off to the island in the middle of the lake just now.\""
    m "\"Ita, atque feci. Ex quo huc veni mire agit; hodie eum speculatus sum, et modo ad insulam in medio lacu navigavit.\""

# game/a2s3.rpy:520
translate latin a2s3_282c0859:

    # "Neferu's got a strange, knowing smile on his face."
    "Neferu mirum quendam risum ostendit, velut rem iam sciat."

# game/a2s3.rpy:521
translate latin a2s3_df8ec4bc_1:

    # m "\"What?\""
    m "\"Quid?\""

# game/a2s3.rpy:522
translate latin a2s3_5358b849:

    # n "\"I just find it interesting that you have similar suspicions of Alex that I did.\""
    n "\"Miror tantum te similes de Alex suspiciones habere atque ego habui.\""

# game/a2s3.rpy:523
translate latin a2s3_9d3344cb_1:

    # m "\"What do you mean?\""
    m "\"Quid dicis?\""

# game/a2s3.rpy:524
translate latin a2s3_75ef5a57:

    # n "\"I've been studying the cat myself and noticed a few odd things as well, including his trips to the island.\""
    n "\"Ipse quoque felem observavi et nonnulla mira animadverti, etiam itinera eius ad insulam.\""

# game/a2s3.rpy:525
translate latin a2s3_e499761a_1:

    # "I frown."
    "Frontem contraho."

# game/a2s3.rpy:526
translate latin a2s3_2d5bfaf9:

    # m "\"What? And you didn't tell me?\""
    m "\"Quid? Et mihi non dixisti?\""

# game/a2s3.rpy:528
translate latin a2s3_ca79440d:

    # n "\"Well, this rather desperate situation we're in only came about very recently, and I had little use for this information until now.\""
    n "\"Haec condicio tam desperata in qua sumus nuper tantum orta est; haec notitia mihi antehac parum utilis erat.\""

# game/a2s3.rpy:529
translate latin a2s3_043ca616:

    # m "\"Well, what do you think he's doing?\""
    m "\"Quid igitur eum facere putas?\""

# game/a2s3.rpy:530
translate latin a2s3_41b86fe4:

    # "Neferu shrugs."
    "Neferu umeros attollit."

# game/a2s3.rpy:532
translate latin a2s3_aeaac5a1:

    # n "\"I don't know as I've not yet followed him to the island. You can imagine that I'm planning to now that we could use Alex on our side as well.\""
    n "\"Nescio, nam eum ad insulam nondum secutus sum. Potes intellegere me id nunc facere velle, cum Alex quoque nobis conciliare utile sit.\""

# game/a2s3.rpy:533
translate latin a2s3_962e8e11:

    # m "\"Turn everyone against Cato?\""
    m "\"Omnes contra Catonem convertere?\""

# game/a2s3.rpy:535
translate latin a2s3_d0c65d3d:

    # n "\"Yes.\""
    n "\"Ita.\""

# game/a2s3.rpy:536
translate latin a2s3_7d658e30:

    # m "\"So if he's doing something...bad, then we would use it as blackmail?\""
    m "\"Si igitur aliquid...malum facit, hoc eum coercere possumus?\""

# game/a2s3.rpy:537
translate latin a2s3_7baa2692:

    # n "\"Essentially. He is the closest person to Cassius and could possibly grant us access to classified information.\""
    n "\"Fere. Proximus Cassio est; fortasse ad arcana cognoscenda nobis aditum praebere possit.\""

# game/a2s3.rpy:538
translate latin a2s3_7606b520:

    # "I sigh, growing weary of all this backstabbing."
    "Suspiro, tot fraudibus atque proditionibus defessus."

# game/a2s3.rpy:539
translate latin a2s3_9c6a0131:

    # m "\"If it's the only way to help Amicus, I guess.\""
    m "\"Si sola via est qua Amicum adiuvemus, ut puto.\""

# game/a2s3.rpy:540
translate latin a2s3_f5b60196:

    # n "\"Oh, there are many ways, and I have a last resort plan in place.\""
    n "\"Multae viae sunt; consilium quo in extrema necessitate utar iam paratum habeo.\""

# game/a2s3.rpy:541
translate latin a2s3_0ad3065e:

    # "I wait, but Neferu doesn't go on."
    "Exspecto, sed Neferu non pergit."

# game/a2s3.rpy:542
translate latin a2s3_51752a77:

    # m "\"Which is?\""
    m "\"Quodnam?\""

# game/a2s3.rpy:544
translate latin a2s3_d46621e4:

    # n "\"Well, considering Amicus's birthright, he still has the ability to challenge whoever is on the throne, but—\""
    n "\"Amicus, iure natalium suorum, eum qui in solio sedet adhuc provocare potest; sed—\""

# game/a2s3.rpy:545
translate latin a2s3_0b4eb0fa:

    # m "\"Really?\""
    m "\"Revera?\""

# game/a2s3.rpy:546
translate latin a2s3_85fd2a50:

    # "All this time Amicus could have just challenged Cassius again?"
    "Totum hoc tempus Amicus Cassium rursus provocare poterat?"

# game/a2s3.rpy:547
translate latin a2s3_d4e88461:

    # "Then I realize that Neferu was about to go on."
    "Deinde intellego Neferu sermonem continuaturum fuisse."

# game/a2s3.rpy:548
translate latin a2s3_894de8f4:

    # m "\"But what?\""
    m "\"Sed quid?\""

# game/a2s3.rpy:549
translate latin a2s3_4d3539da:

    # n "\"A fight to the death, since the wolves love their violence, though the emperor would have to accept the challenge.\""
    n "\"Certamen ad mortem: Lupi enim vim suam amant. Imperator tamen provocationem accipere debet.\""

# game/a2s3.rpy:550
translate latin a2s3_9b2ca29d:

    # "The thought of that instantly makes me feel sick."
    "Haec cogitatio statim me nauseantem facit."

# game/a2s3.rpy:551
translate latin a2s3_c594807f:

    # m "\"No way.\""
    m "\"Minime.\""

# game/a2s3.rpy:552
translate latin a2s3_3a616230:

    # n "\"Again, last resort. I doubt Amicus would challenge his own brother, and I doubt Cassius would accept...at least at the moment.\""
    n "\"Ut dixi, extrema ratio est. Dubito an Amicus fratrem suum provocet, atque an Cassius accipiat...saltem nunc.\""

# game/a2s3.rpy:553
translate latin a2s3_f3c853be:

    # "I can't even begin to contemplate a situation like that, and Neferu quickly changes the subject."
    "Ne talem quidem condicionem cogitare possum; Neferu celeriter sermonem mutat."

# game/a2s3.rpy:555
translate latin a2s3_b2545451:

    # n "\"Anyway, I should be off. I'd like to catch Alex in the act and based on previous observations I've made, I have another hour to do so.\""
    n "\"Ceterum, proficisci debeo. Alex in ipso facto deprehendere volo; ex iis quae ante observavi, aliam horam ad id faciendum habeo.\""

# game/a2s3.rpy:556
translate latin a2s3_580d26ec:

    # "I blink in surprise."
    "Admiratus oculos nictor."

# game/a2s3.rpy:557
translate latin a2s3_ae6802de:

    # m "\"Right now? Shouldn't we wait until like...tomorrow night?\""
    m "\"Nunc? Nonne exspectare debemus usque ad...cras noctu?\""

# game/a2s3.rpy:558
translate latin a2s3_22c273f1:

    # n "\"He only goes once a week. Considering how urgent our situation is, I should get this done now.\""
    n "\"Semel tantum in hebdomade it. Cum res nostra tam urgeat, nunc perficiendum est.\""

# game/a2s3.rpy:559
translate latin a2s3_a079e3a6:

    # m "\"Can I go too?\""
    m "\"Ego quoque ire possum?\""

# game/a2s3.rpy:561
translate latin a2s3_98a445e3:

    # n "\"[mc], remember what I said about needing to keep you safe?\""
    n "\"[mc], meministine quae de te tuto servando dixi?\""

# game/a2s3.rpy:562
translate latin a2s3_a3075234:

    # m "\"Yeah, and it's Alex. What's he gonna do?\""
    m "\"Memini; sed Alex est. Quid facere potest?\""

# game/a2s3.rpy:563
translate latin a2s3_a67f1180:

    # n "\"We should be prepared for anything.\""
    n "\"Ad omnia parati esse debemus.\""

# game/a2s3.rpy:564
translate latin a2s3_5af27dfd:

    # m "\"Well, I think it's better if we both go, in case something {i}does{/i} happen and you need my help.\""
    m "\"Puto tamen melius esse si ambo eamus, si quid {i}re vera{/i} accidat atque auxilio meo egeas.\""

# game/a2s3.rpy:565
translate latin a2s3_5c4223ed:

    # "Neferu lets out a soft sigh."
    "Neferu leniter suspirat."

# game/a2s3.rpy:567
translate latin a2s3_cf4e5756:

    # n "\"Alright.\""
    n "\"Bene.\""

# game/a2s3.rpy:568
translate latin a2s3_9aa34d32:

    # "I'm surprised by how quickly he gives in."
    "Miror eum tam celeriter cedere."

# game/a2s3.rpy:569
translate latin a2s3_1c57a4aa:

    # n "\"I suppose you deserve to be treated as an equal in these plans we're making.\""
    n "\"Puto te ut parem in consiliis quae facimus haberi mereri.\""

# game/a2s3.rpy:571
translate latin a2s3_d3e6d46b:

    # n "\"Though if Amicus finds out I'm bringing you on these missions he'll have my hide.\""
    n "\"Sed si Amicus cognoscet me te ad haec munera ducere, pellem mihi detrahet.\""

# game/a2s3.rpy:572
translate latin a2s3_06d9a076:

    # m "\"I'll let him know I wanted to be part of it.\""
    m "\"Dicam ei me partem agere voluisse.\""

# game/a2s3.rpy:573
translate latin a2s3_057d75aa:

    # n "\"Mhm, as if that will convince him. Anyway, let's be off.\""
    n "\"Mhm, quasi id ei persuadeat. Ceterum, eamus.\""

# game/a2s3.rpy:574
translate latin a2s3_1f228d29:

    # m "\"Okay.\""
    m "\"Bene.\""

# game/a2s3.rpy:576
translate latin a2s3_99ececab:

    # "My excitement picks up as I get to my feet and follow Neferu to the door."
    "Animus meus excitatur, dum surgo atque Neferu ad ianuam sequor."

# game/a2s3.rpy:578
translate latin a2s3_6b465ff7:

    # n "\"If we run into anyone, especially Cato, we simply tell them we're out for an evening stroll, understood?\""
    n "\"Si quem offendemus, praesertim Catonem, tantum dicemus nos vesperi deambulare, intellegis?\""

# game/a2s3.rpy:579
translate latin a2s3_08fec879:

    # m "\"Yep!\""
    m "\"Intellego!\""

# game/a2s3.rpy:580
translate latin a2s3_530a7084:

    # "Despite the potentially dangerous situation we're going into, my mood is lifted knowing that things are finally moving again."
    "Quamquam ad rem fortasse periculosam contendimus, laetor quod tandem res rursus procedunt."

# game/a2s3.rpy:584
translate latin a2s3_3179fd09:

    # "Luckily, there's another Sightseer craft in the gazebo, though it looks much older and the floor on this one isn't transparent, which I'm fine with."
    "Feliciter alia Spectatrix sub umbraculo est, quamquam multo antiquior videtur et huius pavimentum non est pellucidum, quod mihi placet."

# game/a2s3.rpy:585
translate latin a2s3_13399214:

    # "I'd rather not gaze into the inky-blackness of the water beneath my feet while sailing to the island."
    "Malo non aquae atram nigredinem sub pedibus spectare dum ad insulam navigamus."

# game/a2s3.rpy:586
translate latin a2s3_e38dc29b:

    # "Neferu is quiet most of the time, looking confident in everything he does as he prepares the craft."
    "Neferu plerumque tacet atque omnia quae facit confidenter agit, dum navem parat."

# game/a2s3.rpy:587
translate latin a2s3_56f6a2ba:

    # "Finally, he reaches out his paw to chivalrously pull me on board."
    "Tandem manum porrigit ut me comiter in navem trahat."

# game/a2s3.rpy:588
translate latin a2s3_266781e6:

    # "The lake laps quietly around us as we approach the island; a black mass amongst the ripples of reflected moonlight in the waves."
    "Lacus leniter circa nos fluctuat, dum ad insulam accedimus, obscuram molem inter undas lunae lumen referentes."

# game/a2s3.rpy:589
translate latin a2s3_9cea541c:

    # "I immediately spot Alex's craft sitting on the beach near where we'd had our little picnic all those weeks ago."
    "Statim navem Alex in litore video, prope locum ubi ante tot hebdomades parvum prandium foris egimus."

# game/a2s3.rpy:590
translate latin a2s3_c062703d:

    # "We travel a little further up the shore, out of sight of the craft before we drift onto the beach."
    "Paulo longius litus sequimur, extra conspectum illius navis; deinde in litus delabimur."

# game/a2s3.rpy:592
translate latin a2s3_be9c1a39:

    # "Neferu holds out a paw again to help me down, even though I don't need it."
    "Neferu rursus manum porrigit ut me descendentem adiuvet, quamquam non egeo."

# game/a2s3.rpy:593
translate latin a2s3_38fdfa2c:

    # "As I settle on the sand though, he leans in close to whisper in my ear."
    "Sed cum in arena consisto, propius se inclinat ut in aurem susurret."

# game/a2s3.rpy:595
translate latin a2s3_419ca6cf:

    # n "\"Wait here. Unfortunately, I believe simian footfalls are louder than that of a jackal.\""
    n "\"Hic exspecta. Infeliciter puto vestigia simiorum clariora esse quam chacali.\""

# game/a2s3.rpy:596
translate latin a2s3_c534a951:

    # m "\"Okay...but call me if something happens, or you need help.\""
    m "\"Bene...sed voca me si quid accidit aut auxilio eges.\""

# game/a2s3.rpy:598
translate latin a2s3_ef2a7f8f:

    # "I see a smile on Neferu's face, and though it's amused, it's not in a condescending way at all."
    "Risum in vultu Neferu video; quamquam hilaris est, minime superbus est."

# game/a2s3.rpy:599
translate latin a2s3_727c6bc3:

    # n "\"Of course, my friend.\""
    n "\"Certe, amice mi.\""

# game/a2s3.rpy:601
translate latin a2s3_dd0b3514:

    # "And with that, the jackal disappears into the night, leaving me with only the little craft and the gentle sounds of the waves to keep me company."
    "His dictis, chacalus in noctem evanescit, me cum parva tantum nave atque lenibus undarum sonis relinquens."

# game/a2s3.rpy:602
translate latin a2s3_f9da8564:

    # "I don't have to wait long before I hear voices coming from further up the beach, and I know right away that it's Neferu and Alex."
    "Non diu exspecto antequam voces a superiore litore audio; statim scio Neferu atque Alex esse."

# game/a2s3.rpy:603
translate latin a2s3_2ec4a2e8:

    # "I wait for a few moments to see if Neferu will call my name."
    "Aliquot momenta exspecto ut videam an Neferu nomen meum vocet."

# game/a2s3.rpy:604
translate latin a2s3_1c4e1b96:

    # "When he doesn't, I frown and look around before quietly making my way toward the voices."
    "Cum non facit, frontem contraho atque circumspicio, deinde tacitus ad voces contendo."

# game/a2s3.rpy:605
translate latin a2s3_1fd1921c:

    # "It's not like I expect he needs my help, but I don't want to miss anything important, and I feel like the moment of confrontation with Alex should involve me."
    "Non puto eum auxilio meo egere; sed nihil grave praeterire volo atque sentio me quoque cum Alex agendi participem esse debere."

# game/a2s3.rpy:606
translate latin a2s3_0ab56287:

    # "As I get closer, I'm able to make out the words, and I see that the two of them are right on the edge of the woods, standing just a few feet apart."
    "Cum propius accedo, verba discernere possum; eos in ipso silvae margine, paucis tantum pedibus inter se distantes, video."

# game/a2s3.rpy:607
translate latin a2s3_5b6c992a:

    # "I crouch and hide along the tree line as I listen more closely to what they're saying."
    "Me contraho atque inter arbores lateo, verba eorum diligentius audiens."

# game/a2s3.rpy:609
translate latin a2s3_956ca017:

    # n "\"—beautiful night. I've always wanted to come to the island to gaze at the moon and planet, away from the lights of the palace.\""
    n "\"—pulchra nox. Semper ad insulam venire volui ut lunam planetamque aspicerem, procul a palatii luminibus.\""

# game/a2s3.rpy:611
translate latin a2s3_f8fed1a7:

    # al "\"Ohh, I see. It is incredibly beautiful here, isn't it?\""
    al "\"Ahh, intellego. Hic incredibiliter pulchrum est, nonne?\""

# game/a2s3.rpy:612
translate latin a2s3_9113e865:

    # "While he's speaking in his typical, pleasant tone, I can definitely tell that Alex seems a bit nervous, his voice tight and a bit out of breath."
    "Quamquam solita voce iucunda loquitur, plane intellego Alex paulum anxium esse, voce intenta ac paulum anhela."

# game/a2s3.rpy:614
translate latin a2s3_3fd05764:

    # n "\"So...\""
    n "\"Ergo...\""

# game/a2s3.rpy:616
translate latin a2s3_2081b889:

    # al "\"Yes?\""
    al "\"Volui?\""

# game/a2s3.rpy:617
translate latin a2s3_07b65026:

    # "Alex looks around nervously."
    "Alex anxius circumspicit."

# game/a2s3.rpy:619
translate latin a2s3_bee043c8:

    # n "\"I heard you speaking just before I happened upon you. Is there someone else with you?\""
    n "\"Te loquentem audivi paulo antequam offendi. Num alius tecum est?\""

# game/a2s3.rpy:621
translate latin a2s3_b2032c3b:

    # al "\"Me? Oh no, definitely not! You know, it's rather embarrassing, but sometimes I just talk to myself.\""
    al "\"Mecum? Minime, certe non! Aliquantum pudendum est, sed interdum mecum loquor.\""

# game/a2s3.rpy:623
translate latin a2s3_bd50f1a7:

    # n "\"Don't be embarrassed, it's something I do as well.\""
    n "\"Noli pudere; ipse quoque id facio.\""

# game/a2s3.rpy:625
translate latin a2s3_af012a97:

    # al "\"O—oh, I see.\""
    al "\"A—ah, intellego.\""

# game/a2s3.rpy:626
translate latin a2s3_538388df:

    # "Alex seems to be relaxing a bit under Neferu's treatment, but tenses up again at the next sentence."
    "Alex sermone Neferu paulum relaxari videtur, sed proxima sententia rursus intenditur."

# game/a2s3.rpy:628
translate latin a2s3_16dde21c:

    # n "\"Though I usually don't whisper to trees. Now THAT is a bit odd.\""
    n "\"Quamquam arboribus susurrare non soleo. ILLUD quidem paulo mirum est.\""

# game/a2s3.rpy:630
translate latin a2s3_fb58ceda:

    # al "\"...\""
    al "\"...\""

# game/a2s3.rpy:631
translate latin a2s3_394a0668:

    # "I see Alex's ears flatten, though I'm a bit confused at the statement."
    "Aures Alex demitti video, quamquam sententia paulum me confundit."

# game/a2s3.rpy:632
translate latin a2s3_1eb4c6e5:

    # "Whispering to trees?"
    "Arboribus susurrare?"

# game/a2s3.rpy:633
translate latin a2s3_ee6daf71:

    # al "\"I—I...\""
    al "\"Ego—ego...\""

# game/a2s3.rpy:634
translate latin a2s3_585527b2:

    # "Alex doesn't seem to have an answer ready and stutters in the most guilty way imaginable."
    "Alex responsum paratum habere non videtur et balbutit velut maxime conscius culpae."

# game/a2s3.rpy:635
translate latin a2s3_b9bbe60a:

    # "Weirdly enough though, he sidles up closer to Neferu."
    "Mire tamen propius ad Neferu se insinuat."

# game/a2s3.rpy:638
translate latin a2s3_7912fc41:

    # al "\"N—Neferu, you're the one that's acting a bit odd right now, you know.\""
    al "\"N—Neferu, tu nunc paulum mire agis, scisne.\""

# game/a2s3.rpy:639
translate latin a2s3_3052a070:

    # "The small cat's demeanor suddenly changes to a more...sultry approach, relaxing his shoulders and drifting a paw down his body."
    "Parvae felis habitus subito in magis...illecebrosum modum mutatur, umeris relaxatis manuque per corpus demissa."

# game/a2s3.rpy:640
translate latin a2s3_1e6abdb1:

    # "It doesn't seem natural at all though, unlike Neferu's smile as he stares down at the approaching cat."
    "Minime tamen naturalis videtur, contra quam risus Neferu, qui desuper felem accedentem aspicit."

# game/a2s3.rpy:641
translate latin a2s3_3c19be9e:

    # "He's still smiling when Alex reaches up to cup his cheeks and kiss him right on the lips."
    "Adhuc arridet cum Alex manus ad genas eius admovet atque recta in labris eum osculatur."

# game/a2s3.rpy:642
translate latin a2s3_50aea7da:

    # "I blink, surprised at the sudden turn this scenario has taken."
    "Admiratus oculos nictor, subita huius rei mutatione percussus."

# game/a2s3.rpy:643
translate latin a2s3_c8462a06:

    # "Neferu looks anything but surprised though, grinning throughout the kiss as Alex tries to kiss deeper."
    "Neferu autem minime admiratus videtur; per totum osculum arridet, dum Alex altius osculari conatur."

# game/a2s3.rpy:644
translate latin a2s3_65d0b463:

    # "Finally, the cat seems to notice the lack of response from the jackal and he draws back, frowning."
    "Tandem feles chacalo non respondenti attendere videtur atque recedit, fronte contracta."

# game/a2s3.rpy:646
translate latin a2s3_aafda3e6:

    # "Neferu shakes his head."
    "Neferu caput quatit."

# game/a2s3.rpy:648
translate latin a2s3_4a8b1034:

    # n "\"Oh Alex, you know that's my technique. It will not work on me. Now why don't we have a look at that tree?\""
    n "\"Oh, Alex, scis hanc meam artem esse. In me non valebit. Cur nunc arborem illam non aspiciamus?\""

# game/a2s3.rpy:650
translate latin a2s3_2d450de7:

    # "Alex freezes up, looking around, and that's when I think he spots me."
    "Alex rigidus fit et circumspicit; tum me conspicere videtur."

# game/a2s3.rpy:652
translate latin a2s3_d411ebe1:

    # al "\"Who—who's that?\""
    al "\"Q—quis ille est?\""

# game/a2s3.rpy:654
translate latin a2s3_e3b905f1:

    # "Neferu turns his head just slightly in my direction, and that's when Alex makes his move."
    "Neferu caput paulum in meam partem vertit; tum Alex agit."

# game/a2s3.rpy:658
translate latin a2s3_c17847e4:

    # "He sends a kick sailing between the jackal's legs, and just as I'm readying myself to intervene, Neferu's paw is there, solidly stopping the attack."
    "Calcem inter crura chacali mittit; dum intervenire paror, manus Neferu iam adest atque impetum firmiter prohibet."

# game/a2s3.rpy:659
translate latin a2s3_7a3b51f6:

    # "There's a pause, Neferu holding Alex's leg, forcing him to balance on one foot as the jackal's smile turns smug."
    "Mora fit: Neferu crus Alex tenet eumque uno pede stare cogit, risu in superbam hilaritatem mutato."

# game/a2s3.rpy:660
translate latin a2s3_c08ac8b6:

    # n "\"What a pity that you're not the first to try such a move on me. I've learned people on this moon fight dirty.\""
    n "\"Quam triste quod non primus hunc motum in me temptas. Didici homines huius lunae improbe pugnare.\""

# game/a2s3.rpy:661
translate latin a2s3_e24953f0:

    # "Alex squeaks, but balls up a fist anyway, sending a straight punch square into Neferu's stomach."
    "Alex stridet, tamen pugnum contrahit atque recta in ventrem Neferu ferit."

# game/a2s3.rpy:663
translate latin a2s3_1bea7051:

    # "It connects with a hollow thud, bouncing off the jackal's abs like they're made of bricks, Neferu only grunting slightly in response."
    "Cavo pulsu contingit et a musculis ventris chacali resilit quasi lateres sint; Neferu leniter tantum fremit."

# game/a2s3.rpy:664
translate latin a2s3_275e7892:

    # n "\"Oof! Now that's a bit more like it!\""
    n "\"Oof! Hoc iam paulo melius est!\""

# game/a2s3.rpy:667
translate latin a2s3_ac168f12:

    # "Suddenly, Neferu uses a leg to sweep Alex's only foot off the ground, sending the cat onto his back in the sand."
    "Neferu subito crure solum pedem Alex ab humo everrit; feles supinus in arenam cadit."

# game/a2s3.rpy:668
translate latin a2s3_b96a7b0f:

    # "Neferu follows him down, pinning the cat there, almost engulfing Alex with his much bigger body."
    "Neferu eum sequitur ac ibi premit, multo maiore corpore Alex paene totum tegens."

# game/a2s3.rpy:670
translate latin a2s3_0e6edf73:

    # al "\"Ah! Get—get off me! Help!\""
    al "\"Ah! R—recede a me! Auxilium!\""

# game/a2s3.rpy:672
translate latin a2s3_03b468a5:

    # "Alex spots me as I come out into the open, standing next to the two of them."
    "Alex me videt cum e latebris prodeo atque iuxta ambos consisto."

# game/a2s3.rpy:673
translate latin a2s3_76b17575:

    # al "\"[mc]! Help me! The jackal's gone mad!\""
    al "\"[mc]! Adiuva me! Chacalus insanit!\""

# game/a2s3.rpy:674
translate latin a2s3_0d363baf:

    # "I fold my arms and stand over him, and Alex quickly realizes that I'm definitely not here to help him."
    "Brachia consero atque supra eum sto; Alex mox intellegit me certe non ad eum adiuvandum adesse."

# game/a2s3.rpy:676
translate latin a2s3_729ac122:

    # al "\"What are you two doing!? I told you I know nothing [mc], why must you keep attacking me like this!?\""
    al "\"Quid ambo facitis!? Dixi me nihil scire, [mc]; cur semper ita me oppugnatis!?\""

# game/a2s3.rpy:677
translate latin a2s3_e1c6deb3:

    # "Alex continues to struggle meekly under the jackal, not even looking like he's trying to escape."
    "Alex sub chacalo debiliter luctari pergit, ne effugere quidem conari visus."

# game/a2s3.rpy:679
translate latin a2s3_4004b731:

    # n "\"Attack {i}you{/i}? Then why is it {i}my{/i} stomach that is sore?\""
    n "\"{i}Te{/i} oppugnare? Cur igitur {i}meus{/i} venter dolet?\""

# game/a2s3.rpy:680
translate latin a2s3_633b7772:

    # "Alex doesn't seem to be listening and tears start brimming in his eyes as he begins to sob."
    "Alex audire non videtur; oculi eius lacrimis implentur et flere incipit."

# game/a2s3.rpy:681
translate latin a2s3_7650205b:

    # "Now I'm fully convinced that his sobs in the bathing room were all an act."
    "Iam plane persuasum habeo fletum eius in balneo omnem simulatum fuisse."

# game/a2s3.rpy:683
translate latin a2s3_d168a122:

    # n "\"[mc].\""
    n "\"[mc].\""

# game/a2s3.rpy:684
translate latin a2s3_e3f17ba3:

    # "I turn my attention back to Neferu who's still smiling as always."
    "Rursus Neferu aspicio, qui ut semper adhuc arridet."

# game/a2s3.rpy:685
translate latin a2s3_9648c2c0:

    # n "\"About ten paces directly in front of me is a large tree, larger than the others that surround it. Do you see it?\""
    n "\"Decem fere passibus recta ante me magna arbor est, maior ceteris circumstantibus. Videsne?\""

# game/a2s3.rpy:686
translate latin a2s3_074f0183:

    # "I look ahead and immediately see what Neferu's talking about, the tree noticeably larger than the others, its branches stretching dozens of feet into the air, the leaves looking like silver in the moonlight."
    "Ante me aspicio et statim quod Neferu dicit video: arbor manifeste maior est, ramis plurimos pedes in aerem porrectis, foliis in lunae luce argento similibus."

# game/a2s3.rpy:687
translate latin a2s3_499b85ea_1:

    # m "\"Yes.\""
    m "\"Ita.\""

# game/a2s3.rpy:688
translate latin a2s3_1c3e5518:

    # n "\"Go up to it, circle it, see if you can find a hollow.\""
    n "\"Ad eam accede, circumambula atque vide an cavum invenias.\""

# game/a2s3.rpy:689
translate latin a2s3_bfec77e2:

    # "I do as I'm told, feeling a little apprehensive as I step just inside the dark woods."
    "Quod iubetur facio, paulum metuens dum in obscuram silvam ingredior."

# game/a2s3.rpy:691
translate latin a2s3_3b645b7b:

    # al "\"Wait...Neferu, [mc], I don't understand...why are you doing this?\""
    al "\"Exspectate...Neferu, [mc], non intellego...cur hoc facitis?\""

# game/a2s3.rpy:692
translate latin a2s3_76ec2842:

    # "I realize at that moment how much I'm trusting Neferu here."
    "Tum intellego quantum hic Neferu confidam."

# game/a2s3.rpy:693
translate latin a2s3_78b48531:

    # "I have no idea what's happening at all."
    "Quid fiat prorsus nescio."

# game/a2s3.rpy:694
translate latin a2s3_89d7ba99:

    # "The trunk of the tree is thick, enough that I wouldn't be able to touch hands if I were to hug it."
    "Truncus arboris tam crassus est ut manus meas coniungere non possim si eum amplectar."

# game/a2s3.rpy:695
translate latin a2s3_09b6dbe3:

    # "I start looking for the hollow Neferu described, and as I walk around the tree, I immediately spot one on the other side of it."
    "Cavum quod Neferu descripsit quaerere incipio; arborem circumambulans statim in altera parte unum video."

# game/a2s3.rpy:696
translate latin a2s3_29c38ec1:

    # "I look into the black hole, feeling a bit nervous at what I might find in there."
    "In nigrum foramen aspicio, paulum sollicitus quid intus inveniam."

# game/a2s3.rpy:697
translate latin a2s3_07112e54:

    # m "\"I foun—\""
    m "\"Inve—\""

# game/a2s3.rpy:699
translate latin a2s3_e172c8b4:

    # "I stop as a tiny, red light in the hollow flares to life with my voice before fading again."
    "Desino, cum parvum lumen rubrum in cavo voce mea excitatum accenditur, deinde rursus languescit."

# game/a2s3.rpy:700
translate latin a2s3_6d5433a6:

    # m "\"What the...\""
    m "\"Quid malum...\""

# game/a2s3.rpy:701
translate latin a2s3_53363f3e:

    # "It happens again, pulsing to the sound of my voice."
    "Iterum accidit, lumen sono vocis meae pulsans."

# game/a2s3.rpy:703
translate latin a2s3_0440e11f:

    # n "\"You found it?\""
    n "\"Invenisti?\""

# game/a2s3.rpy:704
translate latin a2s3_1858ddf2:

    # m "\"Yeah, and there's a little red light in there that's lighting up with my voice.\""
    m "\"Inveni; et parvum lumen rubrum intus est, quod voce mea accenditur.\""

# game/a2s3.rpy:705
translate latin a2s3_6465f41e:

    # "I watch the hypnotic ebb and flow of the light as I speak."
    "Dum loquor, lucis fluxum atque refluxum animum detinentem observo."

# game/a2s3.rpy:707
translate latin a2s3_601cc133:

    # n "\"Thank you, [mc], you may come back now.\""
    n "\"Gratias, [mc]; iam redire potes.\""

# game/a2s3.rpy:708
translate latin a2s3_90abc67f:

    # "Gratefully, I return to the side of my Khemian friend, noticing that Alex's demeanor has completely changed now."
    "Libenter ad latus amici mei Khemiani redeo, animadvertens habitum Alex iam omnino mutatum esse."

# game/a2s3.rpy:710
translate latin a2s3_1aae4ff6:

    # "He's sullen, though almost expressionless as he lays under the jackal, not even pretending to be trying to escape at this point."
    "Morosus est, quamquam vultu paene inani sub chacalo iacet; iam ne effugere quidem conari simulat."

# game/a2s3.rpy:712
translate latin a2s3_2ea90c2e:

    # n "\"Well...that settles it, doesn't it, Alex?\""
    n "\"Hoc...rem constituit, nonne, Alex?\""

# game/a2s3.rpy:713
translate latin a2s3_da24c535:

    # "Alex remains silent, staring up at the sky."
    "Alex tacet, caelum suspiciens."

# game/a2s3.rpy:714
translate latin a2s3_3ffe5d76:

    # m "\"What is it?\""
    m "\"Quid est?\""

# game/a2s3.rpy:715
translate latin a2s3_1fbbdad4:

    # "Neferu looks up at me."
    "Neferu ad me suspicit."

# game/a2s3.rpy:717
translate latin a2s3_94ffbeda:

    # n "\"Classic Omorfan-parent tech. They often combine plant life and machinery to create their gadgets. Rather ingenious, and they've recently been sharing their knowledge with us on Khemia.\""
    n "\"Ars Parentum Omorfanorum solita est. Saepe vitam plantarum cum machinis coniungunt ut instrumenta sua creent. Ingeniosissime; nuper scientiam suam nobiscum in Khemia communicant.\""

# game/a2s3.rpy:718
translate latin a2s3_dd6235d3:

    # al "\"What a mistake that was.\""
    al "\"Quam magnus error fuit.\""

# game/a2s3.rpy:719
translate latin a2s3_e2f901be:

    # m "\"Wait, but what is it?\""
    m "\"Sed quid est?\""

# game/a2s3.rpy:720
translate latin a2s3_eefeb61a:

    # n "\"A communication device; it uses the branches as a massive antenna, capable of transmitting information great distances, though it's likely transmitting to Adastra City.\""
    n "\"Instrumentum communicationis; ramis velut ingenti antenna utitur atque notitiam longissime mittere potest; tamen verisimile est eam ad urbem Adastram mittere.\""

# game/a2s3.rpy:722
translate latin a2s3_eb1a9023:

    # n "\"There is likely a second spy there who then beams the information through a much more powerful machine...straight to Omorfa.\""
    n "\"Fortasse ibi alter speculator est, qui deinde notitiam multo potentiore machina transmittit...recta in Omorfam.\""

# game/a2s3.rpy:724
translate latin a2s3_7831bdd1:

    # "Neferu grins in Alex's face."
    "Neferu in vultum Alex arridet."

# game/a2s3.rpy:725
translate latin a2s3_67d458df:

    # n "\"Isn't that right, Alex?\""
    n "\"Nonne ita est, Alex?\""

# game/a2s3.rpy:726
translate latin a2s3_9744069d:

    # "Once again, Alex remains silent, seeming to have shut down."
    "Alex rursus tacet, velut omni responso clausus."

# game/a2s3.rpy:728
translate latin a2s3_b19ec0ce:

    # n "\"So, do you want to be the one to tell Cassius, [mc]?\""
    n "\"Visne igitur tu Cassio narrare, [mc]?\""

# game/a2s3.rpy:730
translate latin a2s3_78026940:

    # "That finally gets a reaction out of Alex, and he stiffens up, fur bristling out as he snarls at Neferu."
    "Id tandem Alex respondere facit: rigidus fit ac, pilis horrentibus, in Neferu ringitur."

# game/a2s3.rpy:731
translate latin a2s3_c309d903:

    # al "\"And for what reason, jackal? We're all spies here, including you...{i}especially{/i} you.\""
    al "\"Qua causa, chacale? Omnes hic speculatores sumus, etiam tu...{i}praesertim{/i} tu.\""

# game/a2s3.rpy:733
translate latin a2s3_d6e6f378:

    # n "\"Oh? I have no idea what you're talking about, Alex.\""
    n "\"Oh? Prorsus nescio quid dicas, Alex.\""

# game/a2s3.rpy:734
translate latin a2s3_1a52eb7c:

    # "Neferu's tone says otherwise."
    "Vox Neferu contrarium ostendit."

# game/a2s3.rpy:735
translate latin a2s3_482c82bf:

    # "Alex continues to glare up at the jackal, his fur starting to lay flat again."
    "Alex adhuc chacalo truculenter suspicit, pilis rursus planioribus factis."

# game/a2s3.rpy:737
translate latin a2s3_c3e4019f:

    # al "\"Oh, you think I'm that stupid? You think I just let you fuck me without any regard to your intentions, without studying you? I know why you're here, jackal.\""
    al "\"Putas me tam stultum esse? Putas me tantum te mecum concumbere sivisse sine ulla propositi tui cura, sine te observando? Scio cur hic sis, chacale.\""

# game/a2s3.rpy:739
translate latin a2s3_d81b654c:

    # n "\"Do enlighten me, {i}cat{/i}.\""
    n "\"Explica igitur mihi, {i}feles{/i}.\""

# game/a2s3.rpy:740
translate latin a2s3_fe851182:

    # al "\"You're floundering here, looking to make a name for yourself. The Pharaoh practically tossed you off the planet to attempt to cultivate a hopeless alliance on Adastra.\""
    al "\"Hic haeres, nomen tibi facere quaerens. Pharao paene te e planeta eiecit ut foedus desperatum in Adastra colere conareris.\""

# game/a2s3.rpy:742
translate latin a2s3_e752945d:

    # "Neferu's eyes narrow."
    "Neferu oculos contrahit."

# game/a2s3.rpy:743
translate latin a2s3_bcc8c3bf:

    # al "\"How unfulfilling it must be to be the second-born; unable to escape the shadow of your brother, unable to make father proud, stuck on this moon getting your balls kicked in by the bigot wolves.\""
    al "\"Quam parum satisfaciat secundum natum esse: e fratris umbra effugere non posse, patrem gloriari non facere, in hac luna haerere dum Lupi intolerantes testiculos tuos calcibus feriunt.\""

# game/a2s3.rpy:744
translate latin a2s3_3d740f39:

    # "Alex sounds and looks almost unrecognizable."
    "Alex paene non agnosci potest, voce atque vultu."

# game/a2s3.rpy:745
translate latin a2s3_c83cacd1:

    # al "\"Even your sisters; the third and fourth-born, have secured positions of greater prestige than you.\""
    al "\"Etiam sorores tuae, tertia quartaque natae, maiores dignitates quam tu adeptae sunt.\""

# game/a2s3.rpy:747
translate latin a2s3_5c50ac7c:

    # "I see Neferu grip tighter into Alex, but the cat goes on."
    "Neferu arctius Alex tenere video, sed feles pergit."

# game/a2s3.rpy:748
translate latin a2s3_eb059068:

    # al "\"In an era when the royal family has already given up so much power, you're desperate behind that facade of confidence, terrified of withering away into historical insignificance.\""
    al "\"Hac aetate, cum familia regia iam tantam potestatem dederit, post illam confidentiae speciem desperas, metuens ne in historiae oblivionem languescas.\""

# game/a2s3.rpy:749
translate latin a2s3_7d098f87:

    # al "\"You'll be less than a footnote in the Khemian history books.\""
    al "\"Minus quam parva nota in libris historiae Khemianae eris.\""

# game/a2s3.rpy:750
translate latin a2s3_d64b55c3:

    # "Neferu isn't smiling anymore, and I can tell that he's been caught off-guard just as much as me by the cat's complete change in character."
    "Neferu iam non arridet; intellego eum aeque ac me completa morum felis mutatione improviso percussum esse."

# game/a2s3.rpy:751
translate latin a2s3_8e278c19:

    # "Still, he keeps his hold on the cat, remarking coolly:"
    "Tamen felem adhuc tenet atque frigide dicit:"

# game/a2s3.rpy:752
translate latin a2s3_76809927:

    # n "\"I would choose my words more carefully if I were you, considering your position right now. As I was saying, we'll be reporting this to the emperor as soon as we return to the palace.\""
    n "\"Verba diligentius eligerem si tu essem, cum condicionem tuam nunc considerem. Ut dicebam, hoc imperatori referemus simul ac in palatium redierimus.\""

# game/a2s3.rpy:753
translate latin a2s3_1b3a7266:

    # "Alex seems to deflate again, apparently satisfied with the hits he'd gotten in on the jackal."
    "Alex rursus languescere videtur, quasi ictibus quos chacalo intulerat contentus sit."

# game/a2s3.rpy:754
translate latin a2s3_563bb06f:

    # al "\"What do you want?\""
    al "\"Quid vis?\""

# game/a2s3.rpy:756
translate latin a2s3_c79f82d9:

    # n "\"Hm?\""
    n "\"Hm?\""

# game/a2s3.rpy:757
translate latin a2s3_0be5fa8b:

    # al "\"Don't play stupid, what do you want from me? You've known I was a spy since you first got here and you're only doing this now because you want something.\""
    al "\"Noli stultum agere: quid a me vis? Me speculatorem esse scis ex quo primum huc venisti; nunc tantum hoc facis quia aliquid cupis.\""

# game/a2s3.rpy:761
translate latin a2s3_6b6518f6:

    # n "\"Oh, how considerate of you, well...\""
    n "\"Oh, quam considerate agis. Igitur...\""

# game/a2s3.rpy:762
translate latin a2s3_1fbbdad4_1:

    # "Neferu looks up at me."
    "Neferu ad me suspicit."

# game/a2s3.rpy:764
translate latin a2s3_f792ff23:

    # n "\"What do you think we want, [mc]?\""
    n "\"Quid nos velle putas, [mc]?\""

# game/a2s3.rpy:765
translate latin a2s3_1903be76:

    # m "\"Full access to the archives.\""
    m "\"Plenum aditum ad tabularium.\""

# game/a2s3.rpy:766
translate latin a2s3_f790a578:

    # "Alex snorts."
    "Alex fremit."

# game/a2s3.rpy:767
translate latin a2s3_d6e1b454:

    # al "\"I don't have that.\""
    al "\"Non habeo.\""

# game/a2s3.rpy:769
translate latin a2s3_2b7243e8:

    # n "\"Then get it. We know how close you are to Cassius. Make something up as to why you need it, then grant us access.\""
    n "\"Inveni igitur. Scimus quam proximus Cassio sis. Excogita causam cur eo egeas, deinde nobis aditum praebe.\""

# game/a2s3.rpy:770
translate latin a2s3_4d558b87:

    # al "\"For what reason?\""
    al "\"Qua causa?\""

# game/a2s3.rpy:771
translate latin a2s3_53c4d5d3:

    # n "\"To help Amicus. Cassius will not be harmed by this. You have until next week, otherwise the emperor will know of your treason.\""
    n "\"Ut Amicum adiuvemus. Cassius hac re non laedetur. Tempus tibi usque ad proximam hebdomadem est; alioquin imperator proditionem tuam cognoscet.\""

# game/a2s3.rpy:772
translate latin a2s3_47e50a4d:

    # "Alex remains quiet, and Neferu seems satisfied with that, pushing off the cat and getting to his feet."
    "Alex tacet; Neferu hoc contentus videtur, a fele se removens atque surgens."

# game/a2s3.rpy:774
translate latin a2s3_8ce4c26f:

    # n "\"Let us be off.\""
    n "\"Eamus.\""

# game/a2s3.rpy:775
translate latin a2s3_af313c62:

    # "The jackal speaks briskly to me before turning on his heel and making his way back to the craft."
    "Chacalus mihi breviter dicit, deinde se vertit atque ad navem redit."

# game/a2s3.rpy:777
translate latin a2s3_6b3fe700:

    # "I look down at Alex, watching as the cat simply stares at the moons, not even acknowledging me."
    "Alex desuper aspicio, qui lunas tantum intuetur, ne me quidem agnoscens."

# game/a2s3.rpy:780
translate latin a2s3_fc2931e2:

    # "The way back is a bit awkward, Neferu quiet, clearly upset."
    "Reditus aliquantum inconcinnus est: Neferu tacet, manifesto perturbatus."

# game/a2s3.rpy:781
translate latin a2s3_493b215d:

    # "I haven't really ever seen him like this before, and I have to remind myself that I probably rarely see the real Neferu."
    "Eum talem antea fere numquam vidi; mihi in memoriam revocandum est me verum Neferu fortasse raro videre."

# game/a2s3.rpy:782
translate latin a2s3_3fe194b7:

    # "He's putting on an act just like Alex, just like they both have to."
    "Personam agit sicut Alex, sicut ambo agere debent."

# game/a2s3.rpy:783
translate latin a2s3_80a8cfbc:

    # "And though I'm curious about his family situation, I have enough sense not to pry."
    "Quamquam de familia eius curiosus sum, satis prudens sum ne indagem."

# game/a2s3.rpy:784
translate latin a2s3_8e87d929:

    # "Instead, I ask what I'm most worried about:"
    "Potius quod me maxime sollicitat quaero:"

# game/a2s3.rpy:785
translate latin a2s3_4607deff:

    # m "\"What's to stop Alex from betraying us? He could just as easily tell Cassius about our plot.\""
    m "\"Quid Alex prohibet ne nos prodat? Cassio consilium nostrum aeque facile narrare potest.\""

# game/a2s3.rpy:786
translate latin a2s3_f997806a:

    # "The jackal is staring off into the water, his elbows on the railing of the Sightseer as he hunches over."
    "Chacalus in aquam spectat, cubitis margini Spectatricis innixis, corpore incurvato."

# game/a2s3.rpy:787
translate latin a2s3_78abd7c7:

    # n "\"He won't. He can't bear the thought of Cassius knowing of his betrayal.\""
    n "\"Non faciet. Cogitationem Cassium proditionem suam cogniturum esse ferre nequit.\""

# game/a2s3.rpy:788
translate latin a2s3_9113d5f8:

    # "The usual confidence and natural smugness that's usually in the jackal's voice is completely missing, his tone flat."
    "Solita confidentia atque naturalis superbia vocis chacali prorsus absunt; vox plana est."

# game/a2s3.rpy:789
translate latin a2s3_4dd72ad2_1:

    # m "\"You sure?\""
    m "\"Certus es?\""

# game/a2s3.rpy:791
translate latin a2s3_9a4717be:

    # n "\"Yes. His love for Cassius is almost equal to that of his loyalty to Omorfa, which is why I assured him that Cassius wouldn't be harmed by our plans. We have little to worry about.\""
    n "\"Ita. Amor eius erga Cassium paene tantus est quanta fides eius erga Omorfam; ideo confirmavi Cassium consiliis nostris non laesum iri. Parum timendum nobis est.\""

# game/a2s3.rpy:792
translate latin a2s3_3dc275e5:

    # "The jackal's mood puts me off from asking any more questions, and we sail the rest of the way to the palace in silence."
    "Animus chacali me a pluribus quaestionibus revocat; reliquum iter ad palatium taciti navigamus."

# game/a2s3.rpy:796
translate latin a2s3_9272fc51:

    # "Three days later, Alex is able to gain full access to the archives."
    "Tribus post diebus Alex plenum aditum ad tabularium obtinere potest."

# game/a2s3.rpy:797
translate latin a2s3_c5a21186:

    # "He doesn't explain to us how he did it, instead simply notifying Neferu of the specific time he'd open the archives for us and to be ready."
    "Quomodo fecerit non explicat; tantum Neferu certiorem facit quo certo tempore tabularium nobis aperiat, ut parati simus."

# game/a2s3.rpy:798
translate latin a2s3_88e0c2b3:

    # "I don't have to argue to come along this time, instead Virginia tells me that I'll need to go if we're to erase my profile from the palace's database."
    "Hoc tempore mecum ire ut liceat contendere non debeo; Virginia potius mihi dicit me ire debere si descriptionem meam e datorum palatii archivo delere velimus."

# game/a2s3.rpy:799
translate latin a2s3_6c31cd06:

    # "Doing this will allow me to leave the palace without being killed by Com; just another last resort in case things go bad."
    "Hoc me e palatio exire sinet sine eo quod Com me interficiat: alia extrema ratio, si res male cedant."

# game/a2s3.rpy:800
translate latin a2s3_ea3f7231:

    # "Neferu stays behind this time, deciding it to be best considering he's not exactly needed for what we're about to do."
    "Neferu hoc tempore manet, optimum ratus, cum ad ea quae facturi sumus non prorsus opus sit."

# game/a2s3.rpy:802
translate latin a2s3_13e811f3:

    # "Alex walks stiffly ahead of us, not speaking or really acknowledging us in any way."
    "Alex rigide ante nos ambulat, neque loquens neque nos ullo modo vere agnoscens."

# game/a2s3.rpy:803
translate latin a2s3_1f9c1f4a:

    # "I find it unnerving after knowing the cat for so long, though Virginia doesn't seem bothered at all."
    "Postquam tam diu felem novi, id me turbat; Virginia autem minime molestum habere videtur."

# game/a2s3.rpy:804
translate latin a2s3_42f4d75c:

    # "We walk to a portion of the palace that I haven't been to very often, mostly because I was never shown the area."
    "Ad partem palatii pervenimus ubi raro fui, maxime quia mihi numquam ostensa est."

# game/a2s3.rpy:806
translate latin a2s3_0f6d0f45:

    # "Alex comes to a door that he presses his hand to, and unlike the other black panels, this one flashes a green color before the door opens."
    "Alex ad ianuam pervenit manumque ei admovet; haec autem tabula, contra quam ceterae nigrae, viridi lumine coruscat antequam ianua aperitur."

# game/a2s3.rpy:810
translate latin a2s3_871a640b:

    # "We walk inside the room, and I get my first look at the archive."
    "In conclave ingredimur et tabularium primum video."

# game/a2s3.rpy:811
translate latin a2s3_0f5eae29:

    # "I guess I'd expected rows of bookshelves, full of some type of digital storage, or whatever the wolves might use."
    "Putaveram fortasse ordines armariorum libris vel quodam datorum recondendorum genere plenos fore, vel quidquid Lupi adhibent."

# game/a2s3.rpy:812
translate latin a2s3_cb36a58e:

    # "Instead, I'm greeted by the sight of a giant, blue, glowing, sphere, with a honeycomb pattern covering its surface."
    "Potius ingentem sphaeram caeruleam lucentem video, cuius superficies forma favi tecta est."

# game/a2s3.rpy:813
translate latin a2s3_a5e4fbda:

    # "What's most striking about it though is the swirling characters that appear and disappear just over the surface."
    "Maxime tamen mirae sunt litterae circumvolantes, quae paulo supra superficiem apparent atque evanescunt."

# game/a2s3.rpy:814
translate latin a2s3_774b3e86:

    # "They're symbols I don't recognize, not any that I've seen on Adastra before."
    "Signa sunt quae non agnosco, nec qualia antea in Adastra viderim."

# game/a2s3.rpy:815
translate latin a2s3_15aabad5:

    # "Sitting in front of the floating sphere are two stone dragons, mouths open in silent snarls."
    "Ante sphaeram volantem duo dracones lapidei sedent, oribus apertis quasi tacite ringantur."

# game/a2s3.rpy:817
translate latin a2s3_59eb49d6:

    # "Alex seems to be in a hurry as he walks up to the globe."
    "Alex festinare videtur dum ad globum accedit."

# game/a2s3.rpy:818
translate latin a2s3_1a335fee:

    # "Without hesitation, he sticks his paw into the swirling blue and the characters and swirls seem to congregate around it before the whole thing pulses."
    "Sine cunctatione manum in caeruleum vorticosum immittit; litterae atque vortices circa eam convenire videntur antequam tota res pulsat."

# game/a2s3.rpy:819
translate latin a2s3_6ccb79d3:

    # "This seems to satisfy the cat as he turns away."
    "Hoc felem contentum facit; se avertit."

# game/a2s3.rpy:820
translate latin a2s3_8cda2afe:

    # al "\"That should give you full access. You're on your own from here.\""
    al "\"Id plenum aditum vobis praebere debet. Ab hoc loco ipsi agite.\""

# game/a2s3.rpy:822
translate latin a2s3_ffa5a246:

    # "With that, the cat leaves."
    "His dictis, feles abit."

# game/a2s3.rpy:823
translate latin a2s3_364de252:

    # "I watch him disappear out the door, for the first time feeling a bit sad at how our relationship has changed."
    "Eum per ianuam evanescere observo; primum paulum tristis fio cum cogito quam necessitudo nostra mutata sit."

# game/a2s3.rpy:824
translate latin a2s3_8a6ea339:

    # "Virginia remains unbothered though, walking up to the blue sphere as I follow."
    "Virginia autem minime turbatur; ad caeruleam sphaeram accedit, me sequente."

# game/a2s3.rpy:826
translate latin a2s3_7e12e528:

    # "I stand there awkwardly for a moment before clearing my throat."
    "Paulisper inconcinne ibi sto, deinde guttur purgo."

# game/a2s3.rpy:827
translate latin a2s3_f9788f64:

    # m "\"So what is this thing?\""
    m "\"Quid igitur haec res est?\""

# game/a2s3.rpy:828
translate latin a2s3_38208612:

    # v "\"The archive.\""
    v "\"Tabularium.\""

# game/a2s3.rpy:829
translate latin a2s3_9f1039c1:

    # m "\"Yeah, but it looks—\""
    m "\"Ita, sed videtur—\""

# game/a2s3.rpy:830
translate latin a2s3_facdf448:

    # v "\"It's parental, yes, and no, I don't know how it works. It was also used as the method of communication with the parents before they ceased contact, hence the meditation pillow.\""
    v "\"Ars Parentum est, ita; et non, quomodo valeat nescio. Etiam ratio cum Parentibus communicandi erat antequam commercium cessaverunt; ideo pulvillus meditationis adest.\""

# game/a2s3.rpy:831
translate latin a2s3_ffa7dd1c:

    # "Virginia gestures at the pillow before she leans forward slightly, a streak of blue light wrapping around her head briefly before she leans back."
    "Virginia ad pulvillum gestu indicat; deinde paulum se inclinat, et caeruleum lucis filum brevi caput eius circumdat antequam rursus reclinat."

# game/a2s3.rpy:833
translate latin a2s3_21cfe5d6:

    # v "\"It connects to the host's brain, similar to the lingua and operates on mind-control.\""
    v "\"Cum mente eius qui utitur coniungitur, sicut Lingua, atque cogitatione regitur.\""

# game/a2s3.rpy:834
translate latin a2s3_8c4e5c77:

    # m "\"Wow.\""
    m "\"O.\""

# game/a2s3.rpy:835
translate latin a2s3_e512b0f6:

    # v "\"Yes, I haven't used it often, but it's fairly easy to control. You'll find out soon enough.\""
    v "\"Non saepe eo usa sum, sed satis facile regitur. Mox ipse experieris.\""

# game/a2s3.rpy:836
translate latin a2s3_2d6ee573:

    # m "\"Oh.\""
    m "\"O.\""

# game/a2s3.rpy:837
translate latin a2s3_e782780e:

    # "I feel a bit nervous, but Virginia focuses back on the blue globe."
    "Paulum anxius sum; Virginia autem caeruleo globo rursus animum intendit."

# game/a2s3.rpy:839
translate latin a2s3_2a079b62:

    # "Suddenly, a small screen appears over the sphere, and I see what looks like the amphitheater."
    "Subito parva tabula supra sphaeram apparet; quod amphitheatrum esse videtur video."

# game/a2s3.rpy:840
translate latin a2s3_6c07d12d:

    # v "\"Hmmm...what day was the final trial?\""
    v "\"Hmm...quo die ultimum certamen fuit?\""

# game/a2s3.rpy:841
translate latin a2s3_a5076383:

    # "I'm about to answer when suddenly Virginia just waves me into silence, focusing on the screen again."
    "Iam respondere volo, cum Virginia subito me gestu silere iubet atque rursus tabulae animum intendit."

# game/a2s3.rpy:842
translate latin a2s3_cfb08b2e:

    # "I see the scene change to a bloody sunset, and I feel the same anxiety I'd felt that day as I see Cato and Amicus appear on the screen, followed by me and Cassius."
    "Imaginem in cruentum solis occasum mutari video; eandem anxietatem ac illo die sentio, dum Cato et Amicus apparent, deinde ego atque Cassius."

# game/a2s3.rpy:843
translate latin a2s3_0bcf83cb:

    # "The angle is high, and the scene is a bit distant, probably from the palace, but I can make everyone out clearly."
    "Desuper spectatur et imago paulum remota est, fortasse e palatio capta; omnes tamen clare videre possum."

# game/a2s3.rpy:844
translate latin a2s3_a4d8c44c:

    # "Cassius strips and hurries down the steps to the amphitheater, and I want to look away, but don't as Cato turns on Amicus and punches him in the face."
    "Cassius se nudat atque per gradus in amphitheatrum festinat; oculos avertere volo, sed non facio, dum Cato ad Amicum se vertit eumque in vultu pugno percutit."

# game/a2s3.rpy:846
translate latin a2s3_d9c296f2:

    # "Virginia's reaction is small but noticeable, clearly surprised by Cato's brutality."
    "Virginia paulum sed manifesto respondet, certe saevitiam Catonis mirata."

# game/a2s3.rpy:847
translate latin a2s3_f538bf47:

    # "What follows is the awkward, staged posing, and the pin."
    "Deinde inconcinni habitus simulati atque retentio in solo fiunt."

# game/a2s3.rpy:848
translate latin a2s3_4e4520d2:

    # "Then, the footage of me using the nervo on Cassius."
    "Sequitur imago mei nervo in Cassium utentis."

# game/a2s3.rpy:849
translate latin a2s3_cd12ba09:

    # "This is followed by Amicus tearing off Cato's visor."
    "Deinde Amicus tegumentum oculorum Catonis avellit."

# game/a2s3.rpy:850
translate latin a2s3_6a254cb7:

    # "After that, I run off-screen, and I get to watch as drones descend on Amicus and he suddenly goes limp as they, I assume, stun him."
    "Postea extra imaginem curro; observo automata ad Amicum descendere eumque subito flaccidum fieri, cum eum, ut puto, stupefaciunt."

# game/a2s3.rpy:851
translate latin a2s3_f9258bd7:

    # "Virginia watches all of this with an open mouth until Amicus is escorted away and Cato is picked up by a small ship that lands in the middle of the amphitheater."
    "Virginia omnia ore aperto spectat donec Amicus abducitur atque Cato parva nave tollitur, quae in medio amphitheatro considit."

# game/a2s3.rpy:852
translate latin a2s3_66c3ca4e:

    # "Then she shakes her head."
    "Deinde caput quatit."

# game/a2s3.rpy:853
translate latin a2s3_2dce5ff1:

    # v "\"Males...\""
    v "\"Mares...\""

# game/a2s3.rpy:854
translate latin a2s3_3d9ff6a8:

    # "Virginia sighs out in frustration as the screen fades."
    "Virginia moleste suspirat dum imago evanescit."

# game/a2s3.rpy:855
translate latin a2s3_0f8f6996:

    # m "\"So you got the footage?\""
    m "\"Ergo imagines servavisti?\""

# game/a2s3.rpy:857
translate latin a2s3_40b99dca:

    # v "\"I've filed it away to a domain accessible by both me and Neferu. We'll figure out a way to use it delicately.\""
    v "\"In regione mihi atque Neferu patente reposui. Rationem excogitabimus qua caute utamur.\""

# game/a2s3.rpy:858
translate latin a2s3_83fd8e46:

    # m "\"And the investigation into the crash?\""
    m "\"Et investigatio casus navis?\""

# game/a2s3.rpy:859
translate latin a2s3_a591bd5e:

    # "This is something that I'd brought up to Virginia and Neferu before we came here, even though both seemed skeptical that it could be useful in any way."
    "Hoc Virginiae atque Neferu ante adventum proposueram, quamquam ambo dubitaverant an ullo modo utile esse posset."

# game/a2s3.rpy:860
translate latin a2s3_ffa1a384:

    # "That even Cato wouldn't be so devious as to kill his own friend, a friend that happened to be the emperor."
    "Ne Catonem quidem tam dolosum esse ut amicum suum interficiat, qui imperator quoque erat."

# game/a2s3.rpy:862
translate latin a2s3_1a3feec2:

    # "Even now, Virginia sighs as if it's an annoying inconvenience, but focuses for a moment until she seems satisfied."
    "Etiam nunc Virginia velut molestam difficultatem suspirat; tamen paulisper animum intendit donec contenta videtur."

# game/a2s3.rpy:863
translate latin a2s3_a59b96d7:

    # v "\"Done, all documents related to the investigation are now in the same location. We'll go over it later...well, at least you and Neferu can.\""
    v "\"Factum est: omnia documenta ad investigationem pertinentia iam in eodem loco sunt. Postea ea examinabimus...vel saltem tu atque Neferu potestis.\""

# game/a2s3.rpy:864
translate latin a2s3_3b1ed4fc:

    # "There's a momentary pause."
    "Brevis mora fit."

# game/a2s3.rpy:865
translate latin a2s3_e7d5566d:

    # m "\"Well, that was easy.\""
    m "\"Facile fuit.\""

# game/a2s3.rpy:867
translate latin a2s3_59b6666d:

    # v "\"What did you expect? Parental tech makes everything fast and easy.\""
    v "\"Quid exspectabas? Ars Parentum omnia celeria ac facilia facit.\""

# game/a2s3.rpy:868
translate latin a2s3_ad361723:

    # m "\"Yeah, I suppose.\""
    m "\"Ita, opinor.\""

# game/a2s3.rpy:869
translate latin a2s3_f856689c:

    # v "\"So...are you ready to use it?\""
    v "\"Igitur...paratusne es eo uti?\""

# game/a2s3.rpy:870
translate latin a2s3_790983c9:

    # m "\"I—I think so.\""
    m "\"P—puto me esse.\""

# game/a2s3.rpy:871
translate latin a2s3_ca601d26:

    # "Virginia smiles at me."
    "Virginia mihi arridet."

# game/a2s3.rpy:872
translate latin a2s3_8d3c566e:

    # v "\"Don't worry, it's easy. Simply keep your mind clear of anything except your objective; your profile and how it should be wiped clean from the archive.\""
    v "\"Noli timere; facile est. Animum ab omnibus rebus praeter propositum tuum liberum tene: descriptionem tuam e tabulario omnino deleri vis.\""

# game/a2s3.rpy:873
translate latin a2s3_7a54ef63:

    # m "\"My profile...\""
    m "\"Descriptio mea...\""

# game/a2s3.rpy:874
translate latin a2s3_d70c5ad0:

    # "I try to think up how I should imagine a profile, but Virginia stops me."
    "Quomodo descriptionem fingam cogitare conor, sed Virginia me interpellat."

# game/a2s3.rpy:875
translate latin a2s3_bf33af45:

    # v "\"You're already thinking too much. Just this; your profile, wipe it from the archives.\""
    v "\"Iam nimis cogitas. Hoc tantum: descriptio tua, eam e tabulario dele.\""

# game/a2s3.rpy:877
translate latin a2s3_f9f7e2cd:

    # "I swallow hard, but allow Virginia to gently push me forward until one of the tendrils touches my head."
    "Aegre deglutio, sed Virginiam me leniter promoventem sino, donec unum filorum caput meum tangit."

# game/a2s3.rpy:878
translate latin a2s3_b7026e49:

    # "It's a cool feeling at first, then suddenly my body seize up involuntarily as it feels like my entire brain twitches."
    "Primum frigidum sentitur; deinde corpus subito invitus contraho, velut totum cerebrum subsiliat."

# game/a2s3.rpy:879
translate latin a2s3_d31d9f92:

    # v "\"Keep focused on your objective.\""
    v "\"Proposito tuo intentus mane.\""

# game/a2s3.rpy:881
translate latin a2s3_e3950d90:

    # "My profile, gone...my profile, erase it...my profile...delete from the archives..."
    "Descriptio mea, sublata...descriptio mea, eam dele...descriptio mea...e tabulario dele..."

# game/a2s3.rpy:885
translate latin a2s3_0c01baca:

    # "A dagger, screams, pain, blood, hissing breath, spurting red, absolute anguish—"
    "Pugio, clamores, dolor, sanguis, spiritus sibilans, rubor prorumpens, summus angor—"

# game/a2s3.rpy:886
translate latin a2s3_92294901:

    # a "\"[mc]! No, please! Don't leave me here! Please, come back to me! You can't leave me to be alone like this!\""
    a "\"[mc]! Non, quaeso! Noli me hic relinquere! Quaeso, ad me redi! Non potes me ita solum relinquere!\""

# game/a2s3.rpy:887
translate latin a2s3_67ea409f:

    # "Amicus screams right into my ear, and I've never heard him sound like this before."
    "Amicus recta in aurem meam clamat; eum talem antea numquam audivi."

# game/a2s3.rpy:888
translate latin a2s3_246f80e7:

    # "It's horrible, and I know I need to comfort him, to tell him I'm not leaving, but my voice is gone and air hisses from my throat."
    "Horribile est; scio me eum consolari debere, dicere me non abire; sed vox mea amissa est et aer e gutture sibilat."

# game/a2s3.rpy:889
translate latin a2s3_7af048ec:

    # a "\"No, no, no...speak to me!\""
    a "\"Non, non, non...loquere mihi!\""

# game/a2s3.rpy:890
translate latin a2s3_410b1b90:

    # "Amicus's voice rises in pitch, panicking, becoming desperate."
    "Vox Amici acutior fit; expavescit ac desperat."

# game/a2s3.rpy:891
translate latin a2s3_94b54f13:

    # "Then it all stops."
    "Deinde omnia cessant."

# game/a2s3.rpy:892
translate latin a2s3_a20cefa7:

    # "..."
    "..."

# game/a2s3.rpy:893
translate latin a2s3_7b3a49ae:

    # mon "\"You can prevent this...\""
    mon "\"Hoc prohibere potes...\""

# game/a2s3.rpy:894
translate latin a2s3_a20cefa7_1:

    # "..."
    "..."

# game/a2s3.rpy:895
translate latin a2s3_4a623aa4:

    # mon "\"But only if you submit yourself to the benevolent will of the parents..."
    mon "\"Sed tantum si te benignae Parentum voluntati submittis..."

# game/a2s3.rpy:896
translate latin a2s3_a20cefa7_2:

    # "..."
    "..."

# game/a2s3.rpy:897
translate latin a2s3_30bfd9a1:

    # mon "\"Will you?\""
    mon "\"Faciesne?\""

# game/a2s3.rpy:903
translate latin a2s3_a20cefa7_3:

    # "..."
    "..."

# game/a2s3.rpy:906
translate latin a2s3_a20cefa7_4:

    # "..."
    "..."

# game/a2s3.rpy:909
translate latin a2s3_4bd6c2b6:

    # "I gasp and pull back, head reeling."
    "Anhelo ac recedo, capite vertiginoso."

# game/a2s3.rpy:910
translate latin a2s3_cc6f60f2:

    # "I feel soft but strong paws grip me around the shoulders."
    "Manus mites sed fortes umeros meos capere sentio."

# game/a2s3.rpy:912
translate latin a2s3_c6bb4c15:

    # v "\"Are you alright?\""
    v "\"Bene vales?\""

# game/a2s3.rpy:913
translate latin a2s3_bb7373a7:

    # "I look around, wide-eyed, feeling almost sick as that weird feeling of control in brain suddenly leaves."
    "Dilatatis oculis circumspicio, paene nauseans, dum mirus ille mentis regendae sensus subito me relinquit."

# game/a2s3.rpy:914
translate latin a2s3_9046708a:

    # m "\"I—\""
    m "\"Ego—\""

# game/a2s3.rpy:915
translate latin a2s3_0d8e8ad8:

    # "I don't know what to say, and Virginia glances back at the sphere."
    "Quid dicam nescio; Virginia rursus sphaeram aspicit."

# game/a2s3.rpy:916
translate latin a2s3_c29f80bf:

    # v "\"Might not be suited to a simian brain. Com?\""
    v "\"Fortasse cerebro simiano non aptum est. Com?\""

# game/a2s3.rpy:917
translate latin a2s3_3e3b21b8:

    # com "\"Yes Virginia?\""
    com "\"Quid est, Virginia?\""

# game/a2s3.rpy:918
translate latin a2s3_8382f04e:

    # v "\"Locate [mc]'s profile.\""
    v "\"Descriptionem [mc] inveni.\""

# game/a2s3.rpy:919
translate latin a2s3_35be8e76:

    # com "\"There is no such profile archived.\""
    com "\"Nulla talis descriptio in tabulario servatur.\""

# game/a2s3.rpy:920
translate latin a2s3_ea8a57d9:

    # v "\"Well, you did it at least. Let's get you back to Neferu's room.\""
    v "\"Saltem perfecisti. Te ad cubiculum Neferu reducamus.\""

# game/a2s3.rpy:922
translate latin a2s3_b60a855c:

    # "We walk through the halls, Virginia having to help because of my unsteady feet."
    "Per porticus ambulamus; Virginia me adiuvare debet, quia pedibus vacillo."

# game/a2s3.rpy:923
translate latin a2s3_5e0839c1:

    # "I'm stunned, feeling as if I'd just come up from another drug trip."
    "Stupeo, velut rursus e medicamenti visione redierim."

# game/a2s3.rpy:924
translate latin a2s3_1bcdec4d:

    # "But it's not what I felt, or even the visions of violence that have me shaken up."
    "Non tamen sensus ille nec visiones violentiae me perturbant."

# game/a2s3.rpy:925
translate latin a2s3_28d93abb:

    # "It's Amicus's screams of despair that linger in my head..."
    "Clamores desperationis Amici in capite meo manent..."

# game/a2s3.rpy:926
translate latin a2s3_0728594f:

    # "I have to see him as soon as possible."
    "Eum quam primum videre debeo."

# game/a2s3.rpy:927
translate latin a2s3_3d1cf249:

    # "I have to make sure he's all right."
    "Eum bene valere scire debeo."

# game/a2s3.rpy:932
translate latin a2s3_93b5e4b6:

    # a "\"Mmmh, you smell so good...\""
    a "\"Mmmh, tam bene oles...\""

# game/a2s3.rpy:934
translate latin a2s3_7278cbec:

    # "Amicus has me pinned to the floor on the little blanket that I brought with me."
    "Amicus me in pavimento premit, supra parvam stragulam quam mecum attuli."

# game/a2s3.rpy:935
translate latin a2s3_c6cdbe29:

    # "He's smothering me with his big body, grinding down against me as he licks and nips at my neck."
    "Magno corpore me tegit, contra me deorsum se terens, dum collum meum lambit atque leviter mordet."

# game/a2s3.rpy:936
translate latin a2s3_01ffd205:

    # "I haven't even been here more than a minute."
    "Ne unum quidem minutum hic fui."

# game/a2s3.rpy:937
translate latin a2s3_4caab3a4:

    # m "\"W—wait, what if...what if Com sees...\""
    m "\"E—exspecta; quid si...quid si Com videt...\""

# game/a2s3.rpy:938
translate latin a2s3_9ee7f23e:

    # "I gasp around the licks and Amicus responds by holding my head in his giant paws, keeping me steady as he starts to push his hips against me, his thighs forcing my legs upward."
    "Inter lambitus anhelo; Amicus caput meum ingentibus manibus capit meque firmum tenet, dum coxas contra me impellere incipit, femoribus crura mea sursum cogentibus."

# game/a2s3.rpy:939
translate latin a2s3_07725523:

    # "Amicus mumbles into my throat."
    "Amicus ad guttur meum murmurat."

# game/a2s3.rpy:941
translate latin a2s3_0a545422:

    # a "\"Then let him watch.\""
    a "\"Spectet igitur.\""

# game/a2s3.rpy:942
translate latin a2s3_32bdd994:

    # "Com isn't watching, as far as I know."
    "Com non spectat, quantum scio."

# game/a2s3.rpy:943
translate latin a2s3_aac2bdca:

    # "Somehow I'd been able to convince Cassius to give us more privacy."
    "Quodam modo Cassio persuadere potueram ut plus secreti nobis concederet."

# game/a2s3.rpy:944
translate latin a2s3_9edc050c:

    # "Actually, I think I'd just grossed him out when I'd asked, wrinkling his nose as he instructed Com to keep the drone at the top of the ladder this time."
    "Immo, credo me tantum eum rogando fastidio affecisse: nasum corrugans Com iussit hoc tempore automaton in summa scala tenere."

# game/a2s3.rpy:945
translate latin a2s3_1d3c9fdb:

    # "At that moment, I feel the wolf's hard length pressing at my ass, and even though I'm in my underwear and robes, I pull back."
    "Tum rigidum lupi membrum contra nates meas premi sentio; quamquam indusium atque vestem gero, me retraho."

# game/a2s3.rpy:946
translate latin a2s3_92f51ad4:

    # m "\"Whoa, not now, Amicus!\""
    m "\"Heus, non nunc, Amice!\""

# game/a2s3.rpy:947
translate latin a2s3_ec6e5d34:

    # "Amicus goes on nuzzling me, moving to my face and locking lips with me for several seconds while he continues to push his hips against me."
    "Amicus adhuc me rostro mulcet; ad vultum accedit atque labra sua meis aliquot secunda coniungit, coxas interim contra me impellens."

# game/a2s3.rpy:948
translate latin a2s3_06e18670:

    # "He finally pulls back a little."
    "Tandem paulum recedit."

# game/a2s3.rpy:949
translate latin a2s3_68b3923e:

    # a "\"I know, I'm just playing around a little. I've been down here too long. I love you, everything about you.\""
    a "\"Scio; paulum tantum ludo. Nimis diu hic infra fui. Te amo, omnia de te.\""

# game/a2s3.rpy:950
translate latin a2s3_ba52966f:

    # m "\"Clearly.\""
    m "\"Ut patet.\""

# game/a2s3.rpy:951
translate latin a2s3_66a49acb:

    # "That's all I'm able to say before he starts to kiss me again, licking and sucking and I'm at least glad that it tastes like they're providing him with that mouthwash stuff down here."
    "Id tantum dicere possum antequam rursus me osculatur, lambens atque sugens; saltem gaudeo sapore intellegere eum hic liquorem ad os lavandum accipere."

# game/a2s3.rpy:952
translate latin a2s3_0085f6c6:

    # "I've never seen Amicus so horny before, which is saying something, his paws gripping and stroking at me almost desperately as his muzzle kisses every inch of my neck and face."
    "Amicum tam libidine incensum antea numquam vidi, quod multum dicit: manus eius paene desperatae me prehendunt atque mulcent, dum rostrum omnem colli vultusque partem osculatur."

# game/a2s3.rpy:953
translate latin a2s3_615d91bd:

    # "He pushes his body down against mine, his considerable chest and belly crushing me flat against the ground."
    "Corpus suum contra me deorsum urget, magno pectore ventreque me in solum premens."

# game/a2s3.rpy:954
translate latin a2s3_52dd0c3d:

    # "But when his muzzle starts dipping down lower, snuffling against my chest and under my robes, I decide that I've had enough."
    "Sed cum rostrum inferius demittit, pectus meum atque sub veste olfaciens, satis iam esse constituo."

# game/a2s3.rpy:955
translate latin a2s3_2dac718b:

    # "I reach around to grab his upraised rear, getting a handful of thick, furry ass as my fingers squeeze dangerously close to the spot under his tail."
    "Manus circa eum mitto ut nates elevatas capiam; plena manu crassas villosasque nates teneo, digitis periculose prope locum sub cauda pressis."

# game/a2s3.rpy:957
translate latin a2s3_a9ba8a6b:

    # "Predictably, Amicus gasps in surprise and pulls back, quickly sitting up so that his rear is safely pressed against the blanket and I have room to finally sit up myself."
    "Ut exspectabam, Amicus admiratus anhelat et recedit; celeriter considit ut nates tuto stragulae premantur atque spatium mihi tandem surgendi detur."

# game/a2s3.rpy:959
translate latin a2s3_e23ab2c5:

    # a "\"What was that for?\""
    a "\"Cur hoc fecisti?\""

# game/a2s3.rpy:960
translate latin a2s3_e08b4e80:

    # m "\"For not letting me catch my breath. And I know you don't like things near your butt.\""
    m "\"Quia me spiritum recipere non sinebas. Et scio te res prope nates tuas nolle.\""

# game/a2s3.rpy:962
translate latin a2s3_1030ec27:

    # a "\"Well, emperors shouldn't have things near their butt.\""
    a "\"Imperatores res prope nates suas habere non debent.\""

# game/a2s3.rpy:963
translate latin a2s3_7dda34ba:

    # "I roll my eyes at his silly, but understandable insecurity, and crawl up to Amicus to sit in his lap, the wolf eagerly pulling me in."
    "Oculos in caelum verto propter ineptum sed intellegibilem timorem eius; deinde ad Amicum repo ut in gremio eius consideam, dum lupus cupide me ad se trahit."

# game/a2s3.rpy:965
translate latin a2s3_891ef0b0:

    # a "\"I love you.\""
    a "\"Te amo.\""

# game/a2s3.rpy:966
translate latin a2s3_8c5fe2d6:

    # m "\"I love you too.\""
    m "\"Te quoque amo.\""

# game/a2s3.rpy:967
translate latin a2s3_1d444008:

    # "Amicus rubs his paws up and down my arms and shoulders, still just feeling me out."
    "Amicus manus per brachia umerosque meos sursum deorsumque fricat, adhuc tantum me sentiens."

# game/a2s3.rpy:968
translate latin a2s3_79669a53:

    # a "\"I can't wait to get out of here. No more hiding when I'm emperor. I'm going to show you the real Adastra. Being stuck behind these walls is not how the emperor's beautiful lover should be treated.\""
    a "\"Ex hoc loco egredi ardenter cupio. Cum imperator ero, iam non latebimus. Veram Adastram tibi ostendam. Non ita pulcher imperatoris amator tractandus est, ut inter hos muros includatur.\""

# game/a2s3.rpy:969
translate latin a2s3_6841bdd1:

    # "I touch back, pressing my hands over his paws and resting my head against his chest, listening to the rumble of his voice."
    "Eum vicissim tango, manus meas manibus eius imponens caputque pectori innixus, vocis eius sonum audiens."

# game/a2s3.rpy:970
translate latin a2s3_b909f7f4:

    # m "\"Oh? And what's the real Adastra?\""
    m "\"Oh? Et quae est vera Adastra?\""

# game/a2s3.rpy:971
translate latin a2s3_48c01a4b:

    # "Amicus pulls his paw away for just a moment to wave it dismissively before returning it to press against my chest."
    "Amicus manum paulisper removet ut neglegenter agitet; deinde rursus pectori meo admovet."

# game/a2s3.rpy:972
translate latin a2s3_db258f43:

    # a "\"These politics...it doesn't represent the moon's true face. I need to take you to other cities and landscapes. The people are vastly different too, from region to region.\""
    a "\"Hae res publicae...verum lunae vultum non ostendunt. Ad alias urbes atque regiones te ducere debeo. Homines quoque e regione in regionem longe diversi sunt.\""

# game/a2s3.rpy:973
translate latin a2s3_31e1b1cd:

    # m "\"Mmmh.\""
    m "\"Mmmh.\""

# game/a2s3.rpy:974
translate latin a2s3_f3979d53:

    # "I listen to him contentedly for a few minutes, happy to just hear him speak again, reminded of how easy it is for us to just talk to each other."
    "Aliquot minuta eum contentus audio, laetus quod rursus loquitur, memor quam facile inter nos colloquamur."

# game/a2s3.rpy:975
translate latin a2s3_3833f919:

    # "And we actually have time to talk."
    "Atque revera tempus colloquendi habemus."

# game/a2s3.rpy:976
translate latin a2s3_d20dfa1a:

    # "Cato is in a different city on official business, so Cassius had granted us at least a little more time than the last visit."
    "Cato in alia urbe publica negotia agit; itaque Cassius saltem paulo plus temporis quam in priore visitatione nobis concesserat."

# game/a2s3.rpy:977
translate latin a2s3_2d73b835:

    # "Amicus rocks back and forth as I pet the fur on his chest, listening to his heartbeat."
    "Amicus huc atque illuc leniter movetur dum pilos pectoris eius mulceo atque cor pulsans audio."

# game/a2s3.rpy:978
translate latin a2s3_e3db0036:

    # "It's clear that they allow him to bathe down here, but the lack of any perfume leaves only the slight smell of his natural musk."
    "Manifestum est ei hic lavari licere; sed, unguento absente, tenuis tantum naturalis moschi odor eius manet."

# game/a2s3.rpy:979
translate latin a2s3_42c94263:

    # "While I miss the lavender smell I'm used to, I don't mind the masculine scent he's giving off, especially after our little reunion just now."
    "Quamquam lavandulae odorem cui adsuevi desidero, virilem odorem eius non moleste fero, praesertim post brevem illam reunionem modo factam."

# game/a2s3.rpy:980
translate latin a2s3_9f31d986:

    # "I want to sit here forever, feeling completely calm and safe for the first time this week."
    "Hic in perpetuum sedere cupio, primum hac hebdomade prorsus tranquillus ac tutus."

# game/a2s3.rpy:981
translate latin a2s3_13af0719:

    # "I know it has to end though, and there's so much to tell the wolf, so I pull back, looking up at Amicus's face."
    "Scio tamen finiri debere; multa lupo dicenda sunt, itaque recedo et vultum Amici suspicio."

# game/a2s3.rpy:982
translate latin a2s3_2e87079d:

    # m "\"Amicus?\""
    m "\"Amice?\""

# game/a2s3.rpy:984
translate latin a2s3_8ca1d22f:

    # a "\"Yes?\""
    a "\"Volui?\""

# game/a2s3.rpy:985
translate latin a2s3_f5372419:

    # m "\"I need to talk to you about something.\""
    m "\"De quadam re tecum loqui debeo.\""

# game/a2s3.rpy:986
translate latin a2s3_a3442c9b:

    # a "\"Go on.\""
    a "\"Perge.\""

# game/a2s3.rpy:987
translate latin a2s3_dd3a67eb:

    # "Amicus leans down, pressing his nose against my hair and inhaling deeply."
    "Amicus se demittit, nasum capillis meis admovens atque alte inspirans."

# game/a2s3.rpy:988
translate latin a2s3_6d980443:

    # m "\"It's...about the parents, I think. I need to talk to you about something they showed me.\""
    m "\"De Parentibus est...ut puto. De quadam re quam mihi ostenderunt tecum loqui debeo.\""

