
# game/a1s1.rpy:7
translate spanish a1s1_77486a68:

    # unk "\"It's so...large.\""
    unk "\"Es tan...grande.\""

# game/a1s1.rpy:8
translate spanish a1s1_74c91a88:

    # unk "\"It's too much. How do they get anything done?\""
    unk "\"Es demasiado. ¿Cómo consiguen hacer algo?\""

# game/a1s1.rpy:9
translate spanish a1s1_96bd9843:

    # com "\"Sensing doubt. Shall we proceed with the directive, Amicus?\""
    com "\"Detectando dudas. ¿Seguimos con la directiva, Amicus?\""

# game/a1s1.rpy:10
translate spanish a1s1_47478835:

    # a "\"I don't know...Are you sure they're level five?\""
    a "\"No lo sé...¿Seguro que son de nivel cinco?\""

# game/a1s1.rpy:11
translate spanish a1s1_b8ca3f57:

    # com "\"Data from mission 32-65-193 indicates primate species with level five intelligence and—\""
    com "\"Los datos de la misión 32-65-193 indican una especie de primates con inteligencia de nivel cinco y—\""

# game/a1s1.rpy:12
translate spanish a1s1_d83ceef6:

    # a "\"Understood. Thank you.\""
    a "\"Entendido. Gracias.\""

# game/a1s1.rpy:13
translate spanish a1s1_4392f7c4:

    # com "\"Most recent data indicates that all uplift attempts failed.\""
    com "\"Los datos más recientes indican que todos los intentos de elevación fracasaron.\""

# game/a1s1.rpy:14
translate spanish a1s1_a986817b:

    # a "\"Ha, that figures. Why did we try to uplift here in the first place?\""
    a "\"Ja, era de esperar. ¿Por qué intentamos elevarlos aquí para empezar?\""

# game/a1s1.rpy:15
translate spanish a1s1_932c06f3:

    # com "\"Sensing doubt. Shall we procee—\""
    com "\"Detectando dudas. ¿Segui—\""

# game/a1s1.rpy:16
translate spanish a1s1_18bdccdf:

    # a "\"Name of the planet?\""
    a "\"¿Nombre del planeta?\""

# game/a1s1.rpy:17
translate spanish a1s1_ed058531:

    # com "\"Earth.\""
    com "\"Tierra.\""

# game/a1s1.rpy:18
translate spanish a1s1_5af60aea:

    # a "\"Location of Romanus uplift?\""
    a "\"¿Ubicación de la elevación de los Romanus?\""

# game/a1s1.rpy:19
translate spanish a1s1_182bff7d:

    # com "\"The city of Rome, in the state of Italy.\""
    com "\"La ciudad de Roma, en el estado de Italia.\""

# game/a1s1.rpy:20
translate spanish a1s1_859172a1:

    # a "\"Is the probe there?\""
    a "\"¿Está allí la sonda?\""

# game/a1s1.rpy:21
translate spanish a1s1_283efa32:

    # com "\"It has arrived.\""
    com "\"Ha llegado.\""

# game/a1s1.rpy:22
translate spanish a1s1_8a70dce5:

    # a "\"Give me a visual...Zoom in.\""
    a "\"Muéstrame una imagen...Acércala.\""

# game/a1s1.rpy:23
translate spanish a1s1_a20cefa7:

    # "..."
    "..."

# game/a1s1.rpy:24
translate spanish a1s1_e1fda613:

    # a "\"That...doesn't look like Adastra at all.\""
    a "\"Eso...no se parece en nada a Adastra.\""

# game/a1s1.rpy:25
translate spanish a1s1_03043a4b:

    # com "\"Reminder that uplift failed. Ruins of uplift attempt remain.\""
    com "\"Recordatorio: la elevación fracasó. Quedan ruinas de aquel intento.\""

# game/a1s1.rpy:26
translate spanish a1s1_3e9384a3:

    # a "\"Show me the ruins.\""
    a "\"Muéstrame las ruinas.\""

# game/a1s1.rpy:27
translate spanish a1s1_a20cefa7_1:

    # "..."
    "..."

# game/a1s1.rpy:28
translate spanish a1s1_1124cc1e:

    # com "\"Showing the Roman Forum.\""
    com "\"Mostrando el Foro Romano.\""

# game/a1s1.rpy:29
translate spanish a1s1_abaf999a:

    # a "\"...\""
    a "\"...\""

# game/a1s1.rpy:30
translate spanish a1s1_3f3d25dd:

    # com "\"Sensing doubt—\""
    com "\"Detectando dudas—\""

# game/a1s1.rpy:31
translate spanish a1s1_bf7a2451:

    # a "\"Shut up, please.\""
    a "\"Cállate, por favor.\""

# game/a1s1.rpy:32
translate spanish a1s1_2160ca6a:

    # com "\"...\""
    com "\"...\""

# game/a1s1.rpy:33
translate spanish a1s1_11cb2ffa:

    # a "\"What the hell are they even saying? That's not the Language. It's all messed up.\""
    a "\"¿Qué demonios están diciendo? Eso no es la Lengua. Está todo deformado.\""

# game/a1s1.rpy:34
translate spanish a1s1_a20cefa7_2:

    # "..."
    "..."

# game/a1s1.rpy:35
translate spanish a1s1_11847be3:

    # com "\"Sensing—\""
    com "\"Detectando—\""

# game/a1s1.rpy:36
translate spanish a1s1_f76ffc40:

    # a "\"That creature there.\""
    a "\"Esa criatura de ahí.\""

# game/a1s1.rpy:37
translate spanish a1s1_636be05a:

    # com "\"They are called humans.\""
    com "\"Se llaman humanos.\""

# game/a1s1.rpy:38
translate spanish a1s1_8f687ee2:

    # a "\"Get closer.\""
    a "\"Acércate más.\""

# game/a1s1.rpy:39
translate spanish a1s1_a20cefa7_3:

    # "..."
    "..."

# game/a1s1.rpy:40
translate spanish a1s1_ba943069:

    # a "\"It's a human?\""
    a "\"¿Es un humano?\""

# game/a1s1.rpy:41
translate spanish a1s1_14fbafac:

    # com "\"Collecting data...he appears to be a young male human.\""
    com "\"Recopilando datos...Parece ser un humano joven de sexo masculino.\""

# game/a1s1.rpy:42
translate spanish a1s1_a20cefa7_4:

    # "..."
    "..."

# game/a1s1.rpy:43
translate spanish a1s1_97898fd5:

    # a "\"Initiate landing sequence.\""
    a "\"Inicia la secuencia de aterrizaje.\""

# game/a1s1.rpy:44
translate spanish a1s1_1f33b800:

    # com "\"Have you located the directive?\""
    com "\"¿Has localizado el objetivo de la directiva?\""

# game/a1s1.rpy:45
translate spanish a1s1_bcc81977:

    # a "\"Yes.\""
    a "\"Sí.\""

# game/a1s1.rpy:46
translate spanish a1s1_47cb0a76:

    # com "\"Warning that full Nexus analysis is incomple—\""
    com "\"Advertencia: el análisis completo del Nexus está incomple—\""

# game/a1s1.rpy:47
translate spanish a1s1_cb929e37:

    # a "\"Now, please. We cannot waste time outside of the Stretch Drive.\""
    a "\"Ahora, por favor. No podemos perder tiempo cuando no usamos la Propulsión Dilatatoria.\""

# game/a1s1.rpy:48
translate spanish a1s1_a20cefa7_5:

    # "..."
    "..."

# game/a1s1.rpy:49
translate spanish a1s1_b208b2a0:

    # com "\"Initiating landing sequence.\""
    com "\"Iniciando la secuencia de aterrizaje.\""

# game/a1s1.rpy:55
translate spanish a1s1_eb0977cc:

    # "It's hard to believe that I'm actually here."
    "Cuesta creer que esté aquí de verdad."

# game/a1s1.rpy:56
translate spanish a1s1_6d8e1a2e:

    # "After years of fantasizing about it, I'm in Rome..."
    "Tras años soñando con ello, estoy en Roma..."

# game/a1s1.rpy:57
translate spanish a1s1_8c69ffb6:

    # "I've been bouncing around with my friends like an idiot all day."
    "Llevo todo el día de un lado a otro con mis amigos como un idiota."

# game/a1s1.rpy:58
translate spanish a1s1_579c818a:

    # "Yeah, I look like a total tourist, but this is what I've been saving up for for the past two years.."
    "Sí, parezco el típico turista, pero llevo dos años ahorrando para esto.."

# game/a1s1.rpy:59
translate spanish a1s1_aa3b9076:

    # "A whole semester in Rome with the study abroad program."
    "Todo un semestre en Roma con el programa de estudios en el extranjero."

# game/a1s1.rpy:60
translate spanish a1s1_6237c183:

    # "All the conversations I've had with my parents about what a waste of money it would be evaporates from my brain as I take in the view."
    "Mientras contemplo las vistas, se me olvidan todas las conversaciones con mis padres sobre lo que esto supondría de malgasto de dinero."

# game/a1s1.rpy:61
translate spanish a1s1_e3fca3b1:

    # "We only have a few hours, so we move from the Forum to Palatine Hill, then finally to a nearby disco where I get just a little drunk."
    "Solo tenemos unas horas, así que vamos del Foro al Palatino y, por último, a una discoteca cercana, donde me emborracho un poquito."

# game/a1s1.rpy:62
translate spanish a1s1_fb087acd:

    # "Before I know it, it's two in the morning and somehow my friends and I are able to stumble to a taxi that takes us back to our apartments."
    "Antes de darme cuenta, son las dos de la mañana y mis amigos y yo conseguimos llegar a trompicones hasta un taxi que nos lleva de vuelta a nuestros apartamentos."

# game/a1s1.rpy:64
translate spanish a1s1_51699130:

    # "I walk unsteadily through the darkness, glad that I have the place to myself for now."
    "Camino tambaleándome en la oscuridad, contento de tener el piso para mí solo por ahora."

# game/a1s1.rpy:65
translate spanish a1s1_f27ceb0a:

    # "Apparently my group was the first to arrive and my assigned flatmates won't be here for a few days at least."
    "Al parecer, mi grupo ha sido el primero en llegar y mis compañeros de piso asignados no estarán aquí hasta dentro de unos días, como mínimo."

# game/a1s1.rpy:66
translate spanish a1s1_0ebb061a:

    # "I open the door to my room and move my hand along the wall."
    "Abro la puerta de mi habitación y deslizo la mano por la pared."

# game/a1s1.rpy:69
translate spanish a1s1_b12fd0d3:

    # "I stumble in then sit on my bed, bouncing happily for a moment."
    "Entro dando tumbos y me siento en la cama, rebotando alegremente un momento."

# game/a1s1.rpy:70
translate spanish a1s1_b8fd2e60:

    # "I think about going out onto the balcony, but I've been walking all day and it feels too nice to be sitting down."
    "Pienso en salir al balcón, pero llevo todo el día andando y estar sentado me sienta demasiado bien."

# game/a1s1.rpy:71
translate spanish a1s1_2e1bfeb1:

    # "Plus it might not be a great idea considering the state I'm in right now."
    "Además, teniendo en cuenta cómo estoy ahora mismo, quizá no sea muy buena idea."

# game/a1s1.rpy:72
translate spanish a1s1_84af68c2:

    # "Still, just knowing the magic of the city is just outside my window is going to make it hard to sleep."
    "Aun así, solo saber que la magia de la ciudad está al otro lado de mi ventana hará que me cueste dormir."

# game/a1s1.rpy:73
translate spanish a1s1_e8a976a1:

    # "I sigh happily and look around my little room."
    "Suspiro de felicidad y miro a mi alrededor en esta pequeña habitación."

# game/a1s1.rpy:74
translate spanish a1s1_47dfdd03:

    # "Actually I'm told that it's kinda big by this city's standards."
    "Aunque me han dicho que, para lo que se estila en esta ciudad, es bastante grande."

# game/a1s1.rpy:75
translate spanish a1s1_4f58cf74:

    # "It's still a little bare since I just moved in today."
    "Todavía está un poco vacío, porque acabo de instalarme hoy."

# game/a1s1.rpy:76
translate spanish a1s1_3e2aaead:

    # "I'd basically just dropped my suitcases next to the door before running out again."
    "Prácticamente me he limitado a dejar las maletas junto a la puerta antes de salir corriendo otra vez."

# game/a1s1.rpy:77
translate spanish a1s1_6215143f:

    # "I glance at them, but decide I'm way too tired right now to unpack even if my pajamas are in there."
    "Les echo un vistazo, pero decido que estoy demasiado cansado para deshacerlas, aunque tenga el pijama dentro."

# game/a1s1.rpy:78
translate spanish a1s1_0eec5d81:

    # "It's fine if I'm just laying on top of the covers."
    "No pasa nada si solo me tumbo encima de las mantas."

# game/a1s1.rpy:79
translate spanish a1s1_90c175e6:

    # "I'll get to it tomorrow."
    "Ya lo haré mañana."

# game/a1s1.rpy:80
translate spanish a1s1_80c63e49:

    # "In the meantime I just lay back, smiling in the afterglow of today's excitement."
    "Por ahora me tumbo, sonriendo mientras sigo saboreando la emoción de hoy."

# game/a1s1.rpy:81
translate spanish a1s1_dc73bb42:

    # "And tomorrow I'll get to see even more!"
    "¡Y mañana podré ver aún más cosas!"

# game/a1s1.rpy:82
translate spanish a1s1_8bfc9a3d:

    # "Damn it, I need to calm down."
    "Maldita sea, tengo que calmarme."

# game/a1s1.rpy:83
translate spanish a1s1_1a007b80:

    # "No way am I gonna have the energy I'll need tomorrow if I'm up all night."
    "Si me paso la noche en vela, mañana no tendré la energía que necesito."

# game/a1s1.rpy:84
translate spanish a1s1_9d4782e4:

    # "I've got the whole semester and on top of that school doesn't actually start for another two weeks!"
    "¡Tengo todo el semestre por delante y, además, las clases no empiezan hasta dentro de dos semanas!"

# game/a1s1.rpy:85
translate spanish a1s1_e391e053:

    # "There's plenty of time."
    "Hay tiempo de sobra."

# game/a1s1.rpy:86
translate spanish a1s1_27b7ecc1:

    # "Just relax for now and enjoy it."
    "Por ahora, relájate y disfrútalo."

# game/a1s1.rpy:87
translate spanish a1s1_665fd18a:

    # "With that thought in my head, I start to drift off..."
    "Con ese pensamiento en la cabeza, empiezo a quedarme dormido..."

# game/a1s1.rpy:90
translate spanish a1s1_d0394d24:

    # "Something moves..."
    "Algo se mueve..."

# game/a1s1.rpy:91
translate spanish a1s1_ccfa018c:

    # "I lay there in the dark, wondering if I'd dreamed it."
    "Me quedo tumbado en la oscuridad, preguntándome si lo habré soñado."

# game/a1s1.rpy:92
translate spanish a1s1_0ab0e04b:

    # "I had been dreaming, even though I can't remember exactly what it was about."
    "Sí que estaba soñando, aunque no recuerdo exactamente con qué."

# game/a1s1.rpy:93
translate spanish a1s1_32ef38ec:

    # "Something about a portal, maybe?"
    "¿Algo sobre un portal, quizá?"

# game/a1s1.rpy:94
translate spanish a1s1_8fb59446:

    # "I listen for a while, but there's no other sound...just the occasional soft {i}whoosh{/i} of a car passing by outside my balcony."
    "Escucho un rato, pero no se oye nada más...solo el suave {i}susurro{/i} ocasional de un coche que pasa bajo el balcón."

# game/a1s1.rpy:95
translate spanish a1s1_05af45b3:

    # "I shift around a little; the suffocating humidity is making the sheets stick to my skin and I wonder if maybe there's a fan in the closet."
    "Me remuevo un poco; la humedad asfixiante hace que las sábanas se me peguen a la piel y me pregunto si habrá un ventilador en el armario."

# game/a1s1.rpy:96
translate spanish a1s1_08870c26:

    # "I finally sit up in bed, realizing that there's no way I'm going to fall back to sleep like this."
    "Al final me incorporo en la cama, dándome cuenta de que así no voy a poder volver a dormirme."

# game/a1s1.rpy:97
translate spanish a1s1_a4812f89:

    # "I could at least try sliding open the balcony door, though I'm not sure that will do me any good."
    "Al menos podría intentar abrir la puerta corredera del balcón, aunque no sé si me servirá de algo."

# game/a1s1.rpy:98
translate spanish a1s1_362ef336:

    # "Worth a try, I guess."
    "Supongo que merece la pena intentarlo."

# game/a1s1.rpy:99
translate spanish a1s1_252d7c3a:

    # "I groggily slide out of bed and try to slide the glass door open, but it doesn't budge."
    "Todavía aturdido por el sueño, salgo de la cama e intento deslizar la puerta de cristal, pero no se mueve."

# game/a1s1.rpy:100
translate spanish a1s1_04a30081:

    # "I struggle for a few more seconds before sighing and moving toward the door to find the light switch."
    "Forcejeo unos segundos más antes de suspirar e ir hacia la puerta para buscar el interruptor de la luz."

# game/a1s1.rpy:101
translate spanish a1s1_e69927e9:

    # "My feet slide along the semi-cool wooden floor, which feels great, while my hands stretch out in front of me, searching for the wall."
    "Deslizo los pies por el suelo de madera, que está algo fresco y resulta muy agradable, mientras estiro las manos ante mí para buscar la pared."

# game/a1s1.rpy:102
translate spanish a1s1_b318b6c4:

    # "Right then I remember that I was woken up by noises, and I imagine some intruder standing there in the dark, waiting for me to bump into him."
    "Entonces recuerdo que me han despertado unos ruidos e imagino a un intruso ahí parado en la oscuridad, esperando a que me lo encuentre."

# game/a1s1.rpy:103
translate spanish a1s1_c34a963b:

    # "Feeling the hairs stand up on the back of my neck, I quicken my pace and find the wall, fumbling around until—"
    "Siento que se me eriza el vello de la nuca, acelero el paso y encuentro la pared, tanteando hasta que..."

# game/a1s1.rpy:106
translate spanish a1s1_c0f5fb34:

    # "I quickly glance around the room, relieved that it's empty."
    "Miro rápidamente por la habitación, aliviado al ver que está vacía."

# game/a1s1.rpy:107
translate spanish a1s1_8e109e4e:

    # "My parents had warned me about the crime rate here."
    "Mis padres me habían advertido sobre el índice de delincuencia de aquí."

# game/a1s1.rpy:108
translate spanish a1s1_78091602:

    # "While the city is technically safe in terms of murder, robberies and muggings are apparently pretty common."
    "Aunque la ciudad es bastante segura en cuanto a asesinatos, parece que los robos y atracos son bastante habituales."

# game/a1s1.rpy:109
translate spanish a1s1_d7a03ac3:

    # "I had shrugged it off at the time, but now that I'm alone—."
    "En aquel momento no le di importancia, pero ahora que estoy solo..."

# game/a1s1.rpy:110
translate spanish a1s1_898503d3:

    # "I make my way to the balcony, looking for the lock before finally seeing that there's a latch near the top of the door."
    "Me acerco al balcón y busco la cerradura, hasta que por fin veo que hay un pestillo cerca de la parte superior de la puerta."

# game/a1s1.rpy:111
translate spanish a1s1_5da9fad8:

    # "I unhook it and slowly slide the door open."
    "Lo desengancho y deslizo la puerta despacio para abrirla."

# game/a1s1.rpy:112
translate spanish a1s1_2e2d6b3d:

    # "I'm disappointed to find that the air wafting from outside is almost as stuffy as the air inside."
    "Me decepciona comprobar que el aire que entra de fuera es casi tan sofocante como el de dentro."

# game/a1s1.rpy:113
translate spanish a1s1_c35db7eb:

    # "Still, I take the moment to stare out at the lights of the city for a while."
    "Aun así, aprovecho para contemplar un rato las luces de la ciudad."

# game/a1s1.rpy:114
translate spanish a1s1_da1a8ad6:

    # "Even though I'm more interested in the ruins, the city itself is undeniably beautiful."
    "Aunque me interesan más las ruinas, no se puede negar que la ciudad en sí es preciosa."

# game/a1s1.rpy:115
translate spanish a1s1_b7f5d943:

    # "Nothing like my hometown."
    "No se parece en nada a mi ciudad natal."

# game/a1s1.rpy:116
translate spanish a1s1_6904e3bb:

    # "That's when I notice that there's a strange smell in the air, like burning rubber."
    "Entonces noto un olor extraño en el aire, como a goma quemada."

# game/a1s1.rpy:117
translate spanish a1s1_daf99835:

    # "I stick my head out a bit further, looking around for the source, but I see nothing."
    "Saco la cabeza un poco más y miro alrededor para buscar de dónde viene, pero no veo nada."

# game/a1s1.rpy:118
translate spanish a1s1_6c43b34c:

    # "Maybe that's normal here?"
    "¿Quizá sea normal aquí?"

# game/a1s1.rpy:119
translate spanish a1s1_4992f925:

    # "I look back at the clock on the wall."
    "Vuelvo la vista al reloj de la pared."

# game/a1s1.rpy:120
translate spanish a1s1_e806431f:

    # "4 A.M."
    "4 de la madrugada."

# game/a1s1.rpy:121
translate spanish a1s1_6be2e3e0:

    # "I sigh and shuffle back to the bed, only realizing that I've left the light on once I've already fallen back-first onto the covers."
    "Suspiro y arrastro los pies hasta la cama; solo cuando ya me he dejado caer de espaldas sobre las mantas me doy cuenta de que he dejado la luz encendida."

# game/a1s1.rpy:122
translate spanish a1s1_02c81aa4:

    # "I sigh and will myself to get up, but the tiredness has returned and the heavy humidity is almost like a warm blanket pressing down on me."
    "Suspiro y me obligo a levantarme, pero el cansancio ha vuelto y la humedad pesada es casi como una manta caliente que me aplasta."

# game/a1s1.rpy:123
translate spanish a1s1_5ac8571f:

    # "I close my eyes..."
    "Cierro los ojos..."

# game/a1s1.rpy:124
translate spanish a1s1_57d42554:

    # "I'll get up and turn it off in a second, just need to rest my eyes for a bit."
    "Ahora mismo me levanto y la apago; solo necesito descansar los ojos un poco."

# game/a1s1.rpy:125
translate spanish a1s1_cd8e5236:

    # "Just for a bit..."
    "Solo un poco..."

# game/a1s1.rpy:127
translate spanish a1s1_8611e73d:

    # "Something moves again."
    "Algo vuelve a moverse."

# game/a1s1.rpy:128
translate spanish a1s1_381269ae:

    # "And there's another smell in the air."
    "Y hay otro olor en el aire."

# game/a1s1.rpy:129
translate spanish a1s1_5e98d232:

    # "A good smell this time."
    "Esta vez es agradable."

# game/a1s1.rpy:130
translate spanish a1s1_029b4424:

    # "Something floral."
    "Algo floral."

# game/a1s1.rpy:131
translate spanish a1s1_6a7dbfa7:

    # "It reminds me of lavender."
    "Me recuerda a la lavanda."

# game/a1s1.rpy:132
translate spanish a1s1_0c804584:

    # "And that's when something hard and sharp presses into my left eye socket, just above the eye."
    "Entonces algo duro y afilado se me clava en la cuenca del ojo izquierdo, justo encima del ojo."

# game/a1s1.rpy:133
translate spanish a1s1_7600de99:

    # "It doesn't really hurt, but it shocks me awake."
    "No duele realmente, pero el sobresalto me despierta."

# game/a1s1.rpy:138
translate spanish a1s1_a20cefa7_6:

    # "..."
    "..."

# game/a1s1.rpy:139
translate spanish a1s1_3fe64fc1:

    # "It leans over me, something shiny in its grip which it's pulling back from my head."
    "Está inclinado sobre mí, con algo brillante en la mano que aparta de mi cabeza."

# game/a1s1.rpy:143
translate spanish a1s1_dc3047f8:

    # unk "\"Av—\""
    unk "\"Av—\""

# game/a1s1.rpy:144
translate spanish a1s1_15c53b8c:

    # m "\"AH!\""
    m "\"¡AH!\""

# game/a1s1.rpy:149
translate spanish a1s1_b9d9d082:

    # "I kick out with both feet, hitting the thing leaning over me in its body."
    "Doy una patada con ambos pies y golpeo en el cuerpo a la cosa que está inclinada sobre mí."

# game/a1s1.rpy:150
translate spanish a1s1_20f11e71:

    # unk "\"{i}Edapol{/i}!\""
    unk "\"¡{i}Edapol{/i}!\""

# game/a1s1.rpy:151
translate spanish a1s1_d7dc44a6:

    # "It lets out a surprised grunt, stumbling back and falling on its rear while I scramble back on my bed, pressing myself against the wall."
    "Suelta un gruñido de sorpresa, retrocede tambaleándose y cae de culo mientras yo me apresuro a echarme hacia atrás en la cama hasta apretarme contra la pared."

# game/a1s1.rpy:153
translate spanish a1s1_8c3ac6c9:

    # "Almost immediately it scrambles back up, revealing its massive build and its masculine shape."
    "Casi de inmediato se levanta de nuevo, dejando ver su enorme corpulencia y su figura masculina."

# game/a1s1.rpy:154
translate spanish a1s1_76328ece:

    # "It...he adjusts his cape and smooths down his fur before rubbing at his chest, giving me an odd look."
    "La cosa...él se ajusta la capa y se alisa el pelaje antes de frotarse el pecho, mirándome de una forma extraña."

# game/a1s1.rpy:156
translate spanish a1s1_19d89cff:

    # "Then he fixes a smile back on his face."
    "Entonces vuelve a dibujarse una sonrisa en la cara."

# game/a1s1.rpy:158
translate spanish a1s1_46e56750:

    # unk "\"{i}Ave{/i}!\""
    unk "\"¡{i}Ave{/i}!\""

# game/a1s1.rpy:159
translate spanish a1s1_a20cefa7_7:

    # "..."
    "..."

# game/a1s1.rpy:160
translate spanish a1s1_61f958ee:

    # "I stare."
    "Me quedo mirándolo."

# game/a1s1.rpy:161
translate spanish a1s1_8ecf0e79:

    # "That's all I can do is stare."
    "No puedo hacer otra cosa que mirarlo."

# game/a1s1.rpy:163
translate spanish a1s1_4ac0e2c9:

    # "He stares back at me for a moment, then clears his throat."
    "Él también me mira un momento y luego se aclara la garganta."

# game/a1s1.rpy:165
translate spanish a1s1_ef18f8da:

    # unk "\"{i}Ave/{/i}Hello!\""
    unk "\"{i}Ave/{/i}¡Hola!\""

# game/a1s1.rpy:166
translate spanish a1s1_1f3dc6b4:

    # "The space above my left eye throbs and it sounds like I'm hearing two things at once from the same voice."
    "Me palpita la zona por encima del ojo izquierdo y parece que oigo dos cosas a la vez de una misma voz."

# game/a1s1.rpy:168
translate spanish a1s1_3abe4791:

    # unk "\"Erm...{i}Potes intellegere{/i}?/Do you understand?\""
    unk "\"Eh...{i}Potes intellegere{/i}?/¿Me entiendes?\""

# game/a1s1.rpy:169
translate spanish a1s1_bad04be6:

    # "Again the bizarre twitching in my eye, in my brain, and hearing two things at once."
    "Otra vez esa extraña sacudida en el ojo, en el cerebro, y la sensación de oír dos cosas a la vez."

# game/a1s1.rpy:170
translate spanish a1s1_5110002c:

    # "I feel like I'm going to be sick."
    "Siento que voy a vomitar."

# game/a1s1.rpy:171
translate spanish a1s1_75456ed8:

    # "The room shifts and swirls a bit, then slowly starts to settle again."
    "La habitación se mueve y da vueltas un poco, y después vuelve a estabilizarse despacio."

# game/a1s1.rpy:172
translate spanish a1s1_fc81a5c8:

    # "The twitching in my head turns into a dull throb."
    "La sacudida de la cabeza se convierte en un dolor sordo y palpitante."

# game/a1s1.rpy:173
translate spanish a1s1_a30a72be:

    # "I'm having a nightmare."
    "Estoy teniendo una pesadilla."

# game/a1s1.rpy:174
translate spanish a1s1_58a88ee1:

    # unk "\"Do you understand me?\""
    unk "\"¿Me entiendes?\""

# game/a1s1.rpy:175
translate spanish a1s1_52f2f765:

    # "I stare at him and he stares back."
    "Lo miro y él me devuelve la mirada."

# game/a1s1.rpy:176
translate spanish a1s1_1a5a09c6:

    # unk "\"Com, I don't know if the chip is working...\""
    unk "\"Com, no sé si el microchip funciona...\""

# game/a1s1.rpy:177
translate spanish a1s1_b675898e:

    # m "\"Wh—what?\""
    m "\"¿Qu—qué?\""

# game/a1s1.rpy:178
translate spanish a1s1_9866d76f:

    # "The creature raises its hand to its head, rubbing at it."
    "La criatura se lleva una mano a la cabeza y se la frota."

# game/a1s1.rpy:179
translate spanish a1s1_e334ae29:

    # unk "\"Well, he can speak, and it's translating. Can you understand me?\""
    unk "\"Bueno, puede hablar y está traduciendo. ¿Me entiendes?\""

# game/a1s1.rpy:180
translate spanish a1s1_250b5d45:

    # "When am I going to wake up?"
    "¿Cuándo voy a despertarme?"

# game/a1s1.rpy:181
translate spanish a1s1_bfea2ba9:

    # "He keeps staring at me and automatically I respond to him."
    "Sigue mirándome y le respondo de forma automática."

# game/a1s1.rpy:182
translate spanish a1s1_6cd16775:

    # m "\"Y—yes?\""
    m "\"¿S—sí?\""

# game/a1s1.rpy:184
translate spanish a1s1_9b656bf8:

    # unk "\"Ah! Good, seems it's finally working now. They take a moment to adjust to the host brain.\""
    unk "\"¡Ah! Bien, parece que por fin funciona. Tardan un momento en adaptarse al cerebro del huésped.\""

# game/a1s1.rpy:185
translate spanish a1s1_f2c92989:

    # "I struggle to keep up with his words."
    "Me cuesta seguir lo que dice."

# game/a1s1.rpy:186
translate spanish a1s1_eab50ecf:

    # "I'm still hearing what he's saying."
    "Sigo oyendo lo que está diciendo."

# game/a1s1.rpy:187
translate spanish a1s1_adf532a3:

    # "It's almost Italian with the inflections and the rolling R's, but at the same time it's definitely not Italian..."
    "Con esas inflexiones y esas erres vibrantes, casi parece italiano, pero a la vez está claro que no es italiano..."

# game/a1s1.rpy:188
translate spanish a1s1_1190b528:

    # "Still, I can understand what he's saying, like he's speaking my own language at the same time."
    "Aun así, entiendo lo que dice, como si al mismo tiempo hablara mi propio idioma."

# game/a1s1.rpy:189
translate spanish a1s1_21fe1f2e:

    # "It makes it hard to concentrate."
    "Eso hace que me cueste concentrarme."

# game/a1s1.rpy:191
translate spanish a1s1_3ffcf84d:

    # unk "\"What is your name?\""
    unk "\"¿Cómo te llamas?\""

# game/a1s1.rpy:196
translate spanish a1s1_cdacc0ec:

    # "His expectant look almost forces the answer out of my mouth."
    "Su mirada expectante casi me obliga a responder."

# game/a1s1.rpy:197
translate spanish a1s1_31294dd3:

    # m "\"[mc]...\""
    m "\"[mc]...\""

# game/a1s1.rpy:198
translate spanish a1s1_aaa503b5:

    # unk "\"[mc]? Beautiful! I am Amicus.\""
    unk "\"¿[mc]? ¡Qué bonito! Yo soy Amicus.\""

# game/a1s1.rpy:199
translate spanish a1s1_cd4de8f7:

    # "The confusing double language I was hearing is starting to fade, and now only my own language comes from his mouth."
    "La confusa mezcla de dos idiomas empieza a desaparecer y ahora de su boca solo sale mi propia lengua."

# game/a1s1.rpy:200
translate spanish a1s1_5ef2ce8b:

    # "It's odd, the words not quite matching up with his lips."
    "Resulta extraño: las palabras no encajan del todo con el movimiento de sus labios."

# game/a1s1.rpy:201
translate spanish a1s1_b08d468a:

    # "What's even more distracting are the massive canines that continue to flash behind those lips."
    "Lo que me distrae todavía más son los enormes colmillos que no dejan de asomar detrás de esos labios."

# game/a1s1.rpy:202
translate spanish a1s1_9c9f6724:

    # "I need to get the hell out of here."
    "Tengo que salir de aquí, joder."

# game/a1s1.rpy:203
translate spanish a1s1_158b9c11:

    # "Dream or not, I don't like the look of the teeth and claws on this thing."
    "Sea un sueño o no, no me gusta nada el aspecto de los dientes y las garras de esta cosa."

# game/a1s1.rpy:205
translate spanish a1s1_5e7e3d67:

    # a "\"Ah, is the Lingua having troubles again?\""
    a "\"Ah, ¿vuelve a dar problemas la Lingua?\""

# game/a1s1.rpy:206
translate spanish a1s1_07641443:

    # "I don't respond, instead glancing at the door just to the right and behind this...Amicus."
    "No contesto; en lugar de eso, miro la puerta, que queda a la derecha y detrás de este...Amicus."

# game/a1s1.rpy:207
translate spanish a1s1_b4002846:

    # "He frowns."
    "Frunce el ceño."

# game/a1s1.rpy:209
translate spanish a1s1_2fb5f55d:

    # a "\"Com, you told me they're level 5. I can't even speak with it!\""
    a "\"Com, me dijiste que eran de nivel 5. ¡Ni siquiera puedo hablar con él!\""

# game/a1s1.rpy:210
translate spanish a1s1_7de0ee82:

    # "It takes me a moment to realize he's not talking to me."
    "Tardo un momento en darme cuenta de que no está hablando conmigo."

# game/a1s1.rpy:211
translate spanish a1s1_4bbc02a0:

    # "I hear a soft chatter coming from the wolf, like someone's talking to him from a phone, but I can't see anything."
    "Oigo un parloteo tenue que sale del lobo, como si alguien le hablara por teléfono, pero no veo nada."

# game/a1s1.rpy:212
translate spanish a1s1_db48a3ea:

    # a "\"Yeah? Well he kicked me in the chest!\""
    a "\"¿Ah, sí? ¡Pues me ha dado una patada en el pecho!\""

# game/a1s1.rpy:213
translate spanish a1s1_75f5601c:

    # "Amicus rubs at his chest with a frown."
    "Amicus se frota el pecho con el ceño fruncido."

# game/a1s1.rpy:214
translate spanish a1s1_636bc604:

    # "More muffled speaking."
    "Más palabras amortiguadas."

# game/a1s1.rpy:216
translate spanish a1s1_59ab6cfe:

    # a "\"Of course I didn't! He just kicked me! He's looking at me like he has no idea—\""
    a "\"¡Claro que no! ¡Me ha dado una patada sin más! Me mira como si no tuviera ni idea—\""

# game/a1s1.rpy:217
translate spanish a1s1_ef6a8ae0:

    # "More muffled speaking interrupts him."
    "Más palabras amortiguadas lo interrumpen."

# game/a1s1.rpy:219
translate spanish a1s1_a34128dd:

    # a "\"Oh...Wait, what!?\""
    a "\"Oh...¡Espera, ¿qué!?\""

# game/a1s1.rpy:221
translate spanish a1s1_e0f3c827:

    # a "\"Are you serious?\""
    a "\"¿Lo dices en serio?\""

# game/a1s1.rpy:222
translate spanish a1s1_cd9f95da:

    # "Now he looks pissed and I press myself harder against the wall, trying to work up the courage to make a break for the door."
    "Ahora parece enfadado y me aprieto todavía más contra la pared, intentando reunir el valor para salir corriendo hacia la puerta."

# game/a1s1.rpy:223
translate spanish a1s1_2d88f30a:

    # a "\"How—Wait, so you're always offering me opinions on my mood, but you couldn't offer THAT!?\""
    a "\"Cómo—Espera: siempre me das tu opinión sobre mi estado de ánimo, ¡¿pero no podías decirme ESO!?\""

# game/a1s1.rpy:224
translate spanish a1s1_ae57adfd:

    # "More muffled babbling, but the wolf thing interrupts it with a snarl."
    "El parloteo amortiguado continúa, pero la cosa con forma de lobo lo interrumpe con un gruñido."

# game/a1s1.rpy:225
translate spanish a1s1_17fe186c:

    # a "\"Well what the hell do I do now!?\""
    a "\"¡¿Y qué demonios hago ahora!?\""

# game/a1s1.rpy:226
translate spanish a1s1_f892c4df:

    # "His lips are drawn back and now I get to have a real good view of those canines."
    "Ha echado los labios hacia atrás y ahora puedo ver muy bien esos colmillos."

# game/a1s1.rpy:227
translate spanish a1s1_3b34be8e:

    # "I stare wide-eyed at them, and that's when he seems to notice me again."
    "Los miro con los ojos muy abiertos y entonces parece que vuelve a reparar en mí."

# game/a1s1.rpy:229
translate spanish a1s1_e51d5ae8:

    # "He readjusts his expression into a smile, but I can still see a fang poking out."
    "Recompone la expresión en una sonrisa, pero aún puedo ver un colmillo que sobresale."

# game/a1s1.rpy:230
translate spanish a1s1_5c894071:

    # a "\"Heeey, listen...\""
    a "\"Eeeh, escucha...\""

# game/a1s1.rpy:231
translate spanish a1s1_17f03fa3:

    # "Something about the way he acts; his expressions, demeanor..."
    "Hay algo en su forma de actuar: sus expresiones, su actitud..."

# game/a1s1.rpy:232
translate spanish a1s1_6a959af9:

    # "He's so...human."
    "Es tan...humano."

# game/a1s1.rpy:233
translate spanish a1s1_faded846:

    # a "\"Could you...could you come with me outside for a quick moment?\""
    a "\"¿Podrías...podrías acompañarme fuera un momentito?\""

# game/a1s1.rpy:234
translate spanish a1s1_d6527c60:

    # "For some reason the realization of his human-ness makes me absolutely positive that this is a dream."
    "Por alguna razón, al darme cuenta de lo humano que es, me convenzo por completo de que esto es un sueño."

# game/a1s1.rpy:235
translate spanish a1s1_54d3d854:

    # "This must be a character from a game, or movie that I'd seen."
    "Debe de ser un personaje de algún juego o película que haya visto."

# game/a1s1.rpy:236
translate spanish a1s1_c953fec1:

    # "I shake my head slowly at him."
    "Niego con la cabeza despacio."

# game/a1s1.rpy:237
translate spanish a1s1_ea632bd1:

    # a "\"Ah..um, please?\""
    a "\"Ah..eh, ¿por favor?\""

# game/a1s1.rpy:238
translate spanish a1s1_6b056a7b:

    # "I just stare, still waiting to wake up."
    "Me limito a mirarlo, esperando todavía despertarme."

# game/a1s1.rpy:239
translate spanish a1s1_bcd268af:

    # "I've had dreams where I couldn't wake up before. This is just one of those."
    "Ya he tenido sueños de los que no podía despertarme. Este es uno de ellos."

# game/a1s1.rpy:240
translate spanish a1s1_f5dad1d4:

    # "I remember reading somewhere that if you aren't sure you're dreaming you can plug your nose."
    "Recuerdo haber leído en algún sitio que, si no sabes si estás soñando, puedes taparte la nariz."

# game/a1s1.rpy:241
translate spanish a1s1_fdb04c62:

    # "If you can still breathe, then it's definitely a dream."
    "Si aún puedes respirar, entonces seguro que es un sueño."

# game/a1s1.rpy:242
translate spanish a1s1_12fe202d:

    # "But I remain frozen against the wall."
    "Pero sigo inmóvil, pegado a la pared."

# game/a1s1.rpy:244
translate spanish a1s1_6e2be873:

    # "The massive wolf sighs."
    "El enorme lobo suspira."

# game/a1s1.rpy:245
translate spanish a1s1_89e0fbad:

    # "Then his paw suddenly moves to his waist."
    "Entonces, de repente, se lleva la pata a la cintura."

# game/a1s1.rpy:246
translate spanish a1s1_ff6d139f:

    # "I only have a moment to see some sort of device with multi-colored lights before he moves and my entire body seizes up and things go black..."
    "Apenas alcanzo a ver una especie de aparato con luces de varios colores antes de que se mueva, se me paralice todo el cuerpo y todo se vuelva negro..."

# game/a1s1.rpy:250
translate spanish a1s1_b4e715e2:

    # "My body feels strangely numb."
    "Tengo el cuerpo extrañamente entumecido."

# game/a1s1.rpy:251
translate spanish a1s1_76ffee5f:

    # "It's like when I wake up with a dead leg or arm, except right now it's my entire body."
    "Es como cuando me despierto con una pierna o un brazo dormidos, solo que ahora me ocurre en todo el cuerpo."

# game/a1s1.rpy:252
translate spanish a1s1_d03f3ae5:

    # "The only thing I can really feel is a sharp, cold pain behind and above my left eye."
    "Lo único que puedo sentir de verdad es un dolor agudo y frío detrás y encima del ojo izquierdo."

# game/a1s1.rpy:253
translate spanish a1s1_d2021c3d:

    # "I try to wiggle my fingers and hands, wondering if I'm having some sort of sleep paralysis."
    "Intento mover los dedos y las manos, preguntándome si estoy teniendo algún tipo de parálisis del sueño."

# game/a1s1.rpy:254
translate spanish a1s1_10f45fad:

    # "They move, at least I think they do; everything's so dark."
    "Se mueven, o al menos eso creo; está todo tan oscuro."

# game/a1s1.rpy:255
translate spanish a1s1_9c3ec7b9:

    # "Am I still in the apartment?"
    "¿Sigo en el apartamento?"

# game/a1s1.rpy:256
translate spanish a1s1_00f2b5db:

    # "Usually there's a little bit of light coming from the balcony because of the street lamps, but everything is pitch-black."
    "Normalmente entra algo de luz del balcón por las farolas, pero ahora todo está completamente a oscuras."

# game/a1s1.rpy:257
translate spanish a1s1_9b39a63c:

    # "I start to feel a little panicky, both from the numb feeling and also the idea that I might have gone blind somehow."
    "Empiezo a asustarme un poco, tanto por el entumecimiento como por la idea de que quizá me haya quedado ciego de alguna manera."

# game/a1s1.rpy:258
translate spanish a1s1_dae82f25:

    # "I try to remember what happened last."
    "Intento recordar qué ha pasado por última vez."

# game/a1s1.rpy:259
translate spanish a1s1_289b5d1f:

    # "Did I go out somewhere, maybe a club?"
    "¿Salí por ahí, a algún club quizá?"

# game/a1s1.rpy:260
translate spanish a1s1_6e857eba:

    # "The disco."
    "La discoteca."

# game/a1s1.rpy:261
translate spanish a1s1_ee08ab67:

    # "Did I take something?"
    "¿Tomé algo?"

# game/a1s1.rpy:262
translate spanish a1s1_075ec059:

    # "I start to push myself up and that's when I feel something soft under my hands...and something very hard under it, like concrete."
    "Empiezo a incorporarme y entonces siento algo blando bajo las manos...y, debajo, algo muy duro, como cemento."

# game/a1s1.rpy:263
translate spanish a1s1_73cf309b:

    # "I'm definitely not in a bed right now."
    "Está claro que ahora no estoy en una cama."

# game/a1s1.rpy:264
translate spanish a1s1_cef37a22:

    # "Now I really am starting to panic, wondering if I've been kidnapped."
    "Ahora sí que empiezo a entrar en pánico y me pregunto si me han secuestrado."

# game/a1s1.rpy:265
translate spanish a1s1_7e1507a7:

    # "I get on my hands and knees, thankful that at least the numb feeling is going away."
    "Me pongo a cuatro patas, agradecido de que al menos se me esté pasando el entumecimiento."

# game/a1s1.rpy:266
translate spanish a1s1_31be5b3f:

    # "I'm also relieved to find out I'm not blind; I see a soft glow of light outlining what's roughly the shape of a door in front of me."
    "También me alivia descubrir que no estoy ciego: veo un resplandor tenue que perfila algo con forma aproximada de puerta frente a mí."

# game/a1s1.rpy:267
translate spanish a1s1_4fdbaef1:

    # "I open my mouth, about to call out before I force it shut again."
    "Abro la boca, a punto de gritar, pero me obligo a cerrarla otra vez."

# game/a1s1.rpy:268
translate spanish a1s1_0ba1121e:

    # "I have no idea where I am, or how I got here, but I'm not liking the signs."
    "No tengo ni idea de dónde estoy ni de cómo he llegado aquí, pero las señales no me gustan nada."

# game/a1s1.rpy:269
translate spanish a1s1_835e8790:

    # "My head throbs a little and I close my eyes tight, trying to steady my breathing, listening to my heart pound."
    "Me palpita un poco la cabeza y cierro los ojos con fuerza, intentando regular la respiración mientras escucho los latidos del corazón."

# game/a1s1.rpy:270
translate spanish a1s1_dc20e7df:

    # "I definitely got back to my apartment and I remember going to bed, and then I remember..."
    "Seguro que volví a mi apartamento y recuerdo haberme acostado, y luego recuerdo..."

# game/a1s1.rpy:271
translate spanish a1s1_a0aa26ec:

    # "My eyes fly open as I remember that...wolf creature, staring at me with those blue eyes."
    "Abro los ojos de golpe al recordar a aquella...criatura con forma de lobo, mirándome con esos ojos azules."

# game/a1s1.rpy:272
translate spanish a1s1_cb7874a8:

    # "And those teeth!"
    "¡Y esos dientes!"

# game/a1s1.rpy:273
translate spanish a1s1_0103c0fe:

    # "Oh my God, there's no way, there's no fucking way."
    "Dios mío, no puede ser, no puede ser, joder."

# game/a1s1.rpy:274
translate spanish a1s1_ec49e5ca:

    # "I open my eyes again and stare at the soft light, trying to listen."
    "Vuelvo a abrir los ojos y miro fijamente la tenue luz, intentando escuchar."

# game/a1s1.rpy:275
translate spanish a1s1_d61f7ee1:

    # "There's a constant hum of some kind, a whirring of a large machine."
    "Hay una especie de zumbido constante, el ronroneo de una máquina grande."

# game/a1s1.rpy:276
translate spanish a1s1_ab5e021d:

    # "It's gentle and almost soothing, but it makes me think I'm in some sort of vehicle."
    "Es suave y casi tranquilizador, pero me hace pensar que estoy en algún tipo de vehículo."

# game/a1s1.rpy:277
translate spanish a1s1_30bd4fdc:

    # "But I don't feel anything, no bumps or turns..."
    "Pero no noto nada: ni baches ni giros..."

# game/a1s1.rpy:278
translate spanish a1s1_e291e558:

    # "I slowly crawl toward the door, listening as hard as I can for voices, or movement, anything that might tell me someone's nearby."
    "Me arrastro despacio hacia la puerta, prestando toda la atención posible a voces, movimientos o cualquier cosa que me indique que hay alguien cerca."

# game/a1s1.rpy:279
translate spanish a1s1_0f6961e2:

    # "As I get closer to the door I do hear something, a type of beeping and chirping."
    "Al acercarme a la puerta sí que oigo algo: una especie de pitidos y chirridos."

# game/a1s1.rpy:280
translate spanish a1s1_805651df:

    # "I stay in that position for what feels like a solid fifteen minutes, not hearing anything more."
    "Me quedo en esa posición lo que me parecen quince minutos enteros, sin oír nada más."

# game/a1s1.rpy:281
translate spanish a1s1_59eadde4:

    # "I think about trying to open the door, but I realize that might not be a great idea."
    "Pienso en intentar abrir la puerta, pero me doy cuenta de que quizá no sea muy buena idea."

# game/a1s1.rpy:282
translate spanish a1s1_10bc3e4b:

    # "I still don't know if that wolf is real...no, I know he isn't real."
    "Aún no sé si ese lobo es real...no, sé que no es real."

# game/a1s1.rpy:283
translate spanish a1s1_f05fef11:

    # "What's more likely is that someone slipped something into my drink and I hallucinated everything."
    "Lo más probable es que alguien me echara algo en la bebida y yo haya alucinado todo lo demás."

# game/a1s1.rpy:284
translate spanish a1s1_c63e16de:

    # "I had laughed off my parents' warnings that tourists are vulnerable in Rome, but now that doesn't seem so crazy."
    "Me había reído de las advertencias de mis padres sobre lo vulnerables que son los turistas en Roma, pero ahora ya no parecen tan disparatadas."

# game/a1s1.rpy:285
translate spanish a1s1_538547c6:

    # "Someone had drugged me, followed me to my apartment, then kidnapped me."
    "Alguien me ha drogado, me ha seguido hasta el apartamento y luego me ha secuestrado."

# game/a1s1.rpy:286
translate spanish a1s1_fc6ea5f3:

    # "I need something, a weapon, before I try opening the door."
    "Necesito algo, un arma, antes de intentar abrir la puerta."

# game/a1s1.rpy:287
translate spanish a1s1_539b7556:

    # "I feel like I'm in a closet of some kind so there's probably something here that I can use..."
    "Tengo la sensación de estar en una especie de armario, así que probablemente haya algo aquí que pueda usar..."

# game/a1s1.rpy:288
translate spanish a1s1_36d81232:

    # "Slowly, I get on my knees and start moving forward, waving my hands out in front of me."
    "Despacio, me pongo de rodillas y empiezo a avanzar, moviendo las manos de un lado a otro frente a mí."

# game/a1s1.rpy:289
translate spanish a1s1_0f0e81ad:

    # "If I can find the shelves then I can just feel around for something solid and—"
    "Si encuentro las estanterías, podré buscar a tientas algo sólido y—"

# game/a1s1.rpy:291
translate spanish a1s1_70ae9824:

    # "My hand sweeps what feels like a box and what follows is a clang of metal as something falls to the floor."
    "La mano roza lo que parece una caja y luego se oye un ruido metálico cuando algo cae al suelo."

# game/a1s1.rpy:292
translate spanish a1s1_a8aedc81:

    # "I cringe, squeezing my eyes shut as the sound echoes around the room I'm in."
    "Me estremezco y aprieto los ojos mientras el ruido resuena por la habitación en la que estoy."

# game/a1s1.rpy:293
translate spanish a1s1_97acbeef:

    # "I kneel there in complete silence, stunned."
    "Me quedo ahí de rodillas, en completo silencio, aturdido."

# game/a1s1.rpy:294
translate spanish a1s1_74d4cc3a:

    # "And that's when light spills over my body, followed by a large shadow."
    "Entonces la luz se derrama sobre mi cuerpo, seguida de una gran sombra."

# game/a1s1.rpy:295
translate spanish a1s1_8a1ee62e:

    # a "\"Oh hey, you're awake! Did you know he was awake?\""
    a "\"¡Ah, oye, estás despierto! ¿Sabías que estaba despierto?\""

# game/a1s1.rpy:296
translate spanish a1s1_153b1bf3:

    # unk "\"Yes, for approximately .2 hours—\""
    unk "\"Sí, desde hace aproximadamente .2 horas—\""

# game/a1s1.rpy:297
translate spanish a1s1_dcb96c62:

    # a "\"I swear to the Gods, why are you so useless?\""
    a "\"Te lo juro por los Dioses, ¿por qué eres tan inútil?\""

# game/a1s1.rpy:298
translate spanish a1s1_a5c77630:

    # "I sit there, not having turned around yet, but the shadow gets bigger and I feel him looming over me."
    "Me quedo sentado sin haberme girado todavía, pero la sombra se hace mayor y noto que él se cierne sobre mí."

# game/a1s1.rpy:299
translate spanish a1s1_2d45f00c:

    # "I get a whiff of lavender."
    "Me llega un olor a lavanda."

# game/a1s1.rpy:300
translate spanish a1s1_758ccfed:

    # "Finally, I slowly turn my head and see the wolf."
    "Por fin giro la cabeza despacio y veo al lobo."

# game/a1s1.rpy:304
translate spanish a1s1_d58c4651:

    # "He towers over me, his broad muzzle pointed down so that he can look me right in the eye."
    "Se alza sobre mí, con el ancho hocico inclinado hacia abajo para mirarme directamente a los ojos."

# game/a1s1.rpy:305
translate spanish a1s1_a0f5fdc4:

    # "While his size and general demeanor are intimidating, his eyes are warm and friendly."
    "Aunque su tamaño y su actitud resultan intimidantes, tiene una mirada cálida y amistosa."

# game/a1s1.rpy:306
translate spanish a1s1_88fd5c4f:

    # "That doesn't really matter to me right now as I realize that I hadn't been dreaming or hallucinating earlier..."
    "Eso ahora me da bastante igual, al darme cuenta de que antes no estaba soñando ni alucinando..."

# game/a1s1.rpy:307
translate spanish a1s1_9389d513:

    # "...or the dream/hallucination is ongoing."
    "...o el sueño o la alucinación siguen en marcha."

# game/a1s1.rpy:308
translate spanish a1s1_38aad77c:

    # "The wolf moves toward me and I immediately scoot back until the shelves behind me dig into my spine."
    "El lobo se acerca y yo me echo de inmediato hacia atrás, hasta que las estanterías que tengo detrás se me clavan en la espalda."

# game/a1s1.rpy:309
translate spanish a1s1_8a6c55e4:

    # "I vaguely notice the metal thing that I'd knocked over earlier."
    "Apenas reparo en el objeto metálico que he tirado antes."

# game/a1s1.rpy:310
translate spanish a1s1_053230ef:

    # "It's a polygon-shaped thing with a long cord running out of it."
    "Es un objeto con forma de polígono y un cable largo que sale de él."

# game/a1s1.rpy:311
translate spanish a1s1_b526df15:

    # unk "\"Remember the human doesn't know about the {i}Galaxias{/i}; proceed with caution.\""
    unk "\"Recuerda que el humano no conoce el {i}Galaxias{/i}; procede con cautela.\""

# game/a1s1.rpy:312
translate spanish a1s1_790bfe0c:

    # "The wolf's ears flick before he visibly tries to right his expression into a smile."
    "Las orejas del lobo se mueven y luego intenta visiblemente recomponer el rostro en una sonrisa."

# game/a1s1.rpy:314
translate spanish a1s1_fc469198:

    # a "\"H—hello human, sorry, I mean [mc], right?\""
    a "\"H—hola, humano; perdón, quería decir [mc], ¿verdad?\""

# game/a1s1.rpy:315
translate spanish a1s1_038f75e9:

    # "Again, I get caught up in watching the movements of his mouth counter to what I'm hearing in my brain."
    "Vuelvo a quedarme pendiente del movimiento de su boca, que no coincide con lo que oigo en la cabeza."

# game/a1s1.rpy:316
translate spanish a1s1_96ce96fd:

    # "Then I notice that he's waiting, watching me intently."
    "Entonces noto que está esperando, mirándome con atención."

# game/a1s1.rpy:317
translate spanish a1s1_0027a5a0:

    # "I open my mouth, then close it, then nod."
    "Abro la boca, la cierro y luego asiento."

# game/a1s1.rpy:319
translate spanish a1s1_b1003efd:

    # "The wolf still stares at me, seeming not to understand."
    "El lobo sigue mirándome, como si no entendiera."

# game/a1s1.rpy:320
translate spanish a1s1_128c51ae:

    # a "\"Right?\""
    a "\"¿Verdad?\""

# game/a1s1.rpy:321
translate spanish a1s1_c8af9c77:

    # "The silence stretches on until I finally force myself to speak."
    "El silencio se alarga hasta que por fin me obligo a hablar."

# game/a1s1.rpy:322
translate spanish a1s1_499b85ea:

    # m "\"Yes.\""
    m "\"Sí.\""

# game/a1s1.rpy:323
translate spanish a1s1_ac0729a6:

    # "It comes out in barely a whisper."
    "Mi voz apenas es un susurro."

# game/a1s1.rpy:325
translate spanish a1s1_8dad4b44:

    # a "\"Great! So now that we understand that, I can tell you that I'm from the star {i}Stella Vita{/i}, very far from here.\""
    a "\"¡Muy bien! Ahora que lo tenemos claro, puedo decirte que vengo de la estrella {i}Stella Vita{/i}, muy lejos de aquí.\""

# game/a1s1.rpy:326
translate spanish a1s1_d2535d3d:

    # "The wolf sets his paws far apart, his eyes wide as he emphasizes the distance."
    "El lobo separa mucho las patas y abre los ojos de par en par para recalcar la distancia."

# game/a1s1.rpy:327
translate spanish a1s1_960bba08:

    # "He's talking to me in a way one might to a very dumb two-year-old."
    "Me habla como le hablaría uno a un niño de dos años muy tonto."

# game/a1s1.rpy:328
translate spanish a1s1_80b66eda:

    # a "\"I live on a moon called Adastra. Do you know what a moon is? You live on what's called a planet.\""
    a "\"Vivo en una luna llamada Adastra. ¿Sabes qué es una luna? Tú vives en lo que se llama un planeta.\""

# game/a1s1.rpy:329
translate spanish a1s1_b4df7430:

    # "I stare at him for a moment, almost offended despite my continuing shock."
    "Lo miro un momento, casi ofendido pese al estado de conmoción en el que sigo."

# game/a1s1.rpy:331
translate spanish a1s1_5b7aec9d:

    # "Amicus smiles gently."
    "Amicus sonríe con dulzura."

# game/a1s1.rpy:332
translate spanish a1s1_769c331f:

    # a "\"A moon is a large—\""
    a "\"Una luna es un gran—\""

# game/a1s1.rpy:333
translate spanish a1s1_6900e072:

    # m "\"I know what a moon is.\""
    m "\"Sé lo que es una luna.\""

# game/a1s1.rpy:335
translate spanish a1s1_f77dfa4a:

    # "Amicus blinks at me."
    "Amicus me mira y parpadea."

# game/a1s1.rpy:336
translate spanish a1s1_a482770e:

    # m "\"We have one.\""
    m "\"Tenemos una.\""

# game/a1s1.rpy:337
translate spanish a1s1_2cbda01f:

    # "My words feel automatic...actually everything feels like it's on auto-pilot right now."
    "Las palabras me salen solas...en realidad, ahora siento que todo funciona en piloto automático."

# game/a1s1.rpy:339
translate spanish a1s1_f54a9733:

    # a "\"Oh! Well, I didn't know that. That's great!\""
    a "\"¡Oh! No lo sabía. ¡Qué bien!\""

# game/a1s1.rpy:340
translate spanish a1s1_6a9a5981:

    # "There's an awkward silence as the two of us stare at each other."
    "Se hace un silencio incómodo mientras nos miramos el uno al otro."

# game/a1s1.rpy:341
translate spanish a1s1_2d16ed10:

    # "The initial fear is wearing off."
    "El miedo inicial empieza a disiparse."

# game/a1s1.rpy:342
translate spanish a1s1_365e654c:

    # "I feel that if this alien is meaning to hurt me, he would have done it by now."
    "Tengo la sensación de que, si este alienígena quisiera hacerme daño, ya lo habría hecho."

# game/a1s1.rpy:343
translate spanish a1s1_7fcc53a5:

    # "At least...for now."
    "Al menos...por ahora."

# game/a1s1.rpy:344
translate spanish a1s1_f36df3b1:

    # "Amicus rubs his paws together nervously."
    "Amicus se frota las patas con nerviosismo."

# game/a1s1.rpy:345
translate spanish a1s1_68298918:

    # a "\"Um...are you hungry?\""
    a "\"Eh...¿tienes hambre?\""

# game/a1s1.rpy:346
translate spanish a1s1_0a18126c:

    # "He motions at his mouth, then rubs his stomach while licking his lips."
    "Se señala la boca y luego se frota la barriga mientras se relame los labios."

# game/a1s1.rpy:348
translate spanish a1s1_ead8f92b:

    # a "\"Mmmmmh.\""
    a "\"Mmmmmh.\""

# game/a1s1.rpy:349
translate spanish a1s1_16af2423:

    # "Again, gestures and expressions that I have no trouble interpreting."
    "Una vez más, gestos y expresiones que interpreto sin dificultad."

# game/a1s1.rpy:350
translate spanish a1s1_f4de058d:

    # "The only alien thing about him is his appearance."
    "Lo único alienígena de él es su aspecto."

# game/a1s1.rpy:351
translate spanish a1s1_15ceed41:

    # m "\"I—I don't know.\""
    m "\"N—no lo sé.\""

# game/a1s1.rpy:353
translate spanish a1s1_92b2af0b:

    # "The wolf frowns, almost looking frustrated."
    "El lobo frunce el ceño, casi frustrado."

# game/a1s1.rpy:354
translate spanish a1s1_e91da4e9:

    # "His slow speech gets even slower."
    "Ya hablaba despacio, pero ahora lo hace aún más lentamente."

# game/a1s1.rpy:355
translate spanish a1s1_bca898d5:

    # a "\"Well...why don't we give it a try, then?\""
    a "\"Bueno...¿por qué no lo probamos, entonces?\""

# game/a1s1.rpy:356
translate spanish a1s1_362b6ad3:

    # "I guess my answers don't exactly make me seem intelligent."
    "Supongo que mis respuestas no me hacen parecer precisamente inteligente."

# game/a1s1.rpy:357
translate spanish a1s1_3d741ce9:

    # "But I don't know how else to respond."
    "Pero no sé de qué otra forma responder."

# game/a1s1.rpy:359
translate spanish a1s1_84865bfb:

    # a "\"Why don't you come out onto the deck with me? I'll make something.\""
    a "\"¿Por qué no sales conmigo a la cubierta? Prepararé algo.\""

# game/a1s1.rpy:360
translate spanish a1s1_643c336d:

    # "Amicus gives an exaggerated \"come on\" gesture with both paws as he walks backwards...straight into the wall as he misses the door."
    "Amicus hace un exagerado gesto de \"vamos\" con ambas patas mientras camina hacia atrás...directo contra la pared, porque no acierta con la puerta."

# game/a1s1.rpy:364
translate spanish a1s1_216c9f25:

    # a "\"Ow! Uh, yeah, let's go human.\""
    a "\"¡Ay! Eh, sí, vamos, humano.\""

# game/a1s1.rpy:365
translate spanish a1s1_1ee0652a:

    # "He rubs the back of his head with a wince before turning and walking out the door."
    "Se frota la nuca con una mueca de dolor antes de darse la vuelta y salir por la puerta."

# game/a1s1.rpy:368
translate spanish a1s1_209a8389:

    # "I stare at the open door for a moment before slowly getting up and following him, walking over a brown shag rug; the soft thing I'd been laying on."
    "Miro un momento la puerta abierta antes de levantarme despacio y seguirlo, pasando sobre una alfombra marrón de pelo largo: el objeto blando sobre el que estaba tumbado."

# game/a1s1.rpy:371
translate spanish a1s1_1c3668e4:

    # "That's when I'm standing in the middle of what looks like something straight out of a sci-fi movie."
    "Entonces me encuentro en medio de algo que parece sacado directamente de una película de ciencia ficción."

# game/a1s1.rpy:372
translate spanish a1s1_d3aafc8b:

    # "It's small and cramped, but the amount of unfamiliar, glowing technology is almost overwhelming."
    "Es pequeño y estrecho, pero la cantidad de tecnología desconocida y luminosa resulta casi abrumadora."

# game/a1s1.rpy:373
translate spanish a1s1_2f49535c:

    # "Glass panels cover almost every inch of the walls around me, displaying images and characters that I can't even come close to understanding."
    "Unos paneles de cristal cubren casi cada centímetro de las paredes que me rodean, mostrando imágenes y caracteres que ni siquiera me acerco a comprender."

# game/a1s1.rpy:374
translate spanish a1s1_a16ecf0e:

    # "Straight ahead of me are large windows, looking out into blackness dotted with specks of light."
    "Justo frente a mí hay unas ventanas grandes que dan a una oscuridad salpicada de pequeños puntos de luz."

# game/a1s1.rpy:375
translate spanish a1s1_9faf8a1c:

    # "Specks of light..."
    "Puntos de luz..."

# game/a1s1.rpy:376
translate spanish a1s1_b8d229da:

    # "I'm in a space ship."
    "Estoy en una nave espacial."

# game/a1s1.rpy:377
translate spanish a1s1_e4f61777:

    # "Where the hell is he taking me?"
    "¿Adónde demonios me está llevando?"

# game/a1s1.rpy:378
translate spanish a1s1_3ea9be29:

    # "Amicus is over to my right side, messing with what I can only describe as a large Espresso machine growing out of the side of the spaceship."
    "Amicus está a mi derecha, trasteando con algo que solo puedo describir como una enorme máquina de café expreso que parece brotar del costado de la nave."

# game/a1s1.rpy:379
translate spanish a1s1_2d070ccd:

    # "He's holding a cup under a nozzle, ducking down a little to stare at the opening."
    "Sostiene una taza bajo una boquilla, agachándose un poco para mirar el orificio."

# game/a1s1.rpy:380
translate spanish a1s1_56536181:

    # "He notices me looking."
    "Se da cuenta de que lo estoy mirando."

# game/a1s1.rpy:382
translate spanish a1s1_eac2e36f:

    # a "\"Heh, takes a while to warm up...I have to warn you that it's not very good, but it's probably better than most of what you eat on your moon...planet, I mean.\""
    a "\"Je, tarda un poco en calentarse...Tengo que advertirte que no está muy bueno, pero probablemente sea mejor que la mayoría de lo que coméis en vuestra luna...planeta, quería decir.\""

# game/a1s1.rpy:383
translate spanish a1s1_eef02891:

    # "Just as he's talking a very thick globule of brown sludge shoots out of the nozzle, half of it missing the cup."
    "Mientras habla, una masa muy espesa de fango marrón sale disparada de la boquilla y la mitad cae fuera de la taza."

# game/a1s1.rpy:385
translate spanish a1s1_8b9e4bab:

    # a "\"Ah, dammit.\""
    a "\"Ah, maldita sea.\""

# game/a1s1.rpy:386
translate spanish a1s1_e3acdd97:

    # "The wolf hastily moves the cup to catch the rest of it while reaching over with his other paw to snatch up a rag from a hook on the side of the machine."
    "El lobo mueve la taza apresuradamente para recoger el resto, mientras con la otra pata coge un trapo que cuelga de un gancho en el lateral de la máquina."

# game/a1s1.rpy:388
translate spanish a1s1_7edc4041:

    # a "\"Sorry, this thing is near broken. Do you want to sit down?\""
    a "\"Perdón, este cacharro está casi roto. ¿Quieres sentarte?\""

# game/a1s1.rpy:389
translate spanish a1s1_a133266e:

    # "He nods his head over at one of the two seats in front of the windows."
    "Señala con la cabeza uno de los dos asientos que hay delante de las ventanas."

# game/a1s1.rpy:390
translate spanish a1s1_39269607:

    # a "\"Just, uh, don't touch any of the bright lights, okay?\""
    a "\"Solo, eh, no toques ninguna de las luces brillantes, ¿vale?\""

# game/a1s1.rpy:392
translate spanish a1s1_fce7187e:

    # "I make my way over to the front of the deck, still waiting to wake up."
    "Me dirijo a la parte delantera de la cubierta, esperando todavía despertarme."

# game/a1s1.rpy:393
translate spanish a1s1_68e55c7a:

    # "I stand beside the seat, reaching out to touch the soft red bristles of the helmet and the wings on the sides."
    "Me paro junto al asiento y alargo la mano para tocar las suaves cerdas rojas del casco y las alas de sus lados."

# game/a1s1.rpy:394
translate spanish a1s1_ab97a796:

    # "This only enforces the feeling that I'm hallucinating or dreaming."
    "Eso no hace más que reforzar la sensación de que estoy alucinando o soñando."

# game/a1s1.rpy:395
translate spanish a1s1_64650b80:

    # "There's a strange Roman influence to Amicus and the ship, one that's almost cartoonish."
    "Amicus y la nave tienen una extraña influencia romana, casi propia de unos dibujos animados."

# game/a1s1.rpy:396
translate spanish a1s1_bcab87f8:

    # "Has my obsession over Rome gone too far?"
    "¿Habrá llegado demasiado lejos mi obsesión con Roma?"

# game/a1s1.rpy:397
translate spanish a1s1_24c0ed8a:

    # "I can just imagine myself in some Italian hospital right now, babbling about Roman wolf aliens."
    "Me imagino perfectamente en algún hospital italiano ahora mismo, balbuceando sobre alienígenas romanos con forma de lobo."

# game/a1s1.rpy:399
translate spanish a1s1_972bf95c:

    # a "\"Go on and sit.\""
    a "\"Venga, siéntate.\""

# game/a1s1.rpy:400
translate spanish a1s1_a849b504:

    # "Amicus plants himself heavily in the seat next to mine, holding two cups of what looks like brown sludge."
    "Amicus se deja caer pesadamente en el asiento de al lado, sosteniendo dos tazas de lo que parece fango marrón."

# game/a1s1.rpy:401
translate spanish a1s1_0cec13dc:

    # "He holds one out to me."
    "Me ofrece una."

# game/a1s1.rpy:402
translate spanish a1s1_d081d670:

    # "I take it gingerly before sitting down."
    "La cojo con cuidado antes de sentarme."

# game/a1s1.rpy:403
translate spanish a1s1_1b119778:

    # "Looking into the cup, the \"food\" has the consistency and look of half-melted chocolate ice cream."
    "Miro dentro de la taza; la \"comida\" tiene la textura y el aspecto de un helado de chocolate a medio derretir."

# game/a1s1.rpy:404
translate spanish a1s1_6b4da191:

    # "Except it's warm and smells like dirt, like literal mud."
    "Solo que está caliente y huele a tierra, a barro de verdad."

# game/a1s1.rpy:405
translate spanish a1s1_a1137124:

    # "I scrunch my nose up at it, which Amicus notices."
    "Arrugo la nariz, y Amicus se da cuenta."

# game/a1s1.rpy:407
translate spanish a1s1_cee7e6e4:

    # a "\"Haha! yeah, it's not the best. I actually had some good food that I brought along with me, but I ate it all before I got here.\""
    a "\"¡Ja, ja! Sí, no es lo mejor. Había traído algo de comida buena, pero me la comí toda antes de llegar aquí.\""

# game/a1s1.rpy:408
translate spanish a1s1_a167fbc5:

    # "The wolf shrugs then settles excitedly into his seat."
    "El lobo se encoge de hombros y después se acomoda con entusiasmo en el asiento."

# game/a1s1.rpy:410
translate spanish a1s1_1ec87302:

    # a "\"So tell me about where you're from! What's life like on Earth?\""
    a "\"¡Entonces háblame de donde vienes! ¿Cómo es la vida en la Tierra?\""

# game/a1s1.rpy:411
translate spanish a1s1_ddb84a43:

    # m "\"Um, it's...okay?\""
    m "\"Eh, está...¿bien?\""

# game/a1s1.rpy:413
translate spanish a1s1_b7935aed:

    # a "\"Okay, well, what's your occupation?\""
    a "\"Vale, bueno, ¿a qué te dedicas?\""

# game/a1s1.rpy:414
translate spanish a1s1_71d94276:

    # m "\"I'm...a student.\""
    m "\"Soy...estudiante.\""

# game/a1s1.rpy:415
translate spanish a1s1_41b525ab:

    # a "\"Oh, what discipline?\""
    a "\"Ah, ¿de qué disciplina?\""

# game/a1s1.rpy:416
translate spanish a1s1_37fe3f5e:

    # "I try to adjust to the surreal feeling of talking to this wolf."
    "Intento acostumbrarme a la sensación irreal de estar hablando con este lobo."

# game/a1s1.rpy:417
translate spanish a1s1_26b29875:

    # m "\"I don't know yet. I was looking into history; Greek and Roman studies.\""
    m "\"Aún no lo sé. Me estaba planteando historia: estudios griegos y romanos.\""

# game/a1s1.rpy:418
translate spanish a1s1_5d398362:

    # a "\"Hm...\""
    a "\"Hm...\""

# game/a1s1.rpy:419
translate spanish a1s1_582f5743:

    # "That seems confusing to him for some reason."
    "Por alguna razón, eso parece confundirlo."

# game/a1s1.rpy:420
translate spanish a1s1_d36b52a8:

    # a "\"Do you have an emperor? What's he like?\""
    a "\"¿Tenéis un emperador? ¿Cómo es?\""

# game/a1s1.rpy:421
translate spanish a1s1_9197e014:

    # "I catch myself staring at his mouth again, at the weird way his mouth is un-synced with his words."
    "Me sorprendo mirando su boca otra vez, esa extraña falta de sincronía entre sus movimientos y sus palabras."

# game/a1s1.rpy:422
translate spanish a1s1_544f5dd5:

    # m "\"N—no...\""
    m "\"N—no...\""

# game/a1s1.rpy:424
translate spanish a1s1_8a6defb9:

    # a "\"Then how—\""
    a "\"Entonces, cómo—\""

# game/a1s1.rpy:425
translate spanish a1s1_4fd30174:

    # "I interrupt him."
    "Lo interrumpo."

# game/a1s1.rpy:426
translate spanish a1s1_3d9c52d8:

    # m "\"Why isn't your mouth matching up with the sounds you're making?\""
    m "\"¿Por qué los movimientos de tu boca no coinciden con los sonidos que haces?\""

# game/a1s1.rpy:427
translate spanish a1s1_72e548c1:

    # a "\"Eh?\""
    a "\"¿Eh?\""

# game/a1s1.rpy:428
translate spanish a1s1_88475498:

    # "Even with the space ship and alien around me, it's the weird distortion of feeling like I'm watching a dubbed movie that has me most unsettled."
    "Incluso con la nave espacial y el alienígena que me rodean, lo que más me inquieta es esa extraña distorsión, como si estuviera viendo una película doblada."

# game/a1s1.rpy:430
translate spanish a1s1_0e2194aa:

    # a "\"Oh!\""
    a "\"¡Oh!\""

# game/a1s1.rpy:431
translate spanish a1s1_11b8dc0c:

    # "Amicus points a finger at me to a spot just above my left eye."
    "Amicus señala con un dedo la zona justo encima de mi ojo izquierdo."

# game/a1s1.rpy:432
translate spanish a1s1_6ea5a501:

    # a "\"I gave you a Lingua. It helps you understand me.\""
    a "\"Te he dado una Lingua. Te ayuda a entenderme.\""

# game/a1s1.rpy:433
translate spanish a1s1_c67597be:

    # "I stare at him, but he doesn't offer anything more."
    "Lo miro, pero no explica nada más."

# game/a1s1.rpy:434
translate spanish a1s1_98dbe3cb:

    # m "\"...How?\""
    m "\"...¿Cómo?\""

# game/a1s1.rpy:436
translate spanish a1s1_ac8a2ce6:

    # a "\"Oh, well it, uh, sort of attaches to the language center in the brain.\""
    a "\"Ah, bueno, eh, se conecta de alguna manera al centro del lenguaje del cerebro.\""

# game/a1s1.rpy:437
translate spanish a1s1_08791113:

    # a "\"It's very smart; it learns from the host brain and is able to interpret the eight major Galaxias languages for them.\""
    a "\"Es muy inteligente: aprende del cerebro del huésped y puede interpretar para él las ocho lenguas principales del Galaxias.\""

# game/a1s1.rpy:438
translate spanish a1s1_920b6365:

    # m "\"And...how does it do that?\""
    m "\"Y...¿cómo hace eso?\""

# game/a1s1.rpy:440
translate spanish a1s1_d4fc81df:

    # a "\"Uh, well, our brains are structured in similar ways, at least among Sapients, so it works almost universally.\""
    a "\"Eh, nuestros cerebros tienen una estructura parecida, al menos entre los Sapientes, así que funciona casi de manera universal.\""

# game/a1s1.rpy:441
translate spanish a1s1_7827e68d:

    # a "\"Honestly, it's parental tech, so I'm not fully sure of how it works. None of us do, but it does work.\""
    a "\"Sinceramente, es tecnología de los Padres, así que no sé del todo cómo funciona. Ninguno de nosotros lo sabe, pero funciona.\""

# game/a1s1.rpy:442
translate spanish a1s1_bd610ca3:

    # "Amicus continues to look at me, clearly concerned about something."
    "Amicus sigue mirándome, claramente preocupado por algo."

# game/a1s1.rpy:443
translate spanish a1s1_8417fadc:

    # "But I'm concerned, too."
    "Pero yo también estoy preocupado."

# game/a1s1.rpy:444
translate spanish a1s1_e023eaa1:

    # m "\"How did you get it...into my brain.\""
    m "\"Cómo la has metido...en mi cerebro.\""

# game/a1s1.rpy:445
translate spanish a1s1_1ecffb06:

    # a "\"Uh...\""
    a "\"Eh...\""

# game/a1s1.rpy:447
translate spanish a1s1_42570b6d:

    # a "\"You know, you ask a lot of questions.\""
    a "\"Sabes, haces muchas preguntas.\""

# game/a1s1.rpy:448
translate spanish a1s1_e3a5312e:

    # "I stare at him."
    "Lo miro fijamente."

# game/a1s1.rpy:449
translate spanish a1s1_d2d0a020:

    # m "\"Well, this is all kind of new to me. Should I not be asking questions?\""
    m "\"Bueno, todo esto es nuevo para mí. ¿No debería hacer preguntas?\""

# game/a1s1.rpy:451
translate spanish a1s1_dc36b687:

    # a "\"It's fine. I've just never had a child ask me questions, really. Anyway, there's a device that inserts it. I was lucky to find one left over on the ship.\""
    a "\"No pasa nada. Es que nunca me había hecho preguntas uno de los Hijos, la verdad. En fin, hay un aparato que la inserta. Tuve suerte de encontrar uno que había quedado en la nave.\""

# game/a1s1.rpy:452
translate spanish a1s1_fa44efc7:

    # "Inserts it."
    "La inserta."

# game/a1s1.rpy:453
translate spanish a1s1_1868ae8c:

    # "I rub the spot between my eye and eye socket, the skin slightly tender."
    "Me froto la zona entre el ojo y la cuenca; tengo la piel algo sensible."

# game/a1s1.rpy:455
translate spanish a1s1_ff482f7a:

    # a "\"Does it hurt? That should wear off in a few hours.\""
    a "\"¿Te duele? Debería pasarse en unas horas.\""

# game/a1s1.rpy:456
translate spanish a1s1_1756ca87:

    # "I stare at Amicus for a few moments, then down into my cup, feeling a bit sick."
    "Miro a Amicus unos instantes y después bajo la vista a la taza, sintiendo un poco de náuseas."

# game/a1s1.rpy:457
translate spanish a1s1_04aa5eb6:

    # "Staring at the brown mush isn't helping."
    "Mirar aquella papilla marrón no ayuda."

# game/a1s1.rpy:459
translate spanish a1s1_fcf502c8:

    # a "\"Need help with that? You can eat it like this.\""
    a "\"¿Necesitas ayuda con eso? Puedes comerlo así.\""

# game/a1s1.rpy:460
translate spanish a1s1_d7063bef:

    # "He dips his muzzle down toward his own cup."
    "Inclina el hocico hacia su propia taza."

# game/a1s1.rpy:461
translate spanish a1s1_a4e5521c:

    # "He sticks out a long, thick, pink tongue, pressing it into the sludge before cupping it and bringing it back up into his mouth."
    "Saca una lengua larga, gruesa y rosada y la hunde en el fango; después la curva y se la lleva de nuevo a la boca."

# game/a1s1.rpy:462
translate spanish a1s1_ad6356a8:

    # "He pulls a bit of a face before smiling."
    "Hace una pequeña mueca y luego sonríe."

# game/a1s1.rpy:464
translate spanish a1s1_4be88848:

    # a "\"Not terrible!\""
    a "\"¡No está tan mal!\""

# game/a1s1.rpy:465
translate spanish a1s1_11a936d8:

    # "Then he looks at me a bit closer."
    "Entonces me mira más de cerca."

# game/a1s1.rpy:467
translate spanish a1s1_8971992d:

    # a "\"Wait, you do have a tongue, right?\""
    a "\"Espera, sí que tienes lengua, ¿no?\""

# game/a1s1.rpy:468
translate spanish a1s1_a4fc5b6b:

    # "I stare back at him for a moment before setting the cup to the side on the armrest."
    "Le devuelvo la mirada un momento antes de dejar la taza a un lado, sobre el reposabrazos."

# game/a1s1.rpy:471
translate spanish a1s1_9e2304d6:

    # m "\"What are you doing?\""
    m "\"¿Qué estás haciendo?\""

# game/a1s1.rpy:473
translate spanish a1s1_c42c8b9e:

    # a "\"Huh?\""
    a "\"¿Eh?\""

# game/a1s1.rpy:474
translate spanish a1s1_d63c7aaa:

    # m "\"What is all this, where are you taking me?\""
    m "\"¿Qué es todo esto, adónde me estás llevando?\""

# game/a1s1.rpy:475
translate spanish a1s1_601967be:

    # "At this point I'm starting to get over the shock."
    "A estas alturas empiezo a superar la conmoción."

# game/a1s1.rpy:476
translate spanish a1s1_a2a6a213:

    # "I'm also starting to get annoyed at this alien's complete disregard for...basically everything to do with me."
    "También empiezo a enfadarme por la absoluta indiferencia de este alienígena hacia...prácticamente todo lo que tiene que ver conmigo."

# game/a1s1.rpy:477
translate spanish a1s1_2551b837:

    # m "\"You kidnapped me, you left me in a closet, you're feeding me what looks like shit, and now you tell me you jabbed something into my brain?\""
    m "\"¿Me has secuestrado, me has dejado en un armario, me estás dando algo que parece mierda y ahora me dices que me has clavado algo en el cerebro?\""

# game/a1s1.rpy:479
translate spanish a1s1_96863100:

    # "Amicus actually flinches at that."
    "Amicus sí que da un respingo al oír eso."

# game/a1s1.rpy:480
translate spanish a1s1_af059a4e:

    # a "\"D-does it still hurt? I can give you a pain manager—\""
    a "\"¿T—todavía te duele? Puedo darte un regulador del dolor—\""

# game/a1s1.rpy:481
translate spanish a1s1_76231e5e:

    # m "\"I don't really want anything from you. What is all of this?\""
    m "\"La verdad es que no quiero nada de ti. ¿Qué es todo esto?\""

# game/a1s1.rpy:482
translate spanish a1s1_d841db44:

    # "The wolf just stares at me, wide-eyed."
    "El lobo se limita a mirarme con los ojos muy abiertos."

# game/a1s1.rpy:483
translate spanish a1s1_4da4b17f:

    # "It's like he didn't even consider me being capable of being upset."
    "Es como si ni siquiera se le hubiera ocurrido que yo fuera capaz de enfadarme."

# game/a1s1.rpy:484
translate spanish a1s1_39a9302d:

    # a "\"Hey, it's okay—\""
    a "\"Oye, no pasa nada—\""

# game/a1s1.rpy:485
translate spanish a1s1_d274d0cb:

    # m "\"You kidnapped me.\""
    m "\"Me has secuestrado.\""

# game/a1s1.rpy:486
translate spanish a1s1_5b62667a:

    # "I feel myself getting more panicked, both from the realization of what's happened and what's currently happening."
    "Siento que me entra cada vez más pánico, tanto al darme cuenta de lo que ha pasado como de lo que está pasando ahora."

# game/a1s1.rpy:487
translate spanish a1s1_e9db3d3f:

    # a "\"No! Well, I mean—\""
    a "\"¡No! Bueno, quería decir—\""

# game/a1s1.rpy:488
translate spanish a1s1_7eb2e208:

    # m "\"You like, tazed me or something!\""
    m "\"¡Me has dado con una táser o algo así!\""

# game/a1s1.rpy:489
translate spanish a1s1_3c8805f7:

    # a "\"What?\""
    a "\"¿Qué?\""

# game/a1s1.rpy:490
translate spanish a1s1_f0910897:

    # m "\"You electrocuted me.\""
    m "\"Me has electrocutado.\""

# game/a1s1.rpy:491
translate spanish a1s1_7c665dcb:

    # a "\"No! It's not electricity.\""
    a "\"¡No! No es electricidad.\""

# game/a1s1.rpy:492
translate spanish a1s1_45fa820f:

    # m "\"That doesn't make it better!\""
    m "\"¡Eso no lo mejora!\""

# game/a1s1.rpy:493
translate spanish a1s1_1ae3b06c:

    # "For a brief moment I think about overpowering this wolf, somehow turning the ship around if I can figure it out."
    "Por un breve momento pienso en reducir a este lobo y dar la vuelta a la nave de alguna manera, si consigo averiguar cómo manejarla."

# game/a1s1.rpy:494
translate spanish a1s1_ebed2e1c:

    # com "\"Sensing hostile intent. Proceed with caution, Amicus.\""
    com "\"Detectando intenciones hostiles. Procede con cautela, Amicus.\""

# game/a1s1.rpy:496
translate spanish a1s1_bb80c469:

    # "Amicus doesn't say anything and I see him gripping into his cup tightly."
    "Amicus no dice nada y veo que aprieta con fuerza la taza."

# game/a1s1.rpy:497
translate spanish a1s1_482cc6e6:

    # "I get the odd feeling that he didn't expect me to point these things out to him."
    "Tengo la extraña sensación de que no esperaba que yo le señalara estas cosas."

# game/a1s1.rpy:498
translate spanish a1s1_fa40c7d5:

    # "Did he think that I was that unintelligent?"
    "¿Creía que yo era tan poco inteligente?"

# game/a1s1.rpy:499
translate spanish a1s1_f133bbd8:

    # "I can tell he's calculating something in his head right now, and that makes me nervous."
    "Puedo ver que está calculando algo mentalmente, y eso me pone nervioso."

# game/a1s1.rpy:500
translate spanish a1s1_32db0c6a:

    # "Maybe I should have just played dumb."
    "Quizá debería haberme hecho el tonto."

# game/a1s1.rpy:501
translate spanish a1s1_4877c7bc:

    # "We stare at each other for a long while until Amicus's steely gaze forces me to look away."
    "Nos miramos durante un buen rato, hasta que la mirada de acero de Amicus me obliga a apartar la vista."

# game/a1s1.rpy:502
translate spanish a1s1_323887e5:

    # "I choose to glance up at the ceiling, deciding to change the subject and give myself some time to just think."
    "Decido mirar al techo y cambiar de tema para darme algo de tiempo para pensar."

# game/a1s1.rpy:503
translate spanish a1s1_03388e1b:

    # m "\"What is that thing?\""
    m "\"¿Qué es esa cosa?\""

# game/a1s1.rpy:504
translate spanish a1s1_256eb462:

    # "Amicus clears his throat."
    "Amicus se aclara la garganta."

# game/a1s1.rpy:505
translate spanish a1s1_3c8805f7_1:

    # a "\"What?\""
    a "\"¿Qué?\""

# game/a1s1.rpy:506
translate spanish a1s1_b8592b9d:

    # m "\"That voice.\""
    m "\"Esa voz.\""

# game/a1s1.rpy:507
translate spanish a1s1_938ffb0c:

    # "I nod up at the ceiling, in the vague direction where I heard the sound come from."
    "Señalo con la cabeza hacia el techo, más o menos en la dirección de donde he oído el sonido."

# game/a1s1.rpy:508
translate spanish a1s1_cdb07352:

    # "The thing that can apparently sense my hostile intents."
    "La cosa que al parecer puede detectar mis intenciones hostiles."

# game/a1s1.rpy:510
translate spanish a1s1_0e2194aa_1:

    # a "\"Oh!\""
    a "\"¡Oh!\""

# game/a1s1.rpy:511
translate spanish a1s1_886f7b57:

    # "Amicus looks up at the ceiling too."
    "Amicus también mira al techo."

# game/a1s1.rpy:513
translate spanish a1s1_63cb0efc:

    # a "\"That's Computatrum, or Com. He's pretty annoying, aren't you Com?\""
    a "\"Es Computatrum, o Com. Es bastante molesto, ¿verdad, Com?\""

# game/a1s1.rpy:514
translate spanish a1s1_2d68c962:

    # com "\"I can provide diagnostics on the ship, on the mood and competence of crew mates, on—\""
    com "\"Puedo ofrecer diagnósticos sobre la nave, sobre el estado de ánimo y las capacidades de los tripulantes, sobre—\""

# game/a1s1.rpy:515
translate spanish a1s1_59602e0d:

    # a "\"Thank you, Com. Anyway, he's not actually a sapient. He's a program that can process language and spit out information stored in his database.\""
    a "\"Gracias, Com. En fin, en realidad no es un Sapiente. Es un programa que puede procesar el lenguaje y soltar la información almacenada en su base de datos.\""

# game/a1s1.rpy:516
translate spanish a1s1_54bca475:

    # "Amicus pauses."
    "Amicus hace una pausa."

# game/a1s1.rpy:517
translate spanish a1s1_8192385a:

    # a "\"I'm sorry, you probably don't understand what I'm talking about.\""
    a "\"Perdón, probablemente no entiendas de qué estoy hablando.\""

# game/a1s1.rpy:518
translate spanish a1s1_e2564d96:

    # m "\"Um, I think I do. Artificial intelligence, maybe?\""
    m "\"Eh, creo que sí. ¿Inteligencia artificial, quizá?\""

# game/a1s1.rpy:519
translate spanish a1s1_8ff60a1b:

    # "I reach instinctively for the pocket of my jeans, but I remember that I left my phone on the bedside table."
    "Me llevo la mano instintivamente al bolsillo de los vaqueros, pero recuerdo que he dejado el móvil en la mesilla de noche."

# game/a1s1.rpy:521
translate spanish a1s1_047dc754:

    # "Amicus's eyes widen once again, and again I wonder if I should be keeping my mouth shut."
    "Amicus vuelve a abrir los ojos de par en par y yo vuelvo a preguntarme si debería mantener la boca cerrada."

# game/a1s1.rpy:522
translate spanish a1s1_dacff7bd:

    # "Revealing how much I know seems to be some sort of trigger for him."
    "Revelar cuánto sé parece activar algo en él."

# game/a1s1.rpy:524
translate spanish a1s1_ac9ae423:

    # a "\"Ah...So, have you been in space before?\""
    a "\"Ah...Entonces, ¿has estado antes en el espacio?\""

# game/a1s1.rpy:525
translate spanish a1s1_2088f2ec:

    # m "\"Um, no.\""
    m "\"Eh, no.\""

# game/a1s1.rpy:526
translate spanish a1s1_0d90c929:

    # "I look out the window, staring at the stars."
    "Miro por la ventana y contemplo las estrellas."

# game/a1s1.rpy:527
translate spanish a1s1_c3e08507:

    # a "\"Okay...have your people ever been to space?\""
    a "\"Vale...¿tu gente ha estado alguna vez en el espacio?\""

# game/a1s1.rpy:528
translate spanish a1s1_edee423f:

    # m "\"Uh, no, no we haven't.\""
    m "\"Eh, no, no hemos estado.\""

# game/a1s1.rpy:529
translate spanish a1s1_c05066d5:

    # a "\"Do you know what atoms are, nuclear energy, maybe?\""
    a "\"¿Sabes lo que son los átomos, quizá la energía nuclear?\""

# game/a1s1.rpy:530
translate spanish a1s1_c651d0c8:

    # m "\"No.\""
    m "\"No.\""

# game/a1s1.rpy:531
translate spanish a1s1_59475080:

    # com "\"Based on Nexus analysis on Earth, these statements appear to be misleading, Amicus.\""
    com "\"Según el análisis del Nexus sobre la Tierra, estas afirmaciones parecen engañosas, Amicus.\""

# game/a1s1.rpy:532
translate spanish a1s1_98066696:

    # "I glance at the ceiling again, realizing now that I've got a constant spy above me."
    "Vuelvo a mirar al techo, dándome cuenta de que tengo un espía constante encima de mí."

# game/a1s1.rpy:533
translate spanish a1s1_c5ee7b6e:

    # "I look back at Amicus and we stare at each other in silence for a long moment."
    "Vuelvo a mirar a Amicus y nos observamos en silencio durante un largo momento."

# game/a1s1.rpy:534
translate spanish a1s1_26559216:

    # "Then I realize how absurd all of this is."
    "Entonces me doy cuenta de lo absurdo que es todo esto."

# game/a1s1.rpy:535
translate spanish a1s1_f5a3b597:

    # m "\"What do you want with me?\""
    m "\"¿Qué quieres de mí?\""

# game/a1s1.rpy:536
translate spanish a1s1_96fb641a:

    # "Amicus looks away, seeming to think."
    "Amicus aparta la vista, como si estuviera pensando."

# game/a1s1.rpy:538
translate spanish a1s1_3b13900b:

    # a "\"Well, it's...it's part of a program on my planet to introduce new aliens to the Galaxias.\""
    a "\"Bueno, es...es parte de un programa de mi planeta para presentar nuevos alienígenas al Galaxias.\""

# game/a1s1.rpy:539
translate spanish a1s1_d18dcfb8:

    # m "\"What is that?\""
    m "\"¿Qué es eso?\""

# game/a1s1.rpy:541
translate spanish a1s1_e2ed25f4:

    # a "\"It's the greater galactic civilization, [mc]. It's a gradual strategy to slowly introduce Earth to the idea of other Sapients.\""
    a "\"Es la gran civilización galáctica, [mc]. Es una estrategia gradual para familiarizar poco a poco a la Tierra con la idea de que existen otros Sapientes.\""

# game/a1s1.rpy:542
translate spanish a1s1_86b13a5c:

    # m "\"Oh...is this happening to other humans?\""
    m "\"Ah...¿esto también les está pasando a otros humanos?\""

# game/a1s1.rpy:543
translate spanish a1s1_bcc81977_1:

    # a "\"Yes.\""
    a "\"Sí.\""

# game/a1s1.rpy:544
translate spanish a1s1_1ead6d40:

    # "I contemplate this for a moment."
    "Lo pienso un momento."

# game/a1s1.rpy:545
translate spanish a1s1_d543c2a0:

    # m "\"And...when you're done showing me you'll take me back?\""
    m "\"Y...cuando acabes de enseñármelo, ¿me llevarás de vuelta?\""

# game/a1s1.rpy:546
translate spanish a1s1_ae8abdc8:

    # "There's a momentary pause that I don't like very much."
    "Hay una breve pausa que no me gusta nada."

# game/a1s1.rpy:547
translate spanish a1s1_4eb44ffd:

    # a "\"...Yes.\""
    a "\"...Sí.\""

# game/a1s1.rpy:548
translate spanish a1s1_b50e6068:

    # "I imagine that I'd hear \"these statements appear to be misleading\" from Com right now, if he were on my side."
    "Imagino que ahora oiría a Com decir \"estas afirmaciones parecen engañosas\" si estuviera de mi parte."

# game/a1s1.rpy:549
translate spanish a1s1_c759c599:

    # "I look into my cup of brown sludge again."
    "Vuelvo a mirar mi taza de fango marrón."

# game/a1s1.rpy:550
translate spanish a1s1_2d777753:

    # m "\"Well, to be honest I'm not all that interested. So could you just take me back...now?\""
    m "\"Bueno, sinceramente, no me interesa demasiado. Así que ¿podrías llevarme de vuelta...ahora?\""

# game/a1s1.rpy:552
translate spanish a1s1_594096e1:

    # "Amicus stares at me."
    "Amicus se queda mirándome."

# game/a1s1.rpy:553
translate spanish a1s1_b5dc73e5:

    # m "\"I've got school and...and a family...they don't know where I am right now.\""
    m "\"Tengo clases y...y una familia...ahora no saben dónde estoy.\""

# game/a1s1.rpy:555
translate spanish a1s1_47f76efe:

    # a "\"Wh—uh—I, I mean, don't you want to see the galaxy? I really think that it would be amazing for someone like you that hasn't seen it before.\""
    a "\"Qu—eh—yo, quiero decir, ¿no quieres ver la galaxia? De verdad creo que sería increíble para alguien como tú, que nunca la ha visto.\""

# game/a1s1.rpy:556
translate spanish a1s1_a10d5c8a:

    # "The wolf starts fidgeting with his paws, not looking at me, choosing to stare out the windows."
    "El lobo empieza a juguetear nerviosamente con las patas; no me mira y prefiere observar por las ventanas."

# game/a1s1.rpy:557
translate spanish a1s1_4bae6b94:

    # "He isn't wrong."
    "No se equivoca."

# game/a1s1.rpy:558
translate spanish a1s1_b60f3d48:

    # "It would be pretty cool to see the galaxy, but not with someone like him who kidnapped me, taking me somewhere for a reason that he isn't telling me."
    "Sería muy guay ver la galaxia, pero no con alguien que me ha secuestrado y me lleva a algún sitio por una razón que no quiere contarme."

# game/a1s1.rpy:559
translate spanish a1s1_bb1aa492:

    # m "\"No, no I actually want to go home right now.\""
    m "\"No, no; de verdad quiero volver a casa ahora mismo.\""

# game/a1s1.rpy:560
translate spanish a1s1_762e3985:

    # "Amicus stares at me for a full ten seconds before looking away."
    "Amicus me mira durante diez segundos enteros antes de apartar la vista."

# game/a1s1.rpy:562
translate spanish a1s1_0d413744:

    # a "\"How about we wait until we get to my home then we can discuss it?\""
    a "\"¿Y si esperamos a llegar a mi casa y entonces lo hablamos?\""

# game/a1s1.rpy:563
translate spanish a1s1_7daae42b:

    # m "\"No. Take me back.\""
    m "\"No. Llévame de vuelta.\""

# game/a1s1.rpy:564
translate spanish a1s1_42720994:

    # "I feel my heart hammering in my chest as I start to realize that this alien is definitely not going to take me back."
    "El corazón me martillea en el pecho mientras empiezo a darme cuenta de que este alienígena no va a llevarme de vuelta."

# game/a1s1.rpy:566
translate spanish a1s1_b3660930:

    # "I stand up and Amicus flinches and brings his paws up to his chest, as if I'm going to attack him."
    "Me levanto y Amicus da un respingo y se lleva las patas al pecho, como si yo fuera a atacarlo."

# game/a1s1.rpy:568
translate spanish a1s1_f8f0cd8e:

    # "We stay like that for a moment."
    "Nos quedamos así un momento."

# game/a1s1.rpy:569
translate spanish a1s1_5f8a45ea:

    # "I'm breathing hard, staring down at the wolf while Amicus stares back up at me, wide-eyed."
    "Respiro con fuerza y miro al lobo desde arriba, mientras Amicus me mira desde abajo con los ojos muy abiertos."

# game/a1s1.rpy:570
translate spanish a1s1_c09f5fab:

    # "Finally, Amicus lets out a big sigh, looking back out the window."
    "Por fin, Amicus suelta un gran suspiro y vuelve a mirar por la ventana."

# game/a1s1.rpy:572
translate spanish a1s1_a8c26014:

    # a "\"Okay, I'm going to take you back. I'm sorry.\""
    a "\"Vale, voy a llevarte de vuelta. Lo siento.\""

# game/a1s1.rpy:573
translate spanish a1s1_7a4687bc:

    # "I watch him for a moment, looking for signs of sincerity, but he still won't look at me."
    "Lo observo un momento buscando señales de sinceridad, pero sigue sin querer mirarme."

# game/a1s1.rpy:574
translate spanish a1s1_0b4eb0fa:

    # m "\"Really?\""
    m "\"¿De verdad?\""

# game/a1s1.rpy:575
translate spanish a1s1_1f433de6:

    # a "\"Yes...but it's complicated. We're, uh, on a trajectory for Adastra. It'll take time for us to turn around.\""
    a "\"Sí...pero es complicado. Eh, vamos en una trayectoria hacia Adastra. Tardaremos un poco en dar la vuelta.\""

# game/a1s1.rpy:576
translate spanish a1s1_faeab43b:

    # "I keep watching him, not sure what to do."
    "Sigo observándolo, sin saber qué hacer."

# game/a1s1.rpy:577
translate spanish a1s1_23bbffc2:

    # "I feel like he's lying, but if he is there's really nothing I can do about it."
    "Siento que me está mintiendo, pero, si es así, no hay nada que pueda hacer."

# game/a1s1.rpy:578
translate spanish a1s1_40d8d1c1:

    # "I'm stuck here with him, probably millions of miles from Earth, with no way of knowing how to get back."
    "Estoy atrapado aquí con él, probablemente a millones de millas de la Tierra, sin forma de saber cómo volver."

# game/a1s1.rpy:579
translate spanish a1s1_7da27250:

    # "So I just stand there, arms folded tightly against my chest, staring out the window, too."
    "Así que me quedo de pie, con los brazos cruzados y apretados contra el pecho, mirando también por la ventana."

# game/a1s1.rpy:580
translate spanish a1s1_f617df9b:

    # "That's when I see a star brighter than all of the others, almost too bright to look at."
    "Entonces veo una estrella más brillante que todas las demás, casi demasiado brillante para mirarla."

# game/a1s1.rpy:581
translate spanish a1s1_f23bde36:

    # m "\"Is that the sun?\""
    m "\"¿Eso es el sol?\""

# game/a1s1.rpy:582
translate spanish a1s1_66a01596:

    # a "\"The what?\""
    a "\"¿El qué?\""

# game/a1s1.rpy:583
translate spanish a1s1_8418c46f:

    # m "\"Is that my star? My planet's star.\""
    m "\"¿Es mi estrella? La estrella de mi planeta.\""

# game/a1s1.rpy:584
translate spanish a1s1_8b5fc7d5:

    # "Amicus squints in the direction I'm looking in."
    "Amicus entrecierra los ojos mirando en la misma dirección que yo."

# game/a1s1.rpy:586
translate spanish a1s1_a2889e7f:

    # a "\"Oh...Oh, yeah! Yeah, that's your star...I can't remember the name we have for it. It's a bunch of numbers.\""
    a "\"Ah...¡Ah, sí! Sí, es vuestra estrella...No recuerdo el nombre que le damos. Son unos cuantos números.\""

# game/a1s1.rpy:587
translate spanish a1s1_6358c0bf:

    # m "\"How far away are we?\""
    m "\"¿A qué distancia estamos?\""

# game/a1s1.rpy:589
translate spanish a1s1_e5c37924:

    # a "\"Not far. We could get back there in no time.\""
    a "\"No estamos lejos. Podríamos volver en un momento.\""

# game/a1s1.rpy:590
translate spanish a1s1_2f21f96b:

    # "Amicus stands up next to me, seeming to stretch."
    "Amicus se pone de pie a mi lado, como si se estirara."

# game/a1s1.rpy:592
translate spanish a1s1_dd30b674:

    # m "\"So...are we going back?\""
    m "\"Entonces...¿volvemos?\""

# game/a1s1.rpy:593
translate spanish a1s1_7bbd1710:

    # a "\"Yeah, yeah, just gotta do it in a way that doesn't waste too much energy. I still have to get back to Adastra after all.\""
    a "\"Sí, sí; solo tengo que hacerlo sin gastar demasiada energía. Al fin y al cabo, aún tengo que volver a Adastra.\""

# game/a1s1.rpy:594
translate spanish a1s1_b37ab19d:

    # "I stare in the direction of the Sun again, my gaze slightly averted from the piercing dot."
    "Vuelvo a mirar hacia el Sol, apartando ligeramente los ojos del punto de luz que me hiere la vista."

# game/a1s1.rpy:595
translate spanish a1s1_2b87c86d:

    # "How long has it been since I was kidnapped?"
    "¿Cuánto tiempo ha pasado desde que me secuestró?"

# game/a1s1.rpy:596
translate spanish a1s1_11b65f7b:

    # "I wonder if my friends have alerted the school, or even the authorities."
    "Me pregunto si mis amigos habrán avisado a la universidad o incluso a las autoridades."

# game/a1s1.rpy:597
translate spanish a1s1_92830ed6:

    # "How am I going to explain this?"
    "¿Cómo voy a explicar esto?"

# game/a1s1.rpy:598
translate spanish a1s1_7a0cd758:

    # "There's a movement to my right and just as I'm turning to look, something cold presses into the side of my neck."
    "Hay un movimiento a mi derecha y, justo cuando me giro para mirar, algo frío me presiona el costado del cuello."

# game/a1s1.rpy:599
translate spanish a1s1_647ea463:

    # "A familiar sensation of my muscles tightening up makes me slam back into the seat."
    "La familiar sensación de que se me tensan los músculos me hace caer de golpe hacia atrás en el asiento."

# game/a1s1.rpy:600
translate spanish a1s1_2ea99556:

    # "At the same time my mind seems to wipe clean...empty."
    "A la vez, parece que se me borra todo de la mente...vacía."

# game/a1s1.rpy:601
translate spanish a1s1_d377dc01:

    # "Suddenly I'm surrounded by soft and warm gray fur."
    "De repente estoy rodeado de un pelaje gris, suave y cálido."

# game/a1s1.rpy:602
translate spanish a1s1_b3271f6c:

    # "I feel like a limp blanket as I'm flopped around, my muscles like jelly."
    "Me siento como una manta flácida mientras me mueven de un lado a otro; tengo los músculos como gelatina."

# game/a1s1.rpy:603
translate spanish a1s1_edc4567c:

    # "It's not a bad feeling, in fact I kinda feel great."
    "No es una mala sensación; de hecho, me siento bastante bien."

# game/a1s1.rpy:604
translate spanish a1s1_7e971bed:

    # "I would smile if my facial muscles were working."
    "Sonreiría si me funcionaran los músculos de la cara."

# game/a1s1.rpy:605
translate spanish a1s1_29b03dcb:

    # "I'm laid on the ground and then my arms are pushed behind me."
    "Me dejan en el suelo y luego me colocan los brazos detrás de la espalda."

# game/a1s1.rpy:606
translate spanish a1s1_b0c2122b:

    # "Something starts to wind around my wrists."
    "Algo empieza a enrollarse alrededor de mis muñecas."

# game/a1s1.rpy:607
translate spanish a1s1_d4ebc398:

    # com "\"Still detecting consciousness from the human. Insufficient charge used.\""
    com "\"El humano sigue mostrando consciencia. Se ha utilizado una carga insuficiente.\""

# game/a1s1.rpy:608
translate spanish a1s1_3b3358d1:

    # a "\"I used it on the lowest setting. I think I hit him with too much last time. Looks like he's mostly out anyway, though.\""
    a "\"Lo he usado en el nivel mínimo. Creo que la otra vez me pasé. Aunque parece que ya está casi inconsciente.\""

# game/a1s1.rpy:609
translate spanish a1s1_9ede3f11:

    # "I hear ragged breathing in my ear as my arms are jerked around."
    "Oigo una respiración agitada junto a mi oído mientras me mueven los brazos a tirones."

# game/a1s1.rpy:610
translate spanish a1s1_c0c447f0:

    # a "\"Dammit! He's more sapient than any child I've known!\""
    a "\"¡Maldita sea! ¡Es más sapiente que cualquiera de los Hijos que he conocido!\""

# game/a1s1.rpy:611
translate spanish a1s1_b5be8675:

    # com "\"Sensing distress. Would you like a stress tablet Amicus?\""
    com "\"Detectando angustia. ¿Quieres una pastilla para el estrés, Amicus?\""

# game/a1s1.rpy:612
translate spanish a1s1_b83d63f0:

    # a "\"Maybe even as intelligent as a Wolf...Well, almost. If they've been to space then they're far past level five.\""
    a "\"Quizá incluso tan inteligente como un Lobo...Bueno, casi. Si han estado en el espacio, han superado de largo el nivel cinco.\""

# game/a1s1.rpy:613
translate spanish a1s1_eb0264fc:

    # "I try to open my eyes but the eyelids are too heavy to lift."
    "Intento abrir los ojos, pero los párpados pesan demasiado para levantarlos."

# game/a1s1.rpy:614
translate spanish a1s1_979b3334:

    # a "\"Maybe level ten?\""
    a "\"¿Quizá de nivel diez?\""

# game/a1s1.rpy:615
translate spanish a1s1_83d8c327:

    # "My brain isn't really working either."
    "Tampoco me funciona bien el cerebro."

# game/a1s1.rpy:616
translate spanish a1s1_56b2818a:

    # "I can't seem to focus."
    "No consigo concentrarme."

# game/a1s1.rpy:617
translate spanish a1s1_28de12eb:

    # "Padded footsteps move around my head."
    "Oigo pasos amortiguados alrededor de mi cabeza."

# game/a1s1.rpy:620
translate spanish a1s1_2f8c7d04:

    # "Then I hear what sounds like an alarm, followed by something I can't really explain..."
    "Luego oigo lo que parece una alarma, seguida de algo que no puedo explicar..."

# game/a1s1.rpy:621
translate spanish a1s1_bff90061:

    # "My mind startles as that deep voice starts up again."
    "Mi mente se sobresalta cuando vuelve a sonar aquella voz grave."

# game/a1s1.rpy:622
translate spanish a1s1_9d5bb6ba:

    # a "\"What do I do now? I've messed this up about as badly as I could have.\""
    a "\"¿Qué hago ahora? He estropeado esto todo lo que podía estropearlo.\""

# game/a1s1.rpy:623
translate spanish a1s1_a20cefa7_8:

    # "..."
    "..."

# game/a1s1.rpy:624
translate spanish a1s1_f066ccfb:

    # a "\"Solutions, Com?\""
    a "\"¿Soluciones, Com?\""

# game/a1s1.rpy:625
translate spanish a1s1_65b6956e:

    # com "\"Solutions: Consider returning the human back to Earth. If no evidence is left behind it is unlikely his statements would be believed.\""
    com "\"Soluciones: considera devolver al humano a la Tierra. Si no se deja ninguna prueba, es poco probable que se crean sus declaraciones.\""

# game/a1s1.rpy:626
translate spanish a1s1_b0ab74af:

    # a "\"...Uh, too late for that since I just activated the Stretch Drive.\""
    a "\"...Eh, ya es demasiado tarde: acabo de activar la Propulsión Dilatatoria.\""

# game/a1s1.rpy:627
translate spanish a1s1_e96ce7c7:

    # com "\"Yes, that was inadvisable.\""
    com "\"Sí, eso no era aconsejable.\""

# game/a1s1.rpy:628
translate spanish a1s1_f0807289:

    # a "\"Yeah, well, I don't know how advanced his species is. If he was being misleading then that means they're space-faring. They could have patrols in their star system.\""
    a "\"Sí, bueno, no sé cuánto ha avanzado su especie. Si estaba mintiendo, eso significa que viajan por el espacio. Podrían tener patrullas en su sistema estelar.\""

# game/a1s1.rpy:629
translate spanish a1s1_6e20bf3e:

    # a "\"I wanted to get out as soon as possible...You know you could have offered the solution before I did that.\""
    a "\"Quería salir de ahí lo antes posible...Sabes que podrías haberme ofrecido esa solución antes de que lo hiciera.\""

# game/a1s1.rpy:630
translate spanish a1s1_9d17ba6e:

    # com "\"You've set me to minimal interruptions.\""
    com "\"Me has configurado para interrumpir lo mínimo posible.\""

# game/a1s1.rpy:631
translate spanish a1s1_4b9d9830:

    # a "\"Next solution.\""
    a "\"Siguiente solución.\""

# game/a1s1.rpy:632
translate spanish a1s1_770172aa:

    # com "\"Consider termination of the human and incineration of the remains through the radiation of the Stretch Drive—\""
    com "\"Considera eliminar al humano e incinerar sus restos mediante la radiación de la Propulsión Dilatatoria—\""

# game/a1s1.rpy:633
translate spanish a1s1_a7afb2bf:

    # a "\"{i}Edapol! {/i}No! Next solution.\""
    a "\"¡{i}Edapol! {/i}No! Siguiente solución.\""

# game/a1s1.rpy:634
translate spanish a1s1_69dd9dd2:

    # com "\"Consider taking the human to Adastra and use him as your pet as you originally planned.\""
    com "\"Considera llevar al humano a Adastra y utilizarlo como tu mascota, tal como habías planeado al principio.\""

# game/a1s1.rpy:635
translate spanish a1s1_1db081d4:

    # com "\"From there you may pass him off as less sapient. It is unlikely you will be questioned.\""
    com "\"Allí puedes hacerlo pasar por menos sapiente. Es poco probable que te cuestionen.\""

# game/a1s1.rpy:636
translate spanish a1s1_a20cefa7_9:

    # "..."
    "..."

# game/a1s1.rpy:637
translate spanish a1s1_6359f6b8:

    # a "\"I don't know. He already despises me and after what I just did...\""
    a "\"No lo sé. Ya me desprecia, y después de lo que acabo de hacer...\""

# game/a1s1.rpy:638
translate spanish a1s1_84de36c4:

    # com "\"Amicus, alternative solutions point to a higher likelihood that the Monitors will be alerted to your actions.\""
    com "\"Amicus, las soluciones alternativas aumentan la probabilidad de que los Monitores sean alertados sobre tus acciones.\""

# game/a1s1.rpy:639
translate spanish a1s1_a20cefa7_10:

    # "..."
    "..."

# game/a1s1.rpy:640
translate spanish a1s1_b378af8d:

    # com "\"Proceed with caution.\""
    com "\"Procede con cautela.\""

# game/a1s1.rpy:641
translate spanish a1s1_5fe437de:

    # a "\"Com, please wipe the last ten minutes of conversation...then go into sleep mode until I wake you. I need to think.\""
    a "\"Com, borra los últimos diez minutos de conversación, por favor...y después entra en modo de reposo hasta que te despierte. Necesito pensar.\""

# game/a1s1.rpy:642
translate spanish a1s1_beb8c686:

    # com "\"Wiping memory. Entering sleep mode.\""
    com "\"Borrando la memoria. Entrando en modo de reposo.\""

# game/a1s1.rpy:643
translate spanish a1s1_9683989d:

    # "A few more moments of silence go by and I feel a wave of fatigue."
    "Pasan unos instantes más de silencio y siento una oleada de cansancio."

# game/a1s1.rpy:644
translate spanish a1s1_519e54d3:

    # "I start to fall asleep."
    "Empiezo a quedarme dormido."

# game/a1s1.rpy:645
translate spanish a1s1_9caf9af4:

    # "The padded footsteps move closer to me and I feel a presence looming."
    "Los pasos amortiguados se acercan y noto una presencia que se cierne sobre mí."

# game/a1s1.rpy:646
translate spanish a1s1_5684fecb:

    # "Then something heavy and soft rests on my forearm."
    "Entonces algo pesado y blando se posa sobre mi antebrazo."

# game/a1s1.rpy:647
translate spanish a1s1_8a44d64c:

    # a "\"I'm sorry...This was a mistake.\""
    a "\"Lo siento...Esto ha sido un error.\""

# game/a1s1.rpy:648
translate spanish a1s1_87b70147:

    # "Then I'm dragged for a short while before I come to rest on something shaggy and soft."
    "Luego me arrastran un poco hasta que quedo sobre algo blando y de pelo largo."

# game/a1s1.rpy:649
translate spanish a1s1_e765c4d6:

    # "Then silence...."
    "Luego, silencio...."

# game/a1s1.rpy:650
translate spanish a1s1_be52cd10:

    # "Then sleep..."
    "Luego, sueño..."

# game/a1s1.rpy:655
translate spanish a1s1_af4532e8:

    # "I float in a void of nothingness."
    "Floto en un vacío de nada."

# game/a1s1.rpy:656
translate spanish a1s1_22cb48e2:

    # "Not even blackness...nothingness."
    "Ni siquiera oscuridad...nada."

# game/a1s1.rpy:657
translate spanish a1s1_e84417a1:

    # "The feeling of having no sense of self, the boundaries of my being having no boundaries..."
    "La sensación de no tener noción de mí mismo, de que los límites de mi ser no tienen límites..."

# game/a1s1.rpy:658
translate spanish a1s1_60c108bb:

    # "It makes me panic."
    "Eso me hace entrar en pánico."

# game/a1s1.rpy:659
translate spanish a1s1_a97e4f67:

    # "I'm still here, but nothing else exists."
    "Sigo aquí, pero no existe nada más."

# game/a1s1.rpy:660
translate spanish a1s1_36dfb867:

    # "Am I all there is?"
    "¿Soy todo lo que existe?"

# game/a1s1.rpy:661
translate spanish a1s1_0242aa20:

    # "I feel the borders of my sanity start to bend and break."
    "Siento que los límites de mi cordura empiezan a doblarse y romperse."

# game/a1s1.rpy:662
translate spanish a1s1_80384914:

    # "It only lasts a moment before something massive and all-encompassing grabs hold of me."
    "Solo dura un momento antes de que algo enorme, que lo abarca todo, se apodere de mí."

# game/a1s1.rpy:663
translate spanish a1s1_d3cfade7:

    # "Instantly I'm comforted, calmed by a sense of complete security."
    "Al instante me siento reconfortado, calmado por una sensación de seguridad absoluta."

# game/a1s1.rpy:664
translate spanish a1s1_3a72158c:

    # "\"All is as it should be...\""
    "\"Todo es como debe ser...\""

# game/a1s1.rpy:669
translate spanish a1s1_3b6ab3ad:

    # "I crack my eyes open to a gray ceiling, the familiar hum of the ship in my ears."
    "Entreabro los ojos y veo un techo gris, con el familiar zumbido de la nave en los oídos."

# game/a1s1.rpy:670
translate spanish a1s1_adc8153d:

    # "My back aches as I feel my hands bunched up underneath me, making me arch uncomfortably."
    "Me duele la espalda: tengo las manos amontonadas debajo y me obligan a arquearme de forma incómoda."

# game/a1s1.rpy:671
translate spanish a1s1_d65aa1ab:

    # "The numbness isn't there like last time."
    "No tengo el entumecimiento de la otra vez."

# game/a1s1.rpy:672
translate spanish a1s1_e3cf1733:

    # "Instead it just feels like I woke up from a deep sleep."
    "Más bien parece que acabo de despertar de un sueño profundo."

# game/a1s1.rpy:673
translate spanish a1s1_f9acd018:

    # "I can tell I'm back in the utility closet laying on the shag rug, but the door is open, allowing me to actually see."
    "Veo que vuelvo a estar en el armario de servicio, tumbado en la alfombra de pelo largo, pero la puerta está abierta y me permite ver."

# game/a1s1.rpy:674
translate spanish a1s1_04820179:

    # "Slowly, I turn my head just a bit and I'm able to vaguely make out the small deck that I'd just been in."
    "Giro la cabeza un poco, despacio, y consigo distinguir vagamente la pequeña cubierta en la que estaba hace un momento."

# game/a1s1.rpy:675
translate spanish a1s1_082f61b0:

    # "I see Amicus to the far right, both his paws resting on the counter with the food dispenser, looking down at a panel."
    "Veo a Amicus al fondo a la derecha, apoyando ambas patas en la encimera del dispensador de comida y mirando un panel."

# game/a1s1.rpy:676
translate spanish a1s1_ca0a79ee:

    # "He's got his back to me at an angle, one foot crossed behind the other, his tail swishing back and forth while he mumbles to himself."
    "Me da la espalda de lado, con un pie cruzado detrás del otro, moviendo la cola de un lado a otro mientras murmura para sí."

# game/a1s1.rpy:677
translate spanish a1s1_92dd477f:

    # "As slowly as I can, I turn over onto my side, trying not to let out a groan of relief as my back and hands are relieved of pressure."
    "Me giro de lado tan despacio como puedo, procurando no soltar un gemido de alivio al dejar de soportar presión en la espalda y las manos."

# game/a1s1.rpy:678
translate spanish a1s1_3cfc9d0c:

    # "I grimace through the pain of having blood rush back into my fingers."
    "Hago una mueca de dolor al volver la sangre a los dedos."

# game/a1s1.rpy:679
translate spanish a1s1_b2fce196:

    # "That's when I realize that my hands are tied at the wrists behind my back with a cord of some kind."
    "Entonces me doy cuenta de que tengo las manos atadas por las muñecas detrás de la espalda con una especie de cable."

# game/a1s1.rpy:680
translate spanish a1s1_c41ac249:

    # "The ends of it dangle through my fingers and it feels smooth and metallic."
    "Los extremos me cuelgan entre los dedos y noto que es liso y metálico."

# game/a1s1.rpy:681
translate spanish a1s1_35e07eeb:

    # "Some slow movements with my hands tells me immediately that they haven't been tied well."
    "Unos pocos movimientos lentos de las manos me indican enseguida que no están bien atadas."

# game/a1s1.rpy:682
translate spanish a1s1_3fe34707:

    # "My left hand is fairly secure, but the loop around my right is loose."
    "La mano izquierda está bastante bien sujeta, pero el lazo de la derecha está flojo."

# game/a1s1.rpy:683
translate spanish a1s1_f12e3d58:

    # "I get the feeling that if I pull hard enough, I might be able to slip it—"
    "Tengo la impresión de que, si tiro lo bastante fuerte, quizá pueda sacarla—"

# game/a1s1.rpy:684
translate spanish a1s1_ffb8948f:

    # "And just like that it comes out."
    "Y así de fácil sale."

# game/a1s1.rpy:685
translate spanish a1s1_95e75613:

    # "My shoulder jerks when I do it and I freeze, waiting to see if Amicus might notice."
    "El hombro se me sacude al hacerlo y me quedo inmóvil, esperando a ver si Amicus se da cuenta."

# game/a1s1.rpy:686
translate spanish a1s1_d2661139:

    # "He goes on staring down at the panel, leaning forward to rest his chin on a fist."
    "Sigue mirando el panel, inclinándose hacia delante para apoyar la barbilla en un puño."

# game/a1s1.rpy:687
translate spanish a1s1_07d78f36:

    # a "\"Cassius is probably going to figure it out right away. I know it.\""
    a "\"Cassius seguramente se dará cuenta enseguida. Lo sé.\""

# game/a1s1.rpy:688
translate spanish a1s1_2306b59a:

    # "Amicus sighs and hunches over further."
    "Amicus suspira y se encorva aún más."

# game/a1s1.rpy:689
translate spanish a1s1_9590e57c:

    # "I let out the breath I'm holding as quietly as I can before I start looking around, moving my head as little as possible."
    "Suelto el aire que estaba conteniendo tan silenciosamente como puedo antes de empezar a mirar alrededor, moviendo la cabeza lo mínimo."

# game/a1s1.rpy:690
translate spanish a1s1_9ebb5349:

    # "On the shelves are a variety of different objects that I can't identify."
    "En las estanterías hay diversos objetos que no consigo identificar."

# game/a1s1.rpy:691
translate spanish a1s1_d6144df5:

    # "They all have a heavy, industrial look to them and I know that I could use any of them as a weapon."
    "Todos tienen un aspecto pesado e industrial y sé que podría usar cualquiera como arma."

# game/a1s1.rpy:692
translate spanish a1s1_96f64e4f:

    # "There's a long, pipe-like object at the end of the bottom shelf and I imagine hefting that in both hands, bringing the end of it down on the top of that stupid wolf's—"
    "En un extremo del estante inferior hay un objeto largo, parecido a una tubería, e imagino alzarlo con ambas manos y descargar su extremo sobre lo alto de la cabeza de ese estúpido lobo—"

# game/a1s1.rpy:693
translate spanish a1s1_e03e911f:

    # "Amicus suddenly straightens up and I stiffen, closing my eyes."
    "Amicus se endereza de repente y yo me tenso y cierro los ojos."

# game/a1s1.rpy:695
translate spanish a1s1_afa08184:

    # "I hear the wolf move, padding in my direction."
    "Oigo moverse al lobo y acercarse con pasos amortiguados."

# game/a1s1.rpy:696
translate spanish a1s1_9c2c94b7:

    # "That continues until there's a pause and I can feel his presence standing in the doorway."
    "Se acerca hasta que se detiene, y puedo sentir su presencia de pie en la entrada."

# game/a1s1.rpy:697
translate spanish a1s1_dad04d86:

    # "I crack open an eye, just a tiny bit to see what he might be doing."
    "Entreabro un ojo, solo un poquito, para ver qué está haciendo."

# game/a1s1.rpy:698
translate spanish a1s1_fd0775d1:

    # "I get a vague image of him standing over me, looking down."
    "Distingo vagamente su figura de pie sobre mí, mirándome desde arriba."

# game/a1s1.rpy:699
translate spanish a1s1_fa90945b:

    # a "\"Hello? Uh, human? [mc]?\""
    a "\"¿Hola? Eh, ¿humano? ¿[mc]?\""

# game/a1s1.rpy:700
translate spanish a1s1_f4b1201a:

    # "I don't move and I breathe as evenly as I can."
    "No me muevo y respiro tan regularmente como puedo."

# game/a1s1.rpy:701
translate spanish a1s1_ea4eb6bf:

    # a "\"Hello?\""
    a "\"¿Hola?\""

# game/a1s1.rpy:702
translate spanish a1s1_5ca5b8e6:

    # "He must know I'm awake; I can feel myself shaking from all the tension."
    "Debe de saber que estoy despierto; siento que tiemblo por toda esta tensión."

# game/a1s1.rpy:703
translate spanish a1s1_b862337b:

    # a "\"Dammit...\""
    a "\"Maldita sea...\""

# game/a1s1.rpy:704
translate spanish a1s1_04afa751:

    # "Amicus mumbles to himself as he turns away, moving back towards the deck."
    "Amicus murmura para sí al darse la vuelta y regresar hacia la cubierta."

# game/a1s1.rpy:706
translate spanish a1s1_c26fdbfc:

    # "That's when I realize that this might be my best chance to make my move."
    "Entonces me doy cuenta de que esta quizá sea mi mejor oportunidad para actuar."

# game/a1s1.rpy:707
translate spanish a1s1_d75d5f2c:

    # "He's not going to take me back."
    "No va a llevarme de vuelta."

# game/a1s1.rpy:708
translate spanish a1s1_4dffe11b:

    # "He's knocked me out twice and that's reason enough to do what I'm about to do."
    "Me ha dejado inconsciente dos veces, y eso es razón suficiente para hacer lo que voy a hacer."

# game/a1s1.rpy:709
translate spanish a1s1_4c26b911:

    # "As quietly as I can, I roll over and reach out for the metal pipe."
    "Tan silenciosamente como puedo, me doy la vuelta y alargo la mano hacia la tubería metálica."

# game/a1s1.rpy:710
translate spanish a1s1_e1ba0061:

    # "By some miracle I manage not to clang it against the metal rack it's on."
    "De algún modo milagroso consigo no golpearla contra el soporte metálico sobre el que está."

# game/a1s1.rpy:711
translate spanish a1s1_79ce504e:

    # "Quietly, I bring it up in both hands as I stand."
    "En silencio, la levanto con ambas manos mientras me pongo de pie."

# game/a1s1.rpy:712
translate spanish a1s1_0ccb14a2:

    # "It's heavy, a lot heavier than I expected, but I can manage it."
    "Es pesada, mucho más de lo que esperaba, pero puedo manejarla."

# game/a1s1.rpy:713
translate spanish a1s1_df41eb16:

    # "I focus on the retreating wolf's back and move at a half-run, my bare feet allowing me to quietly pad toward him."
    "Me fijo en la espalda del lobo que se aleja y avanzo casi corriendo; los pies descalzos me permiten acercarme en silencio."

# game/a1s1.rpy:714
translate spanish a1s1_3eea3b93:

    # "Despite that, I see his ears come up at the last second, his body starting to shift in a way that tells me he's about to turn around."
    "A pesar de eso, veo que levanta las orejas en el último segundo y que su cuerpo empieza a moverse de una forma que me indica que va a girarse."

# game/a1s1.rpy:715
translate spanish a1s1_1fbcb7e8:

    # "And I swing."
    "Y golpeo."

# game/a1s1.rpy:716
translate spanish a1s1_07f83414:

    # "What happens next is something that I can't explain."
    "No puedo explicar lo que ocurre después."

# game/a1s1.rpy:717
translate spanish a1s1_e11232a2:

    # "I aim for his head, wanting to cause as much damage as possible, not really thinking about the consequences of what might happen if I seriously injure, or even kill him."
    "Apunto a la cabeza, queriendo hacerle el máximo daño posible, sin pensar realmente en las consecuencias de herirlo gravemente o incluso matarlo."

# game/a1s1.rpy:718
translate spanish a1s1_1e68a446:

    # "But for some inexplicable reason, the trajectory of my swing suddenly dips down, as if caused by some invisible magnet, making me miss Amicus's head."
    "Pero, por alguna razón inexplicable, la trayectoria de mi golpe se desvía de repente hacia abajo, como por un imán invisible, y no alcanzo la cabeza de Amicus."

# game/a1s1.rpy:719
translate spanish a1s1_1a3b3c7e:

    # "The strange force doesn't lessen the power of my swing though, and it carries through to land with a hard, meaty thump into the side of the wolf's thick neck."
    "Sin embargo, esa fuerza extraña no reduce la potencia del golpe, que acaba dando con un fuerte ruido sordo de carne en el costado del grueso cuello del lobo."

# game/a1s1.rpy:722
translate spanish a1s1_c55b5547:

    # a "\"AAAGH!\""
    a "\"¡AAAGH!\""

# game/a1s1.rpy:725
translate spanish a1s1_220f1ecb:

    # "Amicus cringes, both paws moving to cover the back and side of his neck, dropping into a crouch."
    "Amicus se encoge de dolor, llevándose ambas patas a la nuca y al costado del cuello mientras cae en cuclillas."

# game/a1s1.rpy:726
translate spanish a1s1_e12b7851:

    # "He looks back at me, his eyes wide and wild, an expression that sends a shot of fear into my body."
    "Me mira con los ojos abiertos y desorbitados, una expresión que me provoca una sacudida de miedo por todo el cuerpo."

# game/a1s1.rpy:727
translate spanish a1s1_41594fa7:

    # "I suddenly see him as a wild animal; a wild, scared, and very angry animal."
    "De repente lo veo como un animal salvaje: un animal salvaje, asustado y muy enfadado."

# game/a1s1.rpy:728
translate spanish a1s1_33f5552a:

    # "I raise the pipe again, over my head to bring down on the head I'd just missed."
    "Vuelvo a levantar la tubería por encima de mi cabeza para descargarla sobre la cabeza que acabo de fallar."

# game/a1s1.rpy:729
translate spanish a1s1_7acd7c83:

    # "But Amicus is fast."
    "Pero Amicus es rápido."

# game/a1s1.rpy:731
translate spanish a1s1_82b5acdc:

    # "He leaps up from the crouch, in an upward and forward motion straight into my chest."
    "Salta desde su posición en cuclillas, hacia arriba y hacia delante, directo contra mi pecho."

# game/a1s1.rpy:734
translate spanish a1s1_1477c2fa:

    # "I wheeze, but manage to stay on my feet as the wolf carries me backward to slam against the wall of the deck."
    "Me quedo sin aire, pero consigo mantenerme en pie mientras el lobo me empuja hacia atrás y me estampa contra la pared de la cubierta."

# game/a1s1.rpy:735
translate spanish a1s1_5a041a38:

    # "Amicus snarls into my face, teeth bared, one eye wincing shut."
    "Amicus me gruñe en la cara, enseñando los dientes, con un ojo cerrado por el dolor."

# game/a1s1.rpy:736
translate spanish a1s1_2a6c6991:

    # "I struggle but there's no way; he handles me like a rag doll, like a toy."
    "Forcejeo, pero es inútil: me maneja como a un muñeco de trapo, como a un juguete."

# game/a1s1.rpy:737
translate spanish a1s1_4c3fd121:

    # "This must be how someone feels during a wild animal attack, completely helpless, suddenly wondering why evolution left us so damn defenseless."
    "Así debe de sentirse alguien durante el ataque de un animal salvaje: completamente indefenso, preguntándose de pronto por qué la evolución nos ha dejado tan jodidamente desprotegidos."

# game/a1s1.rpy:738
translate spanish a1s1_d9341b94:

    # a "\"What the HELL are you doing!? AGH!\""
    a "\"¡¿Qué DEMONIOS estás haciendo?! ¡AGH!\""

# game/a1s1.rpy:739
translate spanish a1s1_9fa68862:

    # "Amicus yells at me as he lets go of one of my wrists to put a paw to his neck, cringing as he does."
    "Amicus me grita y suelta una de mis muñecas para llevarse una pata al cuello, encogiéndose de dolor."

# game/a1s1.rpy:740
translate spanish a1s1_58892681:

    # a "\"Dammit!\""
    a "\"¡Mierda!\""

# game/a1s1.rpy:741
translate spanish a1s1_fe75f468:

    # "I struggle with my freed hand, grabbing Amicus's face and trying to gouge his eyes and nose."
    "Forcejeo con la mano libre, agarrándole la cara a Amicus e intentando clavarle los dedos en los ojos y la nariz."

# game/a1s1.rpy:742
translate spanish a1s1_775d77b6:

    # "The wolf immediately lets go of his neck and grabs the pipe."
    "El lobo se suelta inmediatamente el cuello y agarra la tubería."

# game/a1s1.rpy:743
translate spanish a1s1_fb846981:

    # "He wrenches it away, but I try to hold on and almost get lifted off my feet."
    "Tira de ella con fuerza, pero intento sujetarla y casi me levanta del suelo."

# game/a1s1.rpy:744
translate spanish a1s1_51b243f1:

    # "He swings it one way, then violently in the other direction, throwing me to the floor of the deck as I lose my grip on my weapon."
    "La mueve hacia un lado y después violentamente hacia el otro, tirándome al suelo de la cubierta cuando pierdo el agarre de mi arma."

# game/a1s1.rpy:745
translate spanish a1s1_f4107cda:

    # "Amicus advances on me as I lay flat on my back, staring up at him wide-eyed, realizing how big of a mistake I've made thinking I could handle a seven foot tall, muscle-bound wolf."
    "Amicus avanza hacia mí mientras estoy tumbado de espaldas, mirándolo con los ojos abiertos, y me doy cuenta del enorme error de creer que podía dominar a un lobo de siete pies de altura, todo músculo."

# game/a1s1.rpy:746
translate spanish a1s1_fff456f7:

    # "I wonder if he's going to come at me with the pipe, but he throws it to the side."
    "Me pregunto si va a atacarme con la tubería, pero la tira a un lado."

# game/a1s1.rpy:748
translate spanish a1s1_cce65878:

    # "He starts to lean over me, still snarling."
    "Empieza a inclinarse sobre mí, todavía gruñendo."

# game/a1s1.rpy:749
translate spanish a1s1_99b67aba:

    # a "\"You little prick! This time I'll bind you up to your shoulders, how does that sound?\""
    a "\"¡Serás cabroncete! Esta vez te ataré hasta los hombros, ¿qué te parece?\""

# game/a1s1.rpy:750
translate spanish a1s1_2743c03b:

    # "He grabs up one of my arms, trying to pull me up, but I go limp."
    "Me agarra un brazo para levantarme, pero dejo el cuerpo flácido."

# game/a1s1.rpy:751
translate spanish a1s1_af93e9d1:

    # a "\"Get UP! Otherwise I'll make you.\""
    a "\"¡LEVÁNTATE! Si no, te obligaré.\""

# game/a1s1.rpy:752
translate spanish a1s1_2f997317:

    # "He grabs my other arm."
    "Me agarra también el otro brazo."

# game/a1s1.rpy:753
translate spanish a1s1_697276fd:

    # "That's when I notice his wide stance over me and a particular bulge between his legs."
    "Entonces veo que está sobre mí con las piernas muy separadas y noto un bulto concreto entre ellas."

# game/a1s1.rpy:754
translate spanish a1s1_ff041fc3:

    # "I hardly think about it; drawing back one foot I launch it as hard as I can into his crotch."
    "Apenas lo pienso: echo un pie hacia atrás y lo lanzo con toda la fuerza que puedo contra su entrepierna."

# game/a1s1.rpy:757
translate spanish a1s1_aeb647aa:

    # "I feel a distinctly soft form get flattened under my foot as it gets trapped between the force of my kick and the substantial weight of Amicus's body."
    "Siento cómo una forma claramente blanda se aplasta bajo mi pie, atrapada entre la fuerza de mi patada y el considerable peso del cuerpo de Amicus."

# game/a1s1.rpy:758
translate spanish a1s1_571ab292:

    # "If there was any doubt in my mind that this male alien would be affected any differently compared to a male human, his reaction quashed it."
    "Si dudaba de que este alienígena macho pudiera reaccionar de forma distinta a un varón humano, su reacción despejó todas mis dudas."

# game/a1s1.rpy:759
translate spanish a1s1_4c281ae3:

    # "Amicus freezes, eyes wide, hunching over me even further while his thighs snap together, trapping my foot."
    "Amicus se queda inmóvil, con los ojos abiertos, inclinándose aún más sobre mí mientras junta los muslos de golpe y me atrapa el pie."

# game/a1s1.rpy:760
translate spanish a1s1_8dbecf4c:

    # "We both stay frozen for an awkward length of time as I stare at what I'd just done."
    "Nos quedamos inmóviles un tiempo incómodamente largo mientras contemplo lo que acabo de hacer."

# game/a1s1.rpy:761
translate spanish a1s1_c3b7dacc:

    # "And that's when I see that device hanging on his waistband, the one that he'd been using to knock me out."
    "Entonces veo el aparato que le cuelga de la cintura, el que ha estado usando para dejarme inconsciente."

# game/a1s1.rpy:763
translate spanish a1s1_5fba915e:

    # "I struggle to pull my foot free of the surprisingly tight embrace of his thighs while at the same time pulling my hands out of his now limp grasp."
    "Intento sacar el pie de la sorprendentemente fuerte presión de sus muslos mientras retiro las manos de su agarre, que ahora está flojo."

# game/a1s1.rpy:764
translate spanish a1s1_49e943ab:

    # "I reach for his waist, grabbing the device."
    "Alargo la mano hacia su cintura y agarro el aparato."

# game/a1s1.rpy:765
translate spanish a1s1_54fda360:

    # "Amicus, probably distracted by the unexpected nutshot, doesn't seem to notice and I finally yank my foot free."
    "Amicus, probablemente distraído por la inesperada patada en los huevos, no parece darse cuenta, y por fin consigo sacar el pie."

# game/a1s1.rpy:766
translate spanish a1s1_7fafa09b:

    # "As I stumble to my feet the alien half-heartedly grabs at me and I struggle against his paws before reaching for his red cape and pulling it over his head."
    "Mientras me pongo en pie a trompicones, el alienígena intenta agarrarme sin mucho empeño; forcejeo contra sus patas y después cojo su capa roja y se la echo sobre la cabeza."

# game/a1s1.rpy:767
translate spanish a1s1_dde9d034:

    # "Amicus finally stumbles back, one paw flying to his crotch, the other struggling with his cape as he stays bent over, mouth hanging open, making a weird gasping sound like he was holding his breath."
    "Amicus acaba retrocediendo a tumbos, llevándose una pata a la entrepierna mientras lucha con la capa con la otra; sigue encorvado, con la boca abierta, soltando un extraño jadeo como si hubiera estado conteniendo el aire."

# game/a1s1.rpy:768
translate spanish a1s1_1b1c7a26:

    # "I look at the device in my hands, desperately trying to understand how to use it."
    "Miro el aparato en mis manos, intentando desesperadamente entender cómo se usa."

# game/a1s1.rpy:769
translate spanish a1s1_d8d7ebee:

    # "A glass panel takes up most of the face of the device, like a phone, but two metal prongs stick out one end."
    "Un panel de cristal ocupa casi toda su superficie frontal, como en un teléfono, pero de un extremo sobresalen dos puntas metálicas."

# game/a1s1.rpy:770
translate spanish a1s1_7e8b5f55:

    # "I frantically push at the screen and it comes to life, displaying a vertical bar."
    "Pulso la pantalla frenéticamente y se enciende, mostrando una barra vertical."

# game/a1s1.rpy:771
translate spanish a1s1_cd09a14c:

    # "About a tenth of it is filled from the bottom with a light blue color."
    "Aproximadamente una décima parte está llena desde abajo de un azul claro."

# game/a1s1.rpy:772
translate spanish a1s1_39f052cf:

    # "I push at it with my thumb, waiting for something to happen, for electricity to start arcing between the prongs, or something."
    "La pulso con el pulgar, esperando que ocurra algo, que empiecen a saltar arcos eléctricos entre las puntas o algo parecido."

# game/a1s1.rpy:773
translate spanish a1s1_e92443cf:

    # "Instead the bar fills with the slide of my thumb."
    "En vez de eso, la barra se llena al deslizar el pulgar."

# game/a1s1.rpy:774
translate spanish a1s1_be8eec5a:

    # "I push it all the way up until the color turns a dark violet."
    "Lo deslizo hasta arriba del todo, hasta que el color se vuelve violeta oscuro."

# game/a1s1.rpy:776
translate spanish a1s1_46741042:

    # "I hear a snarl and see Amicus finally tear the cape off before he comes at me again, one paw still over his crotch, the other reaching out for me."
    "Oigo un gruñido y veo que Amicus por fin se quita la capa antes de volver a lanzarse hacia mí, con una pata todavía en la entrepierna y la otra extendida para agarrarme."

# game/a1s1.rpy:777
translate spanish a1s1_ed1dce34:

    # "I don't have time to think, I just duck under his approaching paw and press the prongs as hard as I can into his body."
    "No tengo tiempo para pensar: me agacho bajo la pata que se acerca y aprieto las puntas contra su cuerpo con toda la fuerza que puedo."

# game/a1s1.rpy:781
translate spanish a1s1_b14259cd:

    # "It sinks into his stomach and I hear the wolf make a {i}huff{/i} sound into my ear."
    "Se hunde en su vientre y oigo al lobo soltar un {i}uf{/i} junto a mi oído."

# game/a1s1.rpy:782
translate spanish a1s1_9108ee77:

    # "There's a pause as nothing seems to happen, then I press harder and squeeze the device and the result is instant."
    "Durante un momento no parece pasar nada; después aprieto más y comprimo el aparato, y el efecto es inmediato."

# game/a1s1.rpy:784
translate spanish a1s1_84491e6b:

    # "There's no sound, but Amicus's body seizes violently, shaking as if he's having a seizure."
    "No se oye ningún sonido, pero el cuerpo de Amicus se contrae violentamente y tiembla como si estuviera teniendo una convulsión."

# game/a1s1.rpy:785
translate spanish a1s1_e9ac8279:

    # "The muscles in his stomach tense hard and push the device back out a few inches."
    "Los músculos de su vientre se tensan con fuerza y empujan el aparato unas pulgadas hacia fuera."

# game/a1s1.rpy:786
translate spanish a1s1_4058744f:

    # "I hold it there, not wanting to let up in case it isn't enough, in case he'll just recover and come at me again."
    "Lo mantengo ahí, sin querer dejar de apretar por si no es suficiente y él se recupera y vuelve a atacarme."

# game/a1s1.rpy:787
translate spanish a1s1_399e17e7:

    # "After a few seconds the wolf's seizing and shuddering stops on its own."
    "Al cabo de unos segundos, las contracciones y temblores del lobo cesan por sí solos."

# game/a1s1.rpy:788
translate spanish a1s1_1bbe88f5:

    # "I start to pull back and get a glimpse of Amicus's face."
    "Empiezo a echarme hacia atrás y alcanzo a ver un instante la cara de Amicus."

# game/a1s1.rpy:789
translate spanish a1s1_020ecd18:

    # "His muzzle hangs open, foam and drool hanging from his chin, his eyes rolling back in his head."
    "Tiene el hocico abierto, con espuma y saliva colgándole de la barbilla y los ojos vueltos hacia atrás."

# game/a1s1.rpy:790
translate spanish a1s1_b9306b4e:

    # "It's a scary sight, so I try to back away and Amicus comes with me, the contact with the device having been the only thing keeping him balanced."
    "Es una imagen aterradora, así que intento apartarme, pero Amicus viene conmigo: el contacto con el aparato era lo único que lo mantenía en equilibrio."

# game/a1s1.rpy:793
translate spanish a1s1_0ac79c93:

    # "His weight takes me down and the next thing I know is that I'm flat on my back, struggling to breathe as Amicus's incredible weight crushes me into the metal deck."
    "Su peso me derriba y lo siguiente que sé es que estoy de espaldas, luchando por respirar mientras el increíble peso de Amicus me aplasta contra la cubierta metálica."

# game/a1s1.rpy:794
translate spanish a1s1_af2c94a3:

    # "He practically envelopes me with his soft, furry body, his big head resting on my chest."
    "Prácticamente me envuelve con su cuerpo suave y peludo, apoyando la enorme cabeza sobre mi pecho."

# game/a1s1.rpy:795
translate spanish a1s1_fa4bd332:

    # "I stare down at him, watching as his black lips and eyelids twitch, his tongue hanging out as he makes sporadic snorting sounds."
    "Lo miro desde arriba y veo cómo le tiemblan los labios negros y los párpados, con la lengua fuera, mientras emite resoplidos esporádicos."

# game/a1s1.rpy:796
translate spanish a1s1_20d70cce:

    # "I gasp and strain as I spend the next minute working myself out from under him, grimacing as his foamy drool smears on my chest."
    "Jadeo y hago fuerza durante el siguiente minuto para salir de debajo de él, haciendo una mueca cuando la saliva espumosa se me extiende por el pecho."

# game/a1s1.rpy:797
translate spanish a1s1_52e804e4:

    # "Finally, I manage to break free of his dead weight and crawl a few feet away, spending a few moments catching my breath."
    "Por fin consigo librarme de su peso inerte y me arrastro unos pies, dedicando unos instantes a recuperar el aliento."

# game/a1s1.rpy:798
translate spanish a1s1_b7cd334b:

    # "I look back at his still-twitching form, his rump stuck slightly up in the air."
    "Vuelvo la vista hacia su cuerpo todavía tembloroso, con el trasero algo levantado."

# game/a1s1.rpy:799
translate spanish a1s1_10de3b99:

    # "I wonder how long I have before he wakes up."
    "Me pregunto cuánto tiempo tengo antes de que despierte."

# game/a1s1.rpy:800
translate spanish a1s1_43a040f6:

    # "There's a long, shiny, thin cord around my left wrist and I start to work at the knot."
    "Tengo un cable largo, brillante y fino alrededor de la muñeca izquierda, y empiezo a trabajar en el nudo."

# game/a1s1.rpy:801
translate spanish a1s1_d447fbee:

    # "It's a strange material; smooth and metallic, yet it bends as easily as rope."
    "Es un material extraño: liso y metálico, pero se dobla tan fácilmente como una cuerda."

# game/a1s1.rpy:802
translate spanish a1s1_66c4f01b:

    # "It's a pain in the ass getting it undone, though."
    "Pero es un puto suplicio desatarlo."

# game/a1s1.rpy:803
translate spanish a1s1_8714ba7d:

    # "It's like the dumb wolf just put as many knots into it as he could."
    "Es como si ese lobo idiota hubiera hecho todos los nudos que ha podido."

# game/a1s1.rpy:804
translate spanish a1s1_b9dbd443:

    # "He probably had no idea of what he was doing and now it makes sense why I was able to get out of it so easily."
    "Probablemente no tenía ni idea de lo que estaba haciendo, y ahora entiendo por qué he podido librarme tan fácilmente."

# game/a1s1.rpy:805
translate spanish a1s1_a8d0a848:

    # "While I'm undoing the mess I keep looking over at him."
    "Mientras deshago este lío, no dejo de mirar hacia él."

# game/a1s1.rpy:806
translate spanish a1s1_39ecb235:

    # "The twitches and snorts are subsiding, which I'm not sure is a good thing or not."
    "Los espasmos y los resoplidos están remitiendo, aunque no sé si eso es bueno o malo."

# game/a1s1.rpy:807
translate spanish a1s1_b2333d2b:

    # m "\"Come on...\""
    m "\"Vamos...\""

# game/a1s1.rpy:808
translate spanish a1s1_bc3ed4a0:

    # "I grunt as I finally pull the last tangle out, straightening the metal rope thing out in both my hands."
    "Gruño al deshacer por fin el último enredo y estirar esa especie de cuerda metálica con ambas manos."

# game/a1s1.rpy:809
translate spanish a1s1_a1c28065:

    # "I look between it and the knocked out wolf in front of me, giving my head a little shake."
    "Miro primero la cuerda y luego al lobo inconsciente que tengo delante, sacudiendo un poco la cabeza."

# game/a1s1.rpy:810
translate spanish a1s1_24765329:

    # m "\"What the fuck is even happening.\""
    m "\"Qué coño está pasando siquiera.\""

# game/a1s1.rpy:811
translate spanish a1s1_7ce057fa:

    # "I get to work, planting my butt on Amicus's as I pull both of his paws behind his back."
    "Me pongo manos a la obra, sentándome sobre el culo de Amicus mientras le llevo ambas manos a la espalda."

# game/a1s1.rpy:812
translate spanish a1s1_dd88d670:

    # "I have some difficulty keeping my balance as I lift his heavy arms and start winding the rope around his wrists."
    "Me cuesta mantener el equilibrio mientras levanto sus pesados brazos y empiezo a enrollar la cuerda alrededor de sus muñecas."

# game/a1s1.rpy:813
translate spanish a1s1_507b671e:

    # "I'm not exactly an expert at tying hands behind backs either, but I feel far more confident in my work than Amicus ever should have in his own."
    "Tampoco es que sea un experto atando manos a la espalda, pero confío mucho más en mi trabajo de lo que Amicus debería haber confiado en el suyo."

# game/a1s1.rpy:814
translate spanish a1s1_8858af24:

    # "I guess his carelessness makes some sort of sense considering I'm a tiny human and he's a giant canine."
    "Supongo que su descuido tiene cierta lógica, teniendo en cuenta que yo soy un humano diminuto y él un canino enorme."

# game/a1s1.rpy:815
translate spanish a1s1_4069dac7:

    # "He probably thought he'd just be able to toss me back in the closet if I got free."
    "Probablemente creía que, si me soltaba, bastaría con volver a arrojarme al armario."

# game/a1s1.rpy:816
translate spanish a1s1_f6e11450:

    # "I look over my work, somewhat satisfied with how neat and tight the binding is."
    "Repaso mi trabajo, bastante satisfecho de lo ordenada y apretada que ha quedado la atadura."

# game/a1s1.rpy:817
translate spanish a1s1_1865a3ba:

    # "I shift and almost slide off the wolf's ass, forcing me to put my hands back and steady myself on his thighs."
    "Me recoloco y casi me resbalo del culo del lobo, así que tengo que apoyar las manos detrás y sujetarme en sus muslos."

# game/a1s1.rpy:818
translate spanish a1s1_e75ff83a:

    # "They're thick and heavily muscled, and that makes me realize that they might also be a problem."
    "Son gruesos y muy musculosos, y eso me hace darme cuenta de que también podrían suponer un problema."

# game/a1s1.rpy:819
translate spanish a1s1_83bbf679:

    # "While binding his arms is a start, I have no doubt in my mind he'd be able to take me out with a few nasty kicks."
    "Atarle los brazos es un comienzo, pero no me cabe duda de que podría dejarme fuera de combate con unas cuantas patadas bien dadas."

# game/a1s1.rpy:820
translate spanish a1s1_2a9735f5:

    # "I stand up and start looking around for more of that rope, but that's when I notice something strange happening outside the windows."
    "Me levanto y empiezo a buscar más cuerda, pero entonces noto que algo extraño está ocurriendo al otro lado de las ventanas."

# game/a1s1.rpy:821
translate spanish a1s1_fe576099:

    # "Thin streaks of white light stretch and bend, moving slowly from the front before arcing in long lines to the sides and disappearing from sight."
    "Unas finas estelas de luz blanca se alargan y se curvan; avanzan despacio desde el frente, trazan largos arcos hacia los lados y desaparecen de la vista."

# game/a1s1.rpy:822
translate spanish a1s1_53ea1c99:

    # "I stare, mesmerized, then suddenly feel sick at the sight."
    "Me quedo mirándolas, fascinado, y de repente su visión me revuelve el estómago."

# game/a1s1.rpy:823
translate spanish a1s1_6600e992:

    # "I avert my eyes, looking at the wall while I watch the strange light show out of the corner of my eye."
    "Aparto la mirada hacia la pared, aunque sigo viendo de reojo aquel extraño espectáculo de luces."

# game/a1s1.rpy:824
translate spanish a1s1_1e9902e6:

    # "Are those stars? Are we in some sort of worm hole or, what was it called, hyperspace?"
    "¿Son estrellas? ¿Estamos en una especie de agujero de gusano o en... cómo se llamaba... el hiperespacio?"

# game/a1s1.rpy:825
translate spanish a1s1_c8290883:

    # "I start to get the feeling that I'm very, very far from Earth now, which makes me feel even more sick."
    "Empiezo a tener la sensación de que ya estoy muy, muy lejos de la Tierra, y eso me revuelve aún más el estómago."

# game/a1s1.rpy:826
translate spanish a1s1_cbc3592a:

    # "I want to keep my mind off of it, so I set about searching the deck for more of the metal rope, trying to ignore that we might be moving at the speed of light into the depths of space."
    "Quiero dejar de pensar en ello, así que me dedico a buscar más cuerda metálica por la cubierta, intentando ignorar que quizá estemos viajando a la velocidad de la luz hacia las profundidades del espacio."

# game/a1s1.rpy:827
translate spanish a1s1_87c99906:

    # "I don't have much luck; most everything in the ship is flush to its surface with very few moving parts."
    "No tengo mucha suerte: casi todo en la nave está integrado en las superficies y hay muy pocas piezas móviles."

# game/a1s1.rpy:828
translate spanish a1s1_ceb823a8:

    # "I end up going back to the utility closet and that's when I see that metal polygon with the long cord sticking out of it, the one I'd knocked off the shelf earlier."
    "Acabo volviendo al armario de herramientas, donde veo aquel polígono metálico del que sale un cable largo, el que antes tiré de la estantería."

# game/a1s1.rpy:829
translate spanish a1s1_82aeb659:

    # "I lean over and pull at it, deciding that it should hold, even if it's more plastic-y and not metal."
    "Me agacho y tiro del cable, convencido de que aguantará, aunque parece más bien de plástico y no de metal."

# game/a1s1.rpy:830
translate spanish a1s1_97c8d841:

    # "Five minutes later and I have his legs bound together."
    "Cinco minutos después, ya tiene las piernas atadas juntas."

# game/a1s1.rpy:831
translate spanish a1s1_4fda4b14:

    # "I search around for the taser for another minute before finding it pinned between Amicus's chest and the deck."
    "Busco la pistola eléctrica durante otro minuto hasta encontrarla atrapada entre el pecho de Amicus y la cubierta."

# game/a1s1.rpy:832
translate spanish a1s1_033398ee:

    # "I'm hot and sweaty as I finally sit back against the opposite wall, staring at the face-down wolf and his bindings."
    "Acalorado y sudoroso, me siento por fin contra la pared de enfrente, mirando al lobo boca abajo y sus ataduras."

# game/a1s1.rpy:833
translate spanish a1s1_337cc2e4:

    # "I weigh the taser in my hand, going over scenarios in my mind for what I'm going to say to him when he wakes back up..."
    "Sopeso la pistola eléctrica en la mano y repaso mentalmente lo que podría decirle cuando despierte..."

# game/a1s1.rpy:836
translate spanish a1s1_24963ce4:

    # "I'm not sure how long it takes; an hour, maybe two before Amicus starts to stir."
    "No sé cuánto tiempo pasa: una hora, quizá dos, antes de que Amicus empiece a moverse."

# game/a1s1.rpy:837
translate spanish a1s1_7693e9e2:

    # "First he groans, then he rolls over a few times, then draws up his bound legs before trying to work his paws free."
    "Primero gime, luego se da varias vueltas y encoge las piernas atadas antes de intentar soltar las manos."

# game/a1s1.rpy:838
translate spanish a1s1_dc4b67b0:

    # "Finally, he opens his eyes and because he's on his side, I'm the first thing he sees."
    "Por fin abre los ojos y, como está tumbado de lado, lo primero que ve soy yo."

# game/a1s1.rpy:839
translate spanish a1s1_2e497fe4:

    # "He squints, frowns, then groans again, turning over onto his stomach."
    "Entrecierra los ojos, frunce el ceño y vuelve a gemir antes de ponerse boca abajo."

# game/a1s1.rpy:843
translate spanish a1s1_fcdd355c:

    # a "\"What the hell?\""
    a "\"¿Qué demonios?\""

# game/a1s1.rpy:844
translate spanish a1s1_1479e231:

    # "I clear my throat and swallow, trying not to show how nervous I am."
    "Me aclaro la garganta y trago saliva, procurando no mostrar lo nervioso que estoy."

# game/a1s1.rpy:845
translate spanish a1s1_d90b82a6:

    # m "\"Yeah, what the hell. You tazed me again.\""
    m "\"Sí, qué demonios. Me has dado otra descarga.\""

# game/a1s1.rpy:847
translate spanish a1s1_3c8805f7_2:

    # a "\"What?\""
    a "\"¿Qué?\""

# game/a1s1.rpy:848
translate spanish a1s1_48ae054f:

    # "Amicus turns his head to look at me again, then looks away, letting out another groan."
    "Amicus gira la cabeza para volver a mirarme, luego aparta la vista y suelta otro gemido."

# game/a1s1.rpy:850
translate spanish a1s1_7a736a4b:

    # a "\"Ohh, my stomach. What did you do?\""
    a "\"Ay, mi estómago. ¿Qué has hecho?\""

# game/a1s1.rpy:851
translate spanish a1s1_44f6da45:

    # m "\"Exactly what you did to me.\""
    m "\"Exactamente lo mismo que tú me has hecho a mí.\""

# game/a1s1.rpy:852
translate spanish a1s1_2afb3018:

    # "I hold up my taser, turning it in the light so that the wolf can fully see it."
    "Levanto mi pistola eléctrica y la giro bajo la luz para que el lobo pueda verla bien."

# game/a1s1.rpy:853
translate spanish a1s1_2fa5552f:

    # "Amicus stares at it for a moment before letting his face fall back to the floor of the deck."
    "Amicus la mira un momento antes de dejar caer de nuevo la cara contra el suelo de la cubierta."

# game/a1s1.rpy:855
translate spanish a1s1_631c3f7d:

    # a "\"Oh Gods, I feel like I'm on fire...did you use it at full power? What the hell is wrong with you!?\""
    a "\"Ay, dioses, siento que estoy ardiendo... ¿La has puesto a máxima potencia? ¡¿Qué demonios te pasa?!\""

# game/a1s1.rpy:856
translate spanish a1s1_dbfd776e:

    # "Despite my fear and anxiety over this entire situation, I'm able to feel indignant."
    "A pesar del miedo y la ansiedad que me provoca toda esta situación, aún soy capaz de indignarme."

# game/a1s1.rpy:857
translate spanish a1s1_f79d6da1:

    # m "\"Me!? You did the same to me, then lied to me, then tazed me AGAIN, then tied me up. You're crazy!\""
    m "\"¡¿A mí?! Me has hecho lo mismo, luego me has mentido, después me has dado OTRA descarga y me has atado. ¡Estás loco!\""

# game/a1s1.rpy:859
translate spanish a1s1_241eb306:

    # a "\"I would NEVER use full power on ANYONE. Uggghhh.\""
    a "\"Yo JAMÁS usaría la máxima potencia con NADIE. Uggghhh.\""

# game/a1s1.rpy:860
translate spanish a1s1_2aa72739:

    # "Amicus seems to ignore my rant as he rolls onto his back, arching over his tied paws, probably stretching out the muscles that I'd hit with the taser."
    "Amicus parece ignorar mi arrebato mientras se pone boca arriba y arquea la espalda sobre las manos atadas, probablemente para estirar los músculos que he alcanzado con la pistola eléctrica."

# game/a1s1.rpy:861
translate spanish a1s1_3544bdcb:

    # "I wait a while longer, listening to the grunts, groans, and complaints as Amicus continues to whine."
    "Espero un rato más, escuchando gruñidos, gemidos y quejas mientras Amicus sigue lamentándose."

# game/a1s1.rpy:862
translate spanish a1s1_d2816400:

    # "I'm not that stupid, though."
    "Pero no soy tan tonto."

# game/a1s1.rpy:863
translate spanish a1s1_db16d373:

    # "I can tell he's stalling for time, trying to figure out a way to get out of this."
    "Me doy cuenta de que está ganando tiempo, intentando encontrar una forma de salir de esta."

# game/a1s1.rpy:864
translate spanish a1s1_1950528a:

    # "I stand up."
    "Me levanto."

# game/a1s1.rpy:865
translate spanish a1s1_a05f8ccf:

    # m "\"Take me home.\""
    m "\"Llévame a casa.\""

# game/a1s1.rpy:866
translate spanish a1s1_cef44645:

    # "Amicus opens one eye, glaring at me."
    "Amicus abre un ojo y me fulmina con la mirada."

# game/a1s1.rpy:868
translate spanish a1s1_3c8805f7_3:

    # a "\"What?\""
    a "\"¿Qué?\""

# game/a1s1.rpy:869
translate spanish a1s1_3e0e781e:

    # m "\"I said take me home.\""
    m "\"He dicho que me lleves a casa.\""

# game/a1s1.rpy:871
translate spanish a1s1_f8801f6f:

    # "Amicus goes quiet for a moment, his eyes closed, then he forces himself to sit up, visibly cringing as he's forced to use his stomach muscles."
    "Amicus se queda callado un momento, con los ojos cerrados, y luego se obliga a incorporarse, haciendo una mueca evidente de dolor al tener que usar los músculos del abdomen."

# game/a1s1.rpy:872
translate spanish a1s1_052ed4a0:

    # "He scoots back with more complaints until he plants his back against the wall behind him."
    "Retrocede arrastrándose y quejándose aún más, hasta apoyar la espalda contra la pared que tiene detrás."

# game/a1s1.rpy:873
translate spanish a1s1_8ef55b42:

    # "I see his shoulders shift, his biceps bulging and can tell that he's working and testing the restraints."
    "Veo cómo mueve los hombros y se le hinchan los bíceps; me doy cuenta de que está forcejeando y poniendo a prueba las ataduras."

# game/a1s1.rpy:874
translate spanish a1s1_773caa22:

    # "I raise the taser."
    "Levanto la pistola eléctrica."

# game/a1s1.rpy:875
translate spanish a1s1_0a4c5353:

    # m "\"Stop moving or I'm gonna hit you again.\""
    m "\"Deja de moverte o te daré otra descarga.\""

# game/a1s1.rpy:877
translate spanish a1s1_249f2c03:

    # a "\"Fuck off.\""
    a "\"Vete a la mierda.\""

# game/a1s1.rpy:878
translate spanish a1s1_211ba9fb:

    # "I move toward him, brandishing the taser like a sword."
    "Me acerco a él, blandiendo la pistola eléctrica como si fuera una espada."

# game/a1s1.rpy:880
translate spanish a1s1_6e0e0854:

    # a "\"Hey, hey, HEY!\""
    a "\"¡Eh, eh, EH!\""

# game/a1s1.rpy:881
translate spanish a1s1_9de7b642:

    # "Amicus kicks his feet up, trying to block my attack."
    "Amicus levanta los pies de golpe, intentando bloquear mi ataque."

# game/a1s1.rpy:883
translate spanish a1s1_bb38f7d4:

    # "Now I see real fear in his eyes."
    "Ahora veo auténtico miedo en sus ojos."

# game/a1s1.rpy:884
translate spanish a1s1_209e064c:

    # m "\"Then stop moving and tell me how we get back!\""
    m "\"¡Pues deja de moverte y dime cómo podemos volver!\""

# game/a1s1.rpy:885
translate spanish a1s1_42ea5d47:

    # "I don't really want to shock him again."
    "La verdad es que no quiero darle otra descarga."

# game/a1s1.rpy:886
translate spanish a1s1_a1394111:

    # "It did look really painful and on top of that I don't want to knock him out for hours while our little ship is hurtling through space."
    "Parecía realmente doloroso y, además, no quiero dejarlo inconsciente durante horas mientras nuestra pequeña nave sale disparada por el espacio."

# game/a1s1.rpy:887
translate spanish a1s1_4c3706c6:

    # "Amicus glares at me for a moment, his feet still in the air before he slowly lowers them."
    "Amicus me mira con rabia un momento, todavía con los pies en alto, antes de bajarlos despacio."

# game/a1s1.rpy:889
translate spanish a1s1_987ecee1:

    # a "\"I'll...show you if you let me go.\""
    a "\"Te... lo enseñaré si me sueltas.\""

# game/a1s1.rpy:890
translate spanish a1s1_77da021f:

    # "I actually laugh and the sound seems to startle the wolf."
    "Hasta me río, y el sonido parece sobresaltar al lobo."

# game/a1s1.rpy:891
translate spanish a1s1_d861dde5:

    # m "\"Are you kidding me? Why should I trust you at ALL after what you've done to me.\""
    m "\"¿Estás de broma? ¿Por qué iba a confiar en ti lo MÁS MÍNIMO después de lo que me has hecho?\""

# game/a1s1.rpy:892
translate spanish a1s1_2fcfdb70:

    # "Amicus's ears flatten."
    "Amicus aplana las orejas."

# game/a1s1.rpy:893
translate spanish a1s1_03ac5185:

    # m "\"Tell me where the hell you're taking me and why, otherwise I WILL zap you again.\""
    m "\"Dime adónde demonios me llevas y por qué; de lo contrario, SÍ que volveré a darte una descarga.\""

# game/a1s1.rpy:895
translate spanish a1s1_bec79dea:

    # a "\"Wh—I...\""
    a "\"Qué... yo...\""

# game/a1s1.rpy:896
translate spanish a1s1_6e5ab8a9:

    # "He seems at a loss for words."
    "Parece haberse quedado sin palabras."

# game/a1s1.rpy:897
translate spanish a1s1_082d1406:

    # m "\"Hm?\""
    m "\"¿Hm?\""

# game/a1s1.rpy:899
translate spanish a1s1_203d9ea9:

    # a "\"I...can't tell you.\""
    a "\"Yo... no puedo decírtelo.\""

# game/a1s1.rpy:900
translate spanish a1s1_c7b19f48:

    # "I glare and for a moment I consider just jabbing him again right then and there."
    "Lo miro con furia y, por un momento, considero darle otra descarga ahí mismo."

# game/a1s1.rpy:901
translate spanish a1s1_2558be92:

    # m "\"Why not?\""
    m "\"¿Por qué no?\""

# game/a1s1.rpy:903
translate spanish a1s1_a316e54e:

    # "The wolf remains silent as he looks away from me."
    "El lobo permanece en silencio, apartando la mirada de mí."

# game/a1s1.rpy:904
translate spanish a1s1_15ba54a7:

    # "I feel myself getting even more angry."
    "Siento que me enfado todavía más."

# game/a1s1.rpy:905
translate spanish a1s1_66882f4d:

    # "I'm tired of this alien holding me hostage."
    "Estoy harto de que este alienígena me tenga secuestrado."

# game/a1s1.rpy:906
translate spanish a1s1_300292c4:

    # m "\"Well, I guess I'll just have to figure it out on my own, then.\""
    m "\"Bueno, pues supongo que tendré que averiguarlo por mi cuenta.\""

# game/a1s1.rpy:909
translate spanish a1s1_2104fa6c:

    # "I turn away and start moving toward the front of the deck."
    "Me doy la vuelta y empiezo a dirigirme hacia la parte delantera de la cubierta."

# game/a1s1.rpy:910
translate spanish a1s1_00cfaef0:

    # "Amicus shifts around behind me."
    "Amicus se revuelve detrás de mí."

# game/a1s1.rpy:912
translate spanish a1s1_55026a02:

    # a "\"What!? You don't know the first thing about this ship. Don't—\""
    a "\"¡¿Qué?! No sabes absolutamente nada de esta nave. No—\""

# game/a1s1.rpy:913
translate spanish a1s1_bfc07adc:

    # "The big wolf grunts as he tries to get his feet under him."
    "El enorme lobo gruñe mientras intenta colocar los pies bajo su cuerpo."

# game/a1s1.rpy:915
translate spanish a1s1_cd38769c:

    # a "\"Don't touch anything!\""
    a "\"¡No toques nada!\""

# game/a1s1.rpy:917
translate spanish a1s1_fac31667:

    # "I ignore him and move to the panels, looking them over."
    "Lo ignoro y me acerco a los paneles, examinándolos."

# game/a1s1.rpy:918
translate spanish a1s1_04238e7f:

    # "The big one in the middle looks promising and I start poking at it."
    "El grande que hay en el centro parece prometedor, así que empiezo a toquetearlo."

# game/a1s1.rpy:919
translate spanish a1s1_61bfbf1e:

    # "I know I won't be able to figure out how to turn the ship around, but the wolf's worry over me touching the panels gives me an idea."
    "Sé que no podré averiguar cómo dar la vuelta a la nave, pero la preocupación del lobo por que toque los paneles me da una idea."

# game/a1s1.rpy:920
translate spanish a1s1_a5cb80d7:

    # "I can probably mess things up to the point where he'll HAVE to tell me what he's doing, or even how I might be able to get back."
    "Quizá pueda estropear lo suficiente las cosas como para que TENGA que decirme qué está haciendo, o incluso cómo podría volver."

# game/a1s1.rpy:921
translate spanish a1s1_34c56a12:

    # "There aren't many other options aside from torturing him, something I don't really want to do."
    "Aparte de torturarlo, algo que en realidad no quiero hacer, no me quedan muchas opciones."

# game/a1s1.rpy:922
translate spanish a1s1_ac0fd900:

    # "The lines and shapes move with my finger and Roman numerals pop up randomly here and there."
    "Las líneas y las formas se mueven con mi dedo, y aparecen números romanos al azar aquí y allá."

# game/a1s1.rpy:923
translate spanish a1s1_de82b99b:

    # a "\"Hey...what...are you doing?\""
    a "\"Eh... ¿qué... estás haciendo?\""

# game/a1s1.rpy:924
translate spanish a1s1_816b3a4b:

    # "Amicus huffs and puffs behind me, just as a circle appears and compresses around my finger, like it's zeroed in on something."
    "Amicus jadea detrás de mí justo cuando aparece un círculo que se cierra alrededor de mi dedo, como si hubiera fijado un objetivo."

# game/a1s1.rpy:925
translate spanish a1s1_6ef00a2c:

    # "I look back to see Amicus hobbling up onto his tied together feet, looking just about ready to topple over."
    "Miro hacia atrás y veo a Amicus ponerse trabajosamente de pie con los pies atados juntos, como si estuviera a punto de caerse."

# game/a1s1.rpy:927
translate spanish a1s1_60384470:

    # a "\"You have no idea what—\""
    a "\"No tienes ni idea de lo que—\""

# game/a1s1.rpy:928
translate spanish a1s1_df946a3b:

    # "I feel a soft vibration under my finger not unlike my phone's haptic feedback."
    "Noto una vibración suave bajo el dedo, parecida a la respuesta háptica de mi teléfono."

# game/a1s1.rpy:929
translate spanish a1s1_21f2d835:

    # com "\"Overriding sleep mode. Locked on to Stella 556425.\""
    com "\"Anulando el modo de reposo. Objetivo fijado: Stella 556425.\""

# game/a1s1.rpy:931
translate spanish a1s1_b509f5b1:

    # a "\"NO! Com, stop last directive!\""
    a "\"¡NO! Com, cancela la última orden.\""

# game/a1s1.rpy:932
translate spanish a1s1_29c57a0f:

    # com "\"Voice commands for piloting are reserved for the emperor, Amicus.\""
    com "\"Las órdenes de pilotaje por voz están reservadas al emperador, Amicus.\""

# game/a1s1.rpy:934
translate spanish a1s1_dfff6d75:

    # a "\"Human, stop!\""
    a "\"¡Humano, para!\""

# game/a1s1.rpy:935
translate spanish a1s1_cf0ce5d4:

    # "Amicus starts hopping toward me on his bound feet and I scramble to the side so he doesn't run into me."
    "Amicus empieza a saltar hacia mí con los pies atados y yo me aparto apresuradamente para que no choque conmigo."

# game/a1s1.rpy:936
translate spanish a1s1_f34a2ef9:

    # a "\"No, no, no!\""
    a "\"¡No, no, no!\""

# game/a1s1.rpy:937
translate spanish a1s1_b9556f4d:

    # "The wolf stares down at the panel and I look out the window as the stars seem to curve all the way to my right, making me feel sick again and the next thing I know—"
    "El lobo mira el panel y yo miro por la ventana, mientras las estrellas parecen curvarse por completo hacia mi derecha y vuelven a revolverme el estómago; entonces, de repente—"

# game/a1s1.rpy:941
translate spanish a1s1_b2799851:

    # "The cabin is lit up by an ominous red glow."
    "La cabina se ilumina con un ominoso resplandor rojo."

# game/a1s1.rpy:943
translate spanish a1s1_4e63b230:

    # "The windows suddenly tint, blocking the worst of the light and that's when I'm able to see a massive ball of fire in front of the ship."
    "Los cristales se oscurecen de pronto y bloquean la parte más intensa de la luz; entonces puedo ver una enorme bola de fuego delante de la nave."

# game/a1s1.rpy:944
translate spanish a1s1_c14b867c:

    # "The size of it is incredible."
    "Su tamaño es increíble."

# game/a1s1.rpy:945
translate spanish a1s1_43e0695f:

    # com "\"Orbital trajectory will intersect with photosphere. Ensure safety straps are in place. Making corrective maneuvers.\""
    com "\"La trayectoria orbital intersectará la fotosfera. Asegúrense de llevar abrochados los cinturones de seguridad. Ejecutando maniobras correctivas.\""

# game/a1s1.rpy:946
translate spanish a1s1_2d5b5342:

    # "I only have a moment to wonder what the hell Com is talking about before Amicus and I are thrown sideways into the left window of the ship."
    "Apenas tengo un instante para preguntarme de qué demonios habla Com antes de que Amicus y yo salgamos despedidos de lado contra la ventana izquierda de la nave."

# game/a1s1.rpy:947
translate spanish a1s1_c4817402:

    # "The impact is mostly cushioned by Amicus's body and I hear him yell and curse under me."
    "El cuerpo de Amicus amortigua la mayor parte del golpe, y lo oigo gritar y soltar maldiciones debajo de mí."

# game/a1s1.rpy:949
translate spanish a1s1_ff1f31fe:

    # a "\"MOVE! GET IN THE SEAT!\""
    a "\"¡MUÉVETE! ¡MÉTETE EN EL ASIENTO!\""

# game/a1s1.rpy:950
translate spanish a1s1_a7217bce:

    # "I struggle to reach out to the seat in front of me, but I can barely lift my hand."
    "Intento alcanzar el asiento que tengo delante, pero apenas puedo levantar la mano."

# game/a1s1.rpy:951
translate spanish a1s1_e2f00504:

    # "The gravity of the star is so powerful it feels like it's going to suck out my soul."
    "La gravedad de la estrella es tan poderosa que parece que vaya a arrancarme el alma."

# game/a1s1.rpy:952
translate spanish a1s1_1319dd6f:

    # "Then I'm suddenly boosted up by something behind me and I look back, the movement making me feel like my neck is going to break."
    "Entonces algo que hay detrás de mí me impulsa hacia arriba y miro atrás; el movimiento me hace sentir que el cuello va a rompérseme."

# game/a1s1.rpy:953
translate spanish a1s1_e626bc22:

    # "I see Amicus with his back planted against the window, his feet pushing me up to the seat."
    "Veo a Amicus con la espalda apoyada en la ventana, empujándome con los pies hacia el asiento."

# game/a1s1.rpy:954
translate spanish a1s1_c271fa10:

    # "I manage to grab the armrest and pull myself into it."
    "Consigo agarrar el reposabrazos y tirar de mí hasta entrar en el asiento."

# game/a1s1.rpy:955
translate spanish a1s1_b1825b6e:

    # "Now the left armrest is digging painfully into my back, making it feel as if a professional wrestler is slamming me into a back breaker."
    "Ahora el reposabrazos izquierdo se me clava dolorosamente en la espalda, como si un luchador profesional me estuviera aplicando un quebrantador de espalda."

# game/a1s1.rpy:956
translate spanish a1s1_92835a48:

    # "Amicus jumps from the window, high enough that his feet land against the right side of my chair."
    "Amicus salta desde la ventana lo bastante alto como para apoyar los pies contra el lado derecho de mi asiento."

# game/a1s1.rpy:958
translate spanish a1s1_2dba6ea7:

    # "Then he jumps again, managing to wedge himself in the footwell of the opposite seat."
    "Luego vuelve a saltar y consigue encajarse en el hueco para los pies del asiento de enfrente."

# game/a1s1.rpy:959
translate spanish a1s1_cd243b41:

    # com "\"Heat shields are compromised. Expect heat damage to outer layer of ship in 30 seconds.\""
    com "\"Los escudos térmicos están comprometidos. Se prevén daños por calor en la capa exterior de la nave dentro de 30 segundos.\""

# game/a1s1.rpy:960
translate spanish a1s1_5f694945:

    # "With a great deal of snarling and gasping, he pushes himself awkwardly into the seat, both feet planted against the panels in front of him for leverage."
    "Entre gruñidos y jadeos, se impulsa torpemente hasta el asiento, apoyando ambos pies en los paneles que tiene delante para hacer fuerza."

# game/a1s1.rpy:961
translate spanish a1s1_8bf1646e:

    # "He turns to me, teeth bared, a determined look in his eyes."
    "Se vuelve hacia mí con los dientes al descubierto y una expresión decidida en los ojos."

# game/a1s1.rpy:962
translate spanish a1s1_bc262306:

    # a "\"Look at your right armrest! Do you see the green panel between the red buttons!?\""
    a "\"¡Mira tu reposabrazos derecho! ¡¿Ves el panel verde entre los botones rojos?!\""

# game/a1s1.rpy:963
translate spanish a1s1_88e05b31:

    # "Through the shock I'm somehow able to understand him and look down."
    "A pesar del shock, de algún modo consigo entenderlo y mirar hacia abajo."

# game/a1s1.rpy:964
translate spanish a1s1_fdcef024:

    # a "\"Now, drag your finger across it to the left, it'll steer the ship!\""
    a "\"¡Ahora arrastra el dedo por él hacia la izquierda; así dirigirás la nave!\""

# game/a1s1.rpy:965
translate spanish a1s1_1b074d8a:

    # "I feel panic starting to rise in my chest at the idea of steering a goddamn spaceship."
    "Siento que el pánico empieza a subir por mi pecho ante la idea de pilotar una maldita nave espacial."

# game/a1s1.rpy:966
translate spanish a1s1_486a0250:

    # m "\"What!?\""
    m "\"¡¿Qué?!\""

# game/a1s1.rpy:967
translate spanish a1s1_ce8eb89f:

    # a "\"Just do it! Point us away from the star!\""
    a "\"¡Hazlo y ya está! ¡Apunta en dirección contraria a la estrella!\""

# game/a1s1.rpy:968
translate spanish a1s1_1f4abbb6:

    # "I do as I'm told, sliding a thumb gingerly over the green panel."
    "Hago lo que me dice y deslizo con cuidado un pulgar sobre el panel verde."

# game/a1s1.rpy:969
translate spanish a1s1_f9d2d076:

    # "And slowly the ship turns, pointing away from the star, shifting the incredible force of gravity until it's pulling us back into the seats."
    "La nave gira despacio y se orienta en dirección contraria a la estrella; la enorme fuerza de gravedad cambia de dirección hasta empujarnos hacia atrás contra los asientos."

# game/a1s1.rpy:970
translate spanish a1s1_e4599b3d:

    # a "\"Now...now see that lever in between us!?\""
    a "\"Ahora... ¡¿ves esa palanca que hay entre nosotros?!\""

# game/a1s1.rpy:971
translate spanish a1s1_ba9c3ac4:

    # m "\"Yeah!\""
    m "\"¡Sí!\""

# game/a1s1.rpy:972
translate spanish a1s1_f663d1d7:

    # a "\"Pull it down!\""
    a "\"¡Tira de ella hacia abajo!\""

# game/a1s1.rpy:973
translate spanish a1s1_459ab3e4:

    # "Now reaching my hand out is almost impossible as it gets pulled back toward the star behind us."
    "Ahora extender la mano es casi imposible, porque la estrella que tenemos detrás tira de ella hacia atrás."

# game/a1s1.rpy:974
translate spanish a1s1_0a5dfde7:

    # "Gritting my teeth, I lean forward as hard as I can, practically throwing myself forward and grabbing onto the lever."
    "Aprieto los dientes y me inclino hacia delante con todas mis fuerzas, casi arrojándome sobre la palanca hasta conseguir agarrarla."

# game/a1s1.rpy:975
translate spanish a1s1_ce9fad3a:

    # "Then gravity does the rest of the work and the lever comes down hard."
    "Entonces la gravedad hace el resto y la palanca baja de golpe."

# game/a1s1.rpy:976
translate spanish a1s1_1afa6c1e:

    # "I lose my grip and get thrown back into my seat."
    "Pierdo el agarre y salgo despedido hacia atrás contra mi asiento."

# game/a1s1.rpy:979
translate spanish a1s1_f0172b9a:

    # "The gravity increases two-fold and for a moment it feels like my entire body is being crushed into a pancake."
    "La gravedad se duplica y, por un momento, siento que todo mi cuerpo está siendo aplastado hasta quedar plano como una tortita."

# game/a1s1.rpy:983
translate spanish a1s1_b95a3d23:

    # "And then the burning orange light is gone and the deck goes black."
    "Y entonces desaparece la luz naranja abrasadora y la cubierta queda a oscuras."

# game/a1s1.rpy:985
translate spanish a1s1_79c1dcbe:

    # com "\"Running diagnostics...Amicus?\""
    com "\"Ejecutando diagnóstico... ¿Amicus?\""

# game/a1s1.rpy:986
translate spanish a1s1_a20cefa7_11:

    # "..."
    "..."

# game/a1s1.rpy:987
translate spanish a1s1_c36a13ce:

    # a "\"Yes, Com?\""
    a "\"¿Sí, Com?\""

# game/a1s1.rpy:988
translate spanish a1s1_0c2a0d72:

    # com "\"Damage to the ship is severe. Recovery mode is required.\""
    com "\"La nave ha sufrido daños graves. Es necesario activar el modo de recuperación.\""

# game/a1s1.rpy:989
translate spanish a1s1_a20cefa7_12:

    # "..."
    "..."

# game/a1s1.rpy:990
translate spanish a1s1_e6f10430:

    # a "\"Enter recovery mode.\""
    a "\"Activa el modo de recuperación.\""

# game/a1s1.rpy:991
translate spanish a1s1_b36aba0c:

    # com "\"Standby.\""
    com "\"En espera.\""

# game/a1s1.rpy:992
translate spanish a1s1_a20cefa7_13:

    # "..."
    "..."

# game/a1s1.rpy:997
translate spanish a1s1_53ebd070:

    # "We sit in silence for a long, long time."
    "Nos quedamos sentados en silencio durante mucho, muchísimo tiempo."

# game/a1s1.rpy:998
translate spanish a1s1_a3762f20:

    # "I lean against the seat with both feet drawn up to my chest, feeling numb and shaky."
    "Me recuesto en el asiento con ambos pies recogidos contra el pecho, sintiéndome entumecido y tembloroso."

# game/a1s1.rpy:999
translate spanish a1s1_60553089:

    # "I also feel stupid, embarrassed, and kind of guilty."
    "También me siento estúpido, avergonzado y un poco culpable."

# game/a1s1.rpy:1000
translate spanish a1s1_05993c8d:

    # "On one hand I nearly just got us both killed."
    "Por una parte, acabo de estar a punto de matarnos a los dos."

# game/a1s1.rpy:1001
translate spanish a1s1_17873bdb:

    # "But on the other hand this crazy alien almost killed {i}me{/i} by bringing me here in the first place."
    "Pero, por otra, este alienígena loco casi {i}me{/i} mata a mí al traerme aquí para empezar."

# game/a1s1.rpy:1002
translate spanish a1s1_350830fa:

    # "At least it feels that way."
    "Al menos, así es como lo siento."

# game/a1s1.rpy:1003
translate spanish a1s1_34178ec1:

    # "I still don't know what his ultimate plan is with me."
    "Todavía no sé cuál es su plan definitivo para mí."

# game/a1s1.rpy:1004
translate spanish a1s1_49786a05:

    # "I wonder for the hundredth time if I'm going to wake up."
    "Me pregunto por centésima vez si voy a despertarme."

# game/a1s1.rpy:1005
translate spanish a1s1_7b4eb03b:

    # "I plug my nose and try to breathe through my nostrils."
    "Me tapo la nariz e intento respirar por las fosas nasales."

# game/a1s1.rpy:1006
translate spanish a1s1_061ad74f:

    # "No air comes through."
    "No pasa nada de aire."

# game/a1s1.rpy:1007
translate spanish a1s1_9c1278a5:

    # "I sigh and look out the window, at the blue glow that we've found ourselves in."
    "Suspiro y miro por la ventana el resplandor azul en el que nos encontramos."

# game/a1s1.rpy:1008
translate spanish a1s1_b8e14a66:

    # "The star that we'd just escaped is far away now, though it's still an almost-blinding tiny orb far to my left, kind of like the sun was not too long ago."
    "La estrella de la que acabamos de escapar está muy lejos ya, aunque sigue siendo una pequeña esfera casi cegadora a lo lejos, a mi izquierda, como lo era el sol no hace mucho."

# game/a1s1.rpy:1009
translate spanish a1s1_a8f16323:

    # "It's lighting up all of this dust that's around us with an eerie blue glow."
    "Ilumina todo el polvo que nos rodea con un inquietante resplandor azul."

# game/a1s1.rpy:1010
translate spanish a1s1_035489b0:

    # "It's kind of calming."
    "En cierto modo, resulta tranquilizador."

# game/a1s1.rpy:1012
translate spanish a1s1_c80a7ea9:

    # "I look over at Amicus and see him slumped in his chair, looking out the window."
    "Miro a Amicus y lo veo hundido en su asiento, mirando por la ventana."

# game/a1s1.rpy:1013
translate spanish a1s1_63be3a5d:

    # "His shoulders are hunched, ears drooping, and his head down."
    "Tiene los hombros encorvados, las orejas caídas y la cabeza baja."

# game/a1s1.rpy:1014
translate spanish a1s1_8db324c3:

    # "He's on the edge of his seat because his arms are still tied behind his back, forcing him to lean forward a bit."
    "Está sentado en el borde del asiento porque todavía tiene los brazos atados a la espalda, lo que lo obliga a inclinarse un poco hacia delante."

# game/a1s1.rpy:1015
translate spanish a1s1_fe5cde7c:

    # "Com hasn't spoken since we went into \"recovery mode\" and the ship hasn't moved at all."
    "Com no ha vuelto a hablar desde que entramos en el «modo de recuperación», y la nave no se ha movido en absoluto."

# game/a1s1.rpy:1016
translate spanish a1s1_fdf72a54:

    # "The usual hum isn't even there."
    "Ni siquiera se oye el zumbido habitual."

# game/a1s1.rpy:1017
translate spanish a1s1_94397e0d:

    # "It's like everything is turned off."
    "Es como si todo estuviera apagado."

# game/a1s1.rpy:1018
translate spanish a1s1_19de60eb:

    # "I finally decide to break the silence."
    "Por fin decido romper el silencio."

# game/a1s1.rpy:1019
translate spanish a1s1_2e87079d:

    # m "\"Amicus?\""
    m "\"¿Amicus?\""

# game/a1s1.rpy:1020
translate spanish a1s1_40f454f2:

    # "I see his ears flick, but he keeps his head down, not even looking at me."
    "Veo que mueve las orejas, pero mantiene la cabeza baja sin siquiera mirarme."

# game/a1s1.rpy:1021
translate spanish a1s1_a12bf6c9:

    # "I swallow, then try again."
    "Trago saliva y lo intento de nuevo."

# game/a1s1.rpy:1022
translate spanish a1s1_74b1ef73:

    # m "\"Amicus.\""
    m "\"Amicus.\""

# game/a1s1.rpy:1023
translate spanish a1s1_74b02210:

    # "I see his shoulders rise and fall in a deep sigh, but he keeps silent."
    "Veo cómo sus hombros suben y bajan con un profundo suspiro, pero sigue callado."

# game/a1s1.rpy:1024
translate spanish a1s1_0f7586f5:

    # "I'm about to just give up and slump back in my seat when he suddenly responds."
    "Estoy a punto de rendirme y dejarme caer de nuevo en el asiento cuando, de repente, responde."

# game/a1s1.rpy:1025
translate spanish a1s1_3c8805f7_4:

    # a "\"What?\""
    a "\"¿Qué?\""

# game/a1s1.rpy:1026
translate spanish a1s1_604e6184:

    # m "\"What's happening?\""
    m "\"¿Qué está pasando?\""

# game/a1s1.rpy:1028
translate spanish a1s1_f20929c0:

    # "The wolf turns to glare at me."
    "El lobo se vuelve para mirarme con rabia."

# game/a1s1.rpy:1029
translate spanish a1s1_d0761464:

    # a "\"What do you mean 'what's happening'? you broke the ship.\""
    a "\"¿Qué quieres decir con eso de 'qué está pasando'? Has roto la nave.\""

# game/a1s1.rpy:1031
translate spanish a1s1_d45b6579:

    # "He turns away and continues to sulk."
    "Se da la vuelta y sigue enfurruñado."

# game/a1s1.rpy:1032
translate spanish a1s1_4f9b6fbc:

    # "I feel a little anger at that and I realize that this alien isn't alien at all."
    "Eso me enfada un poco y me doy cuenta de que este alienígena no tiene nada de alienígena."

# game/a1s1.rpy:1033
translate spanish a1s1_3982a2ed:

    # "He's acting just like an upset human kid that didn't get his way."
    "Se comporta exactamente como un niño humano enfadado porque no se ha salido con la suya."

# game/a1s1.rpy:1034
translate spanish a1s1_734730b6:

    # "It makes me a little less afraid of him."
    "Eso hace que le tenga un poco menos de miedo."

# game/a1s1.rpy:1035
translate spanish a1s1_def4f1e1:

    # m "\"Excuse me? Do I have to go through the list of shit that you did to me?\""
    m "\"¿Perdona? ¿Tengo que repasar toda la mierda que me has hecho?\""

# game/a1s1.rpy:1037
translate spanish a1s1_c653dfba:

    # "Amicus turns to me again and I can almost see his mind working to think of some sort of comeback."
    "Amicus se vuelve otra vez hacia mí y casi puedo ver cómo le funciona la cabeza para encontrar alguna réplica."

# game/a1s1.rpy:1038
translate spanish a1s1_36cafdff:

    # a "\"Well, I think you topped it by nearly throwing us into a star, human!\""
    a "\"¡Pues creo que tú lo has superado al estar a punto de arrojarnos a una estrella, humano!\""

# game/a1s1.rpy:1039
translate spanish a1s1_671aad74:

    # m "\"You shouldn't have kidnapped me in the first place, {i}wolf{/i}.\""
    m "\"Para empezar, no deberías haberme secuestrado, {i}lobo{/i}.\""

# game/a1s1.rpy:1040
translate spanish a1s1_1dc9a05f:

    # a "\"I should be calling you child since that's what you are.\""
    a "\"Debería llamarte niño, porque eso es lo que eres.\""

# game/a1s1.rpy:1041
translate spanish a1s1_3523184b:

    # m "\"Well this child outsmarted you, zapped you, and tied you up.\""
    m "\"Pues este niño te ha engañado, te ha dado una descarga y te ha atado.\""

# game/a1s1.rpy:1043
translate spanish a1s1_9a8a2db3:

    # "I see him bristle, the hackles rising on his shoulders like a dog."
    "Veo cómo se eriza; se le levanta el pelo de los hombros como a un perro."

# game/a1s1.rpy:1044
translate spanish a1s1_81cbce4e:

    # a "\"You could have KILLED me. That setting is meant for creatures three times my size!\""
    a "\"Podrías haberme MATADO. ¡Esa potencia está pensada para criaturas tres veces más grandes que yo!\""

# game/a1s1.rpy:1045
translate spanish a1s1_cef052dc:

    # m "\"How was I supposed to know!? I don't know anything about what's going on!\""
    m "\"¡¿Cómo iba a saberlo?! ¡No sé nada de lo que está pasando!\""

# game/a1s1.rpy:1046
translate spanish a1s1_5333b4c9:

    # a "\"I told you what's going on—\""
    a "\"Te he dicho lo que está pasando—\""

# game/a1s1.rpy:1047
translate spanish a1s1_99efae27:

    # m "\"You really think I'm stupid, don't you.\""
    m "\"De verdad crees que soy estúpido, ¿no?\""

# game/a1s1.rpy:1049
translate spanish a1s1_a0a98c03:

    # "Amicus pouts and turns away again."
    "Amicus hace un mohín y vuelve a apartarse."

# game/a1s1.rpy:1050
translate spanish a1s1_64a84c4f:

    # m "\"I think you thought I was some stupid alien you could just take advantage of. I can tell you've been lying to me this whole time.\""
    m "\"Creo que pensabas que yo era un alienígena estúpido del que podías aprovecharte sin más. Me doy cuenta de que llevas todo este tiempo mintiéndome.\""

# game/a1s1.rpy:1051
translate spanish a1s1_70ea6b73:

    # "Amicus flattens his ears even more, shoulders bunching up."
    "Amicus aplana aún más las orejas y encoge los hombros."

# game/a1s1.rpy:1052
translate spanish a1s1_b1b9128c:

    # m "\"Is that what you and your people do? Kidnapping and lying to everyone you meet—\""
    m "\"¿Eso es lo que hacéis tú y los tuyos? Secuestrar y mentir a todo el que os encontráis—\""

# game/a1s1.rpy:1054
translate spanish a1s1_157d5187:

    # "Now his hackles really raise up and he turns on me fast."
    "Ahora sí que se le eriza el pelo y se vuelve hacia mí de golpe."

# game/a1s1.rpy:1055
translate spanish a1s1_d41bc9db:

    # "I try not to lean back."
    "Intento no echarme hacia atrás."

# game/a1s1.rpy:1056
translate spanish a1s1_7f1a5b27:

    # "Despite the similarities, he's still a wolf, and those teeth are terrifying."
    "A pesar de las semejanzas, sigue siendo un lobo, y esos dientes dan miedo."

# game/a1s1.rpy:1057
translate spanish a1s1_d93bf076:

    # a "\"I do NOT lie...I—I...\""
    a "\"Yo NO miento... yo—yo...\""

# game/a1s1.rpy:1058
translate spanish a1s1_923bd551:

    # "The wolf's righteous indignation seems to deflate."
    "La indignación del lobo, que tan justificada le parecía, parece desinflarse."

# game/a1s1.rpy:1060
translate spanish a1s1_dfdb5c47:

    # a "\"The situation is too complicated for you to understand.\""
    a "\"La situación es demasiado complicada para que puedas entenderla.\""

# game/a1s1.rpy:1061
translate spanish a1s1_af78b41c:

    # "I glare at him."
    "Lo fulmino con la mirada."

# game/a1s1.rpy:1062
translate spanish a1s1_7d7dd8f5:

    # m "\"Who's tied up again?\""
    m "\"Recuérdame, ¿quién está atado?\""

# game/a1s1.rpy:1063
translate spanish a1s1_c0c56b45:

    # "Amicus doesn't take the bait this time and remains slumped."
    "Esta vez Amicus no pica y permanece hundido en su asiento."

# game/a1s1.rpy:1064
translate spanish a1s1_ea48f145:

    # a "\"I guess it doesn't matter now. We're probably going to die out here with how badly the ship is burned.\""
    a "\"Supongo que ya da igual. Probablemente moriremos aquí fuera, de lo quemada que ha quedado la nave.\""

# game/a1s1.rpy:1065
translate spanish a1s1_96350b7d:

    # "That makes my stomach twist a bit."
    "Eso me encoge un poco el estómago."

# game/a1s1.rpy:1066
translate spanish a1s1_d945d777:

    # "I want to ask him if he's just moping or if he actually thinks we're going to die."
    "Quiero preguntarle si solo está lamentándose o si de verdad cree que vamos a morir."

# game/a1s1.rpy:1067
translate spanish a1s1_2c49dbb6:

    # "But another long moment of silence stretches between us."
    "Pero entre nosotros se prolonga otro largo silencio."

# game/a1s1.rpy:1068
translate spanish a1s1_e1ab004f:

    # "I look out the window again, at the towering clouds of dust in front of us."
    "Vuelvo a mirar por la ventana las enormes nubes de polvo que se alzan ante nosotros."

# game/a1s1.rpy:1069
translate spanish a1s1_6ad35356:

    # m "\"Well...if that's the case, then can you just tell me what's going on?\""
    m "\"Bueno... si es así, ¿puedes al menos decirme qué está pasando?\""

# game/a1s1.rpy:1070
translate spanish a1s1_b378ae4f:

    # "Amicus goes on staring out his window."
    "Amicus sigue mirando por su ventana."

# game/a1s1.rpy:1071
translate spanish a1s1_f10d1e85:

    # "I sigh and lean back, resigned to the idea that I might not ever know why I was dragged out to space to simply get stuck and die in a dust cloud."
    "Suspiro y me recuesto, resignado a que quizá nunca sepa por qué me arrastraron al espacio solo para quedar atrapado y morir en una nube de polvo."

# game/a1s1.rpy:1072
translate spanish a1s1_fa931998:

    # "Then Amicus speaks."
    "Entonces Amicus habla."

# game/a1s1.rpy:1074
translate spanish a1s1_a33e8585:

    # a "\"I...made some mistakes.\""
    a "\"Yo... he cometido algunos errores.\""

# game/a1s1.rpy:1075
translate spanish a1s1_3819ac9d:

    # "I glance at him, waiting, not wanting to say anything in case he stops talking."
    "Lo miro de reojo y espero, sin querer decir nada por si deja de hablar."

# game/a1s1.rpy:1076
translate spanish a1s1_fb06a620:

    # a "\"I didn't know your species wasn't part of the {i}Galaxias{/i}. It's...very illegal to make First Contact without authorization from a parent.\""
    a "\"No sabía que tu especie no formaba parte de {i}Galaxias{/i}. Establecer el Primer Contacto sin la autorización de un Padre... es una infracción muy grave.\""

# game/a1s1.rpy:1077
translate spanish a1s1_c3385ac4:

    # m "\"Parent?\""
    m "\"¿Un Padre?\""

# game/a1s1.rpy:1078
translate spanish a1s1_bb90bd34:

    # a "\"The authorities of the galaxy.\""
    a "\"Las autoridades de la galaxia.\""

# game/a1s1.rpy:1079
translate spanish a1s1_ff1a0c0a:

    # "I frown and Amicus looks at the confusion on my face."
    "Frunzo el ceño y Amicus observa la confusión de mi rostro."

# game/a1s1.rpy:1080
translate spanish a1s1_e7759761:

    # a "\"How can I put this simply...\""
    a "\"Cómo puedo explicarlo de forma sencilla...\""

# game/a1s1.rpy:1081
translate spanish a1s1_a366f2f7:

    # a "\"There are three levels in the {i}Galaxias{/i}. At the very top are the parents. They arrived from beyond our galaxy to spread their culture here.\""
    a "\"Hay tres niveles en {i}Galaxias{/i}. En lo más alto están los Padres. Llegaron de más allá de nuestra galaxia para extender aquí su cultura.\""

# game/a1s1.rpy:1082
translate spanish a1s1_4ad4d594:

    # "Amicus glances at me."
    "Amicus me mira de reojo."

# game/a1s1.rpy:1083
translate spanish a1s1_4039690e:

    # a "\"You know what a galaxy is, that there are others outside of our own?\""
    a "\"¿Sabes qué es una galaxia y que hay otras fuera de la nuestra?\""

# game/a1s1.rpy:1084
translate spanish a1s1_c806ebc0:

    # m "\"Yeah.\""
    m "\"Sí.\""

# game/a1s1.rpy:1086
translate spanish a1s1_670bed70:

    # "Amicus lets out a breathy chuckle."
    "Amicus suelta una risita entrecortada."

# game/a1s1.rpy:1087
translate spanish a1s1_55d88b3e:

    # a "\"Of course, I probably should have expected that. So you must know then that intergalactic travel is incredibly advanced, almost god-like and that's what they are—\""
    a "\"Claro, probablemente debería haberlo esperado. Entonces debes saber que viajar entre galaxias requiere una tecnología increíblemente avanzada, casi divina, y eso es lo que son ellos—\""

# game/a1s1.rpy:1088
translate spanish a1s1_c594d0e2:

    # a "\"—Gods. There are eight of them that are still present in our Galaxy, though they rarely communicate with us these days\""
    a "\"—Dioses. Ocho de ellos siguen presentes en nuestra galaxia, aunque hoy en día rara vez se comunican con nosotros.\""

# game/a1s1.rpy:1089
translate spanish a1s1_8f680690:

    # a "\"Then there are the siblings. That's what my species is a part of. The galaxy was scoped out by the parents at the very start to find the most intelligent and capable species.\""
    a "\"Después están los Hermanos. A ese grupo pertenece mi especie. Desde el principio, los Padres exploraron la galaxia para encontrar las especies más inteligentes y capaces.\""

# game/a1s1.rpy:1090
translate spanish a1s1_61dfd3ff:

    # a "\"They each selected one, and we were the ones chosen and uplifted by the Romanus.\""
    a "\"Cada uno eligió una, y nosotros fuimos los elegidos y elevados por los Romanus.\""

# game/a1s1.rpy:1091
translate spanish a1s1_c619cdb1:

    # "The note of pride in Amicus's voice is obvious."
    "El orgullo que hay en la voz de Amicus resulta evidente."

# game/a1s1.rpy:1092
translate spanish a1s1_635ad1d4:

    # a "\"From then on it has been our mission to increase intelligence in promising species and to teach them our philosophy and culture, to uplift.\""
    a "\"Desde entonces, nuestra misión ha sido aumentar la inteligencia de las especies prometedoras y enseñarles nuestra filosofía y nuestra cultura: elevarlas.\""

# game/a1s1.rpy:1093
translate spanish a1s1_27e1df5d:

    # "I try to make sense of that in terms I can understand."
    "Intento darle sentido en términos que pueda entender."

# game/a1s1.rpy:1094
translate spanish a1s1_f7cd4eb2:

    # m "\"So you spread their culture for the parents? They're like your God and your species are like missionaries?\""
    m "\"¿Entonces difundís su cultura por los Padres? ¿Son como vuestro dios y vuestra especie es como un grupo de misioneros?\""

# game/a1s1.rpy:1095
translate spanish a1s1_f887bb98:

    # "Amicus shrugs."
    "Amicus se encoge de hombros."

# game/a1s1.rpy:1096
translate spanish a1s1_ed35e5da:

    # a "\"Yeah, sort of like that.\""
    a "\"Sí, más o menos.\""

# game/a1s1.rpy:1097
translate spanish a1s1_5e7f358c:

    # "That doesn't sound so great, especially when I compare it to things that have happened on Earth."
    "Eso no suena muy bien, sobre todo cuando lo comparo con lo que ha ocurrido en la Tierra."

# game/a1s1.rpy:1098
translate spanish a1s1_e1a51d7b:

    # "Mass galactic assimilation..."
    "Asimilación galáctica masiva..."

# game/a1s1.rpy:1099
translate spanish a1s1_f28e91c5:

    # m "\"So...why are they doing this? If they got here at the same time and did the same thing, does that mean they're working together—\""
    m "\"Entonces... ¿por qué hacen esto? Si llegaron aquí al mismo tiempo e hicieron lo mismo, ¿significa que trabajan juntos—\""

# game/a1s1.rpy:1100
translate spanish a1s1_3122b23f:

    # "Amicus shakes his head."
    "Amicus niega con la cabeza."

# game/a1s1.rpy:1101
translate spanish a1s1_9247501e:

    # a "\"We don't really know all of the reasons for what the parents do, but we compete with the other siblings.\""
    a "\"En realidad, no conocemos todos los motivos de lo que hacen los Padres, pero competimos con los otros Hermanos.\""

# game/a1s1.rpy:1102
translate spanish a1s1_8a3b9f50:

    # a "\"But that brings me to the rest of the Sapients in the galaxy; the children. The siblings uplift these children and bring them into our fold under the direction of our parents.\""
    a "\"Pero eso me lleva al resto de los Sapientes de la galaxia: los Hijos. Los Hermanos elevan a esos Hijos y los incorporan a nuestra comunidad bajo la dirección de nuestros Padres.\""

# game/a1s1.rpy:1103
translate spanish a1s1_13387842:

    # a "\"Again, they haven't told us exactly what's going on, but we came to the conclusion that it's some sort of competition, and we mean to win for our parents.\""
    a "\"Repito: no nos han dicho exactamente qué está pasando, pero hemos llegado a la conclusión de que es una especie de competición y pretendemos ganarla por nuestros Padres.\""

# game/a1s1.rpy:1104
translate spanish a1s1_9ac126e6:

    # m "\"So, I'm a...child?\""
    m "\"Entonces, ¿yo soy un... Hijo?\""

# game/a1s1.rpy:1106
translate spanish a1s1_52720943:

    # a "\"Well...no, not really. I've been calling you that, but you're not part of the {i}Galaxias{/i}, and that's where I've made my mistake.\""
    a "\"Bueno... no, en realidad no. Te he estado llamando así, pero no formas parte de {i}Galaxias{/i}, y ahí es donde he cometido el error.\""

# game/a1s1.rpy:1108
translate spanish a1s1_57a4b39c:

    # a "\"Like I said, it was illegal for me to contact you, but I didn't know.\""
    a "\"Como he dicho, era ilegal que contactara contigo, pero no lo sabía.\""

# game/a1s1.rpy:1109
translate spanish a1s1_13508b9d:

    # m "\"How did you not know that? Shouldn't you have a...record of this type of stuff?\""
    m "\"¿Cómo podías no saberlo? ¿No deberíais tener un... registro de estas cosas?\""

# game/a1s1.rpy:1110
translate spanish a1s1_39c46f91:

    # a "\"That's the confusing part to me. I found Earth in the Library, so there was a record of it, but there wasn't much. Just a few footnotes about a sapient species there.\""
    a "\"Eso es lo que me confunde. Encontré la Tierra en la Biblioteca, así que había un registro, pero apenas contenía nada. Solo unas pocas notas sobre una especie sapiente que vivía allí.\""

# game/a1s1.rpy:1111
translate spanish a1s1_6ff16e36:

    # a "\"But because that record exists, I know that your species was uplifted to child status at some point.\""
    a "\"Pero, como ese registro existe, sé que vuestra especie fue elevada en algún momento a la condición de Hijos.\""

# game/a1s1.rpy:1112
translate spanish a1s1_75c6be41:

    # m "\"In Rome?\""
    m "\"¿En Roma?\""

# game/a1s1.rpy:1113
translate spanish a1s1_7072f7b6:

    # a "\"Presumably, but sometimes the species is unable to be uplifted for different reasons; too aggressive, too docile, too unintelligent.\""
    a "\"Presumiblemente, pero a veces una especie no puede ser elevada por distintos motivos: es demasiado agresiva, demasiado dócil o demasiado poco inteligente.\""

# game/a1s1.rpy:1114
translate spanish a1s1_4ad4d594_1:

    # "Amicus glances at me."
    "Amicus me mira de reojo."

# game/a1s1.rpy:1115
translate spanish a1s1_c5c3332b:

    # a "\"I thought this is what happened to your species.\""
    a "\"Creía que eso era lo que le había ocurrido a tu especie.\""

# game/a1s1.rpy:1116
translate spanish a1s1_0be68fb6:

    # m "\"Then if we've been uplifted doesn't that mean that you've already made First Contact?\""
    m "\"Entonces, si ya hemos sido elevados, ¿no significa eso que ya habíais establecido el Primer Contacto?\""

# game/a1s1.rpy:1117
translate spanish a1s1_9a0ba985:

    # a "\"Yes, but you're still not part of the Galaxias. That's why I made the mistake. You {i}should{/i} know about it, but you don't. Knowledge of other intelligent life is sacred and for whatever reason your species lost it.\""
    a "\"Sí, pero seguís sin formar parte de Galaxias. Por eso cometí el error. {i}Deberías{/i} conocerla, pero no es así. El conocimiento de otras formas de vida inteligente es sagrado y, por algún motivo, vuestra especie lo perdió.\""

# game/a1s1.rpy:1118
translate spanish a1s1_222f62dc:

    # a "\"So it doesn't matter that we've made contact before; if the knowledge of the {i}Galaxias{/i} has been lost, then any form of communication between us is First Contact all over again.\""
    a "\"Así que no importa que ya hubiéramos contactado antes: si se ha perdido el conocimiento de {i}Galaxias{/i}, cualquier forma de comunicación entre nosotros vuelve a ser un Primer Contacto.\""

# game/a1s1.rpy:1119
translate spanish a1s1_392197d0:

    # a "\"And while uplift has been canceled with species in the past, we don't completely cut off contact; they're permanently part of the {i}Galaxias{/i}. I've never heard of something like this happening before, so I panicked. Com—\""
    a "\"Y, aunque en el pasado se ha cancelado la elevación de algunas especies, no cortamos por completo el contacto: forman parte de {i}Galaxias{/i} de manera permanente. Nunca había oído que ocurriera algo así, de modo que entré en pánico. Com—\""

# game/a1s1.rpy:1120
translate spanish a1s1_fb1be156:

    # "Amicus glances at the ceiling."
    "Amicus mira hacia el techo."

# game/a1s1.rpy:1121
translate spanish a1s1_82350eb8:

    # a "\"—wasn't able to tell me that until he connected to your Nexus.\""
    a "\"—no pudo decírmelo hasta que se conectó a vuestro Nexus.\""

# game/a1s1.rpy:1122
translate spanish a1s1_6d4e410e:

    # m "\"Nexus?\""
    m "\"¿Nexus?\""

# game/a1s1.rpy:1123
translate spanish a1s1_e6d6088e:

    # "Another word that doesn't translate."
    "Otra palabra que no se traduce."

# game/a1s1.rpy:1124
translate spanish a1s1_48340125:

    # a "\"Like, the technology that connects places, people, information—\""
    a "\"Como la tecnología que conecta lugares, personas, información—\""

# game/a1s1.rpy:1125
translate spanish a1s1_626d9018:

    # m "\"The internet?\""
    m "\"¿Internet?\""

# game/a1s1.rpy:1126
translate spanish a1s1_7d75dc6c:

    # a "\"If that's your word for it.\""
    a "\"Si así es como lo llamáis.\""

# game/a1s1.rpy:1127
translate spanish a1s1_fd7e81eb:

    # m "\"So...\""
    m "\"Entonces...\""

# game/a1s1.rpy:1128
translate spanish a1s1_98b63e80:

    # "I try to understand everything I'm being told."
    "Intento comprender todo lo que me está diciendo."

# game/a1s1.rpy:1129
translate spanish a1s1_38d8cc39:

    # m "\"Why didn't you just tell me all of this before you kidnapped me...or knocked me out.\""
    m "\"¿Por qué no me dijiste todo esto antes de secuestrarme... o dejarme inconsciente?\""

# game/a1s1.rpy:1130
translate spanish a1s1_1d3dd843:

    # "I see Amicus's ears flatten and he looks away, clearly ashamed."
    "Veo que Amicus aplana las orejas y aparta la vista, claramente avergonzado."

# game/a1s1.rpy:1131
translate spanish a1s1_846465a3:

    # a "\"I don't know. I didn't fully understand the intelligence of your species yet. I thought I could just...lead you to believe things.\""
    a "\"No lo sé. Aún no comprendía del todo la inteligencia de tu especie. Creía que podía simplemente... hacerte creer ciertas cosas.\""

# game/a1s1.rpy:1132
translate spanish a1s1_0180610d:

    # "I don't say anything and Amicus shifts uncomfortably."
    "No digo nada y Amicus se remueve incómodo."

# game/a1s1.rpy:1133
translate spanish a1s1_6b053d84:

    # a "\"Leaving you on Earth after you saw me...you might have gone to the authorities on your planet with that knowledge which might have lead to a Monitor being alerted.\""
    a "\"Si te hubiera dejado en la Tierra después de que me vieras... podrías haber llevado esa información a las autoridades de tu planeta, y eso podría haber alertado a un Monitor.\""

# game/a1s1.rpy:1134
translate spanish a1s1_e27fdc8d:

    # "Amicus answers my question before I can ask it."
    "Amicus responde a mi pregunta antes de que pueda hacerla."

# game/a1s1.rpy:1135
translate spanish a1s1_daea3945:

    # a "\"Monitors are basically the ears and eyes of the parents. They monitor the galaxy.\""
    a "\"Los Monitores son, básicamente, los ojos y los oídos de los Padres. Vigilan la galaxia.\""

# game/a1s1.rpy:1136
translate spanish a1s1_dfb54641:

    # m "\"And what happens if they're alerted?\""
    m "\"¿Y qué pasa si los alertan?\""

# game/a1s1.rpy:1137
translate spanish a1s1_6d85daed:

    # "Amicus sighs deeply."
    "Amicus suspira profundamente."

# game/a1s1.rpy:1138
translate spanish a1s1_02271e86:

    # a "\"I don't know. It hasn't happened in a long time and I don't think anyone has ever broken this particular law. It's one of the most important laws we're supposed to follow. Knowing I'd broken it...\""
    a "\"No lo sé. Hace mucho que no ocurre y no creo que nadie haya infringido jamás esta ley en concreto. Es una de las leyes más importantes que debemos respetar. Saber que la había infringido...\""

# game/a1s1.rpy:1139
translate spanish a1s1_54bca475_1:

    # "Amicus pauses."
    "Amicus hace una pausa."

# game/a1s1.rpy:1140
translate spanish a1s1_f8f87ce5:

    # m "\"Scared you?\""
    m "\"¿Te asustó?\""

# game/a1s1.rpy:1141
translate spanish a1s1_8f726726:

    # "Amicus shakes his head but doesn't say anything."
    "Amicus niega con la cabeza, pero no dice nada."

# game/a1s1.rpy:1142
translate spanish a1s1_fedb4933:

    # "I try to piece all of this together in my head."
    "Intento encajar todo esto en mi cabeza."

# game/a1s1.rpy:1143
translate spanish a1s1_dec48a5e:

    # m "\"So then you panicked and kidnapped me?\""
    m "\"¿Entonces entraste en pánico y me secuestraste?\""

# game/a1s1.rpy:1144
translate spanish a1s1_ca821773:

    # a "\"It was either that or kill you...or leave you and hope for the best, but that was a risk that I felt I couldn't take at the time.\""
    a "\"Era eso o matarte... o dejarte allí y esperar que todo saliera bien, pero era un riesgo que en aquel momento sentía que no podía asumir.\""

# game/a1s1.rpy:1145
translate spanish a1s1_1c4605d3:

    # "Amicus seems to shrink in his seat."
    "Amicus parece encogerse en su asiento."

# game/a1s1.rpy:1146
translate spanish a1s1_d53ef6e5:

    # a "\"And I guess I just didn't want to tell you because I knew I'd disrupted your life in a terrible way...I thought I might be able to make you forget and want to stay with me if you saw my home.\""
    a "\"Y supongo que no quería decírtelo porque sabía que había trastornado tu vida de una forma horrible... Creía que, si veías mi hogar, quizá podría hacer que lo olvidaras y quisieras quedarte conmigo.\""

# game/a1s1.rpy:1147
translate spanish a1s1_a5b92aaa:

    # m "\"But why? Why did you do it in the first place? What do you want from me?\""
    m "\"¿Pero por qué? ¿Por qué lo hiciste para empezar? ¿Qué quieres de mí?\""

# game/a1s1.rpy:1148
translate spanish a1s1_a5ebcc0b:

    # "Amicus looks at me for a long while, probably debating on how much to tell me, then he turns away."
    "Amicus me mira durante un largo rato, probablemente decidiendo cuánto contarme, y luego aparta la vista."

# game/a1s1.rpy:1149
translate spanish a1s1_ca8be25f:

    # a "\"I needed a pet.\""
    a "\"Necesitaba una mascota.\""

# game/a1s1.rpy:1150
translate spanish a1s1_61d5f247:

    # m "\"Excuse me?\""
    m "\"¿Perdona?\""

# game/a1s1.rpy:1151
translate spanish a1s1_e9a7f917:

    # "Amicus shrinks up even more in his chair."
    "Amicus se encoge aún más en su asiento."

# game/a1s1.rpy:1152
translate spanish a1s1_d6e9d058:

    # a "\"It's a very long story.\""
    a "\"Es una historia muy larga.\""

# game/a1s1.rpy:1153
translate spanish a1s1_57c93327:

    # "I glare at the back of his head."
    "Miro con rabia la parte de atrás de su cabeza."

# game/a1s1.rpy:1154
translate spanish a1s1_1fba1f80:

    # m "\"Well, if we're going to be here a while then I have time.\""
    m "\"Bueno, si vamos a estar aquí un tiempo, tengo tiempo de sobra.\""

# game/a1s1.rpy:1155
translate spanish a1s1_59e1c99b:

    # "Amicus goes on staring out the window."
    "Amicus sigue mirando por la ventana."

# game/a1s1.rpy:1156
translate spanish a1s1_301e94d3:

    # a "\"My father was the emperor. The throne was mine to take, but my brother has challenged me, so now we're both competing for it.\""
    a "\"Mi padre era el emperador. El trono me correspondía a mí, pero mi hermano me ha disputado el derecho, así que ahora ambos competimos por él.\""

# game/a1s1.rpy:1157
translate spanish a1s1_5295c07b:

    # "Amicus looks at me out of the corner of his eye for my reaction."
    "Amicus me mira de reojo para ver mi reacción."

# game/a1s1.rpy:1158
translate spanish a1s1_a5e86746:

    # "His expression tells me I should be impressed, but learning he might be an influential figure among his people doesn't really seem too crazy after the events of the past day or so."
    "Su expresión me dice que debería impresionarme, pero saber que podría ser una figura influyente entre los suyos no parece tan disparatado después de lo ocurrido durante el último día, más o menos."

# game/a1s1.rpy:1159
translate spanish a1s1_b7fd9907:

    # m "\"And getting a 'pet' will help you how?\""
    m "\"¿Y cómo te ayudará conseguir una 'mascota'?\""

# game/a1s1.rpy:1160
translate spanish a1s1_b902c878:

    # a "\"My brother has one...a sibling species, which means that his pet is on the same level of the hierarchy as us.\""
    a "\"Mi hermano tiene una... de una especie Hermana, lo que significa que su mascota está al mismo nivel de la jerarquía que nosotros.\""

# game/a1s1.rpy:1161
translate spanish a1s1_e499761a:

    # "I frown."
    "Frunzo el ceño."

# game/a1s1.rpy:1162
translate spanish a1s1_5e66bbc7:

    # m "\"Oh? And that's unusual?\""
    m "\"¿Ah, sí? ¿Y eso es poco habitual?\""

# game/a1s1.rpy:1163
translate spanish a1s1_c02d8683:

    # a "\"Definitely. It shouldn't even be legal, but somehow he {i}negotiated{/i} it. They signed a contract and everything.\""
    a "\"Desde luego. Ni siquiera debería ser legal, pero de algún modo lo {i}negoció{/i}. Firmaron un contrato y todo.\""

# game/a1s1.rpy:1164
translate spanish a1s1_6a20a80d:

    # "I shake my head."
    "Niego con la cabeza."

# game/a1s1.rpy:1165
translate spanish a1s1_f5cfbdcd:

    # m "\"So what does having a pet do?\""
    m "\"Entonces, ¿de qué sirve tener una mascota?\""

# game/a1s1.rpy:1166
translate spanish a1s1_f887bb98_1:

    # "Amicus shrugs."
    "Amicus se encoge de hombros."

# game/a1s1.rpy:1167
translate spanish a1s1_df4a18ee:

    # a "\"It's a good status symbol to have. The fact that my brother was able to obtain such a prestigious pet shows his skill at negotiation and has put me at a huge disadvantage.\""
    a "\"Es un buen símbolo de estatus. Que mi hermano haya podido conseguir una mascota tan prestigiosa demuestra su habilidad para negociar y me ha dejado en enorme desventaja.\""

# game/a1s1.rpy:1168
translate spanish a1s1_24a774ec:

    # a "\"I needed to do something even more grand to impress my father's advisor. He's the one that will choose between us.\""
    a "\"Tenía que hacer algo todavía más grandioso para impresionar al consejero de mi padre. Él es quien elegirá entre nosotros.\""

# game/a1s1.rpy:1169
translate spanish a1s1_669cc616:

    # m "\"By kidnapping me?\""
    m "\"¿Secuestrándome?\""

# game/a1s1.rpy:1170
translate spanish a1s1_2df92d67:

    # "Amicus growls."
    "Amicus gruñe."

# game/a1s1.rpy:1171
translate spanish a1s1_a77916e8:

    # a "\"That wasn't part of the plan. I thought you'd know what I was and be amazed that a Wolf had come back to your species.\""
    a "\"Eso no formaba parte del plan. Creía que sabrías lo que era y te asombraría que un Lobo hubiera regresado a tu especie.\""

# game/a1s1.rpy:1172
translate spanish a1s1_dd423124:

    # a "\"I was going to make a deal with you, like my brother did with his pet. I wanted a sapient that no one had seen in a long time.\""
    a "\"Iba a hacer un trato contigo, como hizo mi hermano con su mascota. Quería un Sapiente que nadie hubiera visto desde hacía mucho tiempo.\""

# game/a1s1.rpy:1177
translate spanish a1s1_f0acabc1:

    # "So that's why I'm here; to be used as some pawn in some power struggle in some alien empire far away?"
    "¿Así que por eso estoy aquí: para servir de peón en una lucha de poder de algún imperio alienígena lejano?"

# game/a1s1.rpy:1178
translate spanish a1s1_f5aa93b2:

    # m "\"So why can't you take me back? What if I promise not to say anything?\""
    m "\"¿Entonces por qué no puedes llevarme de vuelta? ¿Y si prometo no decir nada?\""

# game/a1s1.rpy:1179
translate spanish a1s1_875dd49e:

    # a "\"I...would take you back if I could. I realize now that that would have been the better option, but I can't.\""
    a "\"Yo... te llevaría de vuelta si pudiera. Ahora comprendo que habría sido la mejor opción, pero no puedo.\""

# game/a1s1.rpy:1180
translate spanish a1s1_2558be92_1:

    # m "\"Why not?\""
    m "\"¿Por qué no?\""

# game/a1s1.rpy:1182
translate spanish a1s1_0fca803d:

    # a "\"First of all, the ship might be damaged beyond repair. Secondly, there isn't enough power to get back. Earth was on the outer reaches of how far I could travel. I need the rest to return home.\""
    a "\"Primero, puede que la nave esté dañada sin posibilidad de reparación. Segundo, no hay energía suficiente para volver. La Tierra estaba casi en el límite de lo lejos que podía viajar. Necesito el resto para regresar a casa.\""

# game/a1s1.rpy:1183
translate spanish a1s1_16c59561:

    # "I manage to stop myself from telling the wolf that all of this is his fault and shouldn't be my problem at all."
    "Consigo contenerme para no decirle al lobo que todo esto es culpa suya y que no debería ser problema mío en absoluto."

# game/a1s1.rpy:1184
translate spanish a1s1_7690c5ed:

    # m "\"Well, can we get more power when we get to your home, then go back to Earth?\""
    m "\"Bueno, ¿podemos conseguir más energía al llegar a tu hogar y después volver a la Tierra?\""

# game/a1s1.rpy:1185
translate spanish a1s1_d90afce6:

    # a "\"No, it's...it's a type of power that the parents produce. We're not able to harness it...yet.\""
    a "\"No, es... es un tipo de energía que producen los Padres. Nosotros no podemos aprovecharla... todavía.\""

# game/a1s1.rpy:1186
translate spanish a1s1_8a740824:

    # m "\"So get more from them, from wherever you got the power in the first place.\""
    m "\"Pues consigue más de ellos, de donde sacaste la energía la primera vez.\""

# game/a1s1.rpy:1188
translate spanish a1s1_07745109:

    # "Amicus leans his head against the headrest."
    "Amicus apoya la cabeza en el reposacabezas."

# game/a1s1.rpy:1189
translate spanish a1s1_c88d4de4:

    # a "\"Our parents authorizes and distributes it, and for whatever reason, they stopped supplying it when we lost our emperor.\""
    a "\"Nuestros Padres autorizan su uso y la distribuyen y, por algún motivo, dejaron de suministrarla cuando perdimos a nuestro emperador.\""

# game/a1s1.rpy:1190
translate spanish a1s1_73e42e69:

    # "I feel myself growing more and more frustrated."
    "Me siento cada vez más frustrado."

# game/a1s1.rpy:1191
translate spanish a1s1_1f0624bf:

    # m "\"Then how the hell are you using it now?\""
    m "\"¿Entonces cómo demonios la estás usando ahora?\""

# game/a1s1.rpy:1192
translate spanish a1s1_f5f4dc21:

    # "A moment of silence goes by."
    "Pasa un momento de silencio."

# game/a1s1.rpy:1193
translate spanish a1s1_19effa26:

    # a "\"This was my father's ship. Only the emperor has constant access to the technology. I...borrowed it to get to you.\""
    a "\"Esta era la nave de mi padre. Solo el emperador tiene acceso permanente a esta tecnología. Yo... la tomé prestada para llegar hasta ti.\""

# game/a1s1.rpy:1194
translate spanish a1s1_af78b41c_1:

    # "I glare at him."
    "Lo fulmino con la mirada."

# game/a1s1.rpy:1195
translate spanish a1s1_75bbb209:

    # m "\"You mean stole it? You know, you're pretty dishonest for someone who says they never lie.\""
    m "\"¿Quieres decir que la robaste? Sabes, eres bastante deshonesto para ser alguien que dice que nunca miente.\""

# game/a1s1.rpy:1197
translate spanish a1s1_c592f25a:

    # "Another soft, rumbling growl from him."
    "Vuelve a soltar un gruñido bajo y profundo."

# game/a1s1.rpy:1198
translate spanish a1s1_0ef784a3:

    # a "\"Times are desperate.\""
    a "\"Son tiempos desesperados.\""

# game/a1s1.rpy:1199
translate spanish a1s1_ae3bea37:

    # m "\"Ask your dad to take me back, then.\""
    m "\"Pues pídele a tu padre que me lleve de vuelta.\""

# game/a1s1.rpy:1200
translate spanish a1s1_c537b6ab:

    # a "\"If you didn't gather from earlier, he's dead. So no one has access to it right now...I'm just using up what was left.\""
    a "\"Por si no lo has deducido antes, ha muerto. Así que ahora nadie tiene acceso a ella... Yo solo estoy gastando lo que quedaba.\""

# game/a1s1.rpy:1201
translate spanish a1s1_81a185a8:

    # "I stare at Amicus for a while, words failing me."
    "Miro a Amicus durante un rato, sin encontrar las palabras."

# game/a1s1.rpy:1202
translate spanish a1s1_7e4cc33e:

    # a "\"Listen, I didn't want to do all those things I did to you. I'm protecting us both.\""
    a "\"Escucha, no quería hacerte todo lo que te hice. Estoy protegiéndonos a los dos.\""

# game/a1s1.rpy:1203
translate spanish a1s1_e33f02ef:

    # "I laugh."
    "Me río."

# game/a1s1.rpy:1204
translate spanish a1s1_de93a4a7:

    # m "\"Oh, really?\""
    m "\"¿Ah, de verdad?\""

# game/a1s1.rpy:1205
translate spanish a1s1_4495ce05:

    # a "\"Yes! I was planning to bring you to the palace to live a good life and forget your old one...then when you started asking those questions I realized your intelligence is much higher than I thought it would be. Then Com thought you might attack me...I made mistakes.\""
    a "\"¡Sí! Pensaba llevarte al palacio para que vivieras bien y olvidaras tu antigua vida... Pero, cuando empezaste a hacer esas preguntas, comprendí que eras mucho más inteligente de lo que había creído. Después Com pensó que quizá fueras a atacarme... Cometí errores.\""

# game/a1s1.rpy:1207
translate spanish a1s1_d1a4dc23:

    # "Amicus lets out another huge sigh and slumps in the seat, looking away."
    "Amicus suelta otro enorme suspiro y se hunde en el asiento, apartando la mirada."

# game/a1s1.rpy:1208
translate spanish a1s1_4222a394:

    # "Several minutes go by in silence, both of us staring out into the eerie blue."
    "Pasan varios minutos en silencio, mientras ambos contemplamos aquel inquietante azul."

# game/a1s1.rpy:1209
translate spanish a1s1_6795a6f1:

    # m "\"So what now? What are your plans?\""
    m "\"¿Y ahora qué? ¿Qué planes tienes?\""

# game/a1s1.rpy:1210
translate spanish a1s1_979ad8ae:

    # "Amicus is the one to laugh this time."
    "Esta vez es Amicus quien se ríe."

# game/a1s1.rpy:1212
translate spanish a1s1_ea8f4e03:

    # a "\"Get out of these bonds, if you'd let me.\""
    a "\"Librarme de estas ataduras, si me dejas.\""

# game/a1s1.rpy:1213
translate spanish a1s1_1e0866bf:

    # "I look at him incredulously."
    "Lo miro incrédulo."

# game/a1s1.rpy:1215
translate spanish a1s1_f334dfb6:

    # "Amicus sighs."
    "Amicus suspira."

# game/a1s1.rpy:1216
translate spanish a1s1_97bb4540:

    # a "\"Listen, you have no idea how to handle this ship. I can at least run diagnostics to see what we can do about this.\""
    a "\"Escucha, no tienes ni idea de cómo manejar esta nave. Yo al menos puedo ejecutar un diagnóstico para ver qué podemos hacer.\""

# game/a1s1.rpy:1217
translate spanish a1s1_f5fc74a4:

    # m "\"What's to stop you from knocking me out again?\""
    m "\"¿Qué te impedirá volver a dejarme inconsciente?\""

# game/a1s1.rpy:1218
translate spanish a1s1_89843a26:

    # a "\"If you don't attack me or hit me with the Nervo again, then I won't have to.\""
    a "\"Si no me atacas ni me das otra descarga con el Nervo, no tendré que hacerlo.\""

# game/a1s1.rpy:1219
translate spanish a1s1_1a929e36:

    # "I look to my left armrest and pick up the little taser device."
    "Miro el reposabrazos izquierdo y recojo la pequeña pistola eléctrica."

# game/a1s1.rpy:1220
translate spanish a1s1_45972660:

    # m "\"This?\""
    m "\"¿Esto?\""

# game/a1s1.rpy:1222
translate spanish a1s1_9ad83078:

    # "Amicus eyes it uneasily."
    "Amicus lo mira con inquietud."

# game/a1s1.rpy:1223
translate spanish a1s1_a61ebafe:

    # a "\"Yeah...\""
    a "\"Sí...\""

# game/a1s1.rpy:1224
translate spanish a1s1_9943ddc6:

    # m "\"How can I trust you after everything that's happened?\""
    m "\"¿Cómo puedo confiar en ti después de todo lo que ha pasado?\""

# game/a1s1.rpy:1225
translate spanish a1s1_4f2092c2:

    # a "\"I give you my word.\""
    a "\"Te doy mi palabra.\""

# game/a1s1.rpy:1226
translate spanish a1s1_e499761a_1:

    # "I frown."
    "Frunzo el ceño."

# game/a1s1.rpy:1227
translate spanish a1s1_d2b6b47a:

    # m "\"And you could go back on it just as easily.\""
    m "\"Y podrías incumplirla con la misma facilidad.\""

# game/a1s1.rpy:1229
translate spanish a1s1_93d01137:

    # a "\"I would never do that! I don't make promises lightly, [mc].\""
    a "\"¡Jamás haría eso! No hago promesas a la ligera, [mc].\""

# game/a1s1.rpy:1230
translate spanish a1s1_215d03c2:

    # "Amicus is so indignant that I actually believe him."
    "Amicus está tan indignado que de verdad le creo."

# game/a1s1.rpy:1231
translate spanish a1s1_29333bbf:

    # "Or he's just a really good actor."
    "O es un actor buenísimo."

# game/a1s1.rpy:1232
translate spanish a1s1_2a6088ff:

    # "Either way, I'm going to have to let him go at some point, especially if we really can't get back to Earth."
    "En cualquier caso, tendré que soltarlo en algún momento, sobre todo si de verdad no podemos volver a la Tierra."

# game/a1s1.rpy:1233
translate spanish a1s1_a4e12baa:

    # "So I make my decision."
    "Así que tomo una decisión."

# game/a1s1.rpy:1234
translate spanish a1s1_a008448f:

    # m "\"If I let you go, you have to find a way to get me back to Earth.\""
    m "\"Si te suelto, tienes que encontrar una manera de llevarme de vuelta a la Tierra.\""

# game/a1s1.rpy:1236
translate spanish a1s1_fb81144d:

    # "Amicus thinks for a moment."
    "Amicus piensa un momento."

# game/a1s1.rpy:1237
translate spanish a1s1_2c36f1a9:

    # a "\"I can do that if I become emperor.\""
    a "\"Podré hacerlo si me convierto en emperador.\""

# game/a1s1.rpy:1238
translate spanish a1s1_0d4dae44:

    # m "\"And how long will that take?\""
    m "\"¿Y cuánto tiempo llevará eso?\""

# game/a1s1.rpy:1239
translate spanish a1s1_f887bb98_2:

    # "Amicus shrugs."
    "Amicus se encoge de hombros."

# game/a1s1.rpy:1240
translate spanish a1s1_51161834:

    # a "\"A few months if all goes well. With your help it could be even faster. You're...very clever. More intelligent than some wolves I know, even.\""
    a "\"Unos pocos meses si todo va bien. Con tu ayuda podría ser incluso más rápido. Eres... muy listo. Hasta más inteligente que algunos lobos que conozco.\""

# game/a1s1.rpy:1241
translate spanish a1s1_be8a4a84:

    # m "\"Months? My parents are probably freaking out by now...school starts in a few weeks!\""
    m "\"¿Meses? Mis padres probablemente ya estén perdiendo la cabeza... ¡Las clases empiezan dentro de unas semanas!\""

# game/a1s1.rpy:1242
translate spanish a1s1_bc78ac5f:

    # "All of these things seem so distant now."
    "Todas esas cosas parecen ahora tan lejanas."

# game/a1s1.rpy:1243
translate spanish a1s1_e0a11c00:

    # "Amicus frowns."
    "Amicus frunce el ceño."

# game/a1s1.rpy:1244
translate spanish a1s1_afb8ae99:

    # a "\"I'm sorry, but I can't do anything. I need to be an emperor to even talk to the parents.\""
    a "\"Lo siento, pero no puedo hacer nada. Tengo que ser emperador incluso para hablar con los Padres.\""

# game/a1s1.rpy:1245
translate spanish a1s1_4b66f979:

    # "I think, but again I don't have many options."
    "Lo pienso, pero, de nuevo, no tengo muchas opciones."

# game/a1s1.rpy:1246
translate spanish a1s1_45748d7b:

    # "I look Amicus in the eye."
    "Miro a Amicus a los ojos."

# game/a1s1.rpy:1247
translate spanish a1s1_1ff0bd1f:

    # m "\"You promise?\""
    m "\"¿Lo prometes?\""

# game/a1s1.rpy:1249
translate spanish a1s1_13415661:

    # a "\"You have my word.\""
    a "\"Tienes mi palabra.\""

# game/a1s1.rpy:1250
translate spanish a1s1_304d84c2:

    # "For a moment I sit there, contemplating."
    "Me quedo sentado un momento, reflexionando."

# game/a1s1.rpy:1251
translate spanish a1s1_b4225f49:

    # "Then I sit up straight."
    "Entonces me incorporo en el asiento."

# game/a1s1.rpy:1252
translate spanish a1s1_67ff07f9:

    # m "\"Alright, stand up.\""
    m "\"Muy bien, levántate.\""

# game/a1s1.rpy:1254
translate spanish a1s1_47563fc0:

    # "Amicus perks up then hops to his bound feet, almost falling over."
    "Amicus se anima y se levanta de un salto sobre los pies atados, casi cayéndose."

# game/a1s1.rpy:1256
translate spanish a1s1_a4ac641e:

    # "I'm sure to place the Nervo close by behind me, just in case."
    "Me aseguro de dejar el Nervo cerca, detrás de mí, por si acaso."

# game/a1s1.rpy:1257
translate spanish a1s1_313097f8:

    # "A few minutes later and the wolf is free."
    "Unos minutos después, el lobo está libre."

# game/a1s1.rpy:1259
translate spanish a1s1_3a039d30:

    # "We both regard each other wearily for a few moments before Amicus finally sighs."
    "Nos miramos cansados durante unos momentos antes de que Amicus suspire por fin."

# game/a1s1.rpy:1260
translate spanish a1s1_c2ca825f:

    # a "\"Listen, I have no reason to...incapacitate you now that you know everything, but if it makes you feel better you can hang on to the Nervo until we get to Adastra.\""
    a "\"Escucha, ahora que lo sabes todo no tengo ningún motivo para... incapacitarte, pero, si así te sientes mejor, puedes quedarte con el Nervo hasta que lleguemos a Adastra.\""

# game/a1s1.rpy:1261
translate spanish a1s1_0b848ce8:

    # a "\"That a fair exchange?\""
    a "\"¿Te parece un trato justo?\""

# game/a1s1.rpy:1262
translate spanish a1s1_37a44bcc:

    # "I look back at the little device."
    "Miro hacia atrás, al pequeño aparato."

# game/a1s1.rpy:1263
translate spanish a1s1_28e9eca7:

    # "While I have little reason to trust Amicus, the wolf has virtually no reason to trust me."
    "Aunque tengo pocos motivos para confiar en Amicus, el lobo prácticamente no tiene ninguno para confiar en mí."

# game/a1s1.rpy:1264
translate spanish a1s1_e98ea258:

    # "I consider it, then shake my head."
    "Me lo pienso y luego niego con la cabeza."

# game/a1s1.rpy:1265
translate spanish a1s1_ac33b6fb:

    # m "\"Can we put it away somewhere? I'd rather just not be thinking about it.\""
    m "\"¿Podemos guardarlo en algún sitio? Preferiría dejar de pensar en ello.\""

# game/a1s1.rpy:1267
translate spanish a1s1_ef689f1d:

    # "Amicus looks at me in surprise, then rubs his stomach where I jabbed him."
    "Amicus me mira sorprendido y luego se frota el abdomen donde le di la descarga."

# game/a1s1.rpy:1268
translate spanish a1s1_d5f0f775:

    # a "\"Okay, yeah, that sounds like a deal to me.\""
    a "\"Vale, sí, me parece un buen trato.\""

# game/a1s1.rpy:1270
translate spanish a1s1_35dd5f05:

    # "Amicus holds out a paw and I look down at the thick, black pads on his fingers and palm before picking up the Nervo and handing it to him carefully."
    "Amicus extiende una mano y miro las gruesas almohadillas negras de sus dedos y su palma antes de recoger el Nervo y entregárselo con cuidado."

# game/a1s1.rpy:1271
translate spanish a1s1_ad1f344e:

    # "For a moment I imagine him immediately turning the thing around and jabbing it into my face, but instead he turns and walks toward the back of the ship."
    "Por un momento me lo imagino girando el aparato de inmediato y estampándomelo en la cara, pero, en vez de eso, se da la vuelta y camina hacia la parte trasera de la nave."

# game/a1s1.rpy:1273
translate spanish a1s1_79ff2228:

    # "I notice his stance is slightly bow-legged and he adjusts himself a few times."
    "Noto que camina con las piernas un poco arqueadas y se recoloca unas cuantas veces."

# game/a1s1.rpy:1274
translate spanish a1s1_6f4c20bc:

    # "That makes me feel a little guilty about fighting dirty earlier."
    "Eso me hace sentir un poco culpable por haber jugado sucio al pelear antes."

# game/a1s1.rpy:1275
translate spanish a1s1_e73c6f47:

    # "But only a little."
    "Pero solo un poco."

# game/a1s1.rpy:1276
translate spanish a1s1_1af4d09d:

    # "On his way he sweeps up his cape in one fluid motion before wrapping it around his shoulders."
    "De camino, recoge la capa con un movimiento fluido y se la coloca alrededor de los hombros."

# game/a1s1.rpy:1277
translate spanish a1s1_a1095ca6:

    # "Then he moves to the back wall and, sticking out a paw, he presses a panel and a small portion of the wall slides back, revealing another smaller room."
    "Luego se acerca a la pared del fondo y, extendiendo una mano, pulsa un panel; una pequeña parte de la pared se desliza hacia atrás y deja al descubierto otra habitación más pequeña."

# game/a1s1.rpy:1278
translate spanish a1s1_fcb0a8e0:

    # "From where I am I can see what looks like a little cot and various cupboards."
    "Desde donde estoy puedo ver lo que parece un pequeño catre y varios armarios."

# game/a1s1.rpy:1279
translate spanish a1s1_a1e911d8:

    # "He opens one of these and places the Nervo inside before shutting it."
    "Abre uno de ellos, guarda el Nervo dentro y vuelve a cerrarlo."

# game/a1s1.rpy:1280
translate spanish a1s1_65cf3021:

    # "He comes back out and notices me staring."
    "Vuelve a salir y se da cuenta de que lo estoy mirando."

# game/a1s1.rpy:1282
translate spanish a1s1_2e46bd5c:

    # a "\"That's my quarters. It's where I sleep. If you, uh, need to urinate or...whatever else you do, there's a toilet in there.\""
    a "\"Ese es mi camarote. Allí duermo. Si, eh, necesitas orinar o... lo que sea que hagáis, hay un retrete ahí dentro.\""

# game/a1s1.rpy:1283
translate spanish a1s1_03425764:

    # m "\"I'm fine for now...\""
    m "\"Por ahora estoy bien...\""

# game/a1s1.rpy:1284
translate spanish a1s1_11010a2b:

    # "I feel my stomach gurgle, something that it's been doing for a while now."
    "Noto que me ruge el estómago, algo que lleva haciendo desde hace un rato."

# game/a1s1.rpy:1285
translate spanish a1s1_36782e7c:

    # m "\"I am a little hungry, though.\""
    m "\"Aunque sí tengo un poco de hambre.\""

# game/a1s1.rpy:1286
translate spanish a1s1_8e4c05e6:

    # "Amicus raises a brow."
    "Amicus alza una ceja."

# game/a1s1.rpy:1287
translate spanish a1s1_74984fcc:

    # a "\"You want to try it again?\""
    a "\"¿Quieres volver a probarlo?\""

# game/a1s1.rpy:1288
translate spanish a1s1_7b7bde3d:

    # m "\"...Sure.\""
    m "\"...Claro.\""

# game/a1s1.rpy:1292
translate spanish a1s1_f38a0a8d:

    # "It's not the worst food I've ever had."
    "No es la peor comida que he probado nunca."

# game/a1s1.rpy:1293
translate spanish a1s1_e5c20a63:

    # "The earthy smell translates into the taste, but there's a strange hint of sweetness to it, like chocolate and that makes it a little more palatable."
    "El olor a tierra también se nota en el sabor, pero tiene un extraño toque dulce, como de chocolate, que lo hace algo más agradable."

# game/a1s1.rpy:1294
translate spanish a1s1_c2da015e:

    # "I can at least swallow it down without gagging, so that's good, I guess."
    "Al menos puedo tragarlo sin tener arcadas, así que supongo que eso está bien."

# game/a1s1.rpy:1295
translate spanish a1s1_88cf08df:

    # "Amicus has his own cup, though he's paying more attention to the panels than to his food."
    "Amicus tiene su propio vaso, aunque presta más atención a los paneles que a la comida."

# game/a1s1.rpy:1297
translate spanish a1s1_786145ac:

    # a "\"I may have been exaggerating a bit earlier. Damage appears to be minimal. We're actually lucky that you didn't lock onto something worse like a pit. There was one very near that star.\""
    a "\"Puede que antes exagerara un poco. Los daños parecen mínimos. En realidad hemos tenido suerte de que no fijaras algo peor como objetivo, como un pozo. Había uno muy cerca de aquella estrella.\""

# game/a1s1.rpy:1298
translate spanish a1s1_30a93cb2:

    # m "\"A pit?\""
    m "\"¿Un pozo?\""

# game/a1s1.rpy:1299
translate spanish a1s1_b0283289:

    # "Amicus shrugs, waving his hand in the air, as if brushing my question aside."
    "Amicus se encoge de hombros y agita una mano en el aire, como quitándole importancia a mi pregunta."

# game/a1s1.rpy:1300
translate spanish a1s1_563cf217:

    # a "\"A very strong gravitational singularity that sucks everything up around it—\""
    a "\"Una singularidad gravitacional muy poderosa que absorbe todo lo que la rodea—\""

# game/a1s1.rpy:1301
translate spanish a1s1_f6d33be0:

    # m "\"Like a black hole?\""
    m "\"¿Como un agujero negro?\""

# game/a1s1.rpy:1302
translate spanish a1s1_95dd1f3d:

    # a "\"Black hole?\""
    a "\"¿Un agujero negro?\""

# game/a1s1.rpy:1303
translate spanish a1s1_4e776e18:

    # m "\"Like, its gravity is so powerful that even light gets pulled into it. That's why they're black.\""
    m "\"Es decir, su gravedad es tan intensa que hasta la luz queda atrapada en ellos. Por eso son negros.\""

# game/a1s1.rpy:1304
translate spanish a1s1_bbcecb2f:

    # "Amicus looks at me in susprise."
    "Amicus me mira sorprendido."

# game/a1s1.rpy:1306
translate spanish a1s1_4c83ddc4:

    # a "\"Oh, you know what that is? Guess I should stop being surprised, honestly.\""
    a "\"Ah, ¿sabes lo que es eso? La verdad es que supongo que debería dejar de sorprenderme.\""

# game/a1s1.rpy:1308
translate spanish a1s1_b4678981:

    # a "\"You humans really are something. You basically uplifted yourselves.\""
    a "\"Los humanos sois realmente increíbles. Prácticamente os habéis elevado vosotros mismos.\""

# game/a1s1.rpy:1309
translate spanish a1s1_8619f2c6:

    # "I shrug."
    "Me encojo de hombros."

# game/a1s1.rpy:1310
translate spanish a1s1_299014b4:

    # m "\"We touched on it in my astronomy 101 class. I don't know much about them.\""
    m "\"Lo vimos por encima en mi clase de introducción a la astronomía. No sé mucho sobre ellos.\""

# game/a1s1.rpy:1311
translate spanish a1s1_952fec56:

    # a "\"But the fact that your species found out about them in the first place...Anyway—\""
    a "\"Pero el hecho de que tu especie llegara a descubrirlos... En fin—\""

# game/a1s1.rpy:1313
translate spanish a1s1_d9425616:

    # "Amicus presses a button before suddenly the hum of the ship comes back to life."
    "Amicus pulsa un botón y, de repente, vuelve a sonar el zumbido de la nave."

# game/a1s1.rpy:1314
translate spanish a1s1_04ea1466:

    # com "\"Systems back online.\""
    com "\"Sistemas de nuevo operativos.\""

# game/a1s1.rpy:1315
translate spanish a1s1_cde03927:

    # a "\"And—\""
    a "\"Y—\""

# game/a1s1.rpy:1321
translate spanish a1s1_abea6c9f:

    # "Amicus pulls the lever and suddenly the blue disappears and the windows are filled with warping stars again."
    "Amicus tira de la palanca y, de pronto, desaparece el azul; las ventanas vuelven a llenarse de estrellas que se deforman."

# game/a1s1.rpy:1322
translate spanish a1s1_a1a1db76:

    # "I immediately look away, feeling the chocolate mud start to work its way up my throat."
    "Aparto la mirada de inmediato, sintiendo que el barro con sabor a chocolate empieza a subirme por la garganta."

# game/a1s1.rpy:1323
translate spanish a1s1_813a3f78:

    # a "\"We were actually almost to Adastra when you...took control.\""
    a "\"En realidad ya estábamos casi en Adastra cuando tú... tomaste el control.\""

# game/a1s1.rpy:1324
translate spanish a1s1_1fb09630:

    # "Amicus rubs the side of his neck, wincing as he stretches it out."
    "Amicus se frota un lado del cuello y hace una mueca al estirarlo."

# game/a1s1.rpy:1325
translate spanish a1s1_9cea1886:

    # a "\"Should be there fairly soon.\""
    a "\"Deberíamos llegar bastante pronto.\""

# game/a1s1.rpy:1326
translate spanish a1s1_a4e2bc7d:

    # m "\"What is this.\""
    m "\"Qué es esto.\""

# game/a1s1.rpy:1327
translate spanish a1s1_0ea100a9:

    # "I wave my hand at the window, not looking."
    "Hago un gesto hacia la ventana sin mirar."

# game/a1s1.rpy:1328
translate spanish a1s1_56f1ccb2:

    # a "\"The bending light? It's the Stretch Drive. Basically space is being shortened ahead of us—\""
    a "\"¿La luz que se curva? Es el Motor de Estiramiento. Básicamente, el espacio se acorta delante de nosotros—\""

# game/a1s1.rpy:1329
translate spanish a1s1_96270e5d:

    # "Amicus puts his paws close together in front of himself."
    "Amicus junta las manos delante de él."

# game/a1s1.rpy:1330
translate spanish a1s1_db1a3fd7:

    # a "\"—and stretched out behind us.\""
    a "\"—y se estira detrás de nosotros.\""

# game/a1s1.rpy:1331
translate spanish a1s1_7fb0886d:

    # "Amicus stretches his paws out wide."
    "Amicus separa mucho las manos."

# game/a1s1.rpy:1332
translate spanish a1s1_4c4ab36f:

    # a "\"I, uh, don't really know how it works; only the parents can build this kind of tech and it's the only way I could get to Earth, or anywhere outside our star system, really.\""
    a "\"Yo, eh, no sé realmente cómo funciona; solo los Padres pueden construir este tipo de tecnología y era la única forma de llegar a la Tierra o, en realidad, a cualquier lugar fuera de nuestro sistema estelar.\""

# game/a1s1.rpy:1333
translate spanish a1s1_9a608588:

    # a "\"They even figured out a way to make time stand still around us when we travel, otherwise waaay too much time would have passed back home.\""
    a "\"Incluso han descubierto cómo detener el tiempo a nuestro alrededor mientras viajamos; de lo contrario, habría pasado muchísimo tiempo en casa.\""

# game/a1s1.rpy:1334
translate spanish a1s1_38773d0a:

    # "I'm starting to get a picture of how powerful these \"parents\" actually are; beings capable of warping space and time to their will."
    "Empiezo a hacerme una idea del poder que tienen esos «Padres»: seres capaces de deformar el espacio y el tiempo a voluntad."

# game/a1s1.rpy:1335
translate spanish a1s1_8a03ef56:

    # m "\"So...how much more time—\""
    m "\"Entonces... ¿cuánto tiempo más—\""

# game/a1s1.rpy:1337
translate spanish a1s1_53507c50:

    # com "\"Arriving at Stella Vita.\""
    com "\"Llegando a Stella Vita.\""

# game/a1s1.rpy:1339
translate spanish a1s1_a2029dcf:

    # "And just like that the stars become still again."
    "Y, así de repente, las estrellas vuelven a quedarse quietas."

# game/a1s1.rpy:1340
translate spanish a1s1_ef76e4fb:

    # "Amicus grins."
    "Amicus sonríe de oreja a oreja."

# game/a1s1.rpy:1341
translate spanish a1s1_c53bb988:

    # a "\"Welcome to Adastra, [mc].\""
    a "\"Bienvenido a Adastra, [mc].\""

# game/a1s1.rpy:1343
translate spanish a1s1_31ccc244:

    # "I look out the window and see a large, green and blue sphere shimmer below me."
    "Miro por la ventana y veo una gran esfera verde y azul brillando debajo de mí."

# game/a1s1.rpy:1344
translate spanish a1s1_f2321a6f:

    # "Beyond it there's another globe, this one chalky and gray."
    "Más allá hay otro globo, este de aspecto calcáreo y gris."

# game/a1s1.rpy:1345
translate spanish a1s1_6c9b88bd:

    # "A smaller and even brighter orb floats further to the right, its color almost pure white."
    "Otra esfera más pequeña y aún más brillante flota más a la derecha, de color casi blanco puro."

# game/a1s1.rpy:1346
translate spanish a1s1_6d735c90:

    # "Amicus points at the more Earth-like sphere."
    "Amicus señala la esfera que más se parece a la Tierra."

# game/a1s1.rpy:1348
translate spanish a1s1_a1e7b60e:

    # a "\"That specifically is Adastra, the planet to the left is {i}Ancoris{/i}. There aren't many people there aside from miners. The smallest is {i}Torque{/i}, another moon.\""
    a "\"Esa en concreto es Adastra; el planeta de la izquierda es {i}Ancoris{/i}. Allí no vive mucha gente, aparte de los mineros. La más pequeña es {i}Torque{/i}, otra luna.\""

# game/a1s1.rpy:1349
translate spanish a1s1_5b381c11:

    # a "\"I know you live on a planet, so Adastra might seem a bit small to you.\""
    a "\"Sé que vives en un planeta, así que Adastra podría parecerte algo pequeña.\""

# game/a1s1.rpy:1350
translate spanish a1s1_5802e7c0:

    # "I press a hand to the window and notice that it's ice-cold."
    "Apoyo una mano en la ventana y noto que está helada."

# game/a1s1.rpy:1351
translate spanish a1s1_7fbca651:

    # m "\"Looks pretty big from here.\""
    m "\"Desde aquí parece bastante grande.\""

# game/a1s1.rpy:1352
translate spanish a1s1_ebd15aed:

    # "Amicus leans over the console and starts touching at the screen."
    "Amicus se inclina sobre la consola y empieza a tocar la pantalla."

# game/a1s1.rpy:1353
translate spanish a1s1_97d616b2:

    # com "\"Re entry sequence engaged.\""
    com "\"Secuencia de reentrada iniciada.\""

# game/a1s1.rpy:1354
translate spanish a1s1_49e30f0d:

    # a "\"Go ahead and put your safety straps on. Re-entry is never comfortable in smaller ships.\""
    a "\"Anda, abróchate los cinturones de seguridad. La reentrada nunca es cómoda en las naves pequeñas.\""

# game/a1s1.rpy:1356
translate spanish a1s1_99993fde:

    # "I hurriedly do as he says, sitting down and trying to figure out the seatbelt."
    "Me apresuro a hacer lo que dice, sentándome e intentando averiguar cómo funciona el cinturón."

# game/a1s1.rpy:1357
translate spanish a1s1_c6141103:

    # "Eventually, Amicus has to come over and help, showing me how the strap just feeds into a slot."
    "Al final, Amicus tiene que acercarse para ayudarme y me enseña que solo hay que introducir la correa en una ranura."

# game/a1s1.rpy:1358
translate spanish a1s1_b3c1cd02:

    # "This automatically pulls the straps tightly across my waist and chest."
    "Eso tensa automáticamente las correas alrededor de mi cintura y mi pecho."

# game/a1s1.rpy:1359
translate spanish a1s1_620a887b:

    # "As Amicus gets in his own seat, we start to curve around to the darker side of Adastra."
    "Cuando Amicus se instala en su asiento, empezamos a describir una curva hacia el lado más oscuro de Adastra."

# game/a1s1.rpy:1363
translate spanish a1s1_f822a901:

    # "Every now and then there's a bit of a downward tug on my stomach, sort of like when when the passenger jet I was in was landing in Rome."
    "De vez en cuando noto un pequeño tirón hacia abajo en el estómago, como cuando el avión de pasajeros en el que viajaba estaba aterrizando en Roma."

# game/a1s1.rpy:1364
translate spanish a1s1_9a354312:

    # "I had imagined that things would rattle around, along with a bunch of fire and heat like in a Hollywood movie."
    "Me había imaginado que todo traquetearía, con montones de fuego y calor, como en una película de Hollywood."

# game/a1s1.rpy:1365
translate spanish a1s1_084e4e08:

    # "Instead, there's only a rumbling sound that accompanies a gentle vibration through the seat."
    "En cambio, solo hay un rumor que acompaña a una suave vibración a través del asiento."

# game/a1s1.rpy:1366
translate spanish a1s1_f7e924ea:

    # "There isn't any fire, but I do start to see blue flashes on the otherwise black windows."
    "No hay fuego, pero empiezo a ver destellos azules en las ventanas, que por lo demás están negras."

# game/a1s1.rpy:1367
translate spanish a1s1_e53fd1ba:

    # "I look over at Amicus and see that he's got his eyes closed, looking relaxed."
    "Miro a Amicus y veo que tiene los ojos cerrados y parece relajado."

# game/a1s1.rpy:1368
translate spanish a1s1_511a7243:

    # m "\"Um...\""
    m "\"Eh...\""

# game/a1s1.rpy:1369
translate spanish a1s1_755fa1f6:

    # "The wolf opens his eyes and smiles gently at me."
    "El lobo abre los ojos y me sonríe con suavidad."

# game/a1s1.rpy:1370
translate spanish a1s1_608c5144:

    # a "\"Don't worry. This is all normal.\""
    a "\"No te preocupes. Todo esto es normal.\""

# game/a1s1.rpy:1371
translate spanish a1s1_8d8c3040:

    # "I realize how nervous I must look, so I nod and lean my head back in the seat."
    "Me doy cuenta de lo nervioso que debo parecer, así que asiento y apoyo la cabeza en el respaldo."

# game/a1s1.rpy:1373
translate spanish a1s1_6e06c5a5:

    # "The electric blue flashes stop after a while and then I feel one final downward pull on my body before the rumbling fades out."
    "Los destellos azul eléctrico cesan al cabo de un rato; después siento un último tirón hacia abajo en el cuerpo antes de que el rumor desaparezca."

# game/a1s1.rpy:1374
translate spanish a1s1_f2f602be:

    # "We sit in complete silence and darkness for a moment before I hear Amicus moving next to me."
    "Nos quedamos sentados un momento en completo silencio y a oscuras, hasta que oigo moverse a Amicus a mi lado."

# game/a1s1.rpy:1375
translate spanish a1s1_0d1e01e8:

    # a "\"Okay, we're in the hanger right now. Just follow me into the palace.\""
    a "\"Bien, ahora estamos en el hangar. Sígueme al palacio.\""

# game/a1s1.rpy:1376
translate spanish a1s1_7d840b05:

    # "Amicus gets up, but the ship stays dark."
    "Amicus se levanta, pero la nave sigue a oscuras."

# game/a1s1.rpy:1377
translate spanish a1s1_a5a4759a:

    # "So does the hanger."
    "El hangar también."

# game/a1s1.rpy:1378
translate spanish a1s1_ed2cc2b7:

    # m "\"Okay...why aren't there any lights?\""
    m "\"Vale... ¿por qué no hay luces?\""

# game/a1s1.rpy:1379
translate spanish a1s1_2a52e8d5:

    # a "\"Uh, everyone's probably asleep. I don't want to wake them up.\""
    a "\"Eh, seguramente todos estén dormidos. No quiero despertarlos.\""

# game/a1s1.rpy:1380
translate spanish a1s1_abc921e0:

    # "I get the feeling that he just doesn't want anyone to catch us, but I don't say anything."
    "Tengo la sensación de que simplemente no quiere que nadie nos descubra, pero no digo nada."

# game/a1s1.rpy:1381
translate spanish a1s1_db3c6603:

    # "I fiddle with my seat belt, unable to get it undone until I feel Amicus lean over me, breathing in my ear as his large paw covers mine, pressing something that releases the strap."
    "Trasteo con el cinturón sin conseguir desabrocharlo, hasta que noto a Amicus inclinarse sobre mí; me respira junto a la oreja mientras su enorme mano cubre la mía y pulsa algo que libera la correa."

# game/a1s1.rpy:1382
translate spanish a1s1_1d2ec602:

    # "I stand up, feeling around blindly as I hold onto the seat, only barely able to make out the red bristles of the headrest in front of me."
    "Me levanto y tanteo a ciegas mientras me sujeto al asiento; apenas distingo las cerdas rojas del reposacabezas que tengo delante."

# game/a1s1.rpy:1383
translate spanish a1s1_3e1976e0:

    # "I reach out a hand."
    "Extiendo una mano."

# game/a1s1.rpy:1384
translate spanish a1s1_cd3315d1:

    # m "\"Hey...\""
    m "\"Eh...\""

# game/a1s1.rpy:1385
translate spanish a1s1_9776826b:

    # "Amicus's rough paw pads envelop my hand."
    "Las ásperas almohadillas de la mano de Amicus envuelven la mía."

# game/a1s1.rpy:1386
translate spanish a1s1_33446be8:

    # a "\"What's wrong?\""
    a "\"¿Qué pasa?\""

# game/a1s1.rpy:1387
translate spanish a1s1_5f787939:

    # m "\"I can't see anything.\""
    m "\"No puedo ver nada.\""

# game/a1s1.rpy:1388
translate spanish a1s1_c38a0bd1:

    # a "\"Oh! Can you not see in low light?\""
    a "\"¡Ah! ¿No puedes ver con poca luz?\""

# game/a1s1.rpy:1389
translate spanish a1s1_6930ca1d:

    # "Amicus starts pulling me along before I hear a soft beep, then a whooshing sound."
    "Amicus empieza a tirar de mí; entonces oigo un pitido suave, seguido de un siseo."

# game/a1s1.rpy:1390
translate spanish a1s1_3a1f371a:

    # m "\"Not really.\""
    m "\"La verdad es que no.\""

# game/a1s1.rpy:1392
translate spanish a1s1_3cab8726:

    # "Another sound catches my attention...crickets."
    "Otro sonido me llama la atención... grillos."

# game/a1s1.rpy:1393
translate spanish a1s1_36a1b9ab:

    # "They have crickets here too?"
    "¿También tienen grillos aquí?"

# game/a1s1.rpy:1394
translate spanish a1s1_55aa36bb:

    # "At the same time I'm hit by a wall of humid warmth, almost like walking in to a sauna."
    "Al mismo tiempo, me golpea una pared de calor húmedo, casi como entrar en una sauna."

# game/a1s1.rpy:1395
translate spanish a1s1_032b6a72:

    # "Amicus puts a paw against my chest."
    "Amicus apoya una mano contra mi pecho."

# game/a1s1.rpy:1396
translate spanish a1s1_683444a1:

    # a "\"Wait a second.\""
    a "\"Espera un segundo.\""

# game/a1s1.rpy:1397
translate spanish a1s1_fae3bfe3:

    # "Then I hear a soft thud followed by a grunt."
    "Entonces oigo un golpe suave, seguido de un gruñido."

# game/a1s1.rpy:1398
translate spanish a1s1_f702c6de:

    # m "\"Hello?\""
    m "\"¿Hola?\""

# game/a1s1.rpy:1399
translate spanish a1s1_69a57f73:

    # a "\"Lean down.\""
    a "\"Agáchate.\""

# game/a1s1.rpy:1400
translate spanish a1s1_6d182cad:

    # "My eyes have adjusted a bit more to the dark and I'm barely able to make out what I think are paws reaching up toward me."
    "Mis ojos se han acostumbrado un poco más a la oscuridad y apenas puedo distinguir lo que creo que son unas manos extendidas hacia mí."

# game/a1s1.rpy:1401
translate spanish a1s1_c7d16218:

    # "I crouch down and Amicus grabs me under the arms before pulling me clumsily off the deck of the ship."
    "Me agacho y Amicus me agarra por debajo de los brazos antes de bajarme torpemente de la cubierta de la nave."

# game/a1s1.rpy:1402
translate spanish a1s1_644d4ef4:

    # "My face mashes up against his furry chest before I'm set down on my feet."
    "La cara se me aplasta contra su pecho peludo antes de que me deje de pie en el suelo."

# game/a1s1.rpy:1403
translate spanish a1s1_93ef6329:

    # a "\"Alright, so we're just going to go straight to my room. Try not to make too much noise.\""
    a "\"Muy bien, iremos directamente a mi habitación. Intenta no hacer demasiado ruido.\""

# game/a1s1.rpy:1404
translate spanish a1s1_6a1f00f6:

    # "I start to nod, but Amicus is already pulling me along."
    "Empiezo a asentir, pero Amicus ya está tirando de mí."

# game/a1s1.rpy:1405
translate spanish a1s1_2cbe14b8:

    # "The humidity presses down on me like a physical force and I start to worry that I might actually have trouble surviving on this moon."
    "La humedad me oprime como una fuerza física y empiezo a temer que realmente me cueste sobrevivir en esta luna."

# game/a1s1.rpy:1406
translate spanish a1s1_5520fe34:

    # m "\"It's...really hot.\""
    m "\"Hace... mucho calor.\""

# game/a1s1.rpy:1407
translate spanish a1s1_7cbc1110:

    # a "\"Things will cool off once we're inside.\""
    a "\"Refrescará cuando estemos dentro.\""

# game/a1s1.rpy:1408
translate spanish a1s1_8f4cb2e0:

    # "I can hear him panting heavily as we move through the hanger."
    "Lo oigo jadear con fuerza mientras atravesamos el hangar."

# game/a1s1.rpy:1409
translate spanish a1s1_f5c7754d:

    # "I still can't see much, just angular shapes in the darkness, but finally I see some light ahead along with some cold air."
    "Sigo sin ver mucho, solo formas angulosas en la oscuridad, pero por fin veo luz delante y siento también aire frío."

# game/a1s1.rpy:1411
translate spanish a1s1_2ad5fe10:

    # "We turn a corner and I have to blink against how bright it suddenly becomes."
    "Doblamos una esquina y tengo que parpadear por lo brillante que se vuelve todo de golpe."

# game/a1s1.rpy:1414
translate spanish a1s1_fb8e1c44:

    # "I look around at the pillars and marble floor, the bright lights above me, and what looks like a garden complete with statues extending out through the archways."
    "Miro a mi alrededor: las columnas, el suelo de mármol, las luces brillantes sobre mí y lo que parece un jardín lleno de estatuas que se extiende al otro lado de los arcos."

# game/a1s1.rpy:1415
translate spanish a1s1_19dea63a:

    # "Well, at least I know Amicus wasn't lying about living in a palace."
    "Bueno, al menos sé que Amicus no mentía al decir que vivía en un palacio."

# game/a1s1.rpy:1416
translate spanish a1s1_615b956e:

    # a "\"What do you think?\""
    a "\"¿Qué te parece?\""

# game/a1s1.rpy:1418
translate spanish a1s1_cab4dfcb:

    # m "\"Wow, I mean, it looks really cool, really expensive.\""
    m "\"Vaya, quiero decir, parece muy impresionante, muy caro.\""

# game/a1s1.rpy:1419
translate spanish a1s1_1876a0b8:

    # "I don't know if that last part was such a great compliment, but Amicus seems happy."
    "No sé si esa última parte ha sido un gran cumplido, pero Amicus parece contento."

# game/a1s1.rpy:1421
translate spanish a1s1_27bb6ef5:

    # a "\"Thanks! It's going to be your home for a while, so I'm glad you like it.\""
    a "\"¡Gracias! Va a ser tu hogar durante un tiempo, así que me alegro de que te guste.\""

# game/a1s1.rpy:1422
translate spanish a1s1_93bd351e:

    # "Amicus adjusts his cape, fanning it out a little."
    "Amicus se ajusta la capa y la abre un poco."

# game/a1s1.rpy:1425
translate spanish a1s1_ce6f0ada:

    # a "\"This is only a small portion of the palace, of course. I'll show you around later, but for now I want to go to my room and dry out a little.\""
    a "\"Esto es solo una pequeña parte del palacio, claro. Te lo enseñaré después, pero ahora quiero ir a mi habitación y secarme un poco.\""

# game/a1s1.rpy:1427
translate spanish a1s1_45bbb629:

    # a "\"I must look like a mess right now. The humidity doesn't do my fur any favors.\""
    a "\"Debo de tener una pinta horrible ahora mismo. La humedad no le hace ningún favor a mi pelaje.\""

# game/a1s1.rpy:1428
translate spanish a1s1_3c1c4b3d:

    # "I can tell Amicus is genuinely embarrassed, even if he's trying to joke, so I put a hand up to my hair."
    "Me doy cuenta de que Amicus está realmente avergonzado, aunque intente bromear, así que me llevo una mano al pelo."

# game/a1s1.rpy:1429
translate spanish a1s1_11d886df:

    # m "\"I have a little less to worry about, but I'm sure my hair is pretty crazy right now.\""
    m "\"Yo tengo un poco menos de lo que preocuparme, pero seguro que llevo el pelo hecho un desastre.\""

# game/a1s1.rpy:1431
translate spanish a1s1_68759124:

    # a "\"True. That patch of fur really is something, though.\""
    a "\"Es verdad. Aunque ese mechón de pelo tuyo sí que es curioso.\""

# game/a1s1.rpy:1432
translate spanish a1s1_219c87e3:

    # "The wolf reaches out and touches my hair, rubbing it between the pads on his fingers."
    "El lobo extiende una mano y me toca el pelo, frotándolo entre las almohadillas de los dedos."

# game/a1s1.rpy:1433
translate spanish a1s1_64a54630:

    # "We've made physical contact several times over the last day, but this is the first time that it really feels friendly."
    "Durante el último día hemos tenido contacto físico varias veces, pero es la primera vez que de verdad parece amistoso."

# game/a1s1.rpy:1434
translate spanish a1s1_fe7e1d2e:

    # "We stand there for a moment, just long enough for things to get awkward."
    "Nos quedamos allí un momento, justo el tiempo suficiente para que la situación se vuelva incómoda."

# game/a1s1.rpy:1436
translate spanish a1s1_71db700d:

    # "Amicus pulls his hand back suddenly, as if realizing what he's doing."
    "Amicus retira la mano de golpe, como si acabara de darse cuenta de lo que está haciendo."

# game/a1s1.rpy:1437
translate spanish a1s1_af6538ef:

    # a "\"Oh, uh—\""
    a "\"Ah, eh—\""

# game/a1s1.rpy:1438
translate spanish a1s1_837eb71f:

    # "He's saved from having to think of something to say as we both hear footsteps coming up the hall to our right."
    "Se libra de tener que pensar en algo que decir cuando ambos oímos unos pasos que se acercan por el pasillo de nuestra derecha."

# game/a1s1.rpy:1440
translate spanish a1s1_9894b2cf:

    # a "\"Shit!\""
    a "\"¡Mierda!\""

# game/a1s1.rpy:1441
translate spanish a1s1_df8ec4bc:

    # m "\"What?\""
    m "\"¿Qué?\""

# game/a1s1.rpy:1442
translate spanish a1s1_1e069919:

    # a "\"Hide and be quiet!\""
    a "\"¡Escóndete y no hagas ruido!\""

# game/a1s1.rpy:1444
translate spanish a1s1_661fff36:

    # "Amicus whispers loudly at me and suddenly pushes me hard back the way we came."
    "Amicus me habla en un susurro demasiado fuerte y de repente me empuja con fuerza hacia donde hemos venido."

# game/a1s1.rpy:1445
translate spanish a1s1_6e2b5c7a:

    # "I stumble before scrambling around the corner."
    "Doy un traspié y luego me apresuro a doblar la esquina."

# game/a1s1.rpy:1446
translate spanish a1s1_3eda09ab:

    # "The footsteps get louder as I stand up and press my back against the wall, listening."
    "Los pasos se oyen más fuertes mientras me enderezo y apoyo la espalda contra la pared para escuchar."

# game/a1s1.rpy:1447
translate spanish a1s1_120f6972:

    # unk "\"Amicus!\""
    unk "\"¡Amicus!\""

# game/a1s1.rpy:1448
translate spanish a1s1_14e760c5:

    # "I jump, the person almost shouting Amicus's name."
    "Me sobresalto: esa persona casi está gritando el nombre de Amicus."

# game/a1s1.rpy:1449
translate spanish a1s1_42f6c8ee:

    # a "\"Cassius.\""
    a "\"Cassius.\""

# game/a1s1.rpy:1450
translate spanish a1s1_3aa62c9a:

    # "Amicus's deeper voice responds, sounding cool and collected."
    "La voz más grave de Amicus responde con calma y aplomo."

# game/a1s1.rpy:1451
translate spanish a1s1_496a92c2:

    # c "\"Where the HELL have you been?\""
    c "\"¿Dónde DEMONIOS te habías metido?\""

# game/a1s1.rpy:1452
translate spanish a1s1_ad49212a:

    # "His voice is higher-pitched and a little more articulate than Amicus's."
    "Su voz es más aguda y articula las palabras un poco mejor que Amicus."

# game/a1s1.rpy:1453
translate spanish a1s1_aa6956c4:

    # "I start to look around the corner, then hesitate...then I do it anyway, wanting to see who this person is."
    "Empiezo a asomarme por la esquina, luego vacilo... y, al final, lo hago de todos modos, porque quiero ver quién es esa persona."

# game/a1s1.rpy:1454
translate spanish a1s1_8b6d0f56:

    # "Luckily, Amicus has moved further down the room so that I'm slightly behind this Cassius guy."
    "Por suerte, Amicus se ha adentrado un poco más en la sala, de modo que yo estoy ligeramente detrás de ese tal Cassius."

# game/a1s1.rpy:1457
translate spanish a1s1_6d6d622c:

    # "I see a white wolf, quite a bit smaller compared to Amicus, but no less intimidating...maybe even more so."
    "Veo a un lobo blanco, bastante más pequeño que Amicus, pero no menos intimidante... quizá incluso más."

# game/a1s1.rpy:1458
translate spanish a1s1_551d2447:

    # "I can tell by his demeanor that he's probably not a fun person to be around."
    "Por su actitud, me doy cuenta de que probablemente no sea muy agradable estar cerca de él."

# game/a1s1.rpy:1460
translate spanish a1s1_35799fc1:

    # a "\"I was out hunting. Is something wrong?\""
    a "\"Había salido a cazar. ¿Pasa algo?\""

# game/a1s1.rpy:1462
translate spanish a1s1_8d03c841:

    # c "\"Hunting!? For two days? Is that a joke?\""
    c "\"¡¿A cazar?! ¿Durante dos días? ¿Es una broma?\""

# game/a1s1.rpy:1464
translate spanish a1s1_6931456d:

    # a "\"Was it that long?\""
    a "\"¿Ha pasado tanto tiempo?\""

# game/a1s1.rpy:1466
translate spanish a1s1_36448747:

    # c "\"Yes! You were supposed to make a speech in Lux yesterday! How many times did we remind you of it?\""
    c "\"¡Sí! ¡Ayer debías dar un discurso en Lux! ¿Cuántas veces te lo recordamos?\""

# game/a1s1.rpy:1468
translate spanish a1s1_55965de7:

    # "Cassius suddenly takes a deep breath."
    "Cassius toma aire profundamente de repente."

# game/a1s1.rpy:1470
translate spanish a1s1_6328b991:

    # c "\"Really, Amicus, you seem to expect everyone to cover up your mistakes. I can't comprehend how you could have forgotten.\""
    c "\"De verdad, Amicus, parece que esperas que todo el mundo encubra tus errores. No puedo comprender cómo has podido olvidarlo.\""

# game/a1s1.rpy:1471
translate spanish a1s1_318eda86:

    # a "\"I...lost track of time.\""
    a "\"Yo... perdí la noción del tiempo.\""

# game/a1s1.rpy:1472
translate spanish a1s1_42c24d75:

    # c "\"That's not an excuse. How do you expect to become emperor if you act this way?\""
    c "\"Eso no es una excusa. ¿Cómo esperas convertirte en emperador si te comportas así?\""

# game/a1s1.rpy:1474
translate spanish a1s1_2df92d67_1:

    # "Amicus growls."
    "Amicus gruñe."

# game/a1s1.rpy:1475
translate spanish a1s1_4c663d3c:

    # a "\"Don't even pretend, Cass. You're probably happy I missed it!\""
    a "\"¡No disimules, Cass! ¡Seguro que te alegras de que me lo haya perdido!\""

# game/a1s1.rpy:1476
translate spanish a1s1_3046bf22:

    # c "\"That's ridiculous. Amicus, I only want what's best for the empire.\""
    c "\"Eso es ridículo. Amicus, solo quiero lo mejor para el imperio.\""

# game/a1s1.rpy:1477
translate spanish a1s1_e2a1422a:

    # "Amicus opens his mouth, then shuts it suddenly."
    "Amicus abre la boca y la cierra de repente."

# game/a1s1.rpy:1479
translate spanish a1s1_cf31936b:

    # a "\"No, I'm not doing this tonight. I'm tired and I want to go to bed.\""
    a "\"No, esta noche no pienso entrar en esto. Estoy cansado y quiero irme a la cama.\""

# game/a1s1.rpy:1480
translate spanish a1s1_9dfa6cbf:

    # "Cassius quietly regards Amicus for a moment, then shakes his head."
    "Cassius observa a Amicus en silencio un momento y luego niega con la cabeza."

# game/a1s1.rpy:1482
translate spanish a1s1_cd56fee5:

    # c "\"Well, Virginia went in your stead, so you have her to thank when she returns.\""
    c "\"Bueno, Virginia fue en tu lugar, así que tendrás que darle las gracias cuando regrese.\""

# game/a1s1.rpy:1484
translate spanish a1s1_b9f94f87:

    # a "\"She's better at that sort of thing anyway.\""
    a "\"De todas formas, a ella se le dan mejor esas cosas.\""

# game/a1s1.rpy:1485
translate spanish a1s1_59a7fbbc:

    # c "\"The point was to show Lux that the next possible emperor stands in solidarity with them. Sending your sister is not a good look.\""
    c "\"La idea era demostrarle a Lux que el posible próximo emperador se solidariza con ellos. Enviar a tu hermana no da buena imagen.\""

# game/a1s1.rpy:1487
translate spanish a1s1_25a6c897:

    # a "\"Well...walking around in undergarments doesn't look good either. You think that's how an emperor should behave?\""
    a "\"Bueno... pasearte en ropa interior tampoco da buena imagen. ¿Crees que así debe comportarse un emperador?\""

# game/a1s1.rpy:1489
translate spanish a1s1_8fefcb05:

    # c "\"No one's awake, Amicus. Don't be such a pup.\""
    c "\"No hay nadie despierto, Amicus. No seas tan cachorro.\""

# game/a1s1.rpy:1490
translate spanish a1s1_c4e3cfc3:

    # a "\"I'm just saying you look really small without your armor. Now THAT is not a good look for an emperor.\""
    a "\"Solo digo que sin tu armadura pareces muy pequeño. ESO sí que no da buena imagen para un emperador.\""

# game/a1s1.rpy:1492
translate spanish a1s1_ca3d8a7c:

    # c "\"Excuse me?\""
    c "\"¿Perdona?\""

# game/a1s1.rpy:1493
translate spanish a1s1_8ec8b806:

    # a "\"What? I only want what's best for the empire and a little runt like you definitely isn't.\""
    a "\"¿Qué? Solo quiero lo mejor para el imperio, y un enano enclenque como tú desde luego no lo es.\""

# game/a1s1.rpy:1495
translate spanish a1s1_3e290ecb:

    # "They stare at each other for a long time and though I have no idea what's going on, I can almost see the electricity arcing between them."
    "Se quedan mirándose durante un largo rato y, aunque no tengo ni idea de lo que ocurre, casi puedo ver la electricidad saltando entre ellos."

# game/a1s1.rpy:1497
translate spanish a1s1_91fe7a34:

    # "Finally, Cassius turns on his heel and stalks away, tail swishing furiously."
    "Por fin, Cassius gira sobre el talón y se aleja con pasos airados, agitando la cola con furia."

# game/a1s1.rpy:1498
translate spanish a1s1_36272402:

    # c "\"Goodnight, Amicus.\""
    c "\"Buenas noches, Amicus.\""

# game/a1s1.rpy:1500
translate spanish a1s1_b1120e2f:

    # "Amicus stands there for a moment, still puffed out a little before he finally deflates."
    "Amicus se queda allí un momento, todavía un poco erizado, antes de desinflarse por fin."

# game/a1s1.rpy:1502
translate spanish a1s1_97c20039:

    # a "\"Dammit.\""
    a "\"Maldita sea.\""

# game/a1s1.rpy:1504
translate spanish a1s1_5346bd85:

    # "I stand quietly around the corner, waiting for Amicus to call me back."
    "Me quedo en silencio al otro lado de la esquina, esperando a que Amicus me llame."

# game/a1s1.rpy:1505
translate spanish a1s1_0ca229dc:

    # "When he doesn't, I whisper at him."
    "Como no lo hace, lo llamo en un susurro."

# game/a1s1.rpy:1506
translate spanish a1s1_2e87079d_1:

    # m "\"Amicus?\""
    m "\"¿Amicus?\""

# game/a1s1.rpy:1508
translate spanish a1s1_e628232f:

    # "His ears prick up and he turns to me."
    "Sus orejas se levantan y se vuelve hacia mí."

# game/a1s1.rpy:1510
translate spanish a1s1_398bda04:

    # a "\"Hey, come on. We should go before anyone else decides to show up.\""
    a "\"Eh, vamos. Será mejor irnos antes de que aparezca alguien más.\""

# game/a1s1.rpy:1511
translate spanish a1s1_1f228d29:

    # m "\"Okay.\""
    m "\"Vale.\""

# game/a1s1.rpy:1514
translate spanish a1s1_98291688:

    # "I can tell by the way the wolf walks, his ears slightly down, his tail almost dragging, that he's not in a good mood."
    "Por su forma de andar, con las orejas algo bajas y la cola casi arrastrando, me doy cuenta de que el lobo no está de buen humor."

# game/a1s1.rpy:1515
translate spanish a1s1_702cfbe4:

    # m "\"You alright?\""
    m "\"¿Estás bien?\""

# game/a1s1.rpy:1516
translate spanish a1s1_56b926d2:

    # a "\"Hm? Yeah, yeah, I'm fine. My brother just knows how to irritate me...and I shouldn't have said that to him.\""
    a "\"¿Hm? Sí, sí, estoy bien. Mi hermano sabe cómo irritarme... Y no debería haberle dicho eso.\""

# game/a1s1.rpy:1517
translate spanish a1s1_fbabd804:

    # "We quietly walk through the marble halls, the echoing of our footsteps the only sound."
    "Caminamos en silencio por los pasillos de mármol; el único sonido es el eco de nuestros pasos."

# game/a1s1.rpy:1518
translate spanish a1s1_a9f4ea58:

    # m "\"Is he not supposed to see me?\""
    m "\"¿No debe verme?\""

# game/a1s1.rpy:1519
translate spanish a1s1_fb181d28:

    # a "\"I just...need to think of the right way to introduce you. Now isn't the best time.\""
    a "\"Solo... necesito pensar en la forma adecuada de presentarte. Ahora no es el mejor momento.\""

# game/a1s1.rpy:1520
translate spanish a1s1_27dcc0f2:

    # m "\"Is he the one that challenged you for the throne?\""
    m "\"¿Es él quien te ha disputado el trono?\""

# game/a1s1.rpy:1521
translate spanish a1s1_bb61b276:

    # "Amicus is quiet for a moment before heaving a huge sigh."
    "Amicus se queda callado un momento antes de soltar un enorme suspiro."

# game/a1s1.rpy:1522
translate spanish a1s1_e0a3b7c8:

    # a "\"Yes, and he's really starting to turn my life upside down because of it. Sometimes I think he just sees this all as a game.\""
    a "\"Sí, y por eso está empezando a poner mi vida patas arriba. A veces creo que para él todo esto no es más que un juego.\""

# game/a1s1.rpy:1523
translate spanish a1s1_59527240:

    # "We come to a stop at what looks like a door."
    "Nos detenemos ante lo que parece una puerta."

# game/a1s1.rpy:1524
translate spanish a1s1_6866551c:

    # "It's completely smooth though, made of what also looks like marble."
    "Sin embargo, es completamente lisa y está hecha de lo que también parece mármol."

# game/a1s1.rpy:1525
translate spanish a1s1_65feb50d:

    # "Amicus doesn't make any move to open it."
    "Amicus no hace ningún movimiento para abrirla."

# game/a1s1.rpy:1527
translate spanish a1s1_58d42db2:

    # a "\"And you know, he never seemed concerned for me and my duties until AFTER he made his challenge. That's what bothers me the most, knowing that it's all an act.\""
    a "\"Y sabes, nunca pareció preocuparse por mí ni por mis deberes hasta DESPUÉS de disputarme el trono. Eso es lo que más me molesta: saber que todo es teatro.\""

# game/a1s1.rpy:1528
translate spanish a1s1_e9b2a73b:

    # m "\"I guess you're not really close with him, then?\""
    m "\"Entonces supongo que no sois muy cercanos, ¿no?\""

# game/a1s1.rpy:1529
translate spanish a1s1_1372a054:

    # a "\"Not since we were pups, no.\""
    a "\"No, desde que éramos cachorros.\""

# game/a1s1.rpy:1530
translate spanish a1s1_b92b890e:

    # "A disturbing thought suddenly hits me."
    "De repente me asalta una idea inquietante."

# game/a1s1.rpy:1531
translate spanish a1s1_be6bbf0d:

    # m "\"Well...you know in Earth's ancient Rome, the place where you guys uplifted, people would kill each other over the throne, like a lot...does that happen here?\""
    m "\"Bueno... sabes que en la antigua Roma de la Tierra, donde vosotros realizasteis la elevación, la gente se mataba por el trono, muchísimo... ¿Eso ocurre aquí?\""

# game/a1s1.rpy:1533
translate spanish a1s1_e0a11c00_1:

    # "Amicus frowns."
    "Amicus frunce el ceño."

# game/a1s1.rpy:1534
translate spanish a1s1_fd516fb4:

    # a "\"Uh...I suppose it's happened in the past, but that was a long time ago. Besides, Cassius would never do something like that.\""
    a "\"Eh... supongo que ha ocurrido en el pasado, pero fue hace mucho tiempo. Además, Cassius jamás haría algo así.\""

# game/a1s1.rpy:1536
translate spanish a1s1_92f1c9fd:

    # "Amicus sticks out his paw and presses it to a black square on the wall."
    "Amicus extiende una mano y la apoya sobre un cuadrado negro de la pared."

# game/a1s1.rpy:1537
translate spanish a1s1_f600264a:

    # "The door slides open without a sound."
    "La puerta se desliza y se abre sin hacer ruido."

# game/a1s1.rpy:1539
translate spanish a1s1_0907a4b7:

    # "I feel a rush of cool air come out of the room and Amicus lets out a happy sigh as he steps inside."
    "Noto una ráfaga de aire frío que sale de la habitación, y Amicus suspira satisfecho al entrar."

# game/a1s1.rpy:1541
translate spanish a1s1_ef87675d:

    # a "\"Ahhhh, that's much better. My dad's advisor keeps the climate way too hot in the rest of the palace.\""
    a "\"Ahhhh, mucho mejor. El consejero de mi padre mantiene el resto del palacio demasiado caliente.\""

# game/a1s1.rpy:1543
translate spanish a1s1_6d34af9f:

    # "I follow the wolf inside and look around."
    "Sigo al lobo al interior y miro a mi alrededor."

# game/a1s1.rpy:1544
translate spanish a1s1_eb0631f2:

    # "Aside from a few quirks, the room looks like it could have come straight out of any luxury hotel on Earth."
    "Salvo por unas pocas peculiaridades, la habitación podría haber salido directamente de cualquier hotel de lujo de la Tierra."

# game/a1s1.rpy:1545
translate spanish a1s1_03aeed76:

    # "Amicus sits heavily on the bed, making it squeak."
    "Amicus se deja caer pesadamente en la cama y la hace chirriar."

# game/a1s1.rpy:1546
translate spanish a1s1_a893d3be:

    # "He starts to strip off his clothing."
    "Empieza a quitarse la ropa."

# game/a1s1.rpy:1548
translate spanish a1s1_2fe005d6:

    # a "\"Toilet and bath are in there.\""
    a "\"El retrete y el baño están ahí.\""

# game/a1s1.rpy:1549
translate spanish a1s1_5c0f7e77:

    # "He nods ahead at another door across from the bed."
    "Señala con la cabeza otra puerta situada frente a la cama."

# game/a1s1.rpy:1550
translate spanish a1s1_2dd50623:

    # "Then he jabs a thumb back at the large curtain."
    "Luego señala hacia atrás, con el pulgar, la gran cortina."

# game/a1s1.rpy:1552
translate spanish a1s1_92a9da45:

    # a "\"That's the balcony if you want to get some air, though I don't know why you would in this weather.\""
    a "\"Ahí está el balcón, si quieres tomar el aire, aunque no sé por qué ibas a querer hacerlo con este tiempo.\""

# game/a1s1.rpy:1553
translate spanish a1s1_c57f6e52:

    # "Then he points at the couch."
    "Después señala el sofá."

# game/a1s1.rpy:1554
translate spanish a1s1_6c3d91f7:

    # a "\"And that can be where you sleep, if that's alright with you. I've known other aliens to prefer the floor, though.\""
    a "\"Y ahí puedes dormir, si te parece bien. Aunque he conocido a otros alienígenas que preferían el suelo.\""

# game/a1s1.rpy:1556
translate spanish a1s1_424ee26a:

    # m "\"The couch is fine.\""
    m "\"El sofá está bien.\""

# game/a1s1.rpy:1558
translate spanish a1s1_73002da7:

    # "I walk over to the red sofa, sizing it up."
    "Me acerco al sofá rojo y calculo su tamaño."

# game/a1s1.rpy:1559
translate spanish a1s1_2bcdcf55:

    # "It's more than big enough, but as I pick up the little black pillow I notice it's covered in fur."
    "Es más que lo bastante grande, pero, al recoger la pequeña almohada negra, noto que está cubierta de pelo."

# game/a1s1.rpy:1560
translate spanish a1s1_cb3b3bc4:

    # "I inconspicuously pick some of it off before a light blanket smacks into the back of my head."
    "Quito discretamente unos cuantos pelos antes de que una manta ligera me golpee en la nuca."

# game/a1s1.rpy:1562
translate spanish a1s1_2d9d5641:

    # a "\"Haha! There you go. Is that all okay?\""
    a "\"¡Ja, ja! Ahí tienes. ¿Todo bien así?\""

# game/a1s1.rpy:1563
translate spanish a1s1_9ad1e2eb:

    # m "\"Yeah, this is good.\""
    m "\"Sí, esto está bien.\""

# game/a1s1.rpy:1564
translate spanish a1s1_6fe613fb:

    # "I hope the blanket will be enough to keep off the cold that seems to be wafting down from the ceiling."
    "Espero que la manta baste para protegerme del frío que parece bajar del techo."

# game/a1s1.rpy:1566
translate spanish a1s1_6b596c54:

    # a "\"Good. Like I said earlier, I'll show you the rest of the palace tomorrow. We'll get some real food too.\""
    a "\"Bien. Como te dije antes, mañana te enseñaré el resto del palacio. También conseguiremos comida de verdad.\""

# game/a1s1.rpy:1568
translate spanish a1s1_30066ee1:

    # "Amicus sprawls back on the bed, not bothering to draw up any blankets, his eyes closed."
    "Amicus se tumba a lo ancho de la cama sin molestarse en echarse ninguna manta encima, con los ojos cerrados."

# game/a1s1.rpy:1569
translate spanish a1s1_c5dded50:

    # "I actually want real food now, but I don't say anything and instead lay down, the sofa a bit harder than I'd expected."
    "En realidad quiero comida de verdad ya, pero no digo nada y me tumbo; el sofá es un poco más duro de lo que esperaba."

# game/a1s1.rpy:1570
translate spanish a1s1_5e7694b6:

    # "Good support, I guess."
    "Buen soporte para la espalda, supongo."

# game/a1s1.rpy:1571
translate spanish a1s1_1bcf068a:

    # "As I'm settling in, I think Amicus has already fallen asleep, but that's when he speaks again."
    "Mientras me acomodo, creo que Amicus ya se ha dormido, pero entonces vuelve a hablar."

# game/a1s1.rpy:1572
translate spanish a1s1_5abd6ccb:

    # a "\"And thanks, [mc].\""
    a "\"Y gracias, [mc].\""

# game/a1s1.rpy:1573
translate spanish a1s1_521ba82e:

    # "I don't know what he's thanking me for."
    "No sé por qué me está dando las gracias."

# game/a1s1.rpy:1574
translate spanish a1s1_de396717:

    # "For not killing him on the ship?"
    "¿Por no haberlo matado en la nave?"

# game/a1s1.rpy:1575
translate spanish a1s1_04f18c2a:

    # "For agreeing to help him become emperor?"
    "¿Por haber aceptado ayudarlo a convertirse en emperador?"

# game/a1s1.rpy:1576
translate spanish a1s1_7c78f5b9:

    # "For the way I took this shitty sofa and flimsy blanket without complaint?"
    "¿Por haber aceptado este sofá de mierda y esta manta endeble sin quejarme?"

# game/a1s1.rpy:1577
translate spanish a1s1_90dc5502:

    # "I'm not sure, so all I say is:"
    "No estoy seguro, así que solo digo:"

# game/a1s1.rpy:1578
translate spanish a1s1_910f899d:

    # m "\"Sure.\""
    m "\"Claro.\""

# game/a1s1.rpy:1579
translate spanish a1s1_098fa350:

    # "Then I hear the wolf snoring softly and the lights suddenly dim down until they're off."
    "Entonces oigo al lobo roncar suavemente y las luces se atenúan de repente hasta apagarse."

# game/a1s1.rpy:1582
translate spanish a1s1_95d6b7d6:

    # "I lay there a while, though I'm not sure for how long."
    "Me quedo tumbado un rato, aunque no sé cuánto tiempo."

# game/a1s1.rpy:1583
translate spanish a1s1_4d9868cc:

    # "In fact, time seems to have lost all meaning since I was abducted."
    "De hecho, parece que el tiempo ha perdido todo sentido desde que me secuestraron."

# game/a1s1.rpy:1584
translate spanish a1s1_5a20cc71:

    # "Amicus's brother said it had been two days, but didn't Amicus say that time freezes when traveling in the Stretch Drive?"
    "El hermano de Amicus dijo que habían pasado dos días, pero ¿no había dicho Amicus que el tiempo se detiene cuando viajamos con el Motor de Estiramiento?"

# game/a1s1.rpy:1585
translate spanish a1s1_73eec06f:

    # "Had we really spent that much time idling around?"
    "¿De verdad habíamos pasado tanto tiempo parados?"

# game/a1s1.rpy:1586
translate spanish a1s1_2e9eaf01:

    # "I need to stop thinking about everything that doesn't make sense...because that's basically everything."
    "Tengo que dejar de pensar en todas las cosas que no tienen sentido... porque eso es prácticamente todo."

# game/a1s1.rpy:1587
translate spanish a1s1_2165491e:

    # "I just need to help this wolf so I can get the hell back home."
    "Solo tengo que ayudar a este lobo para poder volver de una maldita vez a casa."

# game/a1s1.rpy:1588
translate spanish a1s1_5d07c304:

    # "Then I can pick apart everything I've been through all I want."
    "Después podré analizar todo lo que he vivido cuanto quiera."

# game/a1s1.rpy:1589
translate spanish a1s1_8da8f1cd:

    # "For now I just need to help things move along as smoothly as possible."
    "Por ahora solo necesito ayudar a que las cosas avancen de la forma más fluida posible."

# game/a1s1.rpy:1590
translate spanish a1s1_40f74d8a:

    # "With that thought in my head, and with the soft sounds of Amicus's gentle snoring, I'm lulled into a light and troubled sleep."
    "Con esa idea en la cabeza y el suave sonido de los apacibles ronquidos de Amicus, me dejo arrullar hasta caer en un sueño ligero e inquieto."

